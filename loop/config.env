# Config del loop nocturno (PLAN-CONTINUACION.md §3). Se carga con `source` desde bash y desde gate.py.
LOOP_GITHUB_REPO="fscheu/QuantAgent"
LOOP_LABEL="loop"
LOOP_REVIEWER="fscheu"
LOOP_QUEUE_FILE="PLAN-CONTINUACION.md"
# Revisores: LOOP_REVIEWER es la cuenta de GitHub que escribe las líneas R: (Fede) y PM: (sesión pm-revisor,
# que usa la misma cuenta). La PM: solo vale en PRs hacia una rama de lote (§3.7).
LOOP_LOT_LABEL="lote"
LOOP_LOT_PREFIX="lote/"
# Sesión tmux del PM (pm-revisor). El cron la despierta con un mensaje y el PM lanza las corridas con
# `hermes_launch.sh --run`. Vacío o sesión inexistente = el cron lanza una corrida él mismo, como antes.
LOOP_PM_TMUX="claude-rc-quantagent-pm"
# El objetivo por entrega no cambió: más de LOOP_TARGET_LINES estimadas = partición. El límite duro solo evita
# tirar una entrega que salió algo más grande que lo estimado.
LOOP_MAX_LINES="400"
LOOP_TARGET_LINES="100"
LOOP_MAX_FILES="10"
LOOP_EXCLUDE=".beads/** tests/fixtures/** docs/loop/REVIEW-LOG.md"
LOOP_TIMEOUT_MIN="120"
LOOP_CI_WAIT_MIN="15"
# Agente que ejecuta la corrida: claude | agy (Antigravity). Para cambiarlo en UNA sola corrida sin PR:
# `echo agy > $LOOP_LOG_DIR/next-agent` (se consume al usarse). Ver docs/loop/SETUP-HERMES.md.
LOOP_AGENT="agy"
LOOP_AGY_MODEL="gemini-3.8-flash-high"
# Base de tests del loop, separada de la de desarrollo (creada 2026-10-03, ver docs/loop/SETUP-HERMES.md)
LOOP_TEST_DATABASE_URL="postgresql://loop_test:loop_test@127.0.0.1:5432/quantagent_loop_test"
LOOP_LOG_DIR="/home/azureuser/.local/state/quantagent-loop"
