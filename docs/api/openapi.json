  "info": {
    "title": "QuantAgent API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/accounts": {
      "get": {
        "operationId": "accounts_api_accounts_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/AccountRef"
                  },
                  "title": "Response Accounts Api Accounts Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Accounts"
      }
    },
    "/api/accounts/{account_id}/equity": {
      "get": {
        "operationId": "account_equity_api_accounts__account_id__equity_get",
        "parameters": [
          {
            "in": "path",
            "name": "account_id",
            "required": true,
            "schema": {
              "title": "Account Id",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "range",
            "required": false,
            "schema": {
              "default": "1M",
              "enum": [
                "1W",
                "1M",
                "3M",
                "YTD",
                "ALL"
              ],
              "title": "Range",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/EquityPoint"
                  },
                  "title": "Response Account Equity Api Accounts  Account Id  Equity Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Account Equity"
      }
    },
