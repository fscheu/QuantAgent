{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01ESWT768P5KST6bJts7oA8p","type":"tool_result","content":"1\t\"\"\"Centralized logging configuration with database persistence.\"\"\"\n2\t\n3\timport logging\n4\tfrom datetime import datetime\n5\tfrom typing import Optional\n6\t\n7\tfrom . import settings\n8\tfrom .database import SessionLocal\n9\t\n10\t\n11\tclass DatabaseLogHandler(logging.Handler):\n12\t    \"\"\"Custom logging handler that persists logs to PostgreSQL.\"\"\"\n13\t\n14\t    def __init__(\n15\t        self, environment: Optional[str] = None, symbol: Optional[str] = None\n16\t    ):\n17\t        super().__init__()\n18\t        self.environment = environment\n19\t        self.symbol = symbol\n20\t\n21\t    def emit(self, record: logging.LogRecord) -> None:\n22\t        \"\"\"Emit a log record to the database.\"\"\"\n23\t        try:\n24\t            from .models import Log\n25\t\n26\t            session = SessionLocal()\n27\t            try:\n28\t                extra = getattr(record, \"__dict__\", {})\n29\t                log_entry = Log(\n30\t                    timestamp=datetime.utcnow(),\n31\t                    level=record.levelname,\n32\t                    module=record.name,\n33\t                    message=self.format(record),\n34\t                    environment=extra.get(\"environment\", self.environment),\n35\t                    symbol=extra.get(\"symbol\", self.symbol),\n36\t                    event_type=extra.get(\"event_type\"),\n37\t                    extra_data=extra.get(\"extra_data\"),\n38\t                    thread_id=extra.get(\"thread_id\"),\n39\t                    checkpoint_id=extra.get(\"checkpoint_id\"),\n40\t                )\n41\t                session.add(log_entry)\n42\t                session.commit()\n43\t            finally:\n44\t                session.close()\n45\t        except Exception:\n46\t            self.handleError(record)\n47\t\n48\t\n49\tdef setup_logging(\n50\t    level: Optional[str] = None,\n51\t    log_to_console: Optional[bool] = None,\n52\t    log_to_db: Optional[bool] = None,\n53\t    environment: Optional[str] = None,\n54\t    symbol: Optional[str] = None,\n55\t) -> None:\n56\t    \"\"\"\n57\t    Configure logging with dual handlers (console + database).\n58\t\n59\t    Args:\n60\t        level: Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL).\n61\t               Defaults to settings.LOG_LEVEL.\n62\t        log_to_console: Enable console output.\n63\t                        Defaults to settings.LOG_TO_CONSOLE.\n64\t        log_to_db: Enable database persistence.\n65\t                   Defaults to settings.LOG_TO_DB.\n66\t        environment: Environment tag (backtest, paper, prod). Optional.\n67\t        symbol: Symbol tag for filtering. Optional.\n68\t    \"\"\"\n69\t    level = level or settings.LOG_LEVEL\n70\t    if log_to_console is None:\n71\t        log_to_console = settings.LOG_TO_CONSOLE\n72\t    if log_to_db is None:\n73\t        log_to_db = settings.LOG_TO_DB\n74\t\n75\t    root_logger = logging.getLogger()\n76\t    root_logger.setLevel(getattr(logging, level.upper(), logging.INFO))\n77\t    root_logger.handlers.clear()\n78\t\n79\t    console_formatter = logging.Formatter(\n80\t        \"%(asctime)s - %(name)s - %(levelname)s - %(message)s\",\n81\t        datefmt=\"%Y-%m-%d %H:%M:%S\",\n82\t    )\n83\t\n84\t    if log_to_console:\n85\t        console_handler = logging.StreamHandler()\n86\t        console_handler.setFormatter(console_formatter)\n87\t        root_logger.addHandler(console_handler)\n88\t\n89\t    if log_to_db:\n90\t        db_handler = DatabaseLogHandler(environment=environment, symbol=symbol)\n91\t        db_handler.setLevel(logging.INFO)\n92\t        root_logger.addHandler(db_handler)\n93\t"}]},"parent_tool_use_id":null,"session_id":"7dd06f03-9471-4f30-96ac-96686d5d0e21","uuid":"2b1e117f-b37e-4673-8891-b387f68e46a7","timestamp":"2026-05-12T17:52:02.896Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/autodev-worktrees/QuantAgent/QuantAgent-69d/planner-20260512T124234Z/quantagent/logging_config.py","content":"\"\"\"Centralized logging configuration with database persistence.\"\"\"\n\nimport logging\nfrom datetime import datetime\nfrom typing import Optional\n\nfrom . import settings\nfrom .database import SessionLocal\n\n\nclass DatabaseLogHandler(logging.Handler):\n    \"\"\"Custom logging handler that persists logs to PostgreSQL.\"\"\"\n\n    def __init__(\n        self, environment: Optional[str] = None, symbol: Optional[str] = None\n    ):\n        super().__init__()\n        self.environment = environment\n        self.symbol = symbol\n\n    def emit(self, record: logging.LogRecord) -> None:\n        \"\"\"Emit a log record to the database.\"\"\"\n        try:\n            from .models import Log\n\n            session = SessionLocal()\n            try:\n                extra = getattr(record, \"__dict__\", {})\n                log_entry = Log(\n                    timestamp=datetime.utcnow(),\n                    level=record.levelname,\n                    module=record.name,\n                    message=self.format(record),\n                    environment=extra.get(\"environment\", self.environment),\n                    symbol=extra.get(\"symbol\", self.symbol),\n                    event_type=extra.get(\"event_type\"),\n                    extra_data=extra.get(\"extra_data\"),\n                    thread_id=extra.get(\"thread_id\"),\n                    checkpoint_id=extra.get(\"checkpoint_id\"),\n                )\n                session.add(log_entry)\n                session.commit()\n            finally:\n                session.close()\n        except Exception:\n            self.handleError(record)\n\n\ndef setup_logging(\n    level: Optional[str] = None,\n    log_to_console: Optional[bool] = None,\n    log_to_db: Optional[bool] = None,\n    environment: Optional[str] = None,\n    symbol: Optional[str] = None,\n) -> None:\n    \"\"\"\n    Configure logging with dual handlers (console + database).\n\n    Args:\n        level: Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL).\n               Defaults to settings.LOG_LEVEL.\n        log_to_console: Enable console output.\n                        Defaults to settings.LOG_TO_CONSOLE.\n        log_to_db: Enable database persistence.\n                   Defaults to settings.LOG_TO_DB.\n        environment: Environment tag (backtest, paper, prod). Optional.\n        symbol: Symbol tag for filtering. Optional.\n    \"\"\"\n    level = level or settings.LOG_LEVEL\n    if log_to_console is None:\n        log_to_console = settings.LOG_TO_CONSOLE\n    if log_to_db is None:\n        log_to_db = settings.LOG_TO_DB\n\n    root_logger = logging.getLogger()\n    root_logger.setLevel(getattr(logging, level.upper(), logging.INFO))\n    root_logger.handlers.clear()\n\n    console_formatter = logging.Formatter(\n        \"%(asctime)s - %(name)s - %(levelname)s - %(message)s\",\n        datefmt=\"%Y-%m-%d %H:%M:%S\",\n    )\n\n    if log_to_console:\n        console_handler = logging.StreamHandler()\n        console_handler.setFormatter(console_formatter)\n        root_logger.addHandler(console_handler)\n\n    if log_to_db:\n        db_handler = DatabaseLogHandler(environment=environment, symbol=symbol)\n        db_handler.setLevel(logging.INFO)\n        root_logger.addHandler(db_handler)\n","numLines":93,"startLine":1,"totalLines":93}}}
