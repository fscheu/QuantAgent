{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019WzK2CmnQ2zop57UPe92wW","type":"tool_result","content":"1\t\"\"\"\n2\tShared utilities for agent implementations.\n3\t\n4\tProvides centralized retry logic with exponential backoff and structured output helpers.\n5\t\"\"\"\n6\t\n7\timport logging\n8\timport random\n9\timport time\n10\tfrom typing import Callable, TypeVar\n11\t\n12\tfrom quantagent.default_config import RETRY_CONFIG\n13\t\n14\tlogger = logging.getLogger(__name__)\n15\tT = TypeVar(\"T\")\n16\t\n17\t# Error patterns that trigger retry\n18\tRETRYABLE_ERROR_PATTERNS = (\n19\t    \"RateLimitError\",\n20\t    \"APITimeoutError\",\n21\t    \"APIConnectionError\",\n22\t    \"Timeout\",\n23\t    \"ConnectionError\",\n24\t    \"ConnectError\",\n25\t)\n26\t\n27\t\n28\tdef _is_retryable_error(error: Exception) -> bool:\n29\t    \"\"\"\n30\t    Determine if an error should trigger a retry.\n31\t\n32\t    Args:\n33\t        error: The exception to check\n34\t\n35\t    Returns:\n36\t        True if error should be retried, False otherwise\n37\t    \"\"\"\n38\t    error_type = f\"{type(error).__module__}.{type(error).__name__}\"\n39\t\n40\t    # Check explicit retryable patterns\n41\t    if any(pattern in error_type for pattern in RETRYABLE_ERROR_PATTERNS):\n42\t        return True\n43\t\n44\t    # Check HTTP status if available\n45\t    status_code = getattr(error, \"status_code\", None)\n46\t    if status_code is not None:\n47\t        # 429 (rate limit) and 5xx are retryable\n48\t        return status_code == 429 or status_code >= 500\n49\t\n50\t    # Generic network/timeout errors by name\n51\t    error_name_lower = type(error).__name__.lower()\n52\t    if \"timeout\" in error_name_lower or \"connection\" in error_name_lower:\n53\t        return True\n54\t\n55\t    return False\n56\t\n57\t\n58\tdef _calculate_wait_time(\n59\t    attempt: int,\n60\t    base_wait: float,\n61\t    max_wait: float,\n62\t    exponential_base: float,\n63\t    jitter: bool,\n64\t    jitter_factor: float,\n65\t) -> float:\n66\t    \"\"\"\n67\t    Calculate wait time with exponential backoff and optional jitter.\n68\t\n69\t    Args:\n70\t        attempt: Current attempt number (0-indexed)\n71\t        base_wait: Base wait time in seconds\n72\t        max_wait: Maximum wait time cap\n73\t        exponential_base: Multiplier for exponential backoff\n74\t        jitter: Whether to add randomness\n75\t        jitter_factor: Jitter range as fraction of wait time\n76\t\n77\t    Returns:\n78\t        Calculated wait time in seconds\n79\t    \"\"\"\n80\t    # Exponential backoff: base * (exponential_base ^ attempt)\n81\t    wait = base_wait * (exponential_base**attempt)\n82\t\n83\t    # Cap at max_wait\n84\t    wait = min(wait, max_wait)\n85\t\n86\t    # Add jitter if enabled\n87\t    if jitter:\n88\t        jitter_range = wait * jitter_factor\n89\t        wait = wait + random.uniform(-jitter_range / 2, jitter_range / 2)\n90\t        # Floor to prevent negative/zero waits\n91\t        wait = max(0.1, wait)\n92\t\n93\t    return wait\n94\t\n95\t\n96\tdef invoke_with_retry(\n97\t    call_fn: Callable[..., T],\n98\t    *args,\n99\t    retries: int | None = None,\n100\t    base_wait: float | None = None,\n101\t    max_wait: float | None = None,\n102\t    jitter: bool | None = None,\n103\t    **kwargs,\n104\t) -> T:\n105\t    \"\"\"\n106\t    Centralized retry wrapper with exponential backoff.\n107\t\n108\t    Handles rate limiting and transient errors across multiple LLM providers\n109\t    (OpenAI, Anthropic, Qwen). Uses exponential backoff with jitter.\n110\t\n111\t    Args:\n112\t        call_fn: Function to call (typically llm.invoke)\n113\t        *args: Positional arguments for call_fn\n114\t        retries: Max retry attempts (default: from RETRY_CONFIG)\n115\t        base_wait: Base wait time in seconds (default: from RETRY_CONFIG)\n116\t        max_wait: Maximum wait time cap (default: from RETRY_CONFIG)\n117\t        jitter: Add randomness to wait time (default: from RETRY_CONFIG)\n118\t        **kwargs: Keyword arguments for call_fn\n119\t\n120\t    Returns:\n121\t        Result from call_fn if successful\n122\t\n123\t    Raises:\n124\t        RuntimeError: If all retries exhausted\n125\t        Exception: Re-raised if error is not retryable\n126\t\n127\t    Example:\n128\t        >>> result = invoke_with_retry(llm.invoke, messages)\n129\t        >>> result = invoke_with_retry(llm.invoke, messages, retries=7, base_wait=4)\n130\t    \"\"\"\n131\t    # Resolve configuration (local override > global config)\n132\t    max_retries: int = retries if retries is not None else int(RETRY_CONFIG[\"max_retries\"])\n133\t    resolved_base_wait: float = base_wait if base_wait is not None else float(RETRY_CONFIG[\"base_wait\"])\n134\t    resolved_max_wait: float = max_wait if max_wait is not None else float(RETRY_CONFIG[\"max_wait\"])\n135\t    resolved_jitter: bool = jitter if jitter is not None else bool(RETRY_CONFIG[\"jitter\"])\n136\t    exponential_base: float = float(RETRY_CONFIG[\"exponential_base\"])\n137\t    jitter_factor: float = float(RETRY_CONFIG[\"jitter_factor\"])\n138\t\n139\t    for attempt in range(max_retries):\n140\t        try:\n141\t            return call_fn(*args, **kwargs)\n142\t        except Exception as e:\n143\t            # Check if error is retryable\n144\t            if not _is_retryable_error(e):\n145\t                logger.error(\n146\t                    \"Non-retryable error (%s): %s\",\n147\t                    type(e).__name__,\n148\t                    str(e),\n149\t                    extra={\n150\t                        \"error_type\": type(e).__name__,\n151\t                        \"error_message\": str(e),\n152\t                    },\n153\t                )\n154\t                raise\n155\t\n156\t            # Check if we have retries left\n157\t            if attempt >= max_retries - 1:\n158\t                logger.error(\n159\t                    \"Max retries (%d) exceeded: %s\",\n160\t                    max_retries,\n161\t                    str(e),\n162\t                    extra={\n163\t                        \"max_retries\": max_retries,\n164\t                        \"final_error\": str(e),\n165\t                        \"error_type\": type(e).__name__,\n166\t                    },\n167\t                )\n168\t                raise RuntimeError(f\"Max retries ({max_retries}) exceeded: {str(e)}\")\n169\t\n170\t            # Calculate wait time and retry\n171\t            wait_time = _calculate_wait_time(\n172\t                attempt, resolved_base_wait, resolved_max_wait, exponential_base, resolved_jitter, jitter_factor\n173\t            )\n174\t\n175\t            logger.warning(\n176\t                \"Retry %d/%d after %s: waiting %.2fs\",\n177\t                attempt + 1,\n178\t                max_retries,\n179\t                type(e).__name__,\n180\t                wait_time,\n181\t                extra={\n182\t                    \"retry_attempt\": attempt + 1,\n183\t                    \"max_retries\": max_retries,\n184\t                    \"error_type\": type(e).__name__,\n185\t                    \"wait_seconds\": wait_time,\n186\t                },\n187\t            )\n188\t\n189\t            time.sleep(wait_time)\n190\t\n191\t    # This should never be reached due to logic above, but satisfies mypy\n192\t    raise RuntimeError(f\"Max retries ({max_retries}) exceeded\")\n193\t"}]},"parent_tool_use_id":null,"session_id":"7dd06f03-9471-4f30-96ac-96686d5d0e21","uuid":"b2e81b9d-8471-42ee-aa14-f7242e6ed1cb","timestamp":"2026-05-12T17:51:00.508Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/autodev-worktrees/QuantAgent/QuantAgent-69d/planner-20260512T124234Z/quantagent/agent_utils.py","content":"\"\"\"\nShared utilities for agent implementations.\n\nProvides centralized retry logic with exponential backoff and structured output helpers.\n\"\"\"\n\nimport logging\nimport random\nimport time\nfrom typing import Callable, TypeVar\n\nfrom quantagent.default_config import RETRY_CONFIG\n\nlogger = logging.getLogger(__name__)\nT = TypeVar(\"T\")\n\n# Error patterns that trigger retry\nRETRYABLE_ERROR_PATTERNS = (\n    \"RateLimitError\",\n    \"APITimeoutError\",\n    \"APIConnectionError\",\n    \"Timeout\",\n    \"ConnectionError\",\n    \"ConnectError\",\n)\n\n\ndef _is_retryable_error(error: Exception) -> bool:\n    \"\"\"\n    Determine if an error should trigger a retry.\n\n    Args:\n        error: The exception to check\n\n    Returns:\n        True if error should be retried, False otherwise\n    \"\"\"\n    error_type = f\"{type(error).__module__}.{type(error).__name__}\"\n\n    # Check explicit retryable patterns\n    if any(pattern in error_type for pattern in RETRYABLE_ERROR_PATTERNS):\n        return True\n\n    # Check HTTP status if available\n    status_code = getattr(error, \"status_code\", None)\n    if status_code is not None:\n        # 429 (rate limit) and 5xx are retryable\n        return status_code == 429 or status_code >= 500\n\n    # Generic network/timeout errors by name\n    error_name_lower = type(error).__name__.lower()\n    if \"timeout\" in error_name_lower or \"connection\" in error_name_lower:\n        return True\n\n    return False\n\n\ndef _calculate_wait_time(\n    attempt: int,\n    base_wait: float,\n    max_wait: float,\n    exponential_base: float,\n    jitter: bool,\n    jitter_factor: float,\n) -> float:\n    \"\"\"\n    Calculate wait time with exponential backoff and optional jitter.\n\n    Args:\n        attempt: Current attempt number (0-indexed)\n        base_wait: Base wait time in seconds\n        max_wait: Maximum wait time cap\n        exponential_base: Multiplier for exponential backoff\n        jitter: Whether to add randomness\n        jitter_factor: Jitter range as fraction of wait time\n\n    Returns:\n        Calculated wait time in seconds\n    \"\"\"\n    # Exponential backoff: base * (exponential_base ^ attempt)\n    wait = base_wait * (exponential_base**attempt)\n\n    # Cap at max_wait\n    wait = min(wait, max_wait)\n\n    # Add jitter if enabled\n    if jitter:\n        jitter_range = wait * jitter_factor\n        wait = wait + random.uniform(-jitter_range / 2, jitter_range / 2)\n        # Floor to prevent negative/zero waits\n        wait = max(0.1, wait)\n\n    return wait\n\n\ndef invoke_with_retry(\n    call_fn: Callable[..., T],\n    *args,\n    retries: int | None = None,\n    base_wait: float | None = None,\n    max_wait: float | None = None,\n    jitter: bool | None = None,\n    **kwargs,\n) -> T:\n    \"\"\"\n    Centralized retry wrapper with exponential backoff.\n\n    Handles rate limiting and transient errors across multiple LLM providers\n    (OpenAI, Anthropic, Qwen). Uses exponential backoff with jitter.\n\n    Args:\n        call_fn: Function to call (typically llm.invoke)\n        *args: Positional arguments for call_fn\n        retries: Max retry attempts (default: from RETRY_CONFIG)\n        base_wait: Base wait time in seconds (default: from RETRY_CONFIG)\n        max_wait: Maximum wait time cap (default: from RETRY_CONFIG)\n        jitter: Add randomness to wait time (default: from RETRY_CONFIG)\n        **kwargs: Keyword arguments for call_fn\n\n    Returns:\n        Result from call_fn if successful\n\n    Raises:\n        RuntimeError: If all retries exhausted\n        Exception: Re-raised if error is not retryable\n\n    Example:\n        >>> result = invoke_with_retry(llm.invoke, messages)\n        >>> result = invoke_with_retry(llm.invoke, messages, retries=7, base_wait=4)\n    \"\"\"\n    # Resolve configuration (local override > global config)\n    max_retries: int = retries if retries is not None else int(RETRY_CONFIG[\"max_retries\"])\n    resolved_base_wait: float = base_wait if base_wait is not None else float(RETRY_CONFIG[\"base_wait\"])\n    resolved_max_wait: float = max_wait if max_wait is not None else float(RETRY_CONFIG[\"max_wait\"])\n    resolved_jitter: bool = jitter if jitter is not None else bool(RETRY_CONFIG[\"jitter\"])\n    exponential_base: float = float(RETRY_CONFIG[\"exponential_base\"])\n    jitter_factor: float = float(RETRY_CONFIG[\"jitter_factor\"])\n\n    for attempt in range(max_retries):\n        try:\n            return call_fn(*args, **kwargs)\n        except Exception as e:\n            # Check if error is retryable\n            if not _is_retryable_error(e):\n                logger.error(\n                    \"Non-retryable error (%s): %s\",\n                    type(e).__name__,\n                    str(e),\n                    extra={\n                        \"error_type\": type(e).__name__,\n                        \"error_message\": str(e),\n                    },\n                )\n                raise\n\n            # Check if we have retries left\n            if attempt >= max_retries - 1:\n                logger.error(\n                    \"Max retries (%d) exceeded: %s\",\n                    max_retries,\n                    str(e),\n                    extra={\n                        \"max_retries\": max_retries,\n                        \"final_error\": str(e),\n                        \"error_type\": type(e).__name__,\n                    },\n                )\n                raise RuntimeError(f\"Max retries ({max_retries}) exceeded: {str(e)}\")\n\n            # Calculate wait time and retry\n            wait_time = _calculate_wait_time(\n                attempt, resolved_base_wait, resolved_max_wait, exponential_base, resolved_jitter, jitter_factor\n            )\n\n            logger.warning(\n                \"Retry %d/%d after %s: waiting %.2fs\",\n                attempt + 1,\n                max_retries,\n                type(e).__name__,\n                wait_time,\n                extra={\n                    \"retry_attempt\": attempt + 1,\n                    \"max_retries\": max_retries,\n                    \"error_type\": type(e).__name__,\n                    \"wait_seconds\": wait_time,\n                },\n            )\n\n            time.sleep(wait_time)\n\n    # This should never be reached due to logic above, but satisfies mypy\n    raise RuntimeError(f\"Max retries ({max_retries}) exceeded\")\n","numLines":193,"startLine":1,"totalLines":193}}}
