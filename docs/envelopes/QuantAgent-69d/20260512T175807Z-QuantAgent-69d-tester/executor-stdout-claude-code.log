{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015ZrfoobnAbi79HELJKHJ6h","type":"tool_result","content":"1\t\"\"\"\n2\tUnit tests for agent_utils retry logic enhancement (QuantAgent-aao).\n3\t\n4\tTests exponential backoff, multi-provider error handling, configuration,\n5\tand backwards compatibility.\n6\t\"\"\"\n7\t\n8\timport logging\n9\timport random\n10\tfrom unittest.mock import Mock, patch\n11\t\n12\timport pytest\n13\t\n14\tfrom quantagent.agent_utils import (\n15\t    _calculate_wait_time,\n16\t    _is_retryable_error,\n17\t    invoke_with_retry,\n18\t)\n19\t\n20\t# ============================================================================\n21\t# AC1: Core Retry Functionality\n22\t# ============================================================================\n23\t\n24\t\n25\tdef test_invoke_with_retry_success_first_attempt():\n26\t    \"\"\"AC1.1: Success on first attempt - no retries.\"\"\"\n27\t    mock_fn = Mock(return_value=\"success\")\n28\t\n29\t    with patch(\"time.sleep\") as mock_sleep:\n30\t        result = invoke_with_retry(mock_fn)\n31\t\n32\t    assert result == \"success\"\n33\t    assert mock_fn.call_count == 1\n34\t    assert mock_sleep.call_count == 0\n35\t\n36\t\n37\tdef test_invoke_with_retry_success_after_retries():\n38\t    \"\"\"AC1.2: Success after retries - returns result from successful attempt.\"\"\"\n39\t\n40\t    class MockRateLimitError(Exception):\n41\t        pass\n42\t\n43\t    MockRateLimitError.__module__ = \"openai\"\n44\t    MockRateLimitError.__name__ = \"RateLimitError\"\n45\t\n46\t    mock_fn = Mock(\n47\t        side_effect=[\n48\t            MockRateLimitError(\"rate limited\"),\n49\t            MockRateLimitError(\"rate limited\"),\n50\t            \"success\",\n51\t        ]\n52\t    )\n53\t\n54\t    with patch(\"time.sleep\"):\n55\t        result = invoke_with_retry(mock_fn, retries=5)\n56\t\n57\t    assert result == \"success\"\n58\t    assert mock_fn.call_count == 3\n59\t\n60\t\n61\tdef test_invoke_with_retry_max_retries_exceeded():\n62\t    \"\"\"AC1.3: Max retries exceeded - raises RuntimeError.\"\"\"\n63\t\n64\t    class MockRateLimitError(Exception):\n65\t        pass\n66\t\n67\t    MockRateLimitError.__module__ = \"openai\"\n68\t    MockRateLimitError.__name__ = \"RateLimitError\"\n69\t\n70\t    mock_fn = Mock(side_effect=MockRateLimitError(\"rate limited\"))\n71\t\n72\t    with patch(\"time.sleep\") as mock_sleep:\n73\t        with pytest.raises(RuntimeError, match=\"Max retries \\\\(3\\\\) exceeded\"):\n74\t            invoke_with_retry(mock_fn, retries=3)\n75\t\n76\t    assert mock_fn.call_count == 3\n77\t    assert mock_sleep.call_count == 2  # No sleep after last attempt\n78\t\n79\t\n80\t# ============================================================================\n81\t# AC2: Exponential Backoff\n82\t# ============================================================================\n83\t\n84\t\n85\tdef test_exponential_backoff_calculation():\n86\t    \"\"\"AC2.1: Exponential wait time calculation without jitter.\"\"\"\n87\t    # Test wait time progression: 2, 4, 8, 16, 32, 60 (capped)\n88\t    test_cases = [\n89\t        (0, 2.0),  # attempt 0: 2 * 2^0 = 2\n90\t        (1, 4.0),  # attempt 1: 2 * 2^1 = 4\n91\t        (2, 8.0),  # attempt 2: 2 * 2^2 = 8\n92\t        (3, 16.0),  # attempt 3: 2 * 2^3 = 16\n93\t        (4, 32.0),  # attempt 4: 2 * 2^4 = 32\n94\t        (5, 60.0),  # attempt 5: 2 * 2^5 = 64, capped at 60\n95\t    ]\n96\t\n97\t    for attempt, expected_wait in test_cases:\n98\t        wait = _calculate_wait_time(\n99\t            attempt=attempt,\n100\t            base_wait=2.0,\n101\t            max_wait=60.0,\n102\t            exponential_base=2,\n103\t            jitter=False,\n104\t            jitter_factor=0.5,\n105\t        )\n106\t        assert wait == expected_wait, f\"Attempt {attempt} expected {expected_wait}, got {wait}\"\n107\t\n108\t\n109\tdef test_max_wait_cap_applied():\n110\t    \"\"\"AC2.2: Max wait cap prevents excessive delays.\"\"\"\n111\t    # With base=2, max=10, check that waits are capped\n112\t    expected_waits = [2.0, 4.0, 8.0, 10.0, 10.0]\n113\t\n114\t    for attempt, expected in enumerate(expected_waits):\n115\t        wait = _calculate_wait_time(\n116\t            attempt=attempt,\n117\t            base_wait=2.0,\n118\t            max_wait=10.0,\n119\t            exponential_base=2,\n120\t            jitter=False,\n121\t            jitter_factor=0.5,\n122\t        )\n123\t        assert wait == expected\n124\t\n125\t\n126\tdef test_jitter_within_bounds():\n127\t    \"\"\"AC2.3: Jitter produces values within expected range.\"\"\"\n128\t    random.seed(42)  # For reproducibility\n129\t\n130\t    # base_wait=4, jitter_factor=0.5\n131\t    # jitter_range = 4 * 0.5 = 2\n132\t    # wait = 4 + uniform(-1, 1) = [3.0, 5.0]\n133\t\n134\t    for _ in range(100):\n135\t        wait = _calculate_wait_time(\n136\t            attempt=0,\n137\t            base_wait=4.0,\n138\t            max_wait=60.0,\n139\t            exponential_base=2,\n140\t            jitter=True,\n141\t            jitter_factor=0.5,\n142\t        )\n143\t        assert 3.0 <= wait <= 5.0, f\"Wait {wait} outside expected range [3.0, 5.0]\"\n144\t\n145\t\n146\tdef test_jitter_does_not_produce_negative_wait():\n147\t    \"\"\"AC6.3: Jitter floor prevents negative wait times.\"\"\"\n148\t    random.seed(42)\n149\t\n150\t    for _ in range(1000):\n151\t        wait = _calculate_wait_time(\n152\t            attempt=0,\n153\t            base_wait=0.1,\n154\t            max_wait=60.0,\n155\t            exponential_base=2,\n156\t            jitter=True,\n157\t            jitter_factor=1.0,\n158\t        )\n159\t        assert wait >= 0.1, f\"Wait {wait} is below floor\"\n160\t\n161\t\n162\t# ============================================================================\n163\t# AC3: Multi-Provider Support\n164\t# ============================================================================\n165\t\n166\t\n167\tdef test_openai_rate_limit_error_triggers_retry():\n168\t    \"\"\"AC3.1: OpenAI RateLimitError triggers retry.\"\"\"\n169\t\n170\t    class MockRateLimitError(Exception):\n171\t        pass\n172\t\n173\t    MockRateLimitError.__module__ = \"openai\"\n174\t    MockRateLimitError.__name__ = \"RateLimitError\"\n175\t\n176\t    mock_fn = Mock(side_effect=[MockRateLimitError(\"rate limited\"), \"success\"])\n177\t\n178\t    with patch(\"time.sleep\"):\n179\t        result = invoke_with_retry(mock_fn, retries=3)\n180\t\n181\t    assert result == \"success\"\n182\t    assert mock_fn.call_count == 2\n183\t\n184\t\n185\tdef test_anthropic_rate_limit_error_triggers_retry():\n186\t    \"\"\"AC3.2: Anthropic RateLimitError triggers retry.\"\"\"\n187\t\n188\t    class MockAnthropicRateLimitError(Exception):\n189\t        pass\n190\t\n191\t    MockAnthropicRateLimitError.__module__ = \"anthropic\"\n192\t    MockAnthropicRateLimitError.__name__ = \"RateLimitError\"\n193\t\n194\t    mock_fn = Mock(side_effect=[MockAnthropicRateLimitError(), \"success\"])\n195\t\n196\t    with patch(\"time.sleep\"):\n197\t        result = invoke_with_retry(mock_fn, retries=3)\n198\t\n199\t    assert result == \"success\"\n200\t    assert mock_fn.call_count == 2\n201\t\n202\t\n203\tdef test_timeout_errors_trigger_retry():\n204\t    \"\"\"AC3.3: Timeout errors trigger retry.\"\"\"\n205\t\n206\t    class MockTimeout(Exception):\n207\t        pass\n208\t\n209\t    MockTimeout.__module__ = \"requests.exceptions\"\n210\t    MockTimeout.__name__ = \"Timeout\"\n211\t\n212\t    mock_fn = Mock(side_effect=[MockTimeout(\"timeout\"), \"success\"])\n213\t\n214\t    with patch(\"time.sleep\"):\n215\t        result = invoke_with_retry(mock_fn, retries=3)\n216\t\n217\t    assert result == \"success\"\n218\t    assert mock_fn.call_count == 2\n219\t\n220\t\n221\tdef test_connection_errors_trigger_retry():\n222\t    \"\"\"AC3.4: Connection errors trigger retry.\"\"\"\n223\t\n224\t    class MockConnectionError(Exception):\n225\t        pass\n226\t\n227\t    MockConnectionError.__module__ = \"requests.exceptions\"\n228\t    MockConnectionError.__name__ = \"ConnectionError\"\n229\t\n230\t    mock_fn = Mock(side_effect=[MockConnectionError(\"connection failed\"), \"success\"])\n231\t\n232\t    with patch(\"time.sleep\"):\n233\t        result = invoke_with_retry(mock_fn, retries=3)\n234\t\n235\t    assert result == \"success\"\n236\t    assert mock_fn.call_count == 2\n237\t\n238\t\n239\tdef test_authentication_error_does_not_retry():\n240\t    \"\"\"AC3.5: Authentication error (4xx) fails immediately without retry.\"\"\"\n241\t\n242\t    class MockAuthenticationError(Exception):\n243\t        pass\n244\t\n245\t    MockAuthenticationError.__module__ = \"openai\"\n246\t    MockAuthenticationError.__name__ = \"AuthenticationError\"\n247\t\n248\t    mock_fn = Mock(side_effect=MockAuthenticationError(\"Invalid API key\"))\n249\t\n250\t    with pytest.raises(MockAuthenticationError):\n251\t        invoke_with_retry(mock_fn, retries=5)\n252\t\n253\t    assert mock_fn.call_count == 1  # No retries\n254\t\n255\t\n256\tdef test_bad_request_error_does_not_retry():\n257\t    \"\"\"AC3.6: BadRequestError (400) fails immediately without retry.\"\"\"\n258\t\n259\t    class MockBadRequestError(Exception):\n260\t        pass\n261\t\n262\t    MockBadRequestError.__module__ = \"openai\"\n263\t    MockBadRequestError.__name__ = \"BadRequestError\"\n264\t\n265\t    mock_fn = Mock(side_effect=MockBadRequestError(\"Invalid request\"))\n266\t\n267\t    with pytest.raises(MockBadRequestError):\n268\t        invoke_with_retry(mock_fn, retries=5)\n269\t\n270\t    assert mock_fn.call_count == 1\n271\t\n272\t\n273\tdef test_http_429_status_code_triggers_retry():\n274\t    \"\"\"AC3.7: HTTP 429 status code triggers retry.\"\"\"\n275\t\n276\t    class HTTPError(Exception):\n277\t        def __init__(self, status_code):\n278\t            self.status_code = status_code\n279\t            super().__init__(f\"HTTP {status_code}\")\n280\t\n281\t    mock_fn = Mock(side_effect=[HTTPError(429), \"success\"])\n282\t\n283\t    with patch(\"time.sleep\"):\n284\t        result = invoke_with_retry(mock_fn, retries=3)\n285\t\n286\t    assert result == \"success\"\n287\t    assert mock_fn.call_count == 2\n288\t\n289\t\n290\tdef test_http_5xx_status_codes_trigger_retry():\n291\t    \"\"\"AC3.8: HTTP 5xx status codes trigger retry.\"\"\"\n292\t\n293\t    class HTTPError(Exception):\n294\t        def __init__(self, status_code):\n295\t            self.status_code = status_code\n296\t            super().__init__(f\"HTTP {status_code}\")\n297\t\n298\t    for status in [500, 502, 503, 504]:\n299\t        mock_fn = Mock(side_effect=[HTTPError(status), \"success\"])\n300\t\n301\t        with patch(\"time.sleep\"):\n302\t            result = invoke_with_retry(mock_fn, retries=3)\n303\t\n304\t        assert result == \"success\"\n305\t        assert mock_fn.call_count == 2\n306\t\n307\t\n308\t# ============================================================================\n309\t# AC4: Configuration\n310\t# ============================================================================\n311\t\n312\t\n313\tdef test_global_config_applied_by_default():\n314\t    \"\"\"AC4.1: Global config from RETRY_CONFIG used by default.\"\"\"\n315\t    from quantagent.default_config import RETRY_CONFIG\n316\t\n317\t    class MockRateLimitError(Exception):\n318\t        pass\n319\t\n320\t    MockRateLimitError.__module__ = \"openai\"\n321\t    MockRateLimitError.__name__ = \"RateLimitError\"\n322\t\n323\t    # Use actual RETRY_CONFIG value to avoid brittleness\n324\t    expected_retries = int(RETRY_CONFIG[\"max_retries\"])\n325\t    mock_fn = Mock(side_effect=[MockRateLimitError()] * (expected_retries - 1) + [\"success\"])\n326\t\n327\t    with patch(\"time.sleep\"):\n328\t        result = invoke_with_retry(mock_fn)\n329\t\n330\t    assert result == \"success\"\n331\t    assert mock_fn.call_count == expected_retries\n332\t\n333\t\n334\tdef test_per_call_config_overrides_global():\n335\t    \"\"\"AC4.2: Per-call config overrides global config.\"\"\"\n336\t\n337\t    class MockRateLimitError(Exception):\n338\t        pass\n339\t\n340\t    MockRateLimitError.__module__ = \"openai\"\n341\t    MockRateLimitError.__name__ = \"RateLimitError\"\n342\t\n343\t    mock_fn = Mock(side_effect=[MockRateLimitError()] * 5)\n344\t\n345\t    with patch(\"time.sleep\"):\n346\t        with pytest.raises(RuntimeError, match=\"Max retries \\\\(2\\\\) exceeded\"):\n347\t            invoke_with_retry(mock_fn, retries=2)\n348\t\n349\t    assert mock_fn.call_count == 2  # Not 5\n350\t\n351\t\n352\tdef test_partial_override_mix_global_and_local():\n353\t    \"\"\"AC4.3: Partial override uses mix of global and local config.\"\"\"\n354\t\n355\t    class MockRateLimitError(Exception):\n356\t        pass\n357\t\n358\t    MockRateLimitError.__module__ = \"openai\"\n359\t    MockRateLimitError.__name__ = \"RateLimitError\"\n360\t\n361\t    mock_fn = Mock(side_effect=[MockRateLimitError(), \"success\"])\n362\t\n363\t    with patch(\"time.sleep\") as mock_sleep:\n364\t        result = invoke_with_retry(mock_fn, base_wait=10.0, jitter=False)\n365\t\n366\t    assert result == \"success\"\n367\t    assert mock_fn.call_count == 2\n368\t    mock_sleep.assert_called_once_with(10.0)  # Local base_wait used\n369\t\n370\t\n371\t# ============================================================================\n372\t# AC5: Backwards Compatibility\n373\t# ============================================================================\n374\t\n375\t\n376\tdef test_explicit_base_wait_parameter_is_used():\n377\t    \"\"\"AC5.1: Explicit base_wait parameter overrides configuration.\"\"\"\n378\t\n379\t    class MockRateLimitError(Exception):\n380\t        pass\n381\t\n382\t    MockRateLimitError.__module__ = \"openai\"\n383\t    MockRateLimitError.__name__ = \"RateLimitError\"\n384\t\n385\t    mock_fn = Mock(side_effect=[MockRateLimitError(), \"success\"])\n386\t\n387\t    with patch(\"time.sleep\") as mock_sleep:\n388\t        result = invoke_with_retry(mock_fn, retries=3, base_wait=4, jitter=False)\n389\t\n390\t    assert result == \"success\"\n391\t    mock_sleep.assert_called_once_with(4.0)\n392\t\n393\t\n394\t# ============================================================================\n395\t# AC6: Edge Cases\n396\t# ============================================================================\n397\t\n398\t\n399\tdef test_zero_retries():\n400\t    \"\"\"AC6.1: Zero retries (retries=1) raises immediately on failure.\"\"\"\n401\t\n402\t    class MockRateLimitError(Exception):\n403\t        pass\n404\t\n405\t    MockRateLimitError.__module__ = \"openai\"\n406\t    MockRateLimitError.__name__ = \"RateLimitError\"\n407\t\n408\t    mock_fn = Mock(side_effect=MockRateLimitError())\n409\t\n410\t    with pytest.raises(RuntimeError):\n411\t        invoke_with_retry(mock_fn, retries=1)\n412\t\n413\t    assert mock_fn.call_count == 1\n414\t\n415\t\n416\tdef test_function_returns_none_successfully():\n417\t    \"\"\"AC6.4: Function returning None is treated as success.\"\"\"\n418\t    mock_fn = Mock(return_value=None)\n419\t\n420\t    result = invoke_with_retry(mock_fn)\n421\t\n422\t    assert result is None\n423\t    assert mock_fn.call_count == 1\n424\t\n425\t\n426\tdef test_function_with_args_and_kwargs():\n427\t    \"\"\"AC6.5: Function with positional and keyword arguments.\"\"\"\n428\t    mock_fn = Mock(return_value=\"success\")\n429\t\n430\t    invoke_with_retry(mock_fn, \"pos1\", \"pos2\", key1=\"val1\", key2=\"val2\")\n431\t\n432\t    mock_fn.assert_called_once_with(\"pos1\", \"pos2\", key1=\"val1\", key2=\"val2\")\n433\t\n434\t\n435\t# ============================================================================\n436\t# AC7: Logging\n437\t# ============================================================================\n438\t\n439\t\n440\tdef test_warning_on_each_retry(caplog):\n441\t    \"\"\"AC7.1: WARNING log emitted on each retry.\"\"\"\n442\t\n443\t    class MockRateLimitError(Exception):\n444\t        pass\n445\t\n446\t    MockRateLimitError.__module__ = \"openai\"\n447\t    MockRateLimitError.__name__ = \"RateLimitError\"\n448\t\n449\t    mock_fn = Mock(\n450\t        side_effect=[MockRateLimitError(), MockRateLimitError(), \"success\"]\n451\t    )\n452\t\n453\t    with caplog.at_level(logging.WARNING):\n454\t        with patch(\"time.sleep\"):\n455\t            invoke_with_retry(mock_fn, retries=5)\n456\t\n457\t    assert \"Retry 1/5\" in caplog.text\n458\t    assert \"Retry 2/5\" in caplog.text\n459\t\n460\t\n461\tdef test_error_on_final_failure(caplog):\n462\t    \"\"\"AC7.2: ERROR log emitted on final failure.\"\"\"\n463\t\n464\t    class MockRateLimitError(Exception):\n465\t        pass\n466\t\n467\t    MockRateLimitError.__module__ = \"openai\"\n468\t    MockRateLimitError.__name__ = \"RateLimitError\"\n469\t\n470\t    mock_fn = Mock(side_effect=MockRateLimitError(\"rate limited\"))\n471\t\n472\t    with caplog.at_level(logging.ERROR):\n473\t        with patch(\"time.sleep\"):\n474\t            with pytest.raises(RuntimeError):\n475\t                invoke_with_retry(mock_fn, retries=5)\n476\t\n477\t    assert \"Max retries (5) exceeded\" in caplog.text\n478\t\n479\t\n480\tdef test_no_logs_on_success(caplog):\n481\t    \"\"\"AC7.3: No WARNING/ERROR logs on first-try success.\"\"\"\n482\t    mock_fn = Mock(return_value=\"success\")\n483\t\n484\t    with caplog.at_level(logging.WARNING):\n485\t        invoke_with_retry(mock_fn)\n486\t\n487\t    # Should have no WARNING or ERROR logs\n488\t    assert len(caplog.records) == 0\n489\t\n490\t\n491\t# ============================================================================\n492\t# Additional Tests (Missing ACs)\n493\t# ============================================================================\n494\t\n495\t\n496\tdef test_jitter_reproducible_with_seed():\n497\t    \"\"\"AC2.4: Jitter calculations are reproducible with seed.\"\"\"\n498\t    random.seed(42)\n499\t    waits1 = [\n500\t        _calculate_wait_time(\n501\t            attempt=0,\n502\t            base_wait=4.0,\n503\t            max_wait=60.0,\n504\t            exponential_base=2,\n505\t            jitter=True,\n506\t            jitter_factor=0.5,\n507\t        )\n508\t        for _ in range(10)\n509\t    ]\n510\t\n511\t    random.seed(42)\n512\t    waits2 = [\n513\t        _calculate_wait_time(\n514\t            attempt=0,\n515\t            base_wait=4.0,\n516\t            max_wait=60.0,\n517\t            exponential_base=2,\n518\t            jitter=True,\n519\t            jitter_factor=0.5,\n520\t        )\n521\t        for _ in range(10)\n522\t    ]\n523\t\n524\t    assert waits1 == waits2\n525\t\n526\t\n527\tdef test_very_large_max_wait_applied():\n528\t    \"\"\"AC6.2: Very large max_wait values are respected.\"\"\"\n529\t    wait = _calculate_wait_time(\n530\t        attempt=12,  # 2 * 2^12 = 8192 > 3600\n531\t        base_wait=2.0,\n532\t        max_wait=3600.0,  # 1 hour\n533\t        exponential_base=2,\n534\t        jitter=False,\n535\t        jitter_factor=0.5,\n536\t    )\n537\t    assert wait == 3600.0  # Should be capped\n538\t\n539\t\n540\tdef test_exponential_backoff_full_sequence():\n541\t    \"\"\"Verify full exponential backoff sequence with real timing.\"\"\"\n542\t\n543\t    class MockRateLimitError(Exception):\n544\t        pass\n545\t\n546\t    MockRateLimitError.__module__ = \"openai\"\n547\t    MockRateLimitError.__name__ = \"RateLimitError\"\n548\t\n549\t    mock_fn = Mock(side_effect=[MockRateLimitError()] * 3 + [\"success\"])\n550\t\n551\t    with patch(\"time.sleep\") as mock_sleep:\n552\t        result = invoke_with_retry(\n553\t            mock_fn, retries=5, base_wait=2.0, max_wait=60.0, jitter=False\n554\t        )\n555\t\n556\t    assert result == \"success\"\n557\t    assert mock_sleep.call_count == 3\n558\t    expected_waits = [2.0, 4.0, 8.0]\n559\t    actual_waits = [call.args[0] for call in mock_sleep.call_args_list]\n560\t    assert actual_waits == expected_waits\n561\t\n562\t\n563\tdef test_no_sleep_after_final_failure():\n564\t    \"\"\"Verify no sleep occurs after the final failed attempt.\"\"\"\n565\t\n566\t    class MockRateLimitError(Exception):\n567\t        pass\n568\t\n569\t    MockRateLimitError.__module__ = \"openai\"\n570\t    MockRateLimitError.__name__ = \"RateLimitError\"\n571\t\n572\t    mock_fn = Mock(side_effect=MockRateLimitError())\n573\t\n574\t    with patch(\"time.sleep\") as mock_sleep:\n575\t        with pytest.raises(RuntimeError):\n576\t            invoke_with_retry(mock_fn, retries=3)\n577\t\n578\t    # Should sleep only between attempts (not after last)\n579\t    assert mock_sleep.call_count == 2  # retries=3 → 3 attempts → 2 sleeps\n580\t\n581\t\n582\t@pytest.mark.parametrize(\n583\t    \"error_module,error_name\",\n584\t    [\n585\t        (\"openai\", \"RateLimitError\"),\n586\t        (\"anthropic\", \"RateLimitError\"),\n587\t        (\"requests.exceptions\", \"Timeout\"),\n588\t        (\"requests.exceptions\", \"ConnectionError\"),\n589\t    ],\n590\t)\n591\tdef test_retryable_errors_parametrized(error_module, error_name):\n592\t    \"\"\"AC3: All documented retryable errors trigger retry (parametrized).\"\"\"\n593\t\n594\t    class MockError(Exception):\n595\t        pass\n596\t\n597\t    MockError.__module__ = error_module\n598\t    MockError.__name__ = error_name\n599\t\n600\t    mock_fn = Mock(side_effect=[MockError(), \"success\"])\n601\t\n602\t    with patch(\"time.sleep\"):\n603\t        result = invoke_with_retry(mock_fn, retries=3)\n604\t\n605\t    assert result == \"success\"\n606\t    assert mock_fn.call_count == 2\n607\t\n608\t\n609\t# ============================================================================\n610\t# Helper Function Tests\n611\t# ============================================================================\n612\t\n613\t\n614\t@pytest.mark.parametrize(\n615\t    \"error_type,module,name,expected_retryable\",\n616\t    [\n617\t        (\"RateLimitError\", \"openai\", \"RateLimitError\", True),\n618\t        (\"RateLimitError\", \"anthropic\", \"RateLimitError\", True),\n619\t        (\"Timeout\", \"requests.exceptions\", \"Timeout\", True),\n620\t        (\"ConnectionError\", \"requests.exceptions\", \"ConnectionError\", True),\n621\t        (\"AuthenticationError\", \"openai\", \"AuthenticationError\", False),\n622\t        (\"BadRequestError\", \"openai\", \"BadRequestError\", False),\n623\t    ],\n624\t)\n625\tdef test_is_retryable_error_parametrized(error_type, module, name, expected_retryable):\n626\t    \"\"\"Test _is_retryable_error correctly identifies retryable vs non-retryable errors.\"\"\"\n627\t\n628\t    class MockError(Exception):\n629\t        pass\n630\t\n631\t    MockError.__module__ = module\n632\t    MockError.__name__ = name\n633\t\n634\t    error = MockError()\n635\t    assert _is_retryable_error(error) is expected_retryable\n636\t\n637\t\n638\t@pytest.mark.parametrize(\n639\t    \"status_code,expected_retryable\",\n640\t    [\n641\t        (429, True),\n642\t        (500, True),\n643\t        (502, True),\n644\t        (503, True),\n645\t        (504, True),\n646\t        (400, False),\n647\t        (401, False),\n648\t        (403, False),\n649\t        (404, False),\n650\t    ],\n651\t)\n652\tdef test_is_retryable_error_status_codes(status_code, expected_retryable):\n653\t    \"\"\"Test _is_retryable_error checks status_code attribute correctly.\"\"\"\n654\t\n655\t    class HTTPError(Exception):\n656\t        def __init__(self, status_code):\n657\t            self.status_code = status_code\n658\t\n659\t    assert _is_retryable_error(HTTPError(status_code)) is expected_retryable\n660\t"}]},"parent_tool_use_id":null,"session_id":"6027cba3-e69d-464f-aa78-e9e9792aa2ae","uuid":"77ad8de5-d73f-4c3b-9f03-921125904c5b","timestamp":"2026-05-12T17:58:55.076Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/autodev-worktrees/QuantAgent/QuantAgent-69d/planner-20260512T124234Z/tests/test_agent_utils_retry.py","content":"\"\"\"\nUnit tests for agent_utils retry logic enhancement (QuantAgent-aao).\n\nTests exponential backoff, multi-provider error handling, configuration,\nand backwards compatibility.\n\"\"\"\n\nimport logging\nimport random\nfrom unittest.mock import Mock, patch\n\nimport pytest\n\nfrom quantagent.agent_utils import (\n    _calculate_wait_time,\n    _is_retryable_error,\n    invoke_with_retry,\n)\n\n# ============================================================================\n# AC1: Core Retry Functionality\n# ============================================================================\n\n\ndef test_invoke_with_retry_success_first_attempt():\n    \"\"\"AC1.1: Success on first attempt - no retries.\"\"\"\n    mock_fn = Mock(return_value=\"success\")\n\n    with patch(\"time.sleep\") as mock_sleep:\n        result = invoke_with_retry(mock_fn)\n\n    assert result == \"success\"\n    assert mock_fn.call_count == 1\n    assert mock_sleep.call_count == 0\n\n\ndef test_invoke_with_retry_success_after_retries():\n    \"\"\"AC1.2: Success after retries - returns result from successful attempt.\"\"\"\n\n    class MockRateLimitError(Exception):\n        pass\n\n    MockRateLimitError.__module__ = \"openai\"\n    MockRateLimitError.__name__ = \"RateLimitError\"\n\n    mock_fn = Mock(\n        side_effect=[\n            MockRateLimitError(\"rate limited\"),\n            MockRateLimitError(\"rate limited\"),\n            \"success\",\n        ]\n    )\n\n    with patch(\"time.sleep\"):\n        result = invoke_with_retry(mock_fn, retries=5)\n\n    assert result == \"success\"\n    assert mock_fn.call_count == 3\n\n\ndef test_invoke_with_retry_max_retries_exceeded():\n    \"\"\"AC1.3: Max retries exceeded - raises RuntimeError.\"\"\"\n\n    class MockRateLimitError(Exception):\n        pass\n\n    MockRateLimitError.__module__ = \"openai\"\n    MockRateLimitError.__name__ = \"RateLimitError\"\n\n    mock_fn = Mock(side_effect=MockRateLimitError(\"rate limited\"))\n\n    with patch(\"time.sleep\") as mock_sleep:\n        with pytest.raises(RuntimeError, match=\"Max retries \\\\(3\\\\) exceeded\"):\n            invoke_with_retry(mock_fn, retries=3)\n\n    assert mock_fn.call_count == 3\n    assert mock_sleep.call_count == 2  # No sleep after last attempt\n\n\n# ============================================================================\n# AC2: Exponential Backoff\n# ============================================================================\n\n\ndef test_exponential_backoff_calculation():\n    \"\"\"AC2.1: Exponential wait time calculation without jitter.\"\"\"\n    # Test wait time progression: 2, 4, 8, 16, 32, 60 (capped)\n    test_cases = [\n        (0, 2.0),  # attempt 0: 2 * 2^0 = 2\n        (1, 4.0),  # attempt 1: 2 * 2^1 = 4\n        (2, 8.0),  # attempt 2: 2 * 2^2 = 8\n        (3, 16.0),  # attempt 3: 2 * 2^3 = 16\n        (4, 32.0),  # attempt 4: 2 * 2^4 = 32\n        (5, 60.0),  # attempt 5: 2 * 2^5 = 64, capped at 60\n    ]\n\n    for attempt, expected_wait in test_cases:\n        wait = _calculate_wait_time(\n            attempt=attempt,\n            base_wait=2.0,\n            max_wait=60.0,\n            exponential_base=2,\n            jitter=False,\n            jitter_factor=0.5,\n        )\n        assert wait == expected_wait, f\"Attempt {attempt} expected {expected_wait}, got {wait}\"\n\n\ndef test_max_wait_cap_applied():\n    \"\"\"AC2.2: Max wait cap prevents excessive delays.\"\"\"\n    # With base=2, max=10, check that waits are capped\n    expected_waits = [2.0, 4.0, 8.0, 10.0, 10.0]\n\n    for attempt, expected in enumerate(expected_waits):\n        wait = _calculate_wait_time(\n            attempt=attempt,\n            base_wait=2.0,\n            max_wait=10.0,\n            exponential_base=2,\n            jitter=False,\n            jitter_factor=0.5,\n        )\n        assert wait == expected\n\n\ndef test_jitter_within_bounds():\n    \"\"\"AC2.3: Jitter produces values within expected range.\"\"\"\n    random.seed(42)  # For reproducibility\n\n    # base_wait=4, jitter_factor=0.5\n    # jitter_range = 4 * 0.5 = 2\n    # wait = 4 + uniform(-1, 1) = [3.0, 5.0]\n\n    for _ in range(100):\n        wait = _calculate_wait_time(\n            attempt=0,\n            base_wait=4.0,\n            max_wait=60.0,\n            exponential_base=2,\n            jitter=True,\n            jitter_factor=0.5,\n        )\n        assert 3.0 <= wait <= 5.0, f\"Wait {wait} outside expected range [3.0, 5.0]\"\n\n\ndef test_jitter_does_not_produce_negative_wait():\n    \"\"\"AC6.3: Jitter floor prevents negative wait times.\"\"\"\n    random.seed(42)\n\n    for _ in range(1000):\n        wait = _calculate_wait_time(\n            attempt=0,\n            base_wait=0.1,\n            max_wait=60.0,\n            exponential_base=2,\n            jitter=True,\n            jitter_factor=1.0,\n        )\n        assert wait >= 0.1, f\"Wait {wait} is below floor\"\n\n\n# ============================================================================\n# AC3: Multi-Provider Support\n# ============================================================================\n\n\ndef test_openai_rate_limit_error_triggers_retry():\n    \"\"\"AC3.1: OpenAI RateLimitError triggers retry.\"\"\"\n\n    class MockRateLimitError(Exception):\n        pass\n\n    MockRateLimitError.__module__ = \"openai\"\n    MockRateLimitError.__name__ = \"RateLimitError\"\n\n    mock_fn = Mock(side_effect=[MockRateLimitError(\"rate limited\"), \"success\"])\n\n    with patch(\"time.sleep\"):\n        result = invoke_with_retry(mock_fn, retries=3)\n\n    assert result == \"success\"\n    assert mock_fn.call_count == 2\n\n\ndef test_anthropic_rate_limit_error_triggers_retry():\n    \"\"\"AC3.2: Anthropic RateLimitError triggers retry.\"\"\"\n\n    class MockAnthropicRateLimitError(Exception):\n        pass\n\n    MockAnthropicRateLimitError.__module__ = \"anthropic\"\n    MockAnthropicRateLimitError.__name__ = \"RateLimitError\"\n\n    mock_fn = Mock(side_effect=[MockAnthropicRateLimitError(), \"success\"])\n\n    with patch(\"time.sleep\"):\n        result = invoke_with_retry(mock_fn, retries=3)\n\n    assert result == \"success\"\n    assert mock_fn.call_count == 2\n\n\ndef test_timeout_errors_trigger_retry():\n    \"\"\"AC3.3: Timeout errors trigger retry.\"\"\"\n\n    class MockTimeout(Exception):\n        pass\n\n    MockTimeout.__module__ = \"requests.exceptions\"\n    MockTimeout.__name__ = \"Timeout\"\n\n    mock_fn = Mock(side_effect=[MockTimeout(\"timeout\"), \"success\"])\n\n    with patch(\"time.sleep\"):\n        result = invoke_with_retry(mock_fn, retries=3)\n\n    assert result == \"success\"\n    assert mock_fn.call_count == 2\n\n\ndef test_connection_errors_trigger_retry():\n    \"\"\"AC3.4: Connection errors trigger retry.\"\"\"\n\n    class MockConnectionError(Exception):\n        pass\n\n    MockConnectionError.__module__ = \"requests.exceptions\"\n    MockConnectionError.__name__ = \"ConnectionError\"\n\n    mock_fn = Mock(side_effect=[MockConnectionError(\"connection failed\"), \"success\"])\n\n    with patch(\"time.sleep\"):\n        result = invoke_with_retry(mock_fn, retries=3)\n\n    assert result == \"success\"\n    assert mock_fn.call_count == 2\n\n\ndef test_authentication_error_does_not_retry():\n    \"\"\"AC3.5: Authentication error (4xx) fails immediately without retry.\"\"\"\n\n    class MockAuthenticationError(Exception):\n        pass\n\n    MockAuthenticationError.__module__ = \"openai\"\n    MockAuthenticationError.__name__ = \"AuthenticationError\"\n\n    mock_fn = Mock(side_effect=MockAuthenticationError(\"Invalid API key\"))\n\n    with pytest.raises(MockAuthenticationError):\n        invoke_with_retry(mock_fn, retries=5)\n\n    assert mock_fn.call_count == 1  # No retries\n\n\ndef test_bad_request_error_does_not_retry():\n    \"\"\"AC3.6: BadRequestError (400) fails immediately without retry.\"\"\"\n\n    class MockBadRequestError(Exception):\n        pass\n\n    MockBadRequestError.__module__ = \"openai\"\n    MockBadRequestError.__name__ = \"BadRequestError\"\n\n    mock_fn = Mock(side_effect=MockBadRequestError(\"Invalid request\"))\n\n    with pytest.raises(MockBadRequestError):\n        invoke_with_retry(mock_fn, retries=5)\n\n    assert mock_fn.call_count == 1\n\n\ndef test_http_429_status_code_triggers_retry():\n    \"\"\"AC3.7: HTTP 429 status code triggers retry.\"\"\"\n\n    class HTTPError(Exception):\n        def __init__(self, status_code):\n            self.status_code = status_code\n            super().__init__(f\"HTTP {status_code}\")\n\n    mock_fn = Mock(side_effect=[HTTPError(429), \"success\"])\n\n    with patch(\"time.sleep\"):\n        result = invoke_with_retry(mock_fn, retries=3)\n\n    assert result == \"success\"\n    assert mock_fn.call_count == 2\n\n\ndef test_http_5xx_status_codes_trigger_retry():\n    \"\"\"AC3.8: HTTP 5xx status codes trigger retry.\"\"\"\n\n    class HTTPError(Exception):\n        def __init__(self, status_code):\n            self.status_code = status_code\n            super().__init__(f\"HTTP {status_code}\")\n\n    for status in [500, 502, 503, 504]:\n        mock_fn = Mock(side_effect=[HTTPError(status), \"success\"])\n\n        with patch(\"time.sleep\"):\n            result = invoke_with_retry(mock_fn, retries=3)\n\n        assert result == \"success\"\n        assert mock_fn.call_count == 2\n\n\n# ============================================================================\n# AC4: Configuration\n# ============================================================================\n\n\ndef test_global_config_applied_by_default():\n    \"\"\"AC4.1: Global config from RETRY_CONFIG used by default.\"\"\"\n    from quantagent.default_config import RETRY_CONFIG\n\n    class MockRateLimitError(Exception):\n        pass\n\n    MockRateLimitError.__module__ = \"openai\"\n    MockRateLimitError.__name__ = \"RateLimitError\"\n\n    # Use actual RETRY_CONFIG value to avoid brittleness\n    expected_retries = int(RETRY_CONFIG[\"max_retries\"])\n    mock_fn = Mock(side_effect=[MockRateLimitError()] * (expected_retries - 1) + [\"success\"])\n\n    with patch(\"time.sleep\"):\n        result = invoke_with_retry(mock_fn)\n\n    assert result == \"success\"\n    assert mock_fn.call_count == expected_retries\n\n\ndef test_per_call_config_overrides_global():\n    \"\"\"AC4.2: Per-call config overrides global config.\"\"\"\n\n    class MockRateLimitError(Exception):\n        pass\n\n    MockRateLimitError.__module__ = \"openai\"\n    MockRateLimitError.__name__ = \"RateLimitError\"\n\n    mock_fn = Mock(side_effect=[MockRateLimitError()] * 5)\n\n    with patch(\"time.sleep\"):\n        with pytest.raises(RuntimeError, match=\"Max retries \\\\(2\\\\) exceeded\"):\n            invoke_with_retry(mock_fn, retries=2)\n\n    assert mock_fn.call_count == 2  # Not 5\n\n\ndef test_partial_override_mix_global_and_local():\n    \"\"\"AC4.3: Partial override uses mix of global and local config.\"\"\"\n\n    class MockRateLimitError(Exception):\n        pass\n\n    MockRateLimitError.__module__ = \"openai\"\n    MockRateLimitError.__name__ = \"RateLimitError\"\n\n    mock_fn = Mock(side_effect=[MockRateLimitError(), \"success\"])\n\n    with patch(\"time.sleep\") as mock_sleep:\n        result = invoke_with_retry(mock_fn, base_wait=10.0, jitter=False)\n\n    assert result == \"success\"\n    assert mock_fn.call_count == 2\n    mock_sleep.assert_called_once_with(10.0)  # Local base_wait used\n\n\n# ============================================================================\n# AC5: Backwards Compatibility\n# ============================================================================\n\n\ndef test_explicit_base_wait_parameter_is_used():\n    \"\"\"AC5.1: Explicit base_wait parameter overrides configuration.\"\"\"\n\n    class MockRateLimitError(Exception):\n        pass\n\n    MockRateLimitError.__module__ = \"openai\"\n    MockRateLimitError.__name__ = \"RateLimitError\"\n\n    mock_fn = Mock(side_effect=[MockRateLimitError(), \"success\"])\n\n    with patch(\"time.sleep\") as mock_sleep:\n        result = invoke_with_retry(mock_fn, retries=3, base_wait=4, jitter=False)\n\n    assert result == \"success\"\n    mock_sleep.assert_called_once_with(4.0)\n\n\n# ============================================================================\n# AC6: Edge Cases\n# ============================================================================\n\n\ndef test_zero_retries():\n    \"\"\"AC6.1: Zero retries (retries=1) raises immediately on failure.\"\"\"\n\n    class MockRateLimitError(Exception):\n        pass\n\n    MockRateLimitError.__module__ = \"openai\"\n    MockRateLimitError.__name__ = \"RateLimitError\"\n\n    mock_fn = Mock(side_effect=MockRateLimitError())\n\n    with pytest.raises(RuntimeError):\n        invoke_with_retry(mock_fn, retries=1)\n\n    assert mock_fn.call_count == 1\n\n\ndef test_function_returns_none_successfully():\n    \"\"\"AC6.4: Function returning None is treated as success.\"\"\"\n    mock_fn = Mock(return_value=None)\n\n    result = invoke_with_retry(mock_fn)\n\n    assert result is None\n    assert mock_fn.call_count == 1\n\n\ndef test_function_with_args_and_kwargs():\n    \"\"\"AC6.5: Function with positional and keyword arguments.\"\"\"\n    mock_fn = Mock(return_value=\"success\")\n\n    invoke_with_retry(mock_fn, \"pos1\", \"pos2\", key1=\"val1\", key2=\"val2\")\n\n    mock_fn.assert_called_once_with(\"pos1\", \"pos2\", key1=\"val1\", key2=\"val2\")\n\n\n# ============================================================================\n# AC7: Logging\n# ============================================================================\n\n\ndef test_warning_on_each_retry(caplog):\n    \"\"\"AC7.1: WARNING log emitted on each retry.\"\"\"\n\n    class MockRateLimitError(Exception):\n        pass\n\n    MockRateLimitError.__module__ = \"openai\"\n    MockRateLimitError.__name__ = \"RateLimitError\"\n\n    mock_fn = Mock(\n        side_effect=[MockRateLimitError(), MockRateLimitError(), \"success\"]\n    )\n\n    with caplog.at_level(logging.WARNING):\n        with patch(\"time.sleep\"):\n            invoke_with_retry(mock_fn, retries=5)\n\n    assert \"Retry 1/5\" in caplog.text\n    assert \"Retry 2/5\" in caplog.text\n\n\ndef test_error_on_final_failure(caplog):\n    \"\"\"AC7.2: ERROR log emitted on final failure.\"\"\"\n\n    class MockRateLimitError(Exception):\n        pass\n\n    MockRateLimitError.__module__ = \"openai\"\n    MockRateLimitError.__name__ = \"RateLimitError\"\n\n    mock_fn = Mock(side_effect=MockRateLimitError(\"rate limited\"))\n\n    with caplog.at_level(logging.ERROR):\n        with patch(\"time.sleep\"):\n            with pytest.raises(RuntimeError):\n                invoke_with_retry(mock_fn, retries=5)\n\n    assert \"Max retries (5) exceeded\" in caplog.text\n\n\ndef test_no_logs_on_success(caplog):\n    \"\"\"AC7.3: No WARNING/ERROR logs on first-try success.\"\"\"\n    mock_fn = Mock(return_value=\"success\")\n\n    with caplog.at_level(logging.WARNING):\n        invoke_with_retry(mock_fn)\n\n    # Should have no WARNING or ERROR logs\n    assert len(caplog.records) == 0\n\n\n# ============================================================================\n# Additional Tests (Missing ACs)\n# ============================================================================\n\n\ndef test_jitter_reproducible_with_seed():\n    \"\"\"AC2.4: Jitter calculations are reproducible with seed.\"\"\"\n    random.seed(42)\n    waits1 = [\n        _calculate_wait_time(\n            attempt=0,\n            base_wait=4.0,\n            max_wait=60.0,\n            exponential_base=2,\n            jitter=True,\n            jitter_factor=0.5,\n        )\n        for _ in range(10)\n    ]\n\n    random.seed(42)\n    waits2 = [\n        _calculate_wait_time(\n            attempt=0,\n            base_wait=4.0,\n            max_wait=60.0,\n            exponential_base=2,\n            jitter=True,\n            jitter_factor=0.5,\n        )\n        for _ in range(10)\n    ]\n\n    assert waits1 == waits2\n\n\ndef test_very_large_max_wait_applied():\n    \"\"\"AC6.2: Very large max_wait values are respected.\"\"\"\n    wait = _calculate_wait_time(\n        attempt=12,  # 2 * 2^12 = 8192 > 3600\n        base_wait=2.0,\n        max_wait=3600.0,  # 1 hour\n        exponential_base=2,\n        jitter=False,\n        jitter_factor=0.5,\n    )\n    assert wait == 3600.0  # Should be capped\n\n\ndef test_exponential_backoff_full_sequence():\n    \"\"\"Verify full exponential backoff sequence with real timing.\"\"\"\n\n    class MockRateLimitError(Exception):\n        pass\n\n    MockRateLimitError.__module__ = \"openai\"\n    MockRateLimitError.__name__ = \"RateLimitError\"\n\n    mock_fn = Mock(side_effect=[MockRateLimitError()] * 3 + [\"success\"])\n\n    with patch(\"time.sleep\") as mock_sleep:\n        result = invoke_with_retry(\n            mock_fn, retries=5, base_wait=2.0, max_wait=60.0, jitter=False\n        )\n\n    assert result == \"success\"\n    assert mock_sleep.call_count == 3\n    expected_waits = [2.0, 4.0, 8.0]\n    actual_waits = [call.args[0] for call in mock_sleep.call_args_list]\n    assert actual_waits == expected_waits\n\n\ndef test_no_sleep_after_final_failure():\n    \"\"\"Verify no sleep occurs after the final failed attempt.\"\"\"\n\n    class MockRateLimitError(Exception):\n        pass\n\n    MockRateLimitError.__module__ = \"openai\"\n    MockRateLimitError.__name__ = \"RateLimitError\"\n\n    mock_fn = Mock(side_effect=MockRateLimitError())\n\n    with patch(\"time.sleep\") as mock_sleep:\n        with pytest.raises(RuntimeError):\n            invoke_with_retry(mock_fn, retries=3)\n\n    # Should sleep only between attempts (not after last)\n    assert mock_sleep.call_count == 2  # retries=3 → 3 attempts → 2 sleeps\n\n\n@pytest.mark.parametrize(\n    \"error_module,error_name\",\n    [\n        (\"openai\", \"RateLimitError\"),\n        (\"anthropic\", \"RateLimitError\"),\n        (\"requests.exceptions\", \"Timeout\"),\n        (\"requests.exceptions\", \"ConnectionError\"),\n    ],\n)\ndef test_retryable_errors_parametrized(error_module, error_name):\n    \"\"\"AC3: All documented retryable errors trigger retry (parametrized).\"\"\"\n\n    class MockError(Exception):\n        pass\n\n    MockError.__module__ = error_module\n    MockError.__name__ = error_name\n\n    mock_fn = Mock(side_effect=[MockError(), \"success\"])\n\n    with patch(\"time.sleep\"):\n        result = invoke_with_retry(mock_fn, retries=3)\n\n    assert result == \"success\"\n    assert mock_fn.call_count == 2\n\n\n# ============================================================================\n# Helper Function Tests\n# ============================================================================\n\n\n@pytest.mark.parametrize(\n    \"error_type,module,name,expected_retryable\",\n    [\n        (\"RateLimitError\", \"openai\", \"RateLimitError\", True),\n        (\"RateLimitError\", \"anthropic\", \"RateLimitError\", True),\n        (\"Timeout\", \"requests.exceptions\", \"Timeout\", True),\n        (\"ConnectionError\", \"requests.exceptions\", \"ConnectionError\", True),\n        (\"AuthenticationError\", \"openai\", \"AuthenticationError\", False),\n        (\"BadRequestError\", \"openai\", \"BadRequestError\", False),\n    ],\n)\ndef test_is_retryable_error_parametrized(error_type, module, name, expected_retryable):\n    \"\"\"Test _is_retryable_error correctly identifies retryable vs non-retryable errors.\"\"\"\n\n    class MockError(Exception):\n        pass\n\n    MockError.__module__ = module\n    MockError.__name__ = name\n\n    error = MockError()\n    assert _is_retryable_error(error) is expected_retryable\n\n\n@pytest.mark.parametrize(\n    \"status_code,expected_retryable\",\n    [\n        (429, True),\n        (500, True),\n        (502, True),\n        (503, True),\n        (504, True),\n        (400, False),\n        (401, False),\n        (403, False),\n        (404, False),\n    ],\n)\ndef test_is_retryable_error_status_codes(status_code, expected_retryable):\n    \"\"\"Test _is_retryable_error checks status_code attribute correctly.\"\"\"\n\n    class HTTPError(Exception):\n        def __init__(self, status_code):\n            self.status_code = status_code\n\n    assert _is_retryable_error(HTTPError(status_code)) is expected_retryable\n","numLines":660,"startLine":1,"totalLines":660}}}
