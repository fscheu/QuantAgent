{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01WfbnU7rNqe37iH4Ymt9dTZ","type":"tool_result","content":"1\t\"\"\"\n2\tShared utilities for agent implementations.\n3\t\n4\tProvides centralized retry logic with exponential backoff and structured output helpers.\n5\t\"\"\"\n6\t\n7\timport logging\n8\timport random\n9\timport time\n10\tfrom typing import TYPE_CHECKING, Callable, TypeVar\n11\t\n12\tfrom quantagent.default_config import RETRY_CONFIG\n13\t\n14\tif TYPE_CHECKING:\n15\t    from quantagent.llm_telemetry import TelemetryCtx\n16\t\n17\tlogger = logging.getLogger(__name__)\n18\tT = TypeVar(\"T\")\n19\t\n20\t# Error patterns that trigger retry\n21\tRETRYABLE_ERROR_PATTERNS = (\n22\t    \"RateLimitError\",\n23\t    \"APITimeoutError\",\n24\t    \"APIConnectionError\",\n25\t    \"Timeout\",\n26\t    \"ConnectionError\",\n27\t    \"ConnectError\",\n28\t)\n29\t\n30\t\n31\tdef _is_retryable_error(error: Exception) -> bool:\n32\t    \"\"\"\n33\t    Determine if an error should trigger a retry.\n34\t\n35\t    Args:\n36\t        error: The exception to check\n37\t\n38\t    Returns:\n39\t        True if error should be retried, False otherwise\n40\t    \"\"\"\n41\t    error_type = f\"{type(error).__module__}.{type(error).__name__}\"\n42\t\n43\t    # Check explicit retryable patterns\n44\t    if any(pattern in error_type for pattern in RETRYABLE_ERROR_PATTERNS):\n45\t        return True\n46\t\n47\t    # Check HTTP status if available\n48\t    status_code = getattr(error, \"status_code\", None)\n49\t    if status_code is not None:\n50\t        # 429 (rate limit) and 5xx are retryable\n51\t        return status_code == 429 or status_code >= 500\n52\t\n53\t    # Generic network/timeout errors by name\n54\t    error_name_lower = type(error).__name__.lower()\n55\t    if \"timeout\" in error_name_lower or \"connection\" in error_name_lower:\n56\t        return True\n57\t\n58\t    return False\n59\t\n60\t\n61\tdef _calculate_wait_time(\n62\t    attempt: int,\n63\t    base_wait: float,\n64\t    max_wait: float,\n65\t    exponential_base: float,\n66\t    jitter: bool,\n67\t    jitter_factor: float,\n68\t) -> float:\n69\t    \"\"\"\n70\t    Calculate wait time with exponential backoff and optional jitter.\n71\t\n72\t    Args:\n73\t        attempt: Current attempt number (0-indexed)\n74\t        base_wait: Base wait time in seconds\n75\t        max_wait: Maximum wait time cap\n76\t        exponential_base: Multiplier for exponential backoff\n77\t        jitter: Whether to add randomness\n78\t        jitter_factor: Jitter range as fraction of wait time\n79\t\n80\t    Returns:\n81\t        Calculated wait time in seconds\n82\t    \"\"\"\n83\t    # Exponential backoff: base * (exponential_base ^ attempt)\n84\t    wait = base_wait * (exponential_base**attempt)\n85\t\n86\t    # Cap at max_wait\n87\t    wait = min(wait, max_wait)\n88\t\n89\t    # Add jitter if enabled\n90\t    if jitter:\n91\t        jitter_range = wait * jitter_factor\n92\t        wait = wait + random.uniform(-jitter_range / 2, jitter_range / 2)\n93\t        # Floor to prevent negative/zero waits\n94\t        wait = max(0.1, wait)\n95\t\n96\t    return wait\n97\t\n98\t\n99\tdef invoke_with_retry(\n100\t    call_fn: Callable[..., T],\n101\t    *args,\n102\t    retries: int | None = None,\n103\t    base_wait: float | None = None,\n104\t    max_wait: float | None = None,\n105\t    jitter: bool | None = None,\n106\t    telemetry_ctx: \"TelemetryCtx | None\" = None,\n107\t    **kwargs,\n108\t) -> T:\n109\t    \"\"\"\n110\t    Centralized retry wrapper with exponential backoff.\n111\t\n112\t    Handles rate limiting and transient errors across multiple LLM providers\n113\t    (OpenAI, Anthropic, Qwen). Uses exponential backoff with jitter.\n114\t\n115\t    Args:\n116\t        call_fn: Function to call (typically llm.invoke)\n117\t        *args: Positional arguments for call_fn\n118\t        retries: Max retry attempts (default: from RETRY_CONFIG)\n119\t        base_wait: Base wait time in seconds (default: from RETRY_CONFIG)\n120\t        max_wait: Maximum wait time cap (default: from RETRY_CONFIG)\n121\t        jitter: Add randomness to wait time (default: from RETRY_CONFIG)\n122\t        telemetry_ctx: Optional telemetry context for LLM call metrics logging.\n123\t        **kwargs: Keyword arguments for call_fn\n124\t\n125\t    Returns:\n126\t        Result from call_fn if successful\n127\t\n128\t    Raises:\n129\t        RuntimeError: If all retries exhausted\n130\t        Exception: Re-raised if error is not retryable\n131\t\n132\t    Example:\n133\t        >>> result = invoke_with_retry(llm.invoke, messages)\n134\t        >>> result = invoke_with_retry(llm.invoke, messages, retries=7, base_wait=4)\n135\t    \"\"\"\n136\t    # Resolve configuration (local override > global config)\n137\t    max_retries: int = retries if retries is not None else int(RETRY_CONFIG[\"max_retries\"])\n138\t    resolved_base_wait: float = base_wait if base_wait is not None else float(RETRY_CONFIG[\"base_wait\"])\n139\t    resolved_max_wait: float = max_wait if max_wait is not None else float(RETRY_CONFIG[\"max_wait\"])\n140\t    resolved_jitter: bool = jitter if jitter is not None else bool(RETRY_CONFIG[\"jitter\"])\n141\t    exponential_base: float = float(RETRY_CONFIG[\"exponential_base\"])\n142\t    jitter_factor: float = float(RETRY_CONFIG[\"jitter_factor\"])\n143\t\n144\t    t_start = time.perf_counter()\n145\t\n146\t    for attempt in range(max_retries):\n147\t        try:\n148\t            result = call_fn(*args, **kwargs)\n149\t            if telemetry_ctx is not None:\n150\t                from quantagent.llm_telemetry import persist_llm_call\n151\t\n152\t                persist_llm_call(\n153\t                    ctx=telemetry_ctx,\n154\t                    status=\"success\",\n155\t                    duration_ms=(time.perf_counter() - t_start) * 1000,\n156\t                    response=result,\n157\t                )\n158\t            return result\n159\t        except Exception as e:\n160\t            # Check if error is retryable\n161\t            if not _is_retryable_error(e):\n162\t                logger.error(\n163\t                    \"Non-retryable error (%s): %s\",\n164\t                    type(e).__name__,\n165\t                    str(e),\n166\t                    extra={\n167\t                        \"error_type\": type(e).__name__,\n168\t                        \"error_message\": str(e),\n169\t                    },\n170\t                )\n171\t                if telemetry_ctx is not None:\n172\t                    from quantagent.llm_telemetry import persist_llm_call\n173\t\n174\t                    persist_llm_call(\n175\t                        ctx=telemetry_ctx,\n176\t                        status=\"error\",\n177\t                        duration_ms=(time.perf_counter() - t_start) * 1000,\n178\t                        error_message=f\"{type(e).__name__}: {e}\",\n179\t                    )\n180\t                raise\n181\t\n182\t            # Check if we have retries left\n183\t            if attempt >= max_retries - 1:\n184\t                logger.error(\n185\t                    \"Max retries (%d) exceeded: %s\",\n186\t                    max_retries,\n187\t                    str(e),\n188\t                    extra={\n189\t                        \"max_retries\": max_retries,\n190\t                        \"final_error\": str(e),\n191\t                        \"error_type\": type(e).__name__,\n192\t                    },\n193\t                )\n194\t                if telemetry_ctx is not None:\n195\t                    from quantagent.llm_telemetry import persist_llm_call\n196\t\n197\t                    persist_llm_call(\n198\t                        ctx=telemetry_ctx,\n199\t                        status=\"error\",\n200\t                        duration_ms=(time.perf_counter() - t_start) * 1000,\n201\t                        error_message=f\"Max retries exceeded: {type(e).__name__}: {e}\",\n202\t                    )\n203\t                raise RuntimeError(f\"Max retries ({max_retries}) exceeded: {str(e)}\")\n204\t\n205\t            # Calculate wait time and retry\n206\t            wait_time = _calculate_wait_time(\n207\t                attempt, resolved_base_wait, resolved_max_wait, exponential_base, resolved_jitter, jitter_factor\n208\t            )\n209\t\n210\t            logger.warning(\n211\t                \"Retry %d/%d after %s: waiting %.2fs\",\n212\t                attempt + 1,\n213\t                max_retries,\n214\t                type(e).__name__,\n215\t                wait_time,\n216\t                extra={\n217\t                    \"retry_attempt\": attempt + 1,\n218\t                    \"max_retries\": max_retries,\n219\t                    \"error_type\": type(e).__name__,\n220\t                    \"wait_seconds\": wait_time,\n221\t                },\n222\t            )\n223\t\n224\t            time.sleep(wait_time)\n225\t\n226\t    # This should never be reached due to logic above, but satisfies mypy\n227\t    raise RuntimeError(f\"Max retries ({max_retries}) exceeded\")\n228\t"}]},"parent_tool_use_id":null,"session_id":"6027cba3-e69d-464f-aa78-e9e9792aa2ae","uuid":"cec598b1-82c1-4d33-a66d-53e5b5516bd7","timestamp":"2026-05-12T17:58:47.210Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/autodev-worktrees/QuantAgent/QuantAgent-69d/planner-20260512T124234Z/quantagent/agent_utils.py","content":"\"\"\"\nShared utilities for agent implementations.\n\nProvides centralized retry logic with exponential backoff and structured output helpers.\n\"\"\"\n\nimport logging\nimport random\nimport time\nfrom typing import TYPE_CHECKING, Callable, TypeVar\n\nfrom quantagent.default_config import RETRY_CONFIG\n\nif TYPE_CHECKING:\n    from quantagent.llm_telemetry import TelemetryCtx\n\nlogger = logging.getLogger(__name__)\nT = TypeVar(\"T\")\n\n# Error patterns that trigger retry\nRETRYABLE_ERROR_PATTERNS = (\n    \"RateLimitError\",\n    \"APITimeoutError\",\n    \"APIConnectionError\",\n    \"Timeout\",\n    \"ConnectionError\",\n    \"ConnectError\",\n)\n\n\ndef _is_retryable_error(error: Exception) -> bool:\n    \"\"\"\n    Determine if an error should trigger a retry.\n\n    Args:\n        error: The exception to check\n\n    Returns:\n        True if error should be retried, False otherwise\n    \"\"\"\n    error_type = f\"{type(error).__module__}.{type(error).__name__}\"\n\n    # Check explicit retryable patterns\n    if any(pattern in error_type for pattern in RETRYABLE_ERROR_PATTERNS):\n        return True\n\n    # Check HTTP status if available\n    status_code = getattr(error, \"status_code\", None)\n    if status_code is not None:\n        # 429 (rate limit) and 5xx are retryable\n        return status_code == 429 or status_code >= 500\n\n    # Generic network/timeout errors by name\n    error_name_lower = type(error).__name__.lower()\n    if \"timeout\" in error_name_lower or \"connection\" in error_name_lower:\n        return True\n\n    return False\n\n\ndef _calculate_wait_time(\n    attempt: int,\n    base_wait: float,\n    max_wait: float,\n    exponential_base: float,\n    jitter: bool,\n    jitter_factor: float,\n) -> float:\n    \"\"\"\n    Calculate wait time with exponential backoff and optional jitter.\n\n    Args:\n        attempt: Current attempt number (0-indexed)\n        base_wait: Base wait time in seconds\n        max_wait: Maximum wait time cap\n        exponential_base: Multiplier for exponential backoff\n        jitter: Whether to add randomness\n        jitter_factor: Jitter range as fraction of wait time\n\n    Returns:\n        Calculated wait time in seconds\n    \"\"\"\n    # Exponential backoff: base * (exponential_base ^ attempt)\n    wait = base_wait * (exponential_base**attempt)\n\n    # Cap at max_wait\n    wait = min(wait, max_wait)\n\n    # Add jitter if enabled\n    if jitter:\n        jitter_range = wait * jitter_factor\n        wait = wait + random.uniform(-jitter_range / 2, jitter_range / 2)\n        # Floor to prevent negative/zero waits\n        wait = max(0.1, wait)\n\n    return wait\n\n\ndef invoke_with_retry(\n    call_fn: Callable[..., T],\n    *args,\n    retries: int | None = None,\n    base_wait: float | None = None,\n    max_wait: float | None = None,\n    jitter: bool | None = None,\n    telemetry_ctx: \"TelemetryCtx | None\" = None,\n    **kwargs,\n) -> T:\n    \"\"\"\n    Centralized retry wrapper with exponential backoff.\n\n    Handles rate limiting and transient errors across multiple LLM providers\n    (OpenAI, Anthropic, Qwen). Uses exponential backoff with jitter.\n\n    Args:\n        call_fn: Function to call (typically llm.invoke)\n        *args: Positional arguments for call_fn\n        retries: Max retry attempts (default: from RETRY_CONFIG)\n        base_wait: Base wait time in seconds (default: from RETRY_CONFIG)\n        max_wait: Maximum wait time cap (default: from RETRY_CONFIG)\n        jitter: Add randomness to wait time (default: from RETRY_CONFIG)\n        telemetry_ctx: Optional telemetry context for LLM call metrics logging.\n        **kwargs: Keyword arguments for call_fn\n\n    Returns:\n        Result from call_fn if successful\n\n    Raises:\n        RuntimeError: If all retries exhausted\n        Exception: Re-raised if error is not retryable\n\n    Example:\n        >>> result = invoke_with_retry(llm.invoke, messages)\n        >>> result = invoke_with_retry(llm.invoke, messages, retries=7, base_wait=4)\n    \"\"\"\n    # Resolve configuration (local override > global config)\n    max_retries: int = retries if retries is not None else int(RETRY_CONFIG[\"max_retries\"])\n    resolved_base_wait: float = base_wait if base_wait is not None else float(RETRY_CONFIG[\"base_wait\"])\n    resolved_max_wait: float = max_wait if max_wait is not None else float(RETRY_CONFIG[\"max_wait\"])\n    resolved_jitter: bool = jitter if jitter is not None else bool(RETRY_CONFIG[\"jitter\"])\n    exponential_base: float = float(RETRY_CONFIG[\"exponential_base\"])\n    jitter_factor: float = float(RETRY_CONFIG[\"jitter_factor\"])\n\n    t_start = time.perf_counter()\n\n    for attempt in range(max_retries):\n        try:\n            result = call_fn(*args, **kwargs)\n            if telemetry_ctx is not None:\n                from quantagent.llm_telemetry import persist_llm_call\n\n                persist_llm_call(\n                    ctx=telemetry_ctx,\n                    status=\"success\",\n                    duration_ms=(time.perf_counter() - t_start) * 1000,\n                    response=result,\n                )\n            return result\n        except Exception as e:\n            # Check if error is retryable\n            if not _is_retryable_error(e):\n                logger.error(\n                    \"Non-retryable error (%s): %s\",\n                    type(e).__name__,\n                    str(e),\n                    extra={\n                        \"error_type\": type(e).__name__,\n                        \"error_message\": str(e),\n                    },\n                )\n                if telemetry_ctx is not None:\n                    from quantagent.llm_telemetry import persist_llm_call\n\n                    persist_llm_call(\n                        ctx=telemetry_ctx,\n                        status=\"error\",\n                        duration_ms=(time.perf_counter() - t_start) * 1000,\n                        error_message=f\"{type(e).__name__}: {e}\",\n                    )\n                raise\n\n            # Check if we have retries left\n            if attempt >= max_retries - 1:\n                logger.error(\n                    \"Max retries (%d) exceeded: %s\",\n                    max_retries,\n                    str(e),\n                    extra={\n                        \"max_retries\": max_retries,\n                        \"final_error\": str(e),\n                        \"error_type\": type(e).__name__,\n                    },\n                )\n                if telemetry_ctx is not None:\n                    from quantagent.llm_telemetry import persist_llm_call\n\n                    persist_llm_call(\n                        ctx=telemetry_ctx,\n                        status=\"error\",\n                        duration_ms=(time.perf_counter() - t_start) * 1000,\n                        error_message=f\"Max retries exceeded: {type(e).__name__}: {e}\",\n                    )\n                raise RuntimeError(f\"Max retries ({max_retries}) exceeded: {str(e)}\")\n\n            # Calculate wait time and retry\n            wait_time = _calculate_wait_time(\n                attempt, resolved_base_wait, resolved_max_wait, exponential_base, resolved_jitter, jitter_factor\n            )\n\n            logger.warning(\n                \"Retry %d/%d after %s: waiting %.2fs\",\n                attempt + 1,\n                max_retries,\n                type(e).__name__,\n                wait_time,\n                extra={\n                    \"retry_attempt\": attempt + 1,\n                    \"max_retries\": max_retries,\n                    \"error_type\": type(e).__name__,\n                    \"wait_seconds\": wait_time,\n                },\n            )\n\n            time.sleep(wait_time)\n\n    # This should never be reached due to logic above, but satisfies mypy\n    raise RuntimeError(f\"Max retries ({max_retries}) exceeded\")\n","numLines":228,"startLine":1,"totalLines":228}}}
