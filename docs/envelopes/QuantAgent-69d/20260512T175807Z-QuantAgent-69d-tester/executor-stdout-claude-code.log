{"type":"stream_event","event":{"type":"message_delta","delta":{"stop_reason":"tool_use","stop_sequence":null,"stop_details":null},"usage":{"input_tokens":1,"cache_creation_input_tokens":802,"cache_read_input_tokens":59629,"output_tokens":6377,"iterations":[{"input_tokens":1,"output_tokens":6377,"cache_read_input_tokens":59629,"cache_creation_input_tokens":802,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":802},"type":"message"}]},"context_management":{"applied_edits":[]}},"session_id":"6027cba3-e69d-464f-aa78-e9e9792aa2ae","parent_tool_use_id":null,"uuid":"97db1eb8-3ab2-4929-93a2-23860355f56e"}
