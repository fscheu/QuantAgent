{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01343g5aARFxFiFy5pWZDav4","type":"tool_result","content":"1\t\"\"\"\n2\tLLM telemetry helpers for QuantAgent-69d.\n3\t\n4\tProvides usage extraction, Log persistence, and query-time aggregation\n5\tfor LLM call metrics (tokens, duration). Uses the existing `logs` table\n6\tas the persistence surface; no new tables or migrations required.\n7\t\"\"\"\n8\t\n9\tfrom __future__ import annotations\n10\t\n11\timport logging\n12\tfrom dataclasses import dataclass, field\n13\tfrom datetime import datetime\n14\tfrom typing import Any\n15\t\n16\tlogger = logging.getLogger(__name__)\n17\t\n18\t# ── telemetry context ────────────────────────────────────────────────────────\n19\t\n20\t\n21\t@dataclass\n22\tclass TelemetryCtx:\n23\t    \"\"\"Optional context passed to instrumented LLM calls.\"\"\"\n24\t\n25\t    operation: str = \"\"\n26\t    provider: str = \"\"\n27\t    model: str = \"\"\n28\t    environment: str | None = None\n29\t    symbol: str | None = None\n30\t    thread_id: str | None = None\n31\t    checkpoint_id: str | None = None\n32\t    backtest_run_id: int | None = None\n33\t    extra: dict[str, Any] = field(default_factory=dict)\n34\t\n35\t\n36\t# ── usage extraction ─────────────────────────────────────────────────────────\n37\t\n38\t\n39\tdef extract_usage(response: Any) -> dict[str, int | None]:\n40\t    \"\"\"\n41\t    Extract token counts from a LangChain (or raw provider) response.\n42\t\n43\t    Priority order:\n44\t    1. response.usage_metadata  (LangChain standard, dict-like)\n45\t    2. response.response_metadata[\"token_usage\"]  (OpenAI legacy shape)\n46\t    3. Fallback: all None (provider does not expose usage)\n47\t\n48\t    Returns a dict with keys: input_tokens, output_tokens, total_tokens.\n49\t    Values are int or None.\n50\t    \"\"\"\n51\t    usage: dict[str, int | None] = {\n52\t        \"input_tokens\": None,\n53\t        \"output_tokens\": None,\n54\t        \"total_tokens\": None,\n55\t    }\n56\t\n57\t    # 1. LangChain standard usage_metadata\n58\t    usage_meta = getattr(response, \"usage_metadata\", None)\n59\t    if isinstance(usage_meta, dict):\n60\t        usage[\"input_tokens\"] = usage_meta.get(\"input_tokens\")\n61\t        usage[\"output_tokens\"] = usage_meta.get(\"output_tokens\")\n62\t        usage[\"total_tokens\"] = usage_meta.get(\"total_tokens\")\n63\t        return usage\n64\t\n65\t    # 2. OpenAI legacy shape via response_metadata\n66\t    resp_meta = getattr(response, \"response_metadata\", None)\n67\t    if isinstance(resp_meta, dict):\n68\t        token_usage = resp_meta.get(\"token_usage\") or resp_meta.get(\"usage\")\n69\t        if isinstance(token_usage, dict):\n70\t            usage[\"input_tokens\"] = token_usage.get(\"prompt_tokens\") or token_usage.get(\"input_tokens\")\n71\t            usage[\"output_tokens\"] = token_usage.get(\"completion_tokens\") or token_usage.get(\"output_tokens\")\n72\t            usage[\"total_tokens\"] = token_usage.get(\"total_tokens\")\n73\t\n74\t    return usage\n75\t\n76\t\n77\t# ── persistence ───────────────────────────────────────────────────────────────\n78\t\n79\t\n80\tdef persist_llm_call(\n81\t    *,\n82\t    ctx: TelemetryCtx,\n83\t    status: str,\n84\t    duration_ms: float,\n85\t    response: Any = None,\n86\t    error_message: str | None = None,\n87\t) -> None:\n88\t    \"\"\"\n89\t    Write one ``Log(event_type='llm_call')`` row to the database.\n90\t\n91\t    This is best-effort: any DB exception is logged and swallowed so\n92\t    that telemetry failures never propagate to the caller.\n93\t    \"\"\"\n94\t    try:\n95\t        from quantagent.database import SessionLocal\n96\t        from quantagent.models import Log\n97\t\n98\t        usage = extract_usage(response) if response is not None else {\"input_tokens\": None, \"output_tokens\": None, \"total_tokens\": None}\n99\t\n100\t        extra_data: dict[str, Any] = {\n101\t            \"provider\": ctx.provider or None,\n102\t            \"model\": ctx.model or None,\n103\t            \"operation\": ctx.operation or None,\n104\t            \"status\": status,\n105\t            \"input_tokens\": usage[\"input_tokens\"],\n106\t            \"output_tokens\": usage[\"output_tokens\"],\n107\t            \"total_tokens\": usage[\"total_tokens\"],\n108\t            \"duration_ms\": round(duration_ms, 2),\n109\t            \"backtest_run_id\": ctx.backtest_run_id,\n110\t        }\n111\t        if error_message:\n112\t            extra_data[\"error_message\"] = error_message\n113\t        if ctx.extra:\n114\t            extra_data.update(ctx.extra)\n115\t\n116\t        log_entry = Log(\n117\t            timestamp=datetime.utcnow(),\n118\t            level=\"INFO\" if status == \"success\" else \"ERROR\",\n119\t            module=\"quantagent.llm_telemetry\",\n120\t            message=f\"llm_call {ctx.operation or 'unknown'} {status}\",\n121\t            event_type=\"llm_call\",\n122\t            environment=ctx.environment,\n123\t            symbol=ctx.symbol,\n124\t            thread_id=ctx.thread_id,\n125\t            checkpoint_id=ctx.checkpoint_id,\n126\t            extra_data=extra_data,\n127\t        )\n128\t\n129\t        session = SessionLocal()\n130\t        try:\n131\t            session.add(log_entry)\n132\t            session.commit()\n133\t        finally:\n134\t            session.close()\n135\t\n136\t    except Exception:\n137\t        logger.debug(\"Failed to persist LLM telemetry row\", exc_info=True)\n138\t\n139\t\n140\t# ── aggregation ───────────────────────────────────────────────────────────────\n141\t\n142\t\n143\tdef _aggregate_rows(rows: list[Any]) -> dict[str, Any]:\n144\t    \"\"\"Compute aggregate stats over a list of Log rows with event_type='llm_call'.\"\"\"\n145\t    calls = len(rows)\n146\t    input_sum = 0\n147\t    output_sum = 0\n148\t    total_sum = 0\n149\t    duration_sum = 0.0\n150\t    by_operation: dict[str, dict[str, Any]] = {}\n151\t\n152\t    for row in rows:\n153\t        ed = row.extra_data or {}\n154\t        inp = ed.get(\"input_tokens\") or 0\n155\t        out = ed.get(\"output_tokens\") or 0\n156\t        tot = ed.get(\"total_tokens\") or 0\n157\t        dur = ed.get(\"duration_ms\") or 0.0\n158\t        op = ed.get(\"operation\") or \"unknown\"\n159\t\n160\t        input_sum += inp\n161\t        output_sum += out\n162\t        total_sum += tot\n163\t        duration_sum += dur\n164\t\n165\t        if op not in by_operation:\n166\t            by_operation[op] = {\"calls\": 0, \"input_tokens\": 0, \"output_tokens\": 0, \"total_tokens\": 0, \"duration_ms\": 0.0}\n167\t        by_operation[op][\"calls\"] += 1\n168\t        by_operation[op][\"input_tokens\"] += inp\n169\t        by_operation[op][\"output_tokens\"] += out\n170\t        by_operation[op][\"total_tokens\"] += tot\n171\t        by_operation[op][\"duration_ms\"] += dur\n172\t\n173\t    return {\n174\t        \"calls\": calls,\n175\t        \"input_tokens_sum\": input_sum,\n176\t        \"output_tokens_sum\": output_sum,\n177\t        \"total_tokens_sum\": total_sum,\n178\t        \"duration_ms_sum\": round(duration_sum, 2),\n179\t        \"duration_ms_avg\": round(duration_sum / calls, 2) if calls else 0.0,\n180\t        \"by_operation\": by_operation,\n181\t    }\n182\t\n183\t\n184\tdef get_session_metrics(db: Any, thread_id: str) -> dict[str, Any]:\n185\t    \"\"\"\n186\t    Return aggregated LLM call metrics for a given thread_id.\n187\t\n188\t    Args:\n189\t        db: SQLAlchemy session.\n190\t        thread_id: The session/thread identifier to filter on.\n191\t\n192\t    Returns:\n193\t        Aggregate dict with calls, token sums, duration stats, by_operation.\n194\t    \"\"\"\n195\t    from quantagent.models import Log\n196\t\n197\t    rows = (\n198\t        db.query(Log)\n199\t        .filter(Log.event_type == \"llm_call\", Log.thread_id == thread_id)\n200\t        .all()\n201\t    )\n202\t    return _aggregate_rows(rows)\n203\t\n204\t\n205\tdef get_backtest_metrics(db: Any, backtest_run_id: int) -> dict[str, Any]:\n206\t    \"\"\"\n207\t    Return aggregated LLM call metrics for a given backtest run.\n208\t\n209\t    Filters by JSON field extra_data.backtest_run_id. This is acceptable\n210\t    for current scale; optimise separately if query becomes slow.\n211\t\n212\t    Args:\n213\t        db: SQLAlchemy session.\n214\t        backtest_run_id: The BacktestRun.id to filter on.\n215\t\n216\t    Returns:\n217\t        Aggregate dict with calls, token sums, duration stats, by_operation.\n218\t    \"\"\"\n219\t    from quantagent.models import Log\n220\t\n221\t    rows = (\n222\t        db.query(Log)\n223\t        .filter(Log.event_type == \"llm_call\")\n224\t        .all()\n225\t    )\n226\t    # Filter in Python to stay DB-agnostic (SQLite vs Postgres JSON operators differ)\n227\t    filtered = [r for r in rows if (r.extra_data or {}).get(\"backtest_run_id\") == backtest_run_id]\n228\t    return _aggregate_rows(filtered)\n229\t"}]},"parent_tool_use_id":null,"session_id":"6027cba3-e69d-464f-aa78-e9e9792aa2ae","uuid":"da8011bf-00c3-48b6-9c62-6a0bc68851ff","timestamp":"2026-05-12T17:58:44.934Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/autodev-worktrees/QuantAgent/QuantAgent-69d/planner-20260512T124234Z/quantagent/llm_telemetry.py","content":"\"\"\"\nLLM telemetry helpers for QuantAgent-69d.\n\nProvides usage extraction, Log persistence, and query-time aggregation\nfor LLM call metrics (tokens, duration). Uses the existing `logs` table\nas the persistence surface; no new tables or migrations required.\n\"\"\"\n\nfrom __future__ import annotations\n\nimport logging\nfrom dataclasses import dataclass, field\nfrom datetime import datetime\nfrom typing import Any\n\nlogger = logging.getLogger(__name__)\n\n# ── telemetry context ────────────────────────────────────────────────────────\n\n\n@dataclass\nclass TelemetryCtx:\n    \"\"\"Optional context passed to instrumented LLM calls.\"\"\"\n\n    operation: str = \"\"\n    provider: str = \"\"\n    model: str = \"\"\n    environment: str | None = None\n    symbol: str | None = None\n    thread_id: str | None = None\n    checkpoint_id: str | None = None\n    backtest_run_id: int | None = None\n    extra: dict[str, Any] = field(default_factory=dict)\n\n\n# ── usage extraction ─────────────────────────────────────────────────────────\n\n\ndef extract_usage(response: Any) -> dict[str, int | None]:\n    \"\"\"\n    Extract token counts from a LangChain (or raw provider) response.\n\n    Priority order:\n    1. response.usage_metadata  (LangChain standard, dict-like)\n    2. response.response_metadata[\"token_usage\"]  (OpenAI legacy shape)\n    3. Fallback: all None (provider does not expose usage)\n\n    Returns a dict with keys: input_tokens, output_tokens, total_tokens.\n    Values are int or None.\n    \"\"\"\n    usage: dict[str, int | None] = {\n        \"input_tokens\": None,\n        \"output_tokens\": None,\n        \"total_tokens\": None,\n    }\n\n    # 1. LangChain standard usage_metadata\n    usage_meta = getattr(response, \"usage_metadata\", None)\n    if isinstance(usage_meta, dict):\n        usage[\"input_tokens\"] = usage_meta.get(\"input_tokens\")\n        usage[\"output_tokens\"] = usage_meta.get(\"output_tokens\")\n        usage[\"total_tokens\"] = usage_meta.get(\"total_tokens\")\n        return usage\n\n    # 2. OpenAI legacy shape via response_metadata\n    resp_meta = getattr(response, \"response_metadata\", None)\n    if isinstance(resp_meta, dict):\n        token_usage = resp_meta.get(\"token_usage\") or resp_meta.get(\"usage\")\n        if isinstance(token_usage, dict):\n            usage[\"input_tokens\"] = token_usage.get(\"prompt_tokens\") or token_usage.get(\"input_tokens\")\n            usage[\"output_tokens\"] = token_usage.get(\"completion_tokens\") or token_usage.get(\"output_tokens\")\n            usage[\"total_tokens\"] = token_usage.get(\"total_tokens\")\n\n    return usage\n\n\n# ── persistence ───────────────────────────────────────────────────────────────\n\n\ndef persist_llm_call(\n    *,\n    ctx: TelemetryCtx,\n    status: str,\n    duration_ms: float,\n    response: Any = None,\n    error_message: str | None = None,\n) -> None:\n    \"\"\"\n    Write one ``Log(event_type='llm_call')`` row to the database.\n\n    This is best-effort: any DB exception is logged and swallowed so\n    that telemetry failures never propagate to the caller.\n    \"\"\"\n    try:\n        from quantagent.database import SessionLocal\n        from quantagent.models import Log\n\n        usage = extract_usage(response) if response is not None else {\"input_tokens\": None, \"output_tokens\": None, \"total_tokens\": None}\n\n        extra_data: dict[str, Any] = {\n            \"provider\": ctx.provider or None,\n            \"model\": ctx.model or None,\n            \"operation\": ctx.operation or None,\n            \"status\": status,\n            \"input_tokens\": usage[\"input_tokens\"],\n            \"output_tokens\": usage[\"output_tokens\"],\n            \"total_tokens\": usage[\"total_tokens\"],\n            \"duration_ms\": round(duration_ms, 2),\n            \"backtest_run_id\": ctx.backtest_run_id,\n        }\n        if error_message:\n            extra_data[\"error_message\"] = error_message\n        if ctx.extra:\n            extra_data.update(ctx.extra)\n\n        log_entry = Log(\n            timestamp=datetime.utcnow(),\n            level=\"INFO\" if status == \"success\" else \"ERROR\",\n            module=\"quantagent.llm_telemetry\",\n            message=f\"llm_call {ctx.operation or 'unknown'} {status}\",\n            event_type=\"llm_call\",\n            environment=ctx.environment,\n            symbol=ctx.symbol,\n            thread_id=ctx.thread_id,\n            checkpoint_id=ctx.checkpoint_id,\n            extra_data=extra_data,\n        )\n\n        session = SessionLocal()\n        try:\n            session.add(log_entry)\n            session.commit()\n        finally:\n            session.close()\n\n    except Exception:\n        logger.debug(\"Failed to persist LLM telemetry row\", exc_info=True)\n\n\n# ── aggregation ───────────────────────────────────────────────────────────────\n\n\ndef _aggregate_rows(rows: list[Any]) -> dict[str, Any]:\n    \"\"\"Compute aggregate stats over a list of Log rows with event_type='llm_call'.\"\"\"\n    calls = len(rows)\n    input_sum = 0\n    output_sum = 0\n    total_sum = 0\n    duration_sum = 0.0\n    by_operation: dict[str, dict[str, Any]] = {}\n\n    for row in rows:\n        ed = row.extra_data or {}\n        inp = ed.get(\"input_tokens\") or 0\n        out = ed.get(\"output_tokens\") or 0\n        tot = ed.get(\"total_tokens\") or 0\n        dur = ed.get(\"duration_ms\") or 0.0\n        op = ed.get(\"operation\") or \"unknown\"\n\n        input_sum += inp\n        output_sum += out\n        total_sum += tot\n        duration_sum += dur\n\n        if op not in by_operation:\n            by_operation[op] = {\"calls\": 0, \"input_tokens\": 0, \"output_tokens\": 0, \"total_tokens\": 0, \"duration_ms\": 0.0}\n        by_operation[op][\"calls\"] += 1\n        by_operation[op][\"input_tokens\"] += inp\n        by_operation[op][\"output_tokens\"] += out\n        by_operation[op][\"total_tokens\"] += tot\n        by_operation[op][\"duration_ms\"] += dur\n\n    return {\n        \"calls\": calls,\n        \"input_tokens_sum\": input_sum,\n        \"output_tokens_sum\": output_sum,\n        \"total_tokens_sum\": total_sum,\n        \"duration_ms_sum\": round(duration_sum, 2),\n        \"duration_ms_avg\": round(duration_sum / calls, 2) if calls else 0.0,\n        \"by_operation\": by_operation,\n    }\n\n\ndef get_session_metrics(db: Any, thread_id: str) -> dict[str, Any]:\n    \"\"\"\n    Return aggregated LLM call metrics for a given thread_id.\n\n    Args:\n        db: SQLAlchemy session.\n        thread_id: The session/thread identifier to filter on.\n\n    Returns:\n        Aggregate dict with calls, token sums, duration stats, by_operation.\n    \"\"\"\n    from quantagent.models import Log\n\n    rows = (\n        db.query(Log)\n        .filter(Log.event_type == \"llm_call\", Log.thread_id == thread_id)\n        .all()\n    )\n    return _aggregate_rows(rows)\n\n\ndef get_backtest_metrics(db: Any, backtest_run_id: int) -> dict[str, Any]:\n    \"\"\"\n    Return aggregated LLM call metrics for a given backtest run.\n\n    Filters by JSON field extra_data.backtest_run_id. This is acceptable\n    for current scale; optimise separately if query becomes slow.\n\n    Args:\n        db: SQLAlchemy session.\n        backtest_run_id: The BacktestRun.id to filter on.\n\n    Returns:\n        Aggregate dict with calls, token sums, duration stats, by_operation.\n    \"\"\"\n    from quantagent.models import Log\n\n    rows = (\n        db.query(Log)\n        .filter(Log.event_type == \"llm_call\")\n        .all()\n    )\n    # Filter in Python to stay DB-agnostic (SQLite vs Postgres JSON operators differ)\n    filtered = [r for r in rows if (r.extra_data or {}).get(\"backtest_run_id\") == backtest_run_id]\n    return _aggregate_rows(filtered)\n","numLines":229,"startLine":1,"totalLines":229}}}
