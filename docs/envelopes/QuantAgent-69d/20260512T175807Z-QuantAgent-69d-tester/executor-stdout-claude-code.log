{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01ReZcfyEHgEmLNxjqp2sxqQ","type":"tool_result","content":"1\t\"\"\"\n2\tPytest configuration and shared fixtures for QuantAgent testing.\n3\t\n4\tThis module provides pytest fixtures for:\n5\t- Sample OHLCV data (kline_data)\n6\t- Mock LLM configurations (supporting with_structured_output pattern)\n7\t- Agent state objects\n8\t- Mocked API keys\n9\t- Temporary directories for test outputs\n10\t\"\"\"\n11\t\n12\timport importlib.util\n13\timport os\n14\timport sys\n15\timport types\n16\tfrom datetime import datetime\n17\tfrom pathlib import Path\n18\tfrom typing import Dict, List\n19\tfrom unittest.mock import Mock, patch\n20\t\n21\timport numpy as np\n22\timport pandas as pd\n23\timport pytest\n24\t\n25\tfrom quantagent.agent_models import (\n26\t    IndicatorReport,\n27\t    PatternReport,\n28\t    TradingDecision,\n29\t    TrendReport,\n30\t)\n31\t\n32\t\n33\tdef _module_available(module_name: str) -> bool:\n34\t    try:\n35\t        return importlib.util.find_spec(module_name) is not None\n36\t    except (ModuleNotFoundError, ValueError):\n37\t        return False\n38\t\n39\t\n40\tif not _module_available(\"apscheduler.schedulers.background\"):\n41\t    apscheduler = types.ModuleType(\"apscheduler\")\n42\t    schedulers = types.ModuleType(\"apscheduler.schedulers\")\n43\t    background = types.ModuleType(\"apscheduler.schedulers.background\")\n44\t    triggers = types.ModuleType(\"apscheduler.triggers\")\n45\t    interval = types.ModuleType(\"apscheduler.triggers.interval\")\n46\t\n47\t    class SchedulerAlreadyRunningError(Exception):\n48\t        pass\n49\t\n50\t    class JobLookupError(Exception):\n51\t        pass\n52\t\n53\t    class _IntervalValue:\n54\t        def __init__(self, seconds):\n55\t            self._seconds = seconds\n56\t\n57\t        def total_seconds(self):\n58\t            return self._seconds\n59\t\n60\t    class BackgroundScheduler:\n61\t        def __init__(self, *args, **kwargs):\n62\t            self.args = args\n63\t            self.kwargs = kwargs\n64\t            self.running = False\n65\t            self.jobs = {}\n66\t\n67\t        def add_job(self, *args, **kwargs):\n68\t            job_id = kwargs[\"id\"]\n69\t            if job_id in self.jobs and not kwargs.get(\"replace_existing\"):\n70\t                raise ValueError(f\"Job already exists: {job_id}\")\n71\t\n72\t            job = types.SimpleNamespace(\n73\t                id=job_id,\n74\t                trigger=kwargs.get(\"trigger\"),\n75\t                max_instances=kwargs.get(\"max_instances\"),\n76\t            )\n77\t            self.jobs[job_id] = job\n78\t            return job\n79\t\n80\t        def get_job(self, job_id):\n81\t            return self.jobs.get(job_id)\n82\t\n83\t        def remove_job(self, job_id):\n84\t            if job_id not in self.jobs:\n85\t                raise JobLookupError(job_id)\n86\t            del self.jobs[job_id]\n87\t\n88\t        def start(self):\n89\t            if self.running:\n90\t                raise SchedulerAlreadyRunningError()\n91\t            self.running = True\n92\t            return None\n93\t\n94\t        def shutdown(self, wait=True):\n95\t            self.running = False\n96\t            return None\n97\t\n98\t    class IntervalTrigger:\n99\t        def __init__(self, *args, **kwargs):\n100\t            self.args = args\n101\t            self.kwargs = kwargs\n102\t            self.interval = _IntervalValue(kwargs.get(\"seconds\", 0))\n103\t\n104\t    background.BackgroundScheduler = BackgroundScheduler\n105\t    interval.IntervalTrigger = IntervalTrigger\n106\t    schedulers.SchedulerAlreadyRunningError = SchedulerAlreadyRunningError\n107\t    schedulers.JobLookupError = JobLookupError\n108\t    schedulers.background = background\n109\t    triggers.interval = interval\n110\t    apscheduler.schedulers = schedulers\n111\t    apscheduler.triggers = triggers\n112\t\n113\t    sys.modules[\"apscheduler\"]