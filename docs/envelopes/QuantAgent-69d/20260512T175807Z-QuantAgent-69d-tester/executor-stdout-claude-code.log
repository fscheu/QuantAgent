{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015DjqHEFTHPARrUi1LnwRv8","type":"tool_result","content":"1\t\"\"\"SQLAlchemy database configuration and engine setup.\"\"\"\n2\t\n3\tfrom sqlalchemy import create_engine\n4\tfrom sqlalchemy.orm import Session, declarative_base, sessionmaker\n5\tfrom sqlalchemy.pool import StaticPool\n6\t\n7\tfrom quantagent import settings\n8\t\n9\t# Base class for all models (safe to import without DB configured)\n10\tBase = declarative_base()\n11\t\n12\t# Lazy-initialized module-level singletons\n13\t_engine = None\n14\t_SessionLocal = None\n15\t\n16\t\n17\tdef _get_engine():\n18\t    \"\"\"Create or return the cached engine. Validates DATABASE_URL on first call only.\"\"\"\n19\t    global _engine\n20\t    if _engine is None:\n21\t        url = settings.require(\"DATABASE_URL\")\n22\t        if url.startswith(\"sqlite\"):\n23\t            _engine = create_engine(\n24\t                url, connect_args={\"check_same_thread\": False}, poolclass=StaticPool\n25\t            )\n26\t        else:\n27\t            _engine = create_engine(url, pool_pre_ping=True, echo=False)\n28\t    return _engine\n29\t\n30\t\n31\tdef _get_session_factory():\n32\t    \"\"\"Create or return the cached session factory.\"\"\"\n33\t    global _SessionLocal\n34\t    if _SessionLocal is None:\n35\t        _SessionLocal = sessionmaker(autocommit=False, autoflush=False, bind=_get_engine())\n36\t    return _SessionLocal\n37\t\n38\t\n39\t# Keep backward-compatible names as properties via module-level getters.\n40\t# Code that accesses `database.engine` or `database.SessionLocal` directly\n41\t# will now trigger lazy init (and validation) on first access.\n42\t\n43\tclass _LazyEngine:\n44\t    \"\"\"Descriptor-like proxy so `database.engine` still works.\"\"\"\n45\t    def __repr__(self):\n46\t        return repr(_get_engine())\n47\t    def __getattr__(self, name):\n48\t        return getattr(_get_engine(), name)\n49\t\n50\tclass _LazySessionLocal:\n51\t    \"\"\"Descriptor-like proxy so `database.SessionLocal()` still works.\"\"\"\n52\t    def __call__(self, *args, **kwargs):\n53\t        return _get_session_factory()(*args, **kwargs)\n54\t    def __getattr__(self, name):\n55\t        return getattr(_get_session_factory(), name)\n56\t\n57\t\n58\tengine = _LazyEngine()\n59\tSessionLocal = _LazySessionLocal()\n60\t\n61\t\n62\tdef get_db() -> Session:\n63\t    \"\"\"Get database session for dependency injection.\"\"\"\n64\t    db = _get_session_factory()()\n65\t    try:\n66\t        yield db\n67\t    finally:\n68\t        db.close()\n69\t\n70\t\n71\tdef init_db() -> None:\n72\t    \"\"\"Initialize database by creating all tables.\"\"\"\n73\t    # Import models lazily so metadata is populated before create_all\n74\t    from quantagent import models  # noqa: F401\n75\t\n76\t    Base.metadata.create_all(bind=_get_engine())\n77\t\n78\t\n79\tdef drop_all_tables() -> None:\n80\t    \"\"\"Drop all tables (use with caution!).\"\"\"\n81\t    from quantagent import models  # noqa: F401\n82\t\n83\t    Base.metadata.drop_all(bind=_get_engine())\n84\t"}]},"parent_tool_use_id":null,"session_id":"6027cba3-e69d-464f-aa78-e9e9792aa2ae","uuid":"f7b298af-8a8c-4739-8827-85bbff28fc18","timestamp":"2026-05-12T18:01:36.331Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/autodev-worktrees/QuantAgent/QuantAgent-69d/planner-20260512T124234Z/quantagent/database.py","content":"\"\"\"SQLAlchemy database configuration and engine setup.\"\"\"\n\nfrom sqlalchemy import create_engine\nfrom sqlalchemy.orm import Session, declarative_base, sessionmaker\nfrom sqlalchemy.pool import StaticPool\n\nfrom quantagent import settings\n\n# Base class for all models (safe to import without DB configured)\nBase = declarative_base()\n\n# Lazy-initialized module-level singletons\n_engine = None\n_SessionLocal = None\n\n\ndef _get_engine():\n    \"\"\"Create or return the cached engine. Validates DATABASE_URL on first call only.\"\"\"\n    global _engine\n    if _engine is None:\n        url = settings.require(\"DATABASE_URL\")\n        if url.startswith(\"sqlite\"):\n            _engine = create_engine(\n                url, connect_args={\"check_same_thread\": False}, poolclass=StaticPool\n            )\n        else:\n            _engine = create_engine(url, pool_pre_ping=True, echo=False)\n    return _engine\n\n\ndef _get_session_factory():\n    \"\"\"Create or return the cached session factory.\"\"\"\n    global _SessionLocal\n    if _SessionLocal is None:\n        _SessionLocal = sessionmaker(autocommit=False, autoflush=False, bind=_get_engine())\n    return _SessionLocal\n\n\n# Keep backward-compatible names as properties via module-level getters.\n# Code that accesses `database.engine` or `database.SessionLocal` directly\n# will now trigger lazy init (and validation) on first access.\n\nclass _LazyEngine:\n    \"\"\"Descriptor-like proxy so `database.engine` still works.\"\"\"\n    def __repr__(self):\n        return repr(_get_engine())\n    def __getattr__(self, name):\n        return getattr(_get_engine(), name)\n\nclass _LazySessionLocal:\n    \"\"\"Descriptor-like proxy so `database.SessionLocal()` still works.\"\"\"\n    def __call__(self, *args, **kwargs):\n        return _get_session_factory()(*args, **kwargs)\n    def __getattr__(self, name):\n        return getattr(_get_session_factory(), name)\n\n\nengine = _LazyEngine()\nSessionLocal = _LazySessionLocal()\n\n\ndef get_db() -> Session:\n    \"\"\"Get database session for dependency injection.\"\"\"\n    db = _get_session_factory()()\n    try:\n        yield db\n    finally:\n        db.close()\n\n\ndef init_db() -> None:\n    \"\"\"Initialize database by creating all tables.\"\"\"\n    # Import models lazily so metadata is populated before create_all\n    from quantagent import models  # noqa: F401\n\n    Base.metadata.create_all(bind=_get_engine())\n\n\ndef drop_all_tables() -> None:\n    \"\"\"Drop all tables (use with caution!).\"\"\"\n    from quantagent import models  # noqa: F401\n\n    Base.metadata.drop_all(bind=_get_engine())\n","numLines":84,"startLine":1,"totalLines":84}}}
