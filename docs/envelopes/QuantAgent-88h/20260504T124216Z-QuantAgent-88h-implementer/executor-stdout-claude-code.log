me\", \"kind\"),)\n278\t\n279\t\n280\tclass BacktestRun(Base):\n281\t    \"\"\"BacktestRun model for recording backtest executions and configurations.\"\"\"\n282\t\n283\t    __tablename__ = \"backtest_runs\"\n284\t\n285\t    id = Column(Integer, primary_key=True, index=True)\n286\t    name = Column(String(200), nullable=True)\n287\t    timeframe = Column(String(10), nullable=False)  # \"1h\", \"4h\", \"1d\", etc.\n288\t    assets = Column(JSON, nullable=False)  # List of symbols, e.g., [\"BTC\", \"SPX\", \"CL\"]\n289\t    start_date = Column(DateTime, nullable=False, index=True)\n290\t    end_date = Column(DateTime, nullable=False, index=True)\n291\t    data_source = Column(\n292\t        String(200), nullable=True\n293\t    )  # Optional source/hash for reproducibility\n294\t    config_snapshot = Column(JSON, nullable=False)  # Immutable config at run time\n295\t    created_at = Column(DateTime, nullable=False, default=datetime.utcnow, index=True)\n296\t\n297\t    # Result metrics (nullable until run completes)\n298\t    total_trades = Column(Integer, nullable=True)\n299\t    win_rate = Column(Float, nullable=True)\n300\t    profit_factor = Column(Float, nullable=True)\n301\t    sharpe_ratio = Column(Float, nullable=True)\n302\t    max_drawdown = Column(Float, nullable=True)\n303\t    total_pnl = Column(Numeric(precision=18, scale=8), nullable=True)\n304\t\n305\t    __table_args__ = (Index(\"idx_start_end_date\", \"start_date\", \"end_date\"),)\n306\t\n307\t    # Relationships\n308\t    active_positions = relationship(\"ActivePosition\", back_populates=\"backtest_run\")\n309\t\n310\t\n311\tclass ActivePosition(Base):\n312\t    \"\"\"ActivePosition model for tracking active positions with stop-loss and take-profit.\"\"\"\n313\t\n314\t    __tablename__ = \"active_positions\"\n315\t\n316\t    id = Column(Integer, primary_key=True, index=True)\n317\t    symbol = Column(String(20), nullable=False, index=True)\n318\t    side = Column(Enum(OrderSide), nullable=False)\n319