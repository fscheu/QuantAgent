{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Ttg58jxVWqRsquEyhkHd2J","type":"tool_result","content":"1\t\"\"\"SQLAlchemy models for QuantAgent trading system.\"\"\"\n2\t\n3\timport enum\n4\tfrom datetime import datetime\n5\t\n6\tfrom sqlalchemy import JSON, Boolean, Column, DateTime, Enum, Float, ForeignKey, Index, Integer, Numeric, String, Text\n7\tfrom sqlalchemy.orm import relationship\n8\t\n9\tfrom .database import Base\n10\t\n11\t\n12\tclass OrderStatus(str, enum.Enum):\n13\t    \"\"\"Enum for order statuses.\"\"\"\n14\t\n15\t    PENDING = \"pending\"\n16\t    FILLED = \"filled\"\n17\t    PARTIALLY_FILLED = \"partially_filled\"\n18\t    CANCELLED = \"cancelled\"\n19\t    REJECTED = \"rejected\"\n20\t\n21\t\n22\tclass OrderSide(str, enum.Enum):\n23\t    \"\"\"Enum for order side (buy/sell).\"\"\"\n24\t\n25\t    BUY = \"buy\"\n26\t    SELL = \"sell\"\n27\t\n28\t\n29\tclass OrderType(str, enum.Enum):\n30\t    \"\"\"Enum for order types.\"\"\"\n31\t\n32\t    MARKET = \"market\"\n33\t    LIMIT = \"limit\"\n34\t    STOP = \"stop\"\n35\t    STOP_LIMIT = \"stop_limit\"\n36\t\n37\t\n38\tclass TradeSignal(str, enum.Enum):\n39\t    \"\"\"Enum for trading signals.\"\"\"\n40\t\n41\t    LONG = \"long\"\n42\t    SHORT = \"short\"\n43\t    NEUTRAL = \"neutral\"\n44\t    CLOSE = \"close\"\n45\t\n46\t\n47\tclass Environment(str, enum.Enum):\n48\t    \"\"\"Enum for execution environments.\"\"\"\n49\t\n50\t    BACKTEST = \"backtest\"\n51\t    PAPER = \"paper\"\n52\t    PROD = \"prod\"\n53\t\n54\t\n55\tclass ExitPolicy(str, enum.Enum):\n56\t    \"\"\"Enum for position exit policies.\"\"\"\n57\t\n58\t    SL_TP_ONLY = \"sl_tp_only\"\n59\t    TIME_BASED = \"time_based\"\n60\t    REEVALUATE = \"reevaluate\"\n61\t    TRAILING_STOP = \"trailing_stop\"\n62\t\n63\t\n64\tclass Order(Base):\n65\t    \"\"\"Order model for placing and tracking trading orders.\"\"\"\n66\t\n67\t    __tablename__ = \"orders\"\n68\t\n69\t    id = Column(Integer, primary_key=True, index=True)\n70\t    symbol = Column(String(20), nullable=False, index=True)\n71\t    side = Column(Enum(OrderSide), nullable=False)\n72\t    order_type = Column(Enum(OrderType), nullable=False)\n73\t    quantity = Column(Numeric(precision=18, scale=8), nullable=False)\n74\t    price = Column(Numeric(precision=18, scale=8), nullable=True)\n75\t    stop_price = Column(Numeric(precision=18, scale=8), nullable=True)\n76\t    status = Column(Enum(OrderStatus), nullable=False, default=OrderStatus.PENDING)\n77\t    created_at = Column(DateTime, nullable=False, default=datetime.utcnow, index=True)\n78\t    updated_at = Column(\n79\t        DateTime, nullable=False, default=datetime.utcnow, onupdate=datetime.utcnow\n80\t    )\n81\t    filled_at = Column(DateTime, nullable=True, index=True)\n82\t    filled_quantity = Column(Numeric(precision=18, scale=8), nullable=False, default=0)\n83\t    average_fill_price = Column(Numeric(precision=18, scale=8), nullable=True)\n84\t    comment = Column(Text, nullable=True)\n85\t\n86\t    # Environment & Provenance (NEW)\n87\t    environment = Column(\n88\t        Enum(Environment), nullable=False, default=Environment.PAPER, index=True\n89\t    )\n90\t    trigger_signal_id = Column(Integer, ForeignKey(\"signals.id\"), nullable=True)\n91\t\n92\t    # Relationships\n93\t    fills = relationship(\"Fill\", back_populates=\"order\", cascade=\"all, delete-orphan\")\n94\t    trades = relationship(\"Trade\", back_populates=\"order\", cascade=\"all, delete-orphan\")\n95\t    trigger_signal = relationship(\n96\t        \"Signal\", foreign_keys=[trigger_signal_id], back_populates=\"triggered_orders\"\n97\t    )\n98\t\n99\t    __table_args__ = (\n100\t        Index(\"idx_symbol_created_at\", \"symbol\", \"created_at\"),\n101\t        Index(\"idx_status_symbol\", \"status\", \"symbol\"),\n102\t        Index(\"idx_orders_environment\", \"environment\"),\n103\t    )\n104\t\n105\t\n106\tclass Fill(Base):\n107\t    \"\"\"Fill model for partial/full order executions.\"\"\"\n108\t\n109\t    __tablename__ = \"fills\"\n110\t\n111\t    id = Column(Integer, primary_key=True, index=True)\n112\t    order_id = Column(Integer, ForeignKey(\"orders.id\"), nullable=False, index=True)\n113\t    quantity = Column(Numeric(precision=18, scale=8), nullable=False)\n114\t    price = Column(Numeric(precision=18, scale=8), nullable=False)\n115\t    commission = Column(Numeric(precision=18, scale=8), nullable=False, default=0)\n116\t    filled_at = Column(DateTime, nullable=False, default=datetime.utcnow, index=True)\n117\t\n118\t    # Relationships\n119\t    order = relationship(\"Order\", back_populates=\"fills\")\n120\t\n121\t    __table_args__ = (Index(\"idx_order_filled_at\", \"order_id\", \"filled_at\"),)\n122\t\n123\t\n124\tclass Position(Base):\n125\t    \"\"\"Position model for tracking open positions.\"\"\"\n126\t\n127\t    __tablename__ = \"positions\"\n128\t\n129\t    id = Column(Integer, primary_key=True, index=True)\n130\t    symbol = Column(String(20), nullable=False, unique=True, index=True)\n131\t    quantity = Column(Numeric(precision=18, scale=8), nullable=False)\n132\t    average_entry_price = Column(Numeric(precision=18, scale=8), nullable=False)\n133\t    current_price = Column(Numeric(precision=18, scale=8), nullable=False)\n134\t    unrealized_pnl = Column(Numeric(precision=18, scale=8), nullable=False)\n135\t    unrealized_pnl_pct = Column(Float, nullable=False)\n136\t    side = Column(Enum(OrderSide), nullable=False)\n137\t    opened_at = Column(DateTime, nullable=False, default=datetime.utcnow, index=True)\n138\t    updated_at = Column(\n139\t        DateTime, nullable=False, default=datetime.utcnow, onupdate=datetime.utcnow\n140\t    )\n141\t\n142\t\n143\tclass Signal(Base):\n144\t    \"\"\"Signal model for tracking trading signals from agents.\"\"\"\n145\t\n146\t    __tablename__ = \"signals\"\n147\t\n148\t    id = Column(Integer, primary_key=True, index=True)\n149\t    symbol = Column(String(20), nullable=False, index=True)\n150\t    signal = Column(Enum(TradeSignal), nullable=False)\n151\t    confidence = Column(Float, nullable=False)  # 0-1 scale\n152\t    timeframe = Column(String(10), nullable=False)  # 1m, 5m, 15m, 1h, 4h, 1d, etc.\n153\t\n154\t    # Agent analysis details\n155\t    rsi = Column(Float, nullable=True)\n156\t    macd = Column(Float, nullable=True)\n157\t    stochastic = Column(Float, nullable=True)\n158\t    roc = Column(Float, nullable=True)\n159\t    williams_r = Column(Float, nullable=True)\n160\t    pattern = Column(String(100), nullable=True)\n161\t    trend = Column(String(50), nullable=True)\n162\t\n163\t    # Analysis report\n164\t    analysis_summary = Column(Text, nullable=True)\n165\t    generated_at = Column(DateTime, nullable=False, default=datetime.utcnow, index=True)\n166\t\n167\t    # Environment & Provenance (NEW)\n168\t    environment = Column(\n169\t        Enum(Environment), nullable=False, default=Environment.PAPER, index=True\n170\t    )\n171\t    order_id = Column(Integer, ForeignKey(\"orders.id\"), nullable=True)\n172\t\n173\t    # Checkpoint & Metadata (NEW)\n174\t    thread_id = Column(String(100), nullable=True)\n175\t    checkpoint_id = Column(String(100), nullable=True)\n176\t    state_snapshot = Column(JSON, nullable=True)\n177\t\n178\t    # Model metadata\n179\t    model_provider = Column(String(50), nullable=True)  # \"openai\", \"anthropic\", \"qwen\"\n180\t    model_name = Column(String(100), nullable=True)  # \"gpt-4o\", \"claude-3-opus\", etc.\n181\t    temperature = Column(Float, nullable=True)  # Model temperature used\n182\t    agent_version = Column(String(50), nullable=True)\n183\t    graph_version = Column(String(50), nullable=True)\n184\t\n185\t    # Relationships\n186\t    triggered_orders = relationship(\n187\t        \"Order\", foreign_keys=\"Order.trigger_signal_id\", back_populates=\"trigger_signal\"\n188\t    )\n189\t\n190\t    __table_args__ = (\n191\t        Index(\"idx_symbol_generated_at\", \"symbol\",