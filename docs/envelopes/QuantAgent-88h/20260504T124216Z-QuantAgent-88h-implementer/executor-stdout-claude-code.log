 background\n61\t    triggers.interval = interval\n62\t    apscheduler.schedulers = schedulers\n63\t    apscheduler.triggers = triggers\n64\t\n65\t    sys.modules[\"apscheduler\"] = apscheduler\n66\t    sys.modules[\"apscheduler.schedulers\"] = schedulers\n67\t    sys.modules[\"apscheduler.schedulers.background\"] = background\n68\t    sys.modules[\"apscheduler.triggers\"] = triggers\n69\t    sys.modules[\"apscheduler.triggers.interval\"] = interval\n70\t\n71\t# ============================================================================\n72\t# Data Fixtures\n73\t# ============================================================================\n74\t\n75\t\n76\t@pytest.fixture\n77\tdef sample_ohlcv_data() -> Dict[str, List[float]]:\n78\t    \"\"\"\n79\t    Provide sample OHLCV data for testing.\n80\t\n81\t    Returns:\n82\t        Dictionary with 'open', 'high', 'low', 'close', 'volume' keys\n83\t        containing 30 candlesticks of realistic price data.\n84\t    \"\"\"\n85\t    np.random.seed(42)\n86\t    num_candles = 30\n87\t\n88\t    # Generate realistic price movements\n89\t    prices = np.cumsum(np.random.randn(num_candles)) + 100\n90\t\n91\t    return {\n92\t        \"open\": [float(p) for p in prices],\n93\t        \"high\": [float(p + abs(np.random.randn())) for p in prices],\n94\t        \"low\": [float(p - abs(np.random.randn())) for p in prices],\n95\t        \"close\": [float(p + np.random.randn() * 0.5) for p in prices],\n96\t        \"volume\": [\n97\t            float(1000000 + np.random.randint(-100000, 100000))\n98\t            for _ in range(num_candles)\n99\t        ],\n100\t    }\n101\t\n102\t\n103\t@pytest.fixture\n104\tdef sample_ohlcv_dataframe(sample_ohlcv_data) -> pd.DataFrame:\n105\t    \"\"\"\n106\t    Provide sample OHLCV data as a pandas DataFrame.\n107\t\n108\t    Returns:\n109\t        DataFrame with datetime index and OHLCV columns.\n110\t    \"\"\"\n111\t    df = pd.DataFrame(sample_ohlcv_data)\n112\t    df.index = pd.date_range(end=datetime.now(), periods=len(df), freq=\"1h\")\n113\t    df.index.name = \"datetime\"\n114\t    return df\n115\t\n116\t\n117\t@pytest.fixture\n118\tdef sample_state_inicial() -> Dict:\n119\t    return {\n120\t        \"kline_data\": {\n121\t            \"open\": [100.0] * 30,\n122\t            \"high\": [101.0] * 30,\n123\t            \"low\": [99.0] * 30,\n124\t            \"close\": [100.5] * 30,\n125\t            \"volume\": [1000000.0] * 30,\n126\t        },\n127\t        \"analysis_results\": None,\n128\t        \"messages\": [],\n129\t        \"time_frame\": \"1hour\",\n130\t        \"stock_name\": \"BTC\",\n131\t        \"pattern_image\": \"base64_encoded_image_data\",\n132\t        \"trend_image\": \"base64_encoded_image_data\",\n133\t    }\n134\t\n135\t\n136\t@pytest.fixture\n137\tdef sample_state() -> Dict:\n138\t    \"\"\"\n139\t    Provide a minimal valid IndicatorAgentState for testing.\n140\t\n141\t    Returns:\n142\t        Dictionary matching IndicatorAgentState structure with sample data.\n143\t    \"\"\"\n144\t    return {\n145\t        \"kline_data\": {\n146\t            \"open\": [100.0] * 30,\n147\t            \"high\": [101.0] * 30,\n148\t            \"low\": [99.0] * 30,\n149\t            \"close\": [100.5] * 30,\n150\t            \"volume\": [1000000.0] * 30,\n151\t        },\n152\t        \"time_frame\": \"1hour\",\n153\t        \"stock_name\": \"BTC\",\n154\t        \"rsi\": [50.0] * 30,\n155\t        \"macd\": [0.0] * 30,\n156\t        \"macd_signal\": [0.0] * 30,\n157\t        \"macd_hist\": [0.0] * 30,\n158\t        \"stoch_k\": [50.0] * 30,\n159\t        \"stoch_d\": [50.0] * 30,\n160\t        \"roc\": [0.0] * 30,\n161\t        \"willr\": [-50.0] * 30,\n162\t        \"indicator_report\": \"Sample indicator report\",\n163\t        \"pattern_image\": \"base64_encoded_image_data\",\n164\t        \"pattern_image_filename\": \"/tmp/pattern.png\",\n165\t        \"pattern_image_description\": \"Sample pattern description\",\n166\t        \"pattern_report\": \"Sample pattern report\",\n167\t        \"trend_image\": \"base64_encoded_image_data\",\n168\t        \"trend_image_filename\": \"/tmp/trend.png\",\n169\t        \"trend_image_description\": \"Sample trend description\",\n170\t        \"trend_report\": \"Sample trend report\",\n171\t        \"analysis_results\": None,\n172\t        \"messages\": [],\n173\t        \"decision_prompt\": \"Sample decision prompt\",\n174\t        \"final_trade_decision\": \"\",\n175\t    }\n176\t\n177\t\n178\t# ============================================================================\n179\t# Configuration Fixtures\n180\t# ============================================================================\n181\t\n182\t\n183\t@pytest.fixture\n184\tdef mock_config() -> Dict:\n185\t    \"\"\"\n186\t    Provide mock LLM configuration for testing.\n187\t\n188\t    Returns:\n189\t        Dictionary with mock API keys and model settings.\n190\t    \"\"\"\n191\t    return {\n192\t        \"agent_llm_model\": \"gpt-4o-mini\",\n193\t        \"graph_llm_model\": \"gpt-4o\",\n194\t        \"agent_llm_provider\": \"openai\",\n195\t        \"graph_llm_provider\": \"openai\",\n196\t        \"agent_llm_temperature\": 0.1,\n197\t        \"graph_llm_temperature\": 0.1,\n198\t        \"api_key\": \"sk-test-key-12345\",\n199\t        \"anthropic_api_key\": \"sk-ant-test-key\",\n200\t        \"qwen_api_key\": \"sk-qwen-test-key\",\n201\t    }\n202\t\n203\t\n204\t@pytest.fixture\n205\tdef mock_env_vars(monkeypatch):\n206\t    \"\"\"\n207\t    Set up mock environment variables for testing.\n208\t\n209\t    Args:\n210\t        monkeypatch: pytest's monkeypatch fixture.\n211\t    \"\"\"\n212\t    monkeypatch.setenv(\"OPENAI_API_KEY\", \"sk-test-openai-key\")\n213\t    monkeypatch.setenv(\"ANTHROPIC_API_KEY\", \"sk-ant-test-key\")\n214\t    monkeypatch.setenv(\"DASHSCOPE_API_KEY\", \"sk-qwen-test-key\")\n215\t\n216\t\n217\t@pytest.fixture(autouse=True)\n218\tdef ensure_default_llm_api_keys(monkeypatch):\n219\t    \"\"\"Provide deterministic fallback API keys so CI can run without secrets.\"\"\"\n220\t\n221\t    from quantagent import settings as qa_settings\n222\t\n223\t    defaults = {\n224\t        \"OPENAI_API_KEY\": \"sk-test-openai-key\",\n225\t        \"ANTHROPIC_API_KEY\": \"sk-ant-test-key\",\n226\t        \"DASHSCOPE_API_KEY\": \"sk-qwen-test-key\",\n227\t    }\n228\t\n229\t    for key, value in defaults.items():\n230\t        current = os.environ.get(key)\n231\t        if not current:\n232\t            current = value\n233\t            monkeypatch.setenv(key, current)\n234\t        monkeypatch.setattr(qa_settings, key, current, raising=False)\n235\t\n236\t\n237\t# ============================================================================\n238\t# LLM Mock Fixtures\n239\t# ============================================================================\n240\t\n241\t\n242\tclass StructuredMockLLM:\n243\t    \"\"\"\n244\t    Mock LLM supporting modern LangChain patterns.\n245\t\n246\t    Supports both legacy invoke() and modern with_structured_output() patterns.\n247\t    Returns actual Pydantic model instances when used with structured output.\n248\t    \"\"\"\n249\t\n250\t    def __init__(self, default_overrides=None):\n251\t        \"\"\"Initialize with optional field overrides.\"\"\"\n252\t        self.default_overrides = default_overrides or {}\n253\t\n254\t    def invoke(self, messages):\n255\t        return \"Mock LLM response\"\n256\t\n257\t    def with_structured_output(self, schema):\n258\t        \"\"\"\n259\t        Modern pattern: return mock LLM that produces Pydantic instances.\n260\t\n261\t        Args:\n262\t            schema: Pydantic model class (IndicatorReport, PatternReport, etc.)\n263\t\n264\t        Returns:\n265\t            Mock LLM with invoke() that returns schema instance\n266\t        \"\"\"\n267\t        structured_mock = Mock()\n268\t\n269\t        # Create default values based on schema type\n270\t        if schema == IndicatorReport:\n271\t            defaults = {\n272\t                \"macd\": 0.5,\n273\t                \"macd_signal\": 0.3,\n274\t                \"macd_histogram\": 0.2,\n275\t                \"rsi\": 65.0,\n276\t                \"rsi_level\": \"overbought\",\n277\t                \"roc\": 2.5,\n278\t                \"stochastic\": 75.0,\n279\t                \"willr\": -25.0,\n280\t                \"trend_direction\": \"bullish\",\n281\t                \"confidence\": 0.75,\n282\t                \"reasoning\": \"Mock indicator analysis\",\n283\t            }\n284\t        elif schema == PatternReport:\n285\t            defaults = {\n286\t                \"patterns_detected\": [\"double_bottom\"],\n287\t                \"primary_pattern\": \"double_bottom\",\n288\t                \"confidence\": 0.75,\n289\t                \"breakout_probability\": 0.65,\n290\t                \"reasoning\": \"Mock pattern detected\",\n291\t            }\n292\t        elif schema == TrendReport:\n293\t            defaults = {\n294\t                \"support_level\": 99.5,\n295\t                \"resistance_level\": 101.5,\n296\t                \"trend_direction\": \"upward\",\n297\t                \"trend_strength\": 0.75,\n298\t                \"reasoning\": \"Mock trend analysis\",\n299\t            }\n300\t        elif schema == TradingDecision:\n301\t            defaults = {\n302\t                \"decision\": \"LONG\",\n303\t                \"entry_price\": 100.5,\n304\t                \"take_profit\": 102.5,\n305\t                \"stop_loss\": 98.5,\n306\t                \"confidence\": 0.75,\n307\t                \"risk_level\": \"medium\",\n308\t                \"reasoning\": \"Mock trading decision\",\n309\t            }\n310\t        else:\n311\t            defaults = {}\n312\t\n313\t        # Merge with custom overrides\n314\t        defaults.update(self.default_overrides)\n315\t\n316\t        # Create Pydantic instance\n317\t        instance = schema(**defaults)\n318\t        structured_mock.invoke = Mock(return_value=instance)\n319\t\n320\t        return structured_mock\n321\t\n322\t    def bind_tools(self, tools):\n323\t        \"\"\"Mock tool binding.\"\"\"\n324\t        return self\n325\t\n326\t\n327\t@pytest.fixture\n328\tdef mock_llm():\n329\t    \"\"\"\n330\t    Provide a StructuredMockLLM for agent testing.\n331\t\n332\t    Supports both legacy and modern patterns.\n333\t    \"\"\"\n334\t    return StructuredMockLLM()\n335\t\n336\t\n337\t@pytest.fixture\n338\tdef mock_llm_custom():\n339\t    \"\"\"\n340\t    Factory fixture for creating StructuredMockLLM with custom field values.\n341\t\n342\t    Usage:\n343\t        def test_something(mock_llm_custom):\n344\t            llm = mock_llm_custom({\"confidence\": 0.9, \"trend_direction\": \"bearish\"})\n345\t    \"\"\"\n346\t\n347\t    def create_with_overrides(overrides):\n348\t        return StructuredMockLLM(default_overrides=overrides)\n349\t\n350\t    return create_with_overrides\n351\t\n352\t\n353\t@pytest.fixture\n354\tdef mock_openai_llm():\n355\t    \"\"\"\n356\t    Provide a mock OpenAI LLM for testing.\n357\t\n358\t    Returns:\n359\t        StructuredMockLLM object configured like OpenAI LLM.\n360\t    \"\"\"\n361\t    return StructuredMockLLM()\n362\t\n363\t\n364\t@pytest.fixture\n365\tdef mock_anthropic_llm():\n366\t    \"\"\"\n367\t    Provide a mock Anthropic LLM for testing.\n368\t\n369\t    Returns:\n370\t        StructuredMockLLM object configured like Anthropic LLM.\n371\t    \"\"\"\n372\t    return StructuredMockLLM()\n373\t\n374\t\n375\t@pytest.fixture\n376\tdef mock_vision_llm():\n377\t    \"\"\"\n378\t    Provide a mock vision-capable LLM for pattern/trend analysis.\n379\t\n380\t    Returns:\n381\t        StructuredMockLLM object configured for vision tasks.\n382\t    \"\"\"\n383\t    return StructuredMockLLM()\n384\t\n385\t\n386\t# ============================================================================\n387\t# Toolkit Mock Fixtures\n388\t# ============================================================================\n389\t\n390\t\n391\tclass MockToolkit:\n392\t    \"\"\"Mock toolkit with indicator and chart generation functions.\"\"\"\n393\t\n394\t    def __init__(self):\n395\t        \"\"\"Initialize all tool mocks with default return values.\"\"\"\n396\t        self.compute_macd = Mock(name=\"compute_macd\")\n397\t        self.compute_rsi = Mock(name=\"compute_rsi\")\n398\t        self.compute_roc = Mock(name=\"compute_roc\")\n399\t        self.compute_stoch = Mock(name=\"compute_stoch\")\n400\t        self.compute_willr = Mock(name=\"compute_willr\")\n401\t\n402\t        # Setup default return values for tool invocation\n403\t        self.compute_macd.invoke = Mock(\n404\t            return_value={\"macd\": 0.5, \"signal\": 0.3, \"histogram\": 0.2}\n405\t        )\n406\t        self.compute_rsi.invoke = Mock(return_value={\"rsi\": 65.0})\n407\t        self.compute_roc.invoke = Mock(return_value={\"roc\": 2.5})\n408\t        self.compute_stoch.invoke = Mock(return_value={\"stochastic\": 75.0})\n409\t        self.compute_willr.invoke = Mock(return_value={\"willr\": -25.0})\n410\t        self.generate_kline_image = Mock(name=\"generate_kline_image\")\n411\t        self.generate_kline_image.invoke = Mock(\n412\t            return_value={\"pattern_image\": \"mock_b64_encoded_png_pattern\"}\n413\t        )\n414\t        self.generate_trend_image = Mock(name=\"generate_trend_image\")\n415\t        self.generate_trend_image.invoke = Mock(\n416\t            return_value={\"trend_image\": \"mock_b64_encoded_png_trend\"}\n417\t        )\n418\t\n419\t    # def generate_kline_image(self):\n420\t    #     \"\"\"Mock K-line image generation tool.\"\"\"\n421\t    #     mock_tool = Mock()\n422\t    #     mock_tool.invoke = Mock(return_value={\n423\t    #         \"pattern_image\": \"mock_b64_encoded_png_pattern\"\n424\t    #     })\n425\t    #     return mock_tool\n426\t\n427\t    # def generate_trend_image(self):\n428\t    #  