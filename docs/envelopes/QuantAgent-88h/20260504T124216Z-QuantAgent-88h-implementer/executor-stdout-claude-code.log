{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019vCDHoPVS2Can4tj79Q23V","type":"tool_result","content":"1\t\"\"\"\n2\tCentralized configuration management.\n3\tLoads environment variables from .env file and provides typed access to all settings.\n4\t\"\"\"\n5\t\n6\timport os\n7\tfrom dataclasses import dataclass, field, replace\n8\tfrom pathlib import Path\n9\tfrom typing import List, Optional\n10\t\n11\tfrom dotenv import load_dotenv\n12\t\n13\t# Load .env files (idempotent - only loads once)\n14\t# Load .env first (shared defaults)\n15\tenv_path = Path(__file__).parent.parent / \".env\"\n16\tload_dotenv(dotenv_path=env_path)\n17\t\n18\t# Load .env.local second (worktree-specific overrides)\n19\t# This allows each worktree to have its own database without changing .env\n20\tenv_local_path = Path(__file__).parent.parent / \".env.local\"\n21\tif env_local_path.exists():\n22\t    load_dotenv(dotenv_path=env_local_path, override=True)\n23\t\n24\t# Database Configuration\n25\tDATABASE_URL: str = os.getenv(\"DATABASE_URL\", \"\")\n26\t\n27\t# LLM API Keys\n28\tOPENAI_API_KEY: str = os.getenv(\"OPENAI_API_KEY\", \"\")\n29\tANTHROPIC_API_KEY: str = os.getenv(\"ANTHROPIC_API_KEY\", \"\")\n30\tDASHSCOPE_API_KEY: str = os.getenv(\"DASHSCOPE_API_KEY\", \"\")  # Qwen\n31\t\n32\t# Azure OpenAI Configuration\n33\tAZURE_OPENAI_API_KEY: str = os.getenv(\"AZURE_OPENAI_API_KEY\", \"\")\n34\tAZURE_OPENAI_ENDPOINT: str = os.getenv(\"AZURE_OPENAI_ENDPOINT\", \"\")\n35\tAZURE_OPENAI_DEPLOYMENT: str = os.getenv(\"AZURE_OPENAI_DEPLOYMENT\", \"\")\n36\tAZURE_OPENAI_API_VERSION: str = os.getenv(\"AZURE_OPENAI_API_VERSION\", \"2024-02-01\")\n37\t\n38\t# LLM Provider Configuration\n39\tAGENT_LLM_PROVIDER: str = os.getenv(\"AGENT_LLM_PROVIDER\", \"openai\")\n40\tGRAPH_LLM_PROVIDER: str = os.getenv(\"GRAPH_LLM_PROVIDER\", \"openai\")\n41\t\n42\t\n43\t# LLM Model Configuration (defaults based on provider)\n44\tdef get_default_model(provider: str, is_agent: bool = True) -> str:\n45\t    \"\"\"Get default model based on provider.\"\"\"\n46\t    defaults = {\n47\t        \"openai\": {\"agent\": \"gpt-4o-mini\", \"graph\": \"gpt-4o\"},\n48\t        \"anthropic\": {\n49\t            \"agent\": \"claude-haiku-4-5-20251001\",\n50\t            \"graph\": \"claude-haiku-4-5-20251001\",\n51\t        },\n52\t        \"qwen\": {\"agent\": \"qwen3-max\", \"graph\": \"qwen3-vl-plus\"},\n53\t        \"azure\": {\"agent\": \"\", \"graph\": \"\"},\n54\t    }\n55\t    model_type = \"agent\" if is_agent else \"graph\"\n56\t    return defaults.get(provider, defaults[\"openai\"])[model_type]\n57\t\n58\t\n59\tAGENT_LLM_MODEL: str = os.getenv(\n60\t    \"AGENT_LLM_MODEL\", get_default_model(AGENT_LLM_PROVIDER, True)\n61\t)\n62\tGRAPH_LLM_MODEL: str = os.getenv(\n63\t    \"GRAPH_LLM_MODEL\", get_default_model(GRAPH_LLM_PROVIDER, False)\n64\t)\n65\t\n66\t# LLM Temperature Configuration\n67\tAGENT_LLM_TEMPERATURE: float = float(os.getenv(\"AGENT_LLM_TEMPERATURE\", \"0.1\"))\n68\tGRAPH_LLM_TEMPERATURE: float = float(os.getenv(\"GRAPH_LLM_TEMPERATURE\", \"0.1\"))\n69\t\n70\tdef require(name: str) -> str:\n71\t    \"\"\"Return the value of a setting, raising ValueError only when actually needed (lazy validation).\n72\t\n73\t    Use this instead of accessing module-level variables directly when the value\n74\t    is required at runtime (e.g., creating an API client or DB connection).\n75\t    This allows modules to be imported without blowing up in environments that\n76\t    lack certain config (CI, tests, etc.).\n77\t    \"\"\"\n78\t    value = globals().get(name, \"\") or os.getenv(name, \"\")\n79\t    if not value:\n80\t        raise ValueError(\n81\t            f\"{name} not configured. \"\n82\t            \"Set it in your .env file or via the web interface.\"\n83\t        )\n84\t    return value\n85\t\n86\t\n87\t# Logging Configuration\n88\tLOG_LEVEL: str = os.getenv(\"LOG_LEVEL\", \"INFO\")\n89\tLOG_TO_CONSOLE: bool = os.getenv(\"LOG_TO_CONSOLE\", \"true\").lower() == \"true\"\n90\tLOG_TO_DB: bool = os.getenv(\"LOG_TO_DB\", \"true\").lower() == \"true\"\n91\t\n92\t\n93\tDEFAULT_SCHEDULER_ASSETS = [\"BTC\", \"SPX\"]\n94\t\n95\t\n96\tdef _parse_bool_env(var_name: str, default: bool) -> bool:\n97\t    value = os.getenv(var_name)\n98\t    if value is None:\n99\t        return default\n100\t    return value.strip().lower() in {\"1\", \"true\", \"yes\", \"on\"}\n101\t\n102\t\n103\tdef _parse_float_env(var_name: str, default: float) -> float:\n104\t    value = os.getenv(var_name)\n105\t    if value is None:\n106\t        return default\n107\t    try:\n108\t        return float(value)\n109\t    except ValueError:\n110\t        return default\n111\t\n112\t\n113\tdef _parse_assets_env(value: Optional[str]) -> List[str]:\n114\t    if not value:\n115\t        return DEFAULT_SCHEDULER_ASSETS.copy()\n116\t    assets = [asset.strip().upper() for asset in value.split(\",\") if asset.strip()]\n117\t    return assets or DEFAULT_SCHEDULER_ASSETS.copy()\n118\t\n119\t\n120\t@dataclass\n121\tclass SchedulerSettings:\n122\t    enabled: bool = False\n123\t    interval_hours: float = 1.0\n124\t    assets: List[str] = field(default_factory=lambda: DEFAULT_SCHEDULER_ASSETS.copy())\n125\t    environment: str = \"paper\"\n126\t    timeframe: str = \"1h\"\n127\t    lookback_hours: float = 168.0\n128\t\n129\t    def __post_init__(self) -> None:\n130\t        self.interval_hours = float(self.interval_hours)\n131\t        self.lookback_hours = float(self.lookback_hours)\n132\t        if self.interval_hours <= 0:\n133\t            raise ValueError(\"interval_hours must be > 0\")\n134\t        if self.lookback_hours <= 0:\n135\t            raise ValueError(\"lookback_hours must be > 0\")\n136\t        normalized_assets = [\n137\t            asset.strip().upper() for asset in self.assets if asset.strip()\n138\t        ]\n139\t        if not normalized_assets:\n140\t            raise ValueError(\"assets list cannot be empty\")\n141\t        self.assets = normalized_assets\n142\t        env_value = self.environment.strip().lower()\n143\t        if env_value not in {\"backtest\", \"paper\", \"prod\"}:\n144\t            raise ValueError(\"environment must be one of: backtest, paper, prod\")\n145\t        self.environment = env_value\n146\t        timeframe_value = self.timeframe.strip().lower()\n147\t        if not timeframe_value:\n148\t            raise ValueError(\"timeframe cannot be empty\")\n149\t        self.timeframe = timeframe_value\n150\t\n151\t    @classmethod\n152\t    def from_env(cls) -> \"SchedulerSettings\":\n153\t        return cls(\n154\t            enabled=_parse_bool_env(\"TRADING_SCHEDULER_ENABLED\", False),\n155\t            interval_hours=_parse_float_env(\"TRADING_SCHEDULER_INTERVAL_HOURS\", 1.0),\n156\t            assets=_parse_assets_env(os.getenv(\"TRADING_SCHEDULER_ASSETS\")),\n157\t            environment=os.getenv(\"TRADING_SCHEDULER_ENVIRONMENT\", \"paper\"),\n158\t            timeframe=os.getenv(\"TRADING_SCHEDULER_TIMEFRAME\", \"1h\"),\n159\t            lookback_hours=_parse_float_env(\"TRADING_SCHEDULER_LOOKBACK_HOURS\", 168.0),\n160\t        )\n161\t\n162\t    def with_overrides(self, **overrides) -> \"SchedulerSettings\":\n163\t        return replace(self, **overrides)\n164\t\n165\t\n166\t# Scheduler configuration instance accessible as settings.scheduler\n167\tscheduler = SchedulerSettings.from_env()\n168\t\n169\t\n170\tdef update_env_file(key: str, value: str) -> None:\n171\t    \"\"\"\n172\t    Update or add a key-value pair in the .env file.\n173\t    Used by web_interface.py to persist API key changes.\n174\t    \"\"\"\n175\t    env_file = Path(__file__).parent.parent / \".env\"\n176\t\n177\t    # Read existing content\n178\t    if env_file.exists():\n179\t        with open(env_file, \"r\") as f:\n180\t            lines = f.readlines()\n181\t    else:\n182\t        lines = []\n183\t\n184\t    # Update or append the key\n185\t    key_found = False\n186\t    for i, line in enumerate(lines):\n187\t        if line.strip().startswith(f\"{key}=\"):\n188\t            lines[i] = f\"{key}={value}\\n\"\n189\t            key_found = True\n190\t            break\n191\t\n192\t    if not key_found:\n193\t        lines.append(f\"{key}={value}\\n\")\n194\t\n195\t    # Write back\n196\t    with open(env_file, \"w\") as f:\n197\t        f.writelines(lines)\n198\t\n199\t    # Update os.environ for runtime\n200\t    os.environ[key] = value\n201\t"}]},"parent_tool_use_id":null,"session_id":"9ae4eb5f-cbea-4dfd-8ced-66c92dcf87ef","uuid":"2e6515c9-837b-4073-9be9-284801cfaeaa","timestamp":"2026-05-04T12:43:53.555Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/autodev-worktrees/QuantAgent/QuantAgent-88h/implementer-20260504T124216Z/quantagent/settings.py","content":"\"\"\"\nCentralized configuration management.\nLoads environment variables from .env file and provides typed access to all settings.\n\"\"\"\n\nimport os\nfrom dataclasses import dataclass, field, replace\nfrom pathlib import Path\nfrom typing import List, Optional\n\nfrom dotenv import load_dotenv\n\n# Load .env files (idempotent - only loads once)\n# Load .env first (shared defaults)\nenv_path = Path(__file__).parent.parent / \".env\"\nload_dotenv(dotenv_path=env_path)\n\n# Load .env.local second (worktree-specific overrides)\n# This allows each worktree to have its own database without changing .env\nenv_local_path = Path(__file__).parent.parent / \".env.local\"\nif env_local_path.exists():\n    load_dotenv(dotenv_path=env_local_path, override=True)\n\n# Database Configuration\nDATABASE_URL: str = os.getenv(\"DATABASE_URL\", \"\")\n\n# LLM API Keys\nOPENAI_API_KEY: str = os.getenv(\"OPENAI_API_KEY\", \"\")\nANTHROPIC_API_KEY: str = os.getenv(\"ANTHROPIC_API_KEY\", \"\")\nDASHSCOPE_API_KEY: str = os.getenv(\"DASHSCOPE_API_KEY\", \"\")  # Qwen\n\n# Azure OpenAI Configuration\nAZURE_OPENAI_API_KEY: str = os.getenv(\"AZURE_OPENAI_API_KEY\", \"\")\nAZURE_OPENAI_ENDPOINT: str = os.getenv(\"AZURE_OPENAI_ENDPOINT\", \"\")\nAZURE_OPENAI_DEPLOYMENT: str = os.getenv(\"AZURE_OPENAI_DEPLOYMENT\", \"\")\nAZURE_OPENAI_API_VERSION: str = os.getenv(\"AZURE_OPENAI_API_VERSION\", \"2024-02-01\")\n\n# LLM Provider Configuration\nAGENT_LLM_PROVIDER: str = os.getenv(\"AGENT_LLM_PROVIDER\", \"openai\")\nGRAPH_LLM_PROVIDER: str = os.getenv(\"GRAPH_LLM_PROVIDER\", \"openai\")\n\n\n# LLM Model Configuration (defaults based on provider)\ndef get_default_model(provider: str, is_agent: bool = True) -> str:\n    \"\"\"Get default model based on provider.\"\"\"\n    defaults = {\n        \"openai\": {\"agent\": \"gpt-4o-mini\", \"graph\": \"gpt-4o\"},\n        \"anthropic\": {\n            \"agent\": \"claude-haiku-4-5-20251001\",\n            \"graph\": \"claude-haiku-4-5-20251001\",\n        },\n        \"qwen\": {\"agent\": \"qwen3-max\", \"graph\": \"qwen3-vl-plus\"},\n        \"azure\": {\"agent\": \"\", \"graph\": \"\"},\n    }\n    model_type = \"agent\" if is_agent else \"graph\"\n    return defaults.get(provider, defaults[\"openai\"])[model_type]\n\n\nAGENT_LLM_MODEL: str = os.getenv(\n    \"AGENT_LLM_MODEL\", get_default_model(AGENT_LLM_PROVIDER, True)\n)\nGRAPH_LLM_MODEL: str = os.getenv(\n    \"GRAPH_LLM_MODEL\", get_default_model(GRAPH_LLM_PROVIDER, False)\n)\n\n# LLM Temperature Configuration\nAGENT_LLM_TEMPERATURE: float = float(os.getenv(\"AGENT_LLM_TEMPERATURE\", \"0.1\"))\nGRAPH_LLM_TEMPERATURE: float = float(os.getenv(\"GRAPH_LLM_TEMPERATURE\", \"0.1\"))\n\ndef require(name: str) -> str:\n    \"\"\"Return the value of a setting, raising ValueError only when actually needed (lazy validation).\n\n    Use this instead of accessing module-level variables directly when the value\n    is required at runtime (e.g., creating an API client or DB connection).\n    This allows modules to be imported without blowing up in environments that\n    lack certain config (CI, tests, etc.).\n    \"\"\"\n    value = globals().get(name, \"\") or os.getenv(name, \"\")\n    if not value:\n        raise ValueError(\n            f\"{name} not configured. \"\n            \"Set it in your .env file or via the web interface.\"\n        )\n    return value\n\n\n# Logging Configuration\nLOG_LEVEL: str = os.getenv(\"LOG_LEVEL\", \"INFO\")\nLOG_TO_CONSOLE: bool = os.getenv(\"LOG_TO_CONSOLE\", \"true\").lower() == \"true\"\nLOG_TO_DB: bool = os.getenv(\"LOG_TO_DB\", \"true\").lower() == \"true\"\n\n\nDEFAULT_SCHEDULER_ASSETS = [\"BTC\", \"SPX\"]\n\n\ndef _parse_bool_env(var_name: str, default: bool) -> bool:\n    value = os.getenv(var_name)\n    if value is None:\n        return default\n    return value.strip().lower() in {\"1\", \"true\", \"yes\", \"on\"}\n\n\ndef _parse_float_env(var_name: str, default: float) -> float:\n    value = os.getenv(var_name)\n    if value is None:\n        return default\n    try:\n        return float(value)\n    except ValueError:\n        return default\n\n\ndef _parse_assets_env(value: Optional[str]) -> List[str]:\n    if not value:\n        return DEFAULT_SCHEDULER_ASSETS.copy()\n    assets = [asset.strip().upper() for asset in value.split(\",\") if asset.strip()]\n    return assets or DEFAULT_SCHEDULER_ASSETS.copy()\n\n\n@dataclass\nclass SchedulerSettings:\n    enabled: bool = False\n    interval_hours: float = 1.0\n    assets: List[str] = field(default_factory=lambda: DEFAULT_SCHEDULER_ASSETS.copy())\n    environment: str = \"paper\"\n    timeframe: str = \"1h\"\n    lookback_hours: float = 168.0\n\n    def __post_init__(self) -> None:\n        self.interval_hours = float(self.interval_hours)\n        self.lookback_hours = float(self.lookback_hours)\n        if self.interval_hours <= 0:\n            raise ValueError(\"interval_hours must be > 0\")\n        if self.lookback_hours <= 0:\n            raise ValueError(\"lookback_hours must be > 0\")\n        normalized_assets = [\n            asset.strip().upper() for asset in self.assets if asset.strip()\n        ]\n        if not normalized_assets:\n            raise ValueError(\"assets list cannot be empty\")\n        self.assets = normalized_assets\n        env_value = self.environment.strip().lower()\n        if env_value not in {\"backtest\", \"paper\", \"prod\"}:\n            raise ValueError(\"environment must be one of: backtest, paper, prod\")\n        self.environment = env_value\n        timeframe_value = self.timeframe.strip().lower()\n        if not timeframe_value:\n            raise ValueError(\"timeframe cannot be empty\")\n        self.timeframe = timeframe_value\n\n    @classmethod\n    def from_env(cls) -> \"SchedulerSettings\":\n        return cls(\n            enabled=_parse_bool_env(\"TRADING_SCHEDULER_ENABLED\", False),\n            interval_hours=_parse_float_env(\"TRADING_SCHEDULER_INTERVAL_HOURS\", 1.0),\n            assets=_parse_assets_env(os.getenv(\"TRADING_SCHEDULER_ASSETS\")),\n            environment=os.getenv(\"TRADING_SCHEDULER_ENVIRONMENT\", \"paper\"),\n            timeframe=os.getenv(\"TRADING_SCHEDULER_TIMEFRAME\", \"1h\"),\n            lookback_hours=_parse_float_env(\"TRADING_SCHEDULER_LOOKBACK_HOURS\", 168.0),\n        )\n\n    def with_overrides(self, **overrides) -> \"SchedulerSettings\":\n        return replace(self, **overrides)\n\n\n# Scheduler configuration instance accessible as settings.scheduler\nscheduler = SchedulerSettings.from_env()\n\n\ndef update_env_file(key: str, value: str) -> None:\n    \"\"\"\n    Update or add a key-value pair in the .env file.\n    Used by web_interface.py to persist API key changes.\n    \"\"\"\n    env_file = Path(__file__).parent.parent / \".env\"\n\n    # Read existing content\n    if env_file.exists():\n        with open(env_file, \"r\") as f:\n            lines = f.readlines()\n    else:\n        lines = []\n\n    # Update or append the key\n    key_found = False\n    for i, line in enumerate(lines):\n        if line.strip().startswith(f\"{key}=\"):\n            lines[i] = f\"{key}={value}\\n\"\n            key_found = True\n            break\n\n    if not key_found:\n        lines.append(f\"{key}={value}\\n\")\n\n    # Write back\n    with open(env_file, \"w\") as f:\n        f.writelines(lines)\n\n    # Update os.environ for runtime\n    os.environ[key] = value\n","numLines":201,"startLine":1,"totalLines":201}}}
