{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01UMFq6Ztp1iWvuWF67YNWfa","type":"tool_result","content":"1\t\"\"\"LLM Agent Strategy - wrapper around TradingGraph.\"\"\"\n2\t\n3\tfrom typing import Dict, List, Optional\n4\t\n5\tfrom ..models import ActivePosition\n6\tfrom .base import TradingSignal, TradingStrategy\n7\t\n8\t\n9\tclass LLMAgentStrategy(TradingStrategy):\n10\t    \"\"\"\n11\t    Trading strategy that wraps TradingGraph (multi-agent LLM system).\n12\t\n13\t    Uses default exit logic (fixed % SL/TP + trailing stop).\n14\t    Does not re-evaluate positions once opened.\n15\t    \"\"\"\n16\t\n17\t    def __init__(self, trading_graph):\n18\t        \"\"\"\n19\t        Initialize LLM Agent Strategy.\n20\t\n21\t        Args:\n22\t            trading_graph: TradingGraph instance with configured LLMs\n23\t        \"\"\"\n24\t        self.trading_graph = trading_graph\n25\t\n26\t    def generate_signal(\n27\t        self,\n28\t        kline_data: List[Dict],\n29\t        symbol: str,\n30\t        timeframe: str,\n31\t        current_price: float,\n32\t        thread_id: Optional[str] = None,\n33\t    ) -> Optional[TradingSignal]:\n34\t        \"\"\"\n35\t        Generate trading signal using TradingGraph agents.\n36\t\n37\t        Args:\n38\t            kline_data: List of OHLCV candles\n39\t            symbol: Asset symbol\n40\t            timeframe: Timeframe (e.g., \"4h\")\n41\t            current_price: Current market price\n42\t            thread_id: Optional thread ID for checkpointing (required if graph has checkpointer)\n43\t\n44\t        Returns:\n45\t            TradingSignal or None if HOLD\n46\t        \"\"\"\n47\t        # Prepare initial state for graph\n48\t        initial_state: Dict = {\n49\t            \"kline_data\": kline_data,\n50\t            \"time_frame\": timeframe,\n51\t            \"stock_name\": symbol,\n52\t            \"messages\": [],\n53\t        }\n54\t\n55\t        # Prepare config for checkpointing (if thread_id provided)\n56\t        config = None\n57\t        if thread_id is not None:\n58\t            config = {\"configurable\": {\"thread_id\": thread_id}}\n59\t\n60\t        # Invoke graph\n61\t        result = self.trading_graph.graph.invoke(initial_state, config=config)\n62\t\n63\t        # Defensive check: handle None result\n64\t        if result is None:\n65\t            return None\n66\t\n67\t        # Extract decision\n68\t        trading_decision_raw = result.get(\"final_trade_decision\", \"HOLD\")\n69\t\n70\t        # Parse decision (may be string like \"LONG with 0.75 confidence\")\n71\t        decision, confidence = self._parse_decision(trading_decision_raw)\n72\t\n73\t        # If HOLD, return None\n74\t        if decision == \"HOLD\":\n75\t            return None\n76\t\n77\t        # Extract reasoning\n78\t        reasoning = result.get(\"reasoning\", \"\")\n79\t        if not reasoning:\n80\t            # Fallback: get from decision agent report\n81\t            decision_report = result.get(\"decision_report\", {})\n82\t            if isinstance(decision_report, dict):\n83\t                reasoning = decision_report.get(\"reasoning\", \"LLM Agent analysis\")\n84\t\n85\t        # Calculate default SL/TP (2% and 3% from current price)\n86\t        if decision == \"LONG\":\n87\t            stop_loss = current_price * 0.98\n88\t            take_profit = current_price * 1.03\n89\t        else:  # SHORT\n90\t            stop_loss = current_price * 1.02\n91\t            take_profit = current_price * 0.97\n92\t\n93\t        return TradingSignal(\n94\t            decision=decision,\n95\t            confidence=confidence,\n96\t            entry_price=current_price,\n97\t            stop_loss=stop_loss,\n98\t            take_profit=take_profit,\n99\t            reasoning=reasoning,\n100\t            trailing_stop_pct=0.05,  # 5% trailing stop\n101\t        )\n102\t\n103\t    def _parse_decision(self, decision_str: str) -> tuple[str, float]:\n104\t        \"\"\"\n105\t        Parse decision string from graph output.\n106\t\n107\t        Examples:\n108\t            \"LONG\" -> (\"LONG\", 1.0)\n109\t            \"LONG with 0.75 confidence\" -> (\"LONG\", 0.75)\n110\t            \"SHORT\" -> (\"SHORT\", 1.0)\n111\t\n112\t        Args:\n113\t            decision_str: Raw decision string\n114\t\n115\t        Returns:\n116\t            (decision, confidence) tuple\n117\t        \"\"\"\n118\t        decision_str = str(decision_str).strip().upper()\n119\t\n120\t        # Default confidence\n121\t        confidence = 1.0\n122\t\n123\t        # Extract decision\n124\t        if \"LONG\" in decision_str:\n125\t            decision = \"LONG\"\n126\t        elif \"SHORT\" in decision_str:\n127\t            decision = \"SHORT\"\n128\t        else:\n129\t            decision = \"HOLD\"\n130\t\n131\t        # Try to extract confidence if present\n132\t        # Look for patterns like \"0.75\" or \".75\"\n133\t        import re\n134\t\n135\t        # Match floating point numbers (e.g., 0.75, .85, 0.9)\n136\t        float_pattern = r\"\\b\\d*\\.?\\d+\\b\"\n137\t        matches = re.findall(float_pattern, decision_str)\n138\t\n139\t        for match in matches:\n140\t            try:\n141\t                val = float(match)\n142\t                # Only consider values that look like confidence (between 0 and 1)\n143\t                if 0.0 <= val <= 1.0:\n144\t                    confidence = val\n145\t                    break\n146\t            except ValueError:\n147\t                continue\n148\t\n149\t        return decision, confidence\n150\t\n151\t    def should_reevaluate(\n152\t        self,\n153\t        position: ActivePosition,\n154\t        current_price: float,\n155\t    ) -> bool:\n156\t        \"\"\"\n157\t        LLM Agent Strategy does not re-evaluate once position is opened.\n158\t\n159\t        Returns:\n160\t            False always\n161\t        \"\"\"\n162\t        return False\n163\t"}]},"parent_tool_use_id":null,"session_id":"ce2496a8-a497-4f7a-9d36-07ca768dd87e","uuid":"3b63bae3-75e5-41d7-b484-018e784bdf3d","timestamp":"2026-05-05T00:52:34.612Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/autodev-worktrees/QuantAgent/QuantAgent-c69/planner-20260505T005036Z/quantagent/strategy/llm_agent_strategy.py","content":"\"\"\"LLM Agent Strategy - wrapper around TradingGraph.\"\"\"\n\nfrom typing import Dict, List, Optional\n\nfrom ..models import ActivePosition\nfrom .base import TradingSignal, TradingStrategy\n\n\nclass LLMAgentStrategy(TradingStrategy):\n    \"\"\"\n    Trading strategy that wraps TradingGraph (multi-agent LLM system).\n\n    Uses default exit logic (fixed % SL/TP + trailing stop).\n    Does not re-evaluate positions once opened.\n    \"\"\"\n\n    def __init__(self, trading_graph):\n        \"\"\"\n        Initialize LLM Agent Strategy.\n\n        Args:\n            trading_graph: TradingGraph instance with configured LLMs\n        \"\"\"\n        self.trading_graph = trading_graph\n\n    def generate_signal(\n        self,\n        kline_data: List[Dict],\n        symbol: str,\n        timeframe: str,\n        current_price: float,\n        thread_id: Optional[str] = None,\n    ) -> Optional[TradingSignal]:\n        \"\"\"\n        Generate trading signal using TradingGraph agents.\n\n        Args:\n            kline_data: List of OHLCV candles\n            symbol: Asset symbol\n            timeframe: Timeframe (e.g., \"4h\")\n            current_price: Current market price\n            thread_id: Optional thread ID for checkpointing (required if graph has checkpointer)\n\n        Returns:\n            TradingSignal or None if HOLD\n        \"\"\"\n        # Prepare initial state for graph\n        initial_state: Dict = {\n            \"kline_data\": kline_data,\n            \"time_frame\": timeframe,\n            \"stock_name\": symbol,\n            \"messages\": [],\n        }\n\n        # Prepare config for checkpointing (if thread_id provided)\n        config = None\n        if thread_id is not None:\n            config = {\"configurable\": {\"thread_id\": thread_id}}\n\n        # Invoke graph\n        result = self.trading_graph.graph.invoke(initial_state, config=config)\n\n        # Defensive check: handle None result\n        if result is None:\n            return None\n\n        # Extract decision\n        trading_decision_raw = result.get(\"final_trade_decision\", \"HOLD\")\n\n        # Parse decision (may be string like \"LONG with 0.75 confidence\")\n        decision, confidence = self._parse_decision(trading_decision_raw)\n\n        # If HOLD, return None\n        if decision == \"HOLD\":\n            return None\n\n        # Extract reasoning\n        reasoning = result.get(\"reasoning\", \"\")\n        if not reasoning:\n            # Fallback: get from decision agent report\n            decision_report = result.get(\"decision_report\", {})\n            if isinstance(decision_report, dict):\n                reasoning = decision_report.get(\"reasoning\", \"LLM Agent analysis\")\n\n        # Calculate default SL/TP (2% and 3% from current price)\n        if decision == \"LONG\":\n            stop_loss = current_price * 0.98\n            take_profit = current_price * 1.03\n        else:  # SHORT\n            stop_loss = current_price * 1.02\n            take_profit = current_price * 0.97\n\n        return TradingSignal(\n            decision=decision,\n            confidence=confidence,\n            entry_price=current_price,\n            stop_loss=stop_loss,\n            take_profit=take_profit,\n            reasoning=reasoning,\n            trailing_stop_pct=0.05,  # 5% trailing stop\n        )\n\n    def _parse_decision(self, decision_str: str) -> tuple[str, float]:\n        \"\"\"\n        Parse decision string from graph output.\n\n        Examples:\n            \"LONG\" -> (\"LONG\", 1.0)\n            \"LONG with 0.75 confidence\" -> (\"LONG\", 0.75)\n            \"SHORT\" -> (\"SHORT\", 1.0)\n\n        Args:\n            decision_str: Raw decision string\n\n        Returns:\n            (decision, confidence) tuple\n        \"\"\"\n        decision_str = str(decision_str).strip().upper()\n\n        # Default confidence\n        confidence = 1.0\n\n        # Extract decision\n        if \"LONG\" in decision_str:\n            decision = \"LONG\"\n        elif \"SHORT\" in decision_str:\n            decision = \"SHORT\"\n        else:\n            decision = \"HOLD\"\n\n        # Try to extract confidence if present\n        # Look for patterns like \"0.75\" or \".75\"\n        import re\n\n        # Match floating point numbers (e.g., 0.75, .85, 0.9)\n        float_pattern = r\"\\b\\d*\\.?\\d+\\b\"\n        matches = re.findall(float_pattern, decision_str)\n\n        for match in matches:\n            try:\n                val = float(match)\n                # Only consider values that look like confidence (between 0 and 1)\n                if 0.0 <= val <= 1.0:\n                    confidence = val\n                    break\n            except ValueError:\n                continue\n\n        return decision, confidence\n\n    def should_reevaluate(\n        self,\n        position: ActivePosition,\n        current_price: float,\n    ) -> bool:\n        \"\"\"\n        LLM Agent Strategy does not re-evaluate once position is opened.\n\n        Returns:\n            False always\n        \"\"\"\n        return False\n","numLines":163,"startLine":1,"totalLines":163}}}
