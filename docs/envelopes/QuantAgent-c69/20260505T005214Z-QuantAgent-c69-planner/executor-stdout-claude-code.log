{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LcuakQ1X35KqVH2jyTjxyz","type":"tool_result","content":"1\t\"\"\"Unit tests for LLMAgentStrategy.\"\"\"\n2\t\n3\tfrom datetime import datetime, timedelta\n4\tfrom typing import Dict, List\n5\tfrom unittest.mock import Mock\n6\t\n7\timport pytest\n8\t\n9\tfrom quantagent.models import ActivePosition, OrderSide\n10\tfrom quantagent.strategy.llm_agent_strategy import LLMAgentStrategy\n11\t\n12\t\n13\t@pytest.fixture\n14\tdef mock_trading_graph():\n15\t    \"\"\"Fixture for mock TradingGraph.\"\"\"\n16\t    graph = Mock()\n17\t    graph.graph = Mock()\n18\t    return graph\n19\t\n20\t\n21\t@pytest.fixture\n22\tdef llm_strategy(mock_trading_graph):\n23\t    \"\"\"Fixture for LLMAgentStrategy.\"\"\"\n24\t    return LLMAgentStrategy(mock_trading_graph)\n25\t\n26\t\n27\t@pytest.fixture\n28\tdef sample_kline_data() -> List[Dict]:\n29\t    \"\"\"Fixture for sample kline data.\"\"\"\n30\t    return [\n31\t        {\n32\t            \"timestamp\": datetime(2024, 1, 1, 0, 0) + timedelta(hours=i * 4),\n33\t            \"open\": 100 + i,\n34\t            \"high\": 105 + i,\n35\t            \"low\": 99 + i,\n36\t            \"close\": 103 + i,\n37\t            \"volume\": 1000,\n38\t        }\n39\t        for i in range(30)\n40\t    ]\n41\t\n42\t\n43\tclass TestGenerateSignalLong:\n44\t    \"\"\"Test LLM signal generation for LONG.\"\"\"\n45\t\n46\t    def test_generate_long_signal(\n47\t        self, llm_strategy, mock_trading_graph, sample_kline_data\n48\t    ):\n49\t        \"\"\"AC2.1: LLMAgentStrategy generates valid LONG signal.\"\"\"\n50\t        # Mock graph response\n51\t        mock_trading_graph.graph.invoke.return_value = {\n52\t            \"final_trade_decision\": \"LONG with 0.75 confidence\",\n53\t            \"reasoning\": \"Strong bullish momentum\",\n54\t        }\n55\t\n56\t        signal = llm_strategy.generate_signal(sample_kline_data, \"BTCUSDT\", \"4h\", 100.0)\n57\t\n58\t        assert signal is not None\n59\t        assert signal.decision == \"LONG\"\n60\t        assert signal.confidence == 0.75\n61\t        assert signal.entry_price == 100.0\n62\t        assert signal.stop_loss == 98.0  # 2% below\n63\t        assert signal.take_profit == 103.0  # 3% above\n64\t        assert signal.reasoning == \"Strong bullish momentum\"\n65\t        assert signal.trailing_stop_pct == 0.05\n66\t\n67\t    def test_generate_short_signal(\n68\t        self, llm_strategy, mock_trading_graph, sample_kline_data\n69\t    ):\n70\t        \"\"\"LLMAgentStrategy generates valid SHORT signal.\"\"\"\n71\t        mock_trading_graph.graph.invoke.return_value = {\n72\t            \"final_trade_decision\": \"SHORT\",\n73\t            \"decision_report\": {\"reasoning\": \"Bearish trend confirmed\"},\n74\t        }\n75\t\n76\t        signal = llm_strategy.generate_signal(sample_kline_data, \"ETHUSDT\", \"4h\", 100.0)\n77\t\n78\t        assert signal is not None\n79\t        assert signal.decision == \"SHORT\"\n80\t        assert signal.confidence == 1.0  # Default when not specified\n81\t        assert signal.stop_loss == 102.0  # 2% above\n82\t        assert signal.take_profit == 97.0  # 3% below\n83\t\n84\t    def test_generate_hold_signal_returns_none(\n85\t        self, llm_strategy, mock_trading_graph, sample_kline_data\n86\t    ):\n87\t        \"\"\"AC2.4: Strategy returns None when HOLD.\"\"\"\n88\t        mock_trading_graph.graph.invoke.return_value = {\n89\t            \"final_trade_decision\": \"HOLD\",\n90\t        }\n91\t\n92\t        signal = llm_strategy.generate_signal(sample_kline_data, \"BTCUSDT\", \"4h\", 100.0)\n93\t\n94\t        assert signal is None\n95\t\n96\t\n97\tclass TestParseDecision:\n98\t    \"\"\"Test decision string parsing.\"\"\"\n99\t\n100\t    def test_parse_long_with_confidence(self, llm_strategy):\n101\t        \"\"\"Parse LONG with confidence.\"\"\"\n102\t        decision, confidence = llm_strategy._parse_decision(\"LONG with 0.85 confidence\")\n103\t\n104\t        assert decision == \"LONG\"\n105\t        assert confidence == 0.85\n106\t\n107\t    def test_parse_short_simple(self, llm_strategy):\n108\t        \"\"\"Parse simple SHORT.\"\"\"\n109\t        decision, confidence = llm_strategy._parse_decision(\"SHORT\")\n110\t\n111\t        assert decision == \"SHORT\"\n112\t        assert confidence == 1.0\n113\t\n114\t    def test_parse_hold(self, llm_strategy):\n115\t        \"\"\"Parse HOLD.\"\"\"\n116\t        decision, confidence = llm_strategy._parse_decision(\"HOLD - wait for signal\")\n117\t\n118\t        assert decision == \"HOLD\"\n119\t        assert confidence == 1.0\n120\t\n121\t    def test_parse_confidence_clamped(self, llm_strategy):\n122\t        \"\"\"Confidence is clamped to [0, 1].\"\"\"\n123\t        decision, confidence = llm_strategy._parse_decision(\"LONG confidence 1.5\")\n124\t\n125\t        assert decision == \"LONG\"\n126\t        assert confidence == 1.0  # Clamped\n127\t\n128\t\n129\tclass TestShouldReevaluate:\n130\t    \"\"\"Test re-evaluation logic.\"\"\"\n131\t\n132\t    def test_should_not_reevaluate(self, llm_strategy):\n133\t        \"\"\"AC2.2: LLMAgentStrategy does not re-evaluate.\"\"\"\n134\t        position = Mock(spec=ActivePosition)\n135\t        position.side = OrderSide.BUY\n136\t\n137\t        should_reeval = llm_strategy.should_reevaluate(position, 105.0)\n138\t\n139\t        assert should_reeval is False\n140\t\n141\t\n142\tclass TestUsesExistingGraph:\n143\t    \"\"\"Test that LLMAgentStrategy uses TradingGraph.\"\"\"\n144\t\n145\t    def test_invokes_graph(self, llm_strategy, mock_trading_graph, sample_kline_data):\n146\t        \"\"\"AC2.2: Strategy invokes TradingGraph internally.\"\"\"\n147\t        mock_trading_graph.graph.invoke.return_value = {\n148\t            \"final_trade_decision\": \"LONG\",\n149\t        }\n150\t\n151\t        llm_strategy.generate_signal(sample_kline_data, \"BTCUSDT\", \"4h\", 100.0)\n152\t\n153\t        # Verify graph was invoked\n154\t        mock_trading_graph.graph.invoke.assert_called_once()\n155\t\n156\t        # Verify state structure\n157\t        call_args = mock_trading_graph.graph.invoke.call_args[0][0]\n158\t        assert call_args[\"kline_data\"] == sample_kline_data\n159\t        assert call_args[\"stock_name\"] == \"BTCUSDT\"\n160\t        assert call_args[\"time_frame\"] == \"4h\"\n161\t\n162\t    def test_invokes_graph_with_thread_id(\n163\t        self, llm_strategy, mock_trading_graph, sample_kline_data\n164\t    ):\n165\t        \"\"\"Verify strategy passes thread_id config when provided (for checkpointing).\"\"\"\n166\t        mock_trading_graph.graph.invoke.return_value = {\n167\t            \"final_trade_decision\": \"LONG with 0.8 confidence\",\n168\t            \"reasoning\": \"Bullish trend\",\n169\t        }\n170\t\n171\t        thread_id = \"backtest_123_BTC_2024-01-01T00:00:00\"\n172\t        signal = llm_strategy.generate_signal(\n173\t            sample_kline_data, \"BTC\", \"4h\", 50000.0, thread_id=thread_id\n174\t        )\n175\t\n176\t        # Verify graph was invoked with correct config\n177\t        mock_trading_graph.graph.invoke.assert_called_once()\n178\t        call_args = mock_trading_graph.graph.invoke.call_args\n179\t\n180\t        # Verify state (first positional arg)\n181\t        state = call_args[0][0]\n182\t        assert state[\"stock_name\"] == \"BTC\"\n183\t        assert state[\"time_frame\"] == \"4h\"\n184\t        assert state[\"kline_data\"] == sample_kline_data\n185\t\n186\t        # Verify config was passed as keyword arg with thread_id\n187\t        config = call_args[1][\"config\"]\n188\t        assert config is not None\n189\t        assert \"configurable\" in config\n190\t        assert config[\"configurable\"][\"thread_id\"] == thread_id\n191\t\n192\t        # Verify signal was generated correctly\n193\t        assert signal is not None\n194\t        assert signal.decision == \"LONG\"\n195\t        assert signal.confidence == 0.8\n196\t\n197\t    def test_invokes_graph_without_thread_id(\n198\t        self, llm_strategy, mock_trading_graph, sample_kline_data\n199\t    ):\n200\t        \"\"\"Verify strategy invokes graph without config when thread_id not provided.\"\"\"\n201\t        mock_trading_graph.graph.invoke.return_value = {\n202\t            \"final_trade_decision\": \"SHORT\",\n203\t        }\n204\t\n205\t        signal = llm_strategy.generate_signal(\n206\t            sample_kline_data, \"ETH\", \"1h\", 3000.0, thread_id=None\n207\t        )\n208\t\n209\t        # Verify graph was invoked\n210\t        mock_trading_graph.graph.invoke.assert_called_once()\n211\t        call_args = mock_trading_graph.graph.invoke.call_args\n212\t\n213\t        # Verify config is None (second positional arg or keyword arg)\n214\t        config = call_args[1].get(\"config\") if len(call_args) > 1 else None\n215\t        assert config is None\n216\t\n217\t        # Verify signal was generated\n218\t        assert signal is not None\n219\t        assert signal.decision == \"SHORT\"\n220\t"}]},"parent_tool_use_id":null,"session_id":"ce2496a8-a497-4f7a-9d36-07ca768dd87e","uuid":"f4ac1b12-9d6f-4058-9d5f-64d0566e1cd0","timestamp":"2026-05-05T00:52:54.803Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/autodev-worktrees/QuantAgent/QuantAgent-c69/planner-20260505T005036Z/tests/test_llm_agent_strategy.py","content":"\"\"\"Unit tests for LLMAgentStrategy.\"\"\"\n\nfrom datetime import datetime, timedelta\nfrom typing import Dict, List\nfrom unittest.mock import Mock\n\nimport pytest\n\nfrom quantagent.models import ActivePosition, OrderSide\nfrom quantagent.strategy.llm_agent_strategy import LLMAgentStrategy\n\n\n@pytest.fixture\ndef mock_trading_graph():\n    \"\"\"Fixture for mock TradingGraph.\"\"\"\n    graph = Mock()\n    graph.graph = Mock()\n    return graph\n\n\n@pytest.fixture\ndef llm_strategy(mock_trading_graph):\n    \"\"\"Fixture for LLMAgentStrategy.\"\"\"\n    return LLMAgentStrategy(mock_trading_graph)\n\n\n@pytest.fixture\ndef sample_kline_data() -> List[Dict]:\n    \"\"\"Fixture for sample kline data.\"\"\"\n    return [\n        {\n            \"timestamp\": datetime(2024, 1, 1, 0, 0) + timedelta(hours=i * 4),\n            \"open\": 100 + i,\n            \"high\": 105 + i,\n            \"low\": 99 + i,\n            \"close\": 103 + i,\n            \"volume\": 1000,\n        }\n        for i in range(30)\n    ]\n\n\nclass TestGenerateSignalLong:\n    \"\"\"Test LLM signal generation for LONG.\"\"\"\n\n    def test_generate_long_signal(\n        self, llm_strategy, mock_trading_graph, sample_kline_data\n    ):\n        \"\"\"AC2.1: LLMAgentStrategy generates valid LONG signal.\"\"\"\n        # Mock graph response\n        mock_trading_graph.graph.invoke.return_value = {\n            \"final_trade_decision\": \"LONG with 0.75 confidence\",\n            \"reasoning\": \"Strong bullish momentum\",\n        }\n\n        signal = llm_strategy.generate_signal(sample_kline_data, \"BTCUSDT\", \"4h\", 100.0)\n\n        assert signal is not None\n        assert signal.decision == \"LONG\"\n        assert signal.confidence == 0.75\n        assert signal.entry_price == 100.0\n        assert signal.stop_loss == 98.0  # 2% below\n        assert signal.take_profit == 103.0  # 3% above\n        assert signal.reasoning == \"Strong bullish momentum\"\n        assert signal.trailing_stop_pct == 0.05\n\n    def test_generate_short_signal(\n        self, llm_strategy, mock_trading_graph, sample_kline_data\n    ):\n        \"\"\"LLMAgentStrategy generates valid SHORT signal.\"\"\"\n        mock_trading_graph.graph.invoke.return_value = {\n            \"final_trade_decision\": \"SHORT\",\n            \"decision_report\": {\"reasoning\": \"Bearish trend confirmed\"},\n        }\n\n        signal = llm_strategy.generate_signal(sample_kline_data, \"ETHUSDT\", \"4h\", 100.0)\n\n        assert signal is not None\n        assert signal.decision == \"SHORT\"\n        assert signal.confidence == 1.0  # Default when not specified\n        assert signal.stop_loss == 102.0  # 2% above\n        assert signal.take_profit == 97.0  # 3% below\n\n    def test_generate_hold_signal_returns_none(\n        self, llm_strategy, mock_trading_graph, sample_kline_data\n    ):\n        \"\"\"AC2.4: Strategy returns None when HOLD.\"\"\"\n        mock_trading_graph.graph.invoke.return_value = {\n            \"final_trade_decision\": \"HOLD\",\n        }\n\n        signal = llm_strategy.generate_signal(sample_kline_data, \"BTCUSDT\", \"4h\", 100.0)\n\n        assert signal is None\n\n\nclass TestParseDecision:\n    \"\"\"Test decision string parsing.\"\"\"\n\n    def test_parse_long_with_confidence(self, llm_strategy):\n        \"\"\"Parse LONG with confidence.\"\"\"\n        decision, confidence = llm_strategy._parse_decision(\"LONG with 0.85 confidence\")\n\n        assert decision == \"LONG\"\n        assert confidence == 0.85\n\n    def test_parse_short_simple(self, llm_strategy):\n        \"\"\"Parse simple SHORT.\"\"\"\n        decision, confidence = llm_strategy._parse_decision(\"SHORT\")\n\n        assert decision == \"SHORT\"\n        assert confidence == 1.0\n\n    def test_parse_hold(self, llm_strategy):\n        \"\"\"Parse HOLD.\"\"\"\n        decision, confidence = llm_strategy._parse_decision(\"HOLD - wait for signal\")\n\n        assert decision == \"HOLD\"\n        assert confidence == 1.0\n\n    def test_parse_confidence_clamped(self, llm_strategy):\n        \"\"\"Confidence is clamped to [0, 1].\"\"\"\n        decision, confidence = llm_strategy._parse_decision(\"LONG confidence 1.5\")\n\n        assert decision == \"LONG\"\n        assert confidence == 1.0  # Clamped\n\n\nclass TestShouldReevaluate:\n    \"\"\"Test re-evaluation logic.\"\"\"\n\n    def test_should_not_reevaluate(self, llm_strategy):\n        \"\"\"AC2.2: LLMAgentStrategy does not re-evaluate.\"\"\"\n        position = Mock(spec=ActivePosition)\n        position.side = OrderSide.BUY\n\n        should_reeval = llm_strategy.should_reevaluate(position, 105.0)\n\n        assert should_reeval is False\n\n\nclass TestUsesExistingGraph:\n    \"\"\"Test that LLMAgentStrategy uses TradingGraph.\"\"\"\n\n    def test_invokes_graph(self, llm_strategy, mock_trading_graph, sample_kline_data):\n        \"\"\"AC2.2: Strategy invokes TradingGraph internally.\"\"\"\n        mock_trading_graph.graph.invoke.return_value = {\n            \"final_trade_decision\": \"LONG\",\n        }\n\n        llm_strategy.generate_signal(sample_kline_data, \"BTCUSDT\", \"4h\", 100.0)\n\n        # Verify graph was invoked\n        mock_trading_graph.graph.invoke.assert_called_once()\n\n        # Verify state structure\n        call_args = mock_trading_graph.graph.invoke.call_args[0][0]\n        assert call_args[\"kline_data\"] == sample_kline_data\n        assert call_args[\"stock_name\"] == \"BTCUSDT\"\n        assert call_args[\"time_frame\"] == \"4h\"\n\n    def test_invokes_graph_with_thread_id(\n        self, llm_strategy, mock_trading_graph, sample_kline_data\n    ):\n        \"\"\"Verify strategy passes thread_id config when provided (for checkpointing).\"\"\"\n        mock_trading_graph.graph.invoke.return_value = {\n            \"final_trade_decision\": \"LONG with 0.8 confidence\",\n            \"reasoning\": \"Bullish trend\",\n        }\n\n        thread_id = \"backtest_123_BTC_2024-01-01T00:00:00\"\n        signal = llm_strategy.generate_signal(\n            sample_kline_data, \"BTC\", \"4h\", 50000.0, thread_id=thread_id\n        )\n\n        # Verify graph was invoked with correct config\n        mock_trading_graph.graph.invoke.assert_called_once()\n        call_args = mock_trading_graph.graph.invoke.call_args\n\n        # Verify state (first positional arg)\n        state = call_args[0][0]\n        assert state[\"stock_name\"] == \"BTC\"\n        assert state[\"time_frame\"] == \"4h\"\n        assert state[\"kline_data\"] == sample_kline_data\n\n        # Verify config was passed as keyword arg with thread_id\n        config = call_args[1][\"config\"]\n        assert config is not None\n        assert \"configurable\" in config\n        assert config[\"configurable\"][\"thread_id\"] == thread_id\n\n        # Verify signal was generated correctly\n        assert signal is not None\n        assert signal.decision == \"LONG\"\n        assert signal.confidence == 0.8\n\n    def test_invokes_graph_without_thread_id(\n        self, llm_strategy, mock_trading_graph, sample_kline_data\n    ):\n        \"\"\"Verify strategy invokes graph without config when thread_id not provided.\"\"\"\n        mock_trading_graph.graph.invoke.return_value = {\n            \"final_trade_decision\": \"SHORT\",\n        }\n\n        signal = llm_strategy.generate_signal(\n            sample_kline_data, \"ETH\", \"1h\", 3000.0, thread_id=None\n        )\n\n        # Verify graph was invoked\n        mock_trading_graph.graph.invoke.assert_called_once()\n        call_args = mock_trading_graph.graph.invoke.call_args\n\n        # Verify config is None (second positional arg or keyword arg)\n        config = call_args[1].get(\"config\") if len(call_args) > 1 else None\n        assert config is None\n\n        # Verify signal was generated\n        assert signal is not None\n        assert signal.decision == \"SHORT\"\n","numLines":220,"startLine":1,"totalLines":220}}}
