{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01SXApmD8YKQu51fMDxF5wWw","type":"tool_result","content":"1\t\"\"\"\n2\tTradingGraph: Orchestrates the multi-agent trading system using LangChain and LangGraph.\n3\tInitializes LLMs, toolkits, and agent nodes for indicator, pattern, and trend analysis.\n4\tSupports PostgreSQL checkpointing for resilient backtest execution.\n5\t\"\"\"\n6\t\n7\timport logging\n8\t\n9\tfrom langchain_anthropic import ChatAnthropic\n10\tfrom langchain_core.language_models import BaseChatModel\n11\tfrom langchain_openai import ChatOpenAI\n12\tfrom langchain_qwq import ChatQwen\n13\t\n14\tfrom quantagent import settings\n15\tfrom quantagent.graph_setup import SetGraph\n16\tfrom quantagent.graph_util import TechnicalTools\n17\t\n18\tlogger = logging.getLogger(__name__)\n19\t\n20\ttry:\n21\t    from langgraph.checkpoint.postgres import PostgresSaver\n22\texcept ImportError:\n23\t    PostgresSaver = None\n24\t\n25\t\n26\tclass TradingGraph:\n27\t    \"\"\"\n28\t    Main orchestrator for the multi-agent trading system.\n29\t    Sets up LLMs, toolkits, and agent nodes for indicator, pattern, and trend analysis.\n30\t    \"\"\"\n31\t\n32\t    def __init__(self, use_checkpointing: bool = False):\n33\t        \"\"\"\n34\t        Initialize TradingGraph with configuration from environment variables.\n35\t\n36\t        Args:\n37\t            use_checkpointing: Enable PostgreSQL checkpointing for resilience\n38\t        \"\"\"\n39\t        logger.info(\"Initializing TradingGraph\", extra={\"event_type\": \"graph_init\"})\n40\t\n41\t        # All configuration now comes from settings module (loaded from .env)\n42\t        self.agent_llm = self._create_llm(\n43\t            provider=settings.AGENT_LLM_PROVIDER,\n44\t            model=settings.AGENT_LLM_MODEL,\n45\t            temperature=settings.AGENT_LLM_TEMPERATURE,\n46\t        )\n47\t        self.graph_llm = self._create_llm(\n48\t            provider=settings.GRAPH_LLM_PROVIDER,\n49\t            model=settings.GRAPH_LLM_MODEL,\n50\t            temperature=settings.GRAPH_LLM_TEMPERATURE,\n51\t        )\n52\t\n53\t        logger.info(\n54\t            f\"LLM configuration: agent={settings.AGENT_LLM_PROVIDER}/{settings.AGENT_LLM_MODEL}, \"\n55\t            f\"graph={settings.GRAPH_LLM_PROVIDER}/{settings.GRAPH_LLM_MODEL}\",\n56\t            extra={\n57\t                \"event_type\": \"llm_config\",\n58\t                \"extra_data\": {\n59\t                    \"agent_provider\": settings.AGENT_LLM_PROVIDER,\n60\t                    \"agent_model\": settings.AGENT_LLM_MODEL,\n61\t                    \"agent_temperature\": settings.AGENT_LLM_TEMPERATURE,\n62\t                    \"graph_provider\": settings.GRAPH_LLM_PROVIDER,\n63\t                    \"graph_model\": settings.GRAPH_LLM_MODEL,\n64\t                    \"graph_temperature\": settings.GRAPH_LLM_TEMPERATURE,\n65\t                },\n66\t            },\n67\t        )\n68\t\n69\t        self.toolkit = TechnicalTools()\n70\t\n71\t        # --- Setup PostgreSQL checkpointing if enabled ---\n72\t        self.checkpointer = None\n73\t        self._checkpointer_context = None\n74\t        if use_checkpointing:\n75\t            self.checkpointer, self._checkpointer_context = self._setup_checkpointer()\n76\t            logger.info(\n77\t                \"Checkpointing enabled\", extra={\"event_type\": \"checkpointer_init\"}\n78\t            )\n79\t        else:\n80\t            logger.info(\n81\t                \"Checkpointing disabled\", extra={\"event_type\": \"checkpointer_init\"}\n82\t            )\n83\t\n84\t        # --- Create tool nodes for each agent ---\n85\t        # self.tool_nodes = self._set_tool_nodes()\n86\t\n87\t        # --- Graph logic and setup ---\n88\t        self.graph_setup = SetGraph(\n89\t            self.agent_llm,\n90\t            self.graph_llm,\n91\t            self.toolkit,\n92\t            # self.tool_nodes,\n93\t        )\n94\t\n95\t        # --- The main LangGraph graph object ---\n96\t        self.graph = self.graph_setup.set_graph(checkpointer=self.checkpointer)\n97\t\n98\t        logger.info(\n99\t            \"TradingGraph initialization complete\", extra={\"event_type\": \"graph_ready\"}\n100\t        )\n101\t\n102\t    def _get_api_key(self, provider: str = \"openai\") -> str:\n103\t        \"\"\"\n104\t        Get API key from settings module.\n105\t\n106\t        Args:\n107\t            provider: The provider name (\"openai\", \"anthropic\", or \"qwen\")\n108\t\n109\t        Returns:\n110\t            str: The API key for the specified provider\n111\t\n112\t        Raises:\n113\t            ValueError: If API key is missing or invalid\n114\t        \"\"\"\n115\t        if provider == \"openai\":\n116\t            api_key = settings.OPENAI_API_KEY\n117\t            if not api_key:\n118\t                raise ValueError(\n119\t                    \"OPENAI_API_KEY not found in .env file. \"\n120\t                    \"Please set it in your .env file or use the web interface.\"\n121\t                )\n122\t        elif provider == \"anthropic\":\n123\t            api_key = settings.ANTHROPIC_API_KEY\n124\t            if not api_key:\n125\t                raise ValueError(\n126\t                    \"ANTHROPIC_API_KEY not found in .env file. \"\n127\t                    \"Please set it in your .env file or use the web interface.\"\n128\t                )\n129\t        elif provider == \"qwen\":\n130\t            api_key = settings.DASHSCOPE_API_KEY\n131\t            if not api_key:\n132\t                raise ValueError(\n133\t                    \"DASHSCOPE_API_KEY not found in .env file. \"\n134\t                    \"Please set it in your .env file or use the web interface.\"\n135\t                )\n136\t        elif provider == \"azure\":\n137\t            api_key = settings.AZURE_OPENAI_API_KEY\n138\t            if not api_key:\n139\t                raise ValueError(\n140\t                    \"AZURE_OPENAI_API_KEY not found in .env file. \"\n141\t                    \"Please set it in your .env file or use the web interface.\"\n142\t                )\n143\t        else:\n144\t            raise ValueError(\n145\t                f\"Unsupported provider: {provider}. \"\n146\t                \"Must be 'openai', 'anthropic', 'qwen', or 'azure'\"\n147\t            )\n148\t\n149\t        return api_key\n150\t\n151\t    def _setup_checkpointer(self):\n152\t        \"\"\"\n153\t        Setup PostgreSQL checkpointer for graph resilience.\n154\t\n155\t        Returns:\n156\t            Tuple of (checkpointer, context_manager) to keep connection alive.\n157\t\n158\t        Raises:\n159\t            ValueError: If DATABASE_URL not set and checkpointing requested.\n160\t        \"\"\"\n161\t        if not PostgresSaver:\n162\t            raise ImportError(\n163\t                \"langgraph.checkpoint.postgres not available. \"\n164\t                \"Install with: pip install langgraph-checkpoint-postgres\"\n165\t            )\n166\t\n167\t        db_url = settings.DATABASE_URL\n168\t        if not db_url:\n169\t            raise ValueError(\n170\t                \"DATABASE_URL not set in .env file. \"\n171\t                \"Set it for PostgreSQL checkpointing, or use use_checkpointing=False\"\n172\t            )\n173\t\n174\t        try:\n175\t            # PostgresSaver.from_conn_string returns a context manager\n176\t            # Enter it manually and keep it alive for the TradingGraph lifetime\n177\t            context_manager = PostgresSaver.from_conn_string(db_url)\n178\t            checkpointer = context_manager.__enter__()\n179\t            checkpointer.setup()\n180\t            return checkpointer, context_manager\n181\t        except Exception as e:\n182\t            raise ValueError(f\"Failed to connect to PostgreSQL at {db_url}: {str(e)}\")\n183\t\n184\t    def _create_llm(\n185\t        self, provider: str, model: str, temperature: float\n186\t    ) -> BaseChatModel:\n187\t        \"\"\"\n188\t        Create an LLM instance based on the provider.\n189\t\n190\t        Args:\n191\t            provider: The provider name (\"openai\", \"anthropic\", \"qwen\", or \"azure\")\n192\t            model: The model name\n193\t            temperature: The temperature setting for the model\n194\t\n195\t        Returns:\n196\t            BaseChatModel: An instance of the appropriate LLM class\n197\t        \"\"\"\n198\t        api_key = self._get_api_key(provider)\n199\t\n200\t        if provider == \"openai\":\n201\t            return ChatOpenAI(\n202\t                model=model,\n203\t                temperature=temperature,\n204\t                api_key=api_key,\n205\t            )\n206\t        elif provider == \"anthropic\":\n207\t            # ChatAnthropic handles SystemMessage extraction automatically\n208\t            # It extracts SystemMessage from the message list and passes it as 'system' parameter\n209\t            # The messages array should contain at least one non-SystemMessage\n210\t            return ChatAnthropic(\n211\t                model=model,\n212\t                temperature=temperature,\n213\t                api_key=api_key,\n214\t            )\n215\t        elif provider == \"qwen\":\n216\t            return ChatQwen(\n217\t                model=model,\n218\t                temperature=temperature,\n219\t                api_key=api_key,\n220\t                max_retries=4,\n221\t            )\n222\t        elif provider == \"azure\":\n223\t            from langchain_openai import AzureChatOpenAI\n224\t\n225\t            endpoint = settings.AZURE_OPENAI_ENDPOINT\n226\t            deployment = settings.AZURE_OPENAI_DEPLOYMENT\n227\t            api_version = settings.AZURE_OPENAI_API_VERSION\n228\t\n229\t            if not endpoint:\n230\t                raise ValueError(\n231\t                    \"AZURE_OPENAI_ENDPOINT not found in .env file. \"\n232\t                    \"Example: https://myresource.openai.azure.com/\"\n233\t                )\n234\t            if not deployment:\n235\t                raise ValueError(\n236\t                    \"AZURE_OPENAI_DEPLOYMENT not found in .env file. \"\n237\t                    \"Set this to your Azure deployment name (e.g., gpt-4o)\"\n238\t                )\n239\t\n240\t            return AzureChatOpenAI(\n241\t                azure_endpoint=endpoint,\n242\t                azure_deployment=deployment,\n243\t                api_version=api_version,\n244\t                api_key=api_key,\n245\t                temperature=temperature,\n246\t            )\n247\t        else:\n248\t            raise ValueError(\n249\t                f\"Unsupported provider: {provider}. \"\n250\t                \"Must be 'openai', 'anthropic', 'qwen', or 'azure'\"\n251\t            )\n252\t\n253\t    # def _set_tool_nodes(self) -> Dict[str, ToolNode]:\n254\t    #     \"\"\"\n255\t    #     Define tool nodes for each agent type (indicator, pattern, trend).\n256\t    #     \"\"\"\n257\t    #     return {\n258\t    #         \"indicator\": ToolNode(\n259\t    #             [\n260\t    #                 self.toolkit.compute_macd,\n261\t    #                 self.toolkit.compute_roc,\n262\t    #                 self.toolkit.compute_rsi,\n263\t    #                 self.toolkit.compute_stoch,\n264\t    #                 self.toolkit.compute_willr,\n265\t    #             ]\n266\t    #         ),\n267\t    #         \"pattern\": ToolNode(\n268\t    #             [\n269\t    #                 self.toolkit.generate_kline_image,\n270\t    #             ]\n271\t    #         ),\n272\t    #         \"trend\": ToolNode([self.toolkit.generate_trend_image]),\n273\t    #     }\n274\t\n275\t    def refresh_llms(self):\n276\t        \"\"\"\n277\t        Refresh the LLM objects with the current API key from environment.\n278\t        This is called when the API key is updated.\n279\t        \"\"\"\n280\t        # Recreate LLM objects with current config values from settings module\n281\t        self.agent_llm = self._create_llm(\n282\t            provider=settings.AGENT_LLM_PROVIDER,\n283\t            model=settings.AGENT_LLM_MODEL,\n284\t            temperature=settings.AGENT_LLM_TEMPERATURE,\n285\t        )\n286\t        self.graph_llm = self._create_llm(\n287\t            provider=settings.GRAPH_LLM_PROVIDER,\n288\t            model=settings.GRAPH_LLM_MODEL,\n289\t            temperature=settings.GRAPH_LLM_TEMPERATURE,\n290\t        )\n291\t\n292\t        # Recreate the graph setup with new LLMs\n293\t        self.graph_setup = SetGraph(\n294\t            self.agent_llm,\n295\t            self.graph_llm,\n296\t            self.toolkit,\n297\t            # self.tool_nodes,\n298\t        )\n299\t\n300\t        # Recreate the main graph\n301\t        self.graph = self.graph_setup.set_graph()\n302\t\n303\t    def update_api_key(self, api_key: str, provider: str = \"openai\"):\n304\t        \"\"\"\n305\t        Update API key in runtime and persist to .env file.\n306\t        This method is called by the web interface when API key is updated.\n307\t\n308\t        Args:\n309\t            api_key: The new API key\n310\t            provider: The provider name (\"openai\", \"anthropic\", or \"qwen\")\n311\t        \"\"\"\n312\t        # Map provider to env var name\n313\t        env_var_map = {\n314\t            \"openai\": \"OPENAI_API_KEY\",\n315\t            \"anthropic\": \"ANTHROPIC_API_KEY\",\n316\t            \"qwen\": \"DASHSCOPE_API_KEY\",\n317\t        }\n318\t\n319\t        if provider not in env_var_map:\n320\t            raise ValueError(\n321\t                f\"Unsupported provider: {provider}. Must be 'openai', 'anthropic', or 'qwen'\"\n322\t            )\n323\t\n324\t        env_var = env_var_map[provider]\n325\t\n326\t        # Persist to .env file and update runtime\n327\t        settings.update_env_file(env_var, api_key)\n328\t\n329\t        # Refresh the settings module attributes\n330\t        if provider == \"openai\":\n331\t            settings.OPENAI_API_KEY = api_key\n332\t        elif provider == \"anthropic\":\n333\t            settings.ANTHROPIC_API_KEY = api_key\n334\t        elif provider == \"qwen\":\n335\t            settings.DASHSCOPE_API_KEY = api_key\n336\t\n337\t        # Refresh LLMs with new key\n338\t        self.refresh_llms()\n339\t\n340\t    def close(self):\n341\t        \"\"\"\n342\t        Close the checkpointer connection if it was opened.\n343\t        Call this when done with the TradingGraph to clean up resources.\n344\t        \"\"\"\n345\t        if hasattr(self, \"_checkpointer_context\") and self._checkpointer_context:\n346\t            try:\n347\t                self._checkpointer_context.__exit__(None, None, None)\n348\t            except Exception:\n349\t                pass  # Ignore errors during cleanup\n350\t"}]},"parent_tool_use_id":null,"session_id":"ce2496a8-a497-4f7a-9d36-07ca768dd87e","uuid":"9a11259f-3cc3-4d82-9588-8206afe7b528","timestamp":"2026-05-05T00:52:35.000Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/autodev-worktrees/QuantAgent/QuantAgent-c69/planner-20260505T005036Z/quantagent/trading_graph.py","content":"\"\"\"\nTradingGraph: Orchestrates the multi-agent trading system using LangChain and LangGraph.\nInitializes LLMs, toolkits, and agent nodes for indicator, pattern, and trend analysis.\nSupports PostgreSQL checkpointing for resilient backtest execution.\n\"\"\"\n\nimport logging\n\nfrom langchain_anthropic import ChatAnthropic\nfrom langchain_core.language_models import BaseChatModel\nfrom langchain_openai import ChatOpenAI\nfrom langchain_qwq import ChatQwen\n\nfrom quantagent import settings\nfrom quantagent.graph_setup import SetGraph\nfrom quantagent.graph_util import TechnicalTools\n\nlogger = logging.getLogger(__name__)\n\ntry:\n    from langgraph.checkpoint.postgres import PostgresSaver\nexcept ImportError:\n    PostgresSaver = None\n\n\nclass TradingGraph:\n    \"\"\"\n    Main orchestrator for the multi-agent trading system.\n    Sets up LLMs, toolkits, and agent nodes for indicator, pattern, and trend analysis.\n    \"\"\"\n\n    def __init__(self, use_checkpointing: bool = False):\n        \"\"\"\n        Initialize TradingGraph with configuration from environment variables.\n\n        Args:\n            use_checkpointing: Enable PostgreSQL checkpointing for resilience\n        \"\"\"\n        logger.info(\"Initializing TradingGraph\", extra={\"event_type\": \"graph_init\"})\n\n        # All configuration now comes from settings module (loaded from .env)\n        self.agent_llm = self._create_llm(\n            provider=settings.AGENT_LLM_PROVIDER,\n            model=settings.AGENT_LLM_MODEL,\n            temperature=settings.AGENT_LLM_TEMPERATURE,\n        )\n        self.graph_llm = self._create_llm(\n            provider=settings.GRAPH_LLM_PROVIDER,\n            model=settings.GRAPH_LLM_MODEL,\n            temperature=settings.GRAPH_LLM_TEMPERATURE,\n        )\n\n        logger.info(\n            f\"LLM configuration: agent={settings.AGENT_LLM_PROVIDER}/{settings.AGENT_LLM_MODEL}, \"\n            f\"graph={settings.GRAPH_LLM_PROVIDER}/{settings.GRAPH_LLM_MODEL}\",\n            extra={\n                \"event_type\": \"llm_config\",\n                \"extra_data\": {\n                    \"agent_provider\": settings.AGENT_LLM_PROVIDER,\n                    \"agent_model\": settings.AGENT_LLM_MODEL,\n                    \"agent_temperature\": settings.AGENT_LLM_TEMPERATURE,\n                    \"graph_provider\": settings.GRAPH_LLM_PROVIDER,\n                    \"graph_model\": settings.GRAPH_LLM_MODEL,\n                    \"graph_temperature\": settings.GRAPH_LLM_TEMPERATURE,\n                },\n            },\n        )\n\n        self.toolkit = TechnicalTools()\n\n        # --- Setup PostgreSQL checkpointing if enabled ---\n        self.checkpointer = None\n        self._checkpointer_context = None\n        if use_checkpointing:\n            self.checkpointer, self._checkpointer_context = self._setup_checkpointer()\n            logger.info(\n                \"Checkpointing enabled\", extra={\"event_type\": \"checkpointer_init\"}\n            )\n        else:\n            logger.info(\n                \"Checkpointing disabled\", extra={\"event_type\": \"checkpointer_init\"}\n            )\n\n        # --- Create tool nodes for each agent ---\n        # self.tool_nodes = self._set_tool_nodes()\n\n        # --- Graph logic and setup ---\n        self.graph_setup = SetGraph(\n            self.agent_llm,\n            self.graph_llm,\n            self.toolkit,\n            # self.tool_nodes,\n        )\n\n        # --- The main LangGraph graph object ---\n        self.graph = self.graph_setup.set_graph(checkpointer=self.checkpointer)\n\n        logger.info(\n            \"TradingGraph initialization complete\", extra={\"event_type\": \"graph_ready\"}\n        )\n\n    def _get_api_key(self, provider: str = \"openai\") -> str:\n        \"\"\"\n        Get API key from settings module.\n\n        Args:\n            provider: The provider name (\"openai\", \"anthropic\", or \"qwen\")\n\n        Returns:\n            str: The API key for the specified provider\n\n        Raises:\n            ValueError: If API key is missing or invalid\n        \"\"\"\n        if provider == \"openai\":\n            api_key = settings.OPENAI_API_KEY\n            if not api_key:\n                raise ValueError(\n                    \"OPENAI_API_KEY not found in .env file. \"\n                    \"Please set it in your .env file or use the web interface.\"\n                )\n        elif provider == \"anthropic\":\n            api_key = settings.ANTHROPIC_API_KEY\n            if not api_key:\n                raise ValueError(\n                    \"ANTHROPIC_API_KEY not found in .env file. \"\n                    \"Please set it in your .env file or use the web interface.\"\n                )\n        elif provider == \"qwen\":\n            api_key = settings.DASHSCOPE_API_KEY\n            if not api_key:\n                raise ValueError(\n                    \"DASHSCOPE_API_KEY not found in .env file. \"\n                    \"Please set it in your .env file or use the web interface.\"\n                )\n        elif provider == \"azure\":\n            api_key = settings.AZURE_OPENAI_API_KEY\n            if not api_key:\n                raise ValueError(\n                    \"AZURE_OPENAI_API_KEY not found in .env file. \"\n                    \"Please set it in your .env file or use the web interface.\"\n                )\n        else:\n            raise ValueError(\n                f\"Unsupported provider: {provider}. \"\n                \"Must be 'openai', 'anthropic', 'qwen', or 'azure'\"\n            )\n\n        return api_key\n\n    def _setup_checkpointer(self):\n        \"\"\"\n        Setup PostgreSQL checkpointer for graph resilience.\n\n        Returns:\n            Tuple of (checkpointer, context_manager) to keep connection alive.\n\n        Raises:\n            ValueError: If DATABASE_URL not set and checkpointing requested.\n        \"\"\"\n        if not PostgresSaver:\n            raise ImportError(\n                \"langgraph.checkpoint.postgres not available. \"\n                \"Install with: pip install langgraph-checkpoint-postgres\"\n            )\n\n        db_url = settings.DATABASE_URL\n        if not db_url:\n            raise ValueError(\n                \"DATABASE_URL not set in .env file. \"\n                \"Set it for PostgreSQL checkpointing, or use use_checkpointing=False\"\n            )\n\n        try:\n            # PostgresSaver.from_conn_string returns a context manager\n            # Enter it manually and keep it alive for the TradingGraph lifetime\n            context_manager = PostgresSaver.from_conn_string(db_url)\n            checkpointer = context_manager.__enter__()\n            checkpointer.setup()\n            return checkpointer, context_manager\n        except Exception as e:\n            raise ValueError(f\"Failed to connect to PostgreSQL at {db_url}: {str(e)}\")\n\n    def _create_llm(\n        self, provider: str, model: str, temperature: float\n    ) -> BaseChatModel:\n        \"\"\"\n        Create an LLM instance based on the provider.\n\n        Args:\n            provider: The provider name (\"openai\", \"anthropic\", \"qwen\", or \"azure\")\n            model: The model name\n            temperature: The temperature setting for the model\n\n        Returns:\n            BaseChatModel: An instance of the appropriate LLM class\n        \"\"\"\n        api_key = self._get_api_key(provider)\n\n        if provider == \"openai\":\n            return ChatOpenAI(\n                model=model,\n                temperature=temperature,\n                api_key=api_key,\n            )\n        elif provider == \"anthropic\":\n            # ChatAnthropic handles SystemMessage extraction automatically\n            # It extracts SystemMessage from the message list and passes it as 'system' parameter\n            # The messages array should contain at least one non-SystemMessage\n            return ChatAnthropic(\n                model=model,\n                temperature=temperature,\n                api_key=api_key,\n            )\n        elif provider == \"qwen\":\n            return ChatQwen(\n                model=model,\n                temperature=temperature,\n                api_key=api_key,\n                max_retries=4,\n            )\n        elif provider == \"azure\":\n            from langchain_openai import AzureChatOpenAI\n\n            endpoint = settings.AZURE_OPENAI_ENDPOINT\n            deployment = settings.AZURE_OPENAI_DEPLOYMENT\n            api_version = settings.AZURE_OPENAI_API_VERSION\n\n            if not endpoint:\n                raise ValueError(\n                    \"AZURE_OPENAI_ENDPOINT not found in .env file. \"\n                    \"Example: https://myresource.openai.azure.com/\"\n                )\n            if not deployment:\n                raise ValueError(\n                    \"AZURE_OPENAI_DEPLOYMENT not found in .env file. \"\n                    \"Set this to your Azure deployment name (e.g., gpt-4o)\"\n                )\n\n            return AzureChatOpenAI(\n                azure_endpoint=endpoint,\n                azure_deployment=deployment,\n                api_version=api_version,\n                api_key=api_key,\n                temperature=temperature,\n            )\n        else:\n            raise ValueError(\n                f\"Unsupported provider: {provider}. \"\n                \"Must be 'openai', 'anthropic', 'qwen', or 'azure'\"\n            )\n\n    # def _set_tool_nodes(self) -> Dict[str, ToolNode]:\n    #     \"\"\"\n    #     Define tool nodes for each agent type (indicator, pattern, trend).\n    #     \"\"\"\n    #     return {\n    #         \"indicator\": ToolNode(\n    #             [\n    #                 self.toolkit.compute_macd,\n    #                 self.toolkit.compute_roc,\n    #                 self.toolkit.compute_rsi,\n    #                 self.toolkit.compute_stoch,\n    #                 self.toolkit.compute_willr,\n    #             ]\n    #         ),\n    #         \"pattern\": ToolNode(\n    #             [\n    #                 self.toolkit.generate_kline_image,\n    #             ]\n    #         ),\n    #         \"trend\": ToolNode([self.toolkit.generate_trend_image]),\n    #     }\n\n    def refresh_llms(self):\n        \"\"\"\n        Refresh the LLM objects with the current API key from environment.\n        This is called when the API key is updated.\n        \"\"\"\n        # Recreate LLM objects with current config values from settings module\n        self.agent_llm = self._create_llm(\n            provider=settings.AGENT_LLM_PROVIDER,\n            model=settings.AGENT_LLM_MODEL,\n            temperature=settings.AGENT_LLM_TEMPERATURE,\n        )\n        self.graph_llm = self._create_llm(\n            provider=settings.GRAPH_LLM_PROVIDER,\n            model=settings.GRAPH_LLM_MODEL,\n            temperature=settings.GRAPH_LLM_TEMPERATURE,\n        )\n\n        # Recreate the graph setup with new LLMs\n        self.graph_setup = SetGraph(\n            self.agent_llm,\n            self.graph_llm,\n            self.toolkit,\n            # self.tool_nodes,\n        )\n\n        # Recreate the main graph\n        self.graph = self.graph_setup.set_graph()\n\n    def update_api_key(self, api_key: str, provider: str = \"openai\"):\n        \"\"\"\n        Update API key in runtime and persist to .env file.\n        This method is called by the web interface when API key is updated.\n\n        Args:\n            api_key: The new API key\n            provider: The provider name (\"openai\", \"anthropic\", or \"qwen\")\n        \"\"\"\n        # Map provider to env var name\n        env_var_map = {\n            \"openai\": \"OPENAI_API_KEY\",\n            \"anthropic\": \"ANTHROPIC_API_KEY\",\n            \"qwen\": \"DASHSCOPE_API_KEY\",\n        }\n\n        if provider not in env_var_map:\n            raise ValueError(\n                f\"Unsupported provider: {provider}. Must be 'openai', 'anthropic', or 'qwen'\"\n            )\n\n        env_var = env_var_map[provider]\n\n        # Persist to .env file and update runtime\n        settings.update_env_file(env_var, api_key)\n\n        # Refresh the settings module attributes\n        if provider == \"openai\":\n            settings.OPENAI_API_KEY = api_key\n        elif provider == \"anthropic\":\n            settings.ANTHROPIC_API_KEY = api_key\n        elif provider == \"qwen\":\n            settings.DASHSCOPE_API_KEY = api_key\n\n        # Refresh LLMs with new key\n        self.refresh_llms()\n\n    def close(self):\n        \"\"\"\n        Close the checkpointer connection if it was opened.\n        Call this when done with the TradingGraph to clean up resources.\n        \"\"\"\n        if hasattr(self, \"_checkpointer_context\") and self._checkpointer_context:\n            try:\n                self._checkpointer_context.__exit__(None, None, None)\n            except Exception:\n                pass  # Ignore errors during cleanup\n","numLines":350,"startLine":1,"totalLines":350}}}
