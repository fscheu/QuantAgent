{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01M1DtZRbiouC85VxJRjhs5F","type":"tool_result","content":"1\t\"\"\"Base classes for trading strategies with Template Method Pattern.\"\"\"\n2\t\n3\tfrom abc import ABC, abstractmethod\n4\tfrom typing import Dict, List, Optional, Tuple\n5\t\n6\timport pandas as pd\n7\tfrom pydantic import BaseModel, Field\n8\t\n9\tfrom ..models import ActivePosition, ExitPolicy, OrderSide\n10\t\n11\t\n12\tclass TradingSignal(BaseModel):\n13\t    \"\"\"Standardized trading signal output from any strategy.\"\"\"\n14\t\n15\t    decision: str = Field(description=\"Trading decision: 'LONG', 'SHORT', or 'HOLD'\")\n16\t    confidence: float = Field(\n17\t        ge=0.0, le=1.0, description=\"Decision confidence (0.0-1.0)\"\n18\t    )\n19\t    entry_price: Optional[float] = Field(\n20\t        default=None, description=\"Suggested entry price\"\n21\t    )\n22\t    stop_loss: Optional[float] = Field(\n23\t        default=None, description=\"Suggested stop loss price\"\n24\t    )\n25\t    take_profit: Optional[float] = Field(\n26\t        default=None, description=\"Suggested take profit price\"\n27\t    )\n28\t    reasoning: str = Field(default=\"\", description=\"Reasoning for the decision\")\n29\t    exit_policy: ExitPolicy = Field(\n30\t        default=ExitPolicy.TRAILING_STOP, description=\"Exit policy for position\"\n31\t    )\n32\t    trailing_stop_pct: Optional[float] = Field(\n33\t        default=None, description=\"Trailing stop percentage (0.0-1.0)\"\n34\t    )\n35\t    max_hold_candles: Optional[int] = Field(\n36\t        default=None, description=\"Maximum candles to hold position\"\n37\t    )\n38\t\n39\t\n40\tclass TradingStrategy(ABC):\n41\t    \"\"\"\n42\t    Abstract base class for trading strategies.\n43\t\n44\t    Implements Template Method Pattern for exit logic:\n45\t    - should_exit() has DEFAULT implementation (fixed % SL/TP + trailing)\n46\t    - Strategies can override for custom logic (ATR-based, time-based, etc.)\n47\t    \"\"\"\n48\t\n49\t    @abstractmethod\n50\t    def generate_signal(\n51\t        self,\n52\t        kline_data: List[Dict],\n53\t        symbol: str,\n54\t        timeframe: str,\n55\t        current_price: float,\n56\t    ) -> Optional[TradingSignal]:\n57\t        \"\"\"\n58\t        Generate trading signal based on market data.\n59\t\n60\t        Args:\n61\t            kline_data: List of OHLCV candles (dicts with keys: open, high, low, close, volume, timestamp)\n62\t            symbol: Asset symbol (e.g., \"BTCUSDT\")\n63\t            timeframe: Timeframe (e.g., \"4h\")\n64\t            current_price: Current market price\n65\t\n66\t        Returns:\n67\t            TradingSignal if action needed, None otherwise\n68\t        \"\"\"\n69\t        pass\n70\t\n71\t    def should_exit(\n72\t        self,\n73\t        position: ActivePosition,\n74\t        current_price: float,\n75\t        ohlc_data: pd.DataFrame,\n76\t    ) -> Tuple[bool, Optional[str]]:\n77\t        \"\"\"\n78\t        Decide if position should be closed (Template Method).\n79\t\n80\t        DEFAULT IMPLEMENTATION: Fixed % SL/TP + trailing stop check.\n81\t        Strategies can override for custom logic (ATR, volatility-based, etc.).\n82\t\n83\t        Args:\n84\t            position: Active position to evaluate\n85\t            current_price: Current market price\n86\t            ohlc_data: OHLC DataFrame for calculations (columns: open, high, low, close, volume, timestamp)\n87\t\n88\t        Returns:\n89\t            (should_exit, reason):\n90\t                - should_exit: True if position should close\n91\t                - reason: \"STOP_LOSS\", \"TAKE_PROFIT\", \"TRAILING_STOP\", \"TIME_EXPIRED\", or None\n92\t        \"\"\"\n93\t        # Check stop loss\n94\t        if position.side == OrderSide.BUY:\n95\t            if current_price <= float(position.stop_loss):\n96\t                return (True, \"STOP_LOSS\")\n97\t        else:  # SHORT\n98\t            if current_price >= float(position.stop_loss):\n99\t                return (True, \"STOP_LOSS\")\n100\t\n101\t        # Check take profit\n102\t        if position.side == OrderSide.BUY:\n103\t            if current_price >= float(position.take_profit):\n104\t                return (True, \"TAKE_PROFIT\")\n105\t        else:  # SHORT\n106\t            if current_price <= float(position.take_profit):\n107\t                return (True, \"TAKE_PROFIT\")\n108\t\n109\t        # Check trailing stop\n110\t        if position.exit_policy == ExitPolicy.TRAILING_STOP:\n111\t            if self._check_trailing_stop(position, current_price):\n112\t                return (True, \"TRAILING_STOP\")\n113\t\n114\t        # Check time-based exit\n115\t        if (\n116\t            position.max_hold_candles\n117\t            and position.candles_since_entry >= position.max_hold_candles\n118\t        ):\n119\t            if position.exit_policy == ExitPolicy.TIME_BASED:\n120\t                return (True, \"TIME_EXPIRED\")\n121\t\n122\t        return (False, None)\n123\t\n124\t    def _check_trailing_stop(\n125\t        self, position: ActivePosition, current_price: float\n126\t    ) -> bool:\n127\t        \"\"\"\n128\t        Check trailing stop condition (default: % fixed).\n129\t\n130\t        Strategies can override to use ATR or other metrics.\n131\t\n132\t        Args:\n133\t            position: Active position\n134\t            current_price: Current market price\n135\t\n136\t        Returns:\n137\t            True if trailing stop triggered\n138\t        \"\"\"\n139\t        if not position.trailing_stop_pct:\n140\t            return False\n141\t\n142\t        # Update highest/lowest seen prices\n143\t        if position.side == OrderSide.BUY:\n144\t            # LONG position\n145\t            if position.highest_price_seen is None or current_price > float(\n146\t                position.highest_price_seen\n147\t            ):\n148\t                position.highest_price_seen = current_price\n149\t\n150\t            # Trailing stop from highest\n151\t            trailing_sl = float(position.highest_price_seen) * (\n152\t                1 - position.trailing_stop_pct\n153\t            )\n154\t            return current_price < trailing_sl\n155\t\n156\t        else:\n157\t            # SHORT position\n158\t            if position.lowest_price_seen is None or current_price < float(\n159\t                position.lowest_price_seen\n160\t            ):\n161\t                position.lowest_price_seen = current_price\n162\t\n163\t            # Trailing stop from lowest\n164\t            trailing_sl = float(position.lowest_price_seen) * (\n165\t                1 + position.trailing_stop_pct\n166\t            )\n167\t            return current_price > trailing_sl\n168\t\n169\t    @abstractmethod\n170\t    def should_reevaluate(\n171\t        self,\n172\t        position: ActivePosition,\n173\t        current_price: float,\n174\t    ) -> bool:\n175\t        \"\"\"\n176\t        Determine if position should be re-evaluated by agent.\n177\t\n178\t        Only relevant for ExitPolicy.REEVALUATE.\n179\t\n180\t        Args:\n181\t            position: Active position\n182\t            current_price: Current market price\n183\t\n184\t        Returns:\n185\t            True if strategy should be invoked again\n186\t        \"\"\"\n187\t        pass\n188\t\n189\t    def get_default_exit_policy(self) -> ExitPolicy:\n190\t        \"\"\"\n191\t        Get default exit policy for this strategy.\n192\t\n193\t        Can be overridden by subclasses.\n194\t\n195\t        Returns:\n196\t            Default ExitPolicy enum value\n197\t        \"\"\"\n198\t        return ExitPolicy.TRAILING_STOP\n199\t"}]},"parent_tool_use_id":null,"session_id":"ce2496a8-a497-4f7a-9d36-07ca768dd87e","uuid":"90429b70-31cb-4487-9fff-e942805af793","timestamp":"2026-05-05T00:52:43.204Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/autodev-worktrees/QuantAgent/QuantAgent-c69/planner-20260505T005036Z/quantagent/strategy/base.py","content":"\"\"\"Base classes for trading strategies with Template Method Pattern.\"\"\"\n\nfrom abc import ABC, abstractmethod\nfrom typing import Dict, List, Optional, Tuple\n\nimport pandas as pd\nfrom pydantic import BaseModel, Field\n\nfrom ..models import ActivePosition, ExitPolicy, OrderSide\n\n\nclass TradingSignal(BaseModel):\n    \"\"\"Standardized trading signal output from any strategy.\"\"\"\n\n    decision: str = Field(description=\"Trading decision: 'LONG', 'SHORT', or 'HOLD'\")\n    confidence: float = Field(\n        ge=0.0, le=1.0, description=\"Decision confidence (0.0-1.0)\"\n    )\n    entry_price: Optional[float] = Field(\n        default=None, description=\"Suggested entry price\"\n    )\n    stop_loss: Optional[float] = Field(\n        default=None, description=\"Suggested stop loss price\"\n    )\n    take_profit: Optional[float] = Field(\n        default=None, description=\"Suggested take profit price\"\n    )\n    reasoning: str = Field(default=\"\", description=\"Reasoning for the decision\")\n    exit_policy: ExitPolicy = Field(\n        default=ExitPolicy.TRAILING_STOP, description=\"Exit policy for position\"\n    )\n    trailing_stop_pct: Optional[float] = Field(\n        default=None, description=\"Trailing stop percentage (0.0-1.0)\"\n    )\n    max_hold_candles: Optional[int] = Field(\n        default=None, description=\"Maximum candles to hold position\"\n    )\n\n\nclass TradingStrategy(ABC):\n    \"\"\"\n    Abstract base class for trading strategies.\n\n    Implements Template Method Pattern for exit logic:\n    - should_exit() has DEFAULT implementation (fixed % SL/TP + trailing)\n    - Strategies can override for custom logic (ATR-based, time-based, etc.)\n    \"\"\"\n\n    @abstractmethod\n    def generate_signal(\n        self,\n        kline_data: List[Dict],\n        symbol: str,\n        timeframe: str,\n        current_price: float,\n    ) -> Optional[TradingSignal]:\n        \"\"\"\n        Generate trading signal based on market data.\n\n        Args:\n            kline_data: List of OHLCV candles (dicts with keys: open, high, low, close, volume, timestamp)\n            symbol: Asset symbol (e.g., \"BTCUSDT\")\n            timeframe: Timeframe (e.g., \"4h\")\n            current_price: Current market price\n\n        Returns:\n            TradingSignal if action needed, None otherwise\n        \"\"\"\n        pass\n\n    def should_exit(\n        self,\n        position: ActivePosition,\n        current_price: float,\n        ohlc_data: pd.DataFrame,\n    ) -> Tuple[bool, Optional[str]]:\n        \"\"\"\n        Decide if position should be closed (Template Method).\n\n        DEFAULT IMPLEMENTATION: Fixed % SL/TP + trailing stop check.\n        Strategies can override for custom logic (ATR, volatility-based, etc.).\n\n        Args:\n            position: Active position to evaluate\n            current_price: Current market price\n            ohlc_data: OHLC DataFrame for calculations (columns: open, high, low, close, volume, timestamp)\n\n        Returns:\n            (should_exit, reason):\n                - should_exit: True if position should close\n                - reason: \"STOP_LOSS\", \"TAKE_PROFIT\", \"TRAILING_STOP\", \"TIME_EXPIRED\", or None\n        \"\"\"\n        # Check stop loss\n        if position.side == OrderSide.BUY:\n            if current_price <= float(position.stop_loss):\n                return (True, \"STOP_LOSS\")\n        else:  # SHORT\n            if current_price >= float(position.stop_loss):\n                return (True, \"STOP_LOSS\")\n\n        # Check take profit\n        if position.side == OrderSide.BUY:\n            if current_price >= float(position.take_profit):\n                return (True, \"TAKE_PROFIT\")\n        else:  # SHORT\n            if current_price <= float(position.take_profit):\n                return (True, \"TAKE_PROFIT\")\n\n        # Check trailing stop\n        if position.exit_policy == ExitPolicy.TRAILING_STOP:\n            if self._check_trailing_stop(position, current_price):\n                return (True, \"TRAILING_STOP\")\n\n        # Check time-based exit\n        if (\n            position.max_hold_candles\n            and position.candles_since_entry >= position.max_hold_candles\n        ):\n            if position.exit_policy == ExitPolicy.TIME_BASED:\n                return (True, \"TIME_EXPIRED\")\n\n        return (False, None)\n\n    def _check_trailing_stop(\n        self, position: ActivePosition, current_price: float\n    ) -> bool:\n        \"\"\"\n        Check trailing stop condition (default: % fixed).\n\n        Strategies can override to use ATR or other metrics.\n\n        Args:\n            position: Active position\n            current_price: Current market price\n\n        Returns:\n            True if trailing stop triggered\n        \"\"\"\n        if not position.trailing_stop_pct:\n            return False\n\n        # Update highest/lowest seen prices\n        if position.side == OrderSide.BUY:\n            # LONG position\n            if position.highest_price_seen is None or current_price > float(\n                position.highest_price_seen\n            ):\n                position.highest_price_seen = current_price\n\n            # Trailing stop from highest\n            trailing_sl = float(position.highest_price_seen) * (\n                1 - position.trailing_stop_pct\n            )\n            return current_price < trailing_sl\n\n        else:\n            # SHORT position\n            if position.lowest_price_seen is None or current_price < float(\n                position.lowest_price_seen\n            ):\n                position.lowest_price_seen = current_price\n\n            # Trailing stop from lowest\n            trailing_sl = float(position.lowest_price_seen) * (\n                1 + position.trailing_stop_pct\n            )\n            return current_price > trailing_sl\n\n    @abstractmethod\n    def should_reevaluate(\n        self,\n        position: ActivePosition,\n        current_price: float,\n    ) -> bool:\n        \"\"\"\n        Determine if position should be re-evaluated by agent.\n\n        Only relevant for ExitPolicy.REEVALUATE.\n\n        Args:\n            position: Active position\n            current_price: Current market price\n\n        Returns:\n            True if strategy should be invoked again\n        \"\"\"\n        pass\n\n    def get_default_exit_policy(self) -> ExitPolicy:\n        \"\"\"\n        Get default exit policy for this strategy.\n\n        Can be overridden by subclasses.\n\n        Returns:\n            Default ExitPolicy enum value\n        \"\"\"\n        return ExitPolicy.TRAILING_STOP\n","numLines":199,"startLine":1,"totalLines":199}}}
