      DEPLOY_OUTCOME: ${{ steps.deploy.outcome }}\n          HEALTH_OUTCOME: ${{ steps.health.outcome }}\n          QA_TARGET_ALIGNMENT_OUTCOME: ${{ steps.qa_target_alignment.outcome }}\n          QA_VALIDATOR_OUTCOME: ${{ steps.qa_validator.outcome }}\n          QA_VALIDATOR_RESULT_STATUS: ${{ steps.qa_validator_result.outputs.qa_validator_result_status }}\n          QA_VERIFIED: ${{ steps.qa_validator_result.outputs.qa_verified }}\n          QA_PARTIAL: ${{ steps.qa_validator_result.outputs.qa_partial }}\n          VALIDATOR_ARTIFACTS_COUNT: ${{ steps.qa_validator_result.outputs.validator_artifacts_count }}\n          VALIDATOR_ARTIFACTS_LIST: ${{ steps.qa_validator_result.outputs.validator_artifacts_list }}\n        run: |\n          python3 - <<'PY'\n          import json\n          import hashlib\n          import hmac\n          import os\n          import urllib.request\n\n          url = os.environ[\"HERMES_WEBHOOK_URL\"]\n          secret = os.environ[\"HERMES_WEBHOOK_SECRET\"]\n          run_id = os.environ.get(\"GITHUB_RUN_ID\", \"\")\n          run_attempt = os.environ.get(\"GITHUB_RUN_ATTEMPT\", \"\")\n          repo = os.environ.get(\"GITHUB_REPOSITORY\", \"\")\n\n          payload = {\n              \"event_type\": \"deploy_finished\",\n              \"repo\": repo,\n              \"workflow\": os.environ.get(\"GITHUB_WORKFLOW\", \"\"),\n              \"job\": os.environ.get(\"GITHUB_JOB\", \"\"),\n              \"environment\": \"qa\",\n              \"ref\": os.environ.get(\"GITHUB_REF\", \"\"),\n              \"branch\": os.environ.get(\"GITHUB_REF_NAME\", \"\"),\n              \"sha\": os.environ.get(\"GITHUB_SHA\", \"\"),\n              \"actor\": os.environ.get(\"GITHUB_ACTOR\", \"\"),\n              \"conclusion\": os.environ.get(\"JOB_STATUS\", \"\"),\n              \"run_id\": run_id,\n              \"run_attempt\": run_attempt,\n              \"run_url\": f\"https://github.com/{repo}/actions/runs/{run_id}\",\n              \"deployed_url\": 