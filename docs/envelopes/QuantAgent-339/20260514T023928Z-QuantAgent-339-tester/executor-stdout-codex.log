{"type":"item.completed","item":{"id":"item_31","type":"command_execution","command":"/bin/bash -lc \"sed -n '1,260p' .github/workflows/main-ci-deploy.yml\"","aggregated_output":"name: Main CI + Deploy QA\n\non:\n  push:\n    branches: [main]\n  workflow_dispatch:\n\nenv:\n  PYTHON_VERSION: \"3.11\"\n\njobs:\n  ci:\n    name: CI (Lint + Tests)\n    runs-on: ubuntu-latest\n    \n    services:\n      postgres:\n        image: postgres:16\n        env:\n          POSTGRES_USER: test\n          POSTGRES_PASSWORD: test\n          POSTGRES_DB: quantagent_test\n        ports:\n          - 5432:5432\n        options: >-\n          --health-cmd pg_isready\n          --health-interval 10s\n          --health-timeout 5s\n          --health-retries 5\n    \n    steps:\n      - name: Checkout code\n        uses: actions/checkout@v4\n      \n      - name: Set up Python\n        uses: actions/setup-python@v5\n        with:\n          python-version: ${{ env.PYTHON_VERSION }}\n          cache: 'pip'\n      \n      - name: Install system dependencies\n        run: |\n          sudo apt-get update\n          sudo apt-get install -y wget\n          # TA-Lib\n          wget http://prdownloads.sourceforge.net/ta-lib/ta-lib-0.4.0-src.tar.gz\n          tar -xzf ta-lib-0.4.0-src.tar.gz\n          cd ta-lib\n          ./configure --prefix=/usr\n          make\n          sudo make install\n          cd ..\n      \n      - name: Install Python dependencies\n        run: |\n          python -m pip install --upgrade pip\n          pip install -e .\n          pip install pytest pytest-cov ruff\n      \n      - name: Lint with ruff (autofix + check)\n        id: lint\n        run: |\n          ruff check quantagent/ --fix\n          ruff check quantagent/ --output-format=github\n        continue-on-error: true\n      \n      - name: Run unit tests\n        id: tests\n        env:\n          DATABASE_URL: postgresql://test:test@localhost:5432/quantagent_test\n        run: |\n          pytest tests/ -v --tb=short --maxfail=10 \\\n            -m \"not integration and not slow\"\n      \n      - name: Determine overall status\n        id: status\n        env:\n          LINT_EXIT: ${{ steps.lint.outcome }}\n          TESTS_EXIT: ${{ steps.tests.outcome || 'skipped' }}\n        run: |\n          if [[ \"$LINT_EXIT\" != \"success\" ]]; then\n            echo \"failed_step=Lint\" >> $GITHUB_OUTPUT\n            exit 1\n          fi\n\n          if [[ \"$TESTS_EXIT\" != \"success\" && \"$TESTS_EXIT\" != \"skipped\" ]]; then\n            echo \"failed_step=Unit tests\" >> $GITHUB_OUTPUT\n            exit 1\n          fi\n\n          echo \"All checks passed\"\n      \n      - name: Notify Telegram on failure\n        if: failure()\n        env:\n          TELEGRAM_BOT_TOKEN: ${{ secrets.TELEGRAM_BOT_TOKEN }}\n        run: |\n          COMMIT_SHA=\"${GITHUB_SHA:0:7}\"\n          COMMIT_MSG=$(git log -1 --pretty=%B | head -1 | tr '\"' \"'\")\n          FAILED_STEP=\"${{ steps.status.outputs.failed_step || 'Unknown' }}\"\n          RUN_URL=\"https://github.com/${{ github.repository }}/actions/runs/${{ github.run_id }}\"\n          \n          curl -X POST \"https://api.telegram.org/bot${TELEGRAM_BOT_TOKEN}/sendMessage\" \\\n            -H \"Content-Type: application/json\" \\\n            -d \"{\n              \\\"chat_id\\\": \\\"-1003835130753\\\",\n              \\\"message_thread_id\\\": 208,\n              \\\"text\\\": \\\"🚨 CI Failure\\\\n\\\\nCommit: ${COMMIT_SHA}\\\\nMessage: ${COMMIT_MSG}\\\\nFailed step: ${FAILED_STEP}\\\\nLogs: ${RUN_URL}\\\\n\\\\n@openclaw Run ID: ${{ github.run_id }}\\\",\n              \\\"disable_web_page_preview\\\": true\n            }\"\n      \n      - name: Notify Telegram on success\n        if: success()\n        env:\n          TELEGRAM_BOT_TOKEN: ${{ secrets.TELEGRAM_BOT_TOKEN }}\n        run: |\n          COMMIT_SHA=\"${GITHUB_SHA:0:7}\"\n          COMMIT_MSG=$(git log -1 --pretty=%B | head -1 | tr '\"' \"'\")\n          \n          curl -X POST \"https://api.telegram.org/bot${TELEGRAM_BOT_TOKEN}/sendMessage\" \\\n            -H \"Content-Type: application/json\" \\\n            -d \"{\n              \\\"chat_id\\\": \\\"-1003835130753\\\",\n              \\\"message_thread_id\\\": 208,\n              \\\"text\\\": \\\"✅ CI passed\\\\n\\\\nCommit: ${COMMIT_SHA}\\\\nMessage: ${COMMIT_MSG}\\\",\n              \\\"disable_web_page_preview\\\": true\n            }\"\n  \n  deploy-qa:\n    name: Deploy to QA\n    needs: ci\n    runs-on: [self-hosted, Linux, X64, quantagent-vm]\n    if: success()\n\n    steps:\n      - name: Checkout code\n        uses: actions/checkout@v4\n\n      - name: Reset QA validator run artifacts\n        run: |\n          rm -rf /home/azureuser/repos/agents/qa-validator-poc/runs/poc-qa-validator-local-streamlit-8501\n\n      - name: Deploy to QA locally\n        id: deploy\n        run: |\n          cd ~/repos/projects/QuantAgent\n          git fetch origin\n          git reset --hard origin/main\n          sudo docker image prune -af || true\n          sudo docker container prune -f || true\n          sudo docker builder prune -af || true\n          sudo docker compose -f docker-compose.qa.yml down --remove-orphans || true\n          sudo docker compose -f docker-compose.qa.yml build --no-cache\n          sudo docker compose -f docker-compose.qa.yml up -d\n          echo \"Waiting for services to be healthy...\"\n          sleep 20\n\n      - name: Health check\n        id: health\n        run: |\n          for i in {1..18}; do\n            if curl -fsS http://127.0.0.1:8501/_stcore/health; then\n              echo \"QA Streamlit is healthy\"\n              exit 0\n            fi\n            echo \"Attempt $i/18 failed, waiting...\"\n            sleep 10\n          done\n          echo \"Health check failed after 18 attempts\"\n          exit 1\n\n      - name: Verify pinned QA validator artifacts\n        id: qa_validator_integrity\n        run: |\n          printf '%s  %s\\n' \\\n            'dfeb61fef2ed354dd014a777131e5d44e1fd866db44ee43736f2fe7e82c6cf6c' '/home/azureuser/repos/agents/qa-validator-poc/runner.py' \\\n            '43c15205cd6e3d586e740a212b817bf419d793080eb6a3699432e5082a7b06ce' '/home/azureuser/repos/agents/qa-validator-poc/configs/local-streamlit.yaml' \\\n            '870b469879d53314bdd8e824f6bc3584fd14d1859646f1b82aa07c14ab49f47b' '/home/azureuser/repos/agents/qa-validator-poc/prompt_template.md' \\\n            'e3b6a8a9daa88d70b014048209b03729c56c5807ba75c15e726077059de9c775' '/home/azureuser/repos/agents/qa-validator-poc/docs/local-streamlit-target.md' \\\n            | sha256sum -c -\n\n      - name: Verify QA validator target alignment\n        id: qa_target_alignment\n        run: |\n          CONFIG=/home/azureuser/repos/agents/qa-validator-poc/configs/local-streamlit.yaml\n          echo \"=== Validator config target lines ===\"\n          grep -Ei 'url|target|host|port' \"$CONFIG\" | head -10 || echo \"(no matching lines found)\"\n          echo \"===\"\n          if grep -q '8501' \"$CONFIG\"; then\n            echo \"TARGET_ALIGNED=true — validator config references port 8501 (QA Streamlit runtime)\"\n          else\n            echo \"ERROR: Validator config does not reference port 8501.\"\n            echo \"Deployed QA target: http://127.0.0.1:8501\"\n            echo \"This is a target drift condition — aborting to prevent validating the wrong runtime.\"\n            exit 1\n          fi\n\n      - name: Run post-deploy QA validator\n        id: qa_validator\n        continue-on-error: true\n        run: |\n          cd ~/repos/projects/QuantAgent\n          python3 /home/azureuser/repos/agents/qa-validator-poc/runner.py \\\n            --config /home/azureuser/repos/agents/qa-validator-poc/configs/local-streamlit.yaml\n\n      - name: Read QA validator verdict\n        id: qa_validator_result\n        if: always()\n        run: |\n          python3 - <<'PY'\n          import json\n          from pathlib import Path\n\n          run_dir = Path('/home/azureuser/repos/agents/qa-validator-poc/runs/poc-qa-validator-local-streamlit-8501')\n          result_path = run_dir / 'result.json'\n          report_path = run_dir / 'run-report.md'\n\n          status = 'MISSING'\n          if result_path.exists():\n              try:\n                  status = json.loads(result_path.read_text()).get('status', 'MISSING')\n              except Exception:\n                  status = 'INVALID'\n\n          # Collect evidence artifacts\n          artifacts = []\n          if result_path.exists():\n              artifacts.append('result.json')\n          if report_path.exists():\n              artifacts.append('run-report.md')\n          for p in sorted(run_dir.glob('**/*')):\n              if p.is_file() and p.suffix in ('.png', '.jpg', '.html', '.log'):\n                  artifacts.append(str(p.relative_to(run_dir)))\n\n          artifacts_count = len(artifacts)\n          artifacts_list = ','.join(artifacts)\n\n          # Print run-report summary if available\n          if report_path.exists():\n              lines = report_path.read_text().splitlines()[:30]\n              print('=== run-report.md (first 30 lines) ===')\n              print('\\n'.join(lines))\n              print('===')\n\n          print(f'Validator status: {status}')\n          print(f'Artifacts present ({artifacts_count}): {artifacts_list}')\n\n          # qa_verified: only SUCCESS qualifies as fully verified\n          # qa_partial:  PARTIAL means infra up but some functional coverage incomplete\n          qa_verified = str(status == 'SUCCESS').lower()\n          qa_partial = str(status == 'PARTIAL').lower()\n\n          with open(Path.cwd() / '.github_output_tmp', 'w', encoding='utf-8') as f:\n              f.write(f'qa_validator_result_status={status}\\n')\n              f.write(f'qa_verified={qa_verified}\\n')\n              f.write(f'qa_partial={qa_partial}\\n')\n              f.write(f'validator_artifacts_count={artifacts_count}\\n')\n              f.write(f'validator_artifacts_list={artifacts_list}\\n')\n          PY\n          cat .github_output_tmp >> \"$GITHUB_OUTPUT\"\n","exit_code":0,"status":"completed"}}
