{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01RPfYY7wYkdj3QsTw79TPrr","type":"tool_result","content":"1\tfrom __future__ import annotations\n2\t\n3\timport pandas as pd\n4\timport streamlit as st\n5\t\n6\t\n7\tdef render(db, environment: str) -> None:\n8\t    st.subheader(\"Replay – Scenario Sweeps (Sequential)\")\n9\t    st.caption(\"Reuses stored analyses; executes different profiles sequentially.\")\n10\t\n11\t    st.session_state.setdefault(\"replay_runs\", [])\n12\t    st.session_state.setdefault(\"backtest_runs\", [])\n13\t    st.session_state.setdefault(\n14\t        \"ui_profiles\", {\"portfolio\": {}, \"risk\": {}, \"combined\": {}}\n15\t    )\n16\t\n17\t    available_runs = {r[\"id\"] for r in st.session_state.backtest_runs if \"id\" in r}\n18\t    if db.ok:\n19\t        try:\n20\t            with db.SessionLocal() as s:\n21\t                for r in s.query(db.models.BacktestRun.id).all():\n22\t                    run_id = getattr(r, \"id\", None)\n23\t                    if run_id is None and isinstance(r, tuple) and r:\n24\t                        run_id = r[0]\n25\t                    if run_id is not None:\n26\t                        available_runs.add(run_id)\n27\t        except Exception:\n28\t            pass\n29\t    runs_list = sorted(list(available_runs))\n30\t\n31\t    if not runs_list:\n32\t        st.info(\"Create a backtest run first.\")\n33\t        return\n34\t\n35\t    run_id = st.selectbox(\"Backtest run id\", runs_list, index=0)\n36\t    profile_options = _collect_profile_options(db)\n37\t    profiles_selected = st.multiselect(\n38\t        \"Profiles to replay sequentially\",\n39\t        profile_options,\n40\t        default=profile_options[:1] if profile_options else [],\n41\t    )\n42\t    if st.button(\"Start replay (sequential)\"):\n43\t        queue = profiles_selected or [\"default\"]\n44\t        for profile in queue:\n45\t            st.session_state.replay_runs.append(\n46\t                {\n47\t                    \"backtest_run_id\": run_id,\n48\t                    \"profile\": profile,\n49\t                    \"status\": \"queued\",\n50\t                    \"progress\": 0,\n51\t                    \"environment\": environment,\n52\t                }\n53\t            )\n54\t        st.success(\n55\t            f\"Queued {len(queue)} replay executions for run {run_id}. Backend wiring pending.\"\n56\t        )\n57\t\n58\t    if st.session_state.replay_runs:\n59\t        st.markdown(\"**Replay queue (session)**\")\n60\t        st.dataframe(\n61\t            pd.DataFrame(st.session_state.replay_runs), width='stretch'\n62\t        )\n63\t\n64\t\n65\tdef _collect_profile_options(db):\n66\t    names = []\n67\t    if db.ok:\n68\t        try:\n69\t            with db.SessionLocal() as s:\n70\t                names = [\n71\t                    c.name\n72\t                    for c in s.query(db.models.StrategyConfig).order_by(\n73\t                        db.models.StrategyConfig.name\n74\t                    )\n75\t                ]\n76\t        except Exception:\n77\t            pass\n78\t    names.extend(list(st.session_state.ui_profiles.get(\"portfolio\", {}).keys()))\n79\t    names.extend(list(st.session_state.ui_profiles.get(\"risk\", {}).keys()))\n80\t    names.extend(list(st.session_state.ui_profiles.get(\"combined\", {}).keys()))\n81\t    return sorted(list(dict.fromkeys(names)))\n82\t"}]},"parent_tool_use_id":null,"session_id":"471f3e70-3bc2-4389-b48d-0528a3f6a75b","uuid":"4c892f04-b275-484c-903d-767f3d852065","timestamp":"2026-05-10T07:38:13.822Z","tool_use_result":{"type":"text","file":{"filePath":"/mnt/actions-runner/autodev-runtime/worktrees/QuantAgent/QuantAgent-3o8/implementer-20260510T073737Z/apps/streamlit/views/replay.py","content":"from __future__ import annotations\n\nimport pandas as pd\nimport streamlit as st\n\n\ndef render(db, environment: str) -> None:\n    st.subheader(\"Replay – Scenario Sweeps (Sequential)\")\n    st.caption(\"Reuses stored analyses; executes different profiles sequentially.\")\n\n    st.session_state.setdefault(\"replay_runs\", [])\n    st.session_state.setdefault(\"backtest_runs\", [])\n    st.session_state.setdefault(\n        \"ui_profiles\", {\"portfolio\": {}, \"risk\": {}, \"combined\": {}}\n    )\n\n    available_runs = {r[\"id\"] for r in st.session_state.backtest_runs if \"id\" in r}\n    if db.ok:\n        try:\n            with db.SessionLocal() as s:\n                for r in s.query(db.models.BacktestRun.id).all():\n                    run_id = getattr(r, \"id\", None)\n                    if run_id is None and isinstance(r, tuple) and r:\n                        run_id = r[0]\n                    if run_id is not None:\n                        available_runs.add(run_id)\n        except Exception:\n            pass\n    runs_list = sorted(list(available_runs))\n\n    if not runs_list:\n        st.info(\"Create a backtest run first.\")\n        return\n\n    run_id = st.selectbox(\"Backtest run id\", runs_list, index=0)\n    profile_options = _collect_profile_options(db)\n    profiles_selected = st.multiselect(\n        \"Profiles to replay sequentially\",\n        profile_options,\n        default=profile_options[:1] if profile_options else [],\n    )\n    if st.button(\"Start replay (sequential)\"):\n        queue = profiles_selected or [\"default\"]\n        for profile in queue:\n            st.session_state.replay_runs.append(\n                {\n                    \"backtest_run_id\": run_id,\n                    \"profile\": profile,\n                    \"status\": \"queued\",\n                    \"progress\": 0,\n                    \"environment\": environment,\n                }\n            )\n        st.success(\n            f\"Queued {len(queue)} replay executions for run {run_id}. Backend wiring pending.\"\n        )\n\n    if st.session_state.replay_runs:\n        st.markdown(\"**Replay queue (session)**\")\n        st.dataframe(\n            pd.DataFrame(st.session_state.replay_runs), width='stretch'\n        )\n\n\ndef _collect_profile_options(db):\n    names = []\n    if db.ok:\n        try:\n            with db.SessionLocal() as s:\n                names = [\n                    c.name\n                    for c in s.query(db.models.StrategyConfig).order_by(\n                        db.models.StrategyConfig.name\n                    )\n                ]\n        except Exception:\n            pass\n    names.extend(list(st.session_state.ui_profiles.get(\"portfolio\", {}).keys()))\n    names.extend(list(st.session_state.ui_profiles.get(\"risk\", {}).keys()))\n    names.extend(list(st.session_state.ui_profiles.get(\"combined\", {}).keys()))\n    return sorted(list(dict.fromkeys(names)))\n","numLines":82,"startLine":1,"totalLines":82}}}
