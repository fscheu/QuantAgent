{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019FJuMpihY3vUqsUxLr9oJi","type":"tool_result","content":"1\t\"\"\"SQLAlchemy models for QuantAgent trading system.\"\"\"\n2\t\n3\timport enum\n4\tfrom datetime import datetime\n5\tfrom decimal import Decimal\n6\t\n7\tfrom sqlalchemy import (JSON, Boolean, Column, DateTime, Enum, Float,\n8\t                        ForeignKey, Index, Integer, Numeric, String, Text)\n9\tfrom sqlalchemy.dialects.postgresql import JSONB\n10\tfrom sqlalchemy.orm import relationship\n11\t\n12\tfrom .database import Base\n13\t\n14\t\n15\tclass OrderStatus(str, enum.Enum):\n16\t    \"\"\"Enum for order statuses.\"\"\"\n17\t\n18\t    PENDING = \"pending\"\n19\t    FILLED = \"filled\"\n20\t    PARTIALLY_FILLED = \"partially_filled\"\n21\t    CANCELLED = \"cancelled\"\n22\t    REJECTED = \"rejected\"\n23\t\n24\t\n25\tclass OrderSide(str, enum.Enum):\n26\t    \"\"\"Enum for order side (buy/sell).\"\"\"\n27\t\n28\t    BUY = \"buy\"\n29\t    SELL = \"sell\"\n30\t\n31\t\n32\tclass OrderType(str, enum.Enum):\n33\t    \"\"\"Enum for order types.\"\"\"\n34\t\n35\t    MARKET = \"market\"\n36\t    LIMIT = \"limit\"\n37\t    STOP = \"stop\"\n38\t    STOP_LIMIT = \"stop_limit\"\n39\t\n40\t\n41\tclass TradeSignal(str, enum.Enum):\n42\t    \"\"\"Enum for trading signals.\"\"\"\n43\t\n44\t    LONG = \"long\"\n45\t    SHORT = \"short\"\n46\t    NEUTRAL = \"neutral\"\n47\t    CLOSE = \"close\"\n48\t\n49\t\n50\tclass Environment(str, enum.Enum):\n51\t    \"\"\"Enum for execution environments.\"\"\"\n52\t\n53\t    BACKTEST = \"backtest\"\n54\t    PAPER = \"paper\"\n55\t    PROD = \"prod\"\n56\t\n57\t\n58\tclass ExitPolicy(str, enum.Enum):\n59\t    \"\"\"Enum for position exit policies.\"\"\"\n60\t\n61\t    SL_TP_ONLY = \"sl_tp_only\"\n62\t    TIME_BASED = \"time_based\"\n63\t    REEVALUATE = \"reevaluate\"\n64\t    TRAILING_STOP = \"trailing_stop\"\n65\t\n66\t\n67\tclass Order(Base):\n68\t    \"\"\"Order model for placing and tracking trading orders.\"\"\"\n69\t\n70\t    __tablename__ = \"orders\"\n71\t\n72\t    id = Column(Integer, primary_key=True, index=True)\n73\t    symbol = Column(String(20), nullable=False, index=True)\n74\t    side = Column(Enum(OrderSide), nullable=False)\n75\t    order_type = Column(Enum(OrderType), nullable=False)\n76\t    quantity = Column(Numeric(precision=18, scale=8), nullable=False)\n77\t    price = Column(Numeric(precision=18, scale=8), nullable=True)\n78\t    stop_price = Column(Numeric(precision=18, scale=8), nullable=True)\n79\t    status = Column(Enum(OrderStatus), nullable=False, default=OrderStatus.PENDING)\n80\t    created_at = Column(DateTime, nullable=False, default=datetime.utcnow, index=True)\n81\t    updated_at = Column(\n82\t        DateTime, nullable=False, default=datetime.utcnow, onupdate=datetime.utcnow\n83\t    )\n84\t    filled_at = Column(DateTime, nullable=True, index=True)\n85\t    filled_quantity = Column(Numeric(precision=18, scale=8), nullable=False, default=0)\n86\t    average_fill_price = Column(Numeric(precision=18, scale=8), nullable=True)\n87\t    comment = Column(Text, nullable=True)\n88\t\n89\t    # Environment & Provenance (NEW)\n90\t    environment = Column(\n91\t        Enum(Environment), nullable=False, default=Environment.PAPER, index=True\n92\t    )\n93\t    trigger_signal_id = Column(Integer, ForeignKey(\"signals.id\"), nullable=True)\n94\t\n95\t    # Relationships\n96\t    fills = relationship(\"Fill\", back_populates=\"order\", cascade=\"all, delete-orphan\")\n97\t    trades = relationship(\"Trade\", back_populates=\"order\", cascade=\"all, delete-orphan\")\n98\t    trigger_signal = relationship(\n99\t        \"Signal\", foreign_keys=[trigger_signal_id], back_populates=\"triggered_orders\"\n100\t    )\n101\t\n102\t    __table_args__ = (\n103\t        Index(\"idx_symbol_created_at\", \"symbol\", \"created_at\"),\n104\t        Index(\"idx_status_symbol\", \"status\", \"symbol\"),\n105\t        Index(\"idx_orders_environment\", \"environment\"),\n106\t    )\n107\t\n108\t\n109\tclass Fill(Base):\n110\t    \"\"\"Fill model for partial/full order executions.\"\"\"\n111\t\n112\t    __tablename__ = \"fills\"\n113\t\n114\t    id = Column(Integer, primary_key=True, index=True)\n115\t    order_id = Column(Integer, ForeignKey(\"orders.id\"), nullable=False, index=True)\n116\t    quantity = Column(Numeric(precision=18, scale=8), nullable=False)\n117\t    price = Column(Numeric(precision=18, scale=8), nullable=False)\n118\t    commission = Column(Numeric(precision=18, scale=8), nullable=False, default=0)\n119\t    filled_at = Column(DateTime, nullable=False, default=datetime.utcnow, index=True)\n120\t\n121\t    # Relationships\n122\t    order = relationship(\"Order\", back_populates=\"fills\")\n123\t\n124\t    __table_args__ = (Index(\"idx_order_filled_at\", \"order_id\", \"filled_at\"),)\n125\t\n126\t\n127\tclass Position(Base):\n128\t    \"\"\"Position model for tracking open positions.\"\"\"\n129\t\n130\t    __tablename__ = \"positions\"\n131\t\n132\t    id = Column(Integer, primary_key=True, index=True)\n133\t    symbol = Column(String(20), nullable=False, unique=True, index=True)\n134\t    quantity = Column(Numeric(precision=18, scale=8), nullable=False)\n135\t    average_entry_price = Column(Numeric(precision=18, scale=8), nullable=False)\n136\t    current_price = Column(Numeric(precision=18, scale=8), nullable=False)\n137\t    unrealized_pnl = Column(Numeric(precision=18, scale=8), nullable=False)\n138\t    unrealized_pnl_pct = Column(Float, nullable=False)\n139\t    side = Column(Enum(OrderSide), nullable=False)\n140\t    opened_at = Column(DateTime, nullable=False, default=datetime.utcnow, index=True)\n141\t    updated_at = Column(\n142\t        DateTime, nullable=False, default=datetime.utcnow, onupdate=datetime.utcnow\n143\t    )\n144\t\n145\t\n146\tclass Signal(Base):\n147\t    \"\"\"Signal model for tracking trading signals from agents.\"\"\"\n148\t\n149\t    __tablename__ = \"signals\"\n