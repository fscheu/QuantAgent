{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01WMRp7cYJcEFkjkx2jj8C78","type":"tool_result","content":"1\t\"\"\"Backtesting engine for strategy validation.\"\"\"\n2\t\n3\timport logging\n4\timport logging\n5\tfrom dataclasses import dataclass\n6\tfrom datetime import datetime, timedelta\n7\tfrom decimal import Decimal\n8\tfrom decimal import Decimal\n9\tfrom typing import Dict, List, Optional\n10\t\n11\timport numpy as np\n12\timport numpy as np\n13\timport pandas as pd\n14\tfrom sqlalchemy.orm import Session\n15\t\n16\tfrom quantagent.agent_models import TradingDecision\n17\tfrom quantagent.data.asset_types import AssetType, get_asset_type\n18\tfrom quantagent.data.market_calendar import get_market_calendar\n19\tfrom quantagent.data.provider import DataProvider\n20\tfrom quantagent.database import SessionLocal\n21\tfrom quantagent.models import (ActivePosition, BacktestRun, Environment, Order,\n22\t                               OrderSide, Signal, Trade, TradeSignal)\n23\tfrom quantagent.portfolio.manager import PortfolioManager\n24\tfrom quantagent.database import SessionLocal\n25\tfrom quantagent.models import (BacktestRun, Environment, Order, Signal, Trade,\n26\t                               TradeSignal)\n27\tfrom quantagent.portfolio.manager import PortfolioManager\n28\tfrom quantagent.static_util import format_ohlcv_for_agents\n29\tfrom quantagent.strategy.assembler import StrategyAssembler\n30\tfrom quantagent.strategy.base import TradingStrategy\n31\tfrom quantagent.strategy.llm_agent_strategy import LLMAgentStrategy\n32\tfrom quantagent.trading.order_manager import OrderManager\n33\tfrom quantagent.trading.paper_broker import PaperBroker\n34\tfrom quantagent.trading.position_monitor import PositionMonitor\n35\tfrom quantagent.trading.paper_broker import PaperBroker\n36\tfrom quantagent.trading.position_sizer import PositionSizer\n37\tfrom quantagent.trading.risk_manager import RiskManager\n38\tfrom quantagent.trading_graph import TradingGraph\n39\tfrom quantagent.trading_graph import TradingGraph\n40\t\n41\tlogger = logging.getLogger(__name__)\n42\t\n43\t\n44\t@dataclass\n45\tclass BacktestMetrics:\n46\t    \"\"\"Backtest performance metrics.\"\"\"\n47\t\n48\t    total_trades: int\n49\t    winning_trades: int\n50\t    losing_trades: int\n51\t    win_rate: float\n52\t    profit_factor: float\n53\t    sharpe_ratio: float\n54\t    max_drawdown: float\n55\t    total_pnl: float\n56\t    avg_win: float\n57\t    avg_loss: float\n58\t    largest_win: float\n59\t    largest_loss: float\n60\t    total_return_pct: float\n61\t\n62\t    # Phase 4: Active Position Monitoring metrics\n63\t    agent_invocations: int = 0\n64\t    invocations_saved: int = 0\n65\t    invocation_reduction_pct: float = 0.0\n66\t    mean_directional_accuracy: float = 0.0\n67\t    accuracy_by_candle: Dict[int, float] = None\n68\t    close_reasons: Dict[str, int] = None\n69\t\n70\t    def __post_init__(self):\n71\t        if self.accuracy_by_candle is None:\n72\t            self.accuracy_by_candle = {}\n73\t        if self.close_reasons is None:\n74\t            self.close_reasons = {}\n75\t\n76\t\n77\tclass Backtest:\n78\t    \"\"\"\n79\t    Backtesting engine for validating trading strategies.\n80\t\n81\t    Workflow:\n82\t    1. Loop through historical dates\n83\t    2. Fetch OHLC data for each date using DataProvider (cached)\n84\t    3. Execute analysis using TradingGraph\n85\t    4. Simulate trade execution using OrderManager\n86\t    5. Track portfolio performance\n87\t    6. Calculate and persist metrics\n88\t\n89\t    Features:\n90\t    - Uses DataProvider for 10x faster data access (caching)\n91\t    - Executes same agents as live trading\n92\t    - Stores full provenance (config snapshot, model metadata)\n93\t    - Supports replay with different risk/portfolio profiles\n94\t    \"\"\"\n95\t\n96\t    def __init__(\n97\t        self,\n98\t        start_date: datetime,\n99\t        end_date: datetime,\n100\t        assets: List[str],\n101\t        timeframe: str = \"1h\",\n102\t        initial_capital: float = 100000.0,\n103\t        config: Optional[Dict] = None,\n104\t        db_session: Optional[Session] = None,\n105\t        use_checkpointing: bool = False,\n106\t        strategy: Optional[TradingStrategy] = None,\n107\t    ):\n108\t        \"\"\"\n109\t        Initialize Backtest.\n110\t\n111\t        Args:\n112\t            start_date: Start date for backtest\n113\t            end_date: End date for backtest\n114\t            assets: List of asset symbols (e.g., [\"BTC\", \"SPX\", \"CL\"])\n115\t            timeframe: Timeframe for analysis (e.g., \"1h\", \"4h\", \"1d\")\n116\t            initial_capital: Starting portfolio value\n117\t            config: Configuration dict (portfolio/risk params, model settings)\n118\t            db_session: Database session (creates new if None)\n119\t            use_checkpointing: Enable LangGraph checkpointing for state persistence\n120\t            strategy: Optional TradingStrategy. If None, uses LLMAgentStrategy with TradingGraph\n121\t        \"\"\"\n122\t        self.start_date = start_date\n123\t        self.end_date = end_date\n124\t        self.assets = assets\n125\t        self.timeframe = timeframe\n126\t        self.initial_capital = initial_capital\n127\t        self.config = config or {}\n128\t        self.use_checkpointing = use_checkpointing\n129\t\n130\t        # Database\n131\t        self.db = db_session or SessionLocal()\n132\t        self._own_session = db_session is None\n133\t\n134\t        # Data provider (caching layer)\n135\t        self.data_provider = DataProvider(self.db)\n136\t\n137\t        # Resolve config via StrategyAssembler and build components (unify DB session)\n138\t        resolved = StrategyAssembler.from_snapshot(\n139\t            {\n140\t                \"initial_cash\": initial_capital,\n141\t                \"base_position_pct\": self.config.get(\"base_position_pct\", 0.05),\n142\t                \"max_daily_loss_pct\": self.config.get(\"max_daily_loss_pct\", 0.05),\n143\t                \"max_position_pct\": self.config.get(\"max_position_pct\", 0.10),\n144\t                \"slippage_pct\": self.config.get(\"slippage_pct\", 0.01),\n145\t                # Normalize model fields into generic ones; accept both\n146\t                \"model_provider\": self.config.get(\n147\t                    \"agent_llm_provider\", self.config.get(\"model_provider\", \"openai\")\n148\t                ),\n149\t                \"model_name\": self.config.get(\n150\t                    \"agent_llm_model\", self.config.get(\"model_name\", \"gpt-4o-mini\")\n151\t                ),\n152\t                \"temperature\": self.config.get(\n153\t                    \"agent_llm_temperature\", self.config.get(\"temperature\", 0.1)\n154\t                ),\n155\t                \"use_checkpointing\": use_checkpointing,\n156\t                \"universe\": self.config.get(\"universe\", []),\n157\t            },\n158\t            environment=Environment.BACKTEST,\n159\t        )\n160\t        components = StrategyAssembler.build_components(resolved, db_session=self.db)\n161\t\n162\t        # Trading graph (analysis engine)\n163\t        self.trading_graph = components.graph\n164\t\n165\t        # Trading strategy (use provided or default to LLMAgentStrategy)\n166\t        self.strategy = strategy or LLMAgentStrategy(self.trading_graph)\n167\t\n168\t        # Position monitor for active position tracking\n169\t        self.position_monitor = PositionMonitor(self.db)\n170\t\n171\t        # Trading components\n172\t        self.portfolio = components.portfolio_manager\n173\t        self.position_sizer = components.position_sizer\n174\t        self.risk_manager = components.risk_manager\n175\t        self.broker = components.broker\n176\t        self.order_manager = components.order_manager\n177\t\n178\t        # Backtest state\n179\t        self.current_date = start_date\n180\t        self.backtest_run_id: Optional[int] = None\n181\t        self.trades: List[Trade] = []\n182\t        self.equity_curve: List[Dict] = []\n183\t\n184\t        # Phase 4: Invocation tracking\n185\t        self.agent_invocations = 0\n186\t        self.total_candles_processed = 0\n187\t\n188\t        # Market hours filtering\n189\t        self.market_hours_filter = self.config.get(\"market_hours_filter\", True)\n190\t        self._market_calendar = (\n191\t            get_market_calendar() if self.market_hours_filter else None\n192\t        )\n193\t\n194\t        # Cache asset types for each symbol\n195\t        self._asset_types: Dict[str, AssetType] = {\n196\t            asset: get_asset_type(asset) for asset in assets\n197\t        }\n198\t\n199\t    def run(self, name: Optional[str] = None) -> BacktestMetrics:\n200\t        \"\"\"\n201\t        Run backtest and return metrics.\n202\t\n203\t        Args:\n204\t            name: Optional name for this backtest run\n205\t\n206\t        Returns:\n207\t            BacktestMetrics with performance statistics\n208\t        \"\"\"\n209\t        logger.info(\n210\t            f\"Starting backtest: {self.start_date} to {self.end_date}\",\n211\t            extra={\"event_type\": \"backtest_start\", \"environment\": \"backtest\"},\n212\t        )\n213\t        logger.info(\n214\t            f\"Assets: {self.assets}, Timeframe: {self.timeframe}\",\n215\t            extra={\"event_type\": \"backtest_start\"},\n216\t        )\n217\t        logger.info(\n218\t            f\"Initial capital: ${self.initial_capital:,.2f}\",\n219\t            extra={\"event_type\": \"backtest_start\"},\n220\t        )\n221\t        logger.info(\n222\t            f\"Market hours filter: {self.market_hours_filter}\",\n223\t            extra={\"event_type\": \"backtest_start\"},\n224\t        )\n225\t\n226\t        # Create backtest run record\n227\t        self._create_backtest_run(name)\n228\t\n229\t        # Process each asset with its filtered date range\n230\t        total_periods = 0\n231\t        for asset in self.assets:\n232\t            asset_dates = self._get_date_range_for_asset(asset)\n233\t            total_periods += len(asset_dates)\n234\t\n235\t            asset_type = self._asset_types.get(asset, AssetType.UNKNOWN)\n236\t            logger.info(\n237\t                f\"Asset {asset} ({asset_type.value}): {len(asset_dates)} analysis periods\",\n238\t                extra={\"event_type\": \"backtest_start\"},\n239\t            )\n240\t\n241\t        logger.info(\n242\t            f\"Backtesting {total_periods} total analysis periods\",\n243\t            extra={\"event_type\": \"backtest_start\"},\n244\t        )\n245\t\n246\t        # Track progress across all periods\n247\t        periods_completed = 0\n248\t\n249\t        # Loop through assets (outer) and their dates (inner)\n250\t        for asset in self.assets:\n251\t            asset_dates = self._get_date_range_for_asset(asset)\n252\t\n253\t            for i, current_date in enumerate(asset_dates):\n254\t                self.current_date = current_date\n255\t\n256\t                # Reset daily P&L tracking at start of each day\n257\t                if i == 0 or current_date.date() != asset_dates[i - 1].date():\n258\t                    self.risk_manager.reset_daily_tracker()\n259\t\n260\t                try:\n261\t                    self._analyze_and_trade(asset, current_date)\n262\t                except Exception as e:\n263\t                    logger.error(\n264\t                        f\"Error analyzing {asset} at {current_date}: {e}\",\n265\t                       \n266\t                        exc_info=True,\n267\t                        extra={\"event_type\": \"backtest_error\", \"symbol\": asset},\n268\t                    )\n269\t                    continue\n270\t\n271\t                # Record equity at end of period\n272\t                self._record_equity(current_date)\n273\t\n274\t\n275\t                periods_completed += 1\n276\t\n277\t                # Log progress\n278\t                if periods_completed % 100 == 0 or periods_completed == total_periods:\n279\t                    progress = (periods_completed / total_periods) * 100\n280\t                    logger.info(\n281\t                        f\"Progress: {progress:.1f}% ({periods_completed}/{total_periods})\",\n282\t                        extra={\"event_type\": \"backtest_progress\"},\n283\t                    )\n284\t\n285\t        # Calculate metrics\n286\t        metrics = self._calculate_metrics()\n287\t\n288\t        # Update backtest run with results\n289\t        self._update_backtest_run(metrics)\n290\t\n291\t        logger.info(\n292\t            f\"Backtest complete: {metrics.total_trades} trades, Win rate: {metrics.win_rate:.2%}\",\n293\t            extra={\"event_type\": \"backtest_end\", \"environment\": \"backtest\"},\n294\t        )\n295\t        logger.info(\n296\t            f\"Total P&L: ${metrics.total_pnl:,.2f} ({metrics.total_return_pct:.2%})\",\n297\t            extra={\"event_type\": \"backtest_end\"},\n298\t        )\n299\t\n300\t        return metrics\n301\t\n302\t    def _create_backtest_run(self, name: Optional[str]) -> None:\n303\t        \"\"\"Create BacktestRun record in database.\"\"\"\n304\t        run = BacktestRun(\n305\t            name=name or f\"Backtest_{datetime.now().strftime('%Y%m%d_%H%M%S')}\",\n306\t            timeframe=self.timeframe,\n307\t            assets=self.assets,\n308\t            start_date=self.start_date,\n309\t            end_date=self.end_date,\n310\t            config_snapshot=self._build_config_snapshot(),\n311\t        )\n312\t\n313\t        self.db.add(run)\n314\t        self.db.commit()\n315\t        self.backtest_run_id = run.id\n316\t\n317\t        logger.info(\n318\t            f\"Created backtest run #{self.backtest_run_id}: {run.name}\",\n319\t            extra={\"event_type\": \"backtest_init\"},\n320\t        )\n321\t\n322\t    def _build_config_snapshot(self) -> Dict:\n323\t        \"\"\"Build immutable config snapshot for reproducibility.\"\"\"\n324\t        # Re-generate snapshot via assembler to keep alignment\n325\t        resolved = StrategyAssembler.from_snapshot(\n326\t            {\n327\t                \"initial_cash\": self.initial_capital,\n328\t                \"base_position_pct\": self.config.get(\"base_position_pct\", 0.05),\n329\t                \"max_daily_loss_pct\": self.config.get(\"max_daily_loss_pct\", 0.05),\n330\t                \"max_position_pct\": self.config.get(\"max_position_pct\", 0.10),\n331\t                \"slippage_pct\": self.config.get(\"slippage_pct\", 0.01),\n332\t                \"model_provider\": self.config.get(\n333\t                    \"agent_llm_provider\", self.config.get(\"model_provider\", \"openai\")\n334\t                ),\n335\t                \"model_name\": self.config.get(\n336\t                    \"agent_llm_model\", self.config.get(\"model_name\", \"gpt-4o-mini\")\n337\t                ),\n338\t                \"temperature\": self.config.get(\n339\t                    \"agent_llm_temperature\", self.config.get(\"temperature\", 0.1)\n340\t                ),\n341\t                \"use_checkpointing\": self.use_checkpointing,\n342\t                \"universe\": self.config.get(\"universe\", []),\n343\t            },\n344\t            environment=Environment.BACKTEST,\n345\t        )\n346\t        return StrategyAssembler.config_snapshot(resolved)\n347\t\n348\t    def _get_date_range(self) -> List[datetime]:\n349\t        \"\"\"\n350\t        Get list of dates to backtest.\n351\t\n352\t        For hourly/intraday: every N hours\n353\t        For daily: every day\n354\t        \"\"\"\n355\t        dates = []\n356\t        current = self.start_date\n357\t\n358\t        # Determine step size based on timeframe\n359\t        if self.timeframe in [\"1h\", \"4h\"]:\n360\t            step_hours = int(self.timeframe.replace(\"h\", \"\"))\n361\t            step = timedelta(hours=step_hours)\n362\t        elif self.timeframe == \"1d\":\n363\t            step = timedelta(days=1)\n364\t        elif self.timeframe == \"1w\":\n365\t            step = timedelta(weeks=1)\n366\t        else:\n367\t            # Default to hourly\n368\t            step = timedelta(hours=1)\n369\t\n370\t        while current <= self.end_date:\n371\t            dates.append(current)\n372\t            current += step\n373\t\n374\t        return dates\n375\t\n376\t    def _get_date_range_for_asset(self, asset: str) -> List[datetime]:\n377\t        \"\"\"\n378\t        Get date range filtered by market hours for specific asset.\n379\t\n380\t        Args:\n381\t            asset: Asset symbol\n382\t\n383\t        Returns:\n384\t            List of valid trading timestamps for this asset\n385\t        \"\"\"\n386\t        all_dates = self._get_date_range()\n387\t\n388\t        if not self.market_hours_filter or self._market_calendar is None:\n389\t            return all_dates\n390\t\n391\t        asset_type = self._asset_types.get(asset, AssetType.UNKNOWN)\n392\t\n393\t        return self._market_calendar.filter_to_trading_hours(all_dates, asset_type)\n394\t\n395\t    def _analyze_and_trade(self, asset: str, current_date: datetime) -> None:\n396\t        \"\"\"\n397\t        Execute analysis and trade for a single asset at a given time.\n398\t\n399\t        NEW FLOW (Hybrid Model with PositionMonitor):\n400\t        1. Check for active position\n401\t        2. If active: strategy.should_exit() → close or update tracking (NO invoke)\n402\t        3. If not active: strategy.generate_signal() → open position if signal != HOLD\n403\t\n404\t        Args:\n405\t            asset: Asset symbol\n406\t            current_date: Current backtest date\n407\t        \"\"\"\n408\t        # Get historical data for analysis (need lookback period)\n409\t        lookback_days = 30\n410\t        data_start = current_date - timedelta(days=lookback_days)\n411\t\n412\t        df = self.data_provider.get_ohlc(\n413\t            symbol=asset,\n414\t            timeframe=self.timeframe,\n415\t            start_date=data_start,\n416\t            end_date=current_date,\n417\t        )\n418\t\n419\t        if df.empty or len(df) < 30:\n420\t            logger.warning(\n421\t                f\"Insufficient data for {asset} at {current_date} (got {len(df)} records)\",\n422\t                extra={\"event_type\": \"backtest_data_warning\", \"symbol\": asset},\n423\t            )\n424\t            return\n425\t\n426\t        current_price = float(df.iloc[-1][\"close\"])\n427\t\n428\t        # Check for active position\n429\t        active_pos = self.position_monitor.get_active_position(asset)\n430\t\n431\t        # Phase 4: Count total candles processed\n432\t        self.total_candles_processed += 1\n433\t\n434\t        if active_pos:\n435\t            # Position active: check exit conditions via strategy\n436\t            should_exit, reason = self.strategy.should_exit(\n437\t                active_pos, current_price, df\n438\t            )\n439\t\n440\t            if should_exit:\n441\t                # Close position\n442\t                self.position_monitor.close_position(active_pos, reason, current_price)\n443\t\n444\t                # Execute close via OrderManager\n445\t                if active_pos.trade_id:\n446\t                    self.order_manager.close_trade(\n447\t                        active_pos.trade_id,\n448\t                        current_price,\n449\t                        environment=Environment.BACKTEST,\n450\t                    )\n451\t                    logger.info(\n452\t                        f\"{asset}: Closed position - {reason} @ ${current_price:.2f}\"\n453\t                    )\n454\t                # Continue to potentially open new position below\n455\t            else:\n456\t                # Position still active: update tracking only (NO INVOKE)\n457\t                prev_close = (\n458\t                    float(df.iloc[-2][\"close\"]) if len(df) >= 2 else current_price\n459\t                )\n460\t                self.position_monitor.update_candle_tracking(\n461\t                    active_pos, current_price, prev_close\n462\t                )\n463\t                return  # Early return - invocation saved\n464\t\n465\t        # No active position (or just closed): generate signal\n466\t        kline_data = format_ohlcv_for_agents(df)\n467\t\n468\t        # Phase 4: Count agent invocations\n469\t        self.agent_invocations += 1\n470\t\n471\t        # Generate thread_id for checkpointing (if enabled)\n472\t        thread_id = None\n473\t        if self.use_checkpointing:\n474\t            from quantagent.strategy.assembler import StrategyAssembler\n475\t\n476\t            thread_id = StrategyAssembler.make_thread_id(\n477\t                self.backtest_run_id, asset, current_date\n478\t            )\n479\t\n480\t        signal = self.strategy.generate_signal(\n481\t            kline_data, asset, self.timeframe, current_price, thread_id=thread_id\n482\t        )\n483\t\n484\t        if signal is None or signal.decision == \"HOLD\":\n485\t            return\n486\t\n487\t        # Execute trade\n488\t        trading_signal = (\n489\t            TradeSignal.LONG if signal.decision == \"LONG\" else TradeSignal.SHORT\n490\t        )\n491\t\n492\t        # Store signal in database\n493\t        db_signal = self._create_signal_from_strategy(\n494\t            asset=asset,\n495\t            decision=trading_signal,\n496\t            confidence=signal.confidence,\n497\t            reasoning=signal.reasoning,\n498\t            current_date=current_date,\n499\t        )\n500\t\n501\t        # Execute order\n502\t        order = self.order_manager.execute_decision(\n503\t            symbol=asset,\n504\t            decision=trading_signal,\n505\t            confidence=signal.confidence,\n506\t            current_price=current_price,\n507\t            environment=Environment.BACKTEST,\n508\t            trigger_signal_id=db_signal.id if db_signal else None,\n509\t        )\n510\t\n511\t        if order and order.filled_quantity and order.filled_quantity > 0:\n512\t            # Create ActivePosition\n513\t            side = (\n514\t                OrderSide.BUY if trading_signal == TradeSignal.LONG else OrderSide.SELL\n515\t            )\n516\t\n517\t            # Get trade_id from order\n518\t            trade_id = None\n519\t            if order.id:\n520\t                trade = self.db.query(Trade).filter(Trade.order_id == order.id).first()\n521\t                if trade:\n522\t                    trade_id = trade.id\n523\t\n524\t            self.position_monitor.open_position(\n525\t                symbol=asset,\n526\t                side=side,\n527\t                entry_price=signal.entry_price or current_price,\n528\t                stop_loss=signal.stop_loss\n529\t                or (\n530\t                    current_price * 0.98\n531\t                    if side == OrderSide.BUY\n532\t                    else current_price * 1.02\n533\t                ),\n534\t                take_profit=signal.take_profit\n535\t                or (\n536\t                    current_price * 1.03\n537\t                    if side == OrderSide.BUY\n538\t                    else current_price * 0.97\n539\t                ),\n540\t                quantity=order.filled_quantity,\n541\t                exit_policy=signal.exit_policy.value,\n542\t                trade_id=trade_id,\n543\t                signal_id=db_signal.id if db_signal else None,\n544\t                trailing_stop_pct=signal.trailing_stop_pct,\n545\t                max_hold_candles=signal.max_hold_candles,\n546\t            )\n547\t\n548\t            logger.info(\n549\t                f\"Executed {trading_signal.value} for {asset} \"\n550\t                    f\"@ \"\n551\t                f\"${current_price:.2f}, qty: {order.filled_quantity}\"\n552\t            )\n553\t\n554\t    def _parse_decision(self, decision: TradingDecision) -> (TradeSignal, float):\n555\t        \"\"\"Parse decision text to extract LONG/SHORT/HOLD and confidence.\"\"\"\n556\t        decision_upper = decision.decision.upper()\n557\t        signal = TradeSignal.NEUTRAL\n558\t\n559\t        if \"LONG\" in decision_upper or \"BUY\" in decision_upper:\n560\t            signal = TradeSignal.LONG\n561\t        elif \"SHORT\" in decision_upper or \"SELL\" in decision_upper:\n562\t            signal = TradeSignal.SHORT\n563\t        else:\n564\t            signal = TradeSignal.NEUTRAL\n565\t\n566\t        ind = float(decision.confidence)\n567\t\n568\t        return signal, ind\n569\t\n570\t    def _create_signal_from_strategy(\n571\t        self,\n572\t        asset: str,\n573\t        decision: TradeSignal,\n574\t        confidence: float,\n575\t        reasoning: str,\n576\t        current_date: datetime,\n577\t    ) -> Optional[Signal]:\n578\t        \"\"\"Create Signal record from strategy output (simplified).\"\"\"\n579\t        try:\n580\t            signal = Signal(\n581\t                symbol=asset,\n582\t                signal=decision,\n583\t                confidence=confidence,\n584\t                timeframe=self.timeframe,\n585\t                analysis_summary=reasoning,\n586\t                generated_at=current_date,\n587\t                environment=Environment.BACKTEST,\n588\t                model_provider=self.config.get(\"agent_llm_provider\", \"openai\"),\n589\t                model_name=self.config.get(\"agent_llm_model\", \"gpt-4o-mini\"),\n590\t                temperature=self.config.get(\"agent_llm_temperature\", 0.1),\n591\t            )\n592\t\n593\t            self.db.add(signal)\n594\t            self.db.commit()\n595\t            return signal\n596\t\n597\t        except Exception as e:\n598\t            logger.error(f\"Error creating signal: {e}\", exc_info=True)\n599\t            return None\n600\t\n601\t    def _create_signal(\n602\t        self,\n603\t        asset: str,\n604\t        decision: TradeSignal,\n605\t        confidence: float,\n606\t        result: Dict,\n607\t        current_date: datetime,\n608\t        thread_id: Optional[str] = None,\n609\t    ) -> Optional[Signal]:\n610\t        \"\"\"Create and persist Signal record.\"\"\"\n611\t        try:\n612\t            # Extract technical indicators\n613\t            rsi = None\n614\t            macd = None\n615\t            stochastic = None\n616\t            roc = None\n617\t            williams_r = None\n618\t            pattern = None\n619\t            trend = None\n620\t\n621\t            if \"rsi\" in result and result[\"rsi\"]:\n622\t                rsi = (\n623\t                    float(result[\"rsi\"][-1])\n624\t                    if isinstance(result[\"rsi\"], list)\n625\t                    else float(result[\"rsi\"])\n626\t                )\n627\t\n628\t            if \"macd\" in result and result[\"macd\"]:\n629\t                macd = (\n630\t                    float(result[\"macd\"][-1])\n631\t                    if isinstance(result[\"macd\"], list)\n632\t                    else float(result[\"macd\"])\n633\t                )\n634\t\n635\t            indicator_report = result.get(\"indicator_report\")\n636\t            if indicator_report and hasattr(indicator_report, \"rsi\"):\n637\t                rsi = float(indicator_report.rsi)\n638\t            if indicator_report and hasattr(indicator_report, \"macd\"):\n639\t                macd = float(indicator_report.macd)\n640\t            if indicator_report and hasattr(indicator_report, \"stochastic\"):\n641\t                stochastic = float(indicator_report.stochastic)\n642\t            if indicator_report and hasattr(indicator_report, \"roc\"):\n643\t                roc = float(indicator_report.roc)\n644\t            if indicator_report and hasattr(indicator_report, \"willr\"):\n645\t                williams_r = float(indicator_report.willr)\n646\t\n647\t            # Get pattern and trend from reports\n648\t            pattern_report = result.get(\"pattern_report\")\n649\t            if pattern_report and hasattr(pattern_report, \"primary_pattern\"):\n650\t                pattern = pattern_report.primary_pattern\n651\t\n652\t            trend_report = result.get(\"trend_report\")\n653\t            if trend_report and hasattr(trend_report, \"trend_direction\"):\n654\t                trend = trend_report.trend_direction\n655\t\n656\t            # Create signal\n657\t            signal = Signal(\n658\t                symbol=asset,\n659\t                signal=decision,\n660\t                confidence=confidence,\n661\t                timeframe=self.timeframe,\n662\t                rsi=rsi,\n663\t                macd=macd,\n664\t                stochastic=stochastic,\n665\t                roc=roc,\n666\t                williams_r=williams_r,\n667\t                pattern=pattern,\n668\t                trend=trend,\n669\t                analysis_summary=result.get(\"reasoning\", \"\"),\n670\t                generated_at=current_date,\n671\t                environment=Environment.BACKTEST,\n672\t                thread_id=thread_id,\n673\t                model_provider=self.config.get(\"agent_llm_provider\", \"openai\"),\n674\t                model_name=self.config.get(\"agent_llm_model\", \"gpt-4o-mini\"),\n675\t                temperature=self.config.get(\"agent_llm_temperature\", 0.1),\n676\t            )\n677\t\n678\t            self.db.add(signal)\n679\t            self.db.commit()\n680\t\n681\t            return signal\n682\t\n683\t        except Exception as e:\n684\t            logger.error(\n685\t                f\"Error creating signal: {e}\",\n686\t                exc_info=True,\n687\t                extra={\"event_type\": \"backtest_error\"},\n688\t            )\n689\t            return None\n690\t\n691\t    def _record_equity(self, current_date: datetime) -> None:\n692\t        \"\"\"Record equity curve data point.\"\"\"\n693\t        total_value = self.portfolio.get_total_value()\n694\t\n695\t        self.equity_curve.append(\n696\t            {\n697\t                \"date\": current_date,\n698\t                \"equity\": total_value,\n699\t                \"cash\": self.portfolio.cash,\n700\t                \"positions_value\": total_value - self.portfolio.cash,\n701\t            }\n702\t        )\n703\t\n704\t    def _calculate_metrics(self) -> BacktestMetrics:\n705\t        \"\"\"\n706\t        Calculate backtest performance metrics.\n707\t\n708\t        Metrics:\n709\t        - Win rate: % of winning trades\n710\t        - Profit factor: sum(wins) / abs(sum(losses))\n711\t        - Sharpe ratio: (return - risk_free) / volatility\n712\t        - Max drawdown: worst peak-to-trough decline\n713\t        - Total P&L: sum of all trade P&L\n714\t        \"\"\"\n715\t        # Get all trades from database for this backtest\n716\t        trades = (\n717\t            self.db.query(Trade)\n718\t            .filter(\n719\t                Trade.environment == Environment.BACKTEST,\n720\t                Trade.opened_at >= self.start_date,\n721\t                Trade.opened_at <= self.end_date,\n722\t            )\n723\t            .all()\n724\t        )\n725\t\n726\t        if not trades:\n727\t            logger.warning(\n728\t                \"No trades executed during backtest\",\n729\t                extra={\"event_type\": \"backtest_warning\"},\n730\t            )\n731\t\n732\t            # Phase 4: Even with no trades, calculate MDA if positions were opened\n733\t            mda, accuracy_by_candle = self._calculate_directional_accuracy()\n734\t            close_reasons = self._calculate_close_reasons()\n735\t\n736\t            invocations_saved = self.total_candles_processed - self.agent_invocations\n737\t            invocation_reduction_pct = (\n738\t                (invocations_saved / self.total_candles_processed * 100)\n739\t                if self.total_candles_processed > 0\n740\t                else 0.0\n741\t            )\n742\t\n743\t            return BacktestMetrics(\n744\t                total_trades=0,\n745\t                winning_trades=0,\n746\t                losing_trades=0,\n747\t                win_rate=0.0,\n748\t                profit_factor=0.0,\n749\t                sharpe_ratio=0.0,\n750\t                max_drawdown=0.0,\n751\t                total_pnl=0.0,\n752\t                avg_win=0.0,\n753\t                avg_loss=0.0,\n754\t                largest_win=0.0,\n755\t                largest_loss=0.0,\n756\t                total_return_pct=0.0,\n757\t                agent_invocations=self.agent_invocations,\n758\t                invocations_saved=invocations_saved,\n759\t                invocation_reduction_pct=invocation_reduction_pct,\n760\t                mean_directional_accuracy=mda,\n761\t                accuracy_by_candle=accuracy_by_candle,\n762\t                close_reasons=close_reasons,\n763\t            )\n764\t\n765\t        # Calculate basic metrics\n766\t        total_trades = len(trades)\n767\t        winning_trades = [t for t in trades if t.pnl and float(t.pnl) > 0]\n768\t        losing_trades = [t for t in trades if t.pnl and float(t.pnl) < 0]\n769\t\n770\t        total_wins = sum(float(t.pnl) for t in winning_trades)\n771\t        total_losses = abs(sum(float(t.pnl) for t in losing_trades))\n772\t\n773\t        # Win rate\n774\t        win_rate = len(winning_trades) / total_trades if total_trades > 0 else 0.0\n775\t\n776\t        # Profit factor\n777\t        profit_factor = (\n778\t            total_wins / total_losses\n779\t            if total_losses > 0\n780\t            else float(\"inf\") if total_wins > 0 else 0.0\n781\t        )\n782\t\n783\t        # Total P&L\n784\t        total_pnl = sum(float(t.pnl) for t in trades if t.pnl)\n785\t\n786\t        # Average win/loss\n787\t        avg_win = total_wins / len(winning_trades) if winning_trades else 0.0\n788\t        avg_loss = total_losses / len(losing_trades) if losing_trades else 0.0\n789\t\n790\t        # Largest win/loss\n791\t        largest_win = max((float(t.pnl) for t in winning_trades), default=0.0)\n792\t        largest_loss = min((float(t.pnl) for t in losing_trades), default=0.0)\n793\t\n794\t        # Total return %\n795\t        total_return_pct = (\n796\t            (total_pnl / self.initial_capital) * 100\n797\t            if self.initial_capital > 0\n798\t            else 0.0\n799\t        )\n800\t\n801\t        # Sharpe ratio\n802\t        sharpe_ratio = self._calculate_sharpe_ratio()\n803\t\n804\t        # Max drawdown\n805\t        max_drawdown = self._calculate_max_drawdown()\n806\t\n807\t        # Phase 4: Calculate MDA and accuracy metrics\n808\t        mda, accuracy_by_candle = self._calculate_directional_accuracy()\n809\t\n810\t        # Phase 4: Calculate close reasons distribution\n811\t        close_reasons = self._calculate_close_reasons()\n812\t\n813\t        # Phase 4: Calculate invocation reduction\n814\t        invocations_saved = self.total_candles_processed - self.agent_invocations\n815\t        invocation_reduction_pct = (\n816\t            (invocations_saved / self.total_candles_processed * 100)\n817\t            if self.total_candles_processed > 0\n818\t            else 0.0\n819\t        )\n820\t\n821\t        return BacktestMetrics(\n822\t            total_trades=total_trades,\n823\t            winning_trades=len(winning_trades),\n824\t            losing_trades=len(losing_trades),\n825\t            win_rate=win_rate,\n826\t            profit_factor=profit_factor,\n827\t            sharpe_ratio=sharpe_ratio,\n828\t            max_drawdown=max_drawdown,\n829\t            total_pnl=total_pnl,\n830\t            avg_win=avg_win,\n831\t            avg_loss=avg_loss,\n832\t            largest_win=largest_win,\n833\t            largest_loss=largest_loss,\n834\t            total_return_pct=total_return_pct,\n835\t            agent_invocations=self.agent_invocations,\n836\t            invocations_saved=invocations_saved,\n837\t            invocation_reduction_pct=invocation_reduction_pct,\n838\t            mean_directional_accuracy=mda,\n839\t            accuracy_by_candle=accuracy_by_candle,\n840\t            close_reasons=close_reasons,\n841\t        )\n842\t\n843\t    def _calculate_sharpe_ratio(self, risk_free_rate: float = 0.02) -> float:\n844\t        \"\"\"\n845\t        Calculate Sharpe ratio.\n846\t\n847\t        Formula: (return - risk_free) / volatility\n848\t\n849\t        Args:\n850\t            risk_free_rate: Annual risk-free rate (default: 2%)\n851\t\n852\t        Returns:\n853\t            Sharpe ratio\n854\t        \"\"\"\n855\t        if len(self.equity_curve) < 2:\n856\t            return 0.0\n857\t\n858\t        # Calculate returns\n859\t        equity_series = pd.Series([e[\"equity\"] for e in self.equity_curve])\n860\t        returns = equity_series.pct_change().dropna()\n861\t\n862\t        if len(returns) == 0 or returns.std() == 0:\n863\t            return 0.0\n864\t\n865\t        # Annualize based on timeframe\n866\t        periods_per_year = self._get_periods_per_year()\n867\t\n868\t        # Calculate Sharpe\n869\t        excess_return = returns.mean() - (risk_free_rate / periods_per_year)\n870\t        sharpe = (excess_return / returns.std()) * np.sqrt(periods_per_year)\n871\t\n872\t        return float(sharpe)\n873\t\n874\t    def _calculate_max_drawdown(self) -> float:\n875\t        \"\"\"\n876\t        Calculate maximum drawdown.\n877\t\n878\t        Formula: max((peak - trough) / peak)\n879\t\n880\t        Returns:\n881\t            Max drawdown as decimal (e.g., 0.15 = 15%)\n882\t        \"\"\"\n883\t        if len(self.equity_curve) < 2:\n884\t            return 0.0\n885\t\n886\t        equity_series = pd.Series([e[\"equity\"] for e in self.equity_curve])\n887\t\n888\t        # Calculate running maximum\n889\t        running_max = equity_series.expanding().max()\n890\t\n891\t        # Calculate drawdown\n892\t        drawdown = (equity_series - running_max) / running_max\n893\t\n894\t        # Maximum drawdown (most negative)\n895\t        max_dd = abs(drawdown.min())\n896\t\n897\t        return float(max_dd)\n898\t\n899\t    def _calculate_directional_accuracy(self) -> tuple[float, Dict[int, float]]:\n900\t        \"\"\"\n901\t        Calculate Mean Directional Accuracy (MDA) and per-candle accuracy.\n902\t\n903\t        MDA = (correct_candles / total_candles_evaluated)\n904\t\n905\t        Returns:\n906\t            Tuple of (mean_directional_accuracy, accuracy_by_candle)\n907\t        \"\"\"\n908\t        positions = (\n909\t            self.db.query(ActivePosition)\n910\t            .filter(\n911\t                ActivePosition.is_active.is_(False),\n912\t                ActivePosition.decision_timestamp >= self.start_date,\n913\t                ActivePosition.decision_timestamp <= self.end_date,\n914\t            )\n915\t            .all()\n916\t        )\n917\t\n918\t        if not positions:\n919\t            return 0.0, {}\n920\t\n921\t        # Track correct predictions per candle index\n922\t        correct_by_candle = {}\n923\t        total_by_candle = {}\n924\t\n925\t        for pos in positions:\n926\t            expected_direction = \"up\" if pos.side == OrderSide.BUY else \"down\"\n927\t\n928\t            # Evaluate up to prediction_horizon candles\n929\t            for i, direction in enumerate(\n930\t                pos.candles_direction[: pos.prediction_horizon]\n931\t            ):\n932\t                candle_idx = i + 1  # 1-indexed (candle 1, 2, 3...)\n933\t\n934\t                if candle_idx not in correct_by_candle:\n935\t                    correct_by_candle[candle_idx] = 0\n936\t                    total_by_candle[candle_idx] = 0\n937\t\n938\t                total_by_candle[candle_idx] += 1\n939\t                if direction == expected_direction:\n940\t                    correct_by_candle[candle_idx] += 1\n941\t\n942\t        # Calculate accuracy per candle\n943\t        accuracy_by_candle = {\n944\t            candle: correct_by_candle[candle] / total_by_candle[candle]\n945\t            for candle in sorted(total_by_candle.keys())\n946\t        }\n947\t\n948\t        # Calculate overall MDA\n949\t        total_correct = sum(correct_by_candle.values())\n950\t        total_candles = sum(total_by_candle.values())\n951\t        mda = total_correct / total_candles if total_candles > 0 else 0.0\n952\t\n953\t        return mda, accuracy_by_candle\n954\t\n955\t    def _calculate_close_reasons(self) -> Dict[str, int]:\n956\t        \"\"\"\n957\t        Calculate distribution of position close reasons.\n958\t\n959\t        Returns:\n960\t            Dict mapping close_reason to count\n961\t        \"\"\"\n962\t        positions = (\n963\t            self.db.query(ActivePosition)\n964\t            .filter(\n965\t                ActivePosition.is_active.is_(False),\n966\t                ActivePosition.decision_timestamp >= self.start_date,\n967\t                ActivePosition.decision_timestamp <= self.end_date,\n968\t            )\n969\t            .all()\n970\t        )\n971\t\n972\t        close_reasons = {}\n973\t        for pos in positions:\n974\t            reason = pos.close_reason or \"unknown\"\n975\t            close_reasons[reason] = close_reasons.get(reason, 0) + 1\n976\t\n977\t        return close_reasons\n978\t\n979\t    def _get_periods_per_year(self) -> int:\n980\t        \"\"\"Get number of periods per year based on timeframe.\"\"\"\n981\t        if self.timeframe == \"1h\":\n982\t            return 252 * 6.5  # Trading days * hours per day\n983\t        elif self.timeframe == \"4h\":\n984\t            return 252 * 1.625  # Approx 1.6 periods per day\n985\t        elif self.timeframe == \"1d\":\n986\t            return 252\n987\t        elif self.timeframe == \"1w\":\n988\t            return 52\n989\t        else:\n990\t            return 252\n991\t\n992\t    def _update_backtest_run(self, metrics: BacktestMetrics) -> None:\n993\t        \"\"\"Update BacktestRun record with final metrics.\"\"\"\n994\t        if not self.backtest_run_id:\n995\t            return\n996\t\n997\t        run = (\n998\t            self.db.query(BacktestRun)\n999\t            .filter(BacktestRun.id == self.backtest_run_id)\n1000\t            .first()\n1001\t        )\n1002\t\n1003\t        if run:\n1004\t            run.total_trades = metrics.total_trades\n1005\t            run.win_rate = metrics.win_rate\n1006\t            run.profit_factor = metrics.profit_factor\n1007\t            run.sharpe_ratio = metrics.sharpe_ratio\n1008\t            run.max_drawdown = metrics.max_drawdown\n1009\t            run.total_pnl = Decimal(str(metrics.total_pnl))\n1010\t\n1011\t            self.db.commit()\n1012\t            logger.info(\n1013\t                f\"Updated backtest run #{self.backtest_run_id} with final metrics\",\n1014\t                extra={\"event_type\": \"backtest_complete\"},\n1015\t            )\n1016\t\n1017\t    def get_equity_curve(self) -> pd.DataFrame:\n1018\t        \"\"\"\n1019\t        Get equity curve as DataFrame.\n1020\t\n1021\t        Returns:\n1022\t            DataFrame with columns: date, equity, cash, positions_value\n1023\t        \"\"\"\n1024\t        return pd.DataFrame(self.equity_curve)\n1025\t\n1026\t    def __del__(self):\n1027\t        \"\"\"Cleanup database session if we own it.\"\"\"\n1028\t        if self._own_session and self.db:\n1029\t            self.db.close()\n1030\t"}]},"parent_tool_use_id":null,"session_id":"471f3e70-3bc2-4389-b48d-0528a3f6a75b","uuid":"7adce7b9-420b-4d74-909a-135734fc603c","timestamp":"2026-05-10T07:38:13.463Z","tool_use_result":{"type":"text","file":{"filePath":"/mnt/actions-runner/autodev-runtime/worktrees/QuantAgent/QuantAgent-3o8/implementer-20260510T073737Z/quantagent/backtesting/backtest.py","content":"\"\"\"Backtesting engine for strategy validation.\"\"\"\n\nimport logging\nimport logging\nfrom dataclasses import dataclass\nfrom datetime import datetime, timedelta\nfrom decimal import Decimal\nfrom decimal import Decimal\nfrom typing import Dict, List, Optional\n\nimport numpy as np\nimport numpy as np\nimport pandas as pd\nfrom sqlalchemy.orm import Session\n\nfrom quantagent.agent_models import TradingDecision\nfrom quantagent.data.asset_types import AssetType, get_asset_type\nfrom quantagent.data.market_calendar import get_market_calendar\nfrom quantagent.data.provider import DataProvider\nfrom quantagent.database import SessionLocal\nfrom quantagent.models import (ActivePosition, BacktestRun, Environment, Order,\n                               OrderSide, Signal, Trade, TradeSignal)\nfrom quantagent.portfolio.manager import PortfolioManager\nfrom quantagent.database import SessionLocal\nfrom quantagent.models import (BacktestRun, Environment, Order, Signal, Trade,\n                               TradeSignal)\nfrom quantagent.portfolio.manager import PortfolioManager\nfrom quantagent.static_util import format_ohlcv_for_agents\nfrom quantagent.strategy.assembler import StrategyAssembler\nfrom quantagent.strategy.base import TradingStrategy\nfrom quantagent.strategy.llm_agent_strategy import LLMAgentStrategy\nfrom quantagent.trading.order_manager import OrderManager\nfrom quantagent.trading.paper_broker import PaperBroker\nfrom quantagent.trading.position_monitor import PositionMonitor\nfrom quantagent.trading.paper_broker import PaperBroker\nfrom quantagent.trading.position_sizer import PositionSizer\nfrom quantagent.trading.risk_manager import RiskManager\nfrom quantagent.trading_graph import TradingGraph\nfrom quantagent.trading_graph import TradingGraph\n\nlogger = logging.getLogger(__name__)\n\n\n@dataclass\nclass BacktestMetrics:\n    \"\"\"Backtest performance metrics.\"\"\"\n\n    total_trades: int\n    winning_trades: int\n    losing_trades: int\n    win_rate: float\n    profit_factor: float\n    sharpe_ratio: float\n    max_drawdown: float\n    total_pnl: float\n    avg_win: float\n    avg_loss: float\n    largest_win: float\n    largest_loss: float\n    total_return_pct: float\n\n    # Phase 4: Active Position Monitoring metrics\n    agent_invocations: int = 0\n    invocations_saved: int = 0\n    invocation_reduction_pct: float = 0.0\n    mean_directional_accuracy: float = 0.0\n    accuracy_by_candle: Dict[int, float] = None\n    close_reasons: Dict[str, int] = None\n\n    def __post_init__(self):\n        if self.accuracy_by_candle is None:\n            self.accuracy_by_candle = {}\n        if self.close_reasons is None:\n            self.close_reasons = {}\n\n\nclass Backtest:\n    \"\"\"\n    Backtesting engine for validating trading strategies.\n\n    Workflow:\n    1. Loop through historical dates\n    2. Fetch OHLC data for each date using DataProvider (cached)\n    3. Execute analysis using TradingGraph\n    4. Simulate trade execution using OrderManager\n    5. Track portfolio performance\n    6. Calculate and persist metrics\n\n    Features:\n    - Uses DataProvider for 10x faster data access (caching)\n    - Executes same agents as live trading\n    - Stores full provenance (config snapshot, model metadata)\n    - Supports replay with different risk/portfolio profiles\n    \"\"\"\n\n    def __init__(\n        self,\n        start_date: datetime,\n        end_date: datetime,\n        assets: List[str],\n        timeframe: str = \"1h\",\n        initial_capital: float = 100000.0,\n        config: Optional[Dict] = None,\n        db_session: Optional[Session] = None,\n        use_checkpointing: bool = False,\n        strategy: Optional[TradingStrategy] = None,\n    ):\n        \"\"\"\n        Initialize Backtest.\n\n        Args:\n            start_date: Start date for backtest\n            end_date: End date for backtest\n            assets: List of asset symbols (e.g., [\"BTC\", \"SPX\", \"CL\"])\n            timeframe: Timeframe for analysis (e.g., \"1h\", \"4h\", \"1d\")\n            initial_capital: Starting portfolio value\n            config: Configuration dict (portfolio/risk params, model settings)\n            db_session: Database session (creates new if None)\n            use_checkpointing: Enable LangGraph checkpointing for state persistence\n            strategy: Optional TradingStrategy. If None, uses LLMAgentStrategy with TradingGraph\n        \"\"\"\n        self.start_date = start_date\n        self.end_date = end_date\n        self.assets = assets\n        self.timeframe = timeframe\n        self.initial_capital = initial_capital\n        self.config = config or {}\n        self.use_checkpointing = use_checkpointing\n\n        # Database\n        self.db = db_session or SessionLocal()\n        self._own_session = db_session is None\n\n        # Data provider (caching layer)\n        self.data_provider = DataProvider(self.db)\n\n        # Resolve config via StrategyAssembler and build components (unify DB session)\n        resolved = StrategyAssembler.from_snapshot(\n            {\n                \"initial_cash\": initial_capital,\n                \"base_position_pct\": self.config.get(\"base_position_pct\", 0.05),\n                \"max_daily_loss_pct\": self.config.get(\"max_daily_loss_pct\", 0.05),\n                \"max_position_pct\": self.config.get(\"max_position_pct\", 0.10),\n                \"slippage_pct\": self.config.get(\"slippage_pct\", 0.01),\n                # Normalize model fields into generic ones; accept both\n                \"model_provider\": self.config.get(\n                    \"agent_llm_provider\", self.config.get(\"model_provider\", \"openai\")\n                ),\n                \"model_name\": self.config.get(\n                    \"agent_llm_model\", self.config.get(\"model_name\", \"gpt-4o-mini\")\n                ),\n                \"temperature\": self.config.get(\n                    \"agent_llm_temperature\", self.config.get(\"temperature\", 0.1)\n                ),\n                \"use_checkpointing\": use_checkpointing,\n                \"universe\": self.config.get(\"universe\", []),\n            },\n            environment=Environment.BACKTEST,\n        )\n        components = StrategyAssembler.build_components(resolved, db_session=self.db)\n\n        # Trading graph (analysis engine)\n        self.trading_graph = components.graph\n\n        # Trading strategy (use provided or default to LLMAgentStrategy)\n        self.strategy = strategy or LLMAgentStrategy(self.trading_graph)\n\n        # Position monitor for active position tracking\n        self.position_monitor = PositionMonitor(self.db)\n\n        # Trading components\n        self.portfolio = components.portfolio_manager\n        self.position_sizer = components.position_sizer\n        self.risk_manager = components.risk_manager\n        self.broker = components.broker\n        self.order_manager = components.order_manager\n\n        # Backtest state\n        self.current_date = start_date\n        self.backtest_run_id: Optional[int] = None\n        self.trades: List[Trade] = []\n        self.equity_curve: List[Dict] = []\n\n        # Phase 4: Invocation tracking\n        self.agent_invocations = 0\n        self.total_candles_processed = 0\n\n        # Market hours filtering\n        self.market_hours_filter = self.config.get(\"market_hours_filter\", True)\n        self._market_calendar = (\n            get_market_calendar() if self.market_hours_filter else None\n        )\n\n        # Cache asset types for each symbol\n        self._asset_types: Dict[str, AssetType] = {\n            asset: get_asset_type(asset) for asset in assets\n        }\n\n    def run(self, name: Optional[str] = None) -> BacktestMetrics:\n        \"\"\"\n        Run backtest and return metrics.\n\n        Args:\n            name: Optional name for this backtest run\n\n        Returns:\n            BacktestMetrics with performance statistics\n        \"\"\"\n        logger.info(\n            f\"Starting backtest: {self.start_date} to {self.end_date}\",\n            extra={\"event_type\": \"backtest_start\", \"environment\": \"backtest\"},\n        )\n        logger.info(\n            f\"Assets: {self.assets}, Timeframe: {self.timeframe}\",\n            extra={\"event_type\": \"backtest_start\"},\n        )\n        logger.info(\n            f\"Initial capital: ${self.initial_capital:,.2f}\",\n            extra={\"event_type\": \"backtest_start\"},\n        )\n        logger.info(\n            f\"Market hours filter: {self.market_hours_filter}\",\n            extra={\"event_type\": \"backtest_start\"},\n        )\n\n        # Create backtest run record\n        self._create_backtest_run(name)\n\n        # Process each asset with its filtered date range\n        total_periods = 0\n        for asset in self.assets:\n            asset_dates = self._get_date_range_for_asset(asset)\n            total_periods += len(asset_dates)\n\n            asset_type = self._asset_types.get(asset, AssetType.UNKNOWN)\n            logger.info(\n                f\"Asset {asset} ({asset_type.value}): {len(asset_dates)} analysis periods\",\n                extra={\"event_type\": \"backtest_start\"},\n            )\n\n        logger.info(\n            f\"Backtesting {total_periods} total analysis periods\",\n            extra={\"event_type\": \"backtest_start\"},\n        )\n\n        # Track progress across all periods\n        periods_completed = 0\n\n        # Loop through assets (outer) and their dates (inner)\n        for asset in self.assets:\n            asset_dates = self._get_date_range_for_asset(asset)\n\n            for i, current_date in enumerate(asset_dates):\n                self.current_date = current_date\n\n                # Reset daily P&L tracking at start of each day\n                if i == 0 or current_date.date() != asset_dates[i - 1].date():\n                    self.risk_manager.reset_daily_tracker()\n\n                try:\n                    self._analyze_and_trade(asset, current_date)\n                except Exception as e:\n                    logger.error(\n                        f\"Error analyzing {asset} at {current_date}: {e}\",\n                       \n                        exc_info=True,\n                        extra={\"event_type\": \"backtest_error\", \"symbol\": asset},\n                    )\n                    continue\n\n                # Record equity at end of period\n                self._record_equity(current_date)\n\n\n                periods_completed += 1\n\n                # Log progress\n                if periods_completed % 100 == 0 or periods_completed == total_periods:\n                    progress = (periods_completed / total_periods) * 100\n                    logger.info(\n                        f\"Progress: {progress:.1f}% ({periods_completed}/{total_periods})\",\n                        extra={\"event_type\": \"backtest_progress\"},\n                    )\n\n        # Calculate metrics\n        metrics = self._calculate_metrics()\n\n        # Update backtest run with results\n        self._update_backtest_run(metrics)\n\n        logger.info(\n            f\"Backtest complete: {metrics.total_trades} trades, Win rate: {metrics.win_rate:.2%}\",\n            extra={\"event_type\": \"backtest_end\", \"environment\": \"backtest\"},\n        )\n        logger.info(\n            f\"Total P&L: ${metrics.total_pnl:,.2f} ({metrics.total_return_pct:.2%})\",\n            extra={\"event_type\": \"backtest_end\"},\n        )\n\n        return metrics\n\n    def _create_backtest_run(self, name: Optional[str]) -> None:\n        \"\"\"Create BacktestRun record in database.\"\"\"\n        run = BacktestRun(\n            name=name or f\"Backtest_{datetime.now().strftime('%Y%m%d_%H%M%S')}\",\n            timeframe=self.timeframe,\n            assets=self.assets,\n            start_date=self.start_date,\n            end_date=self.end_date,\n            config_snapshot=self._build_config_snapshot(),\n        )\n\n        self.db.add(run)\n        self.db.commit()\n        self.backtest_run_id = run.id\n\n        logger.info(\n            f\"Created backtest run #{self.backtest_run_id}: {run.name}\",\n            extra={\"event_type\": \"backtest_init\"},\n        )\n\n    def _build_config_snapshot(self) -> Dict:\n        \"\"\"Build immutable config snapshot for reproducibility.\"\"\"\n        # Re-generate snapshot via assembler to keep alignment\n        resolved = StrategyAssembler.from_snapshot(\n            {\n                \"initial_cash\": self.initial_capital,\n                \"base_position_pct\": self.config.get(\"base_position_pct\", 0.05),\n                \"max_daily_loss_pct\": self.config.get(\"max_daily_loss_pct\", 0.05),\n                \"max_position_pct\": self.config.get(\"max_position_pct\", 0.10),\n                \"slippage_pct\": self.config.get(\"slippage_pct\", 0.01),\n                \"model_provider\": self.config.get(\n                    \"agent_llm_provider\", self.config.get(\"model_provider\", \"openai\")\n                ),\n                \"model_name\": self.config.get(\n                    \"agent_llm_model\", self.config.get(\"model_name\", \"gpt-4o-mini\")\n                ),\n                \"temperature\": self.config.get(\n                    \"agent_llm_temperature\", self.config.get(\"temperature\", 0.1)\n                ),\n                \"use_checkpointing\": self.use_checkpointing,\n                \"universe\": self.config.get(\"universe\", []),\n            },\n            environment=Environment.BACKTEST,\n        )\n        return StrategyAssembler.config_snapshot(resolved)\n\n    def _get_date_range(self) -> List[datetime]:\n        \"\"\"\n        Get list of dates to backtest.\n\n        For hourly/intraday: every N hours\n        For daily: every day\n        \"\"\"\n        dates = []\n        current = self.start_date\n\n        # Determine step size based on timeframe\n        if self.timeframe in [\"1h\", \"4h\"]:\n            step_hours = int(self.timeframe.replace(\"h\", \"\"))\n            step = timedelta(hours=step_hours)\n        elif self.timeframe == \"1d\":\n            step = timedelta(days=1)\n        elif self.timeframe == \"1w\":\n            step = timedelta(weeks=1)\n        else:\n            # Default to hourly\n            step = timedelta(hours=1)\n\n        while current <= self.end_date:\n            dates.append(current)\n            current += step\n\n        return dates\n\n    def _get_date_range_for_asset(self, asset: str) -> List[datetime]:\n        \"\"\"\n        Get date range filtered by market hours for specific asset.\n\n        Args:\n            asset: Asset symbol\n\n        Returns:\n            List of valid trading timestamps for this asset\n        \"\"\"\n        all_dates = self._get_date_range()\n\n        if not self.market_hours_filter or self._market_calendar is None:\n            return all_dates\n\n        asset_type = self._asset_types.get(asset, AssetType.UNKNOWN)\n\n        return self._market_calendar.filter_to_trading_hours(all_dates, asset_type)\n\n    def _analyze_and_trade(self, asset: str, current_date: datetime) -> None:\n        \"\"\"\n        Execute analysis and trade for a single asset at a given time.\n\n        NEW FLOW (Hybrid Model with PositionMonitor):\n        1. Check for active position\n        2. If active: strategy.should_exit() → close or update tracking (NO invoke)\n        3. If not active: strategy.generate_signal() → open position if signal != HOLD\n\n        Args:\n            asset: Asset symbol\n            current_date: Current backtest date\n        \"\"\"\n        # Get historical data for analysis (need lookback period)\n        lookback_days = 30\n        data_start = current_date - timedelta(days=lookback_days)\n\n        df = self.data_provider.get_ohlc(\n            symbol=asset,\n            timeframe=self.timeframe,\n            start_date=data_start,\n            end_date=current_date,\n        )\n\n        if df.empty or len(df) < 30:\n            logger.warning(\n                f\"Insufficient data for {asset} at {current_date} (got {len(df)} records)\",\n                extra={\"event_type\": \"backtest_data_warning\", \"symbol\": asset},\n            )\n            return\n\n        current_price = float(df.iloc[-1][\"close\"])\n\n        # Check for active position\n        active_pos = self.position_monitor.get_active_position(asset)\n\n        # Phase 4: Count total candles processed\n        self.total_candles_processed += 1\n\n        if active_pos:\n            # Position active: check exit conditions via strategy\n            should_exit, reason = self.strategy.should_exit(\n                active_pos, current_price, df\n            )\n\n            if should_exit:\n                # Close position\n                self.position_monitor.close_position(active_pos, reason, current_price)\n\n                # Execute close via OrderManager\n                if active_pos.trade_id:\n                    self.order_manager.close_trade(\n                        active_pos.trade_id,\n                        current_price,\n                        environment=Environment.BACKTEST,\n                    )\n                    logger.info(\n                        f\"{asset}: Closed position - {reason} @ ${current_price:.2f}\"\n                    )\n                # Continue to potentially open new position below\n            else:\n                # Position still active: update tracking only (NO INVOKE)\n                prev_close = (\n                    float(df.iloc[-2][\"close\"]) if len(df) >= 2 else current_price\n                )\n                self.position_monitor.update_candle_tracking(\n                    active_pos, current_price, prev_close\n                )\n                return  # Early return - invocation saved\n\n        # No active position (or just closed): generate signal\n        kline_data = format_ohlcv_for_agents(df)\n\n        # Phase 4: Count agent invocations\n        self.agent_invocations += 1\n\n        # Generate thread_id for checkpointing (if enabled)\n        thread_id = None\n        if self.use_checkpointing:\n            from quantagent.strategy.assembler import StrategyAssembler\n\n            thread_id = StrategyAssembler.make_thread_id(\n                self.backtest_run_id, asset, current_date\n            )\n\n        signal = self.strategy.generate_signal(\n            kline_data, asset, self.timeframe, current_price, thread_id=thread_id\n        )\n\n        if signal is None or signal.decision == \"HOLD\":\n            return\n\n        # Execute trade\n        trading_signal = (\n            TradeSignal.LONG if signal.decision == \"LONG\" else TradeSignal.SHORT\n        )\n\n        # Store signal in database\n        db_signal = self._create_signal_from_strategy(\n            asset=asset,\n            decision=trading_signal,\n            confidence=signal.confidence,\n            reasoning=signal.reasoning,\n            current_date=current_date,\n        )\n\n        # Execute order\n        order = self.order_manager.execute_decision(\n            symbol=asset,\n            decision=trading_signal,\n            confidence=signal.confidence,\n            current_price=current_price,\n            environment=Environment.BACKTEST,\n            trigger_signal_id=db_signal.id if db_signal else None,\n        )\n\n        if order and order.filled_quantity and order.filled_quantity > 0:\n            # Create ActivePosition\n            side = (\n                OrderSide.BUY if trading_signal == TradeSignal.LONG else OrderSide.SELL\n            )\n\n            # Get trade_id from order\n            trade_id = None\n            if order.id:\n                trade = self.db.query(Trade).filter(Trade.order_id == order.id).first()\n                if trade:\n                    trade_id = trade.id\n\n            self.position_monitor.open_position(\n                symbol=asset,\n                side=side,\n                entry_price=signal.entry_price or current_price,\n                stop_loss=signal.stop_loss\n                or (\n                    current_price * 0.98\n                    if side == OrderSide.BUY\n                    else current_price * 1.02\n                ),\n                take_profit=signal.take_profit\n                or (\n                    current_price * 1.03\n                    if side == OrderSide.BUY\n                    else current_price * 0.97\n                ),\n                quantity=order.filled_quantity,\n                exit_policy=signal.exit_policy.value,\n                trade_id=trade_id,\n                signal_id=db_signal.id if db_signal else None,\n                trailing_stop_pct=signal.trailing_stop_pct,\n                max_hold_candles=signal.max_hold_candles,\n            )\n\n            logger.info(\n                f\"Executed {trading_signal.value} for {asset} \"\n                    f\"@ \"\n                f\"${current_price:.2f}, qty: {order.filled_quantity}\"\n            )\n\n    def _parse_decision(self, decision: TradingDecision) -> (TradeSignal, float):\n        \"\"\"Parse decision text to extract LONG/SHORT/HOLD and confidence.\"\"\"\n        decision_upper = decision.decision.upper()\n        signal = TradeSignal.NEUTRAL\n\n        if \"LONG\" in decision_upper or \"BUY\" in decision_upper:\n            signal = TradeSignal.LONG\n        elif \"SHORT\" in decision_upper or \"SELL\" in decision_upper:\n            signal = TradeSignal.SHORT\n        else:\n            signal = TradeSignal.NEUTRAL\n\n        ind = float(decision.confidence)\n\n        return signal, ind\n\n    def _create_signal_from_strategy(\n        self,\n        asset: str,\n        decision: TradeSignal,\n        confidence: float,\n        reasoning: str,\n        current_date: datetime,\n    ) -> Optional[Signal]:\n        \"\"\"Create Signal record from strategy output (simplified).\"\"\"\n        try:\n            signal = Signal(\n                symbol=asset,\n                signal=decision,\n                confidence=confidence,\n                timeframe=self.timeframe,\n                analysis_summary=reasoning,\n                generated_at=current_date,\n                environment=Environment.BACKTEST,\n                model_provider=self.config.get(\"agent_llm_provider\", \"openai\"),\n                model_name=self.config.get(\"agent_llm_model\", \"gpt-4o-mini\"),\n                temperature=self.config.get(\"agent_llm_temperature\", 0.1),\n            )\n\n            self.db.add(signal)\n            self.db.commit()\n            return signal\n\n        except Exception as e:\n            logger.error(f\"Error creating signal: {e}\", exc_info=True)\n            return None\n\n    def _create_signal(\n        self,\n        asset: str,\n        decision: TradeSignal,\n        confidence: float,\n        result: Dict,\n        current_date: datetime,\n        thread_id: Optional[str] = None,\n    ) -> Optional[Signal]:\n        \"\"\"Create and persist Signal record.\"\"\"\n        try:\n            # Extract technical indicators\n            rsi = None\n            macd = None\n            stochastic = None\n            roc = None\n            williams_r = None\n            pattern = None\n            trend = None\n\n            if \"rsi\" in result and result[\"rsi\"]:\n                rsi = (\n                    float(result[\"rsi\"][-1])\n                    if isinstance(result[\"rsi\"], list)\n                    else float(result[\"rsi\"])\n                )\n\n            if \"macd\" in result and result[\"macd\"]:\n                macd = (\n                    float(result[\"macd\"][-1])\n                    if isinstance(result[\"macd\"], list)\n                    else float(result[\"macd\"])\n                )\n\n            indicator_report = result.get(\"indicator_report\")\n            if indicator_report and hasattr(indicator_report, \"rsi\"):\n                rsi = float(indicator_report.rsi)\n            if indicator_report and hasattr(indicator_report, \"macd\"):\n                macd = float(indicator_report.macd)\n            if indicator_report and hasattr(indicator_report, \"stochastic\"):\n                stochastic = float(indicator_report.stochastic)\n            if indicator_report and hasattr(indicator_report, \"roc\"):\n                roc = float(indicator_report.roc)\n            if indicator_report and hasattr(indicator_report, \"willr\"):\n                williams_r = float(indicator_report.willr)\n\n            # Get pattern and trend from reports\n            pattern_report = result.get(\"pattern_report\")\n            if pattern_report and hasattr(pattern_report, \"primary_pattern\"):\n                pattern = pattern_report.primary_pattern\n\n            trend_report = result.get(\"trend_report\")\n            if trend_report and hasattr(trend_report, \"trend_direction\"):\n                trend = trend_report.trend_direction\n\n            # Create signal\n            signal = Signal(\n                symbol=asset,\n                signal=decision,\n                confidence=confidence,\n                timeframe=self.timeframe,\n                rsi=rsi,\n                macd=macd,\n                stochastic=stochastic,\n                roc=roc,\n                williams_r=williams_r,\n                pattern=pattern,\n                trend=trend,\n                analysis_summary=result.get(\"reasoning\", \"\"),\n                generated_at=current_date,\n                environment=Environment.BACKTEST,\n                thread_id=thread_id,\n                model_provider=self.config.get(\"agent_llm_provider\", \"openai\"),\n                model_name=self.config.get(\"agent_llm_model\", \"gpt-4o-mini\"),\n                temperature=self.config.get(\"agent_llm_temperature\", 0.1),\n            )\n\n            self.db.add(signal)\n            self.db.commit()\n\n            return signal\n\n        except Exception as e:\n            logger.error(\n                f\"Error creating signal: {e}\",\n                exc_info=True,\n                extra={\"event_type\": \"backtest_error\"},\n            )\n            return None\n\n    def _record_equity(self, current_date: datetime) -> None:\n        \"\"\"Record equity curve data point.\"\"\"\n        total_value = self.portfolio.get_total_value()\n\n        self.equity_curve.append(\n            {\n                \"date\": current_date,\n                \"equity\": total_value,\n                \"cash\": self.portfolio.cash,\n                \"positions_value\": total_value - self.portfolio.cash,\n            }\n        )\n\n    def _calculate_metrics(self) -> BacktestMetrics:\n        \"\"\"\n        Calculate backtest performance metrics.\n\n        Metrics:\n        - Win rate: % of winning trades\n        - Profit factor: sum(wins) / abs(sum(losses))\n        - Sharpe ratio: (return - risk_free) / volatility\n        - Max drawdown: worst peak-to-trough decline\n        - Total P&L: sum of all trade P&L\n        \"\"\"\n        # Get all trades from database for this backtest\n        trades = (\n            self.db.query(Trade)\n            .filter(\n                Trade.environment == Environment.BACKTEST,\n                Trade.opened_at >= self.start_date,\n                Trade.opened_at <= self.end_date,\n            )\n            .all()\n        )\n\n        if not trades:\n            logger.warning(\n                \"No trades executed during backtest\",\n                extra={\"event_type\": \"backtest_warning\"},\n            )\n\n            # Phase 4: Even with no trades, calculate MDA if positions were opened\n            mda, accuracy_by_candle = self._calculate_directional_accuracy()\n            close_reasons = self._calculate_close_reasons()\n\n            invocations_saved = self.total_candles_processed - self.agent_invocations\n            invocation_reduction_pct = (\n                (invocations_saved / self.total_candles_processed * 100)\n                if self.total_candles_processed > 0\n                else 0.0\n            )\n\n            return BacktestMetrics(\n                total_trades=0,\n                winning_trades=0,\n                losing_trades=0,\n                win_rate=0.0,\n                profit_factor=0.0,\n                sharpe_ratio=0.0,\n                max_drawdown=0.0,\n                total_pnl=0.0,\n                avg_win=0.0,\n                avg_loss=0.0,\n                largest_win=0.0,\n                largest_loss=0.0,\n                total_return_pct=0.0,\n                agent_invocations=self.agent_invocations,\n                invocations_saved=invocations_saved,\n                invocation_reduction_pct=invocation_reduction_pct,\n                mean_directional_accuracy=mda,\n                accuracy_by_candle=accuracy_by_candle,\n                close_reasons=close_reasons,\n            )\n\n        # Calculate basic metrics\n        total_trades = len(trades)\n        winning_trades = [t for t in trades if t.pnl and float(t.pnl) > 0]\n        losing_trades = [t for t in trades if t.pnl and float(t.pnl) < 0]\n\n        total_wins = sum(float(t.pnl) for t in winning_trades)\n        total_losses = abs(sum(float(t.pnl) for t in losing_trades))\n\n        # Win rate\n        win_rate = len(winning_trades) / total_trades if total_trades > 0 else 0.0\n\n        # Profit factor\n        profit_factor = (\n            total_wins / total_losses\n            if total_losses > 0\n            else float(\"inf\") if total_wins > 0 else 0.0\n        )\n\n        # Total P&L\n        total_pnl = sum(float(t.pnl) for t in trades if t.pnl)\n\n        # Average win/loss\n        avg_win = total_wins / len(winning_trades) if winning_trades else 0.0\n        avg_loss = total_losses / len(losing_trades) if losing_trades else 0.0\n\n        # Largest win/loss\n        largest_win = max((float(t.pnl) for t in winning_trades), default=0.0)\n        largest_loss = min((float(t.pnl) for t in losing_trades), default=0.0)\n\n        # Total return %\n        total_return_pct = (\n            (total_pnl / self.initial_capital) * 100\n            if self.initial_capital > 0\n            else 0.0\n        )\n\n        # Sharpe ratio\n        sharpe_ratio = self._calculate_sharpe_ratio()\n\n        # Max drawdown\n        max_drawdown = self._calculate_max_drawdown()\n\n        # Phase 4: Calculate MDA and accuracy metrics\n        mda, accuracy_by_candle = self._calculate_directional_accuracy()\n\n        # Phase 4: Calculate close reasons distribution\n        close_reasons = self._calculate_close_reasons()\n\n        # Phase 4: Calculate invocation reduction\n        invocations_saved = self.total_candles_processed - self.agent_invocations\n        invocation_reduction_pct = (\n            (invocations_saved / self.total_candles_processed * 100)\n            if self.total_candles_processed > 0\n            else 0.0\n        )\n\n        return BacktestMetrics(\n            total_trades=total_trades,\n            winning_trades=len(winning_trades),\n            losing_trades=len(losing_trades),\n            win_rate=win_rate,\n            profit_factor=profit_factor,\n            sharpe_ratio=sharpe_ratio,\n            max_drawdown=max_drawdown,\n            total_pnl=total_pnl,\n            avg_win=avg_win,\n            avg_loss=avg_loss,\n            largest_win=largest_win,\n            largest_loss=largest_loss,\n            total_return_pct=total_return_pct,\n            agent_invocations=self.agent_invocations,\n            invocations_saved=invocations_saved,\n            invocation_reduction_pct=invocation_reduction_pct,\n            mean_directional_accuracy=mda,\n            accuracy_by_candle=accuracy_by_candle,\n            close_reasons=close_reasons,\n        )\n\n    def _calculate_sharpe_ratio(self, risk_free_rate: float = 0.02) -> float:\n        \"\"\"\n        Calculate Sharpe ratio.\n\n        Formula: (return - risk_free) / volatility\n\n        Args:\n            risk_free_rate: Annual risk-free rate (default: 2%)\n\n        Returns:\n            Sharpe ratio\n        \"\"\"\n        if len(self.equity_curve) < 2:\n            return 0.0\n\n        # Calculate returns\n        equity_series = pd.Series([e[\"equity\"] for e in self.equity_curve])\n        returns = equity_series.pct_change().dropna()\n\n        if len(returns) == 0 or returns.std() == 0:\n            return 0.0\n\n        # Annualize based on timeframe\n        periods_per_year = self._get_periods_per_year()\n\n        # Calculate Sharpe\n        excess_return = returns.mean() - (risk_free_rate / periods_per_year)\n        sharpe = (excess_return / returns.std()) * np.sqrt(periods_per_year)\n\n        return float(sharpe)\n\n    def _calculate_max_drawdown(self) -> float:\n        \"\"\"\n        Calculate maximum drawdown.\n\n        Formula: max((peak - trough) / peak)\n\n        Returns:\n            Max drawdown as decimal (e.g., 0.15 = 15%)\n        \"\"\"\n        if len(self.equity_curve) < 2:\n            return 0.0\n\n        equity_series = pd.Series([e[\"equity\"] for e in self.equity_curve])\n\n        # Calculate running maximum\n        running_max = equity_series.expanding().max()\n\n        # Calculate drawdown\n        drawdown = (equity_series - running_max) / running_max\n\n        # Maximum drawdown (most negative)\n        max_dd = abs(drawdown.min())\n\n        return float(max_dd)\n\n    def _calculate_directional_accuracy(self) -> tuple[float, Dict[int, float]]:\n        \"\"\"\n        Calculate Mean Directional Accuracy (MDA) and per-candle accuracy.\n\n        MDA = (correct_candles / total_candles_evaluated)\n\n        Returns:\n            Tuple of (mean_directional_accuracy, accuracy_by_candle)\n        \"\"\"\n        positions = (\n            self.db.query(ActivePosition)\n            .filter(\n                ActivePosition.is_active.is_(False),\n                ActivePosition.decision_timestamp >= self.start_date,\n                ActivePosition.decision_timestamp <= self.end_date,\n            )\n            .all()\n        )\n\n        if not positions:\n            return 0.0, {}\n\n        # Track correct predictions per candle index\n        correct_by_candle = {}\n        total_by_candle = {}\n\n        for pos in positions:\n            expected_direction = \"up\" if pos.side == OrderSide.BUY else \"down\"\n\n            # Evaluate up to prediction_horizon candles\n            for i, direction in enumerate(\n                pos.candles_direction[: pos.prediction_horizon]\n            ):\n                candle_idx = i + 1  # 1-indexed (candle 1, 2, 3...)\n\n                if candle_idx not in correct_by_candle:\n                    correct_by_candle[candle_idx] = 0\n                    total_by_candle[candle_idx] = 0\n\n                total_by_candle[candle_idx] += 1\n                if direction == expected_direction:\n                    correct_by_candle[candle_idx] += 1\n\n        # Calculate accuracy per candle\n        accuracy_by_candle = {\n            candle: correct_by_candle[candle] / total_by_candle[candle]\n            for candle in sorted(total_by_candle.keys())\n        }\n\n        # Calculate overall MDA\n        total_correct = sum(correct_by_candle.values())\n        total_candles = sum(total_by_candle.values())\n        mda = total_correct / total_candles if total_candles > 0 else 0.0\n\n        return mda, accuracy_by_candle\n\n    def _calculate_close_reasons(self) -> Dict[str, int]:\n        \"\"\"\n        Calculate distribution of position close reasons.\n\n        Returns:\n            Dict mapping close_reason to count\n        \"\"\"\n        positions = (\n            self.db.query(ActivePosition)\n            .filter(\n                ActivePosition.is_active.is_(False),\n                ActivePosition.decision_timestamp >= self.start_date,\n                ActivePosition.decision_timestamp <= self.end_date,\n            )\n            .all()\n        )\n\n        close_reasons = {}\n        for pos in positions:\n            reason = pos.close_reason or \"unknown\"\n            close_reasons[reason] = close_reasons.get(reason, 0) + 1\n\n        return close_reasons\n\n    def _get_periods_per_year(self) -> int:\n        \"\"\"Get number of periods per year based on timeframe.\"\"\"\n        if self.timeframe == \"1h\":\n            return 252 * 6.5  # Trading days * hours per day\n        elif self.timeframe == \"4h\":\n            return 252 * 1.625  # Approx 1.6 periods per day\n        elif self.timeframe == \"1d\":\n            return 252\n        elif self.timeframe == \"1w\":\n            return 52\n        else:\n            return 252\n\n    def _update_backtest_run(self, metrics: BacktestMetrics) -> None:\n        \"\"\"Update BacktestRun record with final metrics.\"\"\"\n        if not self.backtest_run_id:\n            return\n\n        run = (\n            self.db.query(BacktestRun)\n            .filter(BacktestRun.id == self.backtest_run_id)\n            .first()\n        )\n\n        if run:\n            run.total_trades = metrics.total_trades\n            run.win_rate = metrics.win_rate\n            run.profit_factor = metrics.profit_factor\n            run.sharpe_ratio = metrics.sharpe_ratio\n            run.max_drawdown = metrics.max_drawdown\n            run.total_pnl = Decimal(str(metrics.total_pnl))\n\n            self.db.commit()\n            logger.info(\n                f\"Updated backtest run #{self.backtest_run_id} with final metrics\",\n                extra={\"event_type\": \"backtest_complete\"},\n            )\n\n    def get_equity_curve(self) -> pd.DataFrame:\n        \"\"\"\n        Get equity curve as DataFrame.\n\n        Returns:\n            DataFrame with columns: date, equity, cash, positions_value\n        \"\"\"\n        return pd.DataFrame(self.equity_curve)\n\n    def __del__(self):\n        \"\"\"Cleanup database session if we own it.\"\"\"\n        if self._own_session and self.db:\n            self.db.close()\n","numLines":1030,"startLine":1,"totalLines":1030}}}
