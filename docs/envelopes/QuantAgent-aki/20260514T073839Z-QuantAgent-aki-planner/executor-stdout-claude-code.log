{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0125hnjXvMGTbxTR5XK1fioD","type":"tool_result","content":"1\t\"\"\"TradingScheduler orchestrates periodic analysis + paper trading.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\timport logging\n6\tfrom datetime import datetime, timedelta\n7\tfrom typing import Callable, Dict, Optional\n8\t\n9\timport pandas as pd\n10\tfrom apscheduler.schedulers.background import BackgroundScheduler\n11\tfrom apscheduler.triggers.interval import IntervalTrigger\n12\tfrom sqlalchemy.orm import Session\n13\t\n14\tfrom quantagent import settings\n15\tfrom quantagent.data.provider import DataProvider\n16\tfrom quantagent.models import Environment, SchedulerHeartbeat, Signal, Trade, TradeSignal\n17\tfrom quantagent.static_util import format_ohlcv_for_agents\n18\tfrom quantagent.strategy.base import TradingSignal as StrategyTradingSignal\n19\tfrom quantagent.strategy.llm_agent_strategy import LLMAgentStrategy\n20\tfrom quantagent.trading.order_manager import OrderManager\n21\tfrom quantagent.trading.position_monitor import PositionMonitor\n22\tfrom quantagent.trading_graph import TradingGraph\n23\t\n24\tlogger = logging.getLogger(__name__)\n25\t\n26\t\n27\tclass SchedulerError(Exception):\n28\t    \"\"\"Base class for scheduler errors.\"\"\"\n29\t\n30\t\n31\tclass DataFetchError(SchedulerError):\n32\t    \"\"\"Raised when market data cannot be retrieved.\"\"\"\n33\t\n34\t\n35\tclass AnalysisError(SchedulerError):\n36\t    \"\"\"Raised when the analysis pipeline fails.\"\"\"\n37\t\n38\t\n39\tclass ExecutionError(SchedulerError):\n40\t    \"\"\"Raised when trade execution fails.\"\"\"\n41\t\n42\t\n43\tclass TradingScheduler:\n44\t    \"\"\"Run TradingGraph analysis and order execution on an interval.\"\"\"\n45\t\n46\t    JOB_ID = \"trading_scheduler_job\"\n47\t\n48\t    def __init__(\n49\t        self,\n50\t        *,\n51\t        trading_graph: TradingGraph,\n52\t        order_manager: OrderManager,\n53\t        data_provider: DataProvider,\n54\t        db_session: Session,\n55\t        scheduler_settings: Optional[settings.SchedulerSettings] = None,\n56\t        scheduler_factory: Optional[Callable[[], BackgroundScheduler]] = None,\n57\t        strategy: Optional[LLMAgentStrategy] = None,\n58\t    ) -> None:\n59\t        self.trading_graph = trading_graph\n60\t        self.order_manager = order_manager\n61\t        self.data_provider = data_provider\n62\t        self.db = db_session\n63\t        self.config = scheduler_settings or settings.scheduler\n64\t        self.environment = Environment(self.config.environment)\n65\t        self.strategy = strategy or LLMAgentStrategy(self.trading_graph)\n66\t\n67\t        # Initialize PositionMonitor for tracking active positions\n68\t        self.position_monitor = PositionMonitor(\n69\t            db_session=db_session,\n70\t            backtest_run_id=None,  # Paper trading doesn't use backtest_run_id\n71\t            environment=self.environment,\n72\t        )\n73\t\n74\t        self.scheduler = (\n75\t            scheduler_factory()\n76\t            if scheduler_factory is not None\n77\t            else BackgroundScheduler(\n78\t                job_defaults={\"coalesce\": True, \"max_instances\": 1}, timezone=\"UTC\"\n79\t            )\n80\t        )"}]},"parent_tool_use_id":null,"session_id":"e2e7c456-35f5-44fa-bc39-3f5f6a9f15ef","uuid":"90865f5d-7fa9-4d5c-98cc-e164823af78b","timestamp":"2026-05-14T07:39:01.683Z","tool_use_result":{"type":"text","file":{"filePath":"/home/azureuser/repos/projects/QuantAgent/quantagent/trading/scheduler.py","content":"\"\"\"TradingScheduler orchestrates periodic analysis + paper trading.\"\"\"\n\nfrom __future__ import annotations\n\nimport logging\nfrom datetime import datetime, timedelta\nfrom typing import Callable, Dict, Optional\n\nimport pandas as pd\nfrom apscheduler.schedulers.background import BackgroundScheduler\nfrom apscheduler.triggers.interval import IntervalTrigger\nfrom sqlalchemy.orm import Session\n\nfrom quantagent import settings\nfrom quantagent.data.provider import DataProvider\nfrom quantagent.models import Environment, SchedulerHeartbeat, Signal, Trade, TradeSignal\nfrom quantagent.static_util import format_ohlcv_for_agents\nfrom quantagent.strategy.base import TradingSignal as StrategyTradingSignal\nfrom quantagent.strategy.llm_agent_strategy import LLMAgentStrategy\nfrom quantagent.trading.order_manager import OrderManager\nfrom quantagent.trading.position_monitor import PositionMonitor\nfrom quantagent.trading_graph import TradingGraph\n\nlogger = logging.getLogger(__name__)\n\n\nclass SchedulerError(Exception):\n    \"\"\"Base class for scheduler errors.\"\"\"\n\n\nclass DataFetchError(SchedulerError):\n    \"\"\"Raised when market data cannot be retrieved.\"\"\"\n\n\nclass AnalysisError(SchedulerError):\n    \"\"\"Raised when the analysis pipeline fails.\"\"\"\n\n\nclass ExecutionError(SchedulerError):\n    \"\"\"Raised when trade execution fails.\"\"\"\n\n\nclass TradingScheduler:\n    \"\"\"Run TradingGraph analysis and order execution on an interval.\"\"\"\n\n    JOB_ID = \"trading_scheduler_job\"\n\n    def __init__(\n        self,\n        *,\n        trading_graph: TradingGraph,\n        order_manager: OrderManager,\n        data_provider: DataProvider,\n        db_session: Session,\n        scheduler_settings: Optional[settings.SchedulerSettings] = None,\n        scheduler_factory: Optional[Callable[[], BackgroundScheduler]] = None,\n        strategy: Optional[LLMAgentStrategy] = None,\n    ) -> None:\n        self.trading_graph = trading_graph\n        self.order_manager = order_manager\n        self.data_provider = data_provider\n        self.db = db_session\n        self.config = scheduler_settings or settings.scheduler\n        self.environment = Environment(self.config.environment)\n        self.strategy = strategy or LLMAgentStrategy(self.trading_graph)\n\n        # Initialize PositionMonitor for tracking active positions\n        self.position_monitor = PositionMonitor(\n            db_session=db_session,\n            backtest_run_id=None,  # Paper trading doesn't use backtest_run_id\n            environment=self.environment,\n        )\n\n        self.scheduler = (\n            scheduler_factory()\n            if scheduler_factory is not None\n            else BackgroundScheduler(\n                job_defaults={\"coalesce\": True, \"max_instances\": 1}, timezone=\"UTC\"\n            )\n        )","numLines":80,"startLine":1,"totalLines":672}}}
