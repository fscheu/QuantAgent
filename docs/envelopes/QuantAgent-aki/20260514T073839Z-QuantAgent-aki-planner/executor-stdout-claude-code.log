{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01MLNteKuETrC5pzez2zM9FA","type":"tool_result","content":"1\t\"\"\"Paper Trading Scheduler monitoring view for Streamlit dashboard.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\tfrom datetime import datetime, timedelta\n6\tfrom typing import Optional\n7\t\n8\timport streamlit as st\n9\t\n10\t\n11\tdef _calculate_status(heartbeat: Optional[dict]) -> tuple[str, str]:\n12\t    \"\"\"\n13\t    Calculate scheduler status based on last heartbeat.\n14\t\n15\t    Args:\n16\t        heartbeat: Latest heartbeat dict or None\n17\t\n18\t    Returns:\n19\t        Tuple of (status_emoji, status_text)\n20\t    \"\"\"\n21\t    if not heartbeat:\n22\t        return (\"🔴\", \"Stopped\")\n23\t\n24\t    last_run = heartbeat.get(\"timestamp\")\n25\t    if not last_run:\n26\t        return (\"🔴\", \"Stopped\")\n27\t\n28\t    # Calculate time since last run\n29\t    now = datetime.utcnow()\n30\t    if isinstance(last_run, str):\n31\t        last_run = datetime.fromisoformat(last_run.replace(\"Z\", \"+00:00\"))\n32\t\n33\t    time_since = now - last_run\n34\t\n35\t    heartbeat_status = heartbeat.get(\"status\")\n36\t    if heartbeat_status == \"error\":\n37\t        return (\"❌\", \"Error\")\n38\t    if heartbeat_status == \"running\":\n39\t        if time_since < timedelta(hours=2):\n40\t            return (\"⏳\", \"Running\")\n41\t        return (\"🟠\", \"Stuck\")\n42\t\n43\t    # Status thresholds from design doc\n44\t    if time_since < timedelta(hours=2):\n45\t        return (\"🟢\", \"Active\")\n46\t    elif time_since < timedelta(hours=24):\n47\t        return (\"🟡\", \"Stale\")\n48\t    else:\n49\t        return (\"🔴\", \"Stopped\")\n50\t"}]},"parent_tool_use_id":null,"session_id":"e2e7c456-35f5-44fa-bc39-3f5f6a9f15ef","uuid":"8343729f-641b-4bed-bec2-011b502709f9","timestamp":"2026-05-14T07:39:24.969Z","tool_use_result":{"type":"text","file":{"filePath":"/home/azureuser/repos/projects/QuantAgent/apps/streamlit/views/paper_trading.py","content":"\"\"\"Paper Trading Scheduler monitoring view for Streamlit dashboard.\"\"\"\n\nfrom __future__ import annotations\n\nfrom datetime import datetime, timedelta\nfrom typing import Optional\n\nimport streamlit as st\n\n\ndef _calculate_status(heartbeat: Optional[dict]) -> tuple[str, str]:\n    \"\"\"\n    Calculate scheduler status based on last heartbeat.\n\n    Args:\n        heartbeat: Latest heartbeat dict or None\n\n    Returns:\n        Tuple of (status_emoji, status_text)\n    \"\"\"\n    if not heartbeat:\n        return (\"🔴\", \"Stopped\")\n\n    last_run = heartbeat.get(\"timestamp\")\n    if not last_run:\n        return (\"🔴\", \"Stopped\")\n\n    # Calculate time since last run\n    now = datetime.utcnow()\n    if isinstance(last_run, str):\n        last_run = datetime.fromisoformat(last_run.replace(\"Z\", \"+00:00\"))\n\n    time_since = now - last_run\n\n    heartbeat_status = heartbeat.get(\"status\")\n    if heartbeat_status == \"error\":\n        return (\"❌\", \"Error\")\n    if heartbeat_status == \"running\":\n        if time_since < timedelta(hours=2):\n            return (\"⏳\", \"Running\")\n        return (\"🟠\", \"Stuck\")\n\n    # Status thresholds from design doc\n    if time_since < timedelta(hours=2):\n        return (\"🟢\", \"Active\")\n    elif time_since < timedelta(hours=24):\n        return (\"🟡\", \"Stale\")\n    else:\n        return (\"🔴\", \"Stopped\")\n","numLines":50,"startLine":1,"totalLines":365}}}
