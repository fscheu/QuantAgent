{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Bn4QrbL9TGY1YmvKhj3xGU","type":"tool_result","content":"135\t\n136\t\n137\t@dataclass\n138\tclass SchedulerSettings:\n139\t    enabled: bool = False\n140\t    interval_hours: float = 1.0\n141\t    assets: List[str] = field(default_factory=lambda: DEFAULT_SCHEDULER_ASSETS.copy())\n142\t    environment: str = \"paper\"\n143\t    timeframe: str = \"1h\"\n144\t    lookback_hours: float = 168.0\n145\t\n146\t    def __post_init__(self) -> None:\n147\t        self.interval_hours = float(self.interval_hours)\n148\t        self.lookback_hours = float(self.lookback_hours)\n149\t        if self.interval_hours <= 0:\n150\t            raise ValueError(\"interval_hours must be > 0\")\n151\t        if self.lookback_hours <= 0:\n152\t            raise ValueError(\"lookback_hours must be > 0\")\n153\t        normalized_assets = [\n154\t            asset.strip().upper() for asset in self.assets if asset.strip()\n155\t        ]\n156\t        if not normalized_assets:\n157\t            raise ValueError(\"assets list cannot be empty\")\n158\t        self.assets = normalized_assets\n159\t        env_value = self.environment.strip().lower()\n160\t        if env_value not in {\"backtest\", \"paper\", \"prod\"}:\n161\t            raise ValueError(\"environment must be one of: backtest, paper, prod\")\n162\t        self.environment = env_value\n163\t        timeframe_value = self.timeframe.strip().lower()\n164\t        if not timeframe_value:\n165\t            raise ValueError(\"timeframe cannot be empty\")\n166\t        self.timeframe = timeframe_value\n167\t\n168\t    @classmethod\n169\t    def from_env(cls) -> \"SchedulerSettings\":\n170\t        return cls(\n171\t            enabled=_parse_bool_env(\"TRADING_SCHEDULER_ENABLED\", False),\n172\t            interval_hours=_parse_float_env(\"TRADING_SCHEDULER_INTERVAL_HOURS\", 1.0),\n173\t            assets=_parse_assets_env(os.getenv(\"TRADING_SCHEDULER_ASSETS\")),\n174\t            environment=os.getenv(\"TRADING_SCHEDULER_ENVIRONMENT\", \"paper\"),\n175\t            timeframe=os.getenv(\"TRADING_SCHEDULER_TIMEFRAME\", \"1h\"),\n176\t            lookback_hours=_parse_float_env(\"TRADING_SCHEDULER_LOOKBACK_HOURS\", 168.0),\n177\t        )\n178\t\n179\t    def with_overrides(self, **overrides) -> \"SchedulerSettings\":\n180\t        return replace(self, **overrides)\n181\t\n182\t\n183\t# Scheduler configuration instance accessible as settings.scheduler\n184\tscheduler = SchedulerSettings.from_env()\n185\t\n186\t\n187\tdef update_env_file(key: str, value: str) -> None:\n188\t    \"\"\"\n189\t    Update or add a key-value pair in the .env file.\n190\t    Used by web_interface.py to persist API key changes.\n191\t    \"\"\"\n192\t    env_file = Path(__file__).parent.parent / \".env\"\n193\t\n194\t    # Read existing content"}]},"parent_tool_use_id":null,"session_id":"e2e7c456-35f5-44fa-bc39-3f5f6a9f15ef","uuid":"4a5b731b-1b1d-4afb-bf63-b0c35485817b","timestamp":"2026-05-14T07:39:28.012Z","tool_use_result":{"type":"text","file":{"filePath":"/home/azureuser/repos/projects/QuantAgent/quantagent/settings.py","content":"\n\n@dataclass\nclass SchedulerSettings:\n    enabled: bool = False\n    interval_hours: float = 1.0\n    assets: List[str] = field(default_factory=lambda: DEFAULT_SCHEDULER_ASSETS.copy())\n    environment: str = \"paper\"\n    timeframe: str = \"1h\"\n    lookback_hours: float = 168.0\n\n    def __post_init__(self) -> None:\n        self.interval_hours = float(self.interval_hours)\n        self.lookback_hours = float(self.lookback_hours)\n        if self.interval_hours <= 0:\n            raise ValueError(\"interval_hours must be > 0\")\n        if self.lookback_hours <= 0:\n            raise ValueError(\"lookback_hours must be > 0\")\n        normalized_assets = [\n            asset.strip().upper() for asset in self.assets if asset.strip()\n        ]\n        if not normalized_assets:\n            raise ValueError(\"assets list cannot be empty\")\n        self.assets = normalized_assets\n        env_value = self.environment.strip().lower()\n        if env_value not in {\"backtest\", \"paper\", \"prod\"}:\n            raise ValueError(\"environment must be one of: backtest, paper, prod\")\n        self.environment = env_value\n        timeframe_value = self.timeframe.strip().lower()\n        if not timeframe_value:\n            raise ValueError(\"timeframe cannot be empty\")\n        self.timeframe = timeframe_value\n\n    @classmethod\n    def from_env(cls) -> \"SchedulerSettings\":\n        return cls(\n            enabled=_parse_bool_env(\"TRADING_SCHEDULER_ENABLED\", False),\n            interval_hours=_parse_float_env(\"TRADING_SCHEDULER_INTERVAL_HOURS\", 1.0),\n            assets=_parse_assets_env(os.getenv(\"TRADING_SCHEDULER_ASSETS\")),\n            environment=os.getenv(\"TRADING_SCHEDULER_ENVIRONMENT\", \"paper\"),\n            timeframe=os.getenv(\"TRADING_SCHEDULER_TIMEFRAME\", \"1h\"),\n            lookback_hours=_parse_float_env(\"TRADING_SCHEDULER_LOOKBACK_HOURS\", 168.0),\n        )\n\n    def with_overrides(self, **overrides) -> \"SchedulerSettings\":\n        return replace(self, **overrides)\n\n\n# Scheduler configuration instance accessible as settings.scheduler\nscheduler = SchedulerSettings.from_env()\n\n\ndef update_env_file(key: str, value: str) -> None:\n    \"\"\"\n    Update or add a key-value pair in the .env file.\n    Used by web_interface.py to persist API key changes.\n    \"\"\"\n    env_file = Path(__file__).parent.parent / \".env\"\n\n    # Read existing content","numLines":60,"startLine":135,"totalLines":218}}}
