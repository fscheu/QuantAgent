{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01SA6aRY7qry7ZsY2BHKbDNa","type":"tool_result","content":"885\t\n886\t        equity_series = pd.Series([e[\"equity\"] for e in self.equity_curve])\n887\t\n888\t        # Calculate running maximum\n889\t        running_max = equity_series.expanding().max()\n890\t\n891\t        # Calculate drawdown\n892\t        drawdown = (equity_series - running_max) / running_max\n893\t\n894\t        # Maximum drawdown (most negative)\n895\t        max_dd = abs(drawdown.min())\n896\t\n897\t        return float(max_dd)\n898\t\n899\t    def _calculate_directional_accuracy(self) -> tuple[float, Dict[int, float]]:\n900\t        \"\"\"\n901\t        Calculate Mean Directional Accuracy (MDA) and per-candle accuracy.\n902\t\n903\t        MDA = (correct_candles / total_candles_evaluated)\n904\t\n905\t        Returns:\n906\t            Tuple of (mean_directional_accuracy, accuracy_by_candle)\n907\t        \"\"\"\n908\t        positions = (\n909\t            self.db.query(ActivePosition)\n910\t            .filter(\n911\t                ActivePosition.is_active.is_(False),\n912\t                ActivePosition.decision_timestamp >= self.start_date,\n913\t                ActivePosition.decision_timestamp <= self.end_date,\n914\t            )\n915\t            .all()\n916\t        )\n917\t\n918\t        if not positions:\n919\t            return 0.0, {}\n920\t\n921\t        # Track correct predictions per candle index\n922\t        correct_by_candle = {}\n923\t        total_by_candle = {}\n924\t\n925\t        for pos in positions:\n926\t            expected_direction = \"up\" if pos.side == OrderSide.BUY else \"down\"\n927\t\n928\t            # Evaluate up to prediction_horizon candles\n929\t            for i, direction in enumerate(\n930\t                pos.candles_direction[: pos.prediction_horizon]\n931\t            ):\n932\t                candle_idx = i + 1  # 1-indexed (candle 1, 2, 3...)\n933\t\n934\t                if candle_idx not in correct_by_candle:\n935\t                    correct_by_candle[candle_idx] = 0\n936\t                    total_by_candle[candle_idx] = 0\n937\t\n938\t                total_by_candle[candle_idx] += 1\n939\t                if direction == expected_direction:\n940\t                    correct_by_candle[candle_idx] += 1\n941\t\n942\t        # Calculate accuracy per candle\n943\t        accuracy_by_candle = {\n944\t            candle: correct_by_candle[candle] / total_by_candle[candle]\n945\t            for candle in sorted(total_by_candle.keys())\n946\t        }\n947\t\n948\t        # Calculate overall MDA\n949\t        total_correct = sum(correct_by_candle.values())\n950\t        total_candles = sum(total_by_candle.values())\n951\t        mda = total_correct / total_candles if total_candles > 0 else 0.0\n952\t\n953\t        return mda, accuracy_by_candle\n954\t\n955\t    def _calculate_close_reasons(self) -> Dict[str, int]:\n956\t        \"\"\"\n957\t        Calculate distribution of position close reasons.\n958\t\n959\t        Returns:\n960\t            Dict mapping close_reason to count\n961\t        \"\"\"\n962\t        positions = (\n963\t            self.db.query(ActivePosition)\n964\t            .filter(\n965\t                ActivePosition.is_active.is_(False),\n966\t                ActivePosition.decision_timestamp >= self.start_date,\n967\t                ActivePosition.decision_timestamp <= self.end_date,\n968\t            )\n969\t            .all()\n970\t        )\n971\t\n972\t        close_reasons = {}\n973\t        for pos in positions:\n974\t            reason = pos.close_reason or \"unknown\"\n975\t            close_reasons[reason] = close_reasons.get(reason, 0) + 1\n976\t\n977\t        return close_reasons\n978\t\n979\t    def _get_periods_per_year(self) -> int:\n980\t        \"\"\"Get number of periods per year based on timeframe.\"\"\"\n981\t        if self.timeframe == \"1h\":\n982\t            return 252 * 6.5  # Trading days * hours per day\n983\t        elif self.timeframe == \"4h\":\n984\t            return 252 * 1.625  # Approx 1.6 periods per day\n985\t        elif self.timeframe == \"1d\":\n986\t            return 252\n987\t        elif self.timeframe == \"1w\":\n988\t            return 52\n989\t        else:\n990\t            return 252\n991\t\n992\t    def _update_backtest_run(self, metrics: BacktestMetrics) -> None:\n993\t        \"\"\"Update BacktestRun record with final metrics.\"\"\"\n994\t        if not self.backtest_run_id:\n995\t            return\n996\t\n997\t        run = (\n998\t            self.db.query(BacktestRun)\n999\t            .filter(BacktestRun.id == self.backtest_run_id)\n1000\t            .first()\n1001\t        )\n1002\t\n1003\t        if run:\n1004\t            run.total_trades = metrics.total_trades\n1005\t            run.win_rate = metrics.win_rate\n1006\t            run.profit_factor = metrics.profit_factor\n1007\t            run.sharpe_ratio = metrics.sharpe_ratio\n1008\t            run.max_drawdown = metrics.max_drawdown\n1009\t            run.total_pnl = Decimal(str(metrics.total_pnl))\n1010\t\n1011\t            self.db.commit()\n1012\t            logger.info(\n1013\t                f\"Updated backtest run #{self.backtest_run_id} with final metrics\",\n1014\t                extra={\"event_type\": \"backtest_complete\"},\n1015\t            )\n1016\t\n1017\t    def get_equity_curve(self) -> pd.DataFrame:\n1018\t        \"\"\"\n1019\t        Get equity curve as DataFrame.\n1020\t\n1021\t        Returns:\n1022\t            DataFrame with columns: date, equity, cash, positions_value\n1023\t        \"\"\"\n1024\t        return pd.DataFrame(self.equity_curve)\n1025\t\n1026\t    def __del__(self):\n1027\t        \"\"\"Cleanup database session if we own it.\"\"\"\n1028\t        if self._own_session and self.db:\n1029\t            self.db.close()\n1030\t"}]},"parent_tool_use_id":null,"session_id":"5a451379-8c79-4d4e-abfc-8730c6577932","uuid":"6a55f5bb-c816-4314-8a9a-9da9bf751783","timestamp":"2026-05-12T02:45:58.418Z","tool_use_result":{"type":"text","file":{"filePath":"/mnt/actions-runner/autodev-runtime/worktrees/QuantAgent/QuantAgent-e4k/implementer-20260512T024453Z/quantagent/backtesting/backtest.py","content":"\n        equity_series = pd.Series([e[\"equity\"] for e in self.equity_curve])\n\n        # Calculate running maximum\n        running_max = equity_series.expanding().max()\n\n        # Calculate drawdown\n        drawdown = (equity_series - running_max) / running_max\n\n        # Maximum drawdown (most negative)\n        max_dd = abs(drawdown.min())\n\n        return float(max_dd)\n\n    def _calculate_directional_accuracy(self) -> tuple[float, Dict[int, float]]:\n        \"\"\"\n        Calculate Mean Directional Accuracy (MDA) and per-candle accuracy.\n\n        MDA = (correct_candles / total_candles_evaluated)\n\n        Returns:\n            Tuple of (mean_directional_accuracy, accuracy_by_candle)\n        \"\"\"\n        positions = (\n            self.db.query(ActivePosition)\n            .filter(\n                ActivePosition.is_active.is_(False),\n                ActivePosition.decision_timestamp >= self.start_date,\n                ActivePosition.decision_timestamp <= self.end_date,\n            )\n            .all()\n        )\n\n        if not positions:\n            return 0.0, {}\n\n        # Track correct predictions per candle index\n        correct_by_candle = {}\n        total_by_candle = {}\n\n        for pos in positions:\n            expected_direction = \"up\" if pos.side == OrderSide.BUY else \"down\"\n\n            # Evaluate up to prediction_horizon candles\n            for i, direction in enumerate(\n                pos.candles_direction[: pos.prediction_horizon]\n            ):\n                candle_idx = i + 1  # 1-indexed (candle 1, 2, 3...)\n\n                if candle_idx not in correct_by_candle:\n                    correct_by_candle[candle_idx] = 0\n                    total_by_candle[candle_idx] = 0\n\n                total_by_candle[candle_idx] += 1\n                if direction == expected_direction:\n                    correct_by_candle[candle_idx] += 1\n\n        # Calculate accuracy per candle\n        accuracy_by_candle = {\n            candle: correct_by_candle[candle] / total_by_candle[candle]\n            for candle in sorted(total_by_candle.keys())\n        }\n\n        # Calculate overall MDA\n        total_correct = sum(correct_by_candle.values())\n        total_candles = sum(total_by_candle.values())\n        mda = total_correct / total_candles if total_candles > 0 else 0.0\n\n        return mda, accuracy_by_candle\n\n    def _calculate_close_reasons(self) -> Dict[str, int]:\n        \"\"\"\n        Calculate distribution of position close reasons.\n\n        Returns:\n            Dict mapping close_reason to count\n        \"\"\"\n        positions = (\n            self.db.query(ActivePosition)\n            .filter(\n                ActivePosition.is_active.is_(False),\n                ActivePosition.decision_timestamp >= self.start_date,\n                ActivePosition.decision_timestamp <= self.end_date,\n            )\n            .all()\n        )\n\n        close_reasons = {}\n        for pos in positions:\n            reason = pos.close_reason or \"unknown\"\n            close_reasons[reason] = close_reasons.get(reason, 0) + 1\n\n        return close_reasons\n\n    def _get_periods_per_year(self) -> int:\n        \"\"\"Get number of periods per year based on timeframe.\"\"\"\n        if self.timeframe == \"1h\":\n            return 252 * 6.5  # Trading days * hours per day\n        elif self.timeframe == \"4h\":\n            return 252 * 1.625  # Approx 1.6 periods per day\n        elif self.timeframe == \"1d\":\n            return 252\n        elif self.timeframe == \"1w\":\n            return 52\n        else:\n            return 252\n\n    def _update_backtest_run(self, metrics: BacktestMetrics) -> None:\n        \"\"\"Update BacktestRun record with final metrics.\"\"\"\n        if not self.backtest_run_id:\n            return\n\n        run = (\n            self.db.query(BacktestRun)\n            .filter(BacktestRun.id == self.backtest_run_id)\n            .first()\n        )\n\n        if run:\n            run.total_trades = metrics.total_trades\n            run.win_rate = metrics.win_rate\n            run.profit_factor = metrics.profit_factor\n            run.sharpe_ratio = metrics.sharpe_ratio\n            run.max_drawdown = metrics.max_drawdown\n            run.total_pnl = Decimal(str(metrics.total_pnl))\n\n            self.db.commit()\n            logger.info(\n                f\"Updated backtest run #{self.backtest_run_id} with final metrics\",\n                extra={\"event_type\": \"backtest_complete\"},\n            )\n\n    def get_equity_curve(self) -> pd.DataFrame:\n        \"\"\"\n        Get equity curve as DataFrame.\n\n        Returns:\n            DataFrame with columns: date, equity, cash, positions_value\n        \"\"\"\n        return pd.DataFrame(self.equity_curve)\n\n    def __del__(self):\n        \"\"\"Cleanup database session if we own it.\"\"\"\n        if self._own_session and self.db:\n            self.db.close()\n","numLines":146,"startLine":885,"totalLines":1030}}}
