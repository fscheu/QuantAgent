{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015cNPHx2XCuY4ueDVcActfF","type":"tool_result","content":"686\t                exc_info=True,\n687\t                extra={\"event_type\": \"backtest_error\"},\n688\t            )\n689\t            return None\n690\t\n691\t    def _record_equity(self, current_date: datetime) -> None:\n692\t        \"\"\"Record equity curve data point.\"\"\"\n693\t        total_value = self.portfolio.get_total_value()\n694\t\n695\t        self.equity_curve.append(\n696\t            {\n697\t                \"date\": current_date,\n698\t                \"equity\": total_value,\n699\t                \"cash\": self.portfolio.cash,\n700\t                \"positions_value\": total_value - self.portfolio.cash,\n701\t            }\n702\t        )\n703\t\n704\t    def _calculate_metrics(self) -> BacktestMetrics:\n705\t        \"\"\"\n706\t        Calculate backtest performance metrics.\n707\t\n708\t        Metrics:\n709\t        - Win rate: % of winning trades\n710\t        - Profit factor: sum(wins) / abs(sum(losses))\n711\t        - Sharpe ratio: (return - risk_free) / volatility\n712\t        - Max drawdown: worst peak-to-trough decline\n713\t        - Total P&L: sum of all trade P&L\n714\t        \"\"\"\n715\t        # Get all trades from database for this backtest\n716\t        trades = (\n717\t            self.db.query(Trade)\n718\t            .filter(\n719\t                Trade.environment == Environment.BACKTEST,\n720\t                Trade.opened_at >= self.start_date,\n721\t                Trade.opened_at <= self.end_date,\n722\t            )\n723\t            .all()\n724\t        )\n725\t\n726\t        if not trades:\n727\t            logger.warning(\n728\t                \"No trades executed during backtest\",\n729\t                extra={\"event_type\": \"backtest_warning\"},\n730\t            )\n731\t\n732\t            # Phase 4: Even with no trades, calculate MDA if positions were opened\n733\t            mda, accuracy_by_candle = self._calculate_directional_accuracy()\n734\t            close_reasons = self._calculate_close_reasons()\n735\t\n736\t            invocations_saved = self.total_candles_processed - self.agent_invocations\n737\t            invocation_reduction_pct = (\n738\t                (invocations_saved / self.total_candles_processed * 100)\n739\t                if self.total_candles_processed > 0\n740\t                else 0.0\n741\t            )\n742\t\n743\t            return BacktestMetrics(\n744\t                total_trades=0,\n745\t                winning_trades=0,\n746\t                losing_trades=0,\n747\t                win_rate=0.0,\n748\t                profit_factor=0.0,\n749\t                sharpe_ratio=0.0,\n750\t                max_drawdown=0.0,\n751\t                total_pnl=0.0,\n752\t                avg_win=0.0,\n753\t                avg_loss=0.0,\n754\t                largest_win=0.0,\n755\t                largest_loss=0.0,\n756\t                total_return_pct=0.0,\n757\t                agent_invocations=self.agent_invocations,\n758\t                invocations_saved=invocations_saved,\n759\t                invocation_reduction_pct=invocation_reduction_pct,\n760\t                mean_directional_accuracy=mda,\n761\t                accuracy_by_candle=accuracy_by_candle,\n762\t                close_reasons=close_reasons,\n763\t            )\n764\t\n765\t        # Calculate basic metrics\n766\t        total_trades = len(trades)\n767\t        winning_trades = [t for t in trades if t.pnl and float(t.pnl) > 0]\n768\t        losing_trades = [t for t in trades if t.pnl and float(t.pnl) < 0]\n769\t\n770\t        total_wins = sum(float(t.pnl) for t in winning_trades)\n771\t        total_losses = abs(sum(float(t.pnl) for t in losing_trades))\n772\t\n773\t        # Win rate\n774\t        win_rate = len(winning_trades) / total_trades if total_trades > 0 else 0.0\n775\t\n776\t        # Profit factor\n777\t        profit_factor = (\n778\t            total_wins / total_losses\n779\t            if total_losses > 0\n780\t            else float(\"inf\") if total_wins > 0 else 0.0\n781\t        )\n782\t\n783\t        # Total P&L\n784\t        total_pnl = sum(float(t.pnl) for t in trades if t.pnl)\n785\t\n786\t        # Average win/loss\n787\t        avg_win = total_wins / len(winning_trades) if winning_trades else 0.0\n788\t        avg_loss = total_losses / len(losing_trades) if losing_trades else 0.0\n789\t\n790\t        # Largest win/loss\n791\t        largest_win = max((float(t.pnl) for t in winning_trades), default=0.0)\n792\t        largest_loss = min((float(t.pnl) for t in losing_trades), default=0.0)\n793\t\n794\t        # Total return %\n795\t        total_return_pct = (\n796\t            (total_pnl / self.initial_capital) * 100\n797\t            if self.initial_capital > 0\n798\t            else 0.0\n799\t        )\n800\t\n801\t        # Sharpe ratio\n802\t        sharpe_ratio = self._calculate_sharpe_ratio()\n803\t\n804\t        # Max drawdown\n805\t        max_drawdown = self._calculate_max_drawdown()\n806\t\n807\t        # Phase 4: Calculate MDA and accuracy metrics\n808\t        mda, accuracy_by_candle = self._calculate_directional_accuracy()\n809\t\n810\t        # Phase 4: Calculate close reasons distribution\n811\t        close_reasons = self._calculate_close_reasons()\n812\t\n813\t        # Phase 4: Calculate invocation reduction\n814\t        invocations_saved = self.total_candles_processed - self.agent_invocations\n815\t        invocation_reduction_pct = (\n816\t            (invocations_saved / self.total_candles_processed * 100)\n817\t            if self.total_candles_processed > 0\n818\t            else 0.0\n819\t        )\n820\t\n821\t        return BacktestMetrics(\n822\t            total_trades=total_trades,\n823\t            winning_trades=len(winning_trades),\n824\t            losing_trades=len(losing_trades),\n825\t            win_rate=win_rate,\n826\t            profit_factor=profit_factor,\n827\t            sharpe_ratio=sharpe_ratio,\n828\t            max_drawdown=max_drawdown,\n829\t            total_pnl=total_pnl,\n830\t            avg_win=avg_win,\n831\t            avg_loss=avg_loss,\n832\t            largest_win=largest_win,\n833\t            largest_loss=largest_loss,\n834\t            total_return_pct=total_return_pct,\n835\t            agent_invocations=self.agent_invocations,\n836\t            invocations_saved=invocations_saved,\n837\t            invocation_reduction_pct=invocation_reduction_pct,\n838\t            mean_directional_accuracy=mda,\n839\t            accuracy_by_candle=accuracy_by_candle,\n840\t            close_reasons=close_reasons,\n841\t        )\n842\t\n843\t    def _calculate_sharpe_ratio(self, risk_free_rate: float = 0.02) -> float:\n844\t        \"\"\"\n845\t        Calculate Sharpe ratio.\n846\t\n847\t        Formula: (return - risk_free) / volatility\n848\t\n849\t        Args:\n850\t            risk_free_rate: Annual risk-free rate (default: 2%)\n851\t\n852\t        Returns:\n853\t            Sharpe ratio\n854\t        \"\"\"\n855\t        if len(self.equity_curve) < 2:\n856\t            return 0.0\n857\t\n858\t        # Calculate returns\n859\t        equity_series = pd.Series([e[\"equity\"] for e in self.equity_curve])\n860\t        returns = equity_series.pct_change().dropna()\n861\t\n862\t        if len(returns) == 0 or returns.std() == 0:\n863\t            return 0.0\n864\t\n865\t        # Annualize based on timeframe\n866\t        periods_per_year = self._get_periods_per_year()\n867\t\n868\t        # Calculate Sharpe\n869\t        excess_return = returns.mean() - (risk_free_rate / periods_per_year)\n870\t        sharpe = (excess_return / returns.std()) * np.sqrt(periods_per_year)\n871\t\n872\t        return float(sharpe)\n873\t\n874\t    def _calculate_max_drawdown(self) -> float:\n875\t        \"\"\"\n876\t        Calculate maximum drawdown.\n877\t\n878\t        Formula: max((peak - trough) / peak)\n879\t\n880\t        Returns:\n881\t            Max drawdown as decimal (e.g., 0.15 = 15%)\n882\t        \"\"\"\n883\t        if len(self.equity_curve) < 2:\n884\t            return 0.0\n885\t"}]},"parent_tool_use_id":null,"session_id":"5a451379-8c79-4d4e-abfc-8730c6577932","uuid":"40f4a75f-b237-4939-b197-bce26795fbf6","timestamp":"2026-05-12T02:45:55.261Z","tool_use_result":{"type":"text","file":{"filePath":"/mnt/actions-runner/autodev-runtime/worktrees/QuantAgent/QuantAgent-e4k/implementer-20260512T024453Z/quantagent/backtesting/backtest.py","content":"                exc_info=True,\n                extra={\"event_type\": \"backtest_error\"},\n            )\n            return None\n\n    def _record_equity(self, current_date: datetime) -> None:\n        \"\"\"Record equity curve data point.\"\"\"\n        total_value = self.portfolio.get_total_value()\n\n        self.equity_curve.append(\n            {\n                \"date\": current_date,\n                \"equity\": total_value,\n                \"cash\": self.portfolio.cash,\n                \"positions_value\": total_value - self.portfolio.cash,\n            }\n        )\n\n    def _calculate_metrics(self) -> BacktestMetrics:\n        \"\"\"\n        Calculate backtest performance metrics.\n\n        Metrics:\n        - Win rate: % of winning trades\n        - Profit factor: sum(wins) / abs(sum(losses))\n        - Sharpe ratio: (return - risk_free) / volatility\n        - Max drawdown: worst peak-to-trough decline\n        - Total P&L: sum of all trade P&L\n        \"\"\"\n        # Get all trades from database for this backtest\n        trades = (\n            self.db.query(Trade)\n            .filter(\n                Trade.environment == Environment.BACKTEST,\n                Trade.opened_at >= self.start_date,\n                Trade.opened_at <= self.end_date,\n            )\n            .all()\n        )\n\n        if not trades:\n            logger.warning(\n                \"No trades executed during backtest\",\n                extra={\"event_type\": \"backtest_warning\"},\n            )\n\n            # Phase 4: Even with no trades, calculate MDA if positions were opened\n            mda, accuracy_by_candle = self._calculate_directional_accuracy()\n            close_reasons = self._calculate_close_reasons()\n\n            invocations_saved = self.total_candles_processed - self.agent_invocations\n            invocation_reduction_pct = (\n                (invocations_saved / self.total_candles_processed * 100)\n                if self.total_candles_processed > 0\n                else 0.0\n            )\n\n            return BacktestMetrics(\n                total_trades=0,\n                winning_trades=0,\n                losing_trades=0,\n                win_rate=0.0,\n                profit_factor=0.0,\n                sharpe_ratio=0.0,\n                max_drawdown=0.0,\n                total_pnl=0.0,\n                avg_win=0.0,\n                avg_loss=0.0,\n                largest_win=0.0,\n                largest_loss=0.0,\n                total_return_pct=0.0,\n                agent_invocations=self.agent_invocations,\n                invocations_saved=invocations_saved,\n                invocation_reduction_pct=invocation_reduction_pct,\n                mean_directional_accuracy=mda,\n                accuracy_by_candle=accuracy_by_candle,\n                close_reasons=close_reasons,\n            )\n\n        # Calculate basic metrics\n        total_trades = len(trades)\n        winning_trades = [t for t in trades if t.pnl and float(t.pnl) > 0]\n        losing_trades = [t for t in trades if t.pnl and float(t.pnl) < 0]\n\n        total_wins = sum(float(t.pnl) for t in winning_trades)\n        total_losses = abs(sum(float(t.pnl) for t in losing_trades))\n\n        # Win rate\n        win_rate = len(winning_trades) / total_trades if total_trades > 0 else 0.0\n\n        # Profit factor\n        profit_factor = (\n            total_wins / total_losses\n            if total_losses > 0\n            else float(\"inf\") if total_wins > 0 else 0.0\n        )\n\n        # Total P&L\n        total_pnl = sum(float(t.pnl) for t in trades if t.pnl)\n\n        # Average win/loss\n        avg_win = total_wins / len(winning_trades) if winning_trades else 0.0\n        avg_loss = total_losses / len(losing_trades) if losing_trades else 0.0\n\n        # Largest win/loss\n        largest_win = max((float(t.pnl) for t in winning_trades), default=0.0)\n        largest_loss = min((float(t.pnl) for t in losing_trades), default=0.0)\n\n        # Total return %\n        total_return_pct = (\n            (total_pnl / self.initial_capital) * 100\n            if self.initial_capital > 0\n            else 0.0\n        )\n\n        # Sharpe ratio\n        sharpe_ratio = self._calculate_sharpe_ratio()\n\n        # Max drawdown\n        max_drawdown = self._calculate_max_drawdown()\n\n        # Phase 4: Calculate MDA and accuracy metrics\n        mda, accuracy_by_candle = self._calculate_directional_accuracy()\n\n        # Phase 4: Calculate close reasons distribution\n        close_reasons = self._calculate_close_reasons()\n\n        # Phase 4: Calculate invocation reduction\n        invocations_saved = self.total_candles_processed - self.agent_invocations\n        invocation_reduction_pct = (\n            (invocations_saved / self.total_candles_processed * 100)\n            if self.total_candles_processed > 0\n            else 0.0\n        )\n\n        return BacktestMetrics(\n            total_trades=total_trades,\n            winning_trades=len(winning_trades),\n            losing_trades=len(losing_trades),\n            win_rate=win_rate,\n            profit_factor=profit_factor,\n            sharpe_ratio=sharpe_ratio,\n            max_drawdown=max_drawdown,\n            total_pnl=total_pnl,\n            avg_win=avg_win,\n            avg_loss=avg_loss,\n            largest_win=largest_win,\n            largest_loss=largest_loss,\n            total_return_pct=total_return_pct,\n            agent_invocations=self.agent_invocations,\n            invocations_saved=invocations_saved,\n            invocation_reduction_pct=invocation_reduction_pct,\n            mean_directional_accuracy=mda,\n            accuracy_by_candle=accuracy_by_candle,\n            close_reasons=close_reasons,\n        )\n\n    def _calculate_sharpe_ratio(self, risk_free_rate: float = 0.02) -> float:\n        \"\"\"\n        Calculate Sharpe ratio.\n\n        Formula: (return - risk_free) / volatility\n\n        Args:\n            risk_free_rate: Annual risk-free rate (default: 2%)\n\n        Returns:\n            Sharpe ratio\n        \"\"\"\n        if len(self.equity_curve) < 2:\n            return 0.0\n\n        # Calculate returns\n        equity_series = pd.Series([e[\"equity\"] for e in self.equity_curve])\n        returns = equity_series.pct_change().dropna()\n\n        if len(returns) == 0 or returns.std() == 0:\n            return 0.0\n\n        # Annualize based on timeframe\n        periods_per_year = self._get_periods_per_year()\n\n        # Calculate Sharpe\n        excess_return = returns.mean() - (risk_free_rate / periods_per_year)\n        sharpe = (excess_return / returns.std()) * np.sqrt(periods_per_year)\n\n        return float(sharpe)\n\n    def _calculate_max_drawdown(self) -> float:\n        \"\"\"\n        Calculate maximum drawdown.\n\n        Formula: max((peak - trough) / peak)\n\n        Returns:\n            Max drawdown as decimal (e.g., 0.15 = 15%)\n        \"\"\"\n        if len(self.equity_curve) < 2:\n            return 0.0\n","numLines":200,"startLine":686,"totalLines":1030}}}
