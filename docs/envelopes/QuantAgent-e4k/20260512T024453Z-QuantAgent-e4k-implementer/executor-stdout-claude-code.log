t TradingGraph\n39\tfrom quantagent.trading_graph import TradingGraph\n40\t\n41\tlogger = logging.getLogger(__name__)\n42\t\n43\t\n44\t@dataclass\n45\tclass BacktestMetrics:\n46\t    \"\"\"Backtest performance metrics.\"\"\"\n47\t\n48\t    total_trades: int\n49\t    winning_trades: int\n50\t    losing_trades: int\n51\t    win_rate: float\n52\t    profit_factor: float\n53\t    sharpe_ratio: float\n54\t    max_drawdown: float\n55\t    total_pnl: float\n56\t    avg_win: float\n57\t    avg_loss: float\n58\t    largest_win: float\n59\t    largest_loss: float\n60\t    total_return_pct: float\n61\t\n62\t    # Phase 4: Active Position Monitoring metrics\n63\t    agent_invocations: int = 0\n64\t    invocations_saved: int = 0\n65\t    invocation_reduction_pct: float = 0.0\n66\t    mean_directional_accuracy: float = 0.0\n67\t    accuracy_by_candle: Dict[int, float] = None\n68\t    close_reasons: Dict[str, int] = None\n69\t\n70\t    def __post_init__(self):\n71\t        if self.accuracy_by_candle is None:\n72\t            self.accuracy_by_candle = {}\n73\t        if self.close_reasons is None:\n74\t            self.close_reasons = {}\n75\t\n76\t\n77\tclass Backtest:\n78\t    \"\"\"\n79\t    Backtesting engine for validating trading strategies.\n80\t\n81\t    Workflow:\n82\t    1. Loop through historical dates\n83\t    2. Fetch OHLC data for each date using DataProvider (cached)\n84\t    3. Execute analysis using TradingGraph\n85\t    4. Simulate trade execution using OrderManager\n86\t    5. Track portfolio performance\n87\t    6. Calculate and persist metrics\n88\t\n89\t    Features:\n90\t    - Uses DataProvider for 10x faster data access (caching)\n91\t    - Executes same agents as live trading\n92\t    - Stores full provenance (config snapshot, model metadata)\n93\t    - Supports replay with different risk/portfolio profiles\n94\t    \"\"\"\n95\t\n96\t    def __init__(\n97\t        self,\n98\t        start_date: datetime,\n99\t        end_date: datetime,\n100\t        assets