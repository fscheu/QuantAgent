{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01UMvJN3owHqZJBmZ49C7sMB","type":"tool_result","content":"1\t\"\"\"Backtesting engine for strategy validation.\"\"\"\n2\t\n3\timport logging\n4\timport math\n5\tfrom dataclasses import dataclass\n6\tfrom datetime import datetime, timedelta\n7\tfrom decimal import Decimal\n8\tfrom typing import Dict, List, Optional\n9\t\n10\timport numpy as np\n11\timport pandas as pd\n12\tfrom sqlalchemy.orm import Session\n13\t\n14\tfrom quantagent.agent_models import TradingDecision\n15\tfrom quantagent.data.asset_types import AssetType, get_asset_type\n16\tfrom quantagent.data.market_calendar import get_market_calendar\n17\tfrom quantagent.data.provider import DataProvider\n18\tfrom quantagent.database import SessionLocal\n19\tfrom quantagent.models import (\n20\t    ActivePosition,\n21\t    BacktestRun,\n22\t    Environment,\n23\t    OrderSide,\n24\t    Signal,\n25\t    Trade,\n26\t    TradeSignal,\n27\t)\n28\tfrom quantagent.static_util import format_ohlcv_for_agents\n29\tfrom quantagent.strategy.assembler import StrategyAssembler\n30\tfrom quantagent.strategy.base import TradingStrategy\n31\tfrom quantagent.strategy.llm_agent_strategy import LLMAgentStrategy\n32\tfrom quantagent.trading.position_monitor import PositionMonitor\n33\t\n34\tlogger = logging.getLogger(__name__)\n35\t\n36\t\n37\t@dataclass\n38\tclass BacktestMetrics:\n39\t    \"\"\"Backtest performance metrics.\"\"\"\n40\t\n41\t    total_trades: int\n42\t    winning_trades: int\n43\t    losing_trades: int\n44\t    win_rate: float\n45\t    profit_factor: float\n46\t    sharpe_ratio: float\n47\t    max_drawdown: float\n48\t    total_pnl: float\n49\t    avg_win: float\n50\t    avg_loss: float\n51\t    largest_win: float\n52\t    largest_loss: float\n53\t    total_return_pct: float\n54\t\n55\t    # Phase 4: Active Position Monitoring metrics\n56\t    agent_invocations: int = 0\n57\t    invocations_saved: int = 0\n58\t    invocation_reduction_pct: float = 0.0\n59\t    mean_directional_accuracy: float = 0.0\n60\t    accuracy_by_candle: Dict[int, float] = None\n61\t    close_reasons: Dict[str, int] = None\n62\t\n63\t    def __post_init__(self):\n64\t        if self.accuracy_by_candle is None:\n65\t            self.accuracy_by_candle = {}\n66\t        if self.close_reasons is None:\n67\t            self.close_reasons = {}\n68\t\n69\t\n70\tclass Backtest:\n71\t    \"\"\"\n72\t    Backtesting engine for validating trading strategies.\n73\t\n74\t    Workflow:\n75\t    1. Loop through historical dates\n76\t    2. Fetch OHLC data for each date using DataProvider (cached)\n77\t    3. Execute analysis using TradingGraph\n78\t    4. Simulate trade execution using OrderManager\n79\t    5. Track portfolio performance\n80\t    6. Calculate and persist metrics\n81\t\n82\t    Features:\n83\t    - Uses DataProvider for 10x faster data access (caching)\n84\t    - Executes same agents as live trading\n85\t    - Stores full provenance (config snapshot, model metadata)\n86\t    - Supports replay with different risk/portfolio profiles\n87\t    \"\"\"\n88\t\n89\t    def __init__(\n90\t        self,\n91\t        start_date: datetime,\n92\t        end_date: datetime,\n93\t        assets: List[str],\n94\t        timeframe: str = \"1h\",\n95\t        initial_capital: float = 100000.0,\n96\t        config: Optional[Dict] = None,\n97\t        db_session: Optional[Session] = None,\n98\t        use_checkpointing: bool = False,\n99\t        strategy: Optional[TradingStrategy] = None,\n100\t    ):\n101\t        \"\"\"\n102\t        Initialize Backtest.\n103\t\n104\t        Args:\n105\t            start_date: Start date for backtest\n106\t            end_date: End date for backtest\n107\t            assets: List of asset symbols (e.g., [\"BTC\", \"SPX\", \"CL\"])\n108\t            timeframe: Timeframe for analysis (e.g., \"1h\", \"4h\", \"1d\")\n109\t            initial_capital: Starting portfolio value\n110\t            config: Configuration dict (portfolio/risk params, model settings)\n111\t            db_session: Database session (creates new if None)\n112\t            use_checkpointing: Enable LangGraph checkpointing for state persistence\n113\t            strategy: Optional TradingStrategy. If None, uses LLMAgentStrategy with TradingGraph\n114\t        \"\"\"\n115\t        self.start_date = start_date\n116\t        self.end_date = end_date\n117\t        self.assets = assets\n118\t        self.timeframe = timeframe\n119\t        self.initial_capital = initial_capital\n120\t        self.config = config or {}\n121\t        self.use_checkpointing = use_checkpointing\n122\t\n123\t        # Database\n124\t        self.db = db_session or SessionLocal()\n125\t        self._own_session = db_session is None\n126\t\n127\t        # Data provider (caching layer)\n128\t        self.data_provider = DataProvider(self.db)\n129\t\n130\t        # Resolve config via StrategyAssembler and build components (unify DB session)\n131\t        from quantagent import settings\n132\t\n133\t        resolved = StrategyAssembler.from_snapshot(\n134\t            {\n135\t                \"initial_cash\": initial_capital,\n136\t                \"base_position_pct\": self.config.get(\"base_position_pct\", settings.TRADING_BASE_POSITION_PCT),\n137\t                \"max_daily_loss_pct\": self.config.get(\"max_daily_loss_pct\", settings.TRADING_MAX_DAILY_LOSS_PCT),\n138\t                \"max_position_pct\": self.config.get(\"max_position_pct\", settings.TRADING_MAX_POSITION_PCT),\n139\t                \"slippage_pct\": self.config.get(\"slippage_pct\", settings.TRADING_SLIPPAGE_PCT),\n140\t                # Normalize model fields into generic ones; accept both\n141\t                \"model_provider\": self.config.get(\n142\t                    \"agent_llm_provider\", self.config.get(\"model_provider\", settings.AGENT_LLM_PROVIDER)\n143\t                ),\n144\t                \"model_name\": self.config.get(\n145\t                    \"agent_llm_model\", self.config.get(\"model_name\", settings.AGENT_LLM_MODEL)\n146\t                ),\n147\t                \"temperature\": self.config.get(\n148\t                    \"agent_llm_temperature\", self.config.get(\"temperature\", settings.AGENT_LLM_TEMPERATURE)\n149\t                ),\n150\t                \"use_checkpointing\": use_checkpointing,\n151\t                \"universe\": self.config.get(\"universe\", settings.get_trading_universe()),\n152\t            },\n153\t            environment=Environment.BACKTEST,\n154\t        )\n155\t        components = StrategyAssembler.build_components(resolved, db_session=self.db)\n156\t\n157\t        # Trading graph (analysis engine)\n158\t        self.trading_graph = components.graph\n159\t\n160\t        # Trading strategy (use provided or default to LLMAgentStrategy)\n161\t        self.strategy = strategy or LLMAgentStrategy(self.trading_graph)\n162\t\n163\t        # Position monitor for active position tracking\n164\t        self.position_monitor = PositionMonitor(self.db)\n165\t\n166\t        # Trading components\n167\t        self.portfolio = components.portfolio_manager\n168\t        self.position_sizer = components.position_sizer\n169\t        self.risk_manager = components.risk_manager\n170\t        self.broker = components.broker\n171\t        self.order_manager = components.order_manager\n172\t\n173\t        # Backtest state\n174\t        self.current_date = start_date\n175\t        self.backtest_run_id: Optional[int] = None\n176\t        self._replay_trade_order_ids: Optional[set[int]] = None\n177\t        self.trades: List[Trade] = []\n178\t        self.equity_curve: List[Dict] = []\n179\t\n180\t        # Phase 4: Invocation tracking\n181\t        self.agent_invocations = 0\n182\t        self.total_candles_processed = 0\n183\t\n184\t        # Market hours filtering\n185\t        self.market_hours_filter = self.config.get(\"market_hours_filter\", True)\n186\t        self._market_calendar = (\n187\t            get_market_calendar() if self.market_hours_filter else None\n188\t        )\n189\t\n190\t        # Cache asset types for each symbol\n191\t        self._asset_types: Dict[str, AssetType] = {\n192\t            asset: get_asset_type(asset) for asset in assets\n193\t        }\n194\t\n195\t    def run(self, name: Optional[str] = None) -> BacktestMetrics:\n196\t        \"\"\"\n197\t        Run backtest and return metrics.\n198\t\n199\t        Args:\n200\t            name: Optional name for this backtest run\n201\t\n202\t        Returns:\n203\t            BacktestMetrics with performance statistics\n204\t        \"\"\"\n205\t        logger.info(\n206\t            f\"Starting backtest: {self.start_date} to {self.end_date}\",\n207\t            extra={\"event_type\": \"backtest_start\", \"environment\": \"backtest\"},\n208\t        )\n209\t        logger.info(\n210\t            f\"Assets: {self.assets}, Timeframe: {self.timeframe}\",\n211\t            extra={\"event_type\": \"backtest_start\"},\n212\t        )\n213\t        logger.info(\n214\t            f\"Initial capital: ${self.initial_capital:,.2f}\",\n215\t            extra={\"event_type\": \"backtest_start\"},\n216\t        )\n217\t        logger.info(\n218\t            f\"Market hours filter: {self.market_hours_filter}\",\n219\t            extra={\"event_type\": \"backtest_start\"},\n220\t        )\n221\t\n222\t        self._replay_trade_order_ids = None\n223\t\n224\t        # Create backtest run record\n225\t        self._create_backtest_run(name)\n226\t\n227\t        # Process each asset with its filtered date range\n228\t        total_periods = 0\n229\t        for asset in self.assets:\n230\t            asset_dates = self._get_date_range_for_asset(asset)\n231\t            total_periods += len(asset_dates)\n232\t\n233\t            asset_type = self._asset_types.get(asset, AssetType.UNKNOWN)\n234\t            logger.info(\n235\t                f\"Asset {asset} ({asset_type.value}): {len(asset_dates)} analysis periods\",\n236\t                extra={\"event_type\": \"backtest_start\"},\n237\t            )\n238\t\n239\t        logger.info(\n240\t            f\"Backtesting {total_periods} total analysis periods\",\n241\t            extra={\"event_type\": \"backtest_start\"},\n242\t        )\n243\t\n244\t        # Track progress across all periods\n245\t        periods_completed = 0\n246\t\n247\t        # Loop through assets (outer) and their dates (inner)\n248\t        for asset in self.assets:\n249\t            asset_dates = self._get_date_range_for_asset(asset)\n250\t\n251\t            for i, current_date in enumerate(asset_dates):\n252\t                self.current_date = current_date\n253\t\n254\t                # Reset daily P&L tracking at start of each day\n255\t                if i == 0 or current_date.date() != asset_dates[i - 1].date():\n256\t                    self.risk_manager.reset_daily_tracker()\n257\t\n258\t                try:\n259\t                    self._analyze_and_trade(asset, current_date)\n260\t                except Exception as e:\n261\t                    logger.error(\n262\t                        f\"Error analyzing {asset} at {current_date}: {e}\",\n263\t                        exc_info=True,\n264\t                        extra={\"event_type\": \"backtest_error\", \"symbol\": asset},\n265\t                    )\n266\t                    continue\n267\t\n268\t                # Record equity at end of period\n269\t                self._record_equity(current_date)\n270\t\n271\t                periods_completed += 1\n272\t\n273\t                # Log progress\n274\t                if periods_completed % 100 == 0 or periods_completed == total_periods:\n275\t                    progress = (periods_completed / total_periods) * 100\n276\t                    logger.info(\n277\t                        f\"Progress: {progress:.1f}% ({periods_completed}/{total_periods})\",\n278\t                        extra={\"event_type\": \"backtest_progress\"},\n279\t                    )\n280\t\n281\t        # Calculate metrics\n282\t        metrics = self._calculate_metrics()\n283\t\n284\t        # Update backtest run with results\n285\t        self._update_backtest_run(metrics)\n286\t\n287\t        logger.info(\n288\t            f\"Backtest complete: {metrics.total_trades} trades, Win rate: {metrics.win_rate:.2%}\",\n289\t            extra={\"event_type\": \"backtest_end\", \"environment\": \"backtest\"},\n290\t        )\n291\t        logger.info(\n292\t            f\"Total P&L: ${metrics.total_pnl:,.2f} ({metrics.total_return_pct:.2%})\",\n293\t            extra={\"event_type\": \"backtest_end\"},\n294\t        )\n295\t\n296\t        return metrics\n297\t\n298\t    def run_replay(\n299\t        self,\n300\t        source_run_id: int,\n301\t        name: Optional[str] = None,\n302\t    ) -> \"BacktestMetrics\":\n303\t        \"\"\"\n304\t        Execute replay using signals stored from source_run_id.\n305\t\n306\t        No LLM calls are made — signals are read from the DB and re-applied with\n307\t        the current portfolio/risk config (set at Backtest init time).\n308\t\n309\t        Args:\n310\t            source_run_id: ID of the completed BacktestRun to replay.\n311\t            name: Optional name for the new replay BacktestRun record.\n312\t\n313\t        Returns:\n314\t            BacktestMetrics from replay execution.\n315\t\n316\t        Raises:\n317\t            ValueError: If source run does not exist or has no scoped signals.\n318\t        \"\"\"\n319\t        source_run = (\n320\t            self.db.query(BacktestRun).filter(BacktestRun.id == source_run_id).first()\n321\t        )\n322\t        if source_run is None:\n323\t            raise ValueError(f\"Source BacktestRun {source_run_id} not found\")\n324\t\n325\t        # Load only signals scoped to this source run — prevents cross-run contamination.\n326\t        signals = (\n327\t            self.db.query(Signal)\n328\t            .filter(Signal.backtest_run_id == source_run_id)\n329\t            .all()\n330\t        )\n331\t\n332\t        logger.info(\n333\t            f\"[REPLAY] Starting replay: source={source_run_id}, signals={len(signals)}\",\n334\t            extra={\"event_type\": \"replay_start\"},\n335\t        )\n336\t\n337\t        if not signals:\n338\t            raise ValueError(\n339\t                f\"No stored signals found for source run {source_run_id}. \"\n340\t                \"Run the source backtest first (signals must have backtest_run_id set).\"\n341\t            )\n342\t\n343\t        # Build lookup: (symbol, generated_at) -> signal\n344\t        signal_map: Dict = {}\n345\t        for sig in signals:\n346\t            signal_map[(sig.symbol, sig.generated_at)] = sig\n347\t\n348\t        # Reset in-memory state\n349\t        self.equity_curve = []\n350\t        self.trades = []\n351\t        self.agent_invocations = 0\n352\t        self.total_candles_processed = 0\n353\t        self._replay_trade_order_ids = set()\n354\t\n355\t        # Override date/asset/timeframe from source run so replay matches it exactly\n356\t        self.start_date = source_run.start_date\n357\t        self.end_date = source_run.end_date\n358\t        self.assets = source_run.assets\n359\t        self.timeframe = source_run.timeframe\n360\t\n361\t        self._create_backtest_run(\n362\t            name or f\"Replay_{source_run_id}_{datetime.now().strftime('%Y%m%d_%H%M%S')}\",\n363\t            replay_source_run_id=source_run_id,\n364\t        )\n365\t\n366\t        for asset in self.assets:\n367\t            asset_dates = self._get_date_range_for_asset(asset)\n368\t\n369\t            for i, current_date in enumerate(asset_dates):\n370\t                self.current_date = current_date\n371\t\n372\t                if i == 0 or current_date.date() != asset_dates[i - 1].date():\n373\t                    self.risk_manager.reset_daily_tracker()\n374\t\n375\t                try:\n376\t                    self._replay_and_trade(asset, current_date, signal_map)\n377\t                except Exception as e:\n378\t                    logger.error(\n379\t                        f\"[REPLAY] Error replaying {asset} at {current_date}: {e}\",\n380\t                        exc_info=True,\n381\t                        extra={\"event_type\": \"replay_error\", \"symbol\": asset},\n382\t                    )\n383\t                    continue\n384\t\n385\t                self._record_equity(current_date)\n386\t\n387\t        metrics = self._calculate_metrics()\n388\t        self._update_backtest_run(metrics)\n389\t\n390\t        logger.info(\n391\t            f\"[REPLAY] Completed: {metrics.total_trades} trades, P&L ${metrics.total_pnl:,.2f}\",\n392\t            extra={\"event_type\": \"replay_end\"},\n393\t        )\n394\t        return metrics\n395\t\n396\t    def _replay_and_trade(\n397\t        self, asset: str, current_date: datetime, signal_map: Dict\n398\t    ) -> None:\n399\t        \"\"\"Execute a single candle in replay mode — uses stored signal, no LLM call.\"\"\"\n400\t        lookback_days = 30\n401\t        data_start = current_date - timedelta(days=lookback_days)\n402\t        df = self.data_provider.get_ohlc(\n403\t            symbol=asset,\n404\t            timeframe=self.timeframe,\n405\t            start_date=data_start,\n406\t            end_date=current_date,\n407\t        )\n408\t\n409\t        if df.empty or len(df) < 2:\n410\t            return\n411\t\n412\t        current_price = float(df.iloc[-1][\"close\"])\n413\t        active_pos = self.position_monitor.get_active_position(asset)\n414\t        self.total_candles_processed += 1\n415\t\n416\t        if active_pos:\n417\t            should_exit, reason = self.strategy.should_exit(\n418\t                active_pos, current_price, df\n419\t            )\n420\t            if should_exit:\n421\t                self.position_monitor.close_position(active_pos, reason, current_price)\n422\t                if active_pos.trade_id:\n423\t                    self.order_manager.close_trade(\n424\t                        active_pos.trade_id,\n425\t                        current_price,\n426\t                        environment=Environment.BACKTEST,\n427\t                    )\n428\t                    logger.debug(\n429\t                        f\"[REPLAY] {asset}: Closed position ({reason}) @ ${current_price:.2f}\"\n430\t                    )\n431\t            else:\n432\t                prev_close = float(df.iloc[-2][\"close\"])\n433\t                self.position_monitor.update_candle_tracking(\n434\t                    active_pos, current_price, prev_close\n435\t                )\n436\t                return\n437\t\n438\t        stored_signal = signal_map.get((asset, current_date))\n439\t        if stored_signal is None or stored_signal.signal == TradeSignal.NEUTRAL:\n440\t            return\n441\t\n442\t        logger.debug(\n443\t            f\"[REPLAY] {asset} @ {current_date}: using stored signal {stored_signal.id}\"\n444\t        )\n445\t\n446\t        trading_signal = stored_signal.signal\n447\t        order = self.order_manager.execute_decision(\n448\t            symbol=asset,\n449\t            decision=trading_signal,\n450\t            confidence=stored_signal.confidence,\n451\t            current_price=current_price,\n452\t            environment=Environment.BACKTEST,\n453\t            trigger_signal_id=stored_signal.id,\n454\t        )\n455\t\n456\t        if order and order.filled_quantity and order.filled_quantity > 0:\n457\t            if order.id is not None and self._replay_trade_order_ids is not None:\n458\t                self._replay_trade_order_ids.add(order.id)\n459\t\n460\t            side = (\n461\t                OrderSide.BUY if trading_signal == TradeSignal.LONG else OrderSide.SELL\n462\t            )\n463\t            trade_id = None\n464\t            if order.id:\n465\t                trade = self.db.query(Trade).filter(Trade.order_id == order.id).first()\n466\t                if trade:\n467\t                    trade_id = trade.id\n468\t\n469\t            self.position_monitor.open_position(\n470\t                symbol=asset,\n471\t                side=side,\n472\t                entry_price=current_price,\n473\t                stop_loss=(\n474\t                    current_price * 0.98\n475\t                    if side == OrderSide.BUY\n476\t                    else current_price * 1.02\n477\t                ),\n478\t                take_profit=(\n479\t                    current_price * 1.03\n480\t                    if side == OrderSide.BUY\n481\t                    else current_price * 0.97\n482\t                ),\n483\t                quantity=order.filled_quantity,\n484\t                exit_policy=\"sl_tp_only\",\n485\t                trade_id=trade_id,\n486\t                signal_id=stored_signal.id,\n487\t            )\n488\t\n489\t            logger.info(\n490\t                f\"[REPLAY] Executed {trading_signal.value} for {asset} \"\n491\t                f\"@ ${current_price:.2f}, qty: {order.filled_quantity}\",\n492\t                extra={\"event_type\": \"replay_trade\", \"symbol\": asset},\n493\t            )\n494\t\n495\t    def _create_backtest_run(\n496\t        self, name: Optional[str], replay_source_run_id: Optional[int] = None\n497\t    ) -> None:\n498\t        \"\"\"Create BacktestRun record in database.\"\"\"\n499\t        run = BacktestRun(\n500\t            name=name or f\"Backtest_{datetime.now().strftime('%Y%m%d_%H%M%S')}\",\n501\t            timeframe=self.timeframe,\n502\t            assets=self.assets,\n503\t            start_date=self.start_date,\n504\t            end_date=self.end_date,\n505\t            config_snapshot=self._build_config_snapshot(),\n506\t            replay_source_run_id=replay_source_run_id,\n507\t        )\n508\t\n509\t        self.db.add(run)\n510\t        self.db.commit()\n511\t        self.backtest_run_id = run.id\n512\t\n513\t        if self.position_monitor is not None:\n514\t            self.position_monitor.set_backtest_run_id(self.backtest_run_id)\n515\t\n516\t        logger.info(\n517\t            f\"Created backtest run #{self.backtest_run_id}: {run.name}\",\n518\t            extra={\"event_type\": \"backtest_init\"},\n519\t        )\n520\t\n521\t    def _build_config_snapshot(self) -> Dict:\n522\t        \"\"\"Build immutable config snapshot for reproducibility.\"\"\"\n523\t        from quantagent import settings\n524\t\n525\t        # Re-generate snapshot via assembler to keep alignment\n526\t        resolved = StrategyAssembler.from_snapshot(\n527\t            {\n528\t                \"initial_cash\": self.initial_capital,\n529\t                \"base_position_pct\": self.config.get(\"base_position_pct\", settings.TRADING_BASE_POSITION_PCT),\n530\t                \"max_daily_loss_pct\": self.config.get(\"max_daily_loss_pct\", settings.TRADING_MAX_DAILY_LOSS_PCT),\n531\t                \"max_position_pct\": self.config.get(\"max_position_pct\", settings.TRADING_MAX_POSITION_PCT),\n532\t                \"slippage_pct\": self.config.get(\"slippage_pct\", settings.TRADING_SLIPPAGE_PCT),\n533\t                \"model_provider\": self.config.get(\n534\t                    \"agent_llm_provider\", self.config.get(\"model_provider\", settings.AGENT_LLM_PROVIDER)\n535\t                ),\n536\t                \"model_name\": self.config.get(\n537\t                    \"agent_llm_model\", self.config.get(\"model_name\", settings.AGENT_LLM_MODEL)\n538\t                ),\n539\t                \"temperature\": self.config.get(\n540\t                    \"agent_llm_temperature\", self.config.get(\"temperature\", settings.AGENT_LLM_TEMPERATURE)\n541\t                ),\n542\t                \"use_checkpointing\": self.use_checkpointing,\n543\t                \"universe\": self.config.get(\"universe\", settings.get_trading_universe()),\n544\t            },\n545\t            environment=Environment.BACKTEST,\n546\t        )\n547\t        return StrategyAssembler.config_snapshot(resolved)\n548\t\n549\t    def _get_date_range(self) -> List[datetime]:\n550\t        \"\"\"\n551\t        Get list of dates to backtest.\n552\t\n553\t        For hourly/intraday: every N hours\n554\t        For daily: every day\n555\t        \"\"\"\n556\t        dates = []\n557\t        current = self.start_date\n558\t\n559\t        # Determine step size based on timeframe\n560\t        if self.timeframe in [\"1h\", \"4h\"]:\n561\t            step_hours = int(self.timeframe.replace(\"h\", \"\"))\n562\t            step = timedelta(hours=step_hours)\n563\t        elif self.timeframe == \"1d\":\n564\t            step = timedelta(days=1)\n565\t        elif self.timeframe == \"1w\":\n566\t            step = timedelta(weeks=1)\n567\t        else:\n568\t            # Default to hourly\n569\t            step = timedelta(hours=1)\n570\t\n571\t        while current <= self.end_date:\n572\t            dates.append(current)\n573\t            current += step\n574\t\n575\t        return dates\n576\t\n577\t    def _get_date_range_for_asset(self, asset: str) -> List[datetime]:\n578\t        \"\"\"\n579\t        Get date range filtered by market hours for specific asset.\n580\t\n581\t        Args:\n582\t            asset: Asset symbol\n583\t\n584\t        Returns:\n585\t            List of valid trading timestamps for this asset\n586\t        \"\"\"\n587\t        all_dates = self._get_date_range()\n588\t\n589\t        if not self.market_hours_filter or self._market_calendar is None:\n590\t            return all_dates\n591\t\n592\t        asset_type = self._asset_types.get(asset, AssetType.UNKNOWN)\n593\t\n594\t        return self._market_calendar.filter_to_trading_hours(all_dates, asset_type)\n595\t\n596\t    def _analyze_and_trade(self, asset: str, current_date: datetime) -> None:\n597\t        \"\"\"\n598\t        Execute analysis and trade for a single asset at a given time.\n599\t\n600\t        NEW FLOW (Hybrid Model with PositionMonitor):\n601\t        1. Check for active position\n602\t        2. If active: strategy.should_exit() → close or update tracking (NO invoke)\n603\t        3. If not active: strategy.generate_signal() → open position if signal != HOLD\n604\t\n605\t        Args:\n606\t            asset: Asset symbol\n607\t            current_date: Current backtest date\n608\t        \"\"\"\n609\t        # Get historical data for analysis (need lookback period)\n610\t        lookback_bars = self.strategy.required_history_bars\n611\t        if lookback_bars <= 0:\n612\t            lookback_bars = 30\n613\t\n614\t        data_start = current_date - timedelta(\n615\t            days=self._bars_to_calendar_days(lookback_bars)\n616\t        )\n617\t\n618\t        df = self.data_provider.get_ohlc(\n619\t            symbol=asset,\n620\t            timeframe=self.timeframe,\n621\t            start_date=data_start,\n622\t            end_date=current_date,\n623\t        )\n624\t\n625\t        if df.empty or len(df) < lookback_bars:\n626\t            logger.warning(\n627\t                f\"Insufficient data for {asset} at {current_date} \"\n628\t                f\"(got {len(df)}, need {lookback_bars})\",\n629\t                extra={\"event_type\": \"backtest_data_warning\", \"symbol\": asset},\n630\t            )\n631\t            return\n632\t\n633\t        current_price = float(df.iloc[-1][\"close\"])\n634\t\n635\t        # Check for active position\n636\t        active_pos = self.position_monitor.get_active_position(asset)\n637\t\n638\t        # Phase 4: Count total candles processed\n639\t        self.total_candles_processed += 1\n640\t\n641\t        if active_pos:\n642\t            # Position active: check exit conditions via strategy\n643\t            should_exit, reason = self.strategy.should_exit(\n644\t                active_pos, current_price, df\n645\t            )\n646\t\n647\t            if should_exit:\n648\t                # Close position\n649\t                self.position_monitor.close_position(active_pos, reason, current_price)\n650\t\n651\t                # Execute close via OrderManager\n652\t                if active_pos.trade_id:\n653\t                    self.order_manager.close_trade(\n654\t                        active_pos.trade_id,\n655\t                        current_price,\n656\t                        environment=Environment.BACKTEST,\n657\t                    )\n658\t                    logger.info(\n659\t                        f\"{asset}: Closed position - {reason} @ ${current_price:.2f}\"\n660\t                    )\n661\t                # Continue to potentially open new position below\n662\t            else:\n663\t                # Position still active: update tracking only (NO INVOKE)\n664\t                prev_close = (\n665\t                    float(df.iloc[-2][\"close\"]) if len(df) >= 2 else current_price\n666\t                )\n667\t                self.position_monitor.update_candle_tracking(\n668\t                    active_pos, current_price, prev_close\n669\t                )\n670\t                return  # Early return - invocation saved\n671\t\n672\t        # No active position (or just closed): generate signal\n673\t        if isinstance(self.strategy, LLMAgentStrategy):\n674\t            kline_data = format_ohlcv_for_agents(df)\n675\t        else:\n676\t            kline_data = df.to_dict(orient=\"records\")\n677\t\n678\t        # Phase 4: Count agent invocations\n679\t        self.agent_invocations += 1\n680\t\n681\t        # Generate thread_id for checkpointing (if enabled)\n682\t        thread_id = None\n683\t        if self.use_checkpointing:\n684\t            from quantagent.strategy.assembler import StrategyAssembler\n685\t\n686\t            thread_id = StrategyAssembler.make_thread_id(\n687\t                self.backtest_run_id, asset, current_date\n688\t            )\n689\t\n690\t        signal_kwargs = {}\n691\t        if thread_id is not None:\n692\t            signal_kwargs[\"thread_id\"] = thread_id\n693\t\n694\t        signal = self.strategy.generate_signal(\n695\t            kline_data, asset, self.timeframe, current_price, **signal_kwargs\n696\t        )\n697\t\n698\t        if signal is None or signal.decision == \"HOLD\":\n699\t            return\n700\t\n701\t        # Execute trade\n702\t        trading_signal = (\n703\t            TradeSignal.LONG if signal.decision == \"LONG\" else TradeSignal.SHORT\n704\t        )\n705\t\n706\t        # Store signal in database\n707\t        db_signal = self._create_signal_from_strategy(\n708\t            asset=asset,\n709\t            decision=trading_signal,\n710\t            confidence=signal.confidence,\n711\t            reasoning=signal.reasoning,\n712\t            current_date=current_date,\n713\t        )\n714\t\n715\t        # Execute order\n716\t        order = self.order_manager.execute_decision(\n717\t            symbol=asset,\n718\t            decision=trading_signal,\n719\t            confidence=signal.confidence,\n720\t            current_price=current_price,\n721\t            environment=Environment.BACKTEST,\n722\t            trigger_signal_id=db_signal.id if db_signal else None,\n723\t        )\n724\t\n725\t        if order and order.filled_quantity and order.filled_quantity > 0:\n726\t            # Create ActivePosition\n727\t            side = (\n728\t                OrderSide.BUY if trading_signal == TradeSignal.LONG else OrderSide.SELL\n729\t            )\n730\t\n731\t            # Get trade_id from order\n732\t            trade_id = None\n733\t            if order.id:\n734\t                trade = self.db.query(Trade).filter(Trade.order_id == order.id).first()\n735\t                if trade:\n736\t                    trade_id = trade.id\n737\t\n738\t            self.position_monitor.open_position(\n739\t                symbol=asset,\n740\t                side=side,\n741\t                entry_price=signal.entry_price or current_price,\n742\t                stop_loss=signal.stop_loss\n743\t                or (\n744\t                    current_price * 0.98\n745\t                    if side == OrderSide.BUY\n746\t                    else current_price * 1.02\n747\t                ),\n748\t                take_profit=signal.take_profit\n749\t                or (\n750\t                    current_price * 1.03\n751\t                    if side == OrderSide.BUY\n752\t                    else current_price * 0.97\n753\t                ),\n754\t                quantity=order.filled_quantity,\n755\t                exit_policy=signal.exit_policy.value,\n756\t                trade_id=trade_id,\n757\t                signal_id=db_signal.id if db_signal else None,\n758\t                trailing_stop_pct=signal.trailing_stop_pct,\n759\t                max_hold_candles=signal.max_hold_candles,\n760\t            )\n761\t\n762\t            logger.info(\n763\t                f\"Executed {trading_signal.value} for {asset} \"\n764\t                f\"@ \"\n765\t                f\"${current_price:.2f}, qty: {order.filled_quantity}\"\n766\t            )\n767\t\n768\t    def _bars_to_calendar_days(self, bars: int) -> int:\n769\t        \"\"\"Convert required trading bars to a calendar-day lookback window.\"\"\"\n770\t        if self.timeframe == \"1d\":\n771\t            return math.ceil(bars * 365 / 252)\n772\t        if self.timeframe == \"1h\":\n773\t            return math.ceil(bars / 6.5 * 7 / 5)\n774\t        if self.timeframe == \"4h\":\n775\t            return math.ceil(bars * 4 / 6.5 * 7 / 5)\n776\t        return bars * 2\n777\t\n778\t    def _parse_decision(self, decision: TradingDecision) -> (TradeSignal, float):\n779\t        \"\"\"Parse decision text to extract LONG/SHORT/HOLD and confidence.\"\"\"\n780\t        decision_upper = decision.decision.upper()\n781\t        signal = TradeSignal.NEUTRAL\n782\t\n783\t        if \"LONG\" in decision_upper or \"BUY\" in decision_upper:\n784\t            signal = TradeSignal.LONG\n785\t        elif \"SHORT\" in decision_upper or \"SELL\" in decision_upper:\n786\t            signal = TradeSignal.SHORT\n787\t        else:\n788\t            signal = TradeSignal.NEUTRAL\n789\t\n790\t        ind = float(decision.confidence)\n791\t\n792\t        return signal, ind\n793\t\n794\t    def _create_signal_from_strategy(\n795\t        self,\n796\t        asset: str,\n797\t        decision: TradeSignal,\n798\t        confidence: float,\n799\t        reasoning: str,\n800\t        current_date: datetime,\n801\t    ) -> Optional[Signal]:\n802\t        \"\"\"Create Signal record from strategy output (simplified).\"\"\"\n803\t        from quantagent import settings\n804\t\n805\t        try:\n806\t            signal = Signal(\n807\t                symbol=asset,\n808\t                signal=decision,\n809\t                confidence=confidence,\n810\t                timeframe=self.timeframe,\n811\t                analysis_summary=reasoning,\n812\t                generated_at=current_date,\n813\t                environment=Environment.BACKTEST,\n814\t                backtest_run_id=self.backtest_run_id,\n815\t                model_provider=self.config.get(\"agent_llm_provider\", settings.AGENT_LLM_PROVIDER),\n816\t                model_name=self.config.get(\"agent_llm_model\", settings.AGENT_LLM_MODEL),\n817\t                temperature=self.config.get(\"agent_llm_temperature\", settings.AGENT_LLM_TEMPERATURE),\n818\t            )\n819\t\n820\t            self.db.add(signal)\n821\t            self.db.commit()\n822\t            return signal\n823\t\n824\t        except Exception as e:\n825\t            logger.error(f\"Error creating signal: {e}\", exc_info=True)\n826\t            return None\n827\t\n828\t    def _create_signal(\n829\t        self,\n830\t        asset: str,\n831\t        decision: TradeSignal,\n832\t        confidence: float,\n833\t        result: Dict,\n834\t        current_date: datetime,\n835\t        thread_id: Optional[str] = None,\n836\t    ) -> Optional[Signal]:\n837\t        \"\"\"Create and persist Signal record.\"\"\"\n838\t        try:\n839\t            # Extract technical indicators\n840\t            rsi = None\n841\t            macd = None\n842\t            stochastic = None\n843\t            roc = None\n844\t            williams_r = None\n845\t            pattern = None\n846\t            trend = None\n847\t\n848\t            if \"rsi\" in result and result[\"rsi\"]:\n849\t                rsi = (\n850\t                    float(result[\"rsi\"][-1])\n851\t                    if isinstance(result[\"rsi\"], list)\n852\t                    else float(result[\"rsi\"])\n853\t                )\n854\t\n855\t            if \"macd\" in result and result[\"macd\"]:\n856\t                macd = (\n857\t                    float(result[\"macd\"][-1])\n858\t                    if isinstance(result[\"macd\"], list)\n859\t                    else float(result[\"macd\"])\n860\t                )\n861\t\n862\t            indicator_report = result.get(\"indicator_report\")\n863\t            if indicator_report and hasattr(indicator_report, \"rsi\"):\n864\t                rsi = float(indicator_report.rsi)\n865\t            if indicator_report and hasattr(indicator_report, \"macd\"):\n866\t                macd = float(indicator_report.macd)\n867\t            if indicator_report and hasattr(indicator_report, \"stochastic\"):\n868\t                stochastic = float(indicator_report.stochastic)\n869\t            if indicator_report and hasattr(indicator_report, \"roc\"):\n870\t                roc = float(indicator_report.roc)\n871\t            if indicator_report and hasattr(indicator_report, \"willr\"):\n872\t                williams_r = float(indicator_report.willr)\n873\t\n874\t            # Get pattern and trend from reports\n875\t            pattern_report = result.get(\"pattern_report\")\n876\t            if pattern_report and hasattr(pattern_report, \"primary_pattern\"):\n877\t                pattern = pattern_report.primary_pattern\n878\t\n879\t            trend_report = result.get(\"trend_report\")\n880\t            if trend_report and hasattr(trend_report, \"trend_direction\"):\n881\t                trend = trend_report.trend_direction\n882\t\n883\t            # Create signal\n884\t            from quantagent import settings\n885\t\n886\t            signal = Signal(\n887\t                symbol=asset,\n888\t                signal=decision,\n889\t                confidence=confidence,\n890\t                timeframe=self.timeframe,\n891\t                rsi=rsi,\n892\t                macd=macd,\n893\t                stochastic=stochastic,\n894\t                roc=roc,\n895\t                williams_r=williams_r,\n896\t                pattern=pattern,\n897\t                trend=trend,\n898\t                analysis_summary=result.get(\"reasoning\", \"\"),\n899\t                generated_at=current_date,\n900\t                environment=Environment.BACKTEST,\n901\t                backtest_run_id=self.backtest_run_id,\n902\t                thread_id=thread_id,\n903\t                model_provider=self.config.get(\"agent_llm_provider\", settings.AGENT_LLM_PROVIDER),\n904\t                model_name=self.config.get(\"agent_llm_model\", settings.AGENT_LLM_MODEL),\n905\t                temperature=self.config.get(\"agent_llm_temperature\", settings.AGENT_LLM_TEMPERATURE),\n906\t            )\n907\t\n908\t            self.db.add(signal)\n909\t            self.db.commit()\n910\t\n911\t            return signal\n912\t\n913\t        except Exception as e:\n914\t            logger.error(\n915\t                f\"Error creating signal: {e}\",\n916\t                exc_info=True,\n917\t                extra={\"event_type\": \"backtest_error\"},\n918\t            )\n919\t            return None\n920\t\n921\t    def _record_equity(self, current_date: datetime) -> None:\n922\t        \"\"\"Record equity curve data point.\"\"\"\n923\t        total_value = self.portfolio.get_total_value()\n924\t\n925\t        self.equity_curve.append(\n926\t            {\n927\t                \"date\": current_date,\n928\t                \"equity\": total_value,\n929\t                \"cash\": self.portfolio.cash,\n930\t                \"positions_value\": total_value - self.portfolio.cash,\n931\t            }\n932\t        )\n933\t\n934\t    def _calculate_metrics(self) -> BacktestMetrics:\n935\t        \"\"\"\n936\t        Calculate backtest performance metrics.\n937\t\n938\t        Metrics:\n939\t        - Win rate: % of winning trades\n940\t        - Profit factor: sum(wins) / abs(sum(losses))\n941\t        - Sharpe ratio: (return - risk_free) / volatility\n942\t        - Max drawdown: worst peak-to-trough decline\n943\t        - Total P&L: sum of all trade P&L\n944\t        \"\"\"\n945\t        # Get all trades from database for this backtest\n946\t        trades = (\n947\t            self.db.query(Trade)\n948\t            .filter(\n949\t                Trade.environment == Environment.BACKTEST,\n950\t                Trade.opened_at >= self.start_date,\n951\t                Trade.opened_at <= self.end_date,\n952\t            )\n953\t            .all()\n954\t        )\n955\t\n956\t        if self._replay_trade_order_ids is not None:\n957\t            trades = [\n958\t                trade\n959\t                for trade in trades\n960\t                if trade.order_id in self._replay_trade_order_ids\n961\t            ]\n962\t\n963\t        if not trades:\n964\t            logger.warning(\n965\t                \"No trades executed during backtest\",\n966\t                extra={\"event_type\": \"backtest_warning\"},\n967\t            )\n968\t\n969\t            # Phase 4: Even with no trades, calculate MDA if positions were opened\n970\t            mda, accuracy_by_candle = self._calculate_directional_accuracy()\n971\t            close_reasons = self._calculate_close_reasons()\n972\t\n973\t            invocations_saved = self.total_candles_processed - self.agent_invocations\n974\t            invocation_reduction_pct = (\n975\t                (invocations_saved / self.total_candles_processed * 100)\n976\t                if self.total_candles_processed > 0\n977\t                else 0.0\n978\t            )\n979\t\n980\t            return BacktestMetrics(\n981\t                total_trades=0,\n982\t                winning_trades=0,\n983\t                losing_trades=0,\n984\t                win_rate=0.0,\n985\t                profit_factor=0.0,\n986\t                sharpe_ratio=0.0,\n987\t                max_drawdown=0.0,\n988\t                total_pnl=0.0,\n989\t                avg_win=0.0,\n990\t                avg_loss=0.0,\n991\t                largest_win=0.0,\n992\t                largest_loss=0.0,\n993\t                total_return_pct=0.0,\n994\t                agent_invocations=self.agent_invocations,\n995\t                invocations_saved=invocations_saved,\n996\t                invocation_reduction_pct=invocation_reduction_pct,\n997\t                mean_directional_accuracy=mda,\n998\t                accuracy_by_candle=accuracy_by_candle,\n999\t                close_reasons=close_reasons,\n1000\t            )\n1001\t\n1002\t        # Calculate basic metrics\n1003\t        total_trades = len(trades)\n1004\t        winning_trades = [t for t in trades if t.pnl and float(t.pnl) > 0]\n1005\t        losing_trades = [t for t in trades if t.pnl and float(t.pnl) < 0]\n1006\t\n1007\t        total_wins = sum(float(t.pnl) for t in winning_trades)\n1008\t        total_losses = abs(sum(float(t.pnl) for t in losing_trades))\n1009\t\n1010\t        # Win rate\n1011\t        win_rate = len(winning_trades) / total_trades if total_trades > 0 else 0.0\n1012\t\n1013\t        # Profit factor\n1014\t        profit_factor = (\n1015\t            total_wins / total_losses\n1016\t            if total_losses > 0\n1017\t            else float(\"inf\") if total_wins > 0 else 0.0\n1018\t        )\n1019\t\n1020\t        # Total P&L\n1021\t        total_pnl = sum(float(t.pnl) for t in trades if t.pnl)\n1022\t\n1023\t        # Average win/loss\n1024\t        avg_win = total_wins / len(winning_trades) if winning_trades else 0.0\n1025\t        avg_loss = total_losses / len(losing_trades) if losing_trades else 0.0\n1026\t\n1027\t        # Largest win/loss\n1028\t        largest_win = max((float(t.pnl) for t in winning_trades), default=0.0)\n1029\t        largest_loss = min((float(t.pnl) for t in losing_trades), default=0.0)\n1030\t\n1031\t        # Total return %\n1032\t        total_return_pct = (\n1033\t            (total_pnl / self.initial_capital) * 100\n1034\t            if self.initial_capital > 0\n1035\t            else 0.0\n1036\t        )\n1037\t\n1038\t        # Sharpe ratio\n1039\t        sharpe_ratio = self._calculate_sharpe_ratio()\n1040\t\n1041\t        # Max drawdown\n1042\t        max_drawdown = self._calculate_max_drawdown()\n1043\t\n1044\t        # Phase 4: Calculate MDA and accuracy metrics\n1045\t        mda, accuracy_by_candle = self._calculate_directional_accuracy()\n1046\t\n1047\t        # Phase 4: Calculate close reasons distribution\n1048\t        close_reasons = self._calculate_close_reasons()\n1049\t\n1050\t        # Phase 4: Calculate invocation reduction\n1051\t        invocations_saved = self.total_candles_processed - self.agent_invocations\n1052\t        invocation_reduction_pct = (\n1053\t            (invocations_saved / self.total_candles_processed * 100)\n1054\t            if self.total_candles_processed > 0\n1055\t            else 0.0\n1056\t        )\n1057\t\n1058\t        return BacktestMetrics(\n1059\t            total_trades=total_trades,\n1060\t            winning_trades=len(winning_trades),\n1061\t            losing_trades=len(losing_trades),\n1062\t            win_rate=win_rate,\n1063\t            profit_factor=profit_factor,\n1064\t            sharpe_ratio=sharpe_ratio,\n1065\t            max_drawdown=max_drawdown,\n1066\t            total_pnl=total_pnl,\n1067\t            avg_win=avg_win,\n1068\t            avg_loss=avg_loss,\n1069\t            largest_win=largest_win,\n1070\t            largest_loss=largest_loss,\n1071\t            total_return_pct=total_return_pct,\n1072\t            agent_invocations=self.agent_invocations,\n1073\t            invocations_saved=invocations_saved,\n1074\t            invocation_reduction_pct=invocation_reduction_pct,\n1075\t            mean_directional_accuracy=mda,\n1076\t            accuracy_by_candle=accuracy_by_candle,\n1077\t            close_reasons=close_reasons,\n1078\t        )\n1079\t\n1080\t    def _calculate_sharpe_ratio(self, risk_free_rate: float = 0.02) -> float:\n1081\t        \"\"\"\n1082\t        Calculate Sharpe ratio.\n1083\t\n1084\t        Formula: (return - risk_free) / volatility\n1085\t\n1086\t        Args:\n1087\t            risk_free_rate: Annual risk-free rate (default: 2%)\n1088\t\n1089\t        Returns:\n1090\t            Sharpe ratio\n1091\t        \"\"\"\n1092\t        if len(self.equity_curve) < 2:\n1093\t            return 0.0\n1094\t\n1095\t        # Calculate returns\n1096\t        equity_series = pd.Series([e[\"equity\"] for e in self.equity_curve])\n1097\t        returns = equity_series.pct_change().dropna()\n1098\t\n1099\t        if len(returns) == 0 or returns.std() == 0:\n1100\t            return 0.0\n1101\t\n1102\t        # Annualize based on timeframe\n1103\t        periods_per_year = self._get_periods_per_year()\n1104\t\n1105\t        # Calculate Sharpe\n1106\t        excess_return = returns.mean() - (risk_free_rate / periods_per_year)\n1107\t        sharpe = (excess_return / returns.std()) * np.sqrt(periods_per_year)\n1108\t\n1109\t        return float(sharpe)\n1110\t\n1111\t    def _calculate_max_drawdown(self) -> float:\n1112\t        \"\"\"\n1113\t        Calculate maximum drawdown.\n1114\t\n1115\t        Formula: max((peak - trough) / peak)\n1116\t\n1117\t        Returns:\n1118\t            Max drawdown as decimal (e.g., 0.15 = 15%)\n1119\t        \"\"\"\n1120\t        if len(self.equity_curve) < 2:\n1121\t            return 0.0\n1122\t\n1123\t        equity_series = pd.Series([e[\"equity\"] for e in self.equity_curve])\n1124\t\n1125\t        # Calculate running maximum\n1126\t        running_max = equity_series.expanding().max()\n1127\t\n1128\t        # Calculate drawdown\n1129\t        drawdown = (equity_series - running_max) / running_max\n1130\t\n1131\t        # Maximum drawdown (most negative)\n1132\t        max_dd = abs(drawdown.min())\n1133\t\n1134\t        return float(max_dd)\n1135\t\n1136\t    def _calculate_directional_accuracy(self) -> tuple[float, Dict[int, float]]:\n1137\t        \"\"\"\n1138\t        Calculate Mean Directional Accuracy (MDA) and per-candle accuracy.\n1139\t\n1140\t        MDA = (correct_candles / total_candles_evaluated)\n1141\t\n1142\t        Returns:\n1143\t            Tuple of (mean_directional_accuracy, accuracy_by_candle)\n1144\t        \"\"\"\n1145\t        query = self.db.query(ActivePosition).filter(\n1146\t            ActivePosition.is_active.is_(False),\n1147\t            ActivePosition.decision_timestamp >= self.start_date,\n1148\t            ActivePosition.decision_timestamp <= self.end_date,\n1149\t        )\n1150\t\n1151\t        if self.backtest_run_id is not None:\n1152\t            query = query.filter(ActivePosition.backtest_run_id == self.backtest_run_id)\n1153\t\n1154\t        positions = query.all()\n1155\t\n1156\t        if not positions:\n1157\t            return 0.0, {}\n1158\t\n1159\t        # Track correct predictions per candle index\n1160\t        correct_by_candle = {}\n1161\t        total_by_candle = {}\n1162\t\n1163\t        for pos in positions:\n1164\t            expected_direction = \"up\" if pos.side == OrderSide.BUY else \"down\"\n1165\t\n1166\t            # Evaluate up to prediction_horizon candles\n1167\t            for i, direction in enumerate(\n1168\t                pos.candles_direction[: pos.prediction_horizon]\n1169\t            ):\n1170\t                candle_idx = i + 1  # 1-indexed (candle 1, 2, 3...)\n1171\t\n1172\t                if candle_idx not in correct_by_candle:\n1173\t                    correct_by_candle[candle_idx] = 0\n1174\t                    total_by_candle[candle_idx] = 0\n1175\t\n1176\t                total_by_candle[candle_idx] += 1\n1177\t                if direction == expected_direction:\n1178\t                    correct_by_candle[candle_idx] += 1\n1179\t\n1180\t        # Calculate accuracy per candle\n1181\t        accuracy_by_candle = {\n1182\t            candle: correct_by_candle[candle] / total_by_candle[candle]\n1183\t            for candle in sorted(total_by_candle.keys())\n1184\t        }\n1185\t\n1186\t        # Calculate overall MDA\n1187\t        total_correct = sum(correct_by_candle.values())\n1188\t        total_candles = sum(total_by_candle.values())\n1189\t        mda = total_correct / total_candles if total_candles > 0 else 0.0\n1190\t\n1191\t        return mda, accuracy_by_candle\n1192\t\n1193\t    def _calculate_close_reasons(self) -> Dict[str, int]:\n1194\t        \"\"\"\n1195\t        Calculate distribution of position close reasons.\n1196\t\n1197\t        Returns:\n1198\t            Dict mapping close_reason to count\n1199\t        \"\"\"\n1200\t        query = self.db.query(ActivePosition).filter(\n1201\t            ActivePosition.is_active.is_(False),\n1202\t            ActivePosition.decision_timestamp >= self.start_date,\n1203\t            ActivePosition.decision_timestamp <= self.end_date,\n1204\t        )\n1205\t\n1206\t        if self.backtest_run_id is not None:\n1207\t            query = query.filter(ActivePosition.backtest_run_id == self.backtest_run_id)\n1208\t\n1209\t        positions = query.all()\n1210\t\n1211\t        close_reasons = {}\n1212\t        for pos in positions:\n1213\t            reason = pos.close_reason or \"unknown\"\n1214\t            close_reasons[reason] = close_reasons.get(reason, 0) + 1\n1215\t\n1216\t        return close_reasons\n1217\t\n1218\t    def _get_periods_per_year(self) -> int:\n1219\t        \"\"\"Get number of periods per year based on timeframe.\"\"\"\n1220\t        if self.timeframe == \"1h\":\n1221\t            return 252 * 6.5  # Trading days * hours per day\n1222\t        elif self.timeframe == \"4h\":\n1223\t            return 252 * 1.625  # Approx 1.6 periods per day\n1224\t        elif self.timeframe == \"1d\":\n1225\t            return 252\n1226\t        elif self.timeframe == \"1w\":\n1227\t            return 52\n1228\t        else:\n1229\t            return 252\n1230\t\n1231\t    def _update_backtest_run(self, metrics: BacktestMetrics) -> None:\n1232\t        \"\"\"Update BacktestRun record with final metrics.\"\"\"\n1233\t        if not self.backtest_run_id:\n1234\t            return\n1235\t\n1236\t        run = (\n1237\t            self.db.query(BacktestRun)\n1238\t            .filter(BacktestRun.id == self.backtest_run_id)\n1239\t            .first()\n1240\t        )\n1241\t\n1242\t        if run:\n1243\t            run.total_trades = metrics.total_trades\n1244\t            run.win_rate = metrics.win_rate\n1245\t            run.profit_factor = metrics.profit_factor\n1246\t            run.sharpe_ratio = metrics.sharpe_ratio\n1247\t            run.max_drawdown = metrics.max_drawdown\n1248\t            run.total_pnl = Decimal(str(metrics.total_pnl))\n1249\t\n1250\t            self.db.commit()\n1251\t            logger.info(\n1252\t                f\"Updated backtest run #{self.backtest_run_id} with final metrics\",\n1253\t                extra={\"event_type\": \"backtest_complete\"},\n1254\t            )\n1255\t\n1256\t    def get_equity_curve(self) -> pd.DataFrame:\n1257\t        \"\"\"\n1258\t        Get equity curve as DataFrame.\n1259\t\n1260\t        Returns:\n1261\t            DataFrame with columns: date, equity, cash, positions_value\n1262\t        \"\"\"\n1263\t        return pd.DataFrame(self.equity_curve)\n1264\t\n1265\t    def __del__(self):\n1266\t        \"\"\"Cleanup database session if we own it.\"\"\"\n1267\t        if self._own_session and self.db:\n1268\t            self.db.close()\n1269\t"}]},"parent_tool_use_id":null,"session_id":"0ba6b8a9-0956-46b4-a5ab-2f80c3a37c45","uuid":"dfb7511a-5b42-4549-a0f8-3bdb2808b5a4","timestamp":"2026-05-12T02:40:51.801Z","tool_use_result":{"type":"text","file":{"filePath":"/home/azureuser/repos/projects/QuantAgent/quantagent/backtesting/backtest.py","content":"\"\"\"Backtesting engine for strategy validation.\"\"\"\n\nimport logging\nimport math\nfrom dataclasses import dataclass\nfrom datetime import datetime, timedelta\nfrom decimal import Decimal\nfrom typing import Dict, List, Optional\n\nimport numpy as np\nimport pandas as pd\nfrom sqlalchemy.orm import Session\n\nfrom quantagent.agent_models import TradingDecision\nfrom quantagent.data.asset_types import AssetType, get_asset_type\nfrom quantagent.data.market_calendar import get_market_calendar\nfrom quantagent.data.provider import DataProvider\nfrom quantagent.database import SessionLocal\nfrom quantagent.models import (\n    ActivePosition,\n    BacktestRun,\n    Environment,\n    OrderSide,\n    Signal,\n    Trade,\n    TradeSignal,\n)\nfrom quantagent.static_util import format_ohlcv_for_agents\nfrom quantagent.strategy.assembler import StrategyAssembler\nfrom quantagent.strategy.base import TradingStrategy\nfrom quantagent.strategy.llm_agent_strategy import LLMAgentStrategy\nfrom quantagent.trading.position_monitor import PositionMonitor\n\nlogger = logging.getLogger(__name__)\n\n\n@dataclass\nclass BacktestMetrics:\n    \"\"\"Backtest performance metrics.\"\"\"\n\n    total_trades: int\n    winning_trades: int\n    losing_trades: int\n    win_rate: float\n    profit_factor: float\n    sharpe_ratio: float\n    max_drawdown: float\n    total_pnl: float\n    avg_win: float\n    avg_loss: float\n    largest_win: float\n    largest_loss: float\n    total_return_pct: float\n\n    # Phase 4: Active Position Monitoring metrics\n    agent_invocations: int = 0\n    invocations_saved: int = 0\n    invocation_reduction_pct: float = 0.0\n    mean_directional_accuracy: float = 0.0\n    accuracy_by_candle: Dict[int, float] = None\n    close_reasons: Dict[str, int] = None\n\n    def __post_init__(self):\n        if self.accuracy_by_candle is None:\n            self.accuracy_by_candle = {}\n        if self.close_reasons is None:\n            self.close_reasons = {}\n\n\nclass Backtest:\n    \"\"\"\n    Backtesting engine for validating trading strategies.\n\n    Workflow:\n    1. Loop through historical dates\n    2. Fetch OHLC data for each date using DataProvider (cached)\n    3. Execute analysis using TradingGraph\n    4. Simulate trade execution using OrderManager\n    5. Track portfolio performance\n    6. Calculate and persist metrics\n\n    Features:\n    - Uses DataProvider for 10x faster data access (caching)\n    - Executes same agents as live trading\n    - Stores full provenance (config snapshot, model metadata)\n    - Supports replay with different risk/portfolio profiles\n    \"\"\"\n\n    def __init__(\n        self,\n        start_date: datetime,\n        end_date: datetime,\n        assets: List[str],\n        timeframe: str = \"1h\",\n        initial_capital: float = 100000.0,\n        config: Optional[Dict] = None,\n        db_session: Optional[Session] = None,\n        use_checkpointing: bool = False,\n        strategy: Optional[TradingStrategy] = None,\n    ):\n        \"\"\"\n        Initialize Backtest.\n\n        Args:\n            start_date: Start date for backtest\n            end_date: End date for backtest\n            assets: List of asset symbols (e.g., [\"BTC\", \"SPX\", \"CL\"])\n            timeframe: Timeframe for analysis (e.g., \"1h\", \"4h\", \"1d\")\n            initial_capital: Starting portfolio value\n            config: Configuration dict (portfolio/risk params, model settings)\n            db_session: Database session (creates new if None)\n            use_checkpointing: Enable LangGraph checkpointing for state persistence\n            strategy: Optional TradingStrategy. If None, uses LLMAgentStrategy with TradingGraph\n        \"\"\"\n        self.start_date = start_date\n        self.end_date = end_date\n        self.assets = assets\n        self.timeframe = timeframe\n        self.initial_capital = initial_capital\n        self.config = config or {}\n        self.use_checkpointing = use_checkpointing\n\n        # Database\n        self.db = db_session or SessionLocal()\n        self._own_session = db_session is None\n\n        # Data provider (caching layer)\n        self.data_provider = DataProvider(self.db)\n\n        # Resolve config via StrategyAssembler and build components (unify DB session)\n        from quantagent import settings\n\n        resolved = StrategyAssembler.from_snapshot(\n            {\n                \"initial_cash\": initial_capital,\n                \"base_position_pct\": self.config.get(\"base_position_pct\", settings.TRADING_BASE_POSITION_PCT),\n                \"max_daily_loss_pct\": self.config.get(\"max_daily_loss_pct\", settings.TRADING_MAX_DAILY_LOSS_PCT),\n                \"max_position_pct\": self.config.get(\"max_position_pct\", settings.TRADING_MAX_POSITION_PCT),\n                \"slippage_pct\": self.config.get(\"slippage_pct\", settings.TRADING_SLIPPAGE_PCT),\n                # Normalize model fields into generic ones; accept both\n                \"model_provider\": self.config.get(\n                    \"agent_llm_provider\", self.config.get(\"model_provider\", settings.AGENT_LLM_PROVIDER)\n                ),\n                \"model_name\": self.config.get(\n                    \"agent_llm_model\", self.config.get(\"model_name\", settings.AGENT_LLM_MODEL)\n                ),\n                \"temperature\": self.config.get(\n                    \"agent_llm_temperature\", self.config.get(\"temperature\", settings.AGENT_LLM_TEMPERATURE)\n                ),\n                \"use_checkpointing\": use_checkpointing,\n                \"universe\": self.config.get(\"universe\", settings.get_trading_universe()),\n            },\n            environment=Environment.BACKTEST,\n        )\n        components = StrategyAssembler.build_components(resolved, db_session=self.db)\n\n        # Trading graph (analysis engine)\n        self.trading_graph = components.graph\n\n        # Trading strategy (use provided or default to LLMAgentStrategy)\n        self.strategy = strategy or LLMAgentStrategy(self.trading_graph)\n\n        # Position monitor for active position tracking\n        self.position_monitor = PositionMonitor(self.db)\n\n        # Trading components\n        self.portfolio = components.portfolio_manager\n        self.position_sizer = components.position_sizer\n        self.risk_manager = components.risk_manager\n        self.broker = components.broker\n        self.order_manager = components.order_manager\n\n        # Backtest state\n        self.current_date = start_date\n        self.backtest_run_id: Optional[int] = None\n        self._replay_trade_order_ids: Optional[set[int]] = None\n        self.trades: List[Trade] = []\n        self.equity_curve: List[Dict] = []\n\n        # Phase 4: Invocation tracking\n        self.agent_invocations = 0\n        self.total_candles_processed = 0\n\n        # Market hours filtering\n        self.market_hours_filter = self.config.get(\"market_hours_filter\", True)\n        self._market_calendar = (\n            get_market_calendar() if self.market_hours_filter else None\n        )\n\n        # Cache asset types for each symbol\n        self._asset_types: Dict[str, AssetType] = {\n            asset: get_asset_type(asset) for asset in assets\n        }\n\n    def run(self, name: Optional[str] = None) -> BacktestMetrics:\n        \"\"\"\n        Run backtest and return metrics.\n\n        Args:\n            name: Optional name for this backtest run\n\n        Returns:\n            BacktestMetrics with performance statistics\n        \"\"\"\n        logger.info(\n            f\"Starting backtest: {self.start_date} to {self.end_date}\",\n            extra={\"event_type\": \"backtest_start\", \"environment\": \"backtest\"},\n        )\n        logger.info(\n            f\"Assets: {self.assets}, Timeframe: {self.timeframe}\",\n            extra={\"event_type\": \"backtest_start\"},\n        )\n        logger.info(\n            f\"Initial capital: ${self.initial_capital:,.2f}\",\n            extra={\"event_type\": \"backtest_start\"},\n        )\n        logger.info(\n            f\"Market hours filter: {self.market_hours_filter}\",\n            extra={\"event_type\": \"backtest_start\"},\n        )\n\n        self._replay_trade_order_ids = None\n\n        # Create backtest run record\n        self._create_backtest_run(name)\n\n        # Process each asset with its filtered date range\n        total_periods = 0\n        for asset in self.assets:\n            asset_dates = self._get_date_range_for_asset(asset)\n            total_periods += len(asset_dates)\n\n            asset_type = self._asset_types.get(asset, AssetType.UNKNOWN)\n            logger.info(\n                f\"Asset {asset} ({asset_type.value}): {len(asset_dates)} analysis periods\",\n                extra={\"event_type\": \"backtest_start\"},\n            )\n\n        logger.info(\n            f\"Backtesting {total_periods} total analysis periods\",\n            extra={\"event_type\": \"backtest_start\"},\n        )\n\n        # Track progress across all periods\n        periods_completed = 0\n\n        # Loop through assets (outer) and their dates (inner)\n        for asset in self.assets:\n            asset_dates = self._get_date_range_for_asset(asset)\n\n            for i, current_date in enumerate(asset_dates):\n                self.current_date = current_date\n\n                # Reset daily P&L tracking at start of each day\n                if i == 0 or current_date.date() != asset_dates[i - 1].date():\n                    self.risk_manager.reset_daily_tracker()\n\n                try:\n                    self._analyze_and_trade(asset, current_date)\n                except Exception as e:\n                    logger.error(\n                        f\"Error analyzing {asset} at {current_date}: {e}\",\n                        exc_info=True,\n                        extra={\"event_type\": \"backtest_error\", \"symbol\": asset},\n                    )\n                    continue\n\n                # Record equity at end of period\n                self._record_equity(current_date)\n\n                periods_completed += 1\n\n                # Log progress\n                if periods_completed % 100 == 0 or periods_completed == total_periods:\n                    progress = (periods_completed / total_periods) * 100\n                    logger.info(\n                        f\"Progress: {progress:.1f}% ({periods_completed}/{total_periods})\",\n                        extra={\"event_type\": \"backtest_progress\"},\n                    )\n\n        # Calculate metrics\n        metrics = self._calculate_metrics()\n\n        # Update backtest run with results\n        self._update_backtest_run(metrics)\n\n        logger.info(\n            f\"Backtest complete: {metrics.total_trades} trades, Win rate: {metrics.win_rate:.2%}\",\n            extra={\"event_type\": \"backtest_end\", \"environment\": \"backtest\"},\n        )\n        logger.info(\n            f\"Total P&L: ${metrics.total_pnl:,.2f} ({metrics.total_return_pct:.2%})\",\n            extra={\"event_type\": \"backtest_end\"},\n        )\n\n        return metrics\n\n    def run_replay(\n        self,\n        source_run_id: int,\n        name: Optional[str] = None,\n    ) -> \"BacktestMetrics\":\n        \"\"\"\n        Execute replay using signals stored from source_run_id.\n\n        No LLM calls are made — signals are read from the DB and re-applied with\n        the current portfolio/risk config (set at Backtest init time).\n\n        Args:\n            source_run_id: ID of the completed BacktestRun to replay.\n            name: Optional name for the new replay BacktestRun record.\n\n        Returns:\n            BacktestMetrics from replay execution.\n\n        Raises:\n            ValueError: If source run does not exist or has no scoped signals.\n        \"\"\"\n        source_run = (\n            self.db.query(BacktestRun).filter(BacktestRun.id == source_run_id).first()\n        )\n        if source_run is None:\n            raise ValueError(f\"Source BacktestRun {source_run_id} not found\")\n\n        # Load only signals scoped to this source run — prevents cross-run contamination.\n        signals = (\n            self.db.query(Signal)\n            .filter(Signal.backtest_run_id == source_run_id)\n            .all()\n        )\n\n        logger.info(\n            f\"[REPLAY] Starting replay: source={source_run_id}, signals={len(signals)}\",\n            extra={\"event_type\": \"replay_start\"},\n        )\n\n        if not signals:\n            raise ValueError(\n                f\"No stored signals found for source run {source_run_id}. \"\n                \"Run the source backtest first (signals must have backtest_run_id set).\"\n            )\n\n        # Build lookup: (symbol, generated_at) -> signal\n        signal_map: Dict = {}\n        for sig in signals:\n            signal_map[(sig.symbol, sig.generated_at)] = sig\n\n        # Reset in-memory state\n        self.equity_curve = []\n        self.trades = []\n        self.agent_invocations = 0\n        self.total_candles_processed = 0\n        self._replay_trade_order_ids = set()\n\n        # Override date/asset/timeframe from source run so replay matches it exactly\n        self.start_date = source_run.start_date\n        self.end_date = source_run.end_date\n        self.assets = source_run.assets\n        self.timeframe = source_run.timeframe\n\n        self._create_backtest_run(\n            name or f\"Replay_{source_run_id}_{datetime.now().strftime('%Y%m%d_%H%M%S')}\",\n            replay_source_run_id=source_run_id,\n        )\n\n        for asset in self.assets:\n            asset_dates = self._get_date_range_for_asset(asset)\n\n            for i, current_date in enumerate(asset_dates):\n                self.current_date = current_date\n\n                if i == 0 or current_date.date() != asset_dates[i - 1].date():\n                    self.risk_manager.reset_daily_tracker()\n\n                try:\n                    self._replay_and_trade(asset, current_date, signal_map)\n                except Exception as e:\n                    logger.error(\n                        f\"[REPLAY] Error replaying {asset} at {current_date}: {e}\",\n                        exc_info=True,\n                        extra={\"event_type\": \"replay_error\", \"symbol\": asset},\n                    )\n                    continue\n\n                self._record_equity(current_date)\n\n        metrics = self._calculate_metrics()\n        self._update_backtest_run(metrics)\n\n        logger.info(\n            f\"[REPLAY] Completed: {metrics.total_trades} trades, P&L ${metrics.total_pnl:,.2f}\",\n            extra={\"event_type\": \"replay_end\"},\n        )\n        return metrics\n\n    def _replay_and_trade(\n        self, asset: str, current_date: datetime, signal_map: Dict\n    ) -> None:\n        \"\"\"Execute a single candle in replay mode — uses stored signal, no LLM call.\"\"\"\n        lookback_days = 30\n        data_start = current_date - timedelta(days=lookback_days)\n        df = self.data_provider.get_ohlc(\n            symbol=asset,\n            timeframe=self.timeframe,\n            start_date=data_start,\n            end_date=current_date,\n        )\n\n        if df.empty or len(df) < 2:\n            return\n\n        current_price = float(df.iloc[-1][\"close\"])\n        active_pos = self.position_monitor.get_active_position(asset)\n        self.total_candles_processed += 1\n\n        if active_pos:\n            should_exit, reason = self.strategy.should_exit(\n                active_pos, current_price, df\n            )\n            if should_exit:\n                self.position_monitor.close_position(active_pos, reason, current_price)\n                if active_pos.trade_id:\n                    self.order_manager.close_trade(\n                        active_pos.trade_id,\n                        current_price,\n                        environment=Environment.BACKTEST,\n                    )\n                    logger.debug(\n                        f\"[REPLAY] {asset}: Closed position ({reason}) @ ${current_price:.2f}\"\n                    )\n            else:\n                prev_close = float(df.iloc[-2][\"close\"])\n                self.position_monitor.update_candle_tracking(\n                    active_pos, current_price, prev_close\n                )\n                return\n\n        stored_signal = signal_map.get((asset, current_date))\n        if stored_signal is None or stored_signal.signal == TradeSignal.NEUTRAL:\n            return\n\n        logger.debug(\n            f\"[REPLAY] {asset} @ {current_date}: using stored signal {stored_signal.id}\"\n        )\n\n        trading_signal = stored_signal.signal\n        order = self.order_manager.execute_decision(\n            symbol=asset,\n            decision=trading_signal,\n            confidence=stored_signal.confidence,\n            current_price=current_price,\n            environment=Environment.BACKTEST,\n            trigger_signal_id=stored_signal.id,\n        )\n\n        if order and order.filled_quantity and order.filled_quantity > 0:\n            if order.id is not None and self._replay_trade_order_ids is not None:\n                self._replay_trade_order_ids.add(order.id)\n\n            side = (\n                OrderSide.BUY if trading_signal == TradeSignal.LONG else OrderSide.SELL\n            )\n            trade_id = None\n            if order.id:\n                trade = self.db.query(Trade).filter(Trade.order_id == order.id).first()\n                if trade:\n                    trade_id = trade.id\n\n            self.position_monitor.open_position(\n                symbol=asset,\n                side=side,\n                entry_price=current_price,\n                stop_loss=(\n                    current_price * 0.98\n                    if side == OrderSide.BUY\n                    else current_price * 1.02\n                ),\n                take_profit=(\n                    current_price * 1.03\n                    if side == OrderSide.BUY\n                    else current_price * 0.97\n                ),\n                quantity=order.filled_quantity,\n                exit_policy=\"sl_tp_only\",\n                trade_id=trade_id,\n                signal_id=stored_signal.id,\n            )\n\n            logger.info(\n                f\"[REPLAY] Executed {trading_signal.value} for {asset} \"\n                f\"@ ${current_price:.2f}, qty: {order.filled_quantity}\",\n                extra={\"event_type\": \"replay_trade\", \"symbol\": asset},\n            )\n\n    def _create_backtest_run(\n        self, name: Optional[str], replay_source_run_id: Optional[int] = None\n    ) -> None:\n        \"\"\"Create BacktestRun record in database.\"\"\"\n        run = BacktestRun(\n            name=name or f\"Backtest_{datetime.now().strftime('%Y%m%d_%H%M%S')}\",\n            timeframe=self.timeframe,\n            assets=self.assets,\n            start_date=self.start_date,\n            end_date=self.end_date,\n            config_snapshot=self._build_config_snapshot(),\n            replay_source_run_id=replay_source_run_id,\n        )\n\n        self.db.add(run)\n        self.db.commit()\n        self.backtest_run_id = run.id\n\n        if self.position_monitor is not None:\n            self.position_monitor.set_backtest_run_id(self.backtest_run_id)\n\n        logger.info(\n            f\"Created backtest run #{self.backtest_run_id}: {run.name}\",\n            extra={\"event_type\": \"backtest_init\"},\n        )\n\n    def _build_config_snapshot(self) -> Dict:\n        \"\"\"Build immutable config snapshot for reproducibility.\"\"\"\n        from quantagent import settings\n\n        # Re-generate snapshot via assembler to keep alignment\n        resolved = StrategyAssembler.from_snapshot(\n            {\n                \"initial_cash\": self.initial_capital,\n                \"base_position_pct\": self.config.get(\"base_position_pct\", settings.TRADING_BASE_POSITION_PCT),\n                \"max_daily_loss_pct\": self.config.get(\"max_daily_loss_pct\", settings.TRADING_MAX_DAILY_LOSS_PCT),\n                \"max_position_pct\": self.config.get(\"max_position_pct\", settings.TRADING_MAX_POSITION_PCT),\n                \"slippage_pct\": self.config.get(\"slippage_pct\", settings.TRADING_SLIPPAGE_PCT),\n                \"model_provider\": self.config.get(\n                    \"agent_llm_provider\", self.config.get(\"model_provider\", settings.AGENT_LLM_PROVIDER)\n                ),\n                \"model_name\": self.config.get(\n                    \"agent_llm_model\", self.config.get(\"model_name\", settings.AGENT_LLM_MODEL)\n                ),\n                \"temperature\": self.config.get(\n                    \"agent_llm_temperature\", self.config.get(\"temperature\", settings.AGENT_LLM_TEMPERATURE)\n                ),\n                \"use_checkpointing\": self.use_checkpointing,\n                \"universe\": self.config.get(\"universe\", settings.get_trading_universe()),\n            },\n            environment=Environment.BACKTEST,\n        )\n        return StrategyAssembler.config_snapshot(resolved)\n\n    def _get_date_range(self) -> List[datetime]:\n        \"\"\"\n        Get list of dates to backtest.\n\n        For hourly/intraday: every N hours\n        For daily: every day\n        \"\"\"\n        dates = []\n        current = self.start_date\n\n        # Determine step size based on timeframe\n        if self.timeframe in [\"1h\", \"4h\"]:\n            step_hours = int(self.timeframe.replace(\"h\", \"\"))\n            step = timedelta(hours=step_hours)\n        elif self.timeframe == \"1d\":\n            step = timedelta(days=1)\n        elif self.timeframe == \"1w\":\n            step = timedelta(weeks=1)\n        else:\n            # Default to hourly\n            step = timedelta(hours=1)\n\n        while current <= self.end_date:\n            dates.append(current)\n            current += step\n\n        return dates\n\n    def _get_date_range_for_asset(self, asset: str) -> List[datetime]:\n        \"\"\"\n        Get date range filtered by market hours for specific asset.\n\n        Args:\n            asset: Asset symbol\n\n        Returns:\n            List of valid trading timestamps for this asset\n        \"\"\"\n        all_dates = self._get_date_range()\n\n        if not self.market_hours_filter or self._market_calendar is None:\n            return all_dates\n\n        asset_type = self._asset_types.get(asset, AssetType.UNKNOWN)\n\n        return self._market_calendar.filter_to_trading_hours(all_dates, asset_type)\n\n    def _analyze_and_trade(self, asset: str, current_date: datetime) -> None:\n        \"\"\"\n        Execute analysis and trade for a single asset at a given time.\n\n        NEW FLOW (Hybrid Model with PositionMonitor):\n        1. Check for active position\n        2. If active: strategy.should_exit() → close or update tracking (NO invoke)\n        3. If not active: strategy.generate_signal() → open position if signal != HOLD\n\n        Args:\n            asset: Asset symbol\n            current_date: Current backtest date\n        \"\"\"\n        # Get historical data for analysis (need lookback period)\n        lookback_bars = self.strategy.required_history_bars\n        if lookback_bars <= 0:\n            lookback_bars = 30\n\n        data_start = current_date - timedelta(\n            days=self._bars_to_calendar_days(lookback_bars)\n        )\n\n        df = self.data_provider.get_ohlc(\n            symbol=asset,\n            timeframe=self.timeframe,\n            start_date=data_start,\n            end_date=current_date,\n        )\n\n        if df.empty or len(df) < lookback_bars:\n            logger.warning(\n                f\"Insufficient data for {asset} at {current_date} \"\n                f\"(got {len(df)}, need {lookback_bars})\",\n                extra={\"event_type\": \"backtest_data_warning\", \"symbol\": asset},\n            )\n            return\n\n        current_price = float(df.iloc[-1][\"close\"])\n\n        # Check for active position\n        active_pos = self.position_monitor.get_active_position(asset)\n\n        # Phase 4: Count total candles processed\n        self.total_candles_processed += 1\n\n        if active_pos:\n            # Position active: check exit conditions via strategy\n            should_exit, reason = self.strategy.should_exit(\n                active_pos, current_price, df\n            )\n\n            if should_exit:\n                # Close position\n                self.position_monitor.close_position(active_pos, reason, current_price)\n\n                # Execute close via OrderManager\n                if active_pos.trade_id:\n                    self.order_manager.close_trade(\n                        active_pos.trade_id,\n                        current_price,\n                        environment=Environment.BACKTEST,\n                    )\n                    logger.info(\n                        f\"{asset}: Closed position - {reason} @ ${current_price:.2f}\"\n                    )\n                # Continue to potentially open new position below\n            else:\n                # Position still active: update tracking only (NO INVOKE)\n                prev_close = (\n                    float(df.iloc[-2][\"close\"]) if len(df) >= 2 else current_price\n                )\n                self.position_monitor.update_candle_tracking(\n                    active_pos, current_price, prev_close\n                )\n                return  # Early return - invocation saved\n\n        # No active position (or just closed): generate signal\n        if isinstance(self.strategy, LLMAgentStrategy):\n            kline_data = format_ohlcv_for_agents(df)\n        else:\n            kline_data = df.to_dict(orient=\"records\")\n\n        # Phase 4: Count agent invocations\n        self.agent_invocations += 1\n\n        # Generate thread_id for checkpointing (if enabled)\n        thread_id = None\n        if self.use_checkpointing:\n            from quantagent.strategy.assembler import StrategyAssembler\n\n            thread_id = StrategyAssembler.make_thread_id(\n                self.backtest_run_id, asset, current_date\n            )\n\n        signal_kwargs = {}\n        if thread_id is not None:\n            signal_kwargs[\"thread_id\"] = thread_id\n\n        signal = self.strategy.generate_signal(\n            kline_data, asset, self.timeframe, current_price, **signal_kwargs\n        )\n\n        if signal is None or signal.decision == \"HOLD\":\n            return\n\n        # Execute trade\n        trading_signal = (\n            TradeSignal.LONG if signal.decision == \"LONG\" else TradeSignal.SHORT\n        )\n\n        # Store signal in database\n        db_signal = self._create_signal_from_strategy(\n            asset=asset,\n            decision=trading_signal,\n            confidence=signal.confidence,\n            reasoning=signal.reasoning,\n            current_date=current_date,\n        )\n\n        # Execute order\n        order = self.order_manager.execute_decision(\n            symbol=asset,\n            decision=trading_signal,\n            confidence=signal.confidence,\n            current_price=current_price,\n            environment=Environment.BACKTEST,\n            trigger_signal_id=db_signal.id if db_signal else None,\n        )\n\n        if order and order.filled_quantity and order.filled_quantity > 0:\n            # Create ActivePosition\n            side = (\n                OrderSide.BUY if trading_signal == TradeSignal.LONG else OrderSide.SELL\n            )\n\n            # Get trade_id from order\n            trade_id = None\n            if order.id:\n                trade = self.db.query(Trade).filter(Trade.order_id == order.id).first()\n                if trade:\n                    trade_id = trade.id\n\n            self.position_monitor.open_position(\n                symbol=asset,\n                side=side,\n                entry_price=signal.entry_price or current_price,\n                stop_loss=signal.stop_loss\n                or (\n                    current_price * 0.98\n                    if side == OrderSide.BUY\n                    else current_price * 1.02\n                ),\n                take_profit=signal.take_profit\n                or (\n                    current_price * 1.03\n                    if side == OrderSide.BUY\n                    else current_price * 0.97\n                ),\n                quantity=order.filled_quantity,\n                exit_policy=signal.exit_policy.value,\n                trade_id=trade_id,\n                signal_id=db_signal.id if db_signal else None,\n                trailing_stop_pct=signal.trailing_stop_pct,\n                max_hold_candles=signal.max_hold_candles,\n            )\n\n            logger.info(\n                f\"Executed {trading_signal.value} for {asset} \"\n                f\"@ \"\n                f\"${current_price:.2f}, qty: {order.filled_quantity}\"\n            )\n\n    def _bars_to_calendar_days(self, bars: int) -> int:\n        \"\"\"Convert required trading bars to a calendar-day lookback window.\"\"\"\n        if self.timeframe == \"1d\":\n            return math.ceil(bars * 365 / 252)\n        if self.timeframe == \"1h\":\n            return math.ceil(bars / 6.5 * 7 / 5)\n        if self.timeframe == \"4h\":\n            return math.ceil(bars * 4 / 6.5 * 7 / 5)\n        return bars * 2\n\n    def _parse_decision(self, decision: TradingDecision) -> (TradeSignal, float):\n        \"\"\"Parse decision text to extract LONG/SHORT/HOLD and confidence.\"\"\"\n        decision_upper = decision.decision.upper()\n        signal = TradeSignal.NEUTRAL\n\n        if \"LONG\" in decision_upper or \"BUY\" in decision_upper:\n            signal = TradeSignal.LONG\n        elif \"SHORT\" in decision_upper or \"SELL\" in decision_upper:\n            signal = TradeSignal.SHORT\n        else:\n            signal = TradeSignal.NEUTRAL\n\n        ind = float(decision.confidence)\n\n        return signal, ind\n\n    def _create_signal_from_strategy(\n        self,\n        asset: str,\n        decision: TradeSignal,\n        confidence: float,\n        reasoning: str,\n        current_date: datetime,\n    ) -> Optional[Signal]:\n        \"\"\"Create Signal record from strategy output (simplified).\"\"\"\n        from quantagent import settings\n\n        try:\n            signal = Signal(\n                symbol=asset,\n                signal=decision,\n                confidence=confidence,\n                timeframe=self.timeframe,\n                analysis_summary=reasoning,\n                generated_at=current_date,\n                environment=Environment.BACKTEST,\n                backtest_run_id=self.backtest_run_id,\n                model_provider=self.config.get(\"agent_llm_provider\", settings.AGENT_LLM_PROVIDER),\n                model_name=self.config.get(\"agent_llm_model\", settings.AGENT_LLM_MODEL),\n                temperature=self.config.get(\"agent_llm_temperature\", settings.AGENT_LLM_TEMPERATURE),\n            )\n\n            self.db.add(signal)\n            self.db.commit()\n            return signal\n\n        except Exception as e:\n            logger.error(f\"Error creating signal: {e}\", exc_info=True)\n            return None\n\n    def _create_signal(\n        self,\n        asset: str,\n        decision: TradeSignal,\n        confidence: float,\n        result: Dict,\n        current_date: datetime,\n        thread_id: Optional[str] = None,\n    ) -> Optional[Signal]:\n        \"\"\"Create and persist Signal record.\"\"\"\n        try:\n            # Extract technical indicators\n            rsi = None\n            macd = None\n            stochastic = None\n            roc = None\n            williams_r = None\n            pattern = None\n            trend = None\n\n            if \"rsi\" in result and result[\"rsi\"]:\n                rsi = (\n                    float(result[\"rsi\"][-1])\n                    if isinstance(result[\"rsi\"], list)\n                    else float(result[\"rsi\"])\n                )\n\n            if \"macd\" in result and result[\"macd\"]:\n                macd = (\n                    float(result[\"macd\"][-1])\n                    if isinstance(result[\"macd\"], list)\n                    else float(result[\"macd\"])\n                )\n\n            indicator_report = result.get(\"indicator_report\")\n            if indicator_report and hasattr(indicator_report, \"rsi\"):\n                rsi = float(indicator_report.rsi)\n            if indicator_report and hasattr(indicator_report, \"macd\"):\n                macd = float(indicator_report.macd)\n            if indicator_report and hasattr(indicator_report, \"stochastic\"):\n                stochastic = float(indicator_report.stochastic)\n            if indicator_report and hasattr(indicator_report, \"roc\"):\n                roc = float(indicator_report.roc)\n            if indicator_report and hasattr(indicator_report, \"willr\"):\n                williams_r = float(indicator_report.willr)\n\n            # Get pattern and trend from reports\n            pattern_report = result.get(\"pattern_report\")\n            if pattern_report and hasattr(pattern_report, \"primary_pattern\"):\n                pattern = pattern_report.primary_pattern\n\n            trend_report = result.get(\"trend_report\")\n            if trend_report and hasattr(trend_report, \"trend_direction\"):\n                trend = trend_report.trend_direction\n\n            # Create signal\n            from quantagent import settings\n\n            signal = Signal(\n                symbol=asset,\n                signal=decision,\n                confidence=confidence,\n                timeframe=self.timeframe,\n                rsi=rsi,\n                macd=macd,\n                stochastic=stochastic,\n                roc=roc,\n                williams_r=williams_r,\n                pattern=pattern,\n                trend=trend,\n                analysis_summary=result.get(\"reasoning\", \"\"),\n                generated_at=current_date,\n                environment=Environment.BACKTEST,\n                backtest_run_id=self.backtest_run_id,\n                thread_id=thread_id,\n                model_provider=self.config.get(\"agent_llm_provider\", settings.AGENT_LLM_PROVIDER),\n                model_name=self.config.get(\"agent_llm_model\", settings.AGENT_LLM_MODEL),\n                temperature=self.config.get(\"agent_llm_temperature\", settings.AGENT_LLM_TEMPERATURE),\n            )\n\n            self.db.add(signal)\n            self.db.commit()\n\n            return signal\n\n        except Exception as e:\n            logger.error(\n                f\"Error creating signal: {e}\",\n                exc_info=True,\n                extra={\"event_type\": \"backtest_error\"},\n            )\n            return None\n\n    def _record_equity(self, current_date: datetime) -> None:\n        \"\"\"Record equity curve data point.\"\"\"\n        total_value = self.portfolio.get_total_value()\n\n        self.equity_curve.append(\n            {\n                \"date\": current_date,\n                \"equity\": total_value,\n                \"cash\": self.portfolio.cash,\n                \"positions_value\": total_value - self.portfolio.cash,\n            }\n        )\n\n    def _calculate_metrics(self) -> BacktestMetrics:\n        \"\"\"\n        Calculate backtest performance metrics.\n\n        Metrics:\n        - Win rate: % of winning trades\n        - Profit factor: sum(wins) / abs(sum(losses))\n        - Sharpe ratio: (return - risk_free) / volatility\n        - Max drawdown: worst peak-to-trough decline\n        - Total P&L: sum of all trade P&L\n        \"\"\"\n        # Get all trades from database for this backtest\n        trades = (\n            self.db.query(Trade)\n            .filter(\n                Trade.environment == Environment.BACKTEST,\n                Trade.opened_at >= self.start_date,\n                Trade.opened_at <= self.end_date,\n            )\n            .all()\n        )\n\n        if self._replay_trade_order_ids is not None:\n            trades = [\n                trade\n                for trade in trades\n                if trade.order_id in self._replay_trade_order_ids\n            ]\n\n        if not trades:\n            logger.warning(\n                \"No trades executed during backtest\",\n                extra={\"event_type\": \"backtest_warning\"},\n            )\n\n            # Phase 4: Even with no trades, calculate MDA if positions were opened\n            mda, accuracy_by_candle = self._calculate_directional_accuracy()\n            close_reasons = self._calculate_close_reasons()\n\n            invocations_saved = self.total_candles_processed - self.agent_invocations\n            invocation_reduction_pct = (\n                (invocations_saved / self.total_candles_processed * 100)\n                if self.total_candles_processed > 0\n                else 0.0\n            )\n\n            return BacktestMetrics(\n                total_trades=0,\n                winning_trades=0,\n                losing_trades=0,\n                win_rate=0.0,\n                profit_factor=0.0,\n                sharpe_ratio=0.0,\n                max_drawdown=0.0,\n                total_pnl=0.0,\n                avg_win=0.0,\n                avg_loss=0.0,\n                largest_win=0.0,\n                largest_loss=0.0,\n                total_return_pct=0.0,\n                agent_invocations=self.agent_invocations,\n                invocations_saved=invocations_saved,\n                invocation_reduction_pct=invocation_reduction_pct,\n                mean_directional_accuracy=mda,\n                accuracy_by_candle=accuracy_by_candle,\n                close_reasons=close_reasons,\n            )\n\n        # Calculate basic metrics\n        total_trades = len(trades)\n        winning_trades = [t for t in trades if t.pnl and float(t.pnl) > 0]\n        losing_trades = [t for t in trades if t.pnl and float(t.pnl) < 0]\n\n        total_wins = sum(float(t.pnl) for t in winning_trades)\n        total_losses = abs(sum(float(t.pnl) for t in losing_trades))\n\n        # Win rate\n        win_rate = len(winning_trades) / total_trades if total_trades > 0 else 0.0\n\n        # Profit factor\n        profit_factor = (\n            total_wins / total_losses\n            if total_losses > 0\n            else float(\"inf\") if total_wins > 0 else 0.0\n        )\n\n        # Total P&L\n        total_pnl = sum(float(t.pnl) for t in trades if t.pnl)\n\n        # Average win/loss\n        avg_win = total_wins / len(winning_trades) if winning_trades else 0.0\n        avg_loss = total_losses / len(losing_trades) if losing_trades else 0.0\n\n        # Largest win/loss\n        largest_win = max((float(t.pnl) for t in winning_trades), default=0.0)\n        largest_loss = min((float(t.pnl) for t in losing_trades), default=0.0)\n\n        # Total return %\n        total_return_pct = (\n            (total_pnl / self.initial_capital) * 100\n            if self.initial_capital > 0\n            else 0.0\n        )\n\n        # Sharpe ratio\n        sharpe_ratio = self._calculate_sharpe_ratio()\n\n        # Max drawdown\n        max_drawdown = self._calculate_max_drawdown()\n\n        # Phase 4: Calculate MDA and accuracy metrics\n        mda, accuracy_by_candle = self._calculate_directional_accuracy()\n\n        # Phase 4: Calculate close reasons distribution\n        close_reasons = self._calculate_close_reasons()\n\n        # Phase 4: Calculate invocation reduction\n        invocations_saved = self.total_candles_processed - self.agent_invocations\n        invocation_reduction_pct = (\n            (invocations_saved / self.total_candles_processed * 100)\n            if self.total_candles_processed > 0\n            else 0.0\n        )\n\n        return BacktestMetrics(\n            total_trades=total_trades,\n            winning_trades=len(winning_trades),\n            losing_trades=len(losing_trades),\n            win_rate=win_rate,\n            profit_factor=profit_factor,\n            sharpe_ratio=sharpe_ratio,\n            max_drawdown=max_drawdown,\n            total_pnl=total_pnl,\n            avg_win=avg_win,\n            avg_loss=avg_loss,\n            largest_win=largest_win,\n            largest_loss=largest_loss,\n            total_return_pct=total_return_pct,\n            agent_invocations=self.agent_invocations,\n            invocations_saved=invocations_saved,\n            invocation_reduction_pct=invocation_reduction_pct,\n            mean_directional_accuracy=mda,\n            accuracy_by_candle=accuracy_by_candle,\n            close_reasons=close_reasons,\n        )\n\n    def _calculate_sharpe_ratio(self, risk_free_rate: float = 0.02) -> float:\n        \"\"\"\n        Calculate Sharpe ratio.\n\n        Formula: (return - risk_free) / volatility\n\n        Args:\n            risk_free_rate: Annual risk-free rate (default: 2%)\n\n        Returns:\n            Sharpe ratio\n        \"\"\"\n        if len(self.equity_curve) < 2:\n            return 0.0\n\n        # Calculate returns\n        equity_series = pd.Series([e[\"equity\"] for e in self.equity_curve])\n        returns = equity_series.pct_change().dropna()\n\n        if len(returns) == 0 or returns.std() == 0:\n            return 0.0\n\n        # Annualize based on timeframe\n        periods_per_year = self._get_periods_per_year()\n\n        # Calculate Sharpe\n        excess_return = returns.mean() - (risk_free_rate / periods_per_year)\n        sharpe = (excess_return / returns.std()) * np.sqrt(periods_per_year)\n\n        return float(sharpe)\n\n    def _calculate_max_drawdown(self) -> float:\n        \"\"\"\n        Calculate maximum drawdown.\n\n        Formula: max((peak - trough) / peak)\n\n        Returns:\n            Max drawdown as decimal (e.g., 0.15 = 15%)\n        \"\"\"\n        if len(self.equity_curve) < 2:\n            return 0.0\n\n        equity_series = pd.Series([e[\"equity\"] for e in self.equity_curve])\n\n        # Calculate running maximum\n        running_max = equity_series.expanding().max()\n\n        # Calculate drawdown\n        drawdown = (equity_series - running_max) / running_max\n\n        # Maximum drawdown (most negative)\n        max_dd = abs(drawdown.min())\n\n        return float(max_dd)\n\n    def _calculate_directional_accuracy(self) -> tuple[float, Dict[int, float]]:\n        \"\"\"\n        Calculate Mean Directional Accuracy (MDA) and per-candle accuracy.\n\n        MDA = (correct_candles / total_candles_evaluated)\n\n        Returns:\n            Tuple of (mean_directional_accuracy, accuracy_by_candle)\n        \"\"\"\n        query = self.db.query(ActivePosition).filter(\n            ActivePosition.is_active.is_(False),\n            ActivePosition.decision_timestamp >= self.start_date,\n            ActivePosition.decision_timestamp <= self.end_date,\n        )\n\n        if self.backtest_run_id is not None:\n            query = query.filter(ActivePosition.backtest_run_id == self.backtest_run_id)\n\n        positions = query.all()\n\n        if not positions:\n            return 0.0, {}\n\n        # Track correct predictions per candle index\n        correct_by_candle = {}\n        total_by_candle = {}\n\n        for pos in positions:\n            expected_direction = \"up\" if pos.side == OrderSide.BUY else \"down\"\n\n            # Evaluate up to prediction_horizon candles\n            for i, direction in enumerate(\n                pos.candles_direction[: pos.prediction_horizon]\n            ):\n                candle_idx = i + 1  # 1-indexed (candle 1, 2, 3...)\n\n                if candle_idx not in correct_by_candle:\n                    correct_by_candle[candle_idx] = 0\n                    total_by_candle[candle_idx] = 0\n\n                total_by_candle[candle_idx] += 1\n                if direction == expected_direction:\n                    correct_by_candle[candle_idx] += 1\n\n        # Calculate accuracy per candle\n        accuracy_by_candle = {\n            candle: correct_by_candle[candle] / total_by_candle[candle]\n            for candle in sorted(total_by_candle.keys())\n        }\n\n        # Calculate overall MDA\n        total_correct = sum(correct_by_candle.values())\n        total_candles = sum(total_by_candle.values())\n        mda = total_correct / total_candles if total_candles > 0 else 0.0\n\n        return mda, accuracy_by_candle\n\n    def _calculate_close_reasons(self) -> Dict[str, int]:\n        \"\"\"\n        Calculate distribution of position close reasons.\n\n        Returns:\n            Dict mapping close_reason to count\n        \"\"\"\n        query = self.db.query(ActivePosition).filter(\n            ActivePosition.is_active.is_(False),\n            ActivePosition.decision_timestamp >= self.start_date,\n            ActivePosition.decision_timestamp <= self.end_date,\n        )\n\n        if self.backtest_run_id is not None:\n            query = query.filter(ActivePosition.backtest_run_id == self.backtest_run_id)\n\n        positions = query.all()\n\n        close_reasons = {}\n        for pos in positions:\n            reason = pos.close_reason or \"unknown\"\n            close_reasons[reason] = close_reasons.get(reason, 0) + 1\n\n        return close_reasons\n\n    def _get_periods_per_year(self) -> int:\n        \"\"\"Get number of periods per year based on timeframe.\"\"\"\n        if self.timeframe == \"1h\":\n            return 252 * 6.5  # Trading days * hours per day\n        elif self.timeframe == \"4h\":\n            return 252 * 1.625  # Approx 1.6 periods per day\n        elif self.timeframe == \"1d\":\n            return 252\n        elif self.timeframe == \"1w\":\n            return 52\n        else:\n            return 252\n\n    def _update_backtest_run(self, metrics: BacktestMetrics) -> None:\n        \"\"\"Update BacktestRun record with final metrics.\"\"\"\n        if not self.backtest_run_id:\n            return\n\n        run = (\n            self.db.query(BacktestRun)\n            .filter(BacktestRun.id == self.backtest_run_id)\n            .first()\n        )\n\n        if run:\n            run.total_trades = metrics.total_trades\n            run.win_rate = metrics.win_rate\n            run.profit_factor = metrics.profit_factor\n            run.sharpe_ratio = metrics.sharpe_ratio\n            run.max_drawdown = metrics.max_drawdown\n            run.total_pnl = Decimal(str(metrics.total_pnl))\n\n            self.db.commit()\n            logger.info(\n                f\"Updated backtest run #{self.backtest_run_id} with final metrics\",\n                extra={\"event_type\": \"backtest_complete\"},\n            )\n\n    def get_equity_curve(self) -> pd.DataFrame:\n        \"\"\"\n        Get equity curve as DataFrame.\n\n        Returns:\n            DataFrame with columns: date, equity, cash, positions_value\n        \"\"\"\n        return pd.DataFrame(self.equity_curve)\n\n    def __del__(self):\n        \"\"\"Cleanup database session if we own it.\"\"\"\n        if self._own_session and self.db:\n            self.db.close()\n","numLines":1269,"startLine":1,"totalLines":1269}}}
