{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XUX3N6qeLQ9MpP2iNV8NcE","type":"tool_result","content":"1\t\"\"\"Strategy Assembler (Factory)\n2\t\n3\tBuilds a consistent set of trading components from a resolved configuration\n4\tsnapshot: PortfolioManager, PositionSizer, RiskManager, Broker, OrderManager,\n5\tand TradingGraph, plus utilities to manage universe and config snapshots.\n6\t\"\"\"\n7\t\n8\tfrom __future__ import annotations\n9\t\n10\tfrom dataclasses import dataclass\n11\tfrom datetime import datetime\n12\tfrom typing import Dict, List, Optional\n13\t\n14\tfrom sqlalchemy.orm import Session\n15\t\n16\tfrom quantagent.models import Environment\n17\tfrom quantagent.portfolio.manager import PortfolioManager\n18\tfrom quantagent.trading.order_manager import OrderManager\n19\tfrom quantagent.trading.paper_broker import PaperBroker\n20\tfrom quantagent.trading.position_sizer import PositionSizer\n21\tfrom quantagent.trading.risk_manager import RiskManager\n22\tfrom quantagent.trading_graph import TradingGraph\n23\t\n24\t\n25\t@dataclass(frozen=True)\n26\tclass ResolvedConfig:\n27\t    environment: Environment\n28\t    universe: List[str]\n29\t    initial_cash: float\n30\t    base_position_pct: float\n31\t    max_daily_loss_pct: float\n32\t    max_position_pct: float\n33\t    slippage_pct: float\n34\t    model_provider: str\n35\t    model_name: str\n36\t    temperature: float\n37\t    use_checkpointing: bool\n38\t    extras: Optional[Dict] = None\n39\t\n40\t\n41\t@dataclass\n42\tclass TradingComponents:\n43\t    portfolio_manager: PortfolioManager\n44\t    position_sizer: PositionSizer\n45\t    risk_manager: RiskManager\n46\t    broker: PaperBroker\n47\t    order_manager: OrderManager\n48\t    graph: TradingGraph\n49\t\n50\t\n51\tclass StrategyAssembler:\n52\t    \"\"\"Factory to resolve strategy config and assemble trading components.\"\"\"\n53\t\n54\t    @staticmethod\n55\t    def DEFAULTS() -> dict:\n56\t        \"\"\"Default strategy configuration (loaded from settings.py).\"\"\"\n57\t        from quantagent import settings\n58\t        return {\n59\t            \"initial_cash\": settings.TRADING_INITIAL_CASH,\n60\t            \"base_position_pct\": settings.TRADING_BASE_POSITION_PCT,\n61\t            \"max_daily_loss_pct\": settings.TRADING_MAX_DAILY_LOSS_PCT,\n62\t            \"max_position_pct\": settings.TRADING_MAX_POSITION_PCT,\n63\t            \"slippage_pct\": settings.TRADING_SLIPPAGE_PCT,\n64\t            \"model_provider\": settings.AGENT_LLM_PROVIDER,\n65\t            \"model_name\": settings.AGENT_LLM_MODEL,\n66\t            \"temperature\": settings.AGENT_LLM_TEMPERATURE,\n67\t            \"use_checkpointing\": settings.TRADING_USE_CHECKPOINTING,\n68\t            \"universe\": settings.get_trading_universe(),\n69\t        }\n70\t\n71\t    @staticmethod\n72\t    def from_profiles(\n73\t        *,\n74\t        portfolio_profile: Optional[Dict] = None,\n75\t        risk_profile: Optional[Dict] = None,\n76\t        model_profile: Optional[Dict] = None,\n77\t        overrides: Optional[Dict] = None,\n78\t        environment: Environment = Environment.BACKTEST,\n79\t    ) -> ResolvedConfig:\n80\t        \"\"\"Resolve configuration from profile dicts + overrides.\n81\t\n82\t        Priority: overrides > model/portfolio/risk > defaults\n83\t        \"\"\"\n84\t        portfolio_profile = portfolio_profile or {}\n85\t        risk_profile = risk_profile or {}\n86\t        model_profile = model_profile or {}\n87\t        overrides = overrides or {}\n88\t\n89\t        merged: Dict = {**StrategyAssembler.DEFAULTS()}\n90\t\n91\t        # Portfolio fields\n92\t        merged.update(\n93\t            {\n94\t                k: v\n95\t                for k, v in portfolio_profile.items()\n96\t                if k\n97\t                in {\"universe\", \"base_position_pct\", \"slippage_pct\", \"initial_cash\"}\n98\t            }\n99\t        )\n100\t\n101\t        # Risk fields\n102\t        merged.update(\n103\t            {\n104\t                k: v\n105\t                for k, v in risk_profile.items()\n106\t                if k in {\"max_daily_loss_pct\", \"max_position_pct\"}\n107\t            }\n108\t        )\n109\t\n110\t        # Model fields (normalize to generic names)\n111\t        model_norm = StrategyAssembler._normalize_model_profile(model_profile)\n112\t        merged.update(model_norm)\n113\t\n114\t        # Overrides last\n115\t        merged.update(overrides)\n116\t\n117\t        # Build ResolvedConfig\n118\t        return StrategyAssembler._to_resolved(merged, environment)\n119\t\n120\t    @staticmethod\n121\t    def from_snapshot(\n122\t        snapshot: Dict,\n123\t        *,\n124\t        environment: Environment = Environment.BACKTEST,\n125\t    ) -> ResolvedConfig:\n126\t        \"\"\"Resolve configuration from a previously persisted snapshot dict.\n127\t\n128\t        Accepts both the assembler schema (model_provider/model_name/temperature)\n129\t        and Backtest snapshot keys (agent_llm_*).\n130\t        \"\"\"\n131\t        merged = {**StrategyAssembler.DEFAULTS(), **snapshot}\n132\t\n133\t        # Normalize model keys if they come from Backtest snapshot\n134\t        if \"agent_llm_provider\" in merged:\n135\t            merged.setdefault(\"model_provider\", merged.get(\"agent_llm_provider\"))\n136\t        if \"agent_llm_model\" in merged:\n137\t            merged.setdefault(\"model_name\", merged.get(\"agent_llm_model\"))\n138\t        if \"agent_llm_temperature\" in merged:\n139\t            merged.setdefault(\"temperature\", merged.get(\"agent_llm_temperature\"))\n140\t\n141\t        return StrategyAssembler._to_resolved(merged, environment)\n142\t\n143\t    @staticmethod\n144\t    def resolve_universe(\n145\t        resolved: ResolvedConfig, assets_override: Optional[List[str]]\n146\t    ) -> List[str]:\n147\t        \"\"\"Return assets_override if provided, else resolved.universe.\"\"\"\n148\t        if assets_override is not None and len(assets_override) > 0:\n149\t            return assets_override\n150\t        return list(resolved.universe)\n151\t\n152\t    @staticmethod\n153\t    def build_components(\n154\t        resolved: ResolvedConfig,\n155\t        *,\n156\t        db_session: Session,\n157\t    ) -> TradingComponents:\n158\t        \"\"\"Construct trading components wired with the resolved config.\"\"\"\n159\t        pm = PortfolioManager(\n160\t            initial_cash=resolved.initial_cash,\n161\t            environment=resolved.environment,\n162\t            db=db_session,\n163\t        )\n164\t        ps = PositionSizer(base_position_pct=resolved.base_position_pct)\n165\t        rm = RiskManager(\n166\t            portfolio_manager=pm,\n167\t            max_daily_loss_pct=resolved.max_daily_loss_pct,\n168\t            max_position_pct=resolved.max_position_pct,\n169\t            db=db_session,\n170\t        )\n171\t        broker = PaperBroker(slippage_pct=resolved.slippage_pct)\n172\t        om = OrderManager(\n173\t            position_sizer=ps,\n174\t            risk_manager=rm,\n175\t            broker=broker,\n176\t            portfolio_manager=pm,\n177\t            db=db_session,\n178\t        )\n179\t\n180\t        # TradingGraph configuration mapping\n181\t        # graph_cfg = {\n182\t        #     \"agent_llm_provider\": resolved.model_provider,\n183\t        #     \"agent_llm_model\": resolved.model_name,\n184\t        #     \"agent_llm_temperature\": resolved.temperature,\n185\t        # }\n186\t\n187\t        # graph = TradingGraph(config=graph_cfg, use_checkpointing=resolved.use_checkpointing)\n188\t        graph = TradingGraph(use_checkpointing=resolved.use_checkpointing)\n189\t\n190\t        return TradingComponents(\n191\t            portfolio_manager=pm,\n192\t            position_sizer=ps,\n193\t            risk_manager=rm,\n194\t            broker=broker,\n195\t            order_manager=om,\n196\t            graph=graph,\n197\t        )\n198\t\n199\t    @staticmethod\n200\t    def config_snapshot(resolved: ResolvedConfig) -> Dict:\n201\t        \"\"\"Create a serializable snapshot for persistence (BacktestRun).\"\"\"\n202\t        return {\n203\t            \"initial_capital\": resolved.initial_cash,\n204\t            \"base_position_pct\": resolved.base_position_pct,\n205\t            \"max_daily_loss_pct\": resolved.max_daily_loss_pct,\n206\t            \"max_position_pct\": resolved.max_position_pct,\n207\t            \"slippage_pct\": resolved.slippage_pct,\n208\t            # Align with TradingGraph expected keys (agent_llm_*)\n209\t            \"agent_llm_provider\": resolved.model_provider,\n210\t            \"agent_llm_model\": resolved.model_name,\n211\t            \"agent_llm_temperature\": resolved.temperature,\n212\t            \"use_checkpointing\": resolved.use_checkpointing,\n213\t            # Include universe for reproducibility (even if caller overrides)\n214\t            \"universe\": list(resolved.universe),\n215\t        }\n216\t\n217\t    @staticmethod\n218\t    def make_thread_id(run_id: int, symbol: str, ts: datetime) -> str:\n219\t        return f\"backtest_{run_id}_{symbol}_{ts.isoformat()}\"\n220\t\n221\t    # ---- Helpers ----\n222\t    @staticmethod\n223\t    def _normalize_model_profile(model_profile: Dict) -> Dict:\n224\t        out = {}\n225\t        # Accept both generic and agent_llm_* keys\n226\t        provider = model_profile.get(\n227\t            \"model_provider\", model_profile.get(\"agent_llm_provider\")\n228\t        )\n229\t        name = model_profile.get(\"model_name\", model_profile.get(\"agent_llm_model\"))\n230\t        temp = model_profile.get(\n231\t            \"temperature\", model_profile.get(\"agent_llm_temperature\")\n232\t        )\n233\t\n234\t        if provider is not None:\n235\t            out[\"model_provider\"] = provider\n236\t        if name is not None:\n237\t            out[\"model_name\"] = name\n238\t        if temp is not None:\n239\t            out[\"temperature\"] = temp\n240\t\n241\t        # Runtime flags (non-secret)\n242\t        for k in (\"use_checkpointing\",):\n243\t            if k in model_profile:\n244\t                out[k] = model_profile[k]\n245\t\n246\t        return out\n247\t\n248\t    @staticmethod\n249\t    def _to_resolved(merged: Dict, environment: Environment) -> ResolvedConfig:\n250\t        # Basic validations and fallbacks\n251\t        universe = merged.get(\"universe\") or []\n252\t        base_pct = float(\n253\t            merged.get(\n254\t                \"base_position_pct\", StrategyAssembler.DEFAULTS()[\"base_position_pct\"]\n255\t            )\n256\t        )\n257\t        max_pos = float(\n258\t            merged.get(\n259\t                \"max_position_pct\", StrategyAssembler.DEFAULTS()[\"max_position_pct\"]\n260\t            )\n261\t        )\n262\t        max_loss = float(\n263\t            merged.get(\n264\t                \"max_daily_loss_pct\", StrategyAssembler.DEFAULTS()[\"max_daily_loss_pct\"]\n265\t            )\n266\t        )\n267\t        slip = float(\n268\t            merged.get(\"slippage_pct\", StrategyAssembler.DEFAULTS()[\"slippage_pct\"])\n269\t        )\n270\t        initial_cash = float(\n271\t            merged.get(\"initial_cash\", StrategyAssembler.DEFAULTS()[\"initial_cash\"])\n272\t        )\n273\t        temp = float(\n274\t            merged.get(\"temperature\", StrategyAssembler.DEFAULTS()[\"temperature\"])\n275\t        )\n276\t        use_ckpt = bool(\n277\t            merged.get(\n278\t                \"use_checkpointing\", StrategyAssembler.DEFAULTS()[\"use_checkpointing\"]\n279\t            )\n280\t        )\n281\t\n282\t        return ResolvedConfig(\n283\t            environment=environment,\n284\t            universe=list(universe),\n285\t            initial_cash=initial_cash,\n286\t            base_position_pct=base_pct,\n287\t            max_daily_loss_pct=max_loss,\n288\t            max_position_pct=max_pos,\n289\t            slippage_pct=slip,\n290\t            model_provider=str(\n291\t                merged.get(\n292\t                    \"model_provider\", StrategyAssembler.DEFAULTS()[\"model_provider\"]\n293\t                )\n294\t            ),\n295\t            model_name=str(\n296\t                merged.get(\"model_name\", StrategyAssembler.DEFAULTS()[\"model_name\"])\n297\t            ),\n298\t            temperature=temp,\n299\t            use_checkpointing=use_ckpt,\n300\t            extras=None,\n301\t        )\n302\t"}]},"parent_tool_use_id":null,"session_id":"0ba6b8a9-0956-46b4-a5ab-2f80c3a37c45","uuid":"16867145-6b91-4308-86ca-ab80c75f55a4","timestamp":"2026-05-12T02:41:09.839Z","tool_use_result":{"type":"text","file":{"filePath":"/home/azureuser/repos/projects/QuantAgent/quantagent/strategy/assembler.py","content":"\"\"\"Strategy Assembler (Factory)\n\nBuilds a consistent set of trading components from a resolved configuration\nsnapshot: PortfolioManager, PositionSizer, RiskManager, Broker, OrderManager,\nand TradingGraph, plus utilities to manage universe and config snapshots.\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom dataclasses import dataclass\nfrom datetime import datetime\nfrom typing import Dict, List, Optional\n\nfrom sqlalchemy.orm import Session\n\nfrom quantagent.models import Environment\nfrom quantagent.portfolio.manager import PortfolioManager\nfrom quantagent.trading.order_manager import OrderManager\nfrom quantagent.trading.paper_broker import PaperBroker\nfrom quantagent.trading.position_sizer import PositionSizer\nfrom quantagent.trading.risk_manager import RiskManager\nfrom quantagent.trading_graph import TradingGraph\n\n\n@dataclass(frozen=True)\nclass ResolvedConfig:\n    environment: Environment\n    universe: List[str]\n    initial_cash: float\n    base_position_pct: float\n    max_daily_loss_pct: float\n    max_position_pct: float\n    slippage_pct: float\n    model_provider: str\n    model_name: str\n    temperature: float\n    use_checkpointing: bool\n    extras: Optional[Dict] = None\n\n\n@dataclass\nclass TradingComponents:\n    portfolio_manager: PortfolioManager\n    position_sizer: PositionSizer\n    risk_manager: RiskManager\n    broker: PaperBroker\n    order_manager: OrderManager\n    graph: TradingGraph\n\n\nclass StrategyAssembler:\n    \"\"\"Factory to resolve strategy config and assemble trading components.\"\"\"\n\n    @staticmethod\n    def DEFAULTS() -> dict:\n        \"\"\"Default strategy configuration (loaded from settings.py).\"\"\"\n        from quantagent import settings\n        return {\n            \"initial_cash\": settings.TRADING_INITIAL_CASH,\n            \"base_position_pct\": settings.TRADING_BASE_POSITION_PCT,\n            \"max_daily_loss_pct\": settings.TRADING_MAX_DAILY_LOSS_PCT,\n            \"max_position_pct\": settings.TRADING_MAX_POSITION_PCT,\n            \"slippage_pct\": settings.TRADING_SLIPPAGE_PCT,\n            \"model_provider\": settings.AGENT_LLM_PROVIDER,\n            \"model_name\": settings.AGENT_LLM_MODEL,\n            \"temperature\": settings.AGENT_LLM_TEMPERATURE,\n            \"use_checkpointing\": settings.TRADING_USE_CHECKPOINTING,\n            \"universe\": settings.get_trading_universe(),\n        }\n\n    @staticmethod\n    def from_profiles(\n        *,\n        portfolio_profile: Optional[Dict] = None,\n        risk_profile: Optional[Dict] = None,\n        model_profile: Optional[Dict] = None,\n        overrides: Optional[Dict] = None,\n        environment: Environment = Environment.BACKTEST,\n    ) -> ResolvedConfig:\n        \"\"\"Resolve configuration from profile dicts + overrides.\n\n        Priority: overrides > model/portfolio/risk > defaults\n        \"\"\"\n        portfolio_profile = portfolio_profile or {}\n        risk_profile = risk_profile or {}\n        model_profile = model_profile or {}\n        overrides = overrides or {}\n\n        merged: Dict = {**StrategyAssembler.DEFAULTS()}\n\n        # Portfolio fields\n        merged.update(\n            {\n                k: v\n                for k, v in portfolio_profile.items()\n                if k\n                in {\"universe\", \"base_position_pct\", \"slippage_pct\", \"initial_cash\"}\n            }\n        )\n\n        # Risk fields\n        merged.update(\n            {\n                k: v\n                for k, v in risk_profile.items()\n                if k in {\"max_daily_loss_pct\", \"max_position_pct\"}\n            }\n        )\n\n        # Model fields (normalize to generic names)\n        model_norm = StrategyAssembler._normalize_model_profile(model_profile)\n        merged.update(model_norm)\n\n        # Overrides last\n        merged.update(overrides)\n\n        # Build ResolvedConfig\n        return StrategyAssembler._to_resolved(merged, environment)\n\n    @staticmethod\n    def from_snapshot(\n        snapshot: Dict,\n        *,\n        environment: Environment = Environment.BACKTEST,\n    ) -> ResolvedConfig:\n        \"\"\"Resolve configuration from a previously persisted snapshot dict.\n\n        Accepts both the assembler schema (model_provider/model_name/temperature)\n        and Backtest snapshot keys (agent_llm_*).\n        \"\"\"\n        merged = {**StrategyAssembler.DEFAULTS(), **snapshot}\n\n        # Normalize model keys if they come from Backtest snapshot\n        if \"agent_llm_provider\" in merged:\n            merged.setdefault(\"model_provider\", merged.get(\"agent_llm_provider\"))\n        if \"agent_llm_model\" in merged:\n            merged.setdefault(\"model_name\", merged.get(\"agent_llm_model\"))\n        if \"agent_llm_temperature\" in merged:\n            merged.setdefault(\"temperature\", merged.get(\"agent_llm_temperature\"))\n\n        return StrategyAssembler._to_resolved(merged, environment)\n\n    @staticmethod\n    def resolve_universe(\n        resolved: ResolvedConfig, assets_override: Optional[List[str]]\n    ) -> List[str]:\n        \"\"\"Return assets_override if provided, else resolved.universe.\"\"\"\n        if assets_override is not None and len(assets_override) > 0:\n            return assets_override\n        return list(resolved.universe)\n\n    @staticmethod\n    def build_components(\n        resolved: ResolvedConfig,\n        *,\n        db_session: Session,\n    ) -> TradingComponents:\n        \"\"\"Construct trading components wired with the resolved config.\"\"\"\n        pm = PortfolioManager(\n            initial_cash=resolved.initial_cash,\n            environment=resolved.environment,\n            db=db_session,\n        )\n        ps = PositionSizer(base_position_pct=resolved.base_position_pct)\n        rm = RiskManager(\n            portfolio_manager=pm,\n            max_daily_loss_pct=resolved.max_daily_loss_pct,\n            max_position_pct=resolved.max_position_pct,\n            db=db_session,\n        )\n        broker = PaperBroker(slippage_pct=resolved.slippage_pct)\n        om = OrderManager(\n            position_sizer=ps,\n            risk_manager=rm,\n            broker=broker,\n            portfolio_manager=pm,\n            db=db_session,\n        )\n\n        # TradingGraph configuration mapping\n        # graph_cfg = {\n        #     \"agent_llm_provider\": resolved.model_provider,\n        #     \"agent_llm_model\": resolved.model_name,\n        #     \"agent_llm_temperature\": resolved.temperature,\n        # }\n\n        # graph = TradingGraph(config=graph_cfg, use_checkpointing=resolved.use_checkpointing)\n        graph = TradingGraph(use_checkpointing=resolved.use_checkpointing)\n\n        return TradingComponents(\n            portfolio_manager=pm,\n            position_sizer=ps,\n            risk_manager=rm,\n            broker=broker,\n            order_manager=om,\n            graph=graph,\n        )\n\n    @staticmethod\n    def config_snapshot(resolved: ResolvedConfig) -> Dict:\n        \"\"\"Create a serializable snapshot for persistence (BacktestRun).\"\"\"\n        return {\n            \"initial_capital\": resolved.initial_cash,\n            \"base_position_pct\": resolved.base_position_pct,\n            \"max_daily_loss_pct\": resolved.max_daily_loss_pct,\n            \"max_position_pct\": resolved.max_position_pct,\n            \"slippage_pct\": resolved.slippage_pct,\n            # Align with TradingGraph expected keys (agent_llm_*)\n            \"agent_llm_provider\": resolved.model_provider,\n            \"agent_llm_model\": resolved.model_name,\n            \"agent_llm_temperature\": resolved.temperature,\n            \"use_checkpointing\": resolved.use_checkpointing,\n            # Include universe for reproducibility (even if caller overrides)\n            \"universe\": list(resolved.universe),\n        }\n\n    @staticmethod\n    def make_thread_id(run_id: int, symbol: str, ts: datetime) -> str:\n        return f\"backtest_{run_id}_{symbol}_{ts.isoformat()}\"\n\n    # ---- Helpers ----\n    @staticmethod\n    def _normalize_model_profile(model_profile: Dict) -> Dict:\n        out = {}\n        # Accept both generic and agent_llm_* keys\n        provider = model_profile.get(\n            \"model_provider\", model_profile.get(\"agent_llm_provider\")\n        )\n        name = model_profile.get(\"model_name\", model_profile.get(\"agent_llm_model\"))\n        temp = model_profile.get(\n            \"temperature\", model_profile.get(\"agent_llm_temperature\")\n        )\n\n        if provider is not None:\n            out[\"model_provider\"] = provider\n        if name is not None:\n            out[\"model_name\"] = name\n        if temp is not None:\n            out[\"temperature\"] = temp\n\n        # Runtime flags (non-secret)\n        for k in (\"use_checkpointing\",):\n            if k in model_profile:\n                out[k] = model_profile[k]\n\n        return out\n\n    @staticmethod\n    def _to_resolved(merged: Dict, environment: Environment) -> ResolvedConfig:\n        # Basic validations and fallbacks\n        universe = merged.get(\"universe\") or []\n        base_pct = float(\n            merged.get(\n                \"base_position_pct\", StrategyAssembler.DEFAULTS()[\"base_position_pct\"]\n            )\n        )\n        max_pos = float(\n            merged.get(\n                \"max_position_pct\", StrategyAssembler.DEFAULTS()[\"max_position_pct\"]\n            )\n        )\n        max_loss = float(\n            merged.get(\n                \"max_daily_loss_pct\", StrategyAssembler.DEFAULTS()[\"max_daily_loss_pct\"]\n            )\n        )\n        slip = float(\n            merged.get(\"slippage_pct\", StrategyAssembler.DEFAULTS()[\"slippage_pct\"])\n        )\n        initial_cash = float(\n            merged.get(\"initial_cash\", StrategyAssembler.DEFAULTS()[\"initial_cash\"])\n        )\n        temp = float(\n            merged.get(\"temperature\", StrategyAssembler.DEFAULTS()[\"temperature\"])\n        )\n        use_ckpt = bool(\n            merged.get(\n                \"use_checkpointing\", StrategyAssembler.DEFAULTS()[\"use_checkpointing\"]\n            )\n        )\n\n        return ResolvedConfig(\n            environment=environment,\n            universe=list(universe),\n            initial_cash=initial_cash,\n            base_position_pct=base_pct,\n            max_daily_loss_pct=max_loss,\n            max_position_pct=max_pos,\n            slippage_pct=slip,\n            model_provider=str(\n                merged.get(\n                    \"model_provider\", StrategyAssembler.DEFAULTS()[\"model_provider\"]\n                )\n            ),\n            model_name=str(\n                merged.get(\"model_name\", StrategyAssembler.DEFAULTS()[\"model_name\"])\n            ),\n            temperature=temp,\n            use_checkpointing=use_ckpt,\n            extras=None,\n        )\n","numLines":302,"startLine":1,"totalLines":302}}}
