{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01UJ7ZGRNBkt2m8ZjjUtyX1N","type":"tool_result","content":"1\t\"\"\"Portfolio Manager for tracking positions, capital, and P&L.\"\"\"\n2\t\n3\tfrom datetime import datetime\n4\tfrom decimal import Decimal\n5\tfrom typing import Dict, Optional\n6\t\n7\tfrom sqlalchemy.orm import Session\n8\t\n9\tfrom quantagent.database import SessionLocal\n10\tfrom quantagent.models import (\n11\t    Environment,\n12\t    Order,\n13\t    OrderSide,\n14\t    Position,\n15\t    Trade,\n16\t)\n17\t\n18\t\n19\tclass PortfolioManager:\n20\t    \"\"\"Manages portfolio state including positions, cash, and P&L calculations.\n21\t\n22\t    Attributes:\n23\t        positions: Dict mapping symbol to position data {qty, avg_cost, current_price, pnl}\n24\t        cash: Available capital\n25\t        environment: Execution environment (backtest, paper, prod)\n26\t        total_value: Total portfolio value (cash + position values)\n27\t    \"\"\"\n28\t\n29\t    def __init__(\n30\t        self,\n31\t        initial_cash: float,\n32\t        environment: Environment = Environment.PAPER,\n33\t        db: Optional[Session] = None,\n34\t    ):\n35\t        \"\"\"Initialize portfolio manager.\n36\t\n37\t        Args:\n38\t            initial_cash: Starting capital (e.g., 100000.0)\n39\t            environment: Execution environment tag\n40\t            db: SQLAlchemy session (uses SessionLocal if not provided)\n41\t        \"\"\"\n42\t        self.initial_cash = float(initial_cash)\n43\t        self.cash = float(initial_cash)\n44\t        self.environment = environment\n45\t        self.db = db or SessionLocal()\n46\t        self.positions: Dict[str, Dict] = (\n47\t            {}\n48\t        )  # symbol → {qty, avg_cost, current_price, pnl}\n49\t\n50\t    def execute_trade(self, order: Order, fill_price: float) -> Trade:\n51\t        \"\"\"Execute a trade, update positions, persist to database.\n52\t\n53\t        Args:\n54\t            order: Order object with symbol, side, quantity\n55\t            fill_price: Actual fill price from broker\n56\t\n57\t        Returns:\n58\t            Trade object with updated portfolio state\n59\t\n60\t        Raises:\n61\t            ValueError: If invalid trade data\n62\t\n63\t        Note:\n64\t            Pre-trade validation (capital, position size, daily loss) is handled by RiskManager\n65\t            BEFORE this method is called. This method only updates state.\n66\t        \"\"\"\n67\t        symbol = order.symbol\n68\t        qty = float(order.quantity)\n69\t        fill_qty = float(order.filled_quantity) if order.filled_quantity else qty\n70\t        trade_value = fill_qty * fill_price\n71\t\n72\t        # NOTE: Capital validation already done by RiskManager.validate_trade()\n73\t        # If we reach here, the trade is already validated\n74\t\n75\t        # Determine entry price and action type BEFORE updating position\n76\t        entry_price_for_sell = None\n77\t        position_qty_before = (\n78\t            self.positions[symbol][\"qty\"] if symbol in self.positions else 0.0\n79\t        )\n80\t\n81\t        if order.side == OrderSide.SELL:\n82\t            if position_qty_before > 0:\n83\t                # Closing LONG position\n84\t                entry_price_for_sell = self.positions[symbol][\"avg_cost\"]\n85\t            elif position_qty_before == 0:\n86\t                # Opening new SHORT position\n87\t                entry_price_for_sell = None\n88\t            elif position_qty_before < 0:\n89\t                # Increasing existing SHORT position\n90\t                entry_price_for_sell = self.positions[symbol][\"avg_cost\"]\n91\t        elif order.side == OrderSide.BUY:\n92\t            if position_qty_before < 0:\n93\t                # Closing SHORT position\n94\t                entry_price_for_sell = self.positions[symbol][\"avg_cost\"]\n95\t\n96\t        # Update positions based on side\n97\t        if order.side == OrderSide.BUY:\n98\t            self._execute_buy(symbol, fill_qty, fill_price)\n99\t        elif order.side == OrderSide.SELL:\n100\t            self._execute_sell(symbol, fill_qty, fill_price)"}]},"parent_tool_use_id":null,"session_id":"0ba6b8a9-0956-46b4-a5ab-2f80c3a37c45","uuid":"8c105e01-915a-41c5-a95a-2bfe54fc4c45","timestamp":"2026-05-12T02:41:29.486Z","tool_use_result":{"type":"text","file":{"filePath":"/home/azureuser/repos/projects/QuantAgent/quantagent/portfolio/manager.py","content":"\"\"\"Portfolio Manager for tracking positions, capital, and P&L.\"\"\"\n\nfrom datetime import datetime\nfrom decimal import Decimal\nfrom typing import Dict, Optional\n\nfrom sqlalchemy.orm import Session\n\nfrom quantagent.database import SessionLocal\nfrom quantagent.models import (\n    Environment,\n    Order,\n    OrderSide,\n    Position,\n    Trade,\n)\n\n\nclass PortfolioManager:\n    \"\"\"Manages portfolio state including positions, cash, and P&L calculations.\n\n    Attributes:\n        positions: Dict mapping symbol to position data {qty, avg_cost, current_price, pnl}\n        cash: Available capital\n        environment: Execution environment (backtest, paper, prod)\n        total_value: Total portfolio value (cash + position values)\n    \"\"\"\n\n    def __init__(\n        self,\n        initial_cash: float,\n        environment: Environment = Environment.PAPER,\n        db: Optional[Session] = None,\n    ):\n        \"\"\"Initialize portfolio manager.\n\n        Args:\n            initial_cash: Starting capital (e.g., 100000.0)\n            environment: Execution environment tag\n            db: SQLAlchemy session (uses SessionLocal if not provided)\n        \"\"\"\n        self.initial_cash = float(initial_cash)\n        self.cash = float(initial_cash)\n        self.environment = environment\n        self.db = db or SessionLocal()\n        self.positions: Dict[str, Dict] = (\n            {}\n        )  # symbol → {qty, avg_cost, current_price, pnl}\n\n    def execute_trade(self, order: Order, fill_price: float) -> Trade:\n        \"\"\"Execute a trade, update positions, persist to database.\n\n        Args:\n            order: Order object with symbol, side, quantity\n            fill_price: Actual fill price from broker\n\n        Returns:\n            Trade object with updated portfolio state\n\n        Raises:\n            ValueError: If invalid trade data\n\n        Note:\n            Pre-trade validation (capital, position size, daily loss) is handled by RiskManager\n            BEFORE this method is called. This method only updates state.\n        \"\"\"\n        symbol = order.symbol\n        qty = float(order.quantity)\n        fill_qty = float(order.filled_quantity) if order.filled_quantity else qty\n        trade_value = fill_qty * fill_price\n\n        # NOTE: Capital validation already done by RiskManager.validate_trade()\n        # If we reach here, the trade is already validated\n\n        # Determine entry price and action type BEFORE updating position\n        entry_price_for_sell = None\n        position_qty_before = (\n            self.positions[symbol][\"qty\"] if symbol in self.positions else 0.0\n        )\n\n        if order.side == OrderSide.SELL:\n            if position_qty_before > 0:\n                # Closing LONG position\n                entry_price_for_sell = self.positions[symbol][\"avg_cost\"]\n            elif position_qty_before == 0:\n                # Opening new SHORT position\n                entry_price_for_sell = None\n            elif position_qty_before < 0:\n                # Increasing existing SHORT position\n                entry_price_for_sell = self.positions[symbol][\"avg_cost\"]\n        elif order.side == OrderSide.BUY:\n            if position_qty_before < 0:\n                # Closing SHORT position\n                entry_price_for_sell = self.positions[symbol][\"avg_cost\"]\n\n        # Update positions based on side\n        if order.side == OrderSide.BUY:\n            self._execute_buy(symbol, fill_qty, fill_price)\n        elif order.side == OrderSide.SELL:\n            self._execute_sell(symbol, fill_qty, fill_price)","numLines":100,"startLine":1,"totalLines":444}}}
