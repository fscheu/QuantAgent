{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011wmGhPQcaqDsvFakna3AgN","type":"tool_result","content":"1\t\"\"\"\n2\tOrder Manager: Orchestrates the complete order execution flow.\n3\t\n4\tFlow:\n5\t1. PositionSizer.calculate_size() → qty\n6\t2. RiskManager.validate_trade() → (valid, reason)\n7\t   - If False: REJECT (return None)\n8\t   - If True: continue\n9\t3. Create Order object\n10\t4. PaperBroker.place_order() → filled_order\n11\t5. PortfolioManager.execute_trade() → Trade\n12\t6. RiskManager.on_trade_executed() → update daily P&L\n13\t7. Database.add(trade) → commit\n14\t\"\"\"\n15\t\n16\timport logging\n17\tfrom typing import Optional\n18\t\n19\tfrom sqlalchemy.orm import Session\n20\t\n21\tfrom quantagent.models import Order, OrderSide, OrderType, Signal, TradeSignal\n22\t\n23\tfrom .position_sizer import PositionSizer\n24\tfrom .risk_manager import RiskManager\n25\t\n26\tlogger = logging.getLogger(__name__)\n27\t\n28\t\n29\tclass OrderManager:\n30\t    \"\"\"Orchestrates order execution: Size → Validate → Execute → Update → Log.\"\"\"\n31\t\n32\t    def __init__(\n33\t        self,\n34\t        position_sizer: PositionSizer,\n35\t        risk_manager: RiskManager,\n36\t        broker,  # PaperBroker instance\n37\t        portfolio_manager,  # PortfolioManager instance\n38\t        db: Session,\n39\t    ):\n40\t        \"\"\"\n41\t        Initialize Order Manager.\n42\t\n43\t        Args:\n44\t            position_sizer: PositionSizer instance\n45\t            risk_manager: RiskManager instance\n46\t            broker: Broker instance (PaperBroker)\n47\t            portfolio_manager: PortfolioManager instance\n48\t            db: SQLAlchemy session\n49\t        \"\"\"\n50\t        self.position_sizer = position_sizer\n51\t        self.risk_manager = risk_manager\n52\t        self.broker = broker\n53\t        self.portfolio = portfolio_manager\n54\t        self.db = db\n55\t\n56\t    def execute_decision(\n57\t        self,\n58\t        symbol: str,\n59\t        decision: TradeSignal,\n60\t        confidence: float,\n61\t        current_price: float,\n62\t        environment=None,\n63\t        trigger_signal_id: Optional[int] = None,\n64\t    ) -> Optional[Order]:\n65\t        \"\"\"\n66\t        Execute a trading decision end-to-end.\n67\t\n68\t        Flow:\n69\t        1. If HOLD → return None\n70\t        2. Calculate size based on confidence\n71\t        3. Detect position reversal (SHORT->LONG or LONG->SHORT)\n72\t        4. If reversal: execute two-order reversal (close + open)\n73\t        5. If not reversal: validate trade and execute single order\n74\t        6. Update risk tracker\n75\t        7. Log to database\n76\t\n77\t        Args:\n78\t            symbol: Trading symbol (e.g., \"BTC\", \"SPX\")\n79\t            decision: \"LONG\", \"SHORT\", or \"HOLD\"\n80\t            confidence: Signal confidence (0-1)\n81\t            current_price: Current market price\n82\t            environment: Environment enum (BACKTEST, PAPER, PROD) - optional\n83\t            trigger_signal_id: ID of signal that triggered this order - optional\n84\t\n85\t        Returns:\n86\t            Filled Order if executed, None if rejected\n87\t        \"\"\"\n88\t        # Step 1: HOLD decision\n89\t        if decision == TradeSignal.NEUTRAL:\n90\t            logger.info(f\"{symbol}: NEUTRAL signal, no trade executed\")\n91\t            return None\n92\t\n93\t        # Step 2: Calculate position size\n94\t        portfolio_value = self.portfolio.get_total_value()\n95\t        qty = self.position_sizer.calculate_size(\n96\t            symbol=symbol,\n97\t            signal_confidence=confidence,\n98\t            current_price=current_price,\n99\t            portfolio_value=portfolio_value,\n100\t        )\n101\t\n102\t        logger.info(\n103\t            f\"{symbol}: Size calculated - {decision} {qty:.6f} @ ${current_price:.2f} \"\n104\t            f\"(confidence={confidence:.1%}, portfolio=${portfolio_value:.2f})\"\n105\t        )\n106\t\n107\t        # Determine order side BEFORE validation (needed for position check)\n108\t        side = OrderSide.BUY if decision.upper() == \"LONG\" else OrderSide.SELL\n109\t\n110\t        # Check for position reversal\n111\t        current_position = self.portfolio.get_position(symbol)\n112\t        existing_qty = current_position.get(\"qty\", 0.0) if current_position else 0.0\n113\t\n114\t        is_reversal = (existing_qty > 0 and side == OrderSide.SELL) or (\n115\t            existing_qty < 0 and side == OrderSide.BUY\n116\t        )\n117\t\n118\t        if is_reversal:\n119\t            logger.info(\n120\t                f\"{symbol}: Position reversal detected - existing qty: {existing_qty}, new side: {side}\"\n121\t            )\n122\t            # Execute reversal as two orders: close existing + open new\n123\t            return self._execute_reversal(\n124\t                symbol=symbol,\n125\t                existing_qty=existing_qty,\n126\t                new_side=side,\n127\t                new_qty=qty,\n128\t                current_price=current_price,\n129\t                environment=environment,\n130\t                trigger_signal_id=trigger_signal_id,\n131\t            )\n132\t\n133\t        # Step 3: Validate trade (now includes position management check)\n134\t        is_valid, reason = self.risk_manager.validate_trade(\n135\t            symbol, side, qty, current_price\n136\t        )\n137\t\n138\t        if not is_valid:\n139\t            logger.warning(f\"{symbol}: Trade rejected - {reason}\")\n140\t            return None\n141\t\n142\t        logger.info(f\"{symbol}: Trade validation passed - proceeding to execution\")\n143\t\n144\t        # Step 4: Create Order object\n145\t        order = Order(\n146\t            symbol=symbol,\n147\t            side=side,\n148\t            quantity=qty,\n149\t            price=current_price,\n150\t            order_type=OrderType.MARKET,\n151\t            environment=environment,  # Set environment (backtest/paper/prod)\n152\t            trigger_signal_id=trigger_signal_id,  # Set provenance link\n153\t        )\n154\t\n155\t        # Persist order early to obtain ID for provenance\n156\t        try:\n157\t            self.db.add(order)\n158\t            self.db.flush()\n159\t        except Exception as e:\n160\t            logger.error(f\"{symbol}: Failed to persist order pre-fill - {str(e)}\")\n161\t            self.db.rollback()\n162\t            return None\n163\t\n164\t        # Step 5: Place with broker\n165\t        try:\n166\t            filled_order = self.broker.place_order(order)\n167\t            logger.info(\n168\t                f\"{symbol}: Order filled - {filled_order.side} {filled_order.filled_quantity:.6f} \"\n169\t                f\"@ ${filled_order.average_fill_price:.2f}\"\n170\t            )\n171\t        except Exception as e:\n172\t            logger.error(f\"{symbol}: Broker execution failed - {str(e)}\")\n173\t            return None\n174\t\n175\t        # Step 6: Update portfolio\n176\t        try:\n177\t            trade = self.portfolio.execute_trade(\n178\t                filled_order, filled_order.average_fill_price\n179\t            )\n180\t            logger.info(f\"{symbol}: Portfolio updated - {side} {qty:.6f} executed\")\n181\t        except Exception as e:\n182\t            logger.error(f\"{symbol}: Portfolio update failed - {str(e)}\")\n183\t            return None\n184\t\n185\t        # Step 7: Update risk tracker (post-trade P&L)\n186\t        self.risk_manager.on_trade_executed(trade)\n187\t\n188\t        # Step 8: Log to database (persist filled order and trade)\n189\t        try:\n190\t            # Update reverse provenance link if available\n191\t            if trigger_signal_id:\n192\t                sig = (\n193\t                    self.db.query(Signal).filter(Signal.id == trigger_signal_id).first()\n194\t                )\n195\t                if sig and not sig.order_id:\n196\t                    sig.order_id = order.id\n197\t            self.db.add(trade)\n198\t            self.db.commit()\n199\t            logger.info(f\"{symbol}: Trade logged to database\")\n200\t        except Exception as e:\n201\t            logger.error(f\"{symbol}: Database logging failed - {str(e)}\")\n202\t            self.db.rollback()\n203\t            return None\n204\t\n205\t        return filled_order\n206\t\n207\t    def execute_decision_with_order(\n208\t        self,\n209\t        order: Order,\n210\t        decision: str,\n211\t        confidence: float,\n212\t        current_price: float,\n213\t    ) -> Optional[Order]:\n214\t        \"\"\"\n215\t        Execute an order that's already created (alternative to execute_decision).\n216\t\n217\t        Args:\n218\t            order: Pre-created Order object\n219\t            decision: \"LONG\", \"SHORT\", or \"HOLD\"\n220\t            confidence: Signal confidence\n221\t            current_price: Current market price\n222\t\n223\t        Returns:\n224\t            Filled Order if executed, None if rejected\n225\t        \"\"\"\n226\t        if decision.upper() == \"HOLD\":\n227\t            logger.info(f\"{order.symbol}: HOLD signal, no trade executed\")\n228\t            return None\n229\t\n230\t        # Validate trade (includes position management check)\n231\t        is_valid, reason = self.risk_manager.validate_trade(\n232\t            order.symbol,\n233\t            order.side,\n234\t            order.quantity,\n235\t            order.price or current_price,\n236\t        )\n237\t\n238\t        if not is_valid:\n239\t            logger.warning(f\"{order.symbol}: Trade rejected - {reason}\")\n240\t            return None\n241\t\n242\t        # Place with broker\n243\t        try:\n244\t            filled_order = self.broker.place_order(order)\n245\t        except Exception as e:\n246\t            logger.error(f\"{order.symbol}: Broker execution failed - {str(e)}\")\n247\t            return None\n248\t\n249\t        # Update portfolio\n250\t        try:\n251\t            trade = self.portfolio.execute_trade(\n252\t                filled_order, filled_order.average_fill_price\n253\t            )\n254\t        except Exception as e:\n255\t            logger.error(f\"{order.symbol}: Portfolio update failed - {str(e)}\")\n256\t            return None\n257\t\n258\t        # Update risk tracker\n259\t        self.risk_manager.on_trade_executed(trade)\n260\t\n261\t        return filled_order\n262\t\n263\t    def _execute_reversal(\n264\t        self,\n265\t        symbol: str,\n266\t        existing_qty: float,\n267\t        new_side: OrderSide,\n268\t        new_qty: float,\n269\t        current_price: float,\n270\t        environment=None,\n271\t        trigger_signal_id: Optional[int] = None,\n272\t    ) -> Optional[Order]:\n273\t        \"\"\"\n274\t        Execute position reversal as two orders: close existing position, then open new.\n275\t\n276\t        Args:\n277\t            symbol: Trading symbol\n278\t            existing_qty: Current position quantity (positive=LONG, negative=SHORT)\n279\t            new_side: Side of new position (BUY=LONG, SELL=SHORT)\n280\t            new_qty: Quantity for new position\n281\t            current_price: Current market price\n282\t            environment: Environment enum\n283\t            trigger_signal_id: ID of signal that triggered this order\n284\t\n285\t        Returns:\n286\t            Filled Order for the new position if successful, None if failed\n287\t        \"\"\"\n288\t        # Log initial state\n289\t        portfolio_value = self.portfolio.get_total_value()\n290\t        logger.info(\n291\t            f\"{symbol}: Starting position reversal - \"\n292\t            f\"Current: {('LONG' if existing_qty > 0 else 'SHORT')} {abs(existing_qty):.6f}, \"\n293\t            f\"Target: {new_side.name} {new_qty:.6f}, \"\n294\t            f\"Portfolio value: ${portfolio_value:.2f}\"\n295\t        )\n296\t\n297\t        # Step 1: Close existing position\n298\t        close_side = OrderSide.SELL if existing_qty > 0 else OrderSide.BUY\n299\t        close_qty = abs(existing_qty)\n300\t\n301\t        logger.info(\n302\t            f\"{symbol}: Executing reversal - Step 1: Close {close_side} {close_qty:.6f}\"\n303\t        )\n304\t\n305\t        # Validate close trade\n306\t        is_valid, reason = self.risk_manager.validate_trade(\n307\t            symbol, close_side, close_qty, current_price\n308\t        )\n309\t        if not is_valid:\n310\t            logger.warning(f\"{symbol}: Close order rejected - {reason}\")\n311\t            return None\n312\t\n313\t        # Create close order\n314\t        close_order = Order(\n315\t            symbol=symbol,\n316\t            side=close_side,\n317\t            quantity=close_qty,\n318\t            price=current_price,\n319\t            order_type=OrderType.MARKET,\n320\t            environment=environment,\n321\t            trigger_signal_id=trigger_signal_id,\n322\t        )\n323\t\n324\t        # Persist close order\n325\t        try:\n326\t            self.db.add(close_order)\n327\t            self.db.flush()\n328\t        except Exception as e:\n329\t            logger.error(f\"{symbol}: Failed to persist close order - {str(e)}\")\n330\t            self.db.rollback()\n331\t            return None\n332\t\n333\t        # Execute close order with broker\n334\t        try:\n335\t            filled_close_order = self.broker.place_order(close_order)\n336\t            logger.info(\n337\t                f\"{symbol}: Close order filled - {filled_close_order.side} {filled_close_order.filled_quantity:.6f} \"\n338\t                f\"@ ${filled_close_order.average_fill_price:.2f}\"\n339\t            )\n340\t        except Exception as e:\n341\t            logger.error(f\"{symbol}: Close order broker execution failed - {str(e)}\")\n342\t            return None\n343\t\n344\t        # Update portfolio for close\n345\t        try:\n346\t            close_trade = self.portfolio.execute_trade(\n347\t                filled_close_order, filled_close_order.average_fill_price\n348\t            )\n349\t            logger.info(\n350\t                f\"{symbol}: Portfolio updated - close {close_side} {close_qty:.6f} executed\"\n351\t            )\n352\t        except Exception as e:\n353\t            logger.error(\n354\t                f\"{symbol}: Reversal ABORTED at step 1 - Close order portfolio update failed: {type(e).__name__}: {str(e)}. \"\n355\t                f\"Position may remain in original state. Portfolio value: ${self.portfolio.get_total_value():.2f}\"\n356\t            )\n357\t            return None\n358\t\n359\t        # Update risk tracker for close\n360\t        self.risk_manager.on_trade_executed(close_trade)\n361\t\n362\t        # Persist close trade\n363\t        try:\n364\t            if trigger_signal_id:\n365\t                sig = (\n366\t                    self.db.query(Signal)\n367\t                    .filter(Signal.id == trigger_signal_id)\n368\t                    .first()\n369\t                )\n370\t                if sig and not sig.order_id:\n371\t                    sig.order_id = close_order.id\n372\t            self.db.add(close_trade)\n373\t            self.db.commit()\n374\t            logger.info(f\"{symbol}: Close trade logged to database\")\n375\t        except Exception as e:\n376\t            logger.error(f\"{symbol}: Close trade database logging failed - {str(e)}\")\n377\t            self.db.rollback()\n378\t            return None\n379\t\n380\t        # Step 2: Open new position\n381\t        logger.info(\n382\t            f\"{symbol}: Reversal step 1/2 complete - position closed. \"\n383\t            f\"Proceeding to step 2: Open {new_side} {new_qty:.6f}\"\n384\t        )\n385\t\n386\t        # Validate new trade\n387\t        is_valid, reason = self.risk_manager.validate_trade(\n388\t            symbol, new_side, new_qty, current_price\n389\t        )\n390\t        if not is_valid:\n391\t            logger.error(\n392\t                f\"{symbol}: Reversal PARTIAL FAILURE - Close succeeded but new position rejected: {reason}. \"\n393\t                f\"Position is now FLAT (no exposure). Portfolio value: ${self.portfolio.get_total_value():.2f}\"\n394\t            )\n395\t            return None\n396\t\n397\t        # Create new position order\n398\t        new_order = Order(\n399\t            symbol=symbol,\n400\t            side=new_side,\n401\t            quantity=new_qty,\n402\t            price=current_price,\n403\t            order_type=OrderType.MARKET,\n404\t            environment=environment,\n405\t            trigger_signal_id=trigger_signal_id,\n406\t        )\n407\t\n408\t        # Persist new order\n409\t        try:\n410\t            self.db.add(new_order)\n411\t            self.db.flush()\n412\t        except Exception as e:\n413\t            logger.error(f\"{symbol}: Failed to persist new order - {str(e)}\")\n414\t            self.db.rollback()\n415\t            return None\n416\t\n417\t        # Execute new order with broker\n418\t        try:\n419\t            filled_new_order = self.broker.place_order(new_order)\n420\t            logger.info(\n421\t                f\"{symbol}: New order filled - {filled_new_order.side} {filled_new_order.filled_quantity:.6f} \"\n422\t                f\"@ ${filled_new_order.average_fill_price:.2f}\"\n423\t            )\n424\t        except Exception as e:\n425\t            logger.error(f\"{symbol}: New order broker execution failed - {str(e)}\")\n426\t            return None\n427\t\n428\t        # Update portfolio for new position\n429\t        try:\n430\t            new_trade = self.portfolio.execute_trade(\n431\t                filled_new_order, filled_new_order.average_fill_price\n432\t            )\n433\t            logger.info(\n434\t                f\"{symbol}: Portfolio updated - new {new_side} {new_qty:.6f} executed\"\n435\t            )\n436\t        except Exception as e:\n437\t            logger.error(\n438\t                f\"{symbol}: Reversal PARTIAL FAILURE - Close succeeded but new order portfolio update failed: {type(e).__name__}: {str(e)}. \"\n439\t                f\"Position is now FLAT (no exposure). Portfolio value: ${self.portfolio.get_total_value():.2f}\"\n440\t            )\n441\t            return None\n442\t\n443\t        # Update risk tracker for new position\n444\t        self.risk_manager.on_trade_executed(new_trade)\n445\t\n446\t        # Persist new trade\n447\t        try:\n448\t            self.db.add(new_trade)\n449\t            self.db.commit()\n450\t            logger.info(f\"{symbol}: New trade logged to database\")\n451\t        except Exception as e:\n452\t            logger.error(f\"{symbol}: New trade database logging failed - {str(e)}\")\n453\t            self.db.rollback()\n454\t            return None\n455\t\n456\t        logger.info(\n457\t            f\"{symbol}: Position reversal COMPLETE - \"\n458\t            f\"New position: {new_side} {self.portfolio.positions.get(symbol, {}).get('qty', 0):.6f} \"\n459\t            f\"@ ${self.portfolio.positions.get(symbol, {}).get('avg_cost', 0):.2f}. \"\n460\t            f\"Portfolio value: ${self.portfolio.get_total_value():.2f}\"\n461\t        )\n462\t        return filled_new_order\n463\t"}]},"parent_tool_use_id":null,"session_id":"0ba6b8a9-0956-46b4-a5ab-2f80c3a37c45","uuid":"bfb53f61-ca4a-45d9-82dc-a26805e24774","timestamp":"2026-05-12T02:40:52.040Z","tool_use_result":{"type":"text","file":{"filePath":"/home/azureuser/repos/projects/QuantAgent/quantagent/trading/order_manager.py","content":"\"\"\"\nOrder Manager: Orchestrates the complete order execution flow.\n\nFlow:\n1. PositionSizer.calculate_size() → qty\n2. RiskManager.validate_trade() → (valid, reason)\n   - If False: REJECT (return None)\n   - If True: continue\n3. Create Order object\n4. PaperBroker.place_order() → filled_order\n5. PortfolioManager.execute_trade() → Trade\n6. RiskManager.on_trade_executed() → update daily P&L\n7. Database.add(trade) → commit\n\"\"\"\n\nimport logging\nfrom typing import Optional\n\nfrom sqlalchemy.orm import Session\n\nfrom quantagent.models import Order, OrderSide, OrderType, Signal, TradeSignal\n\nfrom .position_sizer import PositionSizer\nfrom .risk_manager import RiskManager\n\nlogger = logging.getLogger(__name__)\n\n\nclass OrderManager:\n    \"\"\"Orchestrates order execution: Size → Validate → Execute → Update → Log.\"\"\"\n\n    def __init__(\n        self,\n        position_sizer: PositionSizer,\n        risk_manager: RiskManager,\n        broker,  # PaperBroker instance\n        portfolio_manager,  # PortfolioManager instance\n        db: Session,\n    ):\n        \"\"\"\n        Initialize Order Manager.\n\n        Args:\n            position_sizer: PositionSizer instance\n            risk_manager: RiskManager instance\n            broker: Broker instance (PaperBroker)\n            portfolio_manager: PortfolioManager instance\n            db: SQLAlchemy session\n        \"\"\"\n        self.position_sizer = position_sizer\n        self.risk_manager = risk_manager\n        self.broker = broker\n        self.portfolio = portfolio_manager\n        self.db = db\n\n    def execute_decision(\n        self,\n        symbol: str,\n        decision: TradeSignal,\n        confidence: float,\n        current_price: float,\n        environment=None,\n        trigger_signal_id: Optional[int] = None,\n    ) -> Optional[Order]:\n        \"\"\"\n        Execute a trading decision end-to-end.\n\n        Flow:\n        1. If HOLD → return None\n        2. Calculate size based on confidence\n        3. Detect position reversal (SHORT->LONG or LONG->SHORT)\n        4. If reversal: execute two-order reversal (close + open)\n        5. If not reversal: validate trade and execute single order\n        6. Update risk tracker\n        7. Log to database\n\n        Args:\n            symbol: Trading symbol (e.g., \"BTC\", \"SPX\")\n            decision: \"LONG\", \"SHORT\", or \"HOLD\"\n            confidence: Signal confidence (0-1)\n            current_price: Current market price\n            environment: Environment enum (BACKTEST, PAPER, PROD) - optional\n            trigger_signal_id: ID of signal that triggered this order - optional\n\n        Returns:\n            Filled Order if executed, None if rejected\n        \"\"\"\n        # Step 1: HOLD decision\n        if decision == TradeSignal.NEUTRAL:\n            logger.info(f\"{symbol}: NEUTRAL signal, no trade executed\")\n            return None\n\n        # Step 2: Calculate position size\n        portfolio_value = self.portfolio.get_total_value()\n        qty = self.position_sizer.calculate_size(\n            symbol=symbol,\n            signal_confidence=confidence,\n            current_price=current_price,\n            portfolio_value=portfolio_value,\n        )\n\n        logger.info(\n            f\"{symbol}: Size calculated - {decision} {qty:.6f} @ ${current_price:.2f} \"\n            f\"(confidence={confidence:.1%}, portfolio=${portfolio_value:.2f})\"\n        )\n\n        # Determine order side BEFORE validation (needed for position check)\n        side = OrderSide.BUY if decision.upper() == \"LONG\" else OrderSide.SELL\n\n        # Check for position reversal\n        current_position = self.portfolio.get_position(symbol)\n        existing_qty = current_position.get(\"qty\", 0.0) if current_position else 0.0\n\n        is_reversal = (existing_qty > 0 and side == OrderSide.SELL) or (\n            existing_qty < 0 and side == OrderSide.BUY\n        )\n\n        if is_reversal:\n            logger.info(\n                f\"{symbol}: Position reversal detected - existing qty: {existing_qty}, new side: {side}\"\n            )\n            # Execute reversal as two orders: close existing + open new\n            return self._execute_reversal(\n                symbol=symbol,\n                existing_qty=existing_qty,\n                new_side=side,\n                new_qty=qty,\n                current_price=current_price,\n                environment=environment,\n                trigger_signal_id=trigger_signal_id,\n            )\n\n        # Step 3: Validate trade (now includes position management check)\n        is_valid, reason = self.risk_manager.validate_trade(\n            symbol, side, qty, current_price\n        )\n\n        if not is_valid:\n            logger.warning(f\"{symbol}: Trade rejected - {reason}\")\n            return None\n\n        logger.info(f\"{symbol}: Trade validation passed - proceeding to execution\")\n\n        # Step 4: Create Order object\n        order = Order(\n            symbol=symbol,\n            side=side,\n            quantity=qty,\n            price=current_price,\n            order_type=OrderType.MARKET,\n            environment=environment,  # Set environment (backtest/paper/prod)\n            trigger_signal_id=trigger_signal_id,  # Set provenance link\n        )\n\n        # Persist order early to obtain ID for provenance\n        try:\n            self.db.add(order)\n            self.db.flush()\n        except Exception as e:\n            logger.error(f\"{symbol}: Failed to persist order pre-fill - {str(e)}\")\n            self.db.rollback()\n            return None\n\n        # Step 5: Place with broker\n        try:\n            filled_order = self.broker.place_order(order)\n            logger.info(\n                f\"{symbol}: Order filled - {filled_order.side} {filled_order.filled_quantity:.6f} \"\n                f\"@ ${filled_order.average_fill_price:.2f}\"\n            )\n        except Exception as e:\n            logger.error(f\"{symbol}: Broker execution failed - {str(e)}\")\n            return None\n\n        # Step 6: Update portfolio\n        try:\n            trade = self.portfolio.execute_trade(\n                filled_order, filled_order.average_fill_price\n            )\n            logger.info(f\"{symbol}: Portfolio updated - {side} {qty:.6f} executed\")\n        except Exception as e:\n            logger.error(f\"{symbol}: Portfolio update failed - {str(e)}\")\n            return None\n\n        # Step 7: Update risk tracker (post-trade P&L)\n        self.risk_manager.on_trade_executed(trade)\n\n        # Step 8: Log to database (persist filled order and trade)\n        try:\n            # Update reverse provenance link if available\n            if trigger_signal_id:\n                sig = (\n                    self.db.query(Signal).filter(Signal.id == trigger_signal_id).first()\n                )\n                if sig and not sig.order_id:\n                    sig.order_id = order.id\n            self.db.add(trade)\n            self.db.commit()\n            logger.info(f\"{symbol}: Trade logged to database\")\n        except Exception as e:\n            logger.error(f\"{symbol}: Database logging failed - {str(e)}\")\n            self.db.rollback()\n            return None\n\n        return filled_order\n\n    def execute_decision_with_order(\n        self,\n        order: Order,\n        decision: str,\n        confidence: float,\n        current_price: float,\n    ) -> Optional[Order]:\n        \"\"\"\n        Execute an order that's already created (alternative to execute_decision).\n\n        Args:\n            order: Pre-created Order object\n            decision: \"LONG\", \"SHORT\", or \"HOLD\"\n            confidence: Signal confidence\n            current_price: Current market price\n\n        Returns:\n            Filled Order if executed, None if rejected\n        \"\"\"\n        if decision.upper() == \"HOLD\":\n            logger.info(f\"{order.symbol}: HOLD signal, no trade executed\")\n            return None\n\n        # Validate trade (includes position management check)\n        is_valid, reason = self.risk_manager.validate_trade(\n            order.symbol,\n            order.side,\n            order.quantity,\n            order.price or current_price,\n        )\n\n        if not is_valid:\n            logger.warning(f\"{order.symbol}: Trade rejected - {reason}\")\n            return None\n\n        # Place with broker\n        try:\n            filled_order = self.broker.place_order(order)\n        except Exception as e:\n            logger.error(f\"{order.symbol}: Broker execution failed - {str(e)}\")\n            return None\n\n        # Update portfolio\n        try:\n            trade = self.portfolio.execute_trade(\n                filled_order, filled_order.average_fill_price\n            )\n        except Exception as e:\n            logger.error(f\"{order.symbol}: Portfolio update failed - {str(e)}\")\n            return None\n\n        # Update risk tracker\n        self.risk_manager.on_trade_executed(trade)\n\n        return filled_order\n\n    def _execute_reversal(\n        self,\n        symbol: str,\n        existing_qty: float,\n        new_side: OrderSide,\n        new_qty: float,\n        current_price: float,\n        environment=None,\n        trigger_signal_id: Optional[int] = None,\n    ) -> Optional[Order]:\n        \"\"\"\n        Execute position reversal as two orders: close existing position, then open new.\n\n        Args:\n            symbol: Trading symbol\n            existing_qty: Current position quantity (positive=LONG, negative=SHORT)\n            new_side: Side of new position (BUY=LONG, SELL=SHORT)\n            new_qty: Quantity for new position\n            current_price: Current market price\n            environment: Environment enum\n            trigger_signal_id: ID of signal that triggered this order\n\n        Returns:\n            Filled Order for the new position if successful, None if failed\n        \"\"\"\n        # Log initial state\n        portfolio_value = self.portfolio.get_total_value()\n        logger.info(\n            f\"{symbol}: Starting position reversal - \"\n            f\"Current: {('LONG' if existing_qty > 0 else 'SHORT')} {abs(existing_qty):.6f}, \"\n            f\"Target: {new_side.name} {new_qty:.6f}, \"\n            f\"Portfolio value: ${portfolio_value:.2f}\"\n        )\n\n        # Step 1: Close existing position\n        close_side = OrderSide.SELL if existing_qty > 0 else OrderSide.BUY\n        close_qty = abs(existing_qty)\n\n        logger.info(\n            f\"{symbol}: Executing reversal - Step 1: Close {close_side} {close_qty:.6f}\"\n        )\n\n        # Validate close trade\n        is_valid, reason = self.risk_manager.validate_trade(\n            symbol, close_side, close_qty, current_price\n        )\n        if not is_valid:\n            logger.warning(f\"{symbol}: Close order rejected - {reason}\")\n            return None\n\n        # Create close order\n        close_order = Order(\n            symbol=symbol,\n            side=close_side,\n            quantity=close_qty,\n            price=current_price,\n            order_type=OrderType.MARKET,\n            environment=environment,\n            trigger_signal_id=trigger_signal_id,\n        )\n\n        # Persist close order\n        try:\n            self.db.add(close_order)\n            self.db.flush()\n        except Exception as e:\n            logger.error(f\"{symbol}: Failed to persist close order - {str(e)}\")\n            self.db.rollback()\n            return None\n\n        # Execute close order with broker\n        try:\n            filled_close_order = self.broker.place_order(close_order)\n            logger.info(\n                f\"{symbol}: Close order filled - {filled_close_order.side} {filled_close_order.filled_quantity:.6f} \"\n                f\"@ ${filled_close_order.average_fill_price:.2f}\"\n            )\n        except Exception as e:\n            logger.error(f\"{symbol}: Close order broker execution failed - {str(e)}\")\n            return None\n\n        # Update portfolio for close\n        try:\n            close_trade = self.portfolio.execute_trade(\n                filled_close_order, filled_close_order.average_fill_price\n            )\n            logger.info(\n                f\"{symbol}: Portfolio updated - close {close_side} {close_qty:.6f} executed\"\n            )\n        except Exception as e:\n            logger.error(\n                f\"{symbol}: Reversal ABORTED at step 1 - Close order portfolio update failed: {type(e).__name__}: {str(e)}. \"\n                f\"Position may remain in original state. Portfolio value: ${self.portfolio.get_total_value():.2f}\"\n            )\n            return None\n\n        # Update risk tracker for close\n        self.risk_manager.on_trade_executed(close_trade)\n\n        # Persist close trade\n        try:\n            if trigger_signal_id:\n                sig = (\n                    self.db.query(Signal)\n                    .filter(Signal.id == trigger_signal_id)\n                    .first()\n                )\n                if sig and not sig.order_id:\n                    sig.order_id = close_order.id\n            self.db.add(close_trade)\n            self.db.commit()\n            logger.info(f\"{symbol}: Close trade logged to database\")\n        except Exception as e:\n            logger.error(f\"{symbol}: Close trade database logging failed - {str(e)}\")\n            self.db.rollback()\n            return None\n\n        # Step 2: Open new position\n        logger.info(\n            f\"{symbol}: Reversal step 1/2 complete - position closed. \"\n            f\"Proceeding to step 2: Open {new_side} {new_qty:.6f}\"\n        )\n\n        # Validate new trade\n        is_valid, reason = self.risk_manager.validate_trade(\n            symbol, new_side, new_qty, current_price\n        )\n        if not is_valid:\n            logger.error(\n                f\"{symbol}: Reversal PARTIAL FAILURE - Close succeeded but new position rejected: {reason}. \"\n                f\"Position is now FLAT (no exposure). Portfolio value: ${self.portfolio.get_total_value():.2f}\"\n            )\n            return None\n\n        # Create new position order\n        new_order = Order(\n            symbol=symbol,\n            side=new_side,\n            quantity=new_qty,\n            price=current_price,\n            order_type=OrderType.MARKET,\n            environment=environment,\n            trigger_signal_id=trigger_signal_id,\n        )\n\n        # Persist new order\n        try:\n            self.db.add(new_order)\n            self.db.flush()\n        except Exception as e:\n            logger.error(f\"{symbol}: Failed to persist new order - {str(e)}\")\n            self.db.rollback()\n            return None\n\n        # Execute new order with broker\n        try:\n            filled_new_order = self.broker.place_order(new_order)\n            logger.info(\n                f\"{symbol}: New order filled - {filled_new_order.side} {filled_new_order.filled_quantity:.6f} \"\n                f\"@ ${filled_new_order.average_fill_price:.2f}\"\n            )\n        except Exception as e:\n            logger.error(f\"{symbol}: New order broker execution failed - {str(e)}\")\n            return None\n\n        # Update portfolio for new position\n        try:\n            new_trade = self.portfolio.execute_trade(\n                filled_new_order, filled_new_order.average_fill_price\n            )\n            logger.info(\n                f\"{symbol}: Portfolio updated - new {new_side} {new_qty:.6f} executed\"\n            )\n        except Exception as e:\n            logger.error(\n                f\"{symbol}: Reversal PARTIAL FAILURE - Close succeeded but new order portfolio update failed: {type(e).__name__}: {str(e)}. \"\n                f\"Position is now FLAT (no exposure). Portfolio value: ${self.portfolio.get_total_value():.2f}\"\n            )\n            return None\n\n        # Update risk tracker for new position\n        self.risk_manager.on_trade_executed(new_trade)\n\n        # Persist new trade\n        try:\n            self.db.add(new_trade)\n            self.db.commit()\n            logger.info(f\"{symbol}: New trade logged to database\")\n        except Exception as e:\n            logger.error(f\"{symbol}: New trade database logging failed - {str(e)}\")\n            self.db.rollback()\n            return None\n\n        logger.info(\n            f\"{symbol}: Position reversal COMPLETE - \"\n            f\"New position: {new_side} {self.portfolio.positions.get(symbol, {}).get('qty', 0):.6f} \"\n            f\"@ ${self.portfolio.positions.get(symbol, {}).get('avg_cost', 0):.2f}. \"\n            f\"Portfolio value: ${self.portfolio.get_total_value():.2f}\"\n        )\n        return filled_new_order\n","numLines":463,"startLine":1,"totalLines":463}}}
