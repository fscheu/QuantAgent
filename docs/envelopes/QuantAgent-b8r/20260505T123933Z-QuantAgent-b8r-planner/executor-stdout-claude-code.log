{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01TcM7JZd1TWQYfUSyW4DRiM","type":"tool_result","content":"1\t\"\"\"RSI Mean Reversion Strategy - example non-LLM strategy.\"\"\"\n2\t\n3\tfrom typing import Dict, List, Optional\n4\t\n5\timport pandas as pd\n6\t\n7\tfrom ..models import ActivePosition, ExitPolicy\n8\tfrom .base import TradingSignal, TradingStrategy\n9\t\n10\t\n11\tclass RSIMeanReversionStrategy(TradingStrategy):\n12\t    \"\"\"\n13\t    Simple RSI-based mean reversion strategy (no LLM).\n14\t\n15\t    Rules:\n16\t    - BUY (LONG) when RSI < 30 (oversold)\n17\t    - SELL (SHORT) when RSI > 70 (overbought)\n18\t    - HOLD otherwise\n19\t    \"\"\"\n20\t\n21\t    def __init__(\n22\t        self,\n23\t        rsi_period: int = 14,\n24\t        oversold_threshold: float = 30.0,\n25\t        overbought_threshold: float = 70.0,\n26\t        stop_loss_pct: float = 0.02,\n27\t        take_profit_pct: float = 0.03,\n28\t        trailing_stop_pct: float = 0.05,\n29\t    ):\n30\t        \"\"\"\n31\t        Initialize RSI Mean Reversion Strategy.\n32\t\n33\t        Args:\n34\t            rsi_period: RSI calculation period (default: 14)\n35\t            oversold_threshold: RSI threshold for buy signal (default: 30)\n36\t            overbought_threshold: RSI threshold for sell signal (default: 70)\n37\t            stop_loss_pct: Stop loss percentage (default: 2%)\n38\t            take_profit_pct: Take profit percentage (default: 3%)\n39\t            trailing_stop_pct: Trailing stop percentage (default: 5%)\n40\t        \"\"\"\n41\t        self.rsi_period = rsi_period\n42\t        self.oversold_threshold = oversold_threshold\n43\t        self.overbought_threshold = overbought_threshold\n44\t        self.stop_loss_pct = stop_loss_pct\n45\t        self.take_profit_pct = take_profit_pct\n46\t        self.trailing_stop_pct = trailing_stop_pct\n47\t\n48\t    def generate_signal(\n49\t        self,\n50\t        kline_data: List[Dict],\n51\t        symbol: str,\n52\t        timeframe: str,\n53\t        current_price: float,\n54\t    ) -> Optional[TradingSignal]:\n55\t        \"\"\"\n56\t        Generate trading signal based on RSI.\n57\t\n58\t        Args:\n59\t            kline_data: List of OHLCV candles\n60\t            symbol: Asset symbol\n61\t            timeframe: Timeframe\n62\t            current_price: Current market price\n63\t\n64\t        Returns:\n65\t            TradingSignal or None if HOLD\n66\t        \"\"\"\n67\t        # Need at least rsi_period + 1 candles\n68\t        if len(kline_data) < self.rsi_period + 1:\n69\t            return None\n70\t\n71\t        # Convert to DataFrame\n72\t        df = pd.DataFrame(kline_data)\n73\t\n74\t        # Calculate RSI\n75\t        rsi = self._calculate_rsi(df[\"close\"], self.rsi_period)\n76\t        current_rsi = rsi.iloc[-1]\n77\t\n78\t        # Generate signal\n79\t        decision = \"HOLD\"\n80\t        confidence = 0.5\n81\t\n82\t        if current_rsi < self.oversold_threshold:\n83\t            decision = \"LONG\"\n84\t            # Confidence increases as RSI gets lower\n85\t            confidence = 1.0 - (current_rsi / self.oversold_threshold)\n86\t        elif current_rsi > self.overbought_threshold:\n87\t            decision = \"SHORT\"\n88\t            # Confidence increases as RSI gets higher\n89\t            confidence = (current_rsi - self.overbought_threshold) / (\n90\t                100 - self.overbought_threshold\n91\t            )\n92\t\n93\t        # If HOLD, return None\n94\t        if decision == \"HOLD\":\n95\t            return None\n96\t\n97\t        # Calculate SL/TP\n98\t        if decision == \"LONG\":\n99\t            stop_loss = current_price * (1 - self.stop_loss_pct)\n100\t            take_profit = current_price * (1 + self.take_profit_pct)\n101\t        else:  # SHORT\n102\t            stop_loss = current_price * (1 + self.stop_loss_pct)\n103\t            take_profit = current_price * (1 - self.take_profit_pct)\n104\t\n105\t        return TradingSignal(\n106\t            decision=decision,\n107\t            confidence=confidence,\n108\t            entry_price=current_price,\n109\t            stop_loss=stop_loss,\n110\t            take_profit=take_profit,\n111\t            reasoning=f\"RSI {current_rsi:.2f} - {'oversold' if decision == 'LONG' else 'overbought'}\",\n112\t            exit_policy=ExitPolicy.TRAILING_STOP,\n113\t            trailing_stop_pct=self.trailing_stop_pct,\n114\t        )\n115\t\n116\t    def _calculate_rsi(self, prices: pd.Series, period: int) -> pd.Series:\n117\t        \"\"\"\n118\t        Calculate RSI indicator.\n119\t\n120\t        Args:\n121\t            prices: Series of closing prices\n122\t            period: RSI period\n123\t\n124\t        Returns:\n125\t            Series of RSI values\n126\t        \"\"\"\n127\t        delta = prices.diff()\n128\t\n129\t        gain = delta.where(delta > 0, 0.0)\n130\t        loss = -delta.where(delta < 0, 0.0)\n131\t\n132\t        avg_gain = gain.rolling(window=period, min_periods=period).mean()\n133\t        avg_loss = loss.rolling(window=period, min_periods=period).mean()\n134\t\n135\t        # Avoid division by zero\n136\t        rs = avg_gain / avg_loss.replace(0, 1e-10)\n137\t        rsi = 100 - (100 / (1 + rs))\n138\t\n139\t        return rsi\n140\t\n141\t    def should_reevaluate(\n142\t        self,\n143\t        position: ActivePosition,\n144\t        current_price: float,\n145\t    ) -> bool:\n146\t        \"\"\"\n147\t        RSI strategy does not re-evaluate once position is opened.\n148\t\n149\t        Returns:\n150\t            False always\n151\t        \"\"\"\n152\t        return False\n153\t\n154\t    def get_default_exit_policy(self) -> ExitPolicy:\n155\t        \"\"\"Get default exit policy (trailing stop).\"\"\"\n156\t        return ExitPolicy.TRAILING_STOP\n157\t"}]},"parent_tool_use_id":null,"session_id":"3e29365a-7925-40eb-8646-1f5eb6603bf2","uuid":"9a6d0fde-6be0-42c8-8586-98e493028166","timestamp":"2026-05-05T12:45:10.225Z","tool_use_result":{"type":"text","file":{"filePath":"/home/azureuser/repos/projects/QuantAgent/quantagent/strategy/rsi_strategy.py","content":"\"\"\"RSI Mean Reversion Strategy - example non-LLM strategy.\"\"\"\n\nfrom typing import Dict, List, Optional\n\nimport pandas as pd\n\nfrom ..models import ActivePosition, ExitPolicy\nfrom .base import TradingSignal, TradingStrategy\n\n\nclass RSIMeanReversionStrategy(TradingStrategy):\n    \"\"\"\n    Simple RSI-based mean reversion strategy (no LLM).\n\n    Rules:\n    - BUY (LONG) when RSI < 30 (oversold)\n    - SELL (SHORT) when RSI > 70 (overbought)\n    - HOLD otherwise\n    \"\"\"\n\n    def __init__(\n        self,\n        rsi_period: int = 14,\n        oversold_threshold: float = 30.0,\n        overbought_threshold: float = 70.0,\n        stop_loss_pct: float = 0.02,\n        take_profit_pct: float = 0.03,\n        trailing_stop_pct: float = 0.05,\n    ):\n        \"\"\"\n        Initialize RSI Mean Reversion Strategy.\n\n        Args:\n            rsi_period: RSI calculation period (default: 14)\n            oversold_threshold: RSI threshold for buy signal (default: 30)\n            overbought_threshold: RSI threshold for sell signal (default: 70)\n            stop_loss_pct: Stop loss percentage (default: 2%)\n            take_profit_pct: Take profit percentage (default: 3%)\n            trailing_stop_pct: Trailing stop percentage (default: 5%)\n        \"\"\"\n        self.rsi_period = rsi_period\n        self.oversold_threshold = oversold_threshold\n        self.overbought_threshold = overbought_threshold\n        self.stop_loss_pct = stop_loss_pct\n        self.take_profit_pct = take_profit_pct\n        self.trailing_stop_pct = trailing_stop_pct\n\n    def generate_signal(\n        self,\n        kline_data: List[Dict],\n        symbol: str,\n        timeframe: str,\n        current_price: float,\n    ) -> Optional[TradingSignal]:\n        \"\"\"\n        Generate trading signal based on RSI.\n\n        Args:\n            kline_data: List of OHLCV candles\n            symbol: Asset symbol\n            timeframe: Timeframe\n            current_price: Current market price\n\n        Returns:\n            TradingSignal or None if HOLD\n        \"\"\"\n        # Need at least rsi_period + 1 candles\n        if len(kline_data) < self.rsi_period + 1:\n            return None\n\n        # Convert to DataFrame\n        df = pd.DataFrame(kline_data)\n\n        # Calculate RSI\n        rsi = self._calculate_rsi(df[\"close\"], self.rsi_period)\n        current_rsi = rsi.iloc[-1]\n\n        # Generate signal\n        decision = \"HOLD\"\n        confidence = 0.5\n\n        if current_rsi < self.oversold_threshold:\n            decision = \"LONG\"\n            # Confidence increases as RSI gets lower\n            confidence = 1.0 - (current_rsi / self.oversold_threshold)\n        elif current_rsi > self.overbought_threshold:\n            decision = \"SHORT\"\n            # Confidence increases as RSI gets higher\n            confidence = (current_rsi - self.overbought_threshold) / (\n                100 - self.overbought_threshold\n            )\n\n        # If HOLD, return None\n        if decision == \"HOLD\":\n            return None\n\n        # Calculate SL/TP\n        if decision == \"LONG\":\n            stop_loss = current_price * (1 - self.stop_loss_pct)\n            take_profit = current_price * (1 + self.take_profit_pct)\n        else:  # SHORT\n            stop_loss = current_price * (1 + self.stop_loss_pct)\n            take_profit = current_price * (1 - self.take_profit_pct)\n\n        return TradingSignal(\n            decision=decision,\n            confidence=confidence,\n            entry_price=current_price,\n            stop_loss=stop_loss,\n            take_profit=take_profit,\n            reasoning=f\"RSI {current_rsi:.2f} - {'oversold' if decision == 'LONG' else 'overbought'}\",\n            exit_policy=ExitPolicy.TRAILING_STOP,\n            trailing_stop_pct=self.trailing_stop_pct,\n        )\n\n    def _calculate_rsi(self, prices: pd.Series, period: int) -> pd.Series:\n        \"\"\"\n        Calculate RSI indicator.\n\n        Args:\n            prices: Series of closing prices\n            period: RSI period\n\n        Returns:\n            Series of RSI values\n        \"\"\"\n        delta = prices.diff()\n\n        gain = delta.where(delta > 0, 0.0)\n        loss = -delta.where(delta < 0, 0.0)\n\n        avg_gain = gain.rolling(window=period, min_periods=period).mean()\n        avg_loss = loss.rolling(window=period, min_periods=period).mean()\n\n        # Avoid division by zero\n        rs = avg_gain / avg_loss.replace(0, 1e-10)\n        rsi = 100 - (100 / (1 + rs))\n\n        return rsi\n\n    def should_reevaluate(\n        self,\n        position: ActivePosition,\n        current_price: float,\n    ) -> bool:\n        \"\"\"\n        RSI strategy does not re-evaluate once position is opened.\n\n        Returns:\n            False always\n        \"\"\"\n        return False\n\n    def get_default_exit_policy(self) -> ExitPolicy:\n        \"\"\"Get default exit policy (trailing stop).\"\"\"\n        return ExitPolicy.TRAILING_STOP\n","numLines":157,"startLine":1,"totalLines":157}}}
