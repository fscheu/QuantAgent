{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_011bFt6fwXmP9gUCdGWywWX2","type":"tool_result","content":"1\t\"\"\"Unit tests for RSIMeanReversionStrategy.\"\"\"\n2\t\n3\tfrom datetime import datetime, timedelta\n4\tfrom typing import Dict, List\n5\t\n6\timport pytest\n7\t\n8\tfrom quantagent.models import ActivePosition, ExitPolicy, OrderSide\n9\tfrom quantagent.strategy.rsi_strategy import RSIMeanReversionStrategy\n10\t\n11\t\n12\t@pytest.fixture\n13\tdef rsi_strategy():\n14\t    \"\"\"Fixture for RSI strategy with default params.\"\"\"\n15\t    return RSIMeanReversionStrategy(\n16\t        rsi_period=14,\n17\t        oversold_threshold=30.0,\n18\t        overbought_threshold=70.0,\n19\t    )\n20\t\n21\t\n22\t@pytest.fixture\n23\tdef oversold_kline_data() -> List[Dict]:\n24\t    \"\"\"\n25\t    Fixture for kline data that produces RSI < 30 (oversold).\n26\t    Simulates a downtrend followed by consolidation.\n27\t    \"\"\"\n28\t    # Start high, then decline (creates oversold RSI)\n29\t    prices = [110.0] + [110.0 - i * 2 for i in range(1, 31)]\n30\t\n31\t    return [\n32\t        {\n33\t            \"timestamp\": datetime(2024, 1, 1, 0, 0) + timedelta(hours=i * 4),\n34\t            \"open\": prices[i],\n35\t            \"high\": prices[i] + 1,\n36\t            \"low\": prices[i] - 1,\n37\t            \"close\": prices[i],\n38\t            \"volume\": 1000,\n39\t        }\n40\t        for i in range(len(prices))\n41\t    ]\n42\t\n43\t\n44\t@pytest.fixture\n45\tdef overbought_kline_data() -> List[Dict]:\n46\t    \"\"\"\n47\t    Fixture for kline data that produces RSI > 70 (overbought).\n48\t    Simulates an uptrend.\n49\t    \"\"\"\n50\t    # Start low, then rally (creates overbought RSI)\n51\t    prices = [50.0] + [50.0 + i * 2 for i in range(1, 31)]\n52\t\n53\t    return [\n54\t        {\n55\t            \"timestamp\": datetime(2024, 1, 1, 0, 0) + timedelta(hours=i * 4),\n56\t            \"open\": prices[i],\n57\t            \"high\": prices[i] + 1,\n58\t            \"low\": prices[i] - 1,\n59\t            \"close\": prices[i],\n60\t            \"volume\": 1000,\n61\t        }\n62\t        for i in range(len(prices))\n63\t    ]\n64\t\n65\t\n66\t@pytest.fixture\n67\tdef neutral_kline_data() -> List[Dict]:\n68\t    \"\"\"Fixture for neutral kline data (RSI ~50).\"\"\"\n69\t    # Sideways movement\n70\t    prices = [100.0 + (i % 2) for i in range(31)]\n71\t\n72\t    return [\n73\t        {\n74\t            \"timestamp\": datetime(2024, 1, 1, 0, 0) + timedelta(hours=i * 4),\n75\t            \"open\": prices[i],\n76\t            \"high\": prices[i] + 0.5,\n77\t            \"low\": prices[i] - 0.5,\n78\t            \"close\": prices[i],\n79\t            \"volume\": 1000,\n80\t        }\n81\t        for i in range(len(prices))\n82\t    ]\n83\t\n84\t\n85\tclass TestGenerateSignalOversold:\n86\t    \"\"\"Test signal generation for oversold conditions.\"\"\"\n87\t\n88\t    def test_generate_long_signal_oversold(self, rsi_strategy, oversold_kline_data):\n89\t        \"\"\"AC2.3: RSI strategy generates LONG on oversold (RSI < 30).\"\"\"\n90\t        signal = rsi_strategy.generate_signal(\n91\t            oversold_kline_data, \"BTCUSDT\", \"4h\", 50.0\n92\t        )\n93\t\n94\t        assert signal is not None\n95\t        assert signal.decision == \"LONG\"\n96\t        assert signal.confidence > 0.5  # High confidence for oversold\n97\t        assert signal.entry_price == 50.0\n98\t        assert signal.stop_loss == 49.0  # 2% below\n99\t        assert signal.take_profit == 51.5  # 3% above\n100\t        assert \"oversold\" in signal.reasoning.lower()\n101\t        assert signal.exit_policy == ExitPolicy.TRAILING_STOP\n102\t\n103\t\n104\tclass TestGenerateSignalOverbought:\n105\t    \"\"\"Test signal generation for overbought conditions.\"\"\"\n106\t\n107\t    def test_generate_short_signal_overbought(\n108\t        self, rsi_strategy, overbought_kline_data\n109\t    ):\n110\t        \"\"\"RSI strategy generates SHORT on overbought (RSI > 70).\"\"\"\n111\t        signal = rsi_strategy.generate_signal(\n112\t            overbought_kline_data, \"ETHUSDT\", \"4h\", 100.0\n113\t        )\n114\t\n115\t        assert signal is not None\n116\t        assert signal.decision == \"SHORT\"\n117\t        assert signal.confidence > 0.5  # High confidence for overbought\n118\t        assert signal.stop_loss == 102.0  # 2% above\n119\t        assert signal.take_profit == 97.0  # 3% below\n120\t        assert \"overbought\" in signal.reasoning.lower()\n121\t\n122\t\n123\tclass TestGenerateSignalNeutral:\n124\t    \"\"\"Test signal generation for neutral conditions.\"\"\"\n125\t\n126\t    def test_generate_hold_signal_neutral(self, rsi_strategy, neutral_kline_data):\n127\t        \"\"\"AC2.4: RSI strategy returns None for neutral RSI (~50).\"\"\"\n128\t        signal = rsi_strategy.generate_signal(\n129\t            neutral_kline_data, \"BTCUSDT\", \"4h\", 100.0\n130\t        )\n131\t\n132\t        # Should return None when RSI is between thresholds\n133\t        assert signal is None\n134\t\n135\t\n136\tclass TestInsufficientData:\n137\t    \"\"\"Test behavior with insufficient data.\"\"\"\n138\t\n139\t    def test_insufficient_data_returns_none(self, rsi_strategy):\n140\t        \"\"\"Strategy returns None when insufficient candles.\"\"\"\n141\t        short_data = [\n142\t            {\n143\t                \"timestamp\": datetime(2024, 1, 1, i, 0).isoformat(),\n144\t                \"open\": 100.0,\n145\t                \"high\": 101.0,\n146\t                \"low\": 99.0,\n147\t                \"close\": 100.0,\n148\t                \"volume\": 1000,\n149\t            }\n150\t            for i in range(10)  # Less than rsi_period (14)\n151\t        ]\n152\t\n153\t        signal = rsi_strategy.generate_signal(short_data, \"BTCUSDT\", \"4h\", 100.0)\n154\t\n155\t        assert signal is None\n156\t\n157\t\n158\tclass TestCustomParameters:\n159\t    \"\"\"Test strategy with custom parameters.\"\"\"\n160\t\n161\t    def test_custom_thresholds(self, overbought_kline_data):\n162\t        \"\"\"Strategy respects custom RSI thresholds.\"\"\"\n163\t        # More aggressive thresholds\n164\t        strategy = RSIMeanReversionStrategy(\n165\t            oversold_threshold=40.0,  # Higher oversold threshold\n166\t            overbought_threshold=60.0,  # Lower overbought threshold\n167\t        )\n168\t\n169\t        signal = strategy.generate_signal(overbought_kline_data, \"BTCUSDT\", \"4h\", 100.0)\n170\t\n171\t        # Should trigger SHORT with looser threshold\n172\t        assert signal is not None\n173\t        assert signal.decision == \"SHORT\"\n174\t\n175\t    def test_custom_stop_loss_take_profit(self, oversold_kline_data):\n176\t        \"\"\"Strategy respects custom SL/TP percentages.\"\"\"\n177\t        strategy = RSIMeanReversionStrategy(\n178\t            stop_loss_pct=0.05,  # 5% SL\n179\t            take_profit_pct=0.10,  # 10% TP\n180\t        )\n181\t\n182\t        signal = strategy.generate_signal(oversold_kline_data, \"BTCUSDT\", \"4h\", 100.0)\n183\t\n184\t        assert signal is not None\n185\t        assert signal.stop_loss == 95.0  # 5% below\n186\t        assert (\n187\t            abs(signal.take_profit - 110.0) < 0.01\n188\t        )  # 10% above (with floating point tolerance)\n189\t\n190\t\n191\tclass TestNoLLMInvocation:\n192\t    \"\"\"Test that RSI strategy does NOT use LLM.\"\"\"\n193\t\n194\t    def test_no_llm_dependency(self, rsi_strategy, oversold_kline_data):\n195\t        \"\"\"AC2.3: RSI strategy generates signal without LLM.\"\"\"\n196\t        # This test verifies by inspection - RSI strategy only uses pandas/numpy\n197\t        # No mock needed because no external dependencies\n198\t\n199\t        signal = rsi_strategy.generate_signal(\n200\t            oversold_kline_data, \"BTCUSDT\", \"4h\", 50.0\n201\t        )\n202\t\n203\t        assert signal is not None\n204\t        # If we got a signal, it means strategy worked without any LLM\n205\t\n206\t\n207\tclass TestShouldReevaluate:\n208\t    \"\"\"Test re-evaluation logic.\"\"\"\n209\t\n210\t    def test_should_not_reevaluate(self, rsi_strategy):\n211\t        \"\"\"RSI strategy does not re-evaluate positions.\"\"\"\n212\t        position = ActivePosition(\n213\t            id=1,\n214\t            symbol=\"BTCUSDT\",\n215\t            side=OrderSide.BUY,\n216\t            entry_price=100.0,\n217\t            stop_loss=95.0,\n218\t            take_profit=110.0,\n219\t            quantity=1.0,\n220\t            decision_timestamp=datetime.utcnow(),\n221\t            candles_since_entry=5,\n222\t            exit_policy=ExitPolicy.TRAILING_STOP,\n223\t            prediction_horizon=3,\n224\t            candles_direction=[],\n225\t            is_active=True,\n226\t        )\n227\t\n228\t        should_reeval = rsi_strategy.should_reevaluate(position, 105.0)\n229\t\n230\t        assert should_reeval is False\n231\t\n232\t\n233\tclass TestDefaultExitPolicy:\n234\t    \"\"\"Test default exit policy.\"\"\"\n235\t\n236\t    def test_default_exit_policy(self, rsi_strategy):\n237\t        \"\"\"RSI strategy uses TRAILING_STOP by default.\"\"\"\n238\t        assert rsi_strategy.get_default_exit_policy() == ExitPolicy.TRAILING_STOP\n239\t"}]},"parent_tool_use_id":null,"session_id":"e7c02214-d66b-4564-be8f-476a12f21292","uuid":"ad6e151f-4ea9-4ed9-bd89-c259dc954e6b","timestamp":"2026-05-05T21:47:07.571Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/autodev-worktrees/techlead-20260505T213844Z/QuantAgent-b8r/implementer-20260505T213930Z/tests/test_rsi_strategy.py","content":"\"\"\"Unit tests for RSIMeanReversionStrategy.\"\"\"\n\nfrom datetime import datetime, timedelta\nfrom typing import Dict, List\n\nimport pytest\n\nfrom quantagent.models import ActivePosition, ExitPolicy, OrderSide\nfrom quantagent.strategy.rsi_strategy import RSIMeanReversionStrategy\n\n\n@pytest.fixture\ndef rsi_strategy():\n    \"\"\"Fixture for RSI strategy with default params.\"\"\"\n    return RSIMeanReversionStrategy(\n        rsi_period=14,\n        oversold_threshold=30.0,\n        overbought_threshold=70.0,\n    )\n\n\n@pytest.fixture\ndef oversold_kline_data() -> List[Dict]:\n    \"\"\"\n    Fixture for kline data that produces RSI < 30 (oversold).\n    Simulates a downtrend followed by consolidation.\n    \"\"\"\n    # Start high, then decline (creates oversold RSI)\n    prices = [110.0] + [110.0 - i * 2 for i in range(1, 31)]\n\n    return [\n        {\n            \"timestamp\": datetime(2024, 1, 1, 0, 0) + timedelta(hours=i * 4),\n            \"open\": prices[i],\n            \"high\": prices[i] + 1,\n            \"low\": prices[i] - 1,\n            \"close\": prices[i],\n            \"volume\": 1000,\n        }\n        for i in range(len(prices))\n    ]\n\n\n@pytest.fixture\ndef overbought_kline_data() -> List[Dict]:\n    \"\"\"\n    Fixture for kline data that produces RSI > 70 (overbought).\n    Simulates an uptrend.\n    \"\"\"\n    # Start low, then rally (creates overbought RSI)\n    prices = [50.0] + [50.0 + i * 2 for i in range(1, 31)]\n\n    return [\n        {\n            \"timestamp\": datetime(2024, 1, 1, 0, 0) + timedelta(hours=i * 4),\n            \"open\": prices[i],\n            \"high\": prices[i] + 1,\n            \"low\": prices[i] - 1,\n            \"close\": prices[i],\n            \"volume\": 1000,\n        }\n        for i in range(len(prices))\n    ]\n\n\n@pytest.fixture\ndef neutral_kline_data() -> List[Dict]:\n    \"\"\"Fixture for neutral kline data (RSI ~50).\"\"\"\n    # Sideways movement\n    prices = [100.0 + (i % 2) for i in range(31)]\n\n    return [\n        {\n            \"timestamp\": datetime(2024, 1, 1, 0, 0) + timedelta(hours=i * 4),\n            \"open\": prices[i],\n            \"high\": prices[i] + 0.5,\n            \"low\": prices[i] - 0.5,\n            \"close\": prices[i],\n            \"volume\": 1000,\n        }\n        for i in range(len(prices))\n    ]\n\n\nclass TestGenerateSignalOversold:\n    \"\"\"Test signal generation for oversold conditions.\"\"\"\n\n    def test_generate_long_signal_oversold(self, rsi_strategy, oversold_kline_data):\n        \"\"\"AC2.3: RSI strategy generates LONG on oversold (RSI < 30).\"\"\"\n        signal = rsi_strategy.generate_signal(\n            oversold_kline_data, \"BTCUSDT\", \"4h\", 50.0\n        )\n\n        assert signal is not None\n        assert signal.decision == \"LONG\"\n        assert signal.confidence > 0.5  # High confidence for oversold\n        assert signal.entry_price == 50.0\n        assert signal.stop_loss == 49.0  # 2% below\n        assert signal.take_profit == 51.5  # 3% above\n        assert \"oversold\" in signal.reasoning.lower()\n        assert signal.exit_policy == ExitPolicy.TRAILING_STOP\n\n\nclass TestGenerateSignalOverbought:\n    \"\"\"Test signal generation for overbought conditions.\"\"\"\n\n    def test_generate_short_signal_overbought(\n        self, rsi_strategy, overbought_kline_data\n    ):\n        \"\"\"RSI strategy generates SHORT on overbought (RSI > 70).\"\"\"\n        signal = rsi_strategy.generate_signal(\n            overbought_kline_data, \"ETHUSDT\", \"4h\", 100.0\n        )\n\n        assert signal is not None\n        assert signal.decision == \"SHORT\"\n        assert signal.confidence > 0.5  # High confidence for overbought\n        assert signal.stop_loss == 102.0  # 2% above\n        assert signal.take_profit == 97.0  # 3% below\n        assert \"overbought\" in signal.reasoning.lower()\n\n\nclass TestGenerateSignalNeutral:\n    \"\"\"Test signal generation for neutral conditions.\"\"\"\n\n    def test_generate_hold_signal_neutral(self, rsi_strategy, neutral_kline_data):\n        \"\"\"AC2.4: RSI strategy returns None for neutral RSI (~50).\"\"\"\n        signal = rsi_strategy.generate_signal(\n            neutral_kline_data, \"BTCUSDT\", \"4h\", 100.0\n        )\n\n        # Should return None when RSI is between thresholds\n        assert signal is None\n\n\nclass TestInsufficientData:\n    \"\"\"Test behavior with insufficient data.\"\"\"\n\n    def test_insufficient_data_returns_none(self, rsi_strategy):\n        \"\"\"Strategy returns None when insufficient candles.\"\"\"\n        short_data = [\n            {\n                \"timestamp\": datetime(2024, 1, 1, i, 0).isoformat(),\n                \"open\": 100.0,\n                \"high\": 101.0,\n                \"low\": 99.0,\n                \"close\": 100.0,\n                \"volume\": 1000,\n            }\n            for i in range(10)  # Less than rsi_period (14)\n        ]\n\n        signal = rsi_strategy.generate_signal(short_data, \"BTCUSDT\", \"4h\", 100.0)\n\n        assert signal is None\n\n\nclass TestCustomParameters:\n    \"\"\"Test strategy with custom parameters.\"\"\"\n\n    def test_custom_thresholds(self, overbought_kline_data):\n        \"\"\"Strategy respects custom RSI thresholds.\"\"\"\n        # More aggressive thresholds\n        strategy = RSIMeanReversionStrategy(\n            oversold_threshold=40.0,  # Higher oversold threshold\n            overbought_threshold=60.0,  # Lower overbought threshold\n        )\n\n        signal = strategy.generate_signal(overbought_kline_data, \"BTCUSDT\", \"4h\", 100.0)\n\n        # Should trigger SHORT with looser threshold\n        assert signal is not None\n        assert signal.decision == \"SHORT\"\n\n    def test_custom_stop_loss_take_profit(self, oversold_kline_data):\n        \"\"\"Strategy respects custom SL/TP percentages.\"\"\"\n        strategy = RSIMeanReversionStrategy(\n            stop_loss_pct=0.05,  # 5% SL\n            take_profit_pct=0.10,  # 10% TP\n        )\n\n        signal = strategy.generate_signal(oversold_kline_data, \"BTCUSDT\", \"4h\", 100.0)\n\n        assert signal is not None\n        assert signal.stop_loss == 95.0  # 5% below\n        assert (\n            abs(signal.take_profit - 110.0) < 0.01\n        )  # 10% above (with floating point tolerance)\n\n\nclass TestNoLLMInvocation:\n    \"\"\"Test that RSI strategy does NOT use LLM.\"\"\"\n\n    def test_no_llm_dependency(self, rsi_strategy, oversold_kline_data):\n        \"\"\"AC2.3: RSI strategy generates signal without LLM.\"\"\"\n        # This test verifies by inspection - RSI strategy only uses pandas/numpy\n        # No mock needed because no external dependencies\n\n        signal = rsi_strategy.generate_signal(\n            oversold_kline_data, \"BTCUSDT\", \"4h\", 50.0\n        )\n\n        assert signal is not None\n        # If we got a signal, it means strategy worked without any LLM\n\n\nclass TestShouldReevaluate:\n    \"\"\"Test re-evaluation logic.\"\"\"\n\n    def test_should_not_reevaluate(self, rsi_strategy):\n        \"\"\"RSI strategy does not re-evaluate positions.\"\"\"\n        position = ActivePosition(\n            id=1,\n            symbol=\"BTCUSDT\",\n            side=OrderSide.BUY,\n            entry_price=100.0,\n            stop_loss=95.0,\n            take_profit=110.0,\n            quantity=1.0,\n            decision_timestamp=datetime.utcnow(),\n            candles_since_entry=5,\n            exit_policy=ExitPolicy.TRAILING_STOP,\n            prediction_horizon=3,\n            candles_direction=[],\n            is_active=True,\n        )\n\n        should_reeval = rsi_strategy.should_reevaluate(position, 105.0)\n\n        assert should_reeval is False\n\n\nclass TestDefaultExitPolicy:\n    \"\"\"Test default exit policy.\"\"\"\n\n    def test_default_exit_policy(self, rsi_strategy):\n        \"\"\"RSI strategy uses TRAILING_STOP by default.\"\"\"\n        assert rsi_strategy.get_default_exit_policy() == ExitPolicy.TRAILING_STOP\n","numLines":239,"startLine":1,"totalLines":239}}}
