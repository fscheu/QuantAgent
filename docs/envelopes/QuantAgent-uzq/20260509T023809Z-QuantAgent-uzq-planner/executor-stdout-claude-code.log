{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01XuGzoKmfYFrjvkKz8MVeww","type":"tool_result","content":"1\tfrom unittest.mock import MagicMock, Mock\n2\t\n3\timport pandas as pd\n4\timport pytest\n5\t\n6\tfrom quantagent.models import Environment, OrderSide, TradeSignal\n7\tfrom quantagent.settings import SchedulerSettings\n8\tfrom quantagent.strategy.base import TradingSignal as StrategyTradingSignal\n9\tfrom quantagent.trading.scheduler import (\n10\t    TradingScheduler,\n11\t)\n12\t\n13\t\n14\tdef _make_mock_order(side=OrderSide.BUY, quantity=\"1.0\", symbol=\"BTC-USD\"):\n15\t    \"\"\"Create a mock order with necessary attributes for PositionMonitor.\"\"\"\n16\t    mock_order = Mock()\n17\t    mock_order.side = side\n18\t    mock_order.quantity = quantity\n19\t    mock_order.symbol = symbol\n20\t    return mock_order\n21\t\n22\t\n23\tclass DummySession:\n24\t    def __init__(self):\n25\t        self._objects = []\n26\t        self.committed = False\n27\t        self.rolled_back = False\n28\t\n29\t    def add(self, obj):\n30\t        self._objects.append(obj)\n31\t\n32\t    def flush(self):\n33\t        for idx, obj in enumerate(self._objects, start=1):\n34\t            if getattr(obj, \"id\", None) is None:\n35\t                setattr(obj, \"id\", idx)\n36\t\n37\t    def refresh(self, obj):\n38\t        if getattr(obj, \"id\", None) is None:\n39\t            setattr(obj, \"id\", len(self._objects))\n40\t        return obj\n41\t\n42\t    def commit(self):\n43\t        self.committed = True\n44\t\n45\t    def rollback(self):\n46\t        self.rolled_back = True\n47\t\n48\t    def query(self, model):\n49\t        \"\"\"Return a mock query object that returns no active positions.\"\"\"\n50\t        mock_query = Mock()\n51\t        mock_query.filter.return_value.first.return_value = None\n52\t        mock_query.filter.return_value.all.return_value = []\n53\t        return mock_query\n54\t\n55\t\n56\tclass DummyScheduler:\n57\t    def __init__(self):\n58\t        self.jobs = []\n59\t        self.started = False\n60\t        self.shutdown_called = False\n61\t\n62\t    def add_job(self, func, **kwargs):\n63\t        self.jobs.append({\"func\": func, **kwargs})\n64\t\n65\t    def start(self):\n66\t        self.started = True\n67\t\n68\t    def shutdown(self, wait=True):\n69\t        self.shutdown_called = True\n70\t        self.started = False\n71\t\n72\t\n73\tdef _sample_df():\n74\t    return pd.DataFrame(\n75\t        {\n76\t            \"timestamp\": pd.date_range(\"2024-01-01\", periods=3, freq=\"h\"),\n77\t            \"open\": [100, 101, 102],\n78\t            \"high\": [101, 102, 103],\n79\t            \"low\": [99, 100, 101],\n80\t            \"close\": [100.5, 101.5, 102.5],\n81\t            \"volume\": [1_000_000, 1_100_000, 1_200_000],\n82\t        }\n83\t    )\n84\t\n85\t\n86\t# ============================================================================\n87\t# AC-8 & AC-9: Configuration Validation\n88\t# ============================================================================\n89\t\n90\t\n91\tdef test_scheduler_settings_validation_interval_zero():\n92\t    \"\"\"AC-8: Configuration Validation - Invalid Interval.\"\"\"\n93\t    with pytest.raises(ValueError, match=\"interval_hours must be > 0\"):\n94\t        SchedulerSettings(interval_hours=0)\n95\t\n96\t\n97\tdef test_scheduler_settings_validation_negative_interval():\n98\t    \"\"\"AC-8: Configuration Validation - Invalid Interval (negative).\"\"\"\n99\t    with pytest.raises(ValueError, match=\"interval_hours must be > 0\"):\n100\t        SchedulerSettings(interval_hours=-0.5)\n101\t\n102\t\n103\tdef test_scheduler_settings_validation_empty_assets():\n104\t    \"\"\"AC-9: Configuration Validation - Empty Assets List.\"\"\"\n105\t    with pytest.raises(ValueError, match=\"assets list cannot be empty\"):\n106\t        SchedulerSettings(assets=[])\n107\t\n108\t\n109\t# ============================================================================\n110\t# AC-1: Scheduler Start (Happy Path)\n111\t# ============================================================================\n112\t\n113\t\n114\tdef test_scheduler_start_happy_path():\n115\t    \"\"\"AC-1: Scheduler Start - Happy Path.\"\"\"\n116\t    config = SchedulerSettings(\n117\t        enabled=True,\n118\t        interval_hours=1.0,\n119\t        assets=[\"BTC\", \"SPX\"],\n120\t        environment=\"paper\",\n121\t    )\n122\t    session = DummySession()\n123\t    scheduler = TradingScheduler(\n124\t        trading_graph=Mock(),\n125\t        order_manager=Mock(),\n126\t        data_provider=Mock(),\n127\t        db_session=session,\n128\t        scheduler_settings=config,\n129\t        scheduler_factory=DummyScheduler,\n130\t        strategy=Mock(),\n131\t    )\n132\t\n133\t    result = scheduler.start(immediate=False)\n134\t\n135\t    assert result is True\n136\t    assert scheduler.is_running is True\n137\t    assert scheduler.scheduler.started is True\n138\t    # Verify job was registered\n139\t    assert len(scheduler.scheduler.jobs) == 1\n140\t    assert scheduler.scheduler.jobs[0][\"id\"] == TradingScheduler.JOB_ID\n141\t\n142\t\n143\tdef test_scheduler_start_disabled_config():\n144\t    \"\"\"AC-1: Scheduler Start - When disabled in config.\"\"\"\n145\t    config = SchedulerSettings(\n146\t        enabled=False,\n147\t        interval_hours=1.0,\n148\t        assets=[\"BTC\"],\n149\t        environment=\"paper\",\n150\t    )\n151\t    session = DummySession()\n152\t    scheduler = TradingScheduler(\n153\t        trading_graph=Mock(),\n154\t        order_manager=Mock(),\n155\t        data_provider=Mock(),\n156\t        db_session=session,\n157\t        scheduler_settings=config,\n158\t        scheduler_factory=DummyScheduler,\n159\t        strategy=Mock(),\n160\t    )\n161\t\n162\t    result = scheduler.start()\n163\t    assert result is False\n164\t    assert scheduler.is_running is False\n165\t\n166\t\n167\t# ============================================================================\n168\t# AC-2: Scheduler Stop (Graceful Shutdown)\n169\t# ============================================================================\n170\t\n171\t\n172\tdef test_scheduler_stop_graceful_shutdown():\n173\t    \"\"\"AC-2: Scheduler Stop - Graceful Shutdown.\"\"\"\n174\t    config = SchedulerSettings(\n175\t        enabled=True,\n176\t        interval_hours=1.0,\n177\t        assets=[\"BTC\"],\n178\t        environment=\"paper\",\n179\t    )\n180\t    session = DummySession()\n181\t    scheduler = TradingScheduler(\n182\t        trading_graph=Mock(),\n183\t        order_manager=Mock(),\n184\t        data_provider=Mock(),\n185\t        db_session=session,\n186\t        scheduler_settings=config,\n187\t        scheduler_factory=DummyScheduler,\n188\t        strategy=Mock(),\n189\t    )\n190\t\n191\t    scheduler.start(immediate=False)\n192\t    assert scheduler.is_running is True\n193\t\n194\t    scheduler.stop()\n195\t\n196\t    assert scheduler.is_running is False\n197\t    assert scheduler.scheduler.shutdown_called is True\n198\t\n199\t\n200\tdef test_scheduler_stop_idempotent():\n201\t    \"\"\"AC-16: Idempotency - Stop Without Start.\"\"\"\n202\t    config = SchedulerSettings(\n203\t        enabled=True,\n204\t        interval_hours=1.0,\n205\t        assets=[\"BTC\"],\n206\t        environment=\"paper\",\n207\t    )\n208\t    session = DummySession()\n209\t    scheduler = TradingScheduler(\n210\t        trading_graph=Mock(),\n211\t        order_manager=Mock(),\n212\t        data_provider=Mock(),\n213\t        db_session=session,\n214\t        scheduler_settings=config,\n215\t        scheduler_factory=DummyScheduler,\n216\t        strategy=Mock(),\n217\t    )\n218\t\n219\t    # Should not raise exception\n220\t    scheduler.stop()\n221\t    assert scheduler.is_running is False\n222\t\n223\t\n224\t# ============================================================================\n225\t# AC-3: Analysis Cycle - LONG Signal\n226\t# ============================================================================\n227\t\n228\t\n229\tdef test_trading_scheduler_long_signal_executes_order():\n230\t    \"\"\"AC-3: Analysis Cycle - LONG Signal.\"\"\"\n231\t    config = SchedulerSettings(\n232\t        enabled=True,\n233\t        interval_hours=1.0,\n234\t        assets=[\"BTC\"],\n235\t        environment=\"paper\",\n236\t        timeframe=\"1h\",\n237\t        lookback_hours=12,\n238\t    )\n239\t\n240\t    session = DummySession()\n241\t    data_provider = MagicMock()\n242\t    data_provider.get_ohlc.return_value = _sample_df()\n243\t\n244\t    order_manager = MagicMock()\n245\t    order_manager.execute_decision.return_value = _make_mock_order()\n246\t\n247\t    strategy = Mock()\n248\t    strategy.generate_signal.return_value = StrategyTradingSignal(\n249\t        decision=\"LONG\",\n250\t        confidence=0.9,\n251\t        entry_price=101.0,\n252\t        stop_loss=97.5,\n253\t        take_profit=110.0,\n254\t        reasoning=\"Test\",\n255\t    )\n256\t\n257\t    scheduler = TradingScheduler(\n258\t        trading_graph=Mock(),\n259\t        order_manager=order_manager,\n260\t        data_provider=data_provider,\n261\t        db_session=session,\n262\t        scheduler_settings=config,\n263\t        scheduler_factory=DummyScheduler,\n264\t        strategy=strategy,\n265\t    )\n266\t\n267\t    stats = scheduler.run_once()\n268\t\n269\t    assert stats[\"processed\"] == 1\n270\t    assert stats[\"errors\"] == 0\n271\t    order_manager.execute_decision.assert_called_once()\n272\t    kwargs = order_manager.execute_decision.call_args.kwargs\n273\t    assert kwargs[\"environment\"] == Environment.PAPER\n274\t    assert kwargs[\"symbol\"] == \"BTC\"\n275\t    assert kwargs[\"decision\"] == TradeSignal.LONG\n276\t\n277\t\n278\t# ============================================================================\n279\t# AC-4: Analysis Cycle - SHORT Signal\n280\t# ============================================================================\n281\t\n282\t\n283\tdef test_trading_scheduler_short_signal_executes_order():\n284\t    \"\"\"AC-4: Analysis Cycle - SHORT Signal.\"\"\"\n285\t    config = SchedulerSettings(\n286\t        enabled=True,\n287\t        interval_hours=1.0,\n288\t        assets=[\"SPX\"],\n289\t        environment=\"paper\",\n290\t        timeframe=\"1h\",\n291\t        lookback_hours=12,\n292\t    )\n293\t\n294\t    session = DummySession()\n295\t    data_provider = MagicMock()\n296\t    data_provider.get_ohlc.return_value = _sample_df()\n297\t\n298\t    order_manager = MagicMock()\n299\t    order_manager.execute_decision.return_value = _make_mock_order()\n300\t\n301\t    strategy = Mock()\n302\t    strategy.generate_signal.return_value = StrategyTradingSignal(\n303\t        decision=\"SHORT\",\n304\t        confidence=0.75,\n305\t        entry_price=101.0,\n306\t        stop_loss=105.0,\n307\t        take_profit=92.5,\n308\t        reasoning=\"Test SHORT signal\",\n309\t    )\n310\t\n311\t    scheduler = TradingScheduler(\n312\t        trading_graph=Mock(),\n313\t        order_manager=order_manager,\n314\t        data_provider=data_provider,\n315\t        db_session=session,\n316\t        scheduler_settings=config,\n317\t        scheduler_factory=DummyScheduler,\n318\t        strategy=strategy,\n319\t    )\n320\t\n321\t    stats = scheduler.run_once()\n322\t\n323\t    assert stats[\"processed\"] == 1\n324\t    assert stats[\"errors\"] == 0\n325\t    order_manager.execute_decision.assert_called_once()\n326\t    kwargs = order_manager.execute_decision.call_args.kwargs\n327\t    assert kwargs[\"environment\"] == Environment.PAPER\n328\t    assert kwargs[\"symbol\"] == \"SPX\"\n329\t    assert kwargs[\"decision\"] == TradeSignal.SHORT\n330\t\n331\t\n332\t# ============================================================================\n333\t# AC-5: Analysis Cycle - HOLD Signal (No Action)\n334\t# ============================================================================\n335\t\n336\t\n337\tdef test_trading_scheduler_hold_signal_skips_execution():\n338\t    \"\"\"AC-5: Analysis Cycle - HOLD Signal (No Action).\"\"\"\n339\t    config = SchedulerSettings(\n340\t        enabled=True,\n341\t        interval_hours=1.0,\n342\t        assets=[\"BTC\"],\n343\t        environment=\"paper\",\n344\t    )\n345\t    session = DummySession()\n346\t    data_provider = MagicMock()\n347\t    data_provider.get_ohlc.return_value = _sample_df()\n348\t\n349\t    order_manager = MagicMock()\n350\t    strategy = Mock()\n351\t    strategy.generate_signal.return_value = None\n352\t\n353\t    scheduler = TradingScheduler(\n354\t        trading_graph=Mock(),\n355\t        order_manager=order_manager,\n356\t        data_provider=data_provider,\n357\t        db_session=session,\n358\t        scheduler_settings=config,\n359\t        scheduler_factory=DummyScheduler,\n360\t        strategy=strategy,\n361\t    )\n362\t\n363\t    stats = scheduler.run_once()\n364\t\n365\t    assert stats[\"processed\"] == 1\n366\t    assert stats[\"errors\"] == 0\n367\t    order_manager.execute_decision.assert_not_called()\n368\t\n369\t\n370\t# ============================================================================\n371\t# AC-6: Error Handling - Transient (API Timeout)\n372\t# ============================================================================\n373\t\n374\t\n375\tdef test_scheduler_transient_error_continue_with_next_asset():\n376\t    \"\"\"AC-6: Error Handling - Transient (API Timeout).\"\"\"\n377\t    config = SchedulerSettings(\n378\t        enabled=True,\n379\t        interval_hours=1.0,\n380\t        assets=[\"BTC\", \"SPX\"],\n381\t        environment=\"paper\",\n382\t        timeframe=\"1h\",\n383\t        lookback_hours=12,\n384\t    )\n385\t\n386\t    session = DummySession()\n387\t    data_provider = MagicMock()\n388\t    # First asset fails with timeout, second succeeds\n389\t    data_provider.get_ohlc.side_effect = [\n390\t        TimeoutError(\"API timeout\"),\n391\t        _sample_df(),\n392\t    ]\n393\t\n394\t    order_manager = MagicMock()\n395\t    order_manager.execute_decision.return_value = _make_mock_order()\n396\t\n397\t    strategy = Mock()\n398\t    strategy.generate_signal.return_value = StrategyTradingSignal(\n399\t        decision=\"LONG\",\n400\t        confidence=0.8,\n401\t        entry_price=101.0,\n402\t        stop_loss=97.5,\n403\t        take_profit=110.0,\n404\t        reasoning=\"Test\",\n405\t    )\n406\t\n407\t    scheduler = TradingScheduler(\n408\t        trading_graph=Mock(),\n409\t        order_manager=order_manager,\n410\t        data_provider=data_provider,\n411\t        db_session=session,\n412\t        scheduler_settings=config,\n413\t        scheduler_factory=DummyScheduler,\n414\t        strategy=strategy,\n415\t    )\n416\t\n417\t    stats = scheduler.run_once()\n418\t\n419\t    # Should have processed BTC (failed) and SPX (succeeded)\n420\t    assert stats[\"processed\"] == 1  # Only 1 succeeded\n421\t    assert stats[\"errors\"] == 1  # 1 failed\n422\t    assert stats[\"total\"] == 2\n423\t    # Only SPX should have been executed\n424\t    order_manager.execute_decision.assert_called_once()\n425\t    kwargs = order_manager.execute_decision.call_args.kwargs\n426\t    assert kwargs[\"symbol\"] == \"SPX\"\n427\t\n428\t\n429\t# ============================================================================\n430\t# AC-7: Error Handling - Analysis Failure\n431\t# ============================================================================\n432\t\n433\t\n434\tdef test_scheduler_analysis_failure_continues_processing():\n435\t    \"\"\"AC-7: Error Handling - Analysis Failure.\"\"\"\n436\t    config = SchedulerSettings(\n437\t        enabled=True,\n438\t        interval_hours=1.0,\n439\t        assets=[\"BTC\", \"ETH\"],\n440\t        environment=\"paper\",\n441\t        timeframe=\"1h\",\n442\t        lookback_hours=12,\n443\t    )\n444\t\n445\t    session = DummySession()\n446\t    data_provider = MagicMock()\n447\t    data_provider.get_ohlc.return_value = _sample_df()\n448\t\n449\t    order_manager = MagicMock()\n450\t    order_manager.execute_decision.return_value = _make_mock_order()\n451\t\n452\t    strategy = Mock()\n453\t    # First call raises exception, second succeeds\n454\t    strategy.generate_signal.side_effect = [\n455\t        Exception(\"Model error\"),\n456\t        StrategyTradingSignal(\n457\t            decision=\"LONG\",\n458\t            confidence=0.8,\n459\t            entry_price=101.0,\n460\t            stop_loss=97.5,\n461\t            take_profit=110.0,\n462\t            reasoning=\"Test\",\n463\t        ),\n464\t    ]\n465\t\n466\t    scheduler = TradingScheduler(\n467\t        trading_graph=Mock(),\n468\t        order_manager=order_manager,\n469\t        data_provider=data_provider,\n470\t        db_session=session,\n471\t        scheduler_settings=config,\n472\t        scheduler_factory=DummyScheduler,\n473\t        strategy=strategy,\n474\t    )\n475\t\n476\t    stats = scheduler.run_once()\n477\t\n478\t    assert stats[\"processed\"] == 1\n479\t    assert stats[\"errors\"] == 1\n480\t    assert stats[\"total\"] == 2\n481\t    # Only ETH should execute\n482\t    order_manager.execute_decision.assert_called_once()\n483\t    kwargs = order_manager.execute_decision.call_args.kwargs\n484\t    assert kwargs[\"symbol\"] == \"ETH\"\n485\t\n486\t\n487\t# ============================================================================\n488\t# AC-11: Environment Tagging - Database Records\n489\t# ============================================================================\n490\t\n491\t\n492\tdef test_scheduler_environment_tagging_in_execution():\n493\t    \"\"\"AC-11: Environment Tagging - Database Records.\"\"\"\n494\t    config = SchedulerSettings(\n495\t        enabled=True,\n496\t        interval_hours=1.0,\n497\t        assets=[\"BTC\", \"SPX\"],\n498\t        environment=\"paper\",\n499\t        timeframe=\"1h\",\n500\t        lookback_hours=12,\n501\t    )\n502\t\n503\t    session = DummySession()\n504\t    data_provider = MagicMock()\n505\t    data_provider.get_ohlc.return_value = _sample_df()\n506\t\n507\t    order_manager = MagicMock()\n508\t    order_manager.execute_decision.return_value = _make_mock_order()\n509\t\n510\t    strategy = Mock()\n511\t    strategy.generate_signal.return_value = StrategyTradingSignal(\n512\t        decision=\"LONG\",\n513\t        confidence=0.9,\n514\t        entry_price=101.0,\n515\t        stop_loss=97.5,\n516\t        take_profit=110.0,\n517\t        reasoning=\"Test\",\n518\t    )\n519\t\n520\t    scheduler = TradingScheduler(\n521\t        trading_graph=Mock(),\n522\t        order_manager=order_manager,\n523\t        data_provider=data_provider,\n524\t        db_session=session,\n525\t        scheduler_settings=config,\n526\t        scheduler_factory=DummyScheduler,\n527\t        strategy=strategy,\n528\t    )\n529\t\n530\t    scheduler.run_once()\n531\t\n532\t    # Verify environment is tagged as 'paper' in all calls\n533\t    calls = order_manager.execute_decision.call_args_list\n534\t    for call in calls:\n535\t        kwargs = call.kwargs\n536\t        assert kwargs[\"environment\"] == Environment.PAPER\n537\t\n538\t\n539\t# ============================================================================\n540\t# AC-15: Idempotency - Double Start\n541\t# ============================================================================\n542\t\n543\t\n544\tdef test_scheduler_double_start_idempotent():\n545\t    \"\"\"AC-15: Idempotency - Double Start.\"\"\"\n546\t    config = SchedulerSettings(\n547\t        enabled=True,\n548\t        interval_hours=1.0,\n549\t        assets=[\"BTC\"],\n550\t        environment=\"paper\",\n551\t    )\n552\t    session = DummySession()\n553\t    scheduler = TradingScheduler(\n554\t        trading_graph=Mock(),\n555\t        order_manager=Mock(),\n556\t        data_provider=Mock(),\n557\t        db_session=session,\n558\t        scheduler_settings=config,\n559\t        scheduler_factory=DummyScheduler,\n560\t        strategy=Mock(),\n561\t    )\n562\t\n563\t    # First start\n564\t    result1 = scheduler.start(immediate=False)\n565\t    assert result1 is True\n566\t    assert scheduler.is_running is True\n567\t    job_count_after_first = len(scheduler.scheduler.jobs)\n568\t\n569\t    # Second start (should be no-op)\n570\t    result2 = scheduler.start(immediate=False)\n571\t    assert result2 is False\n572\t    assert scheduler.is_running is True\n573\t    # Job count should remain the same (no duplicate job registered)\n574\t    job_count_after_second = len(scheduler.scheduler.jobs)\n575\t    assert job_count_after_first == job_count_after_second\n576\t\n577\t\n578\t# ============================================================================\n579\t# Integration: Multiple Assets in Cycle\n580\t# ============================================================================\n581\t\n582\t\n583\tdef test_scheduler_processes_multiple_assets():\n584\t    \"\"\"Test that scheduler processes all configured assets in single cycle.\"\"\"\n585\t    config = SchedulerSettings(\n586\t        enabled=True,\n587\t        interval_hours=1.0,\n588\t        assets=[\"BTC\", \"ETH\", \"SPX\"],\n589\t        environment=\"paper\",\n590\t        timeframe=\"1h\",\n591\t        lookback_hours=12,\n592\t    )\n593\t\n594\t    session = DummySession()\n595\t    data_provider = MagicMock()\n596\t    data_provider.get_ohlc.return_value = _sample_df()\n597\t\n598\t    order_manager = MagicMock()\n599\t    order_manager.execute_decision.return_value = _make_mock_order()\n600\t\n601\t    strategy = Mock()\n602\t    strategy.generate_signal.return_value = StrategyTradingSignal(\n603\t        decision=\"LONG\",\n604\t        confidence=0.8,\n605\t        entry_price=101.0,\n606\t        stop_loss=97.5,\n607\t        take_profit=110.0,\n608\t        reasoning=\"Test\",\n609\t    )\n610\t\n611\t    scheduler = TradingScheduler(\n612\t        trading_graph=Mock(),\n613\t        order_manager=order_manager,\n614\t        data_provider=data_provider,\n615\t        db_session=session,\n616\t        scheduler_settings=config,\n617\t        scheduler_factory=DummyScheduler,\n618\t        strategy=strategy,\n619\t    )\n620\t\n621\t    stats = scheduler.run_once()\n622\t\n623\t    assert stats[\"processed\"] == 3\n624\t    assert stats[\"errors\"] == 0\n625\t    assert stats[\"total\"] == 3\n626\t    assert order_manager.execute_decision.call_count == 3\n627\t\n628\t    # Verify all assets were processed\n629\t    symbols_processed = [\n630\t        call.kwargs[\"symbol\"] for call in order_manager.execute_decision.call_args_list\n631\t    ]\n632\t    assert set(symbols_processed) == {\"BTC\", \"ETH\", \"SPX\"}\n633\t\n634\t\n635\t# ============================================================================\n636\t# Integration: Cycle Tracking and Stats\n637\t# ============================================================================\n638\t\n639\t\n640\tdef test_scheduler_tracks_last_run_stats():\n641\t    \"\"\"Test that scheduler tracks last run statistics.\"\"\"\n642\t    config = SchedulerSettings(\n643\t        enabled=True,\n644\t        interval_hours=1.0,\n645\t        assets=[\"BTC\"],\n646\t        environment=\"paper\",\n647\t        timeframe=\"1h\",\n648\t        lookback_hours=12,\n649\t    )\n650\t\n651\t    session = DummySession()\n652\t    data_provider = MagicMock()\n653\t    data_provider.get_ohlc.return_value = _sample_df()\n654\t\n655\t    order_manager = MagicMock()\n656\t    order_manager.execute_decision.return_value = _make_mock_order()\n657\t\n658\t    strategy = Mock()\n659\t    strategy.generate_signal.return_value = StrategyTradingSignal(\n660\t        decision=\"LONG\",\n661\t        confidence=0.8,\n662\t        entry_price=101.0,\n663\t        stop_loss=97.5,\n664\t        take_profit=110.0,\n665\t        reasoning=\"Test\",\n666\t    )\n667\t\n668\t    scheduler = TradingScheduler(\n669\t        trading_graph=Mock(),\n670\t        order_manager=order_manager,\n671\t        data_provider=data_provider,\n672\t        db_session=session,\n673\t        scheduler_settings=config,\n674\t        scheduler_factory=DummyScheduler,\n675\t        strategy=strategy,\n676\t    )\n677\t\n678\t    assert scheduler.last_run_stats is None\n679\t\n680\t    scheduler.run_once()\n681\t\n682\t    assert scheduler.last_run_stats is not None\n683\t    assert scheduler.last_run_stats[\"processed\"] == 1\n684\t    assert scheduler.last_run_stats[\"errors\"] == 0\n685\t    assert \"duration_seconds\" in scheduler.last_run_stats\n686\t"}]},"parent_tool_use_id":null,"session_id":"2b9b65c5-e77e-400b-90aa-d1fae3699661","uuid":"c454c6c4-7f31-4fe0-993e-046f482219a1","timestamp":"2026-05-09T02:38:43.009Z","tool_use_result":{"type":"text","file":{"filePath":"/home/azureuser/repos/projects/QuantAgent/tests/trading/test_scheduler.py","content":"from unittest.mock import MagicMock, Mock\n\nimport pandas as pd\nimport pytest\n\nfrom quantagent.models import Environment, OrderSide, TradeSignal\nfrom quantagent.settings import SchedulerSettings\nfrom quantagent.strategy.base import TradingSignal as StrategyTradingSignal\nfrom quantagent.trading.scheduler import (\n    TradingScheduler,\n)\n\n\ndef _make_mock_order(side=OrderSide.BUY, quantity=\"1.0\", symbol=\"BTC-USD\"):\n    \"\"\"Create a mock order with necessary attributes for PositionMonitor.\"\"\"\n    mock_order = Mock()\n    mock_order.side = side\n    mock_order.quantity = quantity\n    mock_order.symbol = symbol\n    return mock_order\n\n\nclass DummySession:\n    def __init__(self):\n        self._objects = []\n        self.committed = False\n        self.rolled_back = False\n\n    def add(self, obj):\n        self._objects.append(obj)\n\n    def flush(self):\n        for idx, obj in enumerate(self._objects, start=1):\n            if getattr(obj, \"id\", None) is None:\n                setattr(obj, \"id\", idx)\n\n    def refresh(self, obj):\n        if getattr(obj, \"id\", None) is None:\n            setattr(obj, \"id\", len(self._objects))\n        return obj\n\n    def commit(self):\n        self.committed = True\n\n    def rollback(self):\n        self.rolled_back = True\n\n    def query(self, model):\n        \"\"\"Return a mock query object that returns no active positions.\"\"\"\n        mock_query = Mock()\n        mock_query.filter.return_value.first.return_value = None\n        mock_query.filter.return_value.all.return_value = []\n        return mock_query\n\n\nclass DummyScheduler:\n    def __init__(self):\n        self.jobs = []\n        self.started = False\n        self.shutdown_called = False\n\n    def add_job(self, func, **kwargs):\n        self.jobs.append({\"func\": func, **kwargs})\n\n    def start(self):\n        self.started = True\n\n    def shutdown(self, wait=True):\n        self.shutdown_called = True\n        self.started = False\n\n\ndef _sample_df():\n    return pd.DataFrame(\n        {\n            \"timestamp\": pd.date_range(\"2024-01-01\", periods=3, freq=\"h\"),\n            \"open\": [100, 101, 102],\n            \"high\": [101, 102, 103],\n            \"low\": [99, 100, 101],\n            \"close\": [100.5, 101.5, 102.5],\n            \"volume\": [1_000_000, 1_100_000, 1_200_000],\n        }\n    )\n\n\n# ============================================================================\n# AC-8 & AC-9: Configuration Validation\n# ============================================================================\n\n\ndef test_scheduler_settings_validation_interval_zero():\n    \"\"\"AC-8: Configuration Validation - Invalid Interval.\"\"\"\n    with pytest.raises(ValueError, match=\"interval_hours must be > 0\"):\n        SchedulerSettings(interval_hours=0)\n\n\ndef test_scheduler_settings_validation_negative_interval():\n    \"\"\"AC-8: Configuration Validation - Invalid Interval (negative).\"\"\"\n    with pytest.raises(ValueError, match=\"interval_hours must be > 0\"):\n        SchedulerSettings(interval_hours=-0.5)\n\n\ndef test_scheduler_settings_validation_empty_assets():\n    \"\"\"AC-9: Configuration Validation - Empty Assets List.\"\"\"\n    with pytest.raises(ValueError, match=\"assets list cannot be empty\"):\n        SchedulerSettings(assets=[])\n\n\n# ============================================================================\n# AC-1: Scheduler Start (Happy Path)\n# ============================================================================\n\n\ndef test_scheduler_start_happy_path():\n    \"\"\"AC-1: Scheduler Start - Happy Path.\"\"\"\n    config = SchedulerSettings(\n        enabled=True,\n        interval_hours=1.0,\n        assets=[\"BTC\", \"SPX\"],\n        environment=\"paper\",\n    )\n    session = DummySession()\n    scheduler = TradingScheduler(\n        trading_graph=Mock(),\n        order_manager=Mock(),\n        data_provider=Mock(),\n        db_session=session,\n        scheduler_settings=config,\n        scheduler_factory=DummyScheduler,\n        strategy=Mock(),\n    )\n\n    result = scheduler.start(immediate=False)\n\n    assert result is True\n    assert scheduler.is_running is True\n    assert scheduler.scheduler.started is True\n    # Verify job was registered\n    assert len(scheduler.scheduler.jobs) == 1\n    assert scheduler.scheduler.jobs[0][\"id\"] == TradingScheduler.JOB_ID\n\n\ndef test_scheduler_start_disabled_config():\n    \"\"\"AC-1: Scheduler Start - When disabled in config.\"\"\"\n    config = SchedulerSettings(\n        enabled=False,\n        interval_hours=1.0,\n        assets=[\"BTC\"],\n        environment=\"paper\",\n    )\n    session = DummySession()\n    scheduler = TradingScheduler(\n        trading_graph=Mock(),\n        order_manager=Mock(),\n        data_provider=Mock(),\n        db_session=session,\n        scheduler_settings=config,\n        scheduler_factory=DummyScheduler,\n        strategy=Mock(),\n    )\n\n    result = scheduler.start()\n    assert result is False\n    assert scheduler.is_running is False\n\n\n# ============================================================================\n# AC-2: Scheduler Stop (Graceful Shutdown)\n# ============================================================================\n\n\ndef test_scheduler_stop_graceful_shutdown():\n    \"\"\"AC-2: Scheduler Stop - Graceful Shutdown.\"\"\"\n    config = SchedulerSettings(\n        enabled=True,\n        interval_hours=1.0,\n        assets=[\"BTC\"],\n        environment=\"paper\",\n    )\n    session = DummySession()\n    scheduler = TradingScheduler(\n        trading_graph=Mock(),\n        order_manager=Mock(),\n        data_provider=Mock(),\n        db_session=session,\n        scheduler_settings=config,\n        scheduler_factory=DummyScheduler,\n        strategy=Mock(),\n    )\n\n    scheduler.start(immediate=False)\n    assert scheduler.is_running is True\n\n    scheduler.stop()\n\n    assert scheduler.is_running is False\n    assert scheduler.scheduler.shutdown_called is True\n\n\ndef test_scheduler_stop_idempotent():\n    \"\"\"AC-16: Idempotency - Stop Without Start.\"\"\"\n    config = SchedulerSettings(\n        enabled=True,\n        interval_hours=1.0,\n        assets=[\"BTC\"],\n        environment=\"paper\",\n    )\n    session = DummySession()\n    scheduler = TradingScheduler(\n        trading_graph=Mock(),\n        order_manager=Mock(),\n        data_provider=Mock(),\n        db_session=session,\n        scheduler_settings=config,\n        scheduler_factory=DummyScheduler,\n        strategy=Mock(),\n    )\n\n    # Should not raise exception\n    scheduler.stop()\n    assert scheduler.is_running is False\n\n\n# ============================================================================\n# AC-3: Analysis Cycle - LONG Signal\n# ============================================================================\n\n\ndef test_trading_scheduler_long_signal_executes_order():\n    \"\"\"AC-3: Analysis Cycle - LONG Signal.\"\"\"\n    config = SchedulerSettings(\n        enabled=True,\n        interval_hours=1.0,\n        assets=[\"BTC\"],\n        environment=\"paper\",\n        timeframe=\"1h\",\n        lookback_hours=12,\n    )\n\n    session = DummySession()\n    data_provider = MagicMock()\n    data_provider.get_ohlc.return_value = _sample_df()\n\n    order_manager = MagicMock()\n    order_manager.execute_decision.return_value = _make_mock_order()\n\n    strategy = Mock()\n    strategy.generate_signal.return_value = StrategyTradingSignal(\n        decision=\"LONG\",\n        confidence=0.9,\n        entry_price=101.0,\n        stop_loss=97.5,\n        take_profit=110.0,\n        reasoning=\"Test\",\n    )\n\n    scheduler = TradingScheduler(\n        trading_graph=Mock(),\n        order_manager=order_manager,\n        data_provider=data_provider,\n        db_session=session,\n        scheduler_settings=config,\n        scheduler_factory=DummyScheduler,\n        strategy=strategy,\n    )\n\n    stats = scheduler.run_once()\n\n    assert stats[\"processed\"] == 1\n    assert stats[\"errors\"] == 0\n    order_manager.execute_decision.assert_called_once()\n    kwargs = order_manager.execute_decision.call_args.kwargs\n    assert kwargs[\"environment\"] == Environment.PAPER\n    assert kwargs[\"symbol\"] == \"BTC\"\n    assert kwargs[\"decision\"] == TradeSignal.LONG\n\n\n# ============================================================================\n# AC-4: Analysis Cycle - SHORT Signal\n# ============================================================================\n\n\ndef test_trading_scheduler_short_signal_executes_order():\n    \"\"\"AC-4: Analysis Cycle - SHORT Signal.\"\"\"\n    config = SchedulerSettings(\n        enabled=True,\n        interval_hours=1.0,\n        assets=[\"SPX\"],\n        environment=\"paper\",\n        timeframe=\"1h\",\n        lookback_hours=12,\n    )\n\n    session = DummySession()\n    data_provider = MagicMock()\n    data_provider.get_ohlc.return_value = _sample_df()\n\n    order_manager = MagicMock()\n    order_manager.execute_decision.return_value = _make_mock_order()\n\n    strategy = Mock()\n    strategy.generate_signal.return_value = StrategyTradingSignal(\n        decision=\"SHORT\",\n        confidence=0.75,\n        entry_price=101.0,\n        stop_loss=105.0,\n        take_profit=92.5,\n        reasoning=\"Test SHORT signal\",\n    )\n\n    scheduler = TradingScheduler(\n        trading_graph=Mock(),\n        order_manager=order_manager,\n        data_provider=data_provider,\n        db_session=session,\n        scheduler_settings=config,\n        scheduler_factory=DummyScheduler,\n        strategy=strategy,\n    )\n\n    stats = scheduler.run_once()\n\n    assert stats[\"processed\"] == 1\n    assert stats[\"errors\"] == 0\n    order_manager.execute_decision.assert_called_once()\n    kwargs = order_manager.execute_decision.call_args.kwargs\n    assert kwargs[\"environment\"] == Environment.PAPER\n    assert kwargs[\"symbol\"] == \"SPX\"\n    assert kwargs[\"decision\"] == TradeSignal.SHORT\n\n\n# ============================================================================\n# AC-5: Analysis Cycle - HOLD Signal (No Action)\n# ============================================================================\n\n\ndef test_trading_scheduler_hold_signal_skips_execution():\n    \"\"\"AC-5: Analysis Cycle - HOLD Signal (No Action).\"\"\"\n    config = SchedulerSettings(\n        enabled=True,\n        interval_hours=1.0,\n        assets=[\"BTC\"],\n        environment=\"paper\",\n    )\n    session = DummySession()\n    data_provider = MagicMock()\n    data_provider.get_ohlc.return_value = _sample_df()\n\n    order_manager = MagicMock()\n    strategy = Mock()\n    strategy.generate_signal.return_value = None\n\n    scheduler = TradingScheduler(\n        trading_graph=Mock(),\n        order_manager=order_manager,\n        data_provider=data_provider,\n        db_session=session,\n        scheduler_settings=config,\n        scheduler_factory=DummyScheduler,\n        strategy=strategy,\n    )\n\n    stats = scheduler.run_once()\n\n    assert stats[\"processed\"] == 1\n    assert stats[\"errors\"] == 0\n    order_manager.execute_decision.assert_not_called()\n\n\n# ============================================================================\n# AC-6: Error Handling - Transient (API Timeout)\n# ============================================================================\n\n\ndef test_scheduler_transient_error_continue_with_next_asset():\n    \"\"\"AC-6: Error Handling - Transient (API Timeout).\"\"\"\n    config = SchedulerSettings(\n        enabled=True,\n        interval_hours=1.0,\n        assets=[\"BTC\", \"SPX\"],\n        environment=\"paper\",\n        timeframe=\"1h\",\n        lookback_hours=12,\n    )\n\n    session = DummySession()\n    data_provider = MagicMock()\n    # First asset fails with timeout, second succeeds\n    data_provider.get_ohlc.side_effect = [\n        TimeoutError(\"API timeout\"),\n        _sample_df(),\n    ]\n\n    order_manager = MagicMock()\n    order_manager.execute_decision.return_value = _make_mock_order()\n\n    strategy = Mock()\n    strategy.generate_signal.return_value = StrategyTradingSignal(\n        decision=\"LONG\",\n        confidence=0.8,\n        entry_price=101.0,\n        stop_loss=97.5,\n        take_profit=110.0,\n        reasoning=\"Test\",\n    )\n\n    scheduler = TradingScheduler(\n        trading_graph=Mock(),\n        order_manager=order_manager,\n        data_provider=data_provider,\n        db_session=session,\n        scheduler_settings=config,\n        scheduler_factory=DummyScheduler,\n        strategy=strategy,\n    )\n\n    stats = scheduler.run_once()\n\n    # Should have processed BTC (failed) and SPX (succeeded)\n    assert stats[\"processed\"] == 1  # Only 1 succeeded\n    assert stats[\"errors\"] == 1  # 1 failed\n    assert stats[\"total\"] == 2\n    # Only SPX should have been executed\n    order_manager.execute_decision.assert_called_once()\n    kwargs = order_manager.execute_decision.call_args.kwargs\n    assert kwargs[\"symbol\"] == \"SPX\"\n\n\n# ============================================================================\n# AC-7: Error Handling - Analysis Failure\n# ============================================================================\n\n\ndef test_scheduler_analysis_failure_continues_processing():\n    \"\"\"AC-7: Error Handling - Analysis Failure.\"\"\"\n    config = SchedulerSettings(\n        enabled=True,\n        interval_hours=1.0,\n        assets=[\"BTC\", \"ETH\"],\n        environment=\"paper\",\n        timeframe=\"1h\",\n        lookback_hours=12,\n    )\n\n    session = DummySession()\n    data_provider = MagicMock()\n    data_provider.get_ohlc.return_value = _sample_df()\n\n    order_manager = MagicMock()\n    order_manager.execute_decision.return_value = _make_mock_order()\n\n    strategy = Mock()\n    # First call raises exception, second succeeds\n    strategy.generate_signal.side_effect = [\n        Exception(\"Model error\"),\n        StrategyTradingSignal(\n            decision=\"LONG\",\n            confidence=0.8,\n            entry_price=101.0,\n            stop_loss=97.5,\n            take_profit=110.0,\n            reasoning=\"Test\",\n        ),\n    ]\n\n    scheduler = TradingScheduler(\n        trading_graph=Mock(),\n        order_manager=order_manager,\n        data_provider=data_provider,\n        db_session=session,\n        scheduler_settings=config,\n        scheduler_factory=DummyScheduler,\n        strategy=strategy,\n    )\n\n    stats = scheduler.run_once()\n\n    assert stats[\"processed\"] == 1\n    assert stats[\"errors\"] == 1\n    assert stats[\"total\"] == 2\n    # Only ETH should execute\n    order_manager.execute_decision.assert_called_once()\n    kwargs = order_manager.execute_decision.call_args.kwargs\n    assert kwargs[\"symbol\"] == \"ETH\"\n\n\n# ============================================================================\n# AC-11: Environment Tagging - Database Records\n# ============================================================================\n\n\ndef test_scheduler_environment_tagging_in_execution():\n    \"\"\"AC-11: Environment Tagging - Database Records.\"\"\"\n    config = SchedulerSettings(\n        enabled=True,\n        interval_hours=1.0,\n        assets=[\"BTC\", \"SPX\"],\n        environment=\"paper\",\n        timeframe=\"1h\",\n        lookback_hours=12,\n    )\n\n    session = DummySession()\n    data_provider = MagicMock()\n    data_provider.get_ohlc.return_value = _sample_df()\n\n    order_manager = MagicMock()\n    order_manager.execute_decision.return_value = _make_mock_order()\n\n    strategy = Mock()\n    strategy.generate_signal.return_value = StrategyTradingSignal(\n        decision=\"LONG\",\n        confidence=0.9,\n        entry_price=101.0,\n        stop_loss=97.5,\n        take_profit=110.0,\n        reasoning=\"Test\",\n    )\n\n    scheduler = TradingScheduler(\n        trading_graph=Mock(),\n        order_manager=order_manager,\n        data_provider=data_provider,\n        db_session=session,\n        scheduler_settings=config,\n        scheduler_factory=DummyScheduler,\n        strategy=strategy,\n    )\n\n    scheduler.run_once()\n\n    # Verify environment is tagged as 'paper' in all calls\n    calls = order_manager.execute_decision.call_args_list\n    for call in calls:\n        kwargs = call.kwargs\n        assert kwargs[\"environment\"] == Environment.PAPER\n\n\n# ============================================================================\n# AC-15: Idempotency - Double Start\n# ============================================================================\n\n\ndef test_scheduler_double_start_idempotent():\n    \"\"\"AC-15: Idempotency - Double Start.\"\"\"\n    config = SchedulerSettings(\n        enabled=True,\n        interval_hours=1.0,\n        assets=[\"BTC\"],\n        environment=\"paper\",\n    )\n    session = DummySession()\n    scheduler = TradingScheduler(\n        trading_graph=Mock(),\n        order_manager=Mock(),\n        data_provider=Mock(),\n        db_session=session,\n        scheduler_settings=config,\n        scheduler_factory=DummyScheduler,\n        strategy=Mock(),\n    )\n\n    # First start\n    result1 = scheduler.start(immediate=False)\n    assert result1 is True\n    assert scheduler.is_running is True\n    job_count_after_first = len(scheduler.scheduler.jobs)\n\n    # Second start (should be no-op)\n    result2 = scheduler.start(immediate=False)\n    assert result2 is False\n    assert scheduler.is_running is True\n    # Job count should remain the same (no duplicate job registered)\n    job_count_after_second = len(scheduler.scheduler.jobs)\n    assert job_count_after_first == job_count_after_second\n\n\n# ============================================================================\n# Integration: Multiple Assets in Cycle\n# ============================================================================\n\n\ndef test_scheduler_processes_multiple_assets():\n    \"\"\"Test that scheduler processes all configured assets in single cycle.\"\"\"\n    config = SchedulerSettings(\n        enabled=True,\n        interval_hours=1.0,\n        assets=[\"BTC\", \"ETH\", \"SPX\"],\n        environment=\"paper\",\n        timeframe=\"1h\",\n        lookback_hours=12,\n    )\n\n    session = DummySession()\n    data_provider = MagicMock()\n    data_provider.get_ohlc.return_value = _sample_df()\n\n    order_manager = MagicMock()\n    order_manager.execute_decision.return_value = _make_mock_order()\n\n    strategy = Mock()\n    strategy.generate_signal.return_value = StrategyTradingSignal(\n        decision=\"LONG\",\n        confidence=0.8,\n        entry_price=101.0,\n        stop_loss=97.5,\n        take_profit=110.0,\n        reasoning=\"Test\",\n    )\n\n    scheduler = TradingScheduler(\n        trading_graph=Mock(),\n        order_manager=order_manager,\n        data_provider=data_provider,\n        db_session=session,\n        scheduler_settings=config,\n        scheduler_factory=DummyScheduler,\n        strategy=strategy,\n    )\n\n    stats = scheduler.run_once()\n\n    assert stats[\"processed\"] == 3\n    assert stats[\"errors\"] == 0\n    assert stats[\"total\"] == 3\n    assert order_manager.execute_decision.call_count == 3\n\n    # Verify all assets were processed\n    symbols_processed = [\n        call.kwargs[\"symbol\"] for call in order_manager.execute_decision.call_args_list\n    ]\n    assert set(symbols_processed) == {\"BTC\", \"ETH\", \"SPX\"}\n\n\n# ============================================================================\n# Integration: Cycle Tracking and Stats\n# ============================================================================\n\n\ndef test_scheduler_tracks_last_run_stats():\n    \"\"\"Test that scheduler tracks last run statistics.\"\"\"\n    config = SchedulerSettings(\n        enabled=True,\n        interval_hours=1.0,\n        assets=[\"BTC\"],\n        environment=\"paper\",\n        timeframe=\"1h\",\n        lookback_hours=12,\n    )\n\n    session = DummySession()\n    data_provider = MagicMock()\n    data_provider.get_ohlc.return_value = _sample_df()\n\n    order_manager = MagicMock()\n    order_manager.execute_decision.return_value = _make_mock_order()\n\n    strategy = Mock()\n    strategy.generate_signal.return_value = StrategyTradingSignal(\n        decision=\"LONG\",\n        confidence=0.8,\n        entry_price=101.0,\n        stop_loss=97.5,\n        take_profit=110.0,\n        reasoning=\"Test\",\n    )\n\n    scheduler = TradingScheduler(\n        trading_graph=Mock(),\n        order_manager=order_manager,\n        data_provider=data_provider,\n        db_session=session,\n        scheduler_settings=config,\n        scheduler_factory=DummyScheduler,\n        strategy=strategy,\n    )\n\n    assert scheduler.last_run_stats is None\n\n    scheduler.run_once()\n\n    assert scheduler.last_run_stats is not None\n    assert scheduler.last_run_stats[\"processed\"] == 1\n    assert scheduler.last_run_stats[\"errors\"] == 0\n    assert \"duration_seconds\" in scheduler.last_run_stats\n","numLines":686,"startLine":1,"totalLines":686}}}
