{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01RHzay4DRuf1JcLw8KyrpgR","type":"tool_result","content":"1\tfrom __future__ import annotations\n2\t\n3\tfrom datetime import datetime, timedelta\n4\tfrom unittest.mock import MagicMock, Mock\n5\t\n6\timport pandas as pd\n7\tfrom sqlalchemy import create_engine\n8\tfrom sqlalchemy.orm import sessionmaker\n9\t\n10\tfrom apps.streamlit.services.db import DbHandle\n11\tfrom quantagent.models import (\n12\t    ActivePosition,\n13\t    Environment,\n14\t    Order,\n15\t    OrderSide,\n16\t    SchedulerHeartbeat,\n17\t    Signal,\n18\t    Trade,\n19\t)\n20\tfrom quantagent.settings import SchedulerSettings\n21\tfrom quantagent.strategy.base import TradingSignal as StrategyTradingSignal\n22\tfrom quantagent.trading.scheduler import TradingScheduler\n23\t\n24\t\n25\tdef _make_session(table_names: list[str]):\n26\t    engine = create_engine(\"sqlite:///:memory:\")\n27\t    for name in table_names:\n28\t        table = {\n29\t            \"signals\": Signal.__table__,\n30\t            \"orders\": Order.__table__,\n31\t            \"trades\": Trade.__table__,\n32\t            \"scheduler_heartbeats\": SchedulerHeartbeat.__table__,\n33\t            \"active_positions\": ActivePosition.__table__,\n34\t        }[name]\n35\t        table.create(bind=engine)\n36\t    return sessionmaker(bind=engine, autoflush=False, autocommit=False)\n37\t\n38\t\n39\tdef _make_scheduler(session, assets: list[str] | None = None) -> TradingScheduler:\n40\t    config = SchedulerSettings(\n41\t        enabled=True,\n42\t        interval_hours=1.0,\n43\t        assets=assets or [\"BTC\"],\n44\t        environment=\"paper\",\n45\t        timeframe=\"1h\",\n46\t        lookback_hours=12,\n47\t    )\n48\t    data_provider = MagicMock()\n49\t    data_provider.get_ohlc.return_value = pd.DataFrame(\n50\t        {\n51\t            \"timestamp\": pd.date_range(\"2024-01-01\", periods=3, freq=\"h\"),\n52\t            \"open\": [100, 101, 102],\n53\t            \"high\": [101, 102, 103],\n54\t            \"low\": [99, 100, 101],\n55\t            \"close\": [100.5, 101.5, 102.5],\n56\t            \"volume\": [1_000_000, 1_100_000, 1_200_000],\n57\t        }\n58\t    )\n59\t    strategy = Mock()\n60\t    strategy.generate_signal.return_value = StrategyTradingSignal(\n61\t        decision=\"LONG\",\n62\t        confidence=0.9,\n63\t        entry_price=101.0,\n64\t        stop_loss=97.5,\n65\t        take_profit=110.0,\n66\t        reasoning=\"test signal\",\n67\t    )\n68\t    order_manager = MagicMock()\n69\t    order_manager.execute_decision.return_value = Mock(\n70\t        side=OrderSide.BUY,\n71\t        quantity=\"1.0\",\n72\t        symbol=\"BTC\",\n73\t    )\n74\t    return TradingScheduler(\n75\t        trading_graph=Mock(),\n76\t        order_manager=order_manager,\n77\t        data_provider=data_provider,\n78\t        db_session=session,\n79\t        scheduler_settings=config,\n80\t        strategy=strategy,\n81\t    )\n82\t\n83\t\n84\tdef test_upsert_heartbeat_start_updates_existing_row_for_environment():\n85\t    SessionLocal = _make_session(\n86\t        [\"signals\", \"orders\", \"trades\", \"scheduler_heartbeats\", \"active_positions\"]\n87\t    )\n88\t    with SessionLocal() as session:\n89\t        scheduler = _make_scheduler(session, [\"BTC\", \"ETH\"])\n90\t        first_started = datetime.utcnow() - timedelta(minutes=5)\n91\t        second_started = datetime.utcnow()\n92\t\n93\t        first = scheduler._upsert_heartbeat_start(first_started)\n94\t        second = scheduler._upsert_heartbeat_start(second_started)\n95\t\n96\t        rows = session.query(SchedulerHeartbeat).all()\n97\t        assert len(rows) == 1\n98\t        assert first.id == second.id\n99\t        assert rows[0].timestamp == second_started\n100\t        assert rows[0].status == \"running\"\n101\t        assert rows[0].assets == [\"BTC\", \"ETH\"]\n102\t\n103\t\n104\tdef test_upsert_heartbeat_complete_sets_last_trade_id():\n105\t    SessionLocal = _make_session(\n106\t        [\"signals\", \"orders\", \"trades\", \"scheduler_heartbeats\", \"active_positions\"]\n107\t    )\n108\t    with SessionLocal() as session:\n109\t        session.add(\n110\t            Trade(\n111\t                symbol=\"BTC\",\n112\t                entry_price=100,\n113\t                quantity=1,\n114\t                side=OrderSide.BUY,\n115\t                environment=Environment.PAPER,\n116\t            )\n117\t        )\n118\t        session.commit()\n119\t\n120\t        scheduler = _make_scheduler(session)\n121\t        heartbeat = scheduler._upsert_heartbeat_start(datetime.utcnow())\n122\t        scheduler._upsert_heartbeat_complete(\n123\t            heartbeat,\n124\t            {\"processed\": 1, \"errors\": 0, \"duration_seconds\": 3.2, \"total\": 1},\n125\t        )\n126\t\n127\t        refreshed = session.query(SchedulerHeartbeat).one()\n128\t        assert refreshed.status == \"completed\"\n129\t        assert refreshed.completed_at is not None\n130\t        assert refreshed.last_trade_id == 1\n131\t        assert refreshed.stats[\"processed\"] == 1\n132\t\n133\t\n134\tdef test_analyze_and_trade_continues_when_heartbeat_start_fails():\n135\t    SessionLocal = _make_session(\n136\t        [\"signals\", \"orders\", \"trades\", \"scheduler_heartbeats\", \"active_positions\"]\n137\t    )\n138\t    with SessionLocal() as session:\n139\t        scheduler = _make_scheduler(session)\n140\t        scheduler._upsert_heartbeat_start = Mock(return_value=None)\n141\t        scheduler._upsert_heartbeat_complete = Mock()\n142\t\n143\t        stats = scheduler.analyze_and_trade()\n144\t\n145\t        assert stats[\"processed\"] == 1\n146\t        assert stats[\"errors\"] == 0\n147\t        scheduler._upsert_heartbeat_complete.assert_called_once()\n148\t        assert scheduler._upsert_heartbeat_complete.call_args.args[0] is None\n149\t\n150\t\n151\tdef test_db_handle_returns_latest_heartbeat_dict():\n152\t    SessionLocal = _make_session(\n153\t        [\"signals\", \"orders\", \"trades\", \"scheduler_heartbeats\", \"active_positions\"]\n154\t    )\n155\t    started = datetime.utcnow() - timedelta(minutes=10)\n156\t    completed = datetime.utcnow() - timedelta(minutes=9)\n157\t    with SessionLocal() as session:\n158\t        session.add(\n159\t            SchedulerHeartbeat(\n160\t                timestamp=started,\n161\t                completed_at=completed,\n162\t                status=\"completed\",\n163\t                environment=Environment.PAPER,\n164\t                assets=[\"BTC\"],\n165\t                stats={\"processed\": 1, \"errors\": 0, \"duration_seconds\": 60.0, \"total\": 1},\n166\t                last_trade_id=7,\n167\t            )\n168\t        )\n169\t        session.commit()\n170\t\n171\t    db = DbHandle(ok=True, error=None, SessionLocal=SessionLocal)\n172\t    heartbeat = db.get_latest_heartbeat(\"paper\")\n173\t\n174\t    assert heartbeat is not None\n175\t    assert heartbeat[\"status\"] == \"completed\"\n176\t    assert heartbeat[\"environment\"] == \"paper\"\n177\t    assert heartbeat[\"assets\"] == [\"BTC\"]\n178\t    assert heartbeat[\"stats\"][\"processed\"] == 1\n179\t    assert heartbeat[\"last_trade_id\"] == 7\n180\t\n181\t\n182\tdef test_db_handle_recent_heartbeats_are_limited_and_sorted_desc():\n183\t    SessionLocal = _make_session(\n184\t        [\"signals\", \"orders\", \"trades\", \"scheduler_heartbeats\", \"active_positions\"]\n185\t    )\n186\t    base = datetime.utcnow()\n187\t    with SessionLocal() as session:\n188\t        session.add_all(\n189\t            [\n190\t                SchedulerHeartbeat(\n191\t                    timestamp=base - timedelta(minutes=offset),\n192\t                    completed_at=base - timedelta(minutes=offset - 1),\n193\t                    status=\"completed\",\n194\t                    environment=Environment.PAPER,\n195\t                    assets=[\"BTC\"],\n196\t                    stats={\"processed\": 1, \"errors\": 0, \"duration_seconds\": 5.0, \"total\": 1},\n197\t                )\n198\t                for offset in range(12)\n199\t            ]\n200\t        )\n201\t        session.commit()\n202\t\n203\t    db = DbHandle(ok=True, error=None, SessionLocal=SessionLocal)\n204\t    recent = db.get_recent_heartbeats(\"paper\", limit=10)\n205\t\n206\t    assert len(recent) == 10\n207\t    timestamps = [item[\"timestamp\"] for item in recent]\n208\t    assert timestamps == sorted(timestamps, reverse=True)\n209\t\n210\t\n211\tdef test_db_handle_missing_heartbeat_table_fails_closed():\n212\t    SessionLocal = _make_session([\"signals\", \"orders\", \"trades\"])\n213\t    db = DbHandle(ok=True, error=None, SessionLocal=SessionLocal)\n214\t\n215\t    assert db.get_latest_heartbeat(\"paper\") is None\n216\t    assert db.get_recent_heartbeats(\"paper\", limit=10) == []\n217\t\n218\t\n219\t# ---------------------------------------------------------------------------\n220\t# Additional coverage: full cycle integration + edge cases\n221\t# ---------------------------------------------------------------------------\n222\t\n223\t\n224\tdef test_analyze_and_trade_full_cycle_writes_completed_heartbeat():\n225\t    \"\"\"AC-3 end-to-end: real DB integration — full cycle leaves status='completed'.\"\"\"\n226\t    SessionLocal = _make_session(\n227\t        [\"signals\", \"orders\", \"trades\", \"scheduler_heartbeats\", \"active_positions\"]\n228\t    )\n229\t    with SessionLocal() as session:\n230\t        scheduler = _make_scheduler(session, [\"BTC\"])\n231\t        stats = scheduler.analyze_and_trade()\n232\t\n233\t        hb = session.query(SchedulerHeartbeat).first()\n234\t        assert hb is not None\n235\t        assert hb.status == \"completed\"\n236\t        assert hb.completed_at is not None\n237\t        assert stats[\"processed\"] == 1\n238\t        assert stats[\"errors\"] == 0\n239\t\n240\t\n241\tdef test_analyze_and_trade_per_asset_error_completes_heartbeat_with_error_count():\n242\t    \"\"\"AC-4 variant: per-asset DataFetchError increments error count but heartbeat completes.\"\"\"\n243\t    SessionLocal = _make_session(\n244\t        [\"signals\", \"orders\", \"trades\", \"scheduler_heartbeats\", \"active_positions\"]\n245\t    )\n246\t    with SessionLocal() as session:\n247\t        scheduler = _make_scheduler(session, [\"BTC\"])\n248\t        # Empty DataFrame triggers DataFetchError(\"no data returned\")\n249\t        scheduler.data_provider.get_ohlc.return_value = pd.DataFrame()\n250\t\n251\t        stats = scheduler.analyze_and_trade()\n252\t\n253\t        hb = session.query(SchedulerHeartbeat).first()\n254\t        assert hb is not None\n255\t        assert hb.status == \"completed\"\n256\t        assert stats[\"errors\"] == 1\n257\t        assert stats[\"processed\"] == 0\n258\t\n259\t\n260\tdef test_db_handle_returns_none_for_different_environment():\n261\t    \"\"\"Edge Case 3: 'paper' heartbeat is not returned when querying 'backtest'.\"\"\"\n262\t    SessionLocal = _make_session(\n263\t        [\"signals\", \"orders\", \"trades\", \"scheduler_heartbeats\", \"active_positions\"]\n264\t    )\n265\t    with SessionLocal() as session:\n266\t        session.add(\n267\t            SchedulerHeartbeat(\n268\t                timestamp=datetime.utcnow() - timedelta(minutes=5),\n269\t                status=\"completed\",\n270\t                environment=Environment.PAPER,\n271\t                assets=[\"BTC\"],\n272\t                stats={\"processed\": 1, \"errors\": 0, \"duration_seconds\": 1.0, \"total\": 1},\n273\t            )\n274\t        )\n275\t        session.commit()\n276\t\n277\t    db = DbHandle(ok=True, error=None, SessionLocal=SessionLocal)\n278\t    assert db.get_latest_heartbeat(\"backtest\") is None\n279\t    assert db.get_recent_heartbeats(\"backtest\", limit=10) == []\n280\t\n281\t\n282\tdef test_db_handle_ok_false_short_circuits_queries():\n283\t    \"\"\"DbHandle.ok=False short-circuits without touching the DB.\"\"\"\n284\t    db = DbHandle(ok=False, error=\"DB unavailable\", SessionLocal=None)\n285\t    assert db.get_latest_heartbeat(\"paper\") is None\n286\t    assert db.get_recent_heartbeats(\"paper\", limit=10) == []\n287\t"}]},"parent_tool_use_id":null,"session_id":"2b9b65c5-e77e-400b-90aa-d1fae3699661","uuid":"8bf93ecc-c5f2-42bc-b79d-832f5ac4b4e2","timestamp":"2026-05-09T02:38:39.195Z","tool_use_result":{"type":"text","file":{"filePath":"/home/azureuser/repos/projects/QuantAgent/tests/test_vje_scheduler_heartbeat_backend.py","content":"from __future__ import annotations\n\nfrom datetime import datetime, timedelta\nfrom unittest.mock import MagicMock, Mock\n\nimport pandas as pd\nfrom sqlalchemy import create_engine\nfrom sqlalchemy.orm import sessionmaker\n\nfrom apps.streamlit.services.db import DbHandle\nfrom quantagent.models import (\n    ActivePosition,\n    Environment,\n    Order,\n    OrderSide,\n    SchedulerHeartbeat,\n    Signal,\n    Trade,\n)\nfrom quantagent.settings import SchedulerSettings\nfrom quantagent.strategy.base import TradingSignal as StrategyTradingSignal\nfrom quantagent.trading.scheduler import TradingScheduler\n\n\ndef _make_session(table_names: list[str]):\n    engine = create_engine(\"sqlite:///:memory:\")\n    for name in table_names:\n        table = {\n            \"signals\": Signal.__table__,\n            \"orders\": Order.__table__,\n            \"trades\": Trade.__table__,\n            \"scheduler_heartbeats\": SchedulerHeartbeat.__table__,\n            \"active_positions\": ActivePosition.__table__,\n        }[name]\n        table.create(bind=engine)\n    return sessionmaker(bind=engine, autoflush=False, autocommit=False)\n\n\ndef _make_scheduler(session, assets: list[str] | None = None) -> TradingScheduler:\n    config = SchedulerSettings(\n        enabled=True,\n        interval_hours=1.0,\n        assets=assets or [\"BTC\"],\n        environment=\"paper\",\n        timeframe=\"1h\",\n        lookback_hours=12,\n    )\n    data_provider = MagicMock()\n    data_provider.get_ohlc.return_value = pd.DataFrame(\n        {\n            \"timestamp\": pd.date_range(\"2024-01-01\", periods=3, freq=\"h\"),\n            \"open\": [100, 101, 102],\n            \"high\": [101, 102, 103],\n            \"low\": [99, 100, 101],\n            \"close\": [100.5, 101.5, 102.5],\n            \"volume\": [1_000_000, 1_100_000, 1_200_000],\n        }\n    )\n    strategy = Mock()\n    strategy.generate_signal.return_value = StrategyTradingSignal(\n        decision=\"LONG\",\n        confidence=0.9,\n        entry_price=101.0,\n        stop_loss=97.5,\n        take_profit=110.0,\n        reasoning=\"test signal\",\n    )\n    order_manager = MagicMock()\n    order_manager.execute_decision.return_value = Mock(\n        side=OrderSide.BUY,\n        quantity=\"1.0\",\n        symbol=\"BTC\",\n    )\n    return TradingScheduler(\n        trading_graph=Mock(),\n        order_manager=order_manager,\n        data_provider=data_provider,\n        db_session=session,\n        scheduler_settings=config,\n        strategy=strategy,\n    )\n\n\ndef test_upsert_heartbeat_start_updates_existing_row_for_environment():\n    SessionLocal = _make_session(\n        [\"signals\", \"orders\", \"trades\", \"scheduler_heartbeats\", \"active_positions\"]\n    )\n    with SessionLocal() as session:\n        scheduler = _make_scheduler(session, [\"BTC\", \"ETH\"])\n        first_started = datetime.utcnow() - timedelta(minutes=5)\n        second_started = datetime.utcnow()\n\n        first = scheduler._upsert_heartbeat_start(first_started)\n        second = scheduler._upsert_heartbeat_start(second_started)\n\n        rows = session.query(SchedulerHeartbeat).all()\n        assert len(rows) == 1\n        assert first.id == second.id\n        assert rows[0].timestamp == second_started\n        assert rows[0].status == \"running\"\n        assert rows[0].assets == [\"BTC\", \"ETH\"]\n\n\ndef test_upsert_heartbeat_complete_sets_last_trade_id():\n    SessionLocal = _make_session(\n        [\"signals\", \"orders\", \"trades\", \"scheduler_heartbeats\", \"active_positions\"]\n    )\n    with SessionLocal() as session:\n        session.add(\n            Trade(\n                symbol=\"BTC\",\n                entry_price=100,\n                quantity=1,\n                side=OrderSide.BUY,\n                environment=Environment.PAPER,\n            )\n        )\n        session.commit()\n\n        scheduler = _make_scheduler(session)\n        heartbeat = scheduler._upsert_heartbeat_start(datetime.utcnow())\n        scheduler._upsert_heartbeat_complete(\n            heartbeat,\n            {\"processed\": 1, \"errors\": 0, \"duration_seconds\": 3.2, \"total\": 1},\n        )\n\n        refreshed = session.query(SchedulerHeartbeat).one()\n        assert refreshed.status == \"completed\"\n        assert refreshed.completed_at is not None\n        assert refreshed.last_trade_id == 1\n        assert refreshed.stats[\"processed\"] == 1\n\n\ndef test_analyze_and_trade_continues_when_heartbeat_start_fails():\n    SessionLocal = _make_session(\n        [\"signals\", \"orders\", \"trades\", \"scheduler_heartbeats\", \"active_positions\"]\n    )\n    with SessionLocal() as session:\n        scheduler = _make_scheduler(session)\n        scheduler._upsert_heartbeat_start = Mock(return_value=None)\n        scheduler._upsert_heartbeat_complete = Mock()\n\n        stats = scheduler.analyze_and_trade()\n\n        assert stats[\"processed\"] == 1\n        assert stats[\"errors\"] == 0\n        scheduler._upsert_heartbeat_complete.assert_called_once()\n        assert scheduler._upsert_heartbeat_complete.call_args.args[0] is None\n\n\ndef test_db_handle_returns_latest_heartbeat_dict():\n    SessionLocal = _make_session(\n        [\"signals\", \"orders\", \"trades\", \"scheduler_heartbeats\", \"active_positions\"]\n    )\n    started = datetime.utcnow() - timedelta(minutes=10)\n    completed = datetime.utcnow() - timedelta(minutes=9)\n    with SessionLocal() as session:\n        session.add(\n            SchedulerHeartbeat(\n                timestamp=started,\n                completed_at=completed,\n                status=\"completed\",\n                environment=Environment.PAPER,\n                assets=[\"BTC\"],\n                stats={\"processed\": 1, \"errors\": 0, \"duration_seconds\": 60.0, \"total\": 1},\n                last_trade_id=7,\n            )\n        )\n        session.commit()\n\n    db = DbHandle(ok=True, error=None, SessionLocal=SessionLocal)\n    heartbeat = db.get_latest_heartbeat(\"paper\")\n\n    assert heartbeat is not None\n    assert heartbeat[\"status\"] == \"completed\"\n    assert heartbeat[\"environment\"] == \"paper\"\n    assert heartbeat[\"assets\"] == [\"BTC\"]\n    assert heartbeat[\"stats\"][\"processed\"] == 1\n    assert heartbeat[\"last_trade_id\"] == 7\n\n\ndef test_db_handle_recent_heartbeats_are_limited_and_sorted_desc():\n    SessionLocal = _make_session(\n        [\"signals\", \"orders\", \"trades\", \"scheduler_heartbeats\", \"active_positions\"]\n    )\n    base = datetime.utcnow()\n    with SessionLocal() as session:\n        session.add_all(\n            [\n                SchedulerHeartbeat(\n                    timestamp=base - timedelta(minutes=offset),\n                    completed_at=base - timedelta(minutes=offset - 1),\n                    status=\"completed\",\n                    environment=Environment.PAPER,\n                    assets=[\"BTC\"],\n                    stats={\"processed\": 1, \"errors\": 0, \"duration_seconds\": 5.0, \"total\": 1},\n                )\n                for offset in range(12)\n            ]\n        )\n        session.commit()\n\n    db = DbHandle(ok=True, error=None, SessionLocal=SessionLocal)\n    recent = db.get_recent_heartbeats(\"paper\", limit=10)\n\n    assert len(recent) == 10\n    timestamps = [item[\"timestamp\"] for item in recent]\n    assert timestamps == sorted(timestamps, reverse=True)\n\n\ndef test_db_handle_missing_heartbeat_table_fails_closed():\n    SessionLocal = _make_session([\"signals\", \"orders\", \"trades\"])\n    db = DbHandle(ok=True, error=None, SessionLocal=SessionLocal)\n\n    assert db.get_latest_heartbeat(\"paper\") is None\n    assert db.get_recent_heartbeats(\"paper\", limit=10) == []\n\n\n# ---------------------------------------------------------------------------\n# Additional coverage: full cycle integration + edge cases\n# ---------------------------------------------------------------------------\n\n\ndef test_analyze_and_trade_full_cycle_writes_completed_heartbeat():\n    \"\"\"AC-3 end-to-end: real DB integration — full cycle leaves status='completed'.\"\"\"\n    SessionLocal = _make_session(\n        [\"signals\", \"orders\", \"trades\", \"scheduler_heartbeats\", \"active_positions\"]\n    )\n    with SessionLocal() as session:\n        scheduler = _make_scheduler(session, [\"BTC\"])\n        stats = scheduler.analyze_and_trade()\n\n        hb = session.query(SchedulerHeartbeat).first()\n        assert hb is not None\n        assert hb.status == \"completed\"\n        assert hb.completed_at is not None\n        assert stats[\"processed\"] == 1\n        assert stats[\"errors\"] == 0\n\n\ndef test_analyze_and_trade_per_asset_error_completes_heartbeat_with_error_count():\n    \"\"\"AC-4 variant: per-asset DataFetchError increments error count but heartbeat completes.\"\"\"\n    SessionLocal = _make_session(\n        [\"signals\", \"orders\", \"trades\", \"scheduler_heartbeats\", \"active_positions\"]\n    )\n    with SessionLocal() as session:\n        scheduler = _make_scheduler(session, [\"BTC\"])\n        # Empty DataFrame triggers DataFetchError(\"no data returned\")\n        scheduler.data_provider.get_ohlc.return_value = pd.DataFrame()\n\n        stats = scheduler.analyze_and_trade()\n\n        hb = session.query(SchedulerHeartbeat).first()\n        assert hb is not None\n        assert hb.status == \"completed\"\n        assert stats[\"errors\"] == 1\n        assert stats[\"processed\"] == 0\n\n\ndef test_db_handle_returns_none_for_different_environment():\n    \"\"\"Edge Case 3: 'paper' heartbeat is not returned when querying 'backtest'.\"\"\"\n    SessionLocal = _make_session(\n        [\"signals\", \"orders\", \"trades\", \"scheduler_heartbeats\", \"active_positions\"]\n    )\n    with SessionLocal() as session:\n        session.add(\n            SchedulerHeartbeat(\n                timestamp=datetime.utcnow() - timedelta(minutes=5),\n                status=\"completed\",\n                environment=Environment.PAPER,\n                assets=[\"BTC\"],\n                stats={\"processed\": 1, \"errors\": 0, \"duration_seconds\": 1.0, \"total\": 1},\n            )\n        )\n        session.commit()\n\n    db = DbHandle(ok=True, error=None, SessionLocal=SessionLocal)\n    assert db.get_latest_heartbeat(\"backtest\") is None\n    assert db.get_recent_heartbeats(\"backtest\", limit=10) == []\n\n\ndef test_db_handle_ok_false_short_circuits_queries():\n    \"\"\"DbHandle.ok=False short-circuits without touching the DB.\"\"\"\n    db = DbHandle(ok=False, error=\"DB unavailable\", SessionLocal=None)\n    assert db.get_latest_heartbeat(\"paper\") is None\n    assert db.get_recent_heartbeats(\"paper\", limit=10) == []\n","numLines":287,"startLine":1,"totalLines":287}}}
