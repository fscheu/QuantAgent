{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01NhSDco9ygDB4bMdEuyNAWd","type":"tool_result","content":"1\t\"\"\"TradingScheduler orchestrates periodic analysis + paper trading.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\timport logging\n6\tfrom datetime import datetime, timedelta\n7\tfrom typing import Callable, Dict, Optional\n8\t\n9\timport pandas as pd\n10\tfrom apscheduler.schedulers.background import BackgroundScheduler\n11\tfrom apscheduler.triggers.interval import IntervalTrigger\n12\tfrom sqlalchemy.orm import Session\n13\t\n14\tfrom quantagent import settings\n15\tfrom quantagent.data.provider import DataProvider\n16\tfrom quantagent.models import Environment, Signal, TradeSignal\n17\tfrom quantagent.static_util import format_ohlcv_for_agents\n18\tfrom quantagent.strategy.base import TradingSignal as StrategyTradingSignal\n19\tfrom quantagent.strategy.llm_agent_strategy import LLMAgentStrategy\n20\tfrom quantagent.trading.order_manager import OrderManager\n21\tfrom quantagent.trading.position_monitor import PositionMonitor\n22\tfrom quantagent.trading_graph import TradingGraph\n23\t\n24\tlogger = logging.getLogger(__name__)\n25\t\n26\t\n27\tclass SchedulerError(Exception):\n28\t    \"\"\"Base class for scheduler errors.\"\"\"\n29\t\n30\t\n31\tclass DataFetchError(SchedulerError):\n32\t    \"\"\"Raised when market data cannot be retrieved.\"\"\"\n33\t\n34\t\n35\tclass AnalysisError(SchedulerError):\n36\t    \"\"\"Raised when the analysis pipeline fails.\"\"\"\n37\t\n38\t\n39\tclass ExecutionError(SchedulerError):\n40\t    \"\"\"Raised when trade execution fails.\"\"\"\n41\t\n42\t\n43\tclass TradingScheduler:\n44\t    \"\"\"Run TradingGraph analysis and order execution on an interval.\"\"\"\n45\t\n46\t    JOB_ID = \"trading_scheduler_job\"\n47\t\n48\t    def __init__(\n49\t        self,\n50\t        *,\n51\t        trading_graph: TradingGraph,\n52\t        order_manager: OrderManager,\n53\t        data_provider: DataProvider,\n54\t        db_session: Session,\n55\t        scheduler_settings: Optional[settings.SchedulerSettings] = None,\n56\t        scheduler_factory: Optional[Callable[[], BackgroundScheduler]] = None,\n57\t        strategy: Optional[LLMAgentStrategy] = None,\n58\t    ) -> None:\n59\t        self.trading_graph = trading_graph\n60\t        self.order_manager = order_manager\n61\t        self.data_provider = data_provider\n62\t        self.db = db_session\n63\t        self.config = scheduler_settings or settings.scheduler\n64\t        self.environment = Environment(self.config.environment)\n65\t        self.strategy = strategy or LLMAgentStrategy(self.trading_graph)\n66\t\n67\t        # Initialize PositionMonitor for tracking active positions\n68\t        self.position_monitor = PositionMonitor(\n69\t            db_session=db_session,\n70\t            backtest_run_id=None  # Paper trading doesn't use backtest_run_id\n71\t        )\n72\t\n73\t        self.scheduler = (\n74\t            scheduler_factory()\n75\t            if scheduler_factory is not None\n76\t            else BackgroundScheduler(\n77\t                job_defaults={\"coalesce\": True, \"max_instances\": 1}, timezone=\"UTC\"\n78\t            )\n79\t        )\n80\t        self.is_running = False\n81\t        self.last_run_stats: Optional[Dict[str, float]] = None\n82\t\n83\t    # ------------------------------------------------------------------\n84\t    # Lifecycle management\n85\t    # ------------------------------------------------------------------\n86\t    def start(self, *, immediate: bool = True) -> bool:\n87\t        \"\"\"Start APScheduler background loop.\"\"\"\n88\t        if not self.config.enabled:\n89\t            logger.warning(\n90\t                \"TradingScheduler is disabled; set TRADING_SCHEDULER_ENABLED=1 to run\"\n91\t            )\n92\t            return False\n93\t        if self.is_running:\n94\t            logger.warning(\"TradingScheduler already running; ignoring start() request\")\n95\t            return False\n96\t\n97\t        trigger = IntervalTrigger(hours=self.config.interval_hours)\n98\t        next_run = datetime.utcnow() if immediate else None\n99\t        self.scheduler.add_job(\n100\t            self.analyze_and_trade,\n101\t            trigger=trigger,\n102\t            id=self.JOB_ID,\n103\t            replace_existing=True,\n104\t            next_run_time=next_run,\n105\t            coalesce=True,\n106\t            max_instances=1,\n107\t        )\n108\t        self.scheduler.start()\n109\t        self.is_running = True\n110\t        logger.info(\n111\t            \"Scheduler started, interval=%.3fh, assets=%s\",\n112\t            self.config.interval_hours,\n113\t            self.config.assets,\n114\t            extra={\n115\t                \"event_type\": \"scheduler.start\",\n116\t                \"environment\": self.environment.value,\n117\t                \"extra_data\": {\n118\t                    \"interval_hours\": self.config.interval_hours,\n119\t                    \"assets\": self.config.assets,\n120\t                    \"timeframe\": self.config.timeframe,\n121\t                },\n122\t            },\n123\t        )\n124\t        return True\n125\t\n126\t    def stop(self) -> None:\n127\t        \"\"\"Stop APScheduler loop.\"\"\"\n128\t        if not self.is_running:\n129\t            logger.warning(\"TradingScheduler not running; ignoring stop() request\")\n130\t            return\n131\t        self.scheduler.shutdown(wait=True)\n132\t        self.is_running = False\n133\t        logger.info(\n134\t            \"TradingScheduler stopped\",\n135\t            extra={\n136\t                \"event_type\": \"scheduler.stop\",\n137\t                \"environment\": self.environment.value,\n138\t            },\n139\t        )\n140\t\n141\t    def run_once(self) -> Dict[str, float]:\n142\t        \"\"\"Run a single analyze+trade cycle synchronously.\"\"\"\n143\t        return self.analyze_and_trade()\n144\t\n145\t    # ------------------------------------------------------------------\n146\t    # Core execution\n147\t    # ------------------------------------------------------------------\n148\t    def analyze_and_trade(self) -> Dict[str, float]:\n149\t        cycle_start = datetime.utcnow()\n150\t        processed = 0\n151\t        errors = 0\n152\t\n153\t        for symbol in self.config.assets:\n154\t            try:\n155\t                self._process_asset(symbol)\n156\t                processed += 1\n157\t            except DataFetchError as exc:\n158\t                errors += 1\n159\t                logger.warning(\n160\t                    \"Failed to fetch data for %s: %s\",\n161\t                    symbol,\n162\t                    exc,\n163\t                    extra={\n164\t                        \"event_type\": \"scheduler.data_error\",\n165\t                        \"symbol\": symbol,\n166\t                        \"environment\": self.environment.value,\n167\t                    },\n168\t                )\n169\t            except AnalysisError as exc:\n170\t                errors += 1\n171\t                logger.error(\n172\t                    \"Analysis failed for %s: %s\",\n173\t                    symbol,\n174\t                    exc,\n175\t                    extra={\n176\t                        \"event_type\": \"scheduler.analysis_error\",\n177\t                        \"symbol\": symbol,\n178\t                        \"environment\": self.environment.value,\n179\t                    },\n180\t                )\n181\t            except ExecutionError as exc:\n182\t                errors += 1\n183\t                logger.error(\n184\t                    \"Execution failed for %s: %s\",\n185\t                    symbol,\n186\t                    exc,\n187\t                    extra={\n188\t                        \"event_type\": \"scheduler.execution_error\",\n189\t                        \"symbol\": symbol,\n190\t                        \"environment\": self.environment.value,\n191\t                    },\n192\t                )\n193\t            except Exception:  # pragma: no cover - defensive logging\n194\t                errors += 1\n195\t                logger.exception(\n196\t                    \"Unexpected scheduler error for %s\",\n197\t                    symbol,\n198\t                    extra={\n199\t                        \"event_type\": \"scheduler.unexpected_error\",\n200\t                        \"symbol\": symbol,\n201\t                        \"environment\": self.environment.value,\n202\t                    },\n203\t                )\n204\t\n205\t        duration = (datetime.utcnow() - cycle_start).total_seconds()\n206\t        stats = {\n207\t            \"processed\": processed,\n208\t            \"errors\": errors,\n209\t            \"duration_seconds\": duration,\n210\t            \"total\": len(self.config.assets),\n211\t        }\n212\t        self.last_run_stats = stats\n213\t\n214\t        logger.info(\n215\t            \"Analysis cycle completed: %s/%s processed, %s errors (%.2fs)\",\n216\t            processed,\n217\t            len(self.config.assets),\n218\t            errors,\n219\t            duration,\n220\t            extra={\n221\t                \"event_type\": \"scheduler.cycle_complete\",\n222\t                \"environment\": self.environment.value,\n223\t                \"extra_data\": stats,\n224\t            },\n225\t        )\n226\t        return stats\n227\t\n228\t    # ------------------------------------------------------------------\n229\t    # Internals\n230\t    # ------------------------------------------------------------------\n231\t    def _process_asset(self, symbol: str) -> None:\n232\t        df = self._fetch_market_data(symbol)\n233\t        kline_data = format_ohlcv_for_agents(df)\n234\t        current_price = float(df[\"close\"].iloc[-1])\n235\t\n236\t        # NEW: Position monitoring and exit check\n237\t        position = self.position_monitor.get_active_position(symbol)\n238\t        if position:\n239\t            # Calculate prev_close (fallback to current if not enough data)\n240\t            prev_close = (\n241\t                float(df[\"close\"].iloc[-2]) if len(df) >= 2\n242\t                else current_price\n243\t            )\n244\t\n245\t            # Update tracking\n246\t            self.position_monitor.update_candle_tracking(\n247\t                position, current_price, prev_close\n248\t            )\n249\t\n250\t            logger.debug(\n251\t                \"Position tracked: %s (candles=%d)\",\n252\t                symbol, position.candles_since_entry,\n253\t                extra={\n254\t                    \"event_type\": \"scheduler.position_tracked\",\n255\t                    \"symbol\": symbol,\n256\t                    \"environment\": self.environment.value,\n257\t                }\n258\t            )\n259\t\n260\t            # Check exit conditions\n261\t            should_exit, exit_reason = self._check_exit_conditions(\n262\t                position, current_price\n263\t            )\n264\t\n265\t            if should_exit:\n266\t                self._execute_position_exit(\n267\t                    position, exit_reason, current_price, symbol\n268\t                )\n269\t                logger.info(\n270\t                    \"Position exit: %s reason=%s price=%.2f\",\n271\t                    symbol, exit_reason, current_price,\n272\t                    extra={\n273\t                        \"event_type\": \"scheduler.position_exit\",\n274\t                        \"symbol\": symbol,\n275\t                        \"environment\": self.environment.value,\n276\t                        \"extra_data\": {\n277\t                            \"reason\": exit_reason,\n278\t                            \"exit_price\": current_price\n279\t                        }\n280\t                    }\n281\t                )\n282\t                return  # Skip LLM analysis after exit\n283\t\n284\t        thread_id = self._make_thread_id(symbol)\n285\t\n286\t        try:\n287\t            signal = self.strategy.generate_signal(\n288\t                kline_data,\n289\t                symbol,\n290\t                self.config.timeframe,\n291\t                current_price,\n292\t                thread_id=thread_id,\n293\t            )\n294\t        except Exception as exc:  # pragma: no cover - strategy errors\n295\t            raise AnalysisError(str(exc)) from exc\n296\t\n297\t        if signal is None:\n298\t            logger.info(\n299\t                \"No action for %s: signal=HOLD\",\n300\t                symbol,\n301\t                extra={\n302\t                    \"event_type\": \"scheduler.hold\",\n303\t                    \"symbol\": symbol,\n304\t                    \"environment\": self.environment.value,\n305\t                },\n306\t            )\n307\t            return\n308\t\n309\t        trade_signal = self._map_trade_signal(signal)\n310\t        if trade_signal == TradeSignal.NEUTRAL:\n311\t            logger.info(\n312\t                \"No action for %s: signal=HOLD\",\n313\t                symbol,\n314\t                extra={\n315\t                    \"event_type\": \"scheduler.hold\",\n316\t                    \"symbol\": symbol,\n317\t                    \"environment\": self.environment.value,\n318\t                },\n319\t            )\n320\t            return\n321\t\n322\t        db_signal = self._persist_signal(symbol, trade_signal, signal, thread_id)\n323\t\n324\t        try:\n325\t            order = self.order_manager.execute_decision(\n326\t                symbol=symbol,\n327\t                decision=trade_signal,\n328\t                confidence=signal.confidence,\n329\t                current_price=current_price,\n330\t                environment=self.environment,\n331\t                trigger_signal_id=db_signal.id if db_signal else None,\n332\t            )\n333\t        except Exception as exc:\n334\t            self.db.rollback()\n335\t            raise ExecutionError(str(exc)) from exc\n336\t\n337\t        if order:\n338\t            # NEW: Open ActivePosition for tracking\n339\t            # Extract stop loss and take profit from signal (with fallbacks)\n340\t            stop_loss = getattr(signal, 'stop_loss', None) or (\n341\t                current_price * 0.98 if trade_signal == TradeSignal.LONG\n342\t                else current_price * 1.02\n343\t            )\n344\t            take_profit = getattr(signal, 'take_profit', None) or (\n345\t                current_price * 1.04 if trade_signal == TradeSignal.LONG\n346\t                else current_price * 0.96\n347\t            )\n348\t\n349\t            self.position_monitor.open_position(\n350\t                symbol=symbol,\n351\t                side=order.side,\n352\t                entry_price=current_price,\n353\t                stop_loss=stop_loss,\n354\t                take_profit=take_profit,\n355\t                quantity=order.quantity,\n356\t                exit_policy=\"sl_tp_only\",\n357\t                signal_id=db_signal.id if db_signal else None,\n358\t                backtest_run_id=None,\n359\t            )\n360\t\n361\t            logger.info(\n362\t                \"Order executed: %s %s [%s] [entry=%.2f, sl=%.2f, tp=%.2f]\",\n363\t                symbol,\n364\t                trade_signal.value.upper(),\n365\t                self.environment.value,\n366\t                current_price,\n367\t                stop_loss,\n368\t                take_profit,\n369\t                extra={\n370\t                    \"event_type\": \"scheduler.order_executed\",\n371\t                    \"symbol\": symbol,\n372\t                    \"environment\": self.environment.value,\n373\t                    \"extra_data\": {\n374\t                        \"decision\": trade_signal.value,\n375\t                        \"confidence\": signal.confidence,\n376\t                        \"entry_price\": current_price,\n377\t                        \"stop_loss\": stop_loss,\n378\t                        \"take_profit\": take_profit,\n379\t                    },\n380\t                },\n381\t            )\n382\t        else:\n383\t            self.db.commit()\n384\t            logger.info(\n385\t                \"Decision rejected for %s by execution layer\",\n386\t                symbol,\n387\t                extra={\n388\t                    \"event_type\": \"scheduler.order_skipped\",\n389\t                    \"symbol\": symbol,\n390\t                    \"environment\": self.environment.value,\n391\t                },\n392\t            )\n393\t\n394\t    def _fetch_market_data(self, symbol: str) -> pd.DataFrame:\n395\t        end_date = datetime.utcnow()\n396\t        start_date = end_date - timedelta(hours=self.config.lookback_hours)\n397\t        try:\n398\t            df = self.data_provider.get_ohlc(\n399\t                symbol=symbol,\n400\t                timeframe=self.config.timeframe,\n401\t                start_date=start_date,\n402\t                end_date=end_date,\n403\t            )\n404\t        except Exception as exc:  # pragma: no cover - provider errors\n405\t            raise DataFetchError(str(exc)) from exc\n406\t\n407\t        if df.empty:\n408\t            raise DataFetchError(\"no data returned\")\n409\t        if \"close\" not in df.columns:\n410\t            raise DataFetchError(\"missing close column in OHLC data\")\n411\t        return df\n412\t\n413\t    def _persist_signal(\n414\t        self,\n415\t        symbol: str,\n416\t        decision: TradeSignal,\n417\t        signal: StrategyTradingSignal,\n418\t        thread_id: Optional[str],\n419\t    ) -> Signal:\n420\t        record = Signal(\n421\t            symbol=symbol,\n422\t            signal=decision,\n423\t            confidence=signal.confidence,\n424\t            timeframe=self.config.timeframe,\n425\t            analysis_summary=signal.reasoning,\n426\t            generated_at=datetime.utcnow(),\n427\t            environment=self.environment,\n428\t            model_provider=settings.AGENT_LLM_PROVIDER,\n429\t            model_name=settings.AGENT_LLM_MODEL,\n430\t            temperature=settings.AGENT_LLM_TEMPERATURE,\n431\t            thread_id=thread_id,\n432\t            state_snapshot={\n433\t                \"entry_price\": signal.entry_price,\n434\t                \"stop_loss\": signal.stop_loss,\n435\t                \"take_profit\": signal.take_profit,\n436\t                \"trailing_stop_pct\": signal.trailing_stop_pct,\n437\t            },\n438\t        )\n439\t\n440\t        self.db.add(record)\n441\t        self.db.flush()\n442\t        if getattr(record, \"id\", None) is None:\n443\t            self.db.refresh(record)\n444\t        return record\n445\t\n446\t    @staticmethod\n447\t    def _map_trade_signal(signal: StrategyTradingSignal) -> TradeSignal:\n448\t        decision = signal.decision.upper()\n449\t        if decision == \"LONG\":\n450\t            return TradeSignal.LONG\n451\t        if decision == \"SHORT\":\n452\t            return TradeSignal.SHORT\n453\t        return TradeSignal.NEUTRAL\n454\t\n455\t    def _make_thread_id(self, symbol: str) -> str:\n456\t        timestamp = datetime.utcnow().strftime(\"%Y%m%dT%H%M%S\")\n457\t        return f\"scheduler_{symbol}_{timestamp}\"\n458\t\n459\t    def _check_exit_conditions(\n460\t        self, position, current_price: float\n461\t    ) -> tuple[bool, Optional[str]]:\n462\t        \"\"\"\n463\t        Check if position should exit based on stop loss, take profit, or max hold.\n464\t\n465\t        Args:\n466\t            position: ActivePosition instance\n467\t            current_price: Current market price\n468\t\n469\t        Returns:\n470\t            Tuple of (should_exit, exit_reason)\n471\t        \"\"\"\n472\t        from quantagent.models import OrderSide\n473\t\n474\t        # Stop loss check\n475\t        if position.side == OrderSide.BUY:  # LONG position\n476\t            if current_price <= float(position.stop_loss):\n477\t                return (True, \"stop_loss\")\n478\t        else:  # SHORT position\n479\t            if current_price >= float(position.stop_loss):\n480\t                return (True, \"stop_loss\")\n481\t\n482\t        # Take profit check\n483\t        if position.side == OrderSide.BUY:\n484\t            if current_price >= float(position.take_profit):\n485\t                return (True, \"take_profit\")\n486\t        else:\n487\t            if current_price <= float(position.take_profit):\n488\t                return (True, \"take_profit\")\n489\t\n490\t        # Max hold check\n491\t        if position.max_hold_candles:\n492\t            if position.candles_since_entry >= position.max_hold_candles:\n493\t                return (True, \"max_hold\")\n494\t\n495\t        return (False, None)\n496\t\n497\t    def _execute_position_exit(\n498\t        self,\n499\t        position,\n500\t        exit_reason: str,\n501\t        exit_price: float,\n502\t        symbol: str,\n503\t    ) -> None:\n504\t        \"\"\"\n505\t        Execute position exit by closing position and placing exit order.\n506\t\n507\t        Args:\n508\t            position: ActivePosition to close\n509\t            exit_reason: Reason for exit (stop_loss, take_profit, max_hold)\n510\t            exit_price: Price at exit\n511\t            symbol: Trading symbol\n512\t\n513\t        Raises:\n514\t            ExecutionError: If exit order fails\n515\t        \"\"\"\n516\t        from quantagent.models import OrderSide, Trade\n517\t\n518\t        # Determine exit signal (opposite of position)\n519\t        exit_signal = (\n520\t            TradeSignal.SHORT\n521\t            if position.side == OrderSide.BUY\n522\t            else TradeSignal.LONG\n523\t        )\n524\t\n525\t        # Close position in tracking system\n526\t        self.position_monitor.close_position(\n527\t            position, reason=exit_reason, exit_price=exit_price\n528\t        )\n529\t\n530\t        # Execute exit order\n531\t        try:\n532\t            _order = self.order_manager.execute_decision(\n533\t                symbol=symbol,\n534\t                decision=exit_signal,\n535\t                confidence=1.0,  # Exit is mandatory, not confidence-based\n536\t                current_price=exit_price,\n537\t                environment=self.environment,\n538\t                trigger_signal_id=position.signal_id,\n539\t            )\n540\t            # Note: Exit order execution is fire-and-forget in current architecture\n541\t            # OrderManager logs the result internally\n542\t        except Exception as exc:\n543\t            self.db.rollback()\n544\t            logger.error(\n545\t                \"Exit order failed for %s: %s\",\n546\t                symbol,\n547\t                exc,\n548\t                extra={\n549\t                    \"event_type\": \"scheduler.exit_order_error\",\n550\t                    \"symbol\": symbol,\n551\t                    \"environment\": self.environment.value,\n552\t                },\n553\t            )\n554\t            raise ExecutionError(f\"Exit failed: {exc}\") from exc\n555\t\n556\t        # Update Trade record with exit reason\n557\t        if position.trade_id:\n558\t            trade = self.db.query(Trade).filter(Trade.id == position.trade_id).first()\n559\t            if trade:\n560\t                trade.exit_signal = exit_reason\n561\t                trade.closed_at = position.closed_at\n562\t                self.db.commit()\n563\t"}]},"parent_tool_use_id":null,"session_id":"e388d92c-4a3f-4545-9d52-960b86d84a6e","uuid":"2d6c23bd-2edf-4daa-9a75-12e53defa01f","timestamp":"2026-05-09T07:37:41.166Z","tool_use_result":{"type":"text","file":{"filePath":"/home/azureuser/repos/projects/QuantAgent/quantagent/trading/scheduler.py","content":"\"\"\"TradingScheduler orchestrates periodic analysis + paper trading.\"\"\"\n\nfrom __future__ import annotations\n\nimport logging\nfrom datetime import datetime, timedelta\nfrom typing import Callable, Dict, Optional\n\nimport pandas as pd\nfrom apscheduler.schedulers.background import BackgroundScheduler\nfrom apscheduler.triggers.interval import IntervalTrigger\nfrom sqlalchemy.orm import Session\n\nfrom quantagent import settings\nfrom quantagent.data.provider import DataProvider\nfrom quantagent.models import Environment, Signal, TradeSignal\nfrom quantagent.static_util import format_ohlcv_for_agents\nfrom quantagent.strategy.base import TradingSignal as StrategyTradingSignal\nfrom quantagent.strategy.llm_agent_strategy import LLMAgentStrategy\nfrom quantagent.trading.order_manager import OrderManager\nfrom quantagent.trading.position_monitor import PositionMonitor\nfrom quantagent.trading_graph import TradingGraph\n\nlogger = logging.getLogger(__name__)\n\n\nclass SchedulerError(Exception):\n    \"\"\"Base class for scheduler errors.\"\"\"\n\n\nclass DataFetchError(SchedulerError):\n    \"\"\"Raised when market data cannot be retrieved.\"\"\"\n\n\nclass AnalysisError(SchedulerError):\n    \"\"\"Raised when the analysis pipeline fails.\"\"\"\n\n\nclass ExecutionError(SchedulerError):\n    \"\"\"Raised when trade execution fails.\"\"\"\n\n\nclass TradingScheduler:\n    \"\"\"Run TradingGraph analysis and order execution on an interval.\"\"\"\n\n    JOB_ID = \"trading_scheduler_job\"\n\n    def __init__(\n        self,\n        *,\n        trading_graph: TradingGraph,\n        order_manager: OrderManager,\n        data_provider: DataProvider,\n        db_session: Session,\n        scheduler_settings: Optional[settings.SchedulerSettings] = None,\n        scheduler_factory: Optional[Callable[[], BackgroundScheduler]] = None,\n        strategy: Optional[LLMAgentStrategy] = None,\n    ) -> None:\n        self.trading_graph = trading_graph\n        self.order_manager = order_manager\n        self.data_provider = data_provider\n        self.db = db_session\n        self.config = scheduler_settings or settings.scheduler\n        self.environment = Environment(self.config.environment)\n        self.strategy = strategy or LLMAgentStrategy(self.trading_graph)\n\n        # Initialize PositionMonitor for tracking active positions\n        self.position_monitor = PositionMonitor(\n            db_session=db_session,\n            backtest_run_id=None  # Paper trading doesn't use backtest_run_id\n        )\n\n        self.scheduler = (\n            scheduler_factory()\n            if scheduler_factory is not None\n            else BackgroundScheduler(\n                job_defaults={\"coalesce\": True, \"max_instances\": 1}, timezone=\"UTC\"\n            )\n        )\n        self.is_running = False\n        self.last_run_stats: Optional[Dict[str, float]] = None\n\n    # ------------------------------------------------------------------\n    # Lifecycle management\n    # ------------------------------------------------------------------\n    def start(self, *, immediate: bool = True) -> bool:\n        \"\"\"Start APScheduler background loop.\"\"\"\n        if not self.config.enabled:\n            logger.warning(\n                \"TradingScheduler is disabled; set TRADING_SCHEDULER_ENABLED=1 to run\"\n            )\n            return False\n        if self.is_running:\n            logger.warning(\"TradingScheduler already running; ignoring start() request\")\n            return False\n\n        trigger = IntervalTrigger(hours=self.config.interval_hours)\n        next_run = datetime.utcnow() if immediate else None\n        self.scheduler.add_job(\n            self.analyze_and_trade,\n            trigger=trigger,\n            id=self.JOB_ID,\n            replace_existing=True,\n            next_run_time=next_run,\n            coalesce=True,\n            max_instances=1,\n        )\n        self.scheduler.start()\n        self.is_running = True\n        logger.info(\n            \"Scheduler started, interval=%.3fh, assets=%s\",\n            self.config.interval_hours,\n            self.config.assets,\n            extra={\n                \"event_type\": \"scheduler.start\",\n                \"environment\": self.environment.value,\n                \"extra_data\": {\n                    \"interval_hours\": self.config.interval_hours,\n                    \"assets\": self.config.assets,\n                    \"timeframe\": self.config.timeframe,\n                },\n            },\n        )\n        return True\n\n    def stop(self) -> None:\n        \"\"\"Stop APScheduler loop.\"\"\"\n        if not self.is_running:\n            logger.warning(\"TradingScheduler not running; ignoring stop() request\")\n            return\n        self.scheduler.shutdown(wait=True)\n        self.is_running = False\n        logger.info(\n            \"TradingScheduler stopped\",\n            extra={\n                \"event_type\": \"scheduler.stop\",\n                \"environment\": self.environment.value,\n            },\n        )\n\n    def run_once(self) -> Dict[str, float]:\n        \"\"\"Run a single analyze+trade cycle synchronously.\"\"\"\n        return self.analyze_and_trade()\n\n    # ------------------------------------------------------------------\n    # Core execution\n    # ------------------------------------------------------------------\n    def analyze_and_trade(self) -> Dict[str, float]:\n        cycle_start = datetime.utcnow()\n        processed = 0\n        errors = 0\n\n        for symbol in self.config.assets:\n            try:\n                self._process_asset(symbol)\n                processed += 1\n            except DataFetchError as exc:\n                errors += 1\n                logger.warning(\n                    \"Failed to fetch data for %s: %s\",\n                    symbol,\n                    exc,\n                    extra={\n                        \"event_type\": \"scheduler.data_error\",\n                        \"symbol\": symbol,\n                        \"environment\": self.environment.value,\n                    },\n                )\n            except AnalysisError as exc:\n                errors += 1\n                logger.error(\n                    \"Analysis failed for %s: %s\",\n                    symbol,\n                    exc,\n                    extra={\n                        \"event_type\": \"scheduler.analysis_error\",\n                        \"symbol\": symbol,\n                        \"environment\": self.environment.value,\n                    },\n                )\n            except ExecutionError as exc:\n                errors += 1\n                logger.error(\n                    \"Execution failed for %s: %s\",\n                    symbol,\n                    exc,\n                    extra={\n                        \"event_type\": \"scheduler.execution_error\",\n                        \"symbol\": symbol,\n                        \"environment\": self.environment.value,\n                    },\n                )\n            except Exception:  # pragma: no cover - defensive logging\n                errors += 1\n                logger.exception(\n                    \"Unexpected scheduler error for %s\",\n                    symbol,\n                    extra={\n                        \"event_type\": \"scheduler.unexpected_error\",\n                        \"symbol\": symbol,\n                        \"environment\": self.environment.value,\n                    },\n                )\n\n        duration = (datetime.utcnow() - cycle_start).total_seconds()\n        stats = {\n            \"processed\": processed,\n            \"errors\": errors,\n            \"duration_seconds\": duration,\n            \"total\": len(self.config.assets),\n        }\n        self.last_run_stats = stats\n\n        logger.info(\n            \"Analysis cycle completed: %s/%s processed, %s errors (%.2fs)\",\n            processed,\n            len(self.config.assets),\n            errors,\n            duration,\n            extra={\n                \"event_type\": \"scheduler.cycle_complete\",\n                \"environment\": self.environment.value,\n                \"extra_data\": stats,\n            },\n        )\n        return stats\n\n    # ------------------------------------------------------------------\n    # Internals\n    # ------------------------------------------------------------------\n    def _process_asset(self, symbol: str) -> None:\n        df = self._fetch_market_data(symbol)\n        kline_data = format_ohlcv_for_agents(df)\n        current_price = float(df[\"close\"].iloc[-1])\n\n        # NEW: Position monitoring and exit check\n        position = self.position_monitor.get_active_position(symbol)\n        if position:\n            # Calculate prev_close (fallback to current if not enough data)\n            prev_close = (\n                float(df[\"close\"].iloc[-2]) if len(df) >= 2\n                else current_price\n            )\n\n            # Update tracking\n            self.position_monitor.update_candle_tracking(\n                position, current_price, prev_close\n            )\n\n            logger.debug(\n                \"Position tracked: %s (candles=%d)\",\n                symbol, position.candles_since_entry,\n                extra={\n                    \"event_type\": \"scheduler.position_tracked\",\n                    \"symbol\": symbol,\n                    \"environment\": self.environment.value,\n                }\n            )\n\n            # Check exit conditions\n            should_exit, exit_reason = self._check_exit_conditions(\n                position, current_price\n            )\n\n            if should_exit:\n                self._execute_position_exit(\n                    position, exit_reason, current_price, symbol\n                )\n                logger.info(\n                    \"Position exit: %s reason=%s price=%.2f\",\n                    symbol, exit_reason, current_price,\n                    extra={\n                        \"event_type\": \"scheduler.position_exit\",\n                        \"symbol\": symbol,\n                        \"environment\": self.environment.value,\n                        \"extra_data\": {\n                            \"reason\": exit_reason,\n                            \"exit_price\": current_price\n                        }\n                    }\n                )\n                return  # Skip LLM analysis after exit\n\n        thread_id = self._make_thread_id(symbol)\n\n        try:\n            signal = self.strategy.generate_signal(\n                kline_data,\n                symbol,\n                self.config.timeframe,\n                current_price,\n                thread_id=thread_id,\n            )\n        except Exception as exc:  # pragma: no cover - strategy errors\n            raise AnalysisError(str(exc)) from exc\n\n        if signal is None:\n            logger.info(\n                \"No action for %s: signal=HOLD\",\n                symbol,\n                extra={\n                    \"event_type\": \"scheduler.hold\",\n                    \"symbol\": symbol,\n                    \"environment\": self.environment.value,\n                },\n            )\n            return\n\n        trade_signal = self._map_trade_signal(signal)\n        if trade_signal == TradeSignal.NEUTRAL:\n            logger.info(\n                \"No action for %s: signal=HOLD\",\n                symbol,\n                extra={\n                    \"event_type\": \"scheduler.hold\",\n                    \"symbol\": symbol,\n                    \"environment\": self.environment.value,\n                },\n            )\n            return\n\n        db_signal = self._persist_signal(symbol, trade_signal, signal, thread_id)\n\n        try:\n            order = self.order_manager.execute_decision(\n                symbol=symbol,\n                decision=trade_signal,\n                confidence=signal.confidence,\n                current_price=current_price,\n                environment=self.environment,\n                trigger_signal_id=db_signal.id if db_signal else None,\n            )\n        except Exception as exc:\n            self.db.rollback()\n            raise ExecutionError(str(exc)) from exc\n\n        if order:\n            # NEW: Open ActivePosition for tracking\n            # Extract stop loss and take profit from signal (with fallbacks)\n            stop_loss = getattr(signal, 'stop_loss', None) or (\n                current_price * 0.98 if trade_signal == TradeSignal.LONG\n                else current_price * 1.02\n            )\n            take_profit = getattr(signal, 'take_profit', None) or (\n                current_price * 1.04 if trade_signal == TradeSignal.LONG\n                else current_price * 0.96\n            )\n\n            self.position_monitor.open_position(\n                symbol=symbol,\n                side=order.side,\n                entry_price=current_price,\n                stop_loss=stop_loss,\n                take_profit=take_profit,\n                quantity=order.quantity,\n                exit_policy=\"sl_tp_only\",\n                signal_id=db_signal.id if db_signal else None,\n                backtest_run_id=None,\n            )\n\n            logger.info(\n                \"Order executed: %s %s [%s] [entry=%.2f, sl=%.2f, tp=%.2f]\",\n                symbol,\n                trade_signal.value.upper(),\n                self.environment.value,\n                current_price,\n                stop_loss,\n                take_profit,\n                extra={\n                    \"event_type\": \"scheduler.order_executed\",\n                    \"symbol\": symbol,\n                    \"environment\": self.environment.value,\n                    \"extra_data\": {\n                        \"decision\": trade_signal.value,\n                        \"confidence\": signal.confidence,\n                        \"entry_price\": current_price,\n                        \"stop_loss\": stop_loss,\n                        \"take_profit\": take_profit,\n                    },\n                },\n            )\n        else:\n            self.db.commit()\n            logger.info(\n                \"Decision rejected for %s by execution layer\",\n                symbol,\n                extra={\n                    \"event_type\": \"scheduler.order_skipped\",\n                    \"symbol\": symbol,\n                    \"environment\": self.environment.value,\n                },\n            )\n\n    def _fetch_market_data(self, symbol: str) -> pd.DataFrame:\n        end_date = datetime.utcnow()\n        start_date = end_date - timedelta(hours=self.config.lookback_hours)\n        try:\n            df = self.data_provider.get_ohlc(\n                symbol=symbol,\n                timeframe=self.config.timeframe,\n                start_date=start_date,\n                end_date=end_date,\n            )\n        except Exception as exc:  # pragma: no cover - provider errors\n            raise DataFetchError(str(exc)) from exc\n\n        if df.empty:\n            raise DataFetchError(\"no data returned\")\n        if \"close\" not in df.columns:\n            raise DataFetchError(\"missing close column in OHLC data\")\n        return df\n\n    def _persist_signal(\n        self,\n        symbol: str,\n        decision: TradeSignal,\n        signal: StrategyTradingSignal,\n        thread_id: Optional[str],\n    ) -> Signal:\n        record = Signal(\n            symbol=symbol,\n            signal=decision,\n            confidence=signal.confidence,\n            timeframe=self.config.timeframe,\n            analysis_summary=signal.reasoning,\n            generated_at=datetime.utcnow(),\n            environment=self.environment,\n            model_provider=settings.AGENT_LLM_PROVIDER,\n            model_name=settings.AGENT_LLM_MODEL,\n            temperature=settings.AGENT_LLM_TEMPERATURE,\n            thread_id=thread_id,\n            state_snapshot={\n                \"entry_price\": signal.entry_price,\n                \"stop_loss\": signal.stop_loss,\n                \"take_profit\": signal.take_profit,\n                \"trailing_stop_pct\": signal.trailing_stop_pct,\n            },\n        )\n\n        self.db.add(record)\n        self.db.flush()\n        if getattr(record, \"id\", None) is None:\n            self.db.refresh(record)\n        return record\n\n    @staticmethod\n    def _map_trade_signal(signal: StrategyTradingSignal) -> TradeSignal:\n        decision = signal.decision.upper()\n        if decision == \"LONG\":\n            return TradeSignal.LONG\n        if decision == \"SHORT\":\n            return TradeSignal.SHORT\n        return TradeSignal.NEUTRAL\n\n    def _make_thread_id(self, symbol: str) -> str:\n        timestamp = datetime.utcnow().strftime(\"%Y%m%dT%H%M%S\")\n        return f\"scheduler_{symbol}_{timestamp}\"\n\n    def _check_exit_conditions(\n        self, position, current_price: float\n    ) -> tuple[bool, Optional[str]]:\n        \"\"\"\n        Check if position should exit based on stop loss, take profit, or max hold.\n\n        Args:\n            position: ActivePosition instance\n            current_price: Current market price\n\n        Returns:\n            Tuple of (should_exit, exit_reason)\n        \"\"\"\n        from quantagent.models import OrderSide\n\n        # Stop loss check\n        if position.side == OrderSide.BUY:  # LONG position\n            if current_price <= float(position.stop_loss):\n                return (True, \"stop_loss\")\n        else:  # SHORT position\n            if current_price >= float(position.stop_loss):\n                return (True, \"stop_loss\")\n\n        # Take profit check\n        if position.side == OrderSide.BUY:\n            if current_price >= float(position.take_profit):\n                return (True, \"take_profit\")\n        else:\n            if current_price <= float(position.take_profit):\n                return (True, \"take_profit\")\n\n        # Max hold check\n        if position.max_hold_candles:\n            if position.candles_since_entry >= position.max_hold_candles:\n                return (True, \"max_hold\")\n\n        return (False, None)\n\n    def _execute_position_exit(\n        self,\n        position,\n        exit_reason: str,\n        exit_price: float,\n        symbol: str,\n    ) -> None:\n        \"\"\"\n        Execute position exit by closing position and placing exit order.\n\n        Args:\n            position: ActivePosition to close\n            exit_reason: Reason for exit (stop_loss, take_profit, max_hold)\n            exit_price: Price at exit\n            symbol: Trading symbol\n\n        Raises:\n            ExecutionError: If exit order fails\n        \"\"\"\n        from quantagent.models import OrderSide, Trade\n\n        # Determine exit signal (opposite of position)\n        exit_signal = (\n            TradeSignal.SHORT\n            if position.side == OrderSide.BUY\n            else TradeSignal.LONG\n        )\n\n        # Close position in tracking system\n        self.position_monitor.close_position(\n            position, reason=exit_reason, exit_price=exit_price\n        )\n\n        # Execute exit order\n        try:\n            _order = self.order_manager.execute_decision(\n                symbol=symbol,\n                decision=exit_signal,\n                confidence=1.0,  # Exit is mandatory, not confidence-based\n                current_price=exit_price,\n                environment=self.environment,\n                trigger_signal_id=position.signal_id,\n            )\n            # Note: Exit order execution is fire-and-forget in current architecture\n            # OrderManager logs the result internally\n        except Exception as exc:\n            self.db.rollback()\n            logger.error(\n                \"Exit order failed for %s: %s\",\n                symbol,\n                exc,\n                extra={\n                    \"event_type\": \"scheduler.exit_order_error\",\n                    \"symbol\": symbol,\n                    \"environment\": self.environment.value,\n                },\n            )\n            raise ExecutionError(f\"Exit failed: {exc}\") from exc\n\n        # Update Trade record with exit reason\n        if position.trade_id:\n            trade = self.db.query(Trade).filter(Trade.id == position.trade_id).first()\n            if trade:\n                trade.exit_signal = exit_reason\n                trade.closed_at = position.closed_at\n                self.db.commit()\n","numLines":563,"startLine":1,"totalLines":563}}}
