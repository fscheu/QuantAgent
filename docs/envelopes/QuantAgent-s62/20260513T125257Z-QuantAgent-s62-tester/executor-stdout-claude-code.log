{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01LynazaLTv86rps3biFhXXa","type":"tool_result","content":"1\t\"\"\"\n2\tPytest configuration and shared fixtures for QuantAgent testing.\n3\t\n4\tThis module provides pytest fixtures for:\n5\t- Sample OHLCV data (kline_data)\n6\t- Mock LLM configurations (supporting with_structured_output pattern)\n7\t- Agent state objects\n8\t- Mocked API keys\n9\t- Temporary directories for test outputs\n10\t\"\"\"\n11\t\n12\timport importlib.util\n13\timport os\n14\timport sys\n15\timport types\n16\tfrom datetime import datetime\n17\tfrom pathlib import Path\n18\tfrom typing import Dict, List\n19\tfrom unittest.mock import Mock, patch\n20\t\n21\timport numpy as np\n22\timport pandas as pd\n23\timport pytest\n24\t\n25\tfrom quantagent.agent_models import (\n26\t    IndicatorReport,\n27\t    PatternReport,\n28\t    TradingDecision,\n29\t    TrendReport,\n30\t)\n31\t\n32\t\n33\tdef _module_available(module_name: str) -> bool:\n34\t    try:\n35\t        return importlib.util.find_spec(module_name) is not None\n36\t    except (ModuleNotFoundError, ValueError):\n37\t        return False\n38\t\n39\t\n40\tif not _module_available(\"apscheduler.schedulers.background\"):\n41\t    apscheduler = types.ModuleType(\"apscheduler\")\n42\t    schedulers = types.ModuleType(\"apscheduler.schedulers\")\n43\t    background = types.ModuleType(\"apscheduler.schedulers.background\")\n44\t    triggers = types.ModuleType(\"apscheduler.triggers\")\n45\t    interval = types.ModuleType(\"apscheduler.triggers.interval\")\n46\t\n47\t    class SchedulerAlreadyRunningError(Exception):\n48\t        pass\n49\t\n50\t    class JobLookupError(Exception):\n51\t        pass\n52\t\n53\t    class _IntervalValue:\n54\t        def __init__(self, seconds):\n55\t            self._seconds = seconds\n56\t\n57\t        def total_seconds(self):\n58\t            return self._seconds\n59\t\n60\t    class BackgroundScheduler:\n61\t        def __init__(self, *args, **kwargs):\n62\t            self.args = args\n63\t            self.kwargs = kwargs\n64\t            self.running = False\n65\t            self.jobs = {}\n66\t\n67\t        def add_job(self, *args, **kwargs):\n68\t            job_id = kwargs[\"id\"]\n69\t            if job_id in self.jobs and not kwargs.get(\"replace_existing\"):\n70\t                raise ValueError(f\"Job already exists: {job_id}\")\n71\t\n72\t            job = types.SimpleNamespace(\n73\t                id=job_id,\n74\t                trigger=kwargs.get(\"trigger\"),\n75\t                max_instances=kwargs.get(\"max_instances\"),\n76\t            )\n77\t            self.jobs[job_id] = job\n78\t            return job\n79\t\n80\t        def get_job(self, job_id):\n81\t            return self.jobs.get(job_id)\n82\t\n83\t        def remove_job(self, job_id):\n84\t            if job_id not in self.jobs:\n85\t                raise JobLookupError(job_id)\n86\t            del self.jobs[job_id]\n87\t\n88\t        def start(self):\n89\t            if self.running:\n90\t                raise SchedulerAlreadyRunningError()\n91\t            self.running = True\n92\t            return None\n93\t\n94\t        def shutdown(self, wait=True):\n95\t            self.running = False\n96\t            return None\n97\t\n98\t    class IntervalTrigger:\n99\t        def __init__(self, *args, **kwargs):\n100\t            self.args = args\n101\t            self.kwargs = kwargs\n102\t            self.interval = _IntervalValue(kwargs.get(\"seconds\", 0))\n103\t\n104\t    background.BackgroundScheduler = BackgroundScheduler\n105\t    interval.IntervalTrigger = IntervalTrigger\n106\t    schedulers.SchedulerAlreadyRunningError = SchedulerAlreadyRunningError\n107\t    schedulers.JobLookupError = JobLookupError\n108\t    schedulers.background = background\n109\t    triggers.interval = interval\n110\t    apscheduler.schedulers = schedulers\n111\t    apscheduler.triggers = triggers\n112\t\n113\t    sys.modules[\"apscheduler\"] = apscheduler\n114\t    sys.modules[\"apscheduler.schedulers\"] = schedulers\n115\t    sys.modules[\"apscheduler.schedulers.background\"] = background\n116\t    sys.modules[\"apscheduler.triggers\"] = triggers\n117\t    sys.modules[\"apscheduler.triggers.interval\"] = interval\n118\t\n119\t# Stub talib and langchain_anthropic so the strategy import chain doesn't fail\n120\t# in environments where these optional C/LLM packages are unavailable.\n121\tif \"talib\" not in sys.modules:\n122\t    import numpy as _np\n123\t\n124\t    _talib = types.ModuleType(\"talib\")\n125\t\n126\t    def _rsi(data, timeperiod=14):\n127\t        return _np.full(len(data), 50.0)\n128\t\n129\t    def _macd(data, fastperiod=12, slowperiod=26, signalperiod=9):\n130\t        z = _np.zeros(len(data))\n131\t        return z, z, z\n132\t\n133\t    def _stoch(high, low, close, fastk_period=5, slowk_period=3, slowd_period=3):\n134\t        z = _np.full(len(close), 50.0)\n135\t        return z, z\n136\t\n137\t    def _roc(data, timeperiod=12):\n138\t        return _np.zeros(len(data))\n139\t\n140\t    def _willr(high, low, close, timeperiod=14):\n141\t        return _np.full(len(close), -50.0)\n142\t\n143\t    _talib.RSI = _rsi\n144\t    _talib.MACD = _macd\n145\t    _talib.STOCH = _stoch\n146\t    _talib.ROC = _roc\n147\t    _talib.WILLR = _willr\n148\t    sys.modules[\"talib\"] = _talib\n149\t\n150\tfor _pkg, _attrs in [\n151\t    (\"langchain_anthropic\", [\"ChatAnthropic\"]),\n152\t    (\"langchain_openai\", [\"ChatOpenAI\", \"AzureChatOpenAI\"]),\n153\t    (\"langchain_qwq\", [\"ChatQwen\"]),\n154\t]:\n155\t    if _pkg not in sys.modules:\n156\t        _m = types.ModuleType(_pkg)\n157\t        for _attr in _attrs:\n158\t            setattr(_m, _attr, type(_attr, (), {\"__init__\": lambda self, *a, **k: None}))\n159\t        sys.modules[_pkg] = _m\n160\t\n161\tif not _module_available(\"langgraph.graph\"):\n162\t    _langgraph = types.ModuleType(\"langgraph\")\n163\t    _langgraph_graph = types.ModuleType(\"langgraph.graph\")\n164\t    _langgraph_checkpoint = types.ModuleType(\"langgraph.checkpoint\")\n165\t    _langgraph_checkpoint_memory = types.ModuleType(\"langgraph.checkpoint.memory\")\n166\t    _langgraph_graph.END = \"__end__\"\n167\t    _langgraph_graph.START = \"__start__\"\n168\t    _langgraph_graph.add_messages = lambda *a, **k: []\n169\t    _langgraph_graph.StateGraph = type(\"StateGraph\", (), {\n170\t        \"__init__\": lambda self, *a, **k: None,\n171\t        \"add_node\": lambda self, *a, **k: None,\n172\t        \"add_edge\": lambda self, *a, **k: None,\n173\t        \"add_conditional_edges\": lambda self, *a, **k: None,\n174\t        \"compile\": lambda self, *a, **k: None,\n175\t        \"set_entry_point\": lambda self, *a, **k: None,\n176\t    })\n177\t    _langgraph_checkpoint_memory.InMemorySaver = type(\"InMemorySaver\", (), {})\n178\t    _langgraph.graph = _langgraph_graph\n179\t    _langgraph.checkpoint = _langgraph_checkpoint\n180\t    _langgraph_checkpoint.memory = _langgraph_checkpoint_memory\n181\t    sys.modules[\"langgraph\"] = _langgraph\n182\t    sys.modules[\"langgraph.graph\"] = _langgraph_graph\n183\t    sys.modules[\"langgraph.checkpoint\"] = _langgraph_checkpoint\n184\t    sys.modules[\"langgraph.checkpoint.memory\"] = _langgraph_checkpoint_memory\n185\t\n186\tif not _module_available(\"tabulate\"):\n187\t    _tabulate = types.ModuleType(\"tabulate\")\n188\t\n189\t    def tabulate(rows, headers=(), tablefmt=None):\n190\t        lines = []\n191\t        if headers:\n192\t            lines.append(\" | \".join(str(header) for header in headers))\n193\t        lines.extend(\" | \".join(str(cell) for cell in row) for row in rows)\n194\t        return \"\\n\".join(lines)\n195\t\n196\t    _tabulate.tabulate = tabulate\n197\t    sys.modules[\"tabulate\"] = _tabulate\n198\t\n199\t# ============================================================================\n200\t# Data Fixtures\n201\t# ============================================================================\n202\t\n203\t\n204\t@pytest.fixture\n205\tdef sample_ohlcv_data() -> Dict[str, List[float]]:\n206\t    \"\"\"\n207\t    Provide sample OHLCV data for testing.\n208\t\n209\t    Returns:\n210\t        Dictionary with 'open', 'high', 'low', 'close', 'volume' keys\n211\t        containing 30 candlesticks of realistic price data.\n212\t    \"\"\"\n213\t    np.random.seed(42)\n214\t    num_candles = 30\n215\t\n216\t    # Generate realistic price movements\n217\t    prices = np.cumsum(np.random.randn(num_candles)) + 100\n218\t\n219\t    return {\n220\t        \"open\": [float(p) for p in prices],\n221\t        \"high\": [float(p + abs(np.random.randn())) for p in prices],\n222\t        \"low\": [float(p - abs(np.random.randn())) for p in prices],\n223\t        \"close\": [float(p + np.random.randn() * 0.5) for p in prices],\n224\t        \"volume\": [\n225\t            float(1000000 + np.random.randint(-100000, 100000))\n226\t            for _ in range(num_candles)\n227\t        ],\n228\t    }\n229\t\n230\t\n231\t@pytest.fixture\n232\tdef sample_ohlcv_dataframe(sample_ohlcv_data) -> pd.DataFrame:\n233\t    \"\"\"\n234\t    Provide sample OHLCV data as a pandas DataFrame.\n235\t\n236\t    Returns:\n237\t        DataFrame with datetime index and OHLCV columns.\n238\t    \"\"\"\n239\t    df = pd.DataFrame(sample_ohlcv_data)\n240\t    df.index = pd.date_range(end=datetime.now(), periods=len(df), freq=\"1h\")\n241\t    df.index.name = \"datetime\"\n242\t    return df\n243\t\n244\t\n245\t@pytest.fixture\n246\tdef sample_state_inicial() -> Dict:\n247\t    return {\n248\t        \"kline_data\": {\n249\t            \"open\": [100.0] * 30,\n250\t            \"high\": [101.0] * 30,\n251\t            \"low\": [99.0] * 30,\n252\t            \"close\": [100.5] * 30,\n253\t            \"volume\": [1000000.0] * 30,\n254\t        },\n255\t        \"analysis_results\": None,\n256\t        \"messages\": [],\n257\t        \"time_frame\": \"1hour\",\n258\t        \"stock_name\": \"BTC\",\n259\t        \"pattern_image\": \"base64_encoded_image_data\",\n260\t        \"trend_image\": \"base64_encoded_image_data\",\n261\t    }\n262\t\n263\t\n264\t@pytest.fixture\n265\tdef sample_state() -> Dict:\n266\t    \"\"\"\n267\t    Provide a minimal valid IndicatorAgentState for testing.\n268\t\n269\t    Returns:\n270\t        Dictionary matching IndicatorAgentState structure with sample data.\n271\t    \"\"\"\n272\t    return {\n273\t        \"kline_data\": {\n274\t            \"open\": [100.0] * 30,\n275\t            \"high\": [101.0] * 30,\n276\t            \"low\": [99.0] * 30,\n277\t            \"close\": [100.5] * 30,\n278\t            \"volume\": [1000000.0] * 30,\n279\t        },\n280\t        \"time_frame\": \"1hour\",\n281\t        \"stock_name\": \"BTC\",\n282\t        \"rsi\": [50.0] * 30,\n283\t        \"macd\": [0.0] * 30,\n284\t        \"macd_signal\": [0.0] * 30,\n285\t        \"macd_hist\": [0.0] * 30,\n286\t        \"stoch_k\": [50.0] * 30,\n287\t        \"stoch_d\": [50.0] * 30,\n288\t        \"roc\": [0.0] * 30,\n289\t        \"willr\": [-50.0] * 30,\n290\t        \"indicator_report\": \"Sample indicator report\",\n291\t        \"pattern_image\": \"base64_encoded_image_data\",\n292\t        \"pattern_image_filename\": \"/tmp/pattern.png\",\n293\t        \"pattern_image_description\": \"Sample pattern description\",\n294\t        \"pattern_report\": \"Sample pattern report\",\n295\t        \"trend_image\": \"base64_encoded_image_data\",\n296\t        \"trend_image_filename\": \"/tmp/trend.png\",\n297\t        \"trend_image_description\": \"Sample trend description\",\n298\t        \"trend_report\": \"Sample trend report\",\n299\t        \"analysis_results\": None,\n300\t        \"messages\": [],\n301\t        \"decision_prompt\": \"Sample decision prompt\",\n302\t        \"final_trade_decision\": \"\",\n303\t    }\n304\t\n305\t\n306\t# ============================================================================\n307\t# Configuration Fixtures\n308\t# ============================================================================\n309\t\n310\t\n311\t@pytest.fixture\n312\tdef mock_config() -> Dict:\n313\t    \"\"\"\n314\t    Provide mock LLM configuration for testing.\n315\t\n316\t    Returns:\n317\t        Dictionary with mock API keys and model settings.\n318\t    \"\"\"\n319\t    return {\n320\t        \"agent_llm_model\": \"gpt-4o-mini\",\n321\t        \"graph_llm_model\": \"gpt-4o\",\n322\t        \"agent_llm_provider\": \"openai\",\n323\t        \"graph_llm_provider\": \"openai\",\n324\t        \"agent_llm_temperature\": 0.1,\n325\t        \"graph_llm_temperature\": 0.1,\n326\t        \"api_key\": \"sk-test-key-12345\",\n327\t        \"anthropic_api_key\": \"sk-ant-test-key\",\n328\t        \"qwen_api_key\": \"sk-qwen-test-key\",\n329\t    }\n330\t\n331\t\n332\t@pytest.fixture\n333\tdef mock_env_vars(monkeypatch):\n334\t    \"\"\"\n335\t    Set up mock environment variables for testing.\n336\t\n337\t    Args:\n338\t        monkeypatch: pytest's monkeypatch fixture.\n339\t    \"\"\"\n340\t    monkeypatch.setenv(\"OPENAI_API_KEY\", \"sk-test-openai-key\")\n341\t    monkeypatch.setenv(\"ANTHROPIC_API_KEY\", \"sk-ant-test-key\")\n342\t    monkeypatch.setenv(\"DASHSCOPE_API_KEY\", \"sk-qwen-test-key\")\n343\t\n344\t\n345\t@pytest.fixture(autouse=True)\n346\tdef ensure_default_llm_api_keys(monkeypatch):\n347\t    \"\"\"Provide deterministic fallback API keys so CI can run without secrets.\"\"\"\n348\t\n349\t    from quantagent import settings as qa_settings\n350\t\n351\t    defaults = {\n352\t        \"OPENAI_API_KEY\": \"sk-test-openai-key\",\n353\t        \"ANTHROPIC_API_KEY\": \"sk-ant-test-key\",\n354\t        \"DASHSCOPE_API_KEY\": \"sk-qwen-test-key\",\n355\t    }\n356\t\n357\t    for key, value in defaults.items():\n358\t        current = os.environ.get(key)\n359\t        if not current:\n360\t            current = value\n361\t            monkeypatch.setenv(key, current)\n362\t        monkeypatch.setattr(qa_settings, key, current, raising=False)\n363\t\n364\t\n365\t# ============================================================================\n366\t# LLM Mock Fixtures\n367\t# ============================================================================\n368\t\n369\t\n370\tclass StructuredMockLLM:\n371\t    \"\"\"\n372\t    Mock LLM supporting modern LangChain patterns.\n373\t\n374\t    Supports both legacy invoke() and modern with_structured_output() patterns.\n375\t    Returns actual Pydantic model instances when used with structured output.\n376\t    \"\"\"\n377\t\n378\t    def __init__(self, default_overrides=None):\n379\t        \"\"\"Initialize with optional field overrides.\"\"\"\n380\t        self.default_overrides = default_overrides or {}\n381\t\n382\t    def invoke(self, messages):\n383\t        return \"Mock LLM response\"\n384\t\n385\t    def with_structured_output(self, schema):\n386\t        \"\"\"\n387\t        Modern pattern: return mock LLM that produces Pydantic instances.\n388\t\n389\t        Args:\n390\t            schema: Pydantic model class (IndicatorReport, PatternReport, etc.)\n391\t\n392\t        Returns:\n393\t            Mock LLM with invoke() that returns schema instance\n394\t        \"\"\"\n395\t        structured_mock = Mock()\n396\t\n397\t        # Create default values based on schema type\n398\t        if schema == IndicatorReport:\n399\t            defaults = {\n400\t                \"macd\": 0.5,\n401\t                \"macd_signal\": 0.3,\n402\t                \"macd_histogram\": 0.2,\n403\t                \"rsi\": 65.0,\n404\t                \"rsi_level\": \"overbought\",\n405\t                \"roc\": 2.5,\n406\t                \"stochastic\": 75.0,\n407\t                \"willr\": -25.0,\n408\t                \"trend_direction\": \"bullish\",\n409\t                \"confidence\": 0.75,\n410\t                \"reasoning\": \"Mock indicator analysis\",\n411\t            }\n412\t        elif schema == PatternReport:\n413\t            defaults = {\n414\t                \"patterns_detected\": [\"double_bottom\"],\n415\t                \"primary_pattern\": \"double_bottom\",\n416\t                \"confidence\": 0.75,\n417\t                \"breakout_probability\": 0.65,\n418\t                \"reasoning\": \"Mock pattern detected\",\n419\t            }\n420\t        elif schema == TrendReport:\n421\t            defaults = {\n422\t                \"support_level\": 99.5,\n423\t                \"resistance_level\": 101.5,\n424\t                \"trend_direction\": \"upward\",\n425\t                \"trend_strength\": 0.75,\n426\t                \"reasoning\": \"Mock trend analysis\",\n427\t            }\n428\t        elif schema == TradingDecision:\n429\t            defaults = {\n430\t                \"decision\": \"LONG\",\n431\t                \"entry_price\": 100.5,\n432\t                \"take_profit\": 102.5,\n433\t                \"stop_loss\": 98.5,\n434\t                \"confidence\": 0.75,\n435\t                \"risk_level\": \"medium\",\n436\t                \"reasoning\": \"Mock trading decision\",\n437\t            }\n438\t        else:\n439\t            defaults = {}\n440\t\n441\t        # Merge with custom overrides\n442\t        defaults.update(self.default_overrides)\n443\t\n444\t        # Create Pydantic instance\n445\t        instance = schema(**defaults)\n446\t        structured_mock.invoke = Mock(return_value=instance)\n447\t\n448\t        return structured_mock\n449\t\n450\t    def bind_tools(self, tools):\n451\t        \"\"\"Mock tool binding.\"\"\"\n452\t        return self\n453\t\n454\t\n455\t@pytest.fixture(autouse=True)\n456\tdef patch_trading_graph_llms(monkeypatch):\n457\t    \"\"\"Use deterministic mock LLMs for TradingGraph tests.\"\"\"\n458\t\n459\t    import quantagent.trading_graph as trading_graph_module\n460\t\n461\t    def mock_create_llm(self, provider, model, temperature):\n462\t        return StructuredMockLLM()\n463\t\n464\t    monkeypatch.setattr(\n465\t        trading_graph_module.TradingGraph,\n466\t        \"_create_llm\",\n467\t        mock_create_llm,\n468\t    )\n469\t\n470\t    # Some tests reload quantagent.trading_graph, which can leave previously\n471\t    # imported `TradingGraph` aliases in test modules pointing at a stale class.\n472\t    # Rebind those aliases to the current module class so the mock patch remains\n473\t    # effective across the suite.\n474\t    for module in tuple(sys.modules.values()):\n475\t        if module is None or not getattr(module, \"__name__\", \"\").startswith(\"tests.\"):\n476\t            continue\n477\t\n478\t        trading_graph_alias = getattr(module, \"TradingGraph\", None)\n479\t        if getattr(trading_graph_alias, \"__module__\", None) != \"quantagent.trading_graph\":\n480\t            continue\n481\t\n482\t        monkeypatch.setattr(\n483\t            module,\n484\t            \"TradingGraph\",\n485\t            trading_graph_module.TradingGraph,\n486\t            raising=False,\n487\t        )\n488\t\n489\t\n490\t@pytest.fixture\n491\tdef mock_llm():\n492\t    \"\"\"\n493\t    Provide a StructuredMockLLM for agent testing.\n494\t\n495\t    Supports both legacy and modern patterns.\n496\t    \"\"\"\n497\t    return StructuredMockLLM()\n498\t\n499\t\n500\t@pytest.fixture\n501\tdef mock_llm_custom():\n502\t    \"\"\"\n503\t    Factory fixture for creating StructuredMockLLM with custom field values.\n504\t\n505\t    Usage:\n506\t        def test_something(mock_llm_custom):\n507\t            llm = mock_llm_custom({\"confidence\": 0.9, \"trend_direction\": \"bearish\"})\n508\t    \"\"\"\n509\t\n510\t    def create_with_overrides(overrides):\n511\t        return StructuredMockLLM(default_overrides=overrides)\n512\t\n513\t    return create_with_overrides\n514\t\n515\t\n516\t@pytest.fixture\n517\tdef mock_openai_llm():\n518\t    \"\"\"\n519\t    Provide a mock OpenAI LLM for testing.\n520\t\n521\t    Returns:\n522\t        StructuredMockLLM object configured like OpenAI LLM.\n523\t    \"\"\"\n524\t    return StructuredMockLLM()\n525\t\n526\t\n527\t@pytest.fixture\n528\tdef mock_anthropic_llm():\n529\t    \"\"\"\n530\t    Provide a mock Anthropic LLM for testing.\n531\t\n532\t    Returns:\n533\t        StructuredMockLLM object configured like Anthropic LLM.\n534\t    \"\"\"\n535\t    return StructuredMockLLM()\n536\t\n537\t\n538\t@pytest.fixture\n539\tdef mock_vision_llm():\n540\t    \"\"\"\n541\t    Provide a mock vision-capable LLM for pattern/trend analysis.\n542\t\n543\t    Returns:\n544\t        StructuredMockLLM object configured for vision tasks.\n545\t    \"\"\"\n546\t    return StructuredMockLLM()\n547\t\n548\t\n549\t# ============================================================================\n550\t# Toolkit Mock Fixtures\n551\t# ============================================================================\n552\t\n553\t\n554\tclass MockToolkit:\n555\t    \"\"\"Mock toolkit with indicator and chart generation functions.\"\"\"\n556\t\n557\t    def __init__(self):\n558\t        \"\"\"Initialize all tool mocks with default return values.\"\"\"\n559\t        self.compute_macd = Mock(name=\"compute_macd\")\n560\t        self.compute_rsi = Mock(name=\"compute_rsi\")\n561\t        self.compute_roc = Mock(name=\"compute_roc\")\n562\t        self.compute_stoch = Mock(name=\"compute_stoch\")\n563\t        self.compute_willr = Mock(name=\"compute_willr\")\n564\t\n565\t        # Setup default return values for tool invocation\n566\t        self.compute_macd.invoke = Mock(\n567\t            return_value={\"macd\": 0.5, \"signal\": 0.3, \"histogram\": 0.2}\n568\t        )\n569\t        self.compute_rsi.invoke = Mock(return_value={\"rsi\": 65.0})\n570\t        self.compute_roc.invoke = Mock(return_value={\"roc\": 2.5})\n571\t        self.compute_stoch.invoke = Mock(return_value={\"stochastic\": 75.0})\n572\t        self.compute_willr.invoke = Mock(return_value={\"willr\": -25.0})\n573\t        self.generate_kline_image = Mock(name=\"generate_kline_image\")\n574\t        self.generate_kline_image.invoke = Mock(\n575\t            return_value={\"pattern_image\": \"mock_b64_encoded_png_pattern\"}\n576\t        )\n577\t        self.generate_trend_image = Mock(name=\"generate_trend_image\")\n578\t        self.generate_trend_image.invoke = Mock(\n579\t            return_value={\"trend_image\": \"mock_b64_encoded_png_trend\"}\n580\t        )\n581\t\n582\t    # def generate_kline_image(self):\n583\t    #     \"\"\"Mock K-line image generation tool.\"\"\"\n584\t    #     mock_tool = Mock()\n585\t    #     mock_tool.invoke = Mock(return_value={\n586\t    #         \"pattern_image\": \"mock_b64_encoded_png_pattern\"\n587\t    #     })\n588\t    #     return mock_tool\n589\t\n590\t    # def generate_trend_image(self):\n591\t    #     \"\"\"Mock trend image generation tool.\"\"\"\n592\t    #     mock_tool = Mock()\n593\t    #     mock_tool.invoke = Mock(return_value={\n594\t    #         \"trend_image\": \"mock_b64_encoded_png_trend\"\n595\t    #     })\n596\t    #     return mock_tool\n597\t\n598\t\n599\t@pytest.fixture\n600\tdef mock_toolkit():\n601\t    \"\"\"\n602\t    Provide a MockToolkit with all indicator and chart functions.\n603\t\n604\t    Used by indicator_agent, pattern_agent, and trend_agent tests.\n605\t    \"\"\"\n606\t    return MockToolkit()\n607\t\n608\t\n609\t# ============================================================================\n610\t# Temporary Directory Fixtures\n611\t# ============================================================================\n612\t\n613\t\n614\t@pytest.fixture\n615\tdef temp_output_dir(tmp_path) -> Path:\n616\t    \"\"\"\n617\t    Provide a temporary directory for test outputs.\n618\t\n619\t    Args:\n620\t        tmp_path: pytest's tmp_path fixture.\n621\t\n622\t    Returns:\n623\t        Path object pointing to temporary output directory.\n624\t    \"\"\"\n625\t    output_dir = tmp_path / \"output\"\n626\t    output_dir.mkdir()\n627\t    return output_dir\n628\t\n629\t\n630\t@pytest.fixture\n631\tdef temp_chart_dir(tmp_path) -> Path:\n632\t    \"\"\"\n633\t    Provide a temporary directory for chart outputs.\n634\t\n635\t    Args:\n636\t        tmp_path: pytest's tmp_path fixture.\n637\t\n638\t    Returns:\n639\t        Path object pointing to temporary chart directory.\n640\t    \"\"\"\n641\t    chart_dir = tmp_path / \"charts\"\n642\t    chart_dir.mkdir()\n643\t    return chart_dir\n644\t\n645\t\n646\t# ============================================================================\n647\t# Mocking Utilities\n648\t# ============================================================================\n649\t\n650\t\n651\t@pytest.fixture\n652\tdef patch_yfinance():\n653\t    \"\"\"\n654\t    Patch yfinance to avoid real API calls during testing.\n655\t\n656\t    Yields:\n657\t        MagicMock configured to return sample OHLCV data.\n658\t    \"\"\"\n659\t    with patch(\"yfinance.download\") as mock_download:\n660\t        # Create sample dataframe\n661\t        dates = pd.date_range(end=datetime.now(), periods=30, freq=\"1h\")\n662\t        mock_df = pd.DataFrame(\n663\t            {\n664\t                \"Open\": np.linspace(100, 105, 30),\n665\t                \"High\": np.linspace(101, 106, 30),\n666\t                \"Low\": np.linspace(99, 104, 30),\n667\t                \"Close\": np.linspace(100.5, 105.5, 30),\n668\t                \"Volume\": [1000000] * 30,\n669\t            },\n670\t            index=dates,\n671\t        )\n672\t\n673\t        mock_download.return_value = mock_df\n674\t        yield mock_download\n675\t\n676\t\n677\t@pytest.fixture\n678\tdef patch_talib():\n679\t    \"\"\"\n680\t    Patch TA-Lib functions to avoid errors during testing without TA-Lib.\n681\t\n682\t    Yields:\n683\t        Dictionary of mocked indicator functions.\n684\t    \"\"\"\n685\t    mocked_indicators = {\n686\t        \"RSI\": lambda data, period=14: np.array([50.0] * len(data)),\n687\t        \"MACD\": lambda data, fastperiod=12, slowperiod=26, signalperiod=9: (\n688\t            np.array([0.0] * len(data)),\n689\t            np.array([0.0] * len(data)),\n690\t            np.array([0.0] * len(data)),\n691\t        ),\n692\t        \"STOCH\": lambda high, low, close, fastk_period=5, slowk_period=3, slowd_period=3: (\n693\t            np.array([50.0] * len(close)),\n694\t            np.array([50.0] * len(close)),\n695\t        ),\n696\t        \"ROC\": lambda data, period=12: np.array([0.0] * len(data)),\n697\t        \"WILLR\": lambda high, low, close, period=14: np.array([-50.0] * len(close)),\n698\t    }\n699\t\n700\t    with (\n701\t        patch(\"talib.RSI\", side_effect=mocked_indicators[\"RSI\"]),\n702\t        patch(\"talib.MACD\", side_effect=mocked_indicators[\"MACD\"]),\n703\t        patch(\"talib.STOCH\", side_effect=mocked_indicators[\"STOCH\"]),\n704\t        patch(\"talib.ROC\", side_effect=mocked_indicators[\"ROC\"]),\n705\t        patch(\"talib.WILLR\", side_effect=mocked_indicators[\"WILLR\"]),\n706\t    ):\n707\t        yield mocked_indicators\n708\t\n709\t\n710\t# ============================================================================\n711\t# Session-scoped Fixtures\n712\t# ============================================================================\n713\t\n714\t\n715\t@pytest.fixture(scope=\"session\")\n716\tdef project_root() -> Path:\n717\t    \"\"\"\n718\t    Provide the project root directory path.\n719\t\n720\t    Returns:\n721\t        Path object pointing to the project root.\n722\t    \"\"\"\n723\t    return Path(__file__).parent.parent\n724\t\n725\t\n726\t@pytest.fixture(scope=\"session\")\n727\tdef benchmark_data_dir(project_root) -> Path:\n728\t    \"\"\"\n729\t    Provide path to benchmark data directory.\n730\t\n731\t    Returns:\n732\t        Path object pointing to benchmark/ directory.\n733\t    \"\"\"\n734\t    benchmark_dir = project_root / \"benchmark\"\n735\t    if not benchmark_dir.exists():\n736\t        pytest.skip(\"Benchmark data directory not found\")\n737\t    return benchmark_dir\n738\t\n739\t\n740\t# ============================================================================\n741\t# Pytest Configuration Hooks\n742\t# ============================================================================\n743\t\n744\t\n745\tdef pytest_configure(config):\n746\t    \"\"\"\n747\t    Configure pytest with custom markers and settings.\n748\t\n749\t    Args:\n750\t        config: pytest Config object.\n751\t    \"\"\"\n752\t    config.addinivalue_line(\n753\t        \"markers\", \"slow: marks tests as slow (deselect with '-m \\\"not slow\\\"')\"\n754\t    )\n755\t    config.addinivalue_line(\"markers\", \"integration: marks tests as integration tests\")\n756\t    config.addinivalue_line(\"markers\", \"api: marks tests requiring API calls\")\n757\t    config.addinivalue_line(\"markers\", \"vision: marks tests using vision-capable LLMs\")\n758\t\n759\t\n760\tdef pytest_collection_modifyitems(config, items):\n761\t    \"\"\"\n762\t    Modify test collection to apply default markers.\n763\t\n764\t    Args:\n765\t        config: pytest Config object.\n766\t        items: List of test items.\n767\t    \"\"\"\n768\t    for item in items:\n769\t        # Mark tests with 'integration' in the name\n770\t        if \"integration\" in item.nodeid:\n771\t            item.add_marker(pytest.mark.integration)\n772\t\n773\t        # Mark tests with 'api' in the name\n774\t        if \"api\" in item.nodeid:\n775\t            item.add_marker(pytest.mark.api)\n776\t\n777\t        # Mark tests with 'vision' in the name\n778\t        if \"vision\" in item.nodeid:\n779\t            item.add_marker(pytest.mark.vision)\n780\t\n781\t\n782\t# ============================================================================\n783\t# Database Fixtures\n784\t# ============================================================================\n785\t\n786\t\n787\t@pytest.fixture\n788\tdef db_session():\n789\t    \"\"\"\n790\t    Provide isolated SQLite database session for testing.\n791\t\n792\t    Creates an in-memory SQLite database, runs migrations to create all tables,\n793\t    and yields a session for test use. Automatically cleans up after each test.\n794\t\n795\t    Yields:\n796\t        SQLAlchemy Session connected to in-memory SQLite database.\n797\t\n798\t    Note:\n799\t        Foreign key constraints are enabled via SQLite PRAGMA.\n800\t    \"\"\"\n801\t    from sqlalchemy import create_engine, event, text\n802\t    from sqlalchemy.orm import sessionmaker\n803\t\n804\t    from quantagent.models import Base\n805\t\n806\t    # Create in-memory SQLite engine\n807\t    test_engine = create_engine(\"sqlite:///:memory:\", echo=False)\n808\t\n809\t    # Enable foreign key constraints (SQLite disables by default)\n810\t    @event.listens_for(test_engine, \"connect\")\n811\t    def set_sqlite_pragma(dbapi_conn, connection_record):\n812\t        cursor = dbapi_conn.cursor()\n813\t        cursor.execute(\"PRAGMA foreign_keys=ON\")\n814\t        cursor.close()\n815\t\n816\t    # Create all tables\n817\t    Base.metadata.create_all(test_engine)\n818\t\n819\t    # Create session\n820\t    TestSession = sessionmaker(bind=test_engine)\n821\t    session = TestSession()\n822\t\n823\t    yield session\n824\t\n825\t    # Cleanup\n826\t    session.close()\n827\t    # Disable foreign keys temporarily for cleanup\n828\t    with test_engine.connect() as conn:\n829\t        conn.execute(text(\"PRAGMA foreign_keys=OFF\"))\n830\t        conn.commit()\n831\t    Base.metadata.drop_all(test_engine)\n832\t    test_engine.dispose()\n833\t"}]},"parent_tool_use_id":null,"session_id":"e886872b-4bb6-48e1-bec6-42e1776647f7","uuid":"c98b8da8-9297-4a2c-bc50-35d92ac55735","timestamp":"2026-05-13T12:53:49.886Z","tool_use_result":{"type":"text","file":{"filePath":"/mnt/actions-runner/autodev-runtime/worktrees/QuantAgent/QuantAgent-s62/implementer-20260513T124414Z/tests/conftest.py","content":"\"\"\"\nPytest configuration and shared fixtures for QuantAgent testing.\n\nThis module provides pytest fixtures for:\n- Sample OHLCV data (kline_data)\n- Mock LLM configurations (supporting with_structured_output pattern)\n- Agent state objects\n- Mocked API keys\n- Temporary directories for test outputs\n\"\"\"\n\nimport importlib.util\nimport os\nimport sys\nimport types\nfrom datetime import datetime\nfrom pathlib import Path\nfrom typing import Dict, List\nfrom unittest.mock import Mock, patch\n\nimport numpy as np\nimport pandas as pd\nimport pytest\n\nfrom quantagent.agent_models import (\n    IndicatorReport,\n    PatternReport,\n    TradingDecision,\n    TrendReport,\n)\n\n\ndef _module_available(module_name: str) -> bool:\n    try:\n        return importlib.util.find_spec(module_name) is not None\n    except (ModuleNotFoundError, ValueError):\n        return False\n\n\nif not _module_available(\"apscheduler.schedulers.background\"):\n    apscheduler = types.ModuleType(\"apscheduler\")\n    schedulers = types.ModuleType(\"apscheduler.schedulers\")\n    background = types.ModuleType(\"apscheduler.schedulers.background\")\n    triggers = types.ModuleType(\"apscheduler.triggers\")\n    interval = types.ModuleType(\"apscheduler.triggers.interval\")\n\n    class SchedulerAlreadyRunningError(Exception):\n        pass\n\n    class JobLookupError(Exception):\n        pass\n\n    class _IntervalValue:\n        def __init__(self, seconds):\n            self._seconds = seconds\n\n        def total_seconds(self):\n            return self._seconds\n\n    class BackgroundScheduler:\n        def __init__(self, *args, **kwargs):\n            self.args = args\n            self.kwargs = kwargs\n            self.running = False\n            self.jobs = {}\n\n        def add_job(self, *args, **kwargs):\n            job_id = kwargs[\"id\"]\n            if job_id in self.jobs and not kwargs.get(\"replace_existing\"):\n                raise ValueError(f\"Job already exists: {job_id}\")\n\n            job = types.SimpleNamespace(\n                id=job_id,\n                trigger=kwargs.get(\"trigger\"),\n                max_instances=kwargs.get(\"max_instances\"),\n            )\n            self.jobs[job_id] = job\n            return job\n\n        def get_job(self, job_id):\n            return self.jobs.get(job_id)\n\n        def remove_job(self, job_id):\n            if job_id not in self.jobs:\n                raise JobLookupError(job_id)\n            del self.jobs[job_id]\n\n        def start(self):\n            if self.running:\n                raise SchedulerAlreadyRunningError()\n            self.running = True\n            return None\n\n        def shutdown(self, wait=True):\n            self.running = False\n            return None\n\n    class IntervalTrigger:\n        def __init__(self, *args, **kwargs):\n            self.args = args\n            self.kwargs = kwargs\n            self.interval = _IntervalValue(kwargs.get(\"seconds\", 0))\n\n    background.BackgroundScheduler = BackgroundScheduler\n    interval.IntervalTrigger = IntervalTrigger\n    schedulers.SchedulerAlreadyRunningError = SchedulerAlreadyRunningError\n    schedulers.JobLookupError = JobLookupError\n    schedulers.background = background\n    triggers.interval = interval\n    apscheduler.schedulers = schedulers\n    apscheduler.triggers = triggers\n\n    sys.modules[\"apscheduler\"] = apscheduler\n    sys.modules[\"apscheduler.schedulers\"] = schedulers\n    sys.modules[\"apscheduler.schedulers.background\"] = background\n    sys.modules[\"apscheduler.triggers\"] = triggers\n    sys.modules[\"apscheduler.triggers.interval\"] = interval\n\n# Stub talib and langchain_anthropic so the strategy import chain doesn't fail\n# in environments where these optional C/LLM packages are unavailable.\nif \"talib\" not in sys.modules:\n    import numpy as _np\n\n    _talib = types.ModuleType(\"talib\")\n\n    def _rsi(data, timeperiod=14):\n        return _np.full(len(data), 50.0)\n\n    def _macd(data, fastperiod=12, slowperiod=26, signalperiod=9):\n        z = _np.zeros(len(data))\n        return z, z, z\n\n    def _stoch(high, low, close, fastk_period=5, slowk_period=3, slowd_period=3):\n        z = _np.full(len(close), 50.0)\n        return z, z\n\n    def _roc(data, timeperiod=12):\n        return _np.zeros(len(data))\n\n    def _willr(high, low, close, timeperiod=14):\n        return _np.full(len(close), -50.0)\n\n    _talib.RSI = _rsi\n    _talib.MACD = _macd\n    _talib.STOCH = _stoch\n    _talib.ROC = _roc\n    _talib.WILLR = _willr\n    sys.modules[\"talib\"] = _talib\n\nfor _pkg, _attrs in [\n    (\"langchain_anthropic\", [\"ChatAnthropic\"]),\n    (\"langchain_openai\", [\"ChatOpenAI\", \"AzureChatOpenAI\"]),\n    (\"langchain_qwq\", [\"ChatQwen\"]),\n]:\n    if _pkg not in sys.modules:\n        _m = types.ModuleType(_pkg)\n        for _attr in _attrs:\n            setattr(_m, _attr, type(_attr, (), {\"__init__\": lambda self, *a, **k: None}))\n        sys.modules[_pkg] = _m\n\nif not _module_available(\"langgraph.graph\"):\n    _langgraph = types.ModuleType(\"langgraph\")\n    _langgraph_graph = types.ModuleType(\"langgraph.graph\")\n    _langgraph_checkpoint = types.ModuleType(\"langgraph.checkpoint\")\n    _langgraph_checkpoint_memory = types.ModuleType(\"langgraph.checkpoint.memory\")\n    _langgraph_graph.END = \"__end__\"\n    _langgraph_graph.START = \"__start__\"\n    _langgraph_graph.add_messages = lambda *a, **k: []\n    _langgraph_graph.StateGraph = type(\"StateGraph\", (), {\n        \"__init__\": lambda self, *a, **k: None,\n        \"add_node\": lambda self, *a, **k: None,\n        \"add_edge\": lambda self, *a, **k: None,\n        \"add_conditional_edges\": lambda self, *a, **k: None,\n        \"compile\": lambda self, *a, **k: None,\n        \"set_entry_point\": lambda self, *a, **k: None,\n    })\n    _langgraph_checkpoint_memory.InMemorySaver = type(\"InMemorySaver\", (), {})\n    _langgraph.graph = _langgraph_graph\n    _langgraph.checkpoint = _langgraph_checkpoint\n    _langgraph_checkpoint.memory = _langgraph_checkpoint_memory\n    sys.modules[\"langgraph\"] = _langgraph\n    sys.modules[\"langgraph.graph\"] = _langgraph_graph\n    sys.modules[\"langgraph.checkpoint\"] = _langgraph_checkpoint\n    sys.modules[\"langgraph.checkpoint.memory\"] = _langgraph_checkpoint_memory\n\nif not _module_available(\"tabulate\"):\n    _tabulate = types.ModuleType(\"tabulate\")\n\n    def tabulate(rows, headers=(), tablefmt=None):\n        lines = []\n        if headers:\n            lines.append(\" | \".join(str(header) for header in headers))\n        lines.extend(\" | \".join(str(cell) for cell in row) for row in rows)\n        return \"\\n\".join(lines)\n\n    _tabulate.tabulate = tabulate\n    sys.modules[\"tabulate\"] = _tabulate\n\n# ============================================================================\n# Data Fixtures\n# ============================================================================\n\n\n@pytest.fixture\ndef sample_ohlcv_data() -> Dict[str, List[float]]:\n    \"\"\"\n    Provide sample OHLCV data for testing.\n\n    Returns:\n        Dictionary with 'open', 'high', 'low', 'close', 'volume' keys\n        containing 30 candlesticks of realistic price data.\n    \"\"\"\n    np.random.seed(42)\n    num_candles = 30\n\n    # Generate realistic price movements\n    prices = np.cumsum(np.random.randn(num_candles)) + 100\n\n    return {\n        \"open\": [float(p) for p in prices],\n        \"high\": [float(p + abs(np.random.randn())) for p in prices],\n        \"low\": [float(p - abs(np.random.randn())) for p in prices],\n        \"close\": [float(p + np.random.randn() * 0.5) for p in prices],\n        \"volume\": [\n            float(1000000 + np.random.randint(-100000, 100000))\n            for _ in range(num_candles)\n        ],\n    }\n\n\n@pytest.fixture\ndef sample_ohlcv_dataframe(sample_ohlcv_data) -> pd.DataFrame:\n    \"\"\"\n    Provide sample OHLCV data as a pandas DataFrame.\n\n    Returns:\n        DataFrame with datetime index and OHLCV columns.\n    \"\"\"\n    df = pd.DataFrame(sample_ohlcv_data)\n    df.index = pd.date_range(end=datetime.now(), periods=len(df), freq=\"1h\")\n    df.index.name = \"datetime\"\n    return df\n\n\n@pytest.fixture\ndef sample_state_inicial() -> Dict:\n    return {\n        \"kline_data\": {\n            \"open\": [100.0] * 30,\n            \"high\": [101.0] * 30,\n            \"low\": [99.0] * 30,\n            \"close\": [100.5] * 30,\n            \"volume\": [1000000.0] * 30,\n        },\n        \"analysis_results\": None,\n        \"messages\": [],\n        \"time_frame\": \"1hour\",\n        \"stock_name\": \"BTC\",\n        \"pattern_image\": \"base64_encoded_image_data\",\n        \"trend_image\": \"base64_encoded_image_data\",\n    }\n\n\n@pytest.fixture\ndef sample_state() -> Dict:\n    \"\"\"\n    Provide a minimal valid IndicatorAgentState for testing.\n\n    Returns:\n        Dictionary matching IndicatorAgentState structure with sample data.\n    \"\"\"\n    return {\n        \"kline_data\": {\n            \"open\": [100.0] * 30,\n            \"high\": [101.0] * 30,\n            \"low\": [99.0] * 30,\n            \"close\": [100.5] * 30,\n            \"volume\": [1000000.0] * 30,\n        },\n        \"time_frame\": \"1hour\",\n        \"stock_name\": \"BTC\",\n        \"rsi\": [50.0] * 30,\n        \"macd\": [0.0] * 30,\n        \"macd_signal\": [0.0] * 30,\n        \"macd_hist\": [0.0] * 30,\n        \"stoch_k\": [50.0] * 30,\n        \"stoch_d\": [50.0] * 30,\n        \"roc\": [0.0] * 30,\n        \"willr\": [-50.0] * 30,\n        \"indicator_report\": \"Sample indicator report\",\n        \"pattern_image\": \"base64_encoded_image_data\",\n        \"pattern_image_filename\": \"/tmp/pattern.png\",\n        \"pattern_image_description\": \"Sample pattern description\",\n        \"pattern_report\": \"Sample pattern report\",\n        \"trend_image\": \"base64_encoded_image_data\",\n        \"trend_image_filename\": \"/tmp/trend.png\",\n        \"trend_image_description\": \"Sample trend description\",\n        \"trend_report\": \"Sample trend report\",\n        \"analysis_results\": None,\n        \"messages\": [],\n        \"decision_prompt\": \"Sample decision prompt\",\n        \"final_trade_decision\": \"\",\n    }\n\n\n# ============================================================================\n# Configuration Fixtures\n# ============================================================================\n\n\n@pytest.fixture\ndef mock_config() -> Dict:\n    \"\"\"\n    Provide mock LLM configuration for testing.\n\n    Returns:\n        Dictionary with mock API keys and model settings.\n    \"\"\"\n    return {\n        \"agent_llm_model\": \"gpt-4o-mini\",\n        \"graph_llm_model\": \"gpt-4o\",\n        \"agent_llm_provider\": \"openai\",\n        \"graph_llm_provider\": \"openai\",\n        \"agent_llm_temperature\": 0.1,\n        \"graph_llm_temperature\": 0.1,\n        \"api_key\": \"sk-test-key-12345\",\n        \"anthropic_api_key\": \"sk-ant-test-key\",\n        \"qwen_api_key\": \"sk-qwen-test-key\",\n    }\n\n\n@pytest.fixture\ndef mock_env_vars(monkeypatch):\n    \"\"\"\n    Set up mock environment variables for testing.\n\n    Args:\n        monkeypatch: pytest's monkeypatch fixture.\n    \"\"\"\n    monkeypatch.setenv(\"OPENAI_API_KEY\", \"sk-test-openai-key\")\n    monkeypatch.setenv(\"ANTHROPIC_API_KEY\", \"sk-ant-test-key\")\n    monkeypatch.setenv(\"DASHSCOPE_API_KEY\", \"sk-qwen-test-key\")\n\n\n@pytest.fixture(autouse=True)\ndef ensure_default_llm_api_keys(monkeypatch):\n    \"\"\"Provide deterministic fallback API keys so CI can run without secrets.\"\"\"\n\n    from quantagent import settings as qa_settings\n\n    defaults = {\n        \"OPENAI_API_KEY\": \"sk-test-openai-key\",\n        \"ANTHROPIC_API_KEY\": \"sk-ant-test-key\",\n        \"DASHSCOPE_API_KEY\": \"sk-qwen-test-key\",\n    }\n\n    for key, value in defaults.items():\n        current = os.environ.get(key)\n        if not current:\n            current = value\n            monkeypatch.setenv(key, current)\n        monkeypatch.setattr(qa_settings, key, current, raising=False)\n\n\n# ============================================================================\n# LLM Mock Fixtures\n# ============================================================================\n\n\nclass StructuredMockLLM:\n    \"\"\"\n    Mock LLM supporting modern LangChain patterns.\n\n    Supports both legacy invoke() and modern with_structured_output() patterns.\n    Returns actual Pydantic model instances when used with structured output.\n    \"\"\"\n\n    def __init__(self, default_overrides=None):\n        \"\"\"Initialize with optional field overrides.\"\"\"\n        self.default_overrides = default_overrides or {}\n\n    def invoke(self, messages):\n        return \"Mock LLM response\"\n\n    def with_structured_output(self, schema):\n        \"\"\"\n        Modern pattern: return mock LLM that produces Pydantic instances.\n\n        Args:\n            schema: Pydantic model class (IndicatorReport, PatternReport, etc.)\n\n        Returns:\n            Mock LLM with invoke() that returns schema instance\n        \"\"\"\n        structured_mock = Mock()\n\n        # Create default values based on schema type\n        if schema == IndicatorReport:\n            defaults = {\n                \"macd\": 0.5,\n                \"macd_signal\": 0.3,\n                \"macd_histogram\": 0.2,\n                \"rsi\": 65.0,\n                \"rsi_level\": \"overbought\",\n                \"roc\": 2.5,\n                \"stochastic\": 75.0,\n                \"willr\": -25.0,\n                \"trend_direction\": \"bullish\",\n                \"confidence\": 0.75,\n                \"reasoning\": \"Mock indicator analysis\",\n            }\n        elif schema == PatternReport:\n            defaults = {\n                \"patterns_detected\": [\"double_bottom\"],\n                \"primary_pattern\": \"double_bottom\",\n                \"confidence\": 0.75,\n                \"breakout_probability\": 0.65,\n                \"reasoning\": \"Mock pattern detected\",\n            }\n        elif schema == TrendReport:\n            defaults = {\n                \"support_level\": 99.5,\n                \"resistance_level\": 101.5,\n                \"trend_direction\": \"upward\",\n                \"trend_strength\": 0.75,\n                \"reasoning\": \"Mock trend analysis\",\n            }\n        elif schema == TradingDecision:\n            defaults = {\n                \"decision\": \"LONG\",\n                \"entry_price\": 100.5,\n                \"take_profit\": 102.5,\n                \"stop_loss\": 98.5,\n                \"confidence\": 0.75,\n                \"risk_level\": \"medium\",\n                \"reasoning\": \"Mock trading decision\",\n            }\n        else:\n            defaults = {}\n\n        # Merge with custom overrides\n        defaults.update(self.default_overrides)\n\n        # Create Pydantic instance\n        instance = schema(**defaults)\n        structured_mock.invoke = Mock(return_value=instance)\n\n        return structured_mock\n\n    def bind_tools(self, tools):\n        \"\"\"Mock tool binding.\"\"\"\n        return self\n\n\n@pytest.fixture(autouse=True)\ndef patch_trading_graph_llms(monkeypatch):\n    \"\"\"Use deterministic mock LLMs for TradingGraph tests.\"\"\"\n\n    import quantagent.trading_graph as trading_graph_module\n\n    def mock_create_llm(self, provider, model, temperature):\n        return StructuredMockLLM()\n\n    monkeypatch.setattr(\n        trading_graph_module.TradingGraph,\n        \"_create_llm\",\n        mock_create_llm,\n    )\n\n    # Some tests reload quantagent.trading_graph, which can leave previously\n    # imported `TradingGraph` aliases in test modules pointing at a stale class.\n    # Rebind those aliases to the current module class