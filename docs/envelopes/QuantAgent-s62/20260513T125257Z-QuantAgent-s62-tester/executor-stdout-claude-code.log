{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015Gjg92k9AeATK4nXtwznYd","type":"tool_result","content":"1\t\"\"\"\n2\tTests for QuantAgent-vje: apps/streamlit/views/paper_trading.py\n3\t\n4\tCovers pure-function logic for scheduler status display:\n5\t- _calculate_status (AC-6, AC-7, AC-8)\n6\t- _humanize_time\n7\t- _calculate_duration (including long-cycle edge case)\n8\t\"\"\"\n9\t\n10\tfrom __future__ import annotations\n11\t\n12\tfrom datetime import datetime, timedelta\n13\t\n14\timport pytest\n15\t\n16\tfrom apps.streamlit.views.paper_trading import (\n17\t    _calculate_duration,\n18\t    _calculate_status,\n19\t    _humanize_time,\n20\t)\n21\t\n22\t\n23\t# ---------------------------------------------------------------------------\n24\t# Helpers\n25\t# ---------------------------------------------------------------------------\n26\t\n27\t\n28\tdef _heartbeat(minutes_ago: float = 0, hours_ago: float = 0) -> dict:\n29\t    \"\"\"Return a minimal heartbeat dict with timestamp offset from now.\"\"\"\n30\t    ts = datetime.utcnow() - timedelta(minutes=minutes_ago, hours=hours_ago)\n31\t    return {\"timestamp\": ts, \"stats\": {}, \"completed_at\": None}\n32\t\n33\t\n34\t# ---------------------------------------------------------------------------\n35\t# _calculate_status — AC-6, AC-7, AC-8\n36\t# ---------------------------------------------------------------------------\n37\t\n38\t\n39\tdef test_calculate_status_active_recent():\n40\t    \"\"\"AC-6: Heartbeat < 2h ago → Active.\"\"\"\n41\t    hb = _heartbeat(minutes_ago=30)\n42\t    emoji, text = _calculate_status(hb)\n43\t    assert emoji == \"🟢\"\n44\t    assert text == \"Active\"\n45\t\n46\t\n47\tdef test_calculate_status_active_just_now():\n48\t    \"\"\"AC-6: Heartbeat seconds ago is still Active.\"\"\"\n49\t    hb = _heartbeat(minutes_ago=0)\n50\t    emoji, text = _calculate_status(hb)\n51\t    assert emoji == \"🟢\"\n52\t    assert text == \"Active\"\n53\t\n54\t\n55\tdef test_calculate_status_stale_5h():\n56\t    \"\"\"AC-7: Heartbeat 5h ago → Stale.\"\"\"\n57\t    hb = _heartbeat(hours_ago=5)\n58\t    emoji, text = _calculate_status(hb)\n59\t    assert emoji == \"🟡\"\n60\t    assert text == \"Stale\"\n61\t\n62\t\n63\tdef test_calculate_status_stale_at_boundary():\n64\t    \"\"\"AC-7: Heartbeat exactly 2h ago is Stale (boundary, just past active).\"\"\"\n65\t    hb = _heartbeat(hours_ago=2, minutes_ago=1)\n66\t    emoji, text = _calculate_status(hb)\n67\t    assert emoji == \"🟡\"\n68\t    assert text == \"Stale\"\n69\t\n70\t\n71\tdef test_calculate_status_stopped_over_24h():\n72\t    \"\"\"AC-8: Heartbeat > 24h ago → Stopped.\"\"\"\n73\t    hb = _heartbeat(hours_ago=25)\n74\t    emoji, text = _calculate_status(hb)\n75\t    assert emoji == \"🔴\"\n76\t    assert text == \"Stopped\"\n77\t\n78\t\n79\tdef test_calculate_status_stopped_none_heartbeat():\n80\t    \"\"\"AC-8: No heartbeat at all → Stopped.\"\"\"\n81\t    emoji, text = _calculate_status(None)\n82\t    assert emoji == \"🔴\"\n83\t    assert text == \"Stopped\"\n84\t\n85\t\n86\tdef test_calculate_status_stopped_missing_timestamp():\n87\t    \"\"\"AC-8: Heartbeat with no timestamp field → Stopped.\"\"\"\n88\t    emoji, text = _calculate_status({\"timestamp\": None, \"stats\": {}})\n89\t    assert emoji == \"🔴\"\n90\t    assert text == \"Stopped\"\n91\t\n92\t\n93\tdef test_calculate_status_iso_string_timestamp():\n94\t    \"\"\"_calculate_status handles ISO string timestamps (from DB serialisation).\"\"\"\n95\t    ts = datetime.utcnow() - timedelta(minutes=10)\n96\t    hb = {\"timestamp\": ts.isoformat(), \"stats\": {}}\n97\t    emoji, text = _calculate_status(hb)\n98\t    assert emoji == \"🟢\"\n99\t    assert text == \"Active\"\n100\t\n101\t\n102\t# ---------------------------------------------------------------------------\n103\t# _humanize_time\n104\t# ---------------------------------------------------------------------------\n105\t\n106\t\n107\tdef test_humanize_time_just_now():\n108\t    \"\"\"Under 1 minute → 'Just now'.\"\"\"\n109\t    dt = datetime.utcnow() - timedelta(seconds=30)\n110\t    assert _humanize_time(dt) == \"Just now\"\n111\t\n112\t\n113\tdef test_humanize_time_one_minute():\n114\t    \"\"\"1 minute ago.\"\"\"\n115\t    dt = datetime.utcnow() - timedelta(minutes=1)\n116\t    result = _humanize_time(dt)\n117\t    assert \"minute\" in result\n118\t    assert \"1\" in result\n119\t\n120\t\n121\tdef test_humanize_time_plural_minutes():\n122\t    \"\"\"Multiple minutes — plural form.\"\"\"\n123\t    dt = datetime.utcnow() - timedelta(minutes=5)\n124\t    result = _humanize_time(dt)\n125\t    assert \"5 minutes ago\" == result\n126\t\n127\t\n128\tdef test_humanize_time_one_hour():\n129\t    \"\"\"1 hour ago — singular.\"\"\"\n130\t    dt = datetime.utcnow() - timedelta(hours=1, minutes=5)\n131\t    result = _humanize_time(dt)\n132\t    assert \"hour\" in result\n133\t    assert \"1 \" in result\n134\t\n135\t\n136\tdef test_humanize_time_plural_hours():\n137\t    \"\"\"Multiple hours.\"\"\"\n138\t    dt = datetime.utcnow() - timedelta(hours=3)\n139\t    result = _humanize_time(dt)\n140\t    assert \"3 hours ago\" == result\n141\t\n142\t\n143\tdef test_humanize_time_days():\n144\t    \"\"\"Multiple days.\"\"\"\n145\t    dt = datetime.utcnow() - timedelta(days=3)\n146\t    result = _humanize_time(dt)\n147\t    assert \"3 days ago\" == result\n148\t\n149\t\n150\tdef test_humanize_time_none():\n151\t    \"\"\"None input → 'Never'.\"\"\"\n152\t    assert _humanize_time(None) == \"Never\"\n153\t\n154\t\n155\tdef test_humanize_time_iso_string():\n156\t    \"\"\"ISO string input is parsed correctly.\"\"\"\n157\t    dt = datetime.utcnow() - timedelta(minutes=15)\n158\t    result = _humanize_time(dt.isoformat())\n159\t    assert \"minute\" in result\n160\t\n161\t\n162\tdef test_humanize_time_invalid_string():\n163\t    \"\"\"Unrecognised string → 'Unknown'.\"\"\"\n164\t    result = _humanize_time(\"not-a-date\")\n165\t    assert result == \"Unknown\"\n166\t\n167\t\n168\t# ---------------------------------------------------------------------------\n169\t# _calculate_duration\n170\t# ---------------------------------------------------------------------------\n171\t\n172\t\n173\tdef test_calculate_duration_from_stats():\n174\t    \"\"\"Reads duration_seconds from stats when present.\"\"\"\n175\t    hb = {\n176\t        \"stats\": {\"duration_seconds\": 3.5},\n177\t        \"timestamp\": datetime.utcnow(),\n178\t        \"completed_at\": None,\n179\t    }\n180\t    assert _calculate_duration(hb) == \"3.5s\"\n181\t\n182\t\n183\tdef test_calculate_duration_from_timestamps():\n184\t    \"\"\"Falls back to completed_at - timestamp when stats absent.\"\"\"\n185\t    start = datetime.utcnow() - timedelta(seconds=8)\n186\t    end = datetime.utcnow()\n187\t    hb = {\n188\t        \"stats\": {},\n189\t        \"timestamp\": start,\n190\t        \"completed_at\": end,\n191\t    }\n192\t    result = _calculate_duration(hb)\n193\t    # Should be roughly 8s; just assert format\n194\t    assert result.endswith(\"s\")\n195\t    seconds = float(result[:-1])\n196\t    assert 7.0 <= seconds <= 10.0\n197\t\n198\t\n199\tdef test_calculate_duration_unknown_when_no_data():\n200\t    \"\"\"No stats, no completed_at → 'Unknown'.\"\"\"\n201\t    hb = {\"stats\": {}, \"timestamp\": datetime.utcnow(), \"completed_at\": None}\n202\t    assert _calculate_duration(hb) == \"Unknown\"\n203\t\n204\t\n205\tdef test_calculate_duration_long_cycle_shows_minutes():\n206\t    \"\"\"Edge Case 4: Very long duration (>60s) → shows minutes notation.\"\"\"\n207\t    hb = {\n208\t        \"stats\": {\"duration_seconds\": 600.0},\n209\t        \"timestamp\": datetime.utcnow(),\n210\t        \"completed_at\": None,\n211\t    }\n212\t    result = _calculate_duration(hb)\n213\t    assert result.endswith(\"m\")\n214\t    assert \"10\" in result\n215\t\n216\t\n217\tdef test_calculate_duration_iso_string_timestamps():\n218\t    \"\"\"Handles ISO string timestamps in completed_at / timestamp fields.\"\"\"\n219\t    start = datetime.utcnow() - timedelta(seconds=5)\n220\t    end = datetime.utcnow()\n221\t    hb = {\n222\t        \"stats\": {},\n223\t        \"timestamp\": start.isoformat(),\n224\t        \"completed_at\": end.isoformat(),\n225\t    }\n226\t    result = _calculate_duration(hb)\n227\t    assert result.endswith(\"s\")\n228\t"}]},"parent_tool_use_id":null,"session_id":"e886872b-4bb6-48e1-bec6-42e1776647f7","uuid":"11be0458-4301-4811-8ae5-482f1593037f","timestamp":"2026-05-13T12:53:38.830Z","tool_use_result":{"type":"text","file":{"filePath":"/mnt/actions-runner/autodev-runtime/worktrees/QuantAgent/QuantAgent-s62/implementer-20260513T124414Z/tests/test_vje_paper_trading_view.py","content":"\"\"\"\nTests for QuantAgent-vje: apps/streamlit/views/paper_trading.py\n\nCovers pure-function logic for scheduler status display:\n- _calculate_status (AC-6, AC-7, AC-8)\n- _humanize_time\n- _calculate_duration (including long-cycle edge case)\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom datetime import datetime, timedelta\n\nimport pytest\n\nfrom apps.streamlit.views.paper_trading import (\n    _calculate_duration,\n    _calculate_status,\n    _humanize_time,\n)\n\n\n# ---------------------------------------------------------------------------\n# Helpers\n# ---------------------------------------------------------------------------\n\n\ndef _heartbeat(minutes_ago: float = 0, hours_ago: float = 0) -> dict:\n    \"\"\"Return a minimal heartbeat dict with timestamp offset from now.\"\"\"\n    ts = datetime.utcnow() - timedelta(minutes=minutes_ago, hours=hours_ago)\n    return {\"timestamp\": ts, \"stats\": {}, \"completed_at\": None}\n\n\n# ---------------------------------------------------------------------------\n# _calculate_status — AC-6, AC-7, AC-8\n# ---------------------------------------------------------------------------\n\n\ndef test_calculate_status_active_recent():\n    \"\"\"AC-6: Heartbeat < 2h ago → Active.\"\"\"\n    hb = _heartbeat(minutes_ago=30)\n    emoji, text = _calculate_status(hb)\n    assert emoji == \"🟢\"\n    assert text == \"Active\"\n\n\ndef test_calculate_status_active_just_now():\n    \"\"\"AC-6: Heartbeat seconds ago is still Active.\"\"\"\n    hb = _heartbeat(minutes_ago=0)\n    emoji, text = _calculate_status(hb)\n    assert emoji == \"🟢\"\n    assert text == \"Active\"\n\n\ndef test_calculate_status_stale_5h():\n    \"\"\"AC-7: Heartbeat 5h ago → Stale.\"\"\"\n    hb = _heartbeat(hours_ago=5)\n    emoji, text = _calculate_status(hb)\n    assert emoji == \"🟡\"\n    assert text == \"Stale\"\n\n\ndef test_calculate_status_stale_at_boundary():\n    \"\"\"AC-7: Heartbeat exactly 2h ago is Stale (boundary, just past active).\"\"\"\n    hb = _heartbeat(hours_ago=2, minutes_ago=1)\n    emoji, text = _calculate_status(hb)\n    assert emoji == \"🟡\"\n    assert text == \"Stale\"\n\n\ndef test_calculate_status_stopped_over_24h():\n    \"\"\"AC-8: Heartbeat > 24h ago → Stopped.\"\"\"\n    hb = _heartbeat(hours_ago=25)\n    emoji, text = _calculate_status(hb)\n    assert emoji == \"🔴\"\n    assert text == \"Stopped\"\n\n\ndef test_calculate_status_stopped_none_heartbeat():\n    \"\"\"AC-8: No heartbeat at all → Stopped.\"\"\"\n    emoji, text = _calculate_status(None)\n    assert emoji == \"🔴\"\n    assert text == \"Stopped\"\n\n\ndef test_calculate_status_stopped_missing_timestamp():\n    \"\"\"AC-8: Heartbeat with no timestamp field → Stopped.\"\"\"\n    emoji, text = _calculate_status({\"timestamp\": None, \"stats\": {}})\n    assert emoji == \"🔴\"\n    assert text == \"Stopped\"\n\n\ndef test_calculate_status_iso_string_timestamp():\n    \"\"\"_calculate_status handles ISO string timestamps (from DB serialisation).\"\"\"\n    ts = datetime.utcnow() - timedelta(minutes=10)\n    hb = {\"timestamp\": ts.isoformat(), \"stats\": {}}\n    emoji, text = _calculate_status(hb)\n    assert emoji == \"🟢\"\n    assert text == \"Active\"\n\n\n# ---------------------------------------------------------------------------\n# _humanize_time\n# ---------------------------------------------------------------------------\n\n\ndef test_humanize_time_just_now():\n    \"\"\"Under 1 minute → 'Just now'.\"\"\"\n    dt = datetime.utcnow() - timedelta(seconds=30)\n    assert _humanize_time(dt) == \"Just now\"\n\n\ndef test_humanize_time_one_minute():\n    \"\"\"1 minute ago.\"\"\"\n    dt = datetime.utcnow() - timedelta(minutes=1)\n    result = _humanize_time(dt)\n    assert \"minute\" in result\n    assert \"1\" in result\n\n\ndef test_humanize_time_plural_minutes():\n    \"\"\"Multiple minutes — plural form.\"\"\"\n    dt = datetime.utcnow() - timedelta(minutes=5)\n    result = _humanize_time(dt)\n    assert \"5 minutes ago\" == result\n\n\ndef test_humanize_time_one_hour():\n    \"\"\"1 hour ago — singular.\"\"\"\n    dt = datetime.utcnow() - timedelta(hours=1, minutes=5)\n    result = _humanize_time(dt)\n    assert \"hour\" in result\n    assert \"1 \" in result\n\n\ndef test_humanize_time_plural_hours():\n    \"\"\"Multiple hours.\"\"\"\n    dt = datetime.utcnow() - timedelta(hours=3)\n    result = _humanize_time(dt)\n    assert \"3 hours ago\" == result\n\n\ndef test_humanize_time_days():\n    \"\"\"Multiple days.\"\"\"\n    dt = datetime.utcnow() - timedelta(days=3)\n    result = _humanize_time(dt)\n    assert \"3 days ago\" == result\n\n\ndef test_humanize_time_none():\n    \"\"\"None input → 'Never'.\"\"\"\n    assert _humanize_time(None) == \"Never\"\n\n\ndef test_humanize_time_iso_string():\n    \"\"\"ISO string input is parsed correctly.\"\"\"\n    dt = datetime.utcnow() - timedelta(minutes=15)\n    result = _humanize_time(dt.isoformat())\n    assert \"minute\" in result\n\n\ndef test_humanize_time_invalid_string():\n    \"\"\"Unrecognised string → 'Unknown'.\"\"\"\n    result = _humanize_time(\"not-a-date\")\n    assert result == \"Unknown\"\n\n\n# ---------------------------------------------------------------------------\n# _calculate_duration\n# ---------------------------------------------------------------------------\n\n\ndef test_calculate_duration_from_stats():\n    \"\"\"Reads duration_seconds from stats when present.\"\"\"\n    hb = {\n        \"stats\": {\"duration_seconds\": 3.5},\n        \"timestamp\": datetime.utcnow(),\n        \"completed_at\": None,\n    }\n    assert _calculate_duration(hb) == \"3.5s\"\n\n\ndef test_calculate_duration_from_timestamps():\n    \"\"\"Falls back to completed_at - timestamp when stats absent.\"\"\"\n    start = datetime.utcnow() - timedelta(seconds=8)\n    end = datetime.utcnow()\n    hb = {\n        \"stats\": {},\n        \"timestamp\": start,\n        \"completed_at\": end,\n    }\n    result = _calculate_duration(hb)\n    # Should be roughly 8s; just assert format\n    assert result.endswith(\"s\")\n    seconds = float(result[:-1])\n    assert 7.0 <= seconds <= 10.0\n\n\ndef test_calculate_duration_unknown_when_no_data():\n    \"\"\"No stats, no completed_at → 'Unknown'.\"\"\"\n    hb = {\"stats\": {}, \"timestamp\": datetime.utcnow(), \"completed_at\": None}\n    assert _calculate_duration(hb) == \"Unknown\"\n\n\ndef test_calculate_duration_long_cycle_shows_minutes():\n    \"\"\"Edge Case 4: Very long duration (>60s) → shows minutes notation.\"\"\"\n    hb = {\n        \"stats\": {\"duration_seconds\": 600.0},\n        \"timestamp\": datetime.utcnow(),\n        \"completed_at\": None,\n    }\n    result = _calculate_duration(hb)\n    assert result.endswith(\"m\")\n    assert \"10\" in result\n\n\ndef test_calculate_duration_iso_string_timestamps():\n    \"\"\"Handles ISO string timestamps in completed_at / timestamp fields.\"\"\"\n    start = datetime.utcnow() - timedelta(seconds=5)\n    end = datetime.utcnow()\n    hb = {\n        \"stats\": {},\n        \"timestamp\": start.isoformat(),\n        \"completed_at\": end.isoformat(),\n    }\n    result = _calculate_duration(hb)\n    assert result.endswith(\"s\")\n","numLines":228,"startLine":1,"totalLines":228}}}
