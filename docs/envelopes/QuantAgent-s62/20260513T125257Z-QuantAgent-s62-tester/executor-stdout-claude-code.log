{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_0191BcAmZaWnESpk2uzc6vdU","type":"tool_result","content":"1\tfrom __future__ import annotations\n2\t\n3\tfrom datetime import datetime, timedelta\n4\t\n5\timport streamlit as st\n6\t\n7\tfrom apps.streamlit.utils.ui import df_from_query\n8\t\n9\t\n10\tdef render(db) -> None:\n11\t    st.subheader(\"Logs\")\n12\t\n13\t    if not db.ok:\n14\t        st.info(\"Connect DB to view logs.\")\n15\t        return\n16\t\n17\t    # Filters\n18\t    env_options = [\"all\", \"paper\", \"backtest\"]\n19\t    log_env = st.selectbox(\"Environment\", env_options, index=0)\n20\t\n21\t    col1, col2, col3, col4 = st.columns(4)\n22\t\n23\t    with col1:\n24\t        selected_levels = st.multiselect(\n25\t            \"Log Level\",\n26\t            options=[\"DEBUG\", \"INFO\", \"WARNING\", \"ERROR\", \"CRITICAL\"],\n27\t            default=[\"INFO\", \"WARNING\", \"ERROR\", \"CRITICAL\"],\n28\t        )\n29\t\n30\t    with col2:\n31\t        symbol_filter = st.text_input(\"Symbol (contains)\", value=\"\")\n32\t\n33\t    with col3:\n34\t        event_type_filter = st.text_input(\"Event Type (contains)\", value=\"\")\n35\t\n36\t    with col4:\n37\t        hours_back = st.number_input(\n38\t            \"Hours Back\", min_value=1, max_value=168, value=24\n39\t        )\n40\t\n41\t    # Query logs with filters\n42\t    with db.SessionLocal() as session:\n43\t        try:\n44\t            cutoff_time = datetime.utcnow() - timedelta(hours=hours_back)\n45\t\n46\t            query = session.query(db.models.Log).filter(\n47\t                db.models.Log.timestamp >= cutoff_time\n48\t            )\n49\t\n50\t            if selected_levels:\n51\t                query = query.filter(db.models.Log.level.in_(selected_levels))\n52\t\n53\t            if symbol_filter:\n54\t                query = query.filter(\n55\t                    db.models.Log.symbol.ilike(f\"%{symbol_filter}%\")\n56\t                )\n57\t\n58\t            if event_type_filter:\n59\t                query = query.filter(\n60\t                    db.models.Log.event_type.ilike(f\"%{event_type_filter}%\")\n61\t                )\n62\t\n63\t            if log_env != \"all\":\n64\t                query = query.filter(db.models.Log.environment == log_env)\n65\t\n66\t            logs = (\n67\t                query.order_by(db.models.Log.timestamp.desc())\n68\t                .limit(500)\n69\t                .all()\n70\t            )\n71\t\n72\t            if not logs:\n73\t                st.info(\"No logs found matching the filters.\")\n74\t                return\n75\t\n76\t            # Display logs as dataframe\n77\t            st.markdown(f\"**Showing {len(logs)} log entries (max 500)**\")\n78\t            df = df_from_query(logs)\n79\t\n80\t            # Select relevant columns for display\n81\t            display_columns = [\n82\t                \"timestamp\",\n83\t                \"level\",\n84\t                \"module\",\n85\t                \"event_type\",\n86\t                \"symbol\",\n87\t                \"message\",\n88\t            ]\n89\t            available_columns = [\n90\t                col for col in display_columns if col in df.columns\n91\t            ]\n92\t            st.dataframe(df[available_columns], width=\"stretch\")\n93\t\n94\t            # Expandable details for recent 10 logs\n95\t            st.markdown(\"---\")\n96\t            st.markdown(\"**Recent Log Details (expandable)**\")\n97\t\n98\t            for log in logs[:10]:\n99\t                expander_title = (\n100\t                    f\"{log.timestamp} - {log.level} - {log.module}\"\n101\t                )\n102\t                with st.expander(expander_title):\n103\t                    st.markdown(f\"**Message:** {log.message}\")\n104\t                    st.markdown(f\"**Level:** {log.level}\")\n105\t                    st.markdown(f\"**Module:** {log.module}\")\n106\t                    st.markdown(f\"**Timestamp:** {log.timestamp}\")\n107\t                    if log.symbol:\n108\t                        st.markdown(f\"**Symbol:** {log.symbol}\")\n109\t                    if log.event_type:\n110\t                        st.markdown(f\"**Event Type:** {log.event_type}\")\n111\t                    if log.environment:\n112\t                        st.markdown(f\"**Environment:** {log.environment}\")\n113\t                    if log.thread_id:\n114\t                        st.markdown(f\"**Thread ID:** {log.thread_id}\")\n115\t                    if log.checkpoint_id:\n116\t                        st.markdown(f\"**Checkpoint ID:** {log.checkpoint_id}\")\n117\t                    if log.extra_data:\n118\t                        st.markdown(\"**Metadata (JSON):**\")\n119\t                        st.json(log.extra_data)\n120\t\n121\t        except Exception as e:\n122\t            st.error(f\"Error querying logs: {e}\")\n123\t"}]},"parent_tool_use_id":null,"session_id":"e886872b-4bb6-48e1-bec6-42e1776647f7","uuid":"801c4f6e-0ecb-49ac-8cf8-cb1d081c158a","timestamp":"2026-05-13T12:53:49.262Z","tool_use_result":{"type":"text","file":{"filePath":"/mnt/actions-runner/autodev-runtime/worktrees/QuantAgent/QuantAgent-s62/implementer-20260513T124414Z/apps/streamlit/views/logs.py","content":"from __future__ import annotations\n\nfrom datetime import datetime, timedelta\n\nimport streamlit as st\n\nfrom apps.streamlit.utils.ui import df_from_query\n\n\ndef render(db) -> None:\n    st.subheader(\"Logs\")\n\n    if not db.ok:\n        st.info(\"Connect DB to view logs.\")\n        return\n\n    # Filters\n    env_options = [\"all\", \"paper\", \"backtest\"]\n    log_env = st.selectbox(\"Environment\", env_options, index=0)\n\n    col1, col2, col3, col4 = st.columns(4)\n\n    with col1:\n        selected_levels = st.multiselect(\n            \"Log Level\",\n            options=[\"DEBUG\", \"INFO\", \"WARNING\", \"ERROR\", \"CRITICAL\"],\n            default=[\"INFO\", \"WARNING\", \"ERROR\", \"CRITICAL\"],\n        )\n\n    with col2:\n        symbol_filter = st.text_input(\"Symbol (contains)\", value=\"\")\n\n    with col3:\n        event_type_filter = st.text_input(\"Event Type (contains)\", value=\"\")\n\n    with col4:\n        hours_back = st.number_input(\n            \"Hours Back\", min_value=1, max_value=168, value=24\n        )\n\n    # Query logs with filters\n    with db.SessionLocal() as session:\n        try:\n            cutoff_time = datetime.utcnow() - timedelta(hours=hours_back)\n\n            query = session.query(db.models.Log).filter(\n                db.models.Log.timestamp >= cutoff_time\n            )\n\n            if selected_levels:\n                query = query.filter(db.models.Log.level.in_(selected_levels))\n\n            if symbol_filter:\n                query = query.filter(\n                    db.models.Log.symbol.ilike(f\"%{symbol_filter}%\")\n                )\n\n            if event_type_filter:\n                query = query.filter(\n                    db.models.Log.event_type.ilike(f\"%{event_type_filter}%\")\n                )\n\n            if log_env != \"all\":\n                query = query.filter(db.models.Log.environment == log_env)\n\n            logs = (\n                query.order_by(db.models.Log.timestamp.desc())\n                .limit(500)\n                .all()\n            )\n\n            if not logs:\n                st.info(\"No logs found matching the filters.\")\n                return\n\n            # Display logs as dataframe\n            st.markdown(f\"**Showing {len(logs)} log entries (max 500)**\")\n            df = df_from_query(logs)\n\n            # Select relevant columns for display\n            display_columns = [\n                \"timestamp\",\n                \"level\",\n                \"module\",\n                \"event_type\",\n                \"symbol\",\n                \"message\",\n            ]\n            available_columns = [\n                col for col in display_columns if col in df.columns\n            ]\n            st.dataframe(df[available_columns], width=\"stretch\")\n\n            # Expandable details for recent 10 logs\n            st.markdown(\"---\")\n            st.markdown(\"**Recent Log Details (expandable)**\")\n\n            for log in logs[:10]:\n                expander_title = (\n                    f\"{log.timestamp} - {log.level} - {log.module}\"\n                )\n                with st.expander(expander_title):\n                    st.markdown(f\"**Message:** {log.message}\")\n                    st.markdown(f\"**Level:** {log.level}\")\n                    st.markdown(f\"**Module:** {log.module}\")\n                    st.markdown(f\"**Timestamp:** {log.timestamp}\")\n                    if log.symbol:\n                        st.markdown(f\"**Symbol:** {log.symbol}\")\n                    if log.event_type:\n                        st.markdown(f\"**Event Type:** {log.event_type}\")\n                    if log.environment:\n                        st.markdown(f\"**Environment:** {log.environment}\")\n                    if log.thread_id:\n                        st.markdown(f\"**Thread ID:** {log.thread_id}\")\n                    if log.checkpoint_id:\n                        st.markdown(f\"**Checkpoint ID:** {log.checkpoint_id}\")\n                    if log.extra_data:\n                        st.markdown(\"**Metadata (JSON):**\")\n                        st.json(log.extra_data)\n\n        except Exception as e:\n            st.error(f\"Error querying logs: {e}\")\n","numLines":123,"startLine":1,"totalLines":123}}}
