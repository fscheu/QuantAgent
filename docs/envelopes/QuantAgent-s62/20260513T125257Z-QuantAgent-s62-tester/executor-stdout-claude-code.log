{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01JoqzPPWyutGHNfiZa3JXU8","type":"tool_result","content":"1\t\"\"\"\n2\tTests for LLM telemetry helpers (QuantAgent-69d).\n3\t\n4\tCovers:\n5\t  AC-1  Successful call persists telemetry row with duration_ms > 0\n6\t  AC-2  Token fields nullable when provider response lacks usage data\n7\t  AC-3  Failed calls still produce a log row marked status=error\n8\t  AC-4  Backtest aggregation excludes rows from other backtest runs\n9\t  AC-5  Session aggregation excludes rows from other thread_ids\n10\t  AC-6  Aggregate output contains all required decision-useful fields\n11\t\"\"\"\n12\t\n13\tfrom __future__ import annotations\n14\t\n15\tfrom datetime import datetime\n16\tfrom types import SimpleNamespace\n17\tfrom unittest.mock import MagicMock, call, patch\n18\t\n19\timport pytest\n20\t\n21\tfrom quantagent.llm_telemetry import (\n22\t    TelemetryCtx,\n23\t    _aggregate_rows,\n24\t    extract_usage,\n25\t    get_backtest_metrics,\n26\t    get_session_metrics,\n27\t    persist_llm_call,\n28\t)\n29\t\n30\t\n31\t# ---------------------------------------------------------------------------\n32\t# Helpers\n33\t# ---------------------------------------------------------------------------\n34\t\n35\tdef _make_log_row(\n36\t    thread_id: str | None = None,\n37\t    backtest_run_id: int | None = None,\n38\t    operation: str = \"test_op\",\n39\t    input_tokens: int | None = 10,\n40\t    output_tokens: int | None = 5,\n41\t    total_tokens: int | None = 15,\n42\t    duration_ms: float = 100.0,\n43\t) -> SimpleNamespace:\n44\t    return SimpleNamespace(\n45\t        event_type=\"llm_call\",\n46\t        thread_id=thread_id,\n47\t        extra_data={\n48\t            \"operation\": operation,\n49\t            \"input_tokens\": input_tokens,\n50\t            \"output_tokens\": output_tokens,\n51\t            \"total_tokens\": total_tokens,\n52\t            \"duration_ms\": duration_ms,\n53\t            \"backtest_run_id\": backtest_run_id,\n54\t            \"status\": \"success\",\n55\t        },\n56\t    )\n57\t\n58\t\n59\t# ---------------------------------------------------------------------------\n60\t# TelemetryCtx defaults\n61\t# ---------------------------------------------------------------------------\n62\t\n63\t\n64\tdef test_telemetry_ctx_defaults():\n65\t    ctx = TelemetryCtx()\n66\t    assert ctx.operation == \"\"\n67\t    assert ctx.provider == \"\"\n68\t    assert ctx.model == \"\"\n69\t    assert ctx.environment is None\n70\t    assert ctx.symbol is None\n71\t    assert ctx.thread_id is None\n72\t    assert ctx.backtest_run_id is None\n73\t    assert ctx.extra == {}\n74\t\n75\t\n76\tdef test_telemetry_ctx_set_fields():\n77\t    ctx = TelemetryCtx(\n78\t        operation=\"indicator\",\n79\t        provider=\"openai\",\n80\t        model=\"gpt-4o-mini\",\n81\t        environment=\"paper\",\n82\t        symbol=\"BTC\",\n83\t        thread_id=\"thread-abc\",\n84\t        backtest_run_id=42,\n85\t        extra={\"custom\": True},\n86\t    )\n87\t    assert ctx.operation == \"indicator\"\n88\t    assert ctx.provider == \"openai\"\n89\t    assert ctx.model == \"gpt-4o-mini\"\n90\t    assert ctx.backtest_run_id == 42\n91\t\n92\t\n93\t# ---------------------------------------------------------------------------\n94\t# extract_usage\n95\t# ---------------------------------------------------------------------------\n96\t\n97\t\n98\tclass _MockResponseLangchain:\n99\t    def __init__(self, usage_metadata):\n100\t        self.usage_metadata = usage_metadata\n101\t\n102\t\n103\tclass _MockResponseOpenAILegacy:\n104\t    def __init__(self, token_usage):\n105\t        self.response_metadata = {\"token_usage\": token_usage}\n106\t\n107\t\n108\tclass _MockResponseOpenAIAltKey:\n109\t    def __init__(self, usage):\n110\t        self.response_metadata = {\"usage\": usage}\n111\t\n112\t\n113\tclass _MockResponseNoUsage:\n114\t    pass\n115\t\n116\t\n117\tdef test_extract_usage_langchain_standard():\n118\t    resp = _MockResponseLangchain(\n119\t        {\"input_tokens\": 100, \"output_tokens\": 50, \"total_tokens\": 150}\n120\t    )\n121\t    usage = extract_usage(resp)\n122\t    assert usage[\"input_tokens\"] == 100\n123\t    assert usage[\"output_tokens\"] == 50\n124\t    assert usage[\"total_tokens\"] == 150\n125\t\n126\t\n127\tdef test_extract_usage_openai_legacy_prompt_completion():\n128\t    resp = _MockResponseOpenAILegacy(\n129\t        {\"prompt_tokens\": 80, \"completion_tokens\": 40, \"total_tokens\": 120}\n130\t    )\n131\t    usage = extract_usage(resp)\n132\t    assert usage[\"input_tokens\"] == 80\n133\t    assert usage[\"output_tokens\"] == 40\n134\t    assert usage[\"total_tokens\"] == 120\n135\t\n136\t\n137\tdef test_extract_usage_openai_alt_key_input_output():\n138\t    resp = _MockResponseOpenAIAltKey(\n139\t        {\"input_tokens\": 60, \"output_tokens\": 30, \"total_tokens\": 90}\n140\t    )\n141\t    usage = extract_usage(resp)\n142\t    assert usage[\"input_tokens\"] == 60\n143\t    assert usage[\"output_tokens\"] == 30\n144\t    assert usage[\"total_tokens\"] == 90\n145\t\n146\t\n147\tdef test_extract_usage_no_usage_data_returns_none():\n148\t    \"\"\"AC-2: when provider exposes no usage data all token fields are None.\"\"\"\n149\t    resp = _MockResponseNoUsage()\n150\t    usage = extract_usage(resp)\n151\t    assert usage[\"input_tokens\"] is None\n152\t    assert usage[\"output_tokens\"] is None\n153\t    assert usage[\"total_tokens\"] is None\n154\t\n155\t\n156\tdef test_extract_usage_langchain_partial_tokens():\n157\t    resp = _MockResponseLangchain({\"input_tokens\": 10})\n158\t    usage = extract_usage(resp)\n159\t    assert usage[\"input_tokens\"] == 10\n160\t    assert usage[\"output_tokens\"] is None\n161\t    assert usage[\"total_tokens\"] is None\n162\t\n163\t\n164\tdef test_extract_usage_empty_response_metadata():\n165\t    class Resp:\n166\t        response_metadata = {}\n167\t\n168\t    usage = extract_usage(Resp())\n169\t    assert usage == {\"input_tokens\": None, \"output_tokens\": None, \"total_tokens\": None}\n170\t\n171\t\n172\t# ---------------------------------------------------------------------------\n173\t# _aggregate_rows (unit)\n174\t# ---------------------------------------------------------------------------\n175\t\n176\t\n177\tdef test_aggregate_rows_empty():\n178\t    result = _aggregate_rows([])\n179\t    assert result[\"calls\"] == 0\n180\t    assert result[\"input_tokens_sum\"] == 0\n181\t    assert result[\"output_tokens_sum\"] == 0\n182\t    assert result[\"total_tokens_sum\"] == 0\n183\t    assert result[\"duration_ms_sum\"] == 0.0\n184\t    assert result[\"duration_ms_avg\"] == 0.0\n185\t    assert result[\"by_operation\"] == {}\n186\t\n187\t\n188\tdef test_aggregate_rows_single():\n189\t    row = _make_log_row(input_tokens=10, output_tokens=5, total_tokens=15, duration_ms=200.0)\n190\t    result = _aggregate_rows([row])\n191\t    assert result[\"calls\"] == 1\n192\t    assert result[\"input_tokens_sum\"] == 10\n193\t    assert result[\"output_tokens_sum\"] == 5\n194\t    assert result[\"total_tokens_sum\"] == 15\n195\t    assert result[\"duration_ms_sum\"] == 200.0\n196\t    assert result[\"duration_ms_avg\"] == 200.0\n197\t\n198\t\n199\tdef test_aggregate_rows_multiple():\n200\t    rows = [\n201\t        _make_log_row(operation=\"indicator\", input_tokens=100, output_tokens=50, total_tokens=150, duration_ms=300.0),\n202\t        _make_log_row(operation=\"indicator\", input_tokens=200, output_tokens=100, total_tokens=300, duration_ms=100.0),\n203\t        _make_log_row(operation=\"decision\", input_tokens=50, output_tokens=25, total_tokens=75, duration_ms=200.0),\n204\t    ]\n205\t    result = _aggregate_rows(rows)\n206\t    assert result[\"calls\"] == 3\n207\t    assert result[\"input_tokens_sum\"] == 350\n208\t    assert result[\"output_tokens_sum\"] == 175\n209\t    assert result[\"total_tokens_sum\"] == 525\n210\t    assert result[\"duration_ms_sum\"] == 600.0\n211\t    assert result[\"duration_ms_avg\"] == 200.0\n212\t\n213\t\n214\tdef test_aggregate_rows_by_operation_breakdown():\n215\t    \"\"\"AC-6: by_operation breakdown present with per-operation stats.\"\"\"\n216\t    rows = [\n217\t        _make_log_row(operation=\"indicator\", input_tokens=100, output_tokens=50, total_tokens=150, duration_ms=300.0),\n218\t        _make_log_row(operation=\"indicator\", input_tokens=200, output_tokens=100, total_tokens=300, duration_ms=100.0),\n219\t        _make_log_row(operation=\"decision\", input_tokens=50, output_tokens=25, total_tokens=75, duration_ms=200.0),\n220\t    ]\n221\t    result = _aggregate_rows(rows)\n222\t    by_op = result[\"by_operation\"]\n223\t    assert \"indicator\" in by_op\n224\t    assert \"decision\" in by_op\n225\t    assert by_op[\"indicator\"][\"calls\"] == 2\n226\t    assert by_op[\"indicator\"][\"input_tokens\"] == 300\n227\t    assert by_op[\"decision\"][\"calls\"] == 1\n228\t    assert by_op[\"decision\"][\"output_tokens\"] == 25\n229\t\n230\t\n231\tdef test_aggregate_rows_none_tokens_treated_as_zero():\n232\t    \"\"\"AC-2: rows with null token fields still aggregate without error.\"\"\"\n233\t    rows = [\n234\t        _make_log_row(input_tokens=None, output_tokens=None, total_tokens=None, duration_ms=100.0),\n235\t        _make_log_row(input_tokens=10, output_tokens=5, total_tokens=15, duration_ms=50.0),\n236\t    ]\n237\t    result = _aggregate_rows(rows)\n238\t    assert result[\"calls\"] == 2\n239\t    assert result[\"input_tokens_sum\"] == 10\n240\t    assert result[\"duration_ms_sum\"] == 150.0\n241\t\n242\t\n243\tdef test_aggregate_rows_returns_required_keys():\n244\t    \"\"\"AC-6: Aggregate returns all required keys for downstream reporting.\"\"\"\n245\t    result = _aggregate_rows([_make_log_row()])\n246\t    required_keys = {\n247\t        \"calls\", \"input_tokens_sum\", \"output_tokens_sum\", \"total_tokens_sum\",\n248\t        \"duration_ms_sum\", \"duration_ms_avg\", \"by_operation\",\n249\t    }\n250\t    assert required_keys.issubset(result.keys())\n251\t\n252\t\n253\t# ---------------------------------------------------------------------------\n254\t# persist_llm_call (using real in-memory DB via db_session fixture)\n255\t# ---------------------------------------------------------------------------\n256\t\n257\t\n258\tdef test_persist_llm_call_success_writes_log_row(db_session):\n259\t    \"\"\"AC-1: Successful call produces one llm_call Log row with required fields.\"\"\"\n260\t    from quantagent.models import Log\n261\t\n262\t    ctx = TelemetryCtx(\n263\t        operation=\"indicator\",\n264\t        provider=\"openai\",\n265\t        model=\"gpt-4o-mini\",\n266\t        environment=\"paper\",\n267\t        symbol=\"BTC\",\n268\t        thread_id=\"thread-001\",\n269\t    )\n270\t    response = _MockResponseLangchain(\n271\t        {\"input_tokens\": 120, \"output_tokens\": 60, \"total_tokens\": 180}\n272\t    )\n273\t\n274\t    with patch(\"quantagent.database._get_session_factory\", return_value=lambda: db_session):\n275\t        with patch.object(db_session, \"close\", return_value=None):\n276\t            persist_llm_call(ctx=ctx, status=\"success\", duration_ms=250.0, response=response)\n277\t\n278\t    rows = db_session.query(Log).filter(Log.event_type == \"llm_call\").all()\n279\t    assert len(rows) == 1\n280\t    row = rows[0]\n281\t    assert row.level == \"INFO\"\n282\t    assert row.module == \"quantagent.llm_telemetry\"\n283\t    assert row.symbol == \"BTC\"\n284\t    assert row.thread_id == \"thread-001\"\n285\t    ed = row.extra_data\n286\t    assert ed[\"status\"] == \"success\"\n287\t    assert ed[\"input_tokens\"] == 120\n288\t    assert ed[\"output_tokens\"] == 60\n289\t    assert ed[\"total_tokens\"] == 180\n290\t    assert ed[\"duration_ms\"] > 0\n291\t    assert ed[\"provider\"] == \"openai\"\n292\t    assert ed[\"model\"] == \"gpt-4o-mini\"\n293\t    assert ed[\"operation\"] == \"indicator\"\n294\t\n295\t\n296\tdef test_persist_llm_call_no_usage_data_nullable_tokens(db_session):\n297\t    \"\"\"AC-2: When response has no usage metadata, token fields are None.\"\"\"\n298\t    from quantagent.models import Log\n299\t\n300\t    ctx = TelemetryCtx(operation=\"decision\", provider=\"anthropic\")\n301\t    response = _MockResponseNoUsage()\n302\t\n303\t    with patch(\"quantagent.database._get_session_factory\", return_value=lambda: db_session):\n304\t        with patch.object(db_session, \"close\", return_value=None):\n305\t            persist_llm_call(ctx=ctx, status=\"success\", duration_ms=100.0, response=response)\n306\t\n307\t    row = db_session.query(Log).filter(Log.event_type == \"llm_call\").one()\n308\t    ed = row.extra_data\n309\t    assert ed[\"input_tokens\"] is None\n310\t    assert ed[\"output_tokens\"] is None\n311\t    assert ed[\"total_tokens\"] is None\n312\t    assert ed[\"duration_ms\"] > 0\n313\t\n314\t\n315\tdef test_persist_llm_call_error_status_writes_error_row(db_session):\n316\t    \"\"\"AC-3: Failed call persists row with level=ERROR and status=error.\"\"\"\n317\t    from quantagent.models import Log\n318\t\n319\t    ctx = TelemetryCtx(operation=\"trend\", provider=\"qwen\")\n320\t\n321\t    with patch(\"quantagent.database._get_session_factory\", return_value=lambda: db_session):\n322\t        with patch.object(db_session, \"close\", return_value=None):\n323\t            persist_llm_call(\n324\t                ctx=ctx,\n325\t                status=\"error\",\n326\t                duration_ms=50.0,\n327\t                error_message=\"APITimeoutError: request timed out\",\n328\t            )\n329\t\n330\t    row = db_session.query(Log).filter(Log.event_type == \"llm_call\").one()\n331\t    assert row.level == \"ERROR\"\n332\t    assert \"llm_call trend error\" in row.message\n333\t    ed = row.extra_data\n334\t    assert ed[\"status\"] == \"error\"\n335\t    assert ed[\"error_message\"] == \"APITimeoutError: request timed out\"\n336\t    assert ed[\"duration_ms\"] > 0\n337\t\n338\t\n339\tdef test_persist_llm_call_swallows_db_exception():\n340\t    \"\"\"persist_llm_call is best-effort: a DB failure must NOT propagate.\"\"\"\n341\t    ctx = TelemetryCtx(operation=\"indicator\")\n342\t\n343\t    with patch(\"quantagent.database._get_session_factory\", side_effect=Exception(\"DB down\")):\n344\t        # Should not raise\n345\t        persist_llm_call(ctx=ctx, status=\"success\", duration_ms=10.0)\n346\t\n347\t\n348\tdef test_persist_llm_call_backtest_id_stored(db_session):\n349\t    from quantagent.models import Log\n350\t\n351\t    ctx = TelemetryCtx(operation=\"decision\", backtest_run_id=99)\n352\t\n353\t    with patch(\"quantagent.database._get_session_factory\", return_value=lambda: db_session):\n354\t        with patch.object(db_session, \"close\", return_value=None):\n355\t            persist_llm_call(ctx=ctx, status=\"success\", duration_ms=80.0)\n356\t\n357\t    row = db_session.query(Log).filter(Log.event_type == \"llm_call\").one()\n358\t    assert row.extra_data[\"backtest_run_id\"] == 99\n359\t\n360\t\n361\t# ---------------------------------------------------------------------------\n362\t# get_session_metrics — AC-5: session isolation\n363\t# ---------------------------------------------------------------------------\n364\t\n365\t\n366\tdef test_get_session_metrics_empty_returns_zero_calls(db_session):\n367\t    result = get_session_metrics(db_session, thread_id=\"thread-xyz\")\n368\t    assert result[\"calls\"] == 0\n369\t\n370\t\n371\tdef test_get_session_metrics_filters_by_thread_id(db_session):\n372\t    \"\"\"AC-5: Only rows belonging to the queried thread_id are aggregated.\"\"\"\n373\t    from quantagent.models import Log\n374\t\n375\t    def _log(thread_id, extra_data):\n376\t        return Log(\n377\t            timestamp=datetime.utcnow(),\n378\t            level=\"INFO\",\n379\t            module=\"quantagent.llm_telemetry\",\n380\t            message=\"llm_call indicator success\",\n381\t            event_type=\"llm_call\",\n382\t            thread_id=thread_id,\n383\t            extra_data=extra_data,\n384\t        )\n385\t\n386\t    db_session.add(_log(\"thread-A\", {\"operation\": \"indicator\", \"input_tokens\": 100, \"output_tokens\": 50, \"total_tokens\": 150, \"duration_ms\": 200.0}))\n387\t    db_session.add(_log(\"thread-A\", {\"operation\": \"decision\", \"input_tokens\": 200, \"output_tokens\": 100, \"total_tokens\": 300, \"duration_ms\": 300.0}))\n388\t    db_session.add(_log(\"thread-B\", {\"operation\": \"indicator\", \"input_tokens\": 999, \"output_tokens\": 999, \"total_tokens\": 999, \"duration_ms\": 999.0}))\n389\t    db_session.commit()\n390\t\n391\t    result = get_session_metrics(db_session, thread_id=\"thread-A\")\n392\t    assert result[\"calls\"] == 2\n393\t    assert result[\"input_tokens_sum\"] == 300\n394\t    assert result[\"output_tokens_sum\"] == 150\n395\t    assert result[\"total_tokens_sum\"] == 450\n396\t    assert result[\"duration_ms_sum\"] == 500.0\n397\t\n398\t\n399\tdef test_get_session_metrics_excludes_non_llm_call_rows(db_session):\n400\t    \"\"\"Only event_type='llm_call' rows count.\"\"\"\n401\t    from quantagent.models import Log\n402\t\n403\t    db_session.add(Log(\n404\t        timestamp=datetime.utcnow(),\n405\t        level=\"INFO\",\n406\t        module=\"quantagent.scheduler\",\n407\t        message=\"heartbeat\",\n408\t        event_type=\"heartbeat\",\n409\t        thread_id=\"thread-A\",\n410\t        extra_data={\"duration_ms\": 5000.0},\n411\t    ))\n412\t    db_session.add(Log(\n413\t        timestamp=datetime.utcnow(),\n414\t        level=\"INFO\",\n415\t        module=\"quantagent.llm_telemetry\",\n416\t        message=\"llm_call indicator success\",\n417\t        event_type=\"llm_call\",\n418\t        thread_id=\"thread-A\",\n419\t        extra_data={\"operation\": \"indicator\", \"input_tokens\": 10, \"output_tokens\": 5, \"total_tokens\": 15, \"duration_ms\": 100.0},\n420\t    ))\n421\t    db_session.commit()\n422\t\n423\t    result = get_session_metrics(db_session, thread_id=\"thread-A\")\n424\t    assert result[\"calls\"] == 1\n425\t    assert result[\"input_tokens_sum\"] == 10\n426\t\n427\t\n428\t# ---------------------------------------------------------------------------\n429\t# get_backtest_metrics — AC-4: backtest isolation\n430\t# ---------------------------------------------------------------------------\n431\t\n432\t\n433\tdef test_get_backtest_metrics_empty_returns_zero_calls(db_session):\n434\t    result = get_backtest_metrics(db_session, backtest_run_id=1)\n435\t    assert result[\"calls\"] == 0\n436\t\n437\t\n438\tdef test_get_backtest_metrics_filters_by_backtest_run_id(db_session):\n439\t    \"\"\"AC-4: Metrics for backtest A exclude rows from backtest B.\"\"\"\n440\t    from quantagent.models import Log\n441\t\n442\t    def _log(backtest_run_id, input_tokens):\n443\t        return Log(\n444\t            timestamp=datetime.utcnow(),\n445\t            level=\"INFO\",\n446\t            module=\"quantagent.llm_telemetry\",\n447\t            message=\"llm_call decision success\",\n448\t            event_type=\"llm_call\",\n449\t            extra_data={\n450\t                \"operation\": \"decision\",\n451\t                \"input_tokens\": input_tokens,\n452\t                \"output_tokens\": input_tokens // 2,\n453\t                \"total_tokens\": input_tokens + input_tokens // 2,\n454\t                \"duration_ms\": 100.0,\n455\t                \"backtest_run_id\": backtest_run_id,\n456\t            },\n457\t        )\n458\t\n459\t    db_session.add(_log(backtest_run_id=1, input_tokens=100))\n460\t    db_session.add(_log(backtest_run_id=1, input_tokens=200))\n461\t    db_session.add(_log(backtest_run_id=2, input_tokens=9999))\n462\t    db_session.commit()\n463\t\n464\t    result_a = get_backtest_metrics(db_session, backtest_run_id=1)\n465\t    assert result_a[\"calls\"] == 2\n466\t    assert result_a[\"input_tokens_sum\"] == 300\n467\t\n468\t    result_b = get_backtest_metrics(db_session, backtest_run_id=2)\n469\t    assert result_b[\"calls\"] == 1\n470\t    assert result_b[\"input_tokens_sum\"] == 9999\n471\t\n472\t\n473\tdef test_get_backtest_metrics_by_operation_present(db_session):\n474\t    \"\"\"AC-6: by_operation present in backtest aggregate.\"\"\"\n475\t    from quantagent.models import Log\n476\t\n477\t    for op in (\"indicator\", \"pattern\", \"trend\", \"decision\"):\n478\t        db_session.add(Log(\n479\t            timestamp=datetime.utcnow(),\n480\t            level=\"INFO\",\n481\t            module=\"quantagent.llm_telemetry\",\n482\t            message=f\"llm_call {op} success\",\n483\t            event_type=\"llm_call\",\n484\t            extra_data={\"operation\": op, \"input_tokens\": 10, \"output_tokens\": 5, \"total_tokens\": 15, \"duration_ms\": 50.0, \"backtest_run_id\": 7},\n485\t        ))\n486\t    db_session.commit()\n487\t\n488\t    result = get_backtest_metrics(db_session, backtest_run_id=7)\n489\t    assert result[\"calls\"] == 4\n490\t    assert set(result[\"by_operation\"].keys()) == {\"indicator\", \"pattern\", \"trend\", \"decision\"}\n491\t    for op_stats in result[\"by_operation\"].values():\n492\t        assert op_stats[\"calls\"] == 1\n493\t        assert op_stats[\"input_tokens\"] == 10\n494\t\n495\t\n496\t# ---------------------------------------------------------------------------\n497\t# invoke_with_retry + telemetry_ctx integration\n498\t# ---------------------------------------------------------------------------\n499\t\n500\t\n501\tdef test_invoke_with_retry_persists_telemetry_on_success():\n502\t    \"\"\"AC-1: invoke_with_retry calls persist_llm_call on success.\"\"\"\n503\t    from quantagent.agent_utils import invoke_with_retry\n504\t\n505\t    mock_fn = MagicMock(return_value=\"ok\")\n506\t    ctx = TelemetryCtx(operation=\"test_op\", provider=\"openai\")\n507\t\n508\t    with patch(\"quantagent.llm_telemetry.persist_llm_call\") as mock_persist:\n509\t        result = invoke_with_retry(mock_fn, telemetry_ctx=ctx)\n510\t\n511\t    assert result == \"ok\"\n512\t    mock_persist.assert_called_once()\n513\t    _, kwargs = mock_persist.call_args\n514\t    assert kwargs[\"ctx\"] is ctx\n515\t    assert kwargs[\"status\"] == \"success\"\n516\t    assert kwargs[\"duration_ms\"] > 0\n517\t    assert kwargs[\"response\"] == \"ok\"\n518\t\n519\t\n520\tdef test_invoke_with_retry_persists_telemetry_on_non_retryable_error():\n521\t    \"\"\"AC-3: Non-retryable error triggers persist with status=error.\"\"\"\n522\t    from quantagent.agent_utils import invoke_with_retry\n523\t\n524\t    class AuthErr(Exception):\n525\t        pass\n526\t\n527\t    AuthErr.__module__ = \"openai\"\n528\t    AuthErr.__name__ = \"AuthenticationError\"\n529\t\n530\t    mock_fn = MagicMock(side_effect=AuthErr(\"bad key\"))\n531\t    ctx = TelemetryCtx(operation=\"indicator\", provider=\"openai\")\n532\t\n533\t    with patch(\"quantagent.llm_telemetry.persist_llm_call\") as mock_persist:\n534\t        with pytest.raises(AuthErr):\n535\t            invoke_with_retry(mock_fn, telemetry_ctx=ctx)\n536\t\n537\t    mock_persist.assert_called_once()\n538\t    _, kwargs = mock_persist.call_args\n539\t    assert kwargs[\"status\"] == \"error\"\n540\t    assert kwargs[\"duration_ms\"] > 0\n541\t    assert \"AuthenticationError\" in kwargs[\"error_message\"]\n542\t\n543\t\n544\tdef test_invoke_with_retry_persists_telemetry_on_max_retries_exceeded():\n545\t    \"\"\"AC-3: After retries exhausted, persist_llm_call called with status=error.\"\"\"\n546\t    from quantagent.agent_utils import invoke_with_retry\n547\t\n548\t    class RateErr(Exception):\n549\t        pass\n550\t\n551\t    RateErr.__module__ = \"openai\"\n552\t    RateErr.__name__ = \"RateLimitError\"\n553\t\n554\t    mock_fn = MagicMock(side_effect=RateErr(\"rate limited\"))\n555\t    ctx = TelemetryCtx(operation=\"decision\", provider=\"openai\")\n556\t\n557\t    with patch(\"time.sleep\"), patch(\"quantagent.llm_telemetry.persist_llm_call\") as mock_persist:\n558\t        with pytest.raises(RuntimeError, match=\"Max retries\"):\n559\t            invoke_with_retry(mock_fn, retries=2, telemetry_ctx=ctx)\n560\t\n561\t    mock_persist.assert_called_once()\n562\t    _, kwargs = mock_persist.call_args\n563\t    assert kwargs[\"status\"] == \"error\"\n564\t    assert kwargs[\"duration_ms\"] > 0\n565\t\n566\t\n567\tdef test_invoke_with_retry_no_telemetry_ctx_does_not_call_persist():\n568\t    \"\"\"When telemetry_ctx is None, persist_llm_call is never called.\"\"\"\n569\t    from quantagent.agent_utils import invoke_with_retry\n570\t\n571\t    mock_fn = MagicMock(return_value=\"ok\")\n572\t\n573\t    with patch(\"quantagent.llm_telemetry.persist_llm_call\") as mock_persist:\n574\t        invoke_with_retry(mock_fn)\n575\t\n576\t    mock_persist.assert_not_called()\n577\t"}]},"parent_tool_use_id":null,"session_id":"e886872b-4bb6-48e1-bec6-42e1776647f7","uuid":"e1210284-104f-4378-ae80-0b8d66dcc15b","timestamp":"2026-05-13T12:53:38.497Z","tool_use_result":{"type":"text","file":{"filePath":"/mnt/actions-runner/autodev-runtime/worktrees/QuantAgent/QuantAgent-s62/implementer-20260513T124414Z/tests/test_llm_telemetry.py","content":"\"\"\"\nTests for LLM telemetry helpers (QuantAgent-69d).\n\nCovers:\n  AC-1  Successful call persists telemetry row with duration_ms > 0\n  AC-2  Token fields nullable when provider response lacks usage data\n  AC-3  Failed calls still produce a log row marked status=error\n  AC-4  Backtest aggregation excludes rows from other backtest runs\n  AC-5  Session aggregation excludes rows from other thread_ids\n  AC-6  Aggregate output contains all required decision-useful fields\n\"\"\"\n\nfrom __future__ import annotations\n\nfrom datetime import datetime\nfrom types import SimpleNamespace\nfrom unittest.mock import MagicMock, call, patch\n\nimport pytest\n\nfrom quantagent.llm_telemetry import (\n    TelemetryCtx,\n    _aggregate_rows,\n    extract_usage,\n    get_backtest_metrics,\n    get_session_metrics,\n    persist_llm_call,\n)\n\n\n# ---------------------------------------------------------------------------\n# Helpers\n# ---------------------------------------------------------------------------\n\ndef _make_log_row(\n    thread_id: str | None = None,\n    backtest_run_id: int | None = None,\n    operation: str = \"test_op\",\n    input_tokens: int | None = 10,\n    output_tokens: int | None = 5,\n    total_tokens: int | None = 15,\n    duration_ms: float = 100.0,\n) -> SimpleNamespace:\n    return SimpleNamespace(\n        event_type=\"llm_call\",\n        thread_id=thread_id,\n        extra_data={\n            \"operation\": operation,\n            \"input_tokens\": input_tokens,\n            \"output_tokens\": output_tokens,\n            \"total_tokens\": total_tokens,\n            \"duration_ms\": duration_ms,\n            \"backtest_run_id\": backtest_run_id,\n            \"status\": \"success\",\n        },\n    )\n\n\n# ---------------------------------------------------------------------------\n# TelemetryCtx defaults\n# ---------------------------------------------------------------------------\n\n\ndef test_telemetry_ctx_defaults():\n    ctx = TelemetryCtx()\n    assert ctx.operation == \"\"\n    assert ctx.provider == \"\"\n    assert ctx.model == \"\"\n    assert ctx.environment is None\n    assert ctx.symbol is None\n    assert ctx.thread_id is None\n    assert ctx.backtest_run_id is None\n    assert ctx.extra == {}\n\n\ndef test_telemetry_ctx_set_fields():\n    ctx = TelemetryCtx(\n        operation=\"indicator\",\n        provider=\"openai\",\n        model=\"gpt-4o-mini\",\n        environment=\"paper\",\n        symbol=\"BTC\",\n        thread_id=\"thread-abc\",\n        backtest_run_id=42,\n        extra={\"custom\": True},\n    )\n    assert ctx.operation == \"indicator\"\n    assert ctx.provider == \"openai\"\n    assert ctx.model == \"gpt-4o-mini\"\n    assert ctx.backtest_run_id == 42\n\n\n# ---------------------------------------------------------------------------\n# extract_usage\n# ---------------------------------------------------------------------------\n\n\nclass _MockResponseLangchain:\n    def __init__(self, usage_metadata):\n        self.usage_metadata = usage_metadata\n\n\nclass _MockResponseOpenAILegacy:\n    def __init__(self, token_usage):\n        self.response_metadata = {\"token_usage\": token_usage}\n\n\nclass _MockResponseOpenAIAltKey:\n    def __init__(self, usage):\n        self.response_metadata = {\"usage\": usage}\n\n\nclass _MockResponseNoUsage:\n    pass\n\n\ndef test_extract_usage_langchain_standard():\n    resp = _MockResponseLangchain(\n        {\"input_tokens\": 100, \"output_tokens\": 50, \"total_tokens\": 150}\n    )\n    usage = extract_usage(resp)\n    assert usage[\"input_tokens\"] == 100\n    assert usage[\"output_tokens\"] == 50\n    assert usage[\"total_tokens\"] == 150\n\n\ndef test_extract_usage_openai_legacy_prompt_completion():\n    resp = _MockResponseOpenAILegacy(\n        {\"prompt_tokens\": 80, \"completion_tokens\": 40, \"total_tokens\": 120}\n    )\n    usage = extract_usage(resp)\n    assert usage[\"input_tokens\"] == 80\n    assert usage[\"output_tokens\"] == 40\n    assert usage[\"total_tokens\"] == 120\n\n\ndef test_extract_usage_openai_alt_key_input_output():\n    resp = _MockResponseOpenAIAltKey(\n        {\"input_tokens\": 60, \"output_tokens\": 30, \"total_tokens\": 90}\n    )\n    usage = extract_usage(resp)\n    assert usage[\"input_tokens\"] == 60\n    assert usage[\"output_tokens\"] == 30\n    assert usage[\"total_tokens\"] == 90\n\n\ndef test_extract_usage_no_usage_data_returns_none():\n    \"\"\"AC-2: when provider exposes no usage data all token fields are None.\"\"\"\n    resp = _MockResponseNoUsage()\n    usage = extract_usage(resp)\n    assert usage[\"input_tokens\"] is None\n    assert usage[\"output_tokens\"] is None\n    assert usage[\"total_tokens\"] is None\n\n\ndef test_extract_usage_langchain_partial_tokens():\n    resp = _MockResponseLangchain({\"input_tokens\": 10})\n    usage = extract_usage(resp)\n    assert usage[\"input_tokens\"] == 10\n    assert usage[\"output_tokens\"] is None\n    assert usage[\"total_tokens\"] is None\n\n\ndef test_extract_usage_empty_response_metadata():\n    class Resp:\n        response_metadata = {}\n\n    usage = extract_usage(Resp())\n    assert usage == {\"input_tokens\": None, \"output_tokens\": None, \"total_tokens\": None}\n\n\n# ---------------------------------------------------------------------------\n# _aggregate_rows (unit)\n# ---------------------------------------------------------------------------\n\n\ndef test_aggregate_rows_empty():\n    result = _aggregate_rows([])\n    assert result[\"calls\"] == 0\n    assert result[\"input_tokens_sum\"] == 0\n    assert result[\"output_tokens_sum\"] == 0\n    assert result[\"total_tokens_sum\"] == 0\n    assert result[\"duration_ms_sum\"] == 0.0\n    assert result[\"duration_ms_avg\"] == 0.0\n    assert result[\"by_operation\"] == {}\n\n\ndef test_aggregate_rows_single():\n    row = _make_log_row(input_tokens=10, output_tokens=5, total_tokens=15, duration_ms=200.0)\n    result = _aggregate_rows([row])\n    assert result[\"calls\"] == 1\n    assert result[\"input_tokens_sum\"] == 10\n    assert result[\"output_tokens_sum\"] == 5\n    assert result[\"total_tokens_sum\"] == 15\n    assert result[\"duration_ms_sum\"] == 200.0\n    assert result[\"duration_ms_avg\"] == 200.0\n\n\ndef test_aggregate_rows_multiple():\n    rows = [\n        _make_log_row(operation=\"indicator\", input_tokens=100, output_tokens=50, total_tokens=150, duration_ms=300.0),\n        _make_log_row(operation=\"indicator\", input_tokens=200, output_tokens=100, total_tokens=300, duration_ms=100.0),\n        _make_log_row(operation=\"decision\", input_tokens=50, output_tokens=25, total_tokens=75, duration_ms=200.0),\n    ]\n    result = _aggregate_rows(rows)\n    assert result[\"calls\"] == 3\n    assert result[\"input_tokens_sum\"] == 350\n    assert result[\"output_tokens_sum\"] == 175\n    assert result[\"total_tokens_sum\"] == 525\n    assert result[\"duration_ms_sum\"] == 600.0\n    assert result[\"duration_ms_avg\"] == 200.0\n\n\ndef test_aggregate_rows_by_operation_breakdown():\n    \"\"\"AC-6: by_operation breakdown present with per-operation stats.\"\"\"\n    rows = [\n        _make_log_row(operation=\"indicator\", input_tokens=100, output_tokens=50, total_tokens=150, duration_ms=300.0),\n        _make_log_row(operation=\"indicator\", input_tokens=200, output_tokens=100, total_tokens=300, duration_ms=100.0),\n        _make_log_row(operation=\"decision\", input_tokens=50, output_tokens=25, total_tokens=75, duration_ms=200.0),\n    ]\n    result = _aggregate_rows(rows)\n    by_op = result[\"by_operation\"]\n    assert \"indicator\" in by_op\n    assert \"decision\" in by_op\n    assert by_op[\"indicator\"][\"calls\"] == 2\n    assert by_op[\"indicator\"][\"input_tokens\"] == 300\n    assert by_op[\"decision\"][\"calls\"] == 1\n    assert by_op[\"decision\"][\"output_tokens\"] == 25\n\n\ndef test_aggregate_rows_none_tokens_treated_as_zero():\n    \"\"\"AC-2: rows with null token fields still aggregate without error.\"\"\"\n    rows = [\n        _make_log_row(input_tokens=None, output_tokens=None, total_tokens=None, duration_ms=100.0),\n        _make_log_row(input_tokens=10, output_tokens=5, total_tokens=15, duration_ms=50.0),\n    ]\n    result = _aggregate_rows(rows)\n    assert result[\"calls\"] == 2\n    assert result[\"input_tokens_sum\"] == 10\n    assert result[\"duration_ms_sum\"] == 150.0\n\n\ndef test_aggregate_rows_returns_required_keys():\n    \"\"\"AC-6: Aggregate returns all required keys for downstream reporting.\"\"\"\n    result = _aggregate_rows([_make_log_row()])\n    required_keys = {\n        \"calls\", \"input_tokens_sum\", \"output_tokens_sum\", \"total_tokens_sum\",\n        \"duration_ms_sum\", \"duration_ms_avg\", \"by_operation\",\n    }\n    assert required_keys.issubset(result.keys())\n\n\n# ---------------------------------------------------------------------------\n# persist_llm_call (using real in-memory DB via db_session fixture)\n# ---------------------------------------------------------------------------\n\n\ndef test_persist_llm_call_success_writes_log_row(db_session):\n    \"\"\"AC-1: Successful call produces one llm_call Log row with required fields.\"\"\"\n    from quantagent.models import Log\n\n    ctx = TelemetryCtx(\n        operation=\"indicator\",\n        provider=\"openai\",\n        model=\"gpt-4o-mini\",\n        environment=\"paper\",\n        symbol=\"BTC\",\n        thread_id=\"thread-001\",\n    )\n    response = _MockResponseLangchain(\n        {\"input_tokens\": 120, \"output_tokens\": 60, \"total_tokens\": 180}\n    )\n\n    with patch(\"quantagent.database._get_session_factory\", return_value=lambda: db_session):\n        with patch.object(db_session, \"close\", return_value=None):\n            persist_llm_call(ctx=ctx, status=\"success\", duration_ms=250.0, response=response)\n\n    rows = db_session.query(Log).filter(Log.event_type == \"llm_call\").all()\n    assert len(rows) == 1\n    row = rows[0]\n    assert row.level == \"INFO\"\n    assert row.module == \"quantagent.llm_telemetry\"\n    assert row.symbol == \"BTC\"\n    assert row.thread_id == \"thread-001\"\n    ed = row.extra_data\n    assert ed[\"status\"] == \"success\"\n    assert ed[\"input_tokens\"] == 120\n    assert ed[\"output_tokens\"] == 60\n    assert ed[\"total_tokens\"] == 180\n    assert ed[\"duration_ms\"] > 0\n    assert ed[\"provider\"] == \"openai\"\n    assert ed[\"model\"] == \"gpt-4o-mini\"\n    assert ed[\"operation\"] == \"indicator\"\n\n\ndef test_persist_llm_call_no_usage_data_nullable_tokens(db_session):\n    \"\"\"AC-2: When response has no usage metadata, token fields are None.\"\"\"\n    from quantagent.models import Log\n\n    ctx = TelemetryCtx(operation=\"decision\", provider=\"anthropic\")\n    response = _MockResponseNoUsage()\n\n    with patch(\"quantagent.database._get_session_factory\", return_value=lambda: db_session):\n        with patch.object(db_session, \"close\", return_value=None):\n            persist_llm_call(ctx=ctx, status=\"success\", duration_ms=100.0, response=response)\n\n    row = db_session.query(Log).filter(Log.event_type == \"llm_call\").one()\n    ed = row.extra_data\n    assert ed[\"input_tokens\"] is None\n    assert ed[\"output_tokens\"] is None\n    assert ed[\"total_tokens\"] is None\n    assert ed[\"duration_ms\"] > 0\n\n\ndef test_persist_llm_call_error_status_writes_error_row(db_session):\n    \"\"\"AC-3: Failed call persists row with level=ERROR and status=error.\"\"\"\n    from quantagent.models import Log\n\n    ctx = TelemetryCtx(operation=\"trend\", provider=\"qwen\")\n\n    with patch(\"quantagent.database._get_session_factory\", return_value=lambda: db_session):\n        with patch.object(db_session, \"close\", return_value=None):\n            persist_llm_call(\n                ctx=ctx,\n                status=\"error\",\n                duration_ms=50.0,\n                error_message=\"APITimeoutError: request timed out\",\n            )\n\n    row = db_session.query(Log).filter(Log.event_type == \"llm_call\").one()\n    assert row.level == \"ERROR\"\n    assert \"llm_call trend error\" in row.message\n    ed = row.extra_data\n    assert ed[\"status\"] == \"error\"\n    assert ed[\"error_message\"] == \"APITimeoutError: request timed out\"\n    assert ed[\"duration_ms\"] > 0\n\n\ndef test_persist_llm_call_swallows_db_exception():\n    \"\"\"persist_llm_call is best-effort: a DB failure must NOT propagate.\"\"\"\n    ctx = TelemetryCtx(operation=\"indicator\")\n\n    with patch(\"quantagent.database._get_session_factory\", side_effect=Exception(\"DB down\")):\n        # Should not raise\n        persist_llm_call(ctx=ctx, status=\"success\", duration_ms=10.0)\n\n\ndef test_persist_llm_call_backtest_id_stored(db_session):\n    from quantagent.models import Log\n\n    ctx = TelemetryCtx(operation=\"decision\", backtest_run_id=99)\n\n    with patch(\"quantagent.database._get_session_factory\", return_value=lambda: db_session):\n        with patch.object(db_session, \"close\", return_value=None):\n            persist_llm_call(ctx=ctx, status=\"success\", duration_ms=80.0)\n\n    row = db_session.query(Log).filter(Log.event_type == \"llm_call\").one()\n    assert row.extra_data[\"backtest_run_id\"] == 99\n\n\n# ---------------------------------------------------------------------------\n# get_session_metrics — AC-5: session isolation\n# ---------------------------------------------------------------------------\n\n\ndef test_get_session_metrics_empty_returns_zero_calls(db_session):\n    result = get_session_metrics(db_session, thread_id=\"thread-xyz\")\n    assert result[\"calls\"] == 0\n\n\ndef test_get_session_metrics_filters_by_thread_id(db_session):\n    \"\"\"AC-5: Only rows belonging to the queried thread_id are aggregated.\"\"\"\n    from quantagent.models import Log\n\n    def _log(thread_id, extra_data):\n        return Log(\n            timestamp=datetime.utcnow(),\n            level=\"INFO\",\n            module=\"quantagent.llm_telemetry\",\n            message=\"llm_call indicator success\",\n            event_type=\"llm_call\",\n            thread_id=thread_id,\n            extra_data=extra_data,\n        )\n\n    db_session.add(_log(\"thread-A\", {\"operation\": \"indicator\", \"input_tokens\": 100, \"output_tokens\": 50, \"total_tokens\": 150, \"duration_ms\": 200.0}))\n    db_session.add(_log(\"thread-A\", {\"operation\": \"decision\", \"input_tokens\": 200, \"output_tokens\": 100, \"total_tokens\": 300, \"duration_ms\": 300.0}))\n    db_session.add(_log(\"thread-B\", {\"operation\": \"indicator\", \"input_tokens\": 999, \"output_tokens\": 999, \"total_tokens\": 999, \"duration_ms\": 999.0}))\n    db_session.commit()\n\n    result = get_session_metrics(db_session, thread_id=\"thread-A\")\n    assert result[\"calls\"] == 2\n    assert result[\"input_tokens_sum\"] == 300\n    assert result[\"output_tokens_sum\"] == 150\n    assert result[\"total_tokens_sum\"] == 450\n    assert result[\"duration_ms_sum\"] == 500.0\n\n\ndef test_get_session_metrics_excludes_non_llm_call_rows(db_session):\n    \"\"\"Only event_type='llm_call' rows count.\"\"\"\n    from quantagent.models import Log\n\n    db_session.add(Log(\n        timestamp=datetime.utcnow(),\n        level=\"INFO\",\n        module=\"quantagent.scheduler\",\n        message=\"heartbeat\",\n        event_type=\"heartbeat\",\n        thread_id=\"thread-A\",\n        extra_data={\"duration_ms\": 5000.0},\n    ))\n    db_session.add(Log(\n        timestamp=datetime.utcnow(),\n        level=\"INFO\",\n        module=\"quantagent.llm_telemetry\",\n        message=\"llm_call indicator success\",\n        event_type=\"llm_call\",\n        thread_id=\"thread-A\",\n        extra_data={\"operation\": \"indicator\", \"input_tokens\": 10, \"output_tokens\": 5, \"total_tokens\": 15, \"duration_ms\": 100.0},\n    ))\n    db_session.commit()\n\n    result = get_session_metrics(db_session, thread_id=\"thread-A\")\n    assert result[\"calls\"] == 1\n    assert result[\"input_tokens_sum\"] == 10\n\n\n# ---------------------------------------------------------------------------\n# get_backtest_metrics — AC-4: backtest isolation\n# ---------------------------------------------------------------------------\n\n\ndef test_get_backtest_metrics_empty_returns_zero_calls(db_session):\n    result = get_backtest_metrics(db_session, backtest_run_id=1)\n    assert result[\"calls\"] == 0\n\n\ndef test_get_backtest_metrics_filters_by_backtest_run_id(db_session):\n    \"\"\"AC-4: Metrics for backtest A exclude rows from backtest B.\"\"\"\n    from quantagent.models import Log\n\n    def _log(backtest_run_id, input_tokens):\n        return Log(\n            timestamp=datetime.utcnow(),\n            level=\"INFO\",\n            module=\"quantagent.llm_telemetry\",\n            message=\"llm_call decision success\",\n            event_type=\"llm_call\",\n            extra_data={\n                \"operation\": \"decision\",\n                \"input_tokens\": input_tokens,\n                \"output_tokens\": input_tokens // 2,\n                \"total_tokens\": input_tokens + input_tokens // 2,\n                \"duration_ms\": 100.0,\n                \"backtest_run_id\": backtest_run_id,\n            },\n        )\n\n    db_session.add(_log(backtest_run_id=1, input_tokens=100))\n    db_session.add(_log(backtest_run_id=1, input_tokens=200))\n    db_session.add(_log(backtest_run_id=2, input_tokens=9999))\n    db_session.commit()\n\n    result_a = get_backtest_metrics(db_session, backtest_run_id=1)\n    assert result_a[\"calls\"] == 2\n    assert result_a[\"input_tokens_sum\"] == 300\n\n    result_b = get_backtest_metrics(db_session, backtest_run_id=2)\n    assert result_b[\"calls\"] == 1\n    assert result_b[\"input_tokens_sum\"] == 9999\n\n\ndef test_get_backtest_metrics_by_operation_present(db_session):\n    \"\"\"AC-6: by_operation present in backtest aggregate.\"\"\"\n    from quantagent.models import Log\n\n    for op in (\"indicator\", \"pattern\", \"trend\", \"decision\"):\n        db_session.add(Log(\n            timestamp=datetime.utcnow(),\n            level=\"INFO\",\n            module=\"quantagent.llm_telemetry\",\n            message=f\"llm_call {op} success\",\n            event_type=\"llm_call\",\n            extra_data={\"operation\": op, \"input_tokens\": 10, \"output_tokens\": 5, \"total_tokens\": 15, \"duration_ms\": 50.0, \"backtest_run_id\": 7},\n        ))\n    db_session.commit()\n\n    result = get_backtest_metrics(db_session, backtest_run_id=7)\n    assert result[\"calls\"] == 4\n    assert set(result[\"by_operation\"].keys()) == {\"indicator\", \"pattern\", \"trend\", \"decision\"}\n    for op_stats in result[\"by_operation\"].values():\n        assert op_stats[\"calls\"] == 1\n        assert op_stats[\"input_tokens\"] == 10\n\n\n# ---------------------------------------------------------------------------\n# invoke_with_retry + telemetry_ctx integration\n# ---------------------------------------------------------------------------\n\n\ndef test_invoke_with_retry_persists_telemetry_on_success():\n    \"\"\"AC-1: invoke_with_retry calls persist_llm_call on success.\"\"\"\n    from quantagent.agent_utils import invoke_with_retry\n\n    mock_fn = MagicMock(return_value=\"ok\")\n    ctx = TelemetryCtx(operation=\"test_op\", provider=\"openai\")\n\n    with patch(\"quantagent.llm_telemetry.persist_llm_call\") as mock_persist:\n        result = invoke_with_retry(mock_fn, telemetry_ctx=ctx)\n\n    assert result == \"ok\"\n    mock_persist.assert_called_once()\n    _, kwargs = mock_persist.call_args\n    assert kwargs[\"ctx\"] is ctx\n    assert kwargs[\"status\"] == \"success\"\n    assert kwargs[\"duration_ms\"] > 0\n    assert kwargs[\"response\"] == \"ok\"\n\n\ndef test_invoke_with_retry_persists_telemetry_on_non_retryable_error():\n    \"\"\"AC-3: Non-retryable error triggers persist with status=error.\"\"\"\n    from quantagent.agent_utils import invoke_with_retry\n\n    class AuthErr(Exception):\n        pass\n\n    AuthErr.__module__ = \"openai\"\n    AuthErr.__name__ = \"AuthenticationError\"\n\n    mock_fn = MagicMock(side_effect=AuthErr(\"bad key\"))\n    ctx = TelemetryCtx(operation=\"indicator\", provider=\"openai\")\n\n    with patch(\"quantagent.llm_telemetry.persist_llm_call\") as mock_persist:\n        with pytest.raises(AuthErr):\n            invoke_with_retry(mock_fn, telemetry_ctx=ctx)\n\n    mock_persist.assert_called_once()\n    _, kwargs = mock_persist.call_args\n    assert kwargs[\"status\"] == \"error\"\n    assert kwargs[\"duration_ms\"] > 0\n    assert \"AuthenticationError\" in kwargs[\"error_message\"]\n\n\ndef test_invoke_with_retry_persists_telemetry_on_max_retries_exceeded():\n    \"\"\"AC-3: After retries exhausted, persist_llm_call called with status=error.\"\"\"\n    from quantagent.agent_utils import invoke_with_retry\n\n    class RateErr(Exception):\n        pass\n\n    RateErr.__module__ = \"openai\"\n    RateErr.__name__ = \"RateLimitError\"\n\n    mock_fn = MagicMock(side_effect=RateErr(\"rate limited\"))\n    ctx = TelemetryCtx(operation=\"decision\", provider=\"openai\")\n\n    with patch(\"time.sleep\"), patch(\"quantagent.llm_telemetry.persist_llm_call\") as mock_persist:\n        with pytest.raises(RuntimeError, match=\"Max retries\"):\n            invoke_with_retry(mock_fn, retries=2, telemetry_ctx=ctx)\n\n    mock_persist.assert_called_once()\n    _, kwargs = mock_persist.call_args\n    assert kwargs[\"status\"] == \"error\"\n    assert kwargs[\"duration_ms\"] > 0\n\n\ndef test_invoke_with_retry_no_telemetry_ctx_does_not_call_persist():\n    \"\"\"When telemetry_ctx is None, persist_llm_call is never called.\"\"\"\n    from quantagent.agent_utils import invoke_with_retry\n\n    mock_fn = MagicMock(return_value=\"ok\")\n\n    with patch(\"quantagent.llm_telemetry.persist_llm_call\") as mock_persist:\n        invoke_with_retry(mock_fn)\n\n    mock_persist.assert_not_called()\n","numLines":577,"startLine":1,"totalLines":577}}}
