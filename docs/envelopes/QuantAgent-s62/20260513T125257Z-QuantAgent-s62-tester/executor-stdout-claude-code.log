{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012eNEwSeJaK7Jf5VP7mmDBW","type":"tool_result","content":"1\tfrom __future__ import annotations\n2\t\n3\timport os\n4\tfrom dataclasses import dataclass\n5\tfrom typing import Any, Optional\n6\t\n7\timport streamlit as st\n8\t\n9\t\n10\t@dataclass\n11\tclass DbHandle:\n12\t    ok: bool\n13\t    error: Optional[str]\n14\t    SessionLocal: Any = None\n15\t    models: Any = None\n16\t\n17\t    def get_latest_heartbeat(self, environment: str) -> Optional[dict]:\n18\t        \"\"\"\n19\t        Get the latest scheduler heartbeat for an environment.\n20\t\n21\t        Args:\n22\t            environment: Environment name (paper/prod/backtest)\n23\t\n24\t        Returns:\n25\t            Dict with heartbeat data or None\n26\t        \"\"\"\n27\t        if not self.ok:\n28\t            return None\n29\t\n30\t        try:\n31\t            from quantagent.models import Environment, SchedulerHeartbeat\n32\t\n33\t            with self.SessionLocal() as session:\n34\t                hb = (\n35\t                    session.query(SchedulerHeartbeat)\n36\t                    .filter_by(environment=Environment(environment))\n37\t                    .order_by(SchedulerHeartbeat.timestamp.desc())\n38\t                    .first()\n39\t                )\n40\t\n41\t                if not hb:\n42\t                    return None\n43\t\n44\t                return {\n45\t                    \"id\": hb.id,\n46\t                    \"timestamp\": hb.timestamp,\n47\t                    \"completed_at\": hb.completed_at,\n48\t                    \"status\": hb.status,\n49\t                    \"environment\": hb.environment.value,\n50\t                    \"assets\": hb.assets,\n51\t                    \"stats\": hb.stats,\n52\t                    \"last_trade_id\": hb.last_trade_id,\n53\t                    \"error_message\": hb.error_message,\n54\t                }\n55\t        except Exception:\n56\t            # Table may not exist yet (pre-migration)\n57\t            return None\n58\t\n59\t    def get_recent_heartbeats(\n60\t        self, environment: str, limit: int = 10\n61\t    ) -> list[dict]:\n62\t        \"\"\"\n63\t        Get recent scheduler heartbeats for an environment.\n64\t\n65\t        Args:\n66\t            environment: Environment name (paper/prod/backtest)\n67\t            limit: Maximum number of heartbeats to return\n68\t\n69\t        Returns:\n70\t            List of heartbeat dicts (most recent first)\n71\t        \"\"\"\n72\t        if not self.ok:\n73\t            return []\n74\t\n75\t        try:\n76\t            from quantagent.models import Environment, SchedulerHeartbeat\n77\t\n78\t            with self.SessionLocal() as session:\n79\t                heartbeats = (\n80\t                    session.query(SchedulerHeartbeat)\n81\t                    .filter_by(environment=Environment(environment))\n82\t                    .order_by(SchedulerHeartbeat.timestamp.desc())\n83\t                    .limit(limit)\n84\t                    .all()\n85\t                )\n86\t\n87\t                return [\n88\t                    {\n89\t                        \"id\": hb.id,\n90\t                        \"timestamp\": hb.timestamp,\n91\t                        \"completed_at\": hb.completed_at,\n92\t                        \"status\": hb.status,\n93\t                        \"environment\": hb.environment.value,\n94\t                        \"assets\": hb.assets,\n95\t                        \"stats\": hb.stats,\n96\t                        \"last_trade_id\": hb.last_trade_id,\n97\t                        \"error_message\": hb.error_message,\n98\t                    }\n99\t                    for hb in heartbeats\n100\t                ]\n101\t        except Exception:\n102\t            # Table may not exist yet (pre-migration)\n103\t            return []\n104\t\n105\t\n106\t    def get_paper_llm_metrics(self, environment: str, hours_back: int = 24) -> dict:\n107\t        \"\"\"\n108\t        Return aggregated LLM telemetry metrics for a given environment.\n109\t\n110\t        Args:\n111\t            environment: Environment string (e.g. 'paper', 'backtest').\n112\t            hours_back: Time window in hours (default 24).\n113\t\n114\t        Returns:\n115\t            Aggregate dict or empty dict on failure / no DB.\n116\t        \"\"\"\n117\t        if not self.ok:\n118\t            return {}\n119\t        try:\n120\t            from quantagent.llm_telemetry import get_environment_metrics\n121\t\n122\t            with self.SessionLocal() as session:\n123\t                return get_environment_metrics(session, environment, hours_back)\n124\t        except Exception:\n125\t            return {}\n126\t\n127\t\n128\t@st.cache_resource(show_spinner=False)\n129\tdef get_db_handle() -> DbHandle:\n130\t    \"\"\"Try to import DB session and models. Return a handle or an error.\n131\t\n132\t    Handles missing DATABASE_URL gracefully to keep UI usable without DB.\n133\t    \"\"\"\n134\t    try:\n135\t        db_url = os.getenv(\"DATABASE_URL\")\n136\t        if not db_url:\n137\t            return DbHandle(\n138\t                False, \"DATABASE_URL is not set. See docs/MIGRATIONS.md to configure.\"\n139\t            )\n140\t\n141\t        import quantagent.models as models  # type: ignore\n142\t        from quantagent.database import SessionLocal  # type: ignore\n143\t\n144\t        # Try opening a session to validate connectivity\n145\t        try:\n146\t            s = SessionLocal()\n147\t            s.close()\n148\t        except Exception as e:  # pragma: no cover\n149\t            return DbHandle(False, f\"DB connection error: {e}\")\n150\t\n151\t        return DbHandle(True, None, SessionLocal=SessionLocal, models=models)\n152\t    except Exception as e:  # pragma: no cover\n153\t        return DbHandle(False, f\"DB import error: {e}\")\n154\t"}]},"parent_tool_use_id":null,"session_id":"e886872b-4bb6-48e1-bec6-42e1776647f7","uuid":"b9e71b17-af42-4300-9656-8864b81029e2","timestamp":"2026-05-13T12:53:45.005Z","tool_use_result":{"type":"text","file":{"filePath":"/mnt/actions-runner/autodev-runtime/worktrees/QuantAgent/QuantAgent-s62/implementer-20260513T124414Z/apps/streamlit/services/db.py","content":"from __future__ import annotations\n\nimport os\nfrom dataclasses import dataclass\nfrom typing import Any, Optional\n\nimport streamlit as st\n\n\n@dataclass\nclass DbHandle:\n    ok: bool\n    error: Optional[str]\n    SessionLocal: Any = None\n    models: Any = None\n\n    def get_latest_heartbeat(self, environment: str) -> Optional[dict]:\n        \"\"\"\n        Get the latest scheduler heartbeat for an environment.\n\n        Args:\n            environment: Environment name (paper/prod/backtest)\n\n        Returns:\n            Dict with heartbeat data or None\n        \"\"\"\n        if not self.ok:\n            return None\n\n        try:\n            from quantagent.models import Environment, SchedulerHeartbeat\n\n            with self.SessionLocal() as session:\n                hb = (\n                    session.query(SchedulerHeartbeat)\n                    .filter_by(environment=Environment(environment))\n                    .order_by(SchedulerHeartbeat.timestamp.desc())\n                    .first()\n                )\n\n                if not hb:\n                    return None\n\n                return {\n                    \"id\": hb.id,\n                    \"timestamp\": hb.timestamp,\n                    \"completed_at\": hb.completed_at,\n                    \"status\": hb.status,\n                    \"environment\": hb.environment.value,\n                    \"assets\": hb.assets,\n                    \"stats\": hb.stats,\n                    \"last_trade_id\": hb.last_trade_id,\n                    \"error_message\": hb.error_message,\n                }\n        except Exception:\n            # Table may not exist yet (pre-migration)\n            return None\n\n    def get_recent_heartbeats(\n        self, environment: str, limit: int = 10\n    ) -> list[dict]:\n        \"\"\"\n        Get recent scheduler heartbeats for an environment.\n\n        Args:\n            environment: Environment name (paper/prod/backtest)\n            limit: Maximum number of heartbeats to return\n\n        Returns:\n            List of heartbeat dicts (most recent first)\n        \"\"\"\n        if not self.ok:\n            return []\n\n        try:\n            from quantagent.models import Environment, SchedulerHeartbeat\n\n            with self.SessionLocal() as session:\n                heartbeats = (\n                    session.query(SchedulerHeartbeat)\n                    .filter_by(environment=Environment(environment))\n                    .order_by(SchedulerHeartbeat.timestamp.desc())\n                    .limit(limit)\n                    .all()\n                )\n\n                return [\n                    {\n                        \"id\": hb.id,\n                        \"timestamp\": hb.timestamp,\n                        \"completed_at\": hb.completed_at,\n                        \"status\": hb.status,\n                        \"environment\": hb.environment.value,\n                        \"assets\": hb.assets,\n                        \"stats\": hb.stats,\n                        \"last_trade_id\": hb.last_trade_id,\n                        \"error_message\": hb.error_message,\n                    }\n                    for hb in heartbeats\n                ]\n        except Exception:\n            # Table may not exist yet (pre-migration)\n            return []\n\n\n    def get_paper_llm_metrics(self, environment: str, hours_back: int = 24) -> dict:\n        \"\"\"\n        Return aggregated LLM telemetry metrics for a given environment.\n\n        Args:\n            environment: Environment string (e.g. 'paper', 'backtest').\n            hours_back: Time window in hours (default 24).\n\n        Returns:\n            Aggregate dict or empty dict on failure / no DB.\n        \"\"\"\n        if not self.ok:\n            return {}\n        try:\n            from quantagent.llm_telemetry import get_environment_metrics\n\n            with self.SessionLocal() as session:\n                return get_environment_metrics(session, environment, hours_back)\n        except Exception:\n            return {}\n\n\n@st.cache_resource(show_spinner=False)\ndef get_db_handle() -> DbHandle:\n    \"\"\"Try to import DB session and models. Return a handle or an error.\n\n    Handles missing DATABASE_URL gracefully to keep UI usable without DB.\n    \"\"\"\n    try:\n        db_url = os.getenv(\"DATABASE_URL\")\n        if not db_url:\n            return DbHandle(\n                False, \"DATABASE_URL is not set. See docs/MIGRATIONS.md to configure.\"\n            )\n\n        import quantagent.models as models  # type: ignore\n        from quantagent.database import SessionLocal  # type: ignore\n\n        # Try opening a session to validate connectivity\n        try:\n            s = SessionLocal()\n            s.close()\n        except Exception as e:  # pragma: no cover\n            return DbHandle(False, f\"DB connection error: {e}\")\n\n        return DbHandle(True, None, SessionLocal=SessionLocal, models=models)\n    except Exception as e:  # pragma: no cover\n        return DbHandle(False, f\"DB import error: {e}\")\n","numLines":154,"startLine":1,"totalLines":154}}}
