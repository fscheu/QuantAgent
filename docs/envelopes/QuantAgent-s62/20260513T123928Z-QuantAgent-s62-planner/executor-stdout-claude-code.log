{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01Y39CgsARTwDaHdUvhZ3oYY","type":"tool_result","content":"1\tfrom __future__ import annotations\n2\t\n3\tfrom datetime import datetime\n4\t\n5\timport streamlit as st\n6\t\n7\tfrom apps.streamlit.utils.ui import df_from_query\n8\t\n9\t\n10\tdef _to_float(value) -> float:\n11\t    try:\n12\t        return float(value)\n13\t    except Exception:\n14\t        return 0.0\n15\t\n16\t\n17\tdef render(db, environment: str) -> None:\n18\t    st.subheader(\"Dashboard\")\n19\t\n20\t    kpi1, kpi2, kpi3, kpi4, kpi5 = st.columns(5)\n21\t    total_value = \"-\"\n22\t    daily_pnl = \"-\"\n23\t    win_rate = \"-\"\n24\t    open_positions = 0\n25\t    open_orders = 0\n26\t\n27\t    if db.ok:\n28\t        SessionLocal = db.SessionLocal\n29\t        models = db.models\n30\t        with SessionLocal() as s:\n31\t            try:\n32\t                open_positions = s.query(models.Position).count()\n33\t                open_orders = (\n34\t                    s.query(models.Order)\n35\t                    .filter(models.Order.environment == environment)\n36\t                    .count()\n37\t                )\n38\t                trades_query = s.query(models.Trade).filter(\n39\t                    models.Trade.environment == environment\n40\t                )\n41\t                trades_total = trades_query.count()\n42\t                if trades_total:\n43\t                    wins = (\n44\t                        trades_query.filter(models.Trade.pnl.isnot(None))\n45\t                        .filter(models.Trade.pnl > 0)\n46\t                        .count()\n47\t                    )\n48\t                    win_rate = f\"{(wins / max(trades_total, 1)) * 100:.1f}%\"\n49\t\n50\t                today_start = datetime.combine(\n51\t                    datetime.utcnow().date(), datetime.min.time()\n52\t                )\n53\t                daily_trades = (\n54\t                    trades_query.filter(models.Trade.closed_at.isnot(None))\n55\t                    .filter(models.Trade.closed_at >= today_start)\n56\t                    .all()\n57\t                )\n58\t                if daily_trades:\n59\t                    pnl_value = sum(\n60\t                        _to_float(t.pnl) for t in daily_trades if t.pnl is not None\n61\t                    )\n62\t                    daily_pnl = f\"${pnl_value:,.2f}\"\n63\t\n64\t                positions = s.query(models.Position).all()\n65\t                portfolio_value = sum(\n66\t                    _to_float(p.current_price) * _to_float(p.quantity)\n67\t                    for p in positions\n68\t                )\n69\t                if portfolio_value:\n70\t                    total_value = f\"${portfolio_value:,.2f}\"\n71\t            except Exception:\n72\t                pass\n73\t\n74\t    kpi1.metric(\"Portfolio Value\", total_value)\n75\t    kpi2.metric(\"Daily P&L\", daily_pnl)\n76\t    kpi3.metric(\"Win Rate\", win_rate)\n77\t    kpi4.metric(\"Open Positions\", open_positions)\n78\t    kpi5.metric(\"Open Orders\", open_orders)\n79\t\n80\t    st.divider()\n81\t\n82\t    colA, colB = st.columns(2)\n83\t    with colA:\n84\t        st.markdown(\"**Recent Trades**\")\n85\t        if db.ok:\n86\t            with db.SessionLocal() as s:\n87\t                try:\n88\t                    q = (\n89\t                        s.query(db.models.Trade)\n90\t                        .filter(db.models.Trade.environment == environment)\n91\t                        .order_by(db.models.Trade.opened_at.desc())\n92\t                        .limit(50)\n93\t                        .all()\n94\t                    )\n95\t                    st.dataframe(df_from_query(q), width='stretch')\n96\t                except Exception as e:\n97\t                    st.info(f\"No trades or error reading trades: {e}\")\n98\t        else:\n99\t            st.info(\"Connect DB to view trades.\")\n100\t\n101\t    with colB:\n102\t        st.markdown(\"**Scheduler Status**\")\n103\t        st.write(\"Status: unknown (MVP placeholder)\")\n104\t        st.write(\"Next run: -  | Last run: -  | Errors: -\")\n105\t"}]},"parent_tool_use_id":null,"session_id":"2c1e0874-30df-4cf1-a542-6d2be6b4889e","uuid":"6085ab01-d22a-4397-99c5-984dbf4a9975","timestamp":"2026-05-13T12:40:26.963Z","tool_use_result":{"type":"text","file":{"filePath":"/home/azureuser/repos/projects/QuantAgent/apps/streamlit/views/dashboard.py","content":"from __future__ import annotations\n\nfrom datetime import datetime\n\nimport streamlit as st\n\nfrom apps.streamlit.utils.ui import df_from_query\n\n\ndef _to_float(value) -> float:\n    try:\n        return float(value)\n    except Exception:\n        return 0.0\n\n\ndef render(db, environment: str) -> None:\n    st.subheader(\"Dashboard\")\n\n    kpi1, kpi2, kpi3, kpi4, kpi5 = st.columns(5)\n    total_value = \"-\"\n    daily_pnl = \"-\"\n    win_rate = \"-\"\n    open_positions = 0\n    open_orders = 0\n\n    if db.ok:\n        SessionLocal = db.SessionLocal\n        models = db.models\n        with SessionLocal() as s:\n            try:\n                open_positions = s.query(models.Position).count()\n                open_orders = (\n                    s.query(models.Order)\n                    .filter(models.Order.environment == environment)\n                    .count()\n                )\n                trades_query = s.query(models.Trade).filter(\n                    models.Trade.environment == environment\n                )\n                trades_total = trades_query.count()\n                if trades_total:\n                    wins = (\n                        trades_query.filter(models.Trade.pnl.isnot(None))\n                        .filter(models.Trade.pnl > 0)\n                        .count()\n                    )\n                    win_rate = f\"{(wins / max(trades_total, 1)) * 100:.1f}%\"\n\n                today_start = datetime.combine(\n                    datetime.utcnow().date(), datetime.min.time()\n                )\n                daily_trades = (\n                    trades_query.filter(models.Trade.closed_at.isnot(None))\n                    .filter(models.Trade.closed_at >= today_start)\n                    .all()\n                )\n                if daily_trades:\n                    pnl_value = sum(\n                        _to_float(t.pnl) for t in daily_trades if t.pnl is not None\n                    )\n                    daily_pnl = f\"${pnl_value:,.2f}\"\n\n                positions = s.query(models.Position).all()\n                portfolio_value = sum(\n                    _to_float(p.current_price) * _to_float(p.quantity)\n                    for p in positions\n                )\n                if portfolio_value:\n                    total_value = f\"${portfolio_value:,.2f}\"\n            except Exception:\n                pass\n\n    kpi1.metric(\"Portfolio Value\", total_value)\n    kpi2.metric(\"Daily P&L\", daily_pnl)\n    kpi3.metric(\"Win Rate\", win_rate)\n    kpi4.metric(\"Open Positions\", open_positions)\n    kpi5.metric(\"Open Orders\", open_orders)\n\n    st.divider()\n\n    colA, colB = st.columns(2)\n    with colA:\n        st.markdown(\"**Recent Trades**\")\n        if db.ok:\n            with db.SessionLocal() as s:\n                try:\n                    q = (\n                        s.query(db.models.Trade)\n                        .filter(db.models.Trade.environment == environment)\n                        .order_by(db.models.Trade.opened_at.desc())\n                        .limit(50)\n                        .all()\n                    )\n                    st.dataframe(df_from_query(q), width='stretch')\n                except Exception as e:\n                    st.info(f\"No trades or error reading trades: {e}\")\n        else:\n            st.info(\"Connect DB to view trades.\")\n\n    with colB:\n        st.markdown(\"**Scheduler Status**\")\n        st.write(\"Status: unknown (MVP placeholder)\")\n        st.write(\"Next run: -  | Last run: -  | Errors: -\")\n","numLines":105,"startLine":1,"totalLines":105}}}
