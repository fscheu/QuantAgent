{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01McBUXQtMEyLR7EcJGQumzF","type":"tool_result","content":"1\t\"\"\"Paper Trading Scheduler monitoring view for Streamlit dashboard.\"\"\"\n2\t\n3\tfrom __future__ import annotations\n4\t\n5\tfrom datetime import datetime, timedelta\n6\tfrom typing import Optional\n7\t\n8\timport streamlit as st\n9\t\n10\t\n11\tdef _calculate_status(heartbeat: Optional[dict]) -> tuple[str, str]:\n12\t    \"\"\"\n13\t    Calculate scheduler status based on last heartbeat.\n14\t\n15\t    Args:\n16\t        heartbeat: Latest heartbeat dict or None\n17\t\n18\t    Returns:\n19\t        Tuple of (status_emoji, status_text)\n20\t    \"\"\"\n21\t    if not heartbeat:\n22\t        return (\"🔴\", \"Stopped\")\n23\t\n24\t    last_run = heartbeat.get(\"timestamp\")\n25\t    if not last_run:\n26\t        return (\"🔴\", \"Stopped\")\n27\t\n28\t    # Calculate time since last run\n29\t    now = datetime.utcnow()\n30\t    if isinstance(last_run, str):\n31\t        last_run = datetime.fromisoformat(last_run.replace(\"Z\", \"+00:00\"))\n32\t\n33\t    time_since = now - last_run\n34\t\n35\t    # Status thresholds from design doc\n36\t    if time_since < timedelta(hours=2):\n37\t        return (\"🟢\", \"Active\")\n38\t    elif time_since < timedelta(hours=24):\n39\t        return (\"🟡\", \"Stale\")\n40\t    else:\n41\t        return (\"🔴\", \"Stopped\")\n42\t\n43\t\n44\tdef _humanize_time(dt: Optional[datetime | str]) -> str:\n45\t    \"\"\"\n46\t    Convert datetime to human-readable relative time.\n47\t\n48\t    Args:\n49\t        dt: Datetime object or ISO string\n50\t\n51\t    Returns:\n52\t        Human-readable string like \"2 minutes ago\"\n53\t    \"\"\"\n54\t    if not dt:\n55\t        return \"Never\"\n56\t\n57\t    if isinstance(dt, str):\n58\t        try:\n59\t            dt = datetime.fromisoformat(dt.replace(\"Z\", \"+00:00\"))\n60\t        except Exception:\n61\t            return \"Unknown\"\n62\t\n63\t    now = datetime.utcnow()\n64\t    delta = now - dt\n65\t\n66\t    if delta < timedelta(minutes=1):\n67\t        return \"Just now\"\n68\t    elif delta < timedelta(hours=1):\n69\t        minutes = int(delta.total_seconds() / 60)\n70\t        return f\"{minutes} minute{'s' if minutes != 1 else ''} ago\"\n71\t    elif delta < timedelta(days=1):\n72\t        hours = int(delta.total_seconds() / 3600)\n73\t        return f\"{hours} hour{'s' if hours != 1 else ''} ago\"\n74\t    else:\n75\t        days = int(delta.days)\n76\t        return f\"{days} day{'s' if days != 1 else ''} ago\"\n77\t\n78\t\n79\tdef _calculate_duration(heartbeat: dict) -> str:\n80\t    \"\"\"\n81\t    Calculate cycle duration from heartbeat.\n82\t\n83\t    Args:\n84\t        heartbeat: Heartbeat dict\n85\t\n86\t    Returns:\n87\t        Duration string like \"3.5s\" or from stats if available\n88\t    \"\"\"\n89\t    stats = heartbeat.get(\"stats\")\n90\t    if stats and \"duration_seconds\" in stats:\n91\t        duration_s = stats[\"duration_seconds\"]\n92\t        if duration_s < 60:\n93\t            return f\"{duration_s:.1f}s\"\n94\t        else:\n95\t            return f\"{duration_s / 60:.1f}m\"\n96\t\n97\t    # Fallback: calculate from timestamp and completed_at\n98\t    timestamp = heartbeat.get(\"timestamp\")\n99\t    completed_at = heartbeat.get(\"completed_at\")\n100\t\n101\t    if timestamp and completed_at:\n102\t        if isinstance(timestamp, str):\n103\t            timestamp = datetime.fromisoformat(timestamp.replace(\"Z\", \"+00:00\"))\n104\t        if isinstance(completed_at, str):\n105\t            completed_at = datetime.fromisoformat(completed_at.replace(\"Z\", \"+00:00\"))\n106\t\n107\t        duration = (completed_at - timestamp).total_seconds()\n108\t        if duration < 60:\n109\t            return f\"{duration:.1f}s\"\n110\t        else:\n111\t            return f\"{duration / 60:.1f}m\"\n112\t\n113\t    return \"Unknown\"\n114\t\n115\t\n116\tdef _render_status_card(heartbeat: dict) -> None:\n117\t    \"\"\"\n118\t    Render status card with key metrics.\n119\t\n120\t    Args:\n121\t        heartbeat: Latest heartbeat dict\n122\t    \"\"\"\n123\t    status_emoji, status_text = _calculate_status(heartbeat)\n124\t\n125\t    col1, col2, col3, col4 = st.columns(4)\n126\t\n127\t    with col1:\n128\t        st.metric(\"Status\", f\"{status_emoji} {status_text}\")\n129\t\n130\t    with col2:\n131\t        last_run = heartbeat.get(\"timestamp\")\n132\t        st.metric(\"Last Run\", _humanize_time(last_run))\n133\t\n134\t    with col3:\n135\t        stats = heartbeat.get(\"stats\", {})\n136\t        processed = stats.get(\"processed\", 0)\n137\t        total = stats.get(\"total\", 0)\n138\t        st.metric(\"Assets Processed\", f\"{processed}/{total}\")\n139\t\n140\t    with col4:\n141\t        duration = _calculate_duration(heartbeat)\n142\t        st.metric(\"Last Duration\", duration)\n143\t\n144\t\n145\tdef _render_recent_runs(recent: list[dict]) -> None:\n146\t    \"\"\"\n147\t    Render table of recent scheduler runs.\n148\t\n149\t    Args:\n150\t        recent: List of recent heartbeat dicts\n151\t    \"\"\"\n152\t    st.subheader(\"Recent Runs\")\n153\t\n154\t    if not recent:\n155\t        st.info(\"No recent runs found\")\n156\t        return\n157\t\n158\t    # Build table data\n159\t    table_data = []\n160\t    for hb in recent:\n161\t        timestamp = hb.get(\"timestamp\")\n162\t        if isinstance(timestamp, str):\n163\t            try:\n164\t                timestamp = datetime.fromisoformat(timestamp.replace(\"Z\", \"+00:00\"))\n165\t                time_str = timestamp.strftime(\"%Y-%m-%d %H:%M:%S\")\n166\t            except Exception:\n167\t                time_str = str(timestamp)\n168\t        else:\n169\t            time_str = str(timestamp)\n170\t\n171\t        stats = hb.get(\"stats\", {})\n172\t        status = hb.get(\"status\", \"unknown\")\n173\t        processed = stats.get(\"processed\", 0)\n174\t        errors = stats.get(\"errors\", 0)\n175\t        duration = _calculate_duration(hb)\n176\t\n177\t        # Status emoji\n178\t        if status == \"completed\":\n179\t            status_icon = \"✅\"\n180\t        elif status == \"running\":\n181\t            status_icon = \"⏳\"\n182\t        elif status == \"error\":\n183\t            status_icon = \"❌\"\n184\t        else:\n185\t            status_icon = \"❓\"\n186\t\n187\t        table_data.append(\n188\t            {\n189\t                \"Time\": time_str,\n190\t                \"Status\": f\"{status_icon} {status}\",\n191\t                \"Processed\": f\"{processed}/{stats.get('total', 0)}\",\n192\t                \"Errors\": errors,\n193\t                \"Duration\": duration,\n194\t            }\n195\t        )\n196\t\n197\t    st.dataframe(table_data, use_container_width=True)\n198\t\n199\t\n200\tdef render(db, environment: str) -> None:\n201\t    \"\"\"\n202\t    Main render function for Paper Trading tab.\n203\t\n204\t    Args:\n205\t        db: Database service\n206\t        environment: Current environment (paper/prod/backtest)\n207\t    \"\"\"\n208\t    st.header(\"📊 Paper Trading Scheduler\")\n209\t\n210\t    if not db.ok:\n211\t        st.error(\"❌ Database not available\")\n212\t        st.info(\"Please check database connection and try again.\")\n213\t        return\n214\t\n215\t    # Get latest heartbeat\n216\t    heartbeat = db.get_latest_heartbeat(environment)\n217\t\n218\t    if not heartbeat:\n219\t        st.warning(\"⚠️ No scheduler heartbeat found\")\n220\t        st.info(\n221\t            f\"The scheduler may not be running, or no cycles have completed yet for environment: **{environment}**\"\n222\t        )\n223\t        st.markdown(\"---\")\n224\t        st.markdown(\"**How to start the scheduler:**\")\n225\t        st.code(\"python apps/paper_trading.py\", language=\"bash\")\n226\t        return\n227\t\n228\t    # Render status card\n229\t    _render_status_card(heartbeat)\n230\t\n231\t    st.divider()\n232\t\n233\t    # Render recent runs\n234\t    recent = db.get_recent_heartbeats(environment, limit=10)\n235\t    _render_recent_runs(recent)\n236\t\n237\t    # Optional: Show last trade link\n238\t    last_trade_id = heartbeat.get(\"last_trade_id\")\n239\t    if last_trade_id:\n240\t        st.divider()\n241\t        st.markdown(f\"**Last Trade ID:** {last_trade_id}\")\n242\t"}]},"parent_tool_use_id":null,"session_id":"e4ffb124-556a-4a26-b5a1-3a5ae3b4c5ab","uuid":"a948647c-2dc3-4e32-9ad4-46ad19cac2be","timestamp":"2026-05-13T12:44:50.120Z","tool_use_result":{"type":"text","file":{"filePath":"/mnt/actions-runner/autodev-runtime/worktrees/QuantAgent/QuantAgent-s62/implementer-20260513T124414Z/apps/streamlit/views/paper_trading.py","content":"\"\"\"Paper Trading Scheduler monitoring view for Streamlit dashboard.\"\"\"\n\nfrom __future__ import annotations\n\nfrom datetime import datetime, timedelta\nfrom typing import Optional\n\nimport streamlit as st\n\n\ndef _calculate_status(heartbeat: Optional[dict]) -> tuple[str, str]:\n    \"\"\"\n    Calculate scheduler status based on last heartbeat.\n\n    Args:\n        heartbeat: Latest heartbeat dict or None\n\n    Returns:\n        Tuple of (status_emoji, status_text)\n    \"\"\"\n    if not heartbeat:\n        return (\"🔴\", \"Stopped\")\n\n    last_run = heartbeat.get(\"timestamp\")\n    if not last_run:\n        return (\"🔴\", \"Stopped\")\n\n    # Calculate time since last run\n    now = datetime.utcnow()\n    if isinstance(last_run, str):\n        last_run = datetime.fromisoformat(last_run.replace(\"Z\", \"+00:00\"))\n\n    time_since = now - last_run\n\n    # Status thresholds from design doc\n    if time_since < timedelta(hours=2):\n        return (\"🟢\", \"Active\")\n    elif time_since < timedelta(hours=24):\n        return (\"🟡\", \"Stale\")\n    else:\n        return (\"🔴\", \"Stopped\")\n\n\ndef _humanize_time(dt: Optional[datetime | str]) -> str:\n    \"\"\"\n    Convert datetime to human-readable relative time.\n\n    Args:\n        dt: Datetime object or ISO string\n\n    Returns:\n        Human-readable string like \"2 minutes ago\"\n    \"\"\"\n    if not dt:\n        return \"Never\"\n\n    if isinstance(dt, str):\n        try:\n            dt = datetime.fromisoformat(dt.replace(\"Z\", \"+00:00\"))\n        except Exception:\n            return \"Unknown\"\n\n    now = datetime.utcnow()\n    delta = now - dt\n\n    if delta < timedelta(minutes=1):\n        return \"Just now\"\n    elif delta < timedelta(hours=1):\n        minutes = int(delta.total_seconds() / 60)\n        return f\"{minutes} minute{'s' if minutes != 1 else ''} ago\"\n    elif delta < timedelta(days=1):\n        hours = int(delta.total_seconds() / 3600)\n        return f\"{hours} hour{'s' if hours != 1 else ''} ago\"\n    else:\n        days = int(delta.days)\n        return f\"{days} day{'s' if days != 1 else ''} ago\"\n\n\ndef _calculate_duration(heartbeat: dict) -> str:\n    \"\"\"\n    Calculate cycle duration from heartbeat.\n\n    Args:\n        heartbeat: Heartbeat dict\n\n    Returns:\n        Duration string like \"3.5s\" or from stats if available\n    \"\"\"\n    stats = heartbeat.get(\"stats\")\n    if stats and \"duration_seconds\" in stats:\n        duration_s = stats[\"duration_seconds\"]\n        if duration_s < 60:\n            return f\"{duration_s:.1f}s\"\n        else:\n            return f\"{duration_s / 60:.1f}m\"\n\n    # Fallback: calculate from timestamp and completed_at\n    timestamp = heartbeat.get(\"timestamp\")\n    completed_at = heartbeat.get(\"completed_at\")\n\n    if timestamp and completed_at:\n        if isinstance(timestamp, str):\n            timestamp = datetime.fromisoformat(timestamp.replace(\"Z\", \"+00:00\"))\n        if isinstance(completed_at, str):\n            completed_at = datetime.fromisoformat(completed_at.replace(\"Z\", \"+00:00\"))\n\n        duration = (completed_at - timestamp).total_seconds()\n        if duration < 60:\n            return f\"{duration:.1f}s\"\n        else:\n            return f\"{duration / 60:.1f}m\"\n\n    return \"Unknown\"\n\n\ndef _render_status_card(heartbeat: dict) -> None:\n    \"\"\"\n    Render status card with key metrics.\n\n    Args:\n        heartbeat: Latest heartbeat dict\n    \"\"\"\n    status_emoji, status_text = _calculate_status(heartbeat)\n\n    col1, col2, col3, col4 = st.columns(4)\n\n    with col1:\n        st.metric(\"Status\", f\"{status_emoji} {status_text}\")\n\n    with col2:\n        last_run = heartbeat.get(\"timestamp\")\n        st.metric(\"Last Run\", _humanize_time(last_run))\n\n    with col3:\n        stats = heartbeat.get(\"stats\", {})\n        processed = stats.get(\"processed\", 0)\n        total = stats.get(\"total\", 0)\n        st.metric(\"Assets Processed\", f\"{processed}/{total}\")\n\n    with col4:\n        duration = _calculate_duration(heartbeat)\n        st.metric(\"Last Duration\", duration)\n\n\ndef _render_recent_runs(recent: list[dict]) -> None:\n    \"\"\"\n    Render table of recent scheduler runs.\n\n    Args:\n        recent: List of recent heartbeat dicts\n    \"\"\"\n    st.subheader(\"Recent Runs\")\n\n    if not recent:\n        st.info(\"No recent runs found\")\n        return\n\n    # Build table data\n    table_data = []\n    for hb in recent:\n        timestamp = hb.get(\"timestamp\")\n        if isinstance(timestamp, str):\n            try:\n                timestamp = datetime.fromisoformat(timestamp.replace(\"Z\", \"+00:00\"))\n                time_str = timestamp.strftime(\"%Y-%m-%d %H:%M:%S\")\n            except Exception:\n                time_str = str(timestamp)\n        else:\n            time_str = str(timestamp)\n\n        stats = hb.get(\"stats\", {})\n        status = hb.get(\"status\", \"unknown\")\n        processed = stats.get(\"processed\", 0)\n        errors = stats.get(\"errors\", 0)\n        duration = _calculate_duration(hb)\n\n        # Status emoji\n        if status == \"completed\":\n            status_icon = \"✅\"\n        elif status == \"running\":\n            status_icon = \"⏳\"\n        elif status == \"error\":\n            status_icon = \"❌\"\n        else:\n            status_icon = \"❓\"\n\n        table_data.append(\n            {\n                \"Time\": time_str,\n                \"Status\": f\"{status_icon} {status}\",\n                \"Processed\": f\"{processed}/{stats.get('total', 0)}\",\n                \"Errors\": errors,\n                \"Duration\": duration,\n            }\n        )\n\n    st.dataframe(table_data, use_container_width=True)\n\n\ndef render(db, environment: str) -> None:\n    \"\"\"\n    Main render function for Paper Trading tab.\n\n    Args:\n        db: Database service\n        environment: Current environment (paper/prod/backtest)\n    \"\"\"\n    st.header(\"📊 Paper Trading Scheduler\")\n\n    if not db.ok:\n        st.error(\"❌ Database not available\")\n        st.info(\"Please check database connection and try again.\")\n        return\n\n    # Get latest heartbeat\n    heartbeat = db.get_latest_heartbeat(environment)\n\n    if not heartbeat:\n        st.warning(\"⚠️ No scheduler heartbeat found\")\n        st.info(\n            f\"The scheduler may not be running, or no cycles have completed yet for environment: **{environment}**\"\n        )\n        st.markdown(\"---\")\n        st.markdown(\"**How to start the scheduler:**\")\n        st.code(\"python apps/paper_trading.py\", language=\"bash\")\n        return\n\n    # Render status card\n    _render_status_card(heartbeat)\n\n    st.divider()\n\n    # Render recent runs\n    recent = db.get_recent_heartbeats(environment, limit=10)\n    _render_recent_runs(recent)\n\n    # Optional: Show last trade link\n    last_trade_id = heartbeat.get(\"last_trade_id\")\n    if last_trade_id:\n        st.divider()\n        st.markdown(f\"**Last Trade ID:** {last_trade_id}\")\n","numLines":242,"startLine":1,"totalLines":242}}}
