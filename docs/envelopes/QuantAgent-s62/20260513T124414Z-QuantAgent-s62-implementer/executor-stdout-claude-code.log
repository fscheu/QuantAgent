{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01APYMwjKKZU1oasvuefruwo","type":"tool_result","content":"1\tfrom __future__ import annotations\n2\t\n3\tfrom datetime import datetime, timedelta\n4\t\n5\timport streamlit as st\n6\t\n7\tfrom apps.streamlit.utils.ui import df_from_query\n8\t\n9\t\n10\tdef render(db) -> None:\n11\t    st.subheader(\"Logs\")\n12\t\n13\t    if not db.ok:\n14\t        st.info(\"Connect DB to view logs.\")\n15\t        return\n16\t\n17\t    # Filters\n18\t    col1, col2, col3, col4 = st.columns(4)\n19\t\n20\t    with col1:\n21\t        selected_levels = st.multiselect(\n22\t            \"Log Level\",\n23\t            options=[\"DEBUG\", \"INFO\", \"WARNING\", \"ERROR\", \"CRITICAL\"],\n24\t            default=[\"INFO\", \"WARNING\", \"ERROR\", \"CRITICAL\"],\n25\t        )\n26\t\n27\t    with col2:\n28\t        symbol_filter = st.text_input(\"Symbol (contains)\", value=\"\")\n29\t\n30\t    with col3:\n31\t        event_type_filter = st.text_input(\"Event Type (contains)\", value=\"\")\n32\t\n33\t    with col4:\n34\t        hours_back = st.number_input(\n35\t            \"Hours Back\", min_value=1, max_value=168, value=24\n36\t        )\n37\t\n38\t    # Query logs with filters\n39\t    with db.SessionLocal() as session:\n40\t        try:\n41\t            cutoff_time = datetime.utcnow() - timedelta(hours=hours_back)\n42\t\n43\t            query = session.query(db.models.Log).filter(\n44\t                db.models.Log.timestamp >= cutoff_time\n45\t            )\n46\t\n47\t            if selected_levels:\n48\t                query = query.filter(db.models.Log.level.in_(selected_levels))\n49\t\n50\t            if symbol_filter:\n51\t                query = query.filter(\n52\t                    db.models.Log.symbol.ilike(f\"%{symbol_filter}%\")\n53\t                )\n54\t\n55\t            if event_type_filter:\n56\t                query = query.filter(\n57\t                    db.models.Log.event_type.ilike(f\"%{event_type_filter}%\")\n58\t                )\n59\t\n60\t            logs = (\n61\t                query.order_by(db.models.Log.timestamp.desc())\n62\t                .limit(500)\n63\t                .all()\n64\t            )\n65\t\n66\t            if not logs:\n67\t                st.info(\"No logs found matching the filters.\")\n68\t                return\n69\t\n70\t            # Display logs as dataframe\n71\t            st.markdown(f\"**Showing {len(logs)} log entries (max 500)**\")\n72\t            df = df_from_query(logs)\n73\t\n74\t            # Select relevant columns for display\n75\t            display_columns = [\n76\t                \"timestamp\",\n77\t                \"level\",\n78\t                \"module\",\n79\t                \"event_type\",\n80\t                \"symbol\",\n81\t                \"message\",\n82\t            ]\n83\t            available_columns = [\n84\t                col for col in display_columns if col in df.columns\n85\t            ]\n86\t            st.dataframe(df[available_columns], width=\"stretch\")\n87\t\n88\t            # Expandable details for recent 10 logs\n89\t            st.markdown(\"---\")\n90\t            st.markdown(\"**Recent Log Details (expandable)**\")\n91\t\n92\t            for log in logs[:10]:\n93\t                expander_title = (\n94\t                    f\"{log.timestamp} - {log.level} - {log.module}\"\n95\t                )\n96\t                with st.expander(expander_title):\n97\t                    st.markdown(f\"**Message:** {log.message}\")\n98\t                    st.markdown(f\"**Level:** {log.level}\")\n99\t                    st.markdown(f\"**Module:** {log.module}\")\n100\t                    st.markdown(f\"**Timestamp:** {log.timestamp}\")\n101\t                    if log.symbol:\n102\t                        st.markdown(f\"**Symbol:** {log.symbol}\")\n103\t                    if log.event_type:\n104\t                        st.markdown(f\"**Event Type:** {log.event_type}\")\n105\t                    if log.environment:\n106\t                        st.markdown(f\"**Environment:** {log.environment}\")\n107\t                    if log.thread_id:\n108\t                        st.markdown(f\"**Thread ID:** {log.thread_id}\")\n109\t                    if log.checkpoint_id:\n110\t                        st.markdown(f\"**Checkpoint ID:** {log.checkpoint_id}\")\n111\t                    if log.extra_data:\n112\t                        st.markdown(\"**Metadata (JSON):**\")\n113\t                        st.json(log.extra_data)\n114\t\n115\t        except Exception as e:\n116\t            st.error(f\"Error querying logs: {e}\")\n117\t"}]},"parent_tool_use_id":null,"session_id":"e4ffb124-556a-4a26-b5a1-3a5ae3b4c5ab","uuid":"8c5842fa-fb3f-44fd-b600-e727076089bf","timestamp":"2026-05-13T12:44:53.387Z","tool_use_result":{"type":"text","file":{"filePath":"/mnt/actions-runner/autodev-runtime/worktrees/QuantAgent/QuantAgent-s62/implementer-20260513T124414Z/apps/streamlit/views/logs.py","content":"from __future__ import annotations\n\nfrom datetime import datetime, timedelta\n\nimport streamlit as st\n\nfrom apps.streamlit.utils.ui import df_from_query\n\n\ndef render(db) -> None:\n    st.subheader(\"Logs\")\n\n    if not db.ok:\n        st.info(\"Connect DB to view logs.\")\n        return\n\n    # Filters\n    col1, col2, col3, col4 = st.columns(4)\n\n    with col1:\n        selected_levels = st.multiselect(\n            \"Log Level\",\n            options=[\"DEBUG\", \"INFO\", \"WARNING\", \"ERROR\", \"CRITICAL\"],\n            default=[\"INFO\", \"WARNING\", \"ERROR\", \"CRITICAL\"],\n        )\n\n    with col2:\n        symbol_filter = st.text_input(\"Symbol (contains)\", value=\"\")\n\n    with col3:\n        event_type_filter = st.text_input(\"Event Type (contains)\", value=\"\")\n\n    with col4:\n        hours_back = st.number_input(\n            \"Hours Back\", min_value=1, max_value=168, value=24\n        )\n\n    # Query logs with filters\n    with db.SessionLocal() as session:\n        try:\n            cutoff_time = datetime.utcnow() - timedelta(hours=hours_back)\n\n            query = session.query(db.models.Log).filter(\n                db.models.Log.timestamp >= cutoff_time\n            )\n\n            if selected_levels:\n                query = query.filter(db.models.Log.level.in_(selected_levels))\n\n            if symbol_filter:\n                query = query.filter(\n                    db.models.Log.symbol.ilike(f\"%{symbol_filter}%\")\n                )\n\n            if event_type_filter:\n                query = query.filter(\n                    db.models.Log.event_type.ilike(f\"%{event_type_filter}%\")\n                )\n\n            logs = (\n                query.order_by(db.models.Log.timestamp.desc())\n                .limit(500)\n                .all()\n            )\n\n            if not logs:\n                st.info(\"No logs found matching the filters.\")\n                return\n\n            # Display logs as dataframe\n            st.markdown(f\"**Showing {len(logs)} log entries (max 500)**\")\n            df = df_from_query(logs)\n\n            # Select relevant columns for display\n            display_columns = [\n                \"timestamp\",\n                \"level\",\n                \"module\",\n                \"event_type\",\n                \"symbol\",\n                \"message\",\n            ]\n            available_columns = [\n                col for col in display_columns if col in df.columns\n            ]\n            st.dataframe(df[available_columns], width=\"stretch\")\n\n            # Expandable details for recent 10 logs\n            st.markdown(\"---\")\n            st.markdown(\"**Recent Log Details (expandable)**\")\n\n            for log in logs[:10]:\n                expander_title = (\n                    f\"{log.timestamp} - {log.level} - {log.module}\"\n                )\n                with st.expander(expander_title):\n                    st.markdown(f\"**Message:** {log.message}\")\n                    st.markdown(f\"**Level:** {log.level}\")\n                    st.markdown(f\"**Module:** {log.module}\")\n                    st.markdown(f\"**Timestamp:** {log.timestamp}\")\n                    if log.symbol:\n                        st.markdown(f\"**Symbol:** {log.symbol}\")\n                    if log.event_type:\n                        st.markdown(f\"**Event Type:** {log.event_type}\")\n                    if log.environment:\n                        st.markdown(f\"**Environment:** {log.environment}\")\n                    if log.thread_id:\n                        st.markdown(f\"**Thread ID:** {log.thread_id}\")\n                    if log.checkpoint_id:\n                        st.markdown(f\"**Checkpoint ID:** {log.checkpoint_id}\")\n                    if log.extra_data:\n                        st.markdown(\"**Metadata (JSON):**\")\n                        st.json(log.extra_data)\n\n        except Exception as e:\n            st.error(f\"Error querying logs: {e}\")\n","numLines":117,"startLine":1,"totalLines":117}}}
