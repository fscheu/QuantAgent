{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016DEMZCQz5QxzcxweAdB6qd","type":"tool_result","content":"1\t\"\"\"Backtesting engine for strategy validation.\"\"\"\n2\t\n3\timport logging\n4\timport math\n5\tfrom dataclasses import dataclass\n6\tfrom datetime import datetime, timedelta\n7\tfrom decimal import Decimal\n8\tfrom typing import Dict, List, Optional\n9\t\n10\timport numpy as np\n11\timport pandas as pd\n12\tfrom sqlalchemy.orm import Session\n13\t\n14\tfrom quantagent.agent_models import TradingDecision\n15\tfrom quantagent.data.asset_types import AssetType, get_asset_type\n16\tfrom quantagent.data.market_calendar import get_market_calendar\n17\tfrom quantagent.data.provider import DataProvider\n18\tfrom quantagent.database import SessionLocal\n19\tfrom quantagent.models import (\n20\t    ActivePosition,\n21\t    BacktestRun,\n22\t    Environment,\n23\t    OrderSide,\n24\t    Signal,\n25\t    Trade,\n26\t    TradeSignal,\n27\t)\n28\tfrom quantagent.static_util import format_ohlcv_for_agents\n29\tfrom quantagent.strategy.assembler import StrategyAssembler\n30\tfrom quantagent.strategy.base import TradingStrategy\n31\tfrom quantagent.strategy.llm_agent_strategy import LLMAgentStrategy\n32\tfrom quantagent.trading.position_monitor import PositionMonitor\n33\t\n34\tlogger = logging.getLogger(__name__)\n35\t\n36\t\n37\t@dataclass\n38\tclass BacktestMetrics:\n39\t    \"\"\"Backtest performance metrics.\"\"\"\n40\t\n41\t    total_trades: int\n42\t    winning_trades: int\n43\t    losing_trades: int\n44\t    win_rate: float\n45\t    profit_factor: float\n46\t    sharpe_ratio: float\n47\t    max_drawdown: float\n48\t    total_pnl: float\n49\t    avg_win: float\n50\t    avg_loss: float\n51\t    largest_win: float\n52\t    largest_loss: float\n53\t    total_return_pct: float\n54\t\n55\t    # Phase 4: Active Position Monitoring metrics\n56\t    agent_invocations: int = 0\n57\t    invocations_saved: int = 0\n58\t    invocation_reduction_pct: float = 0.0\n59\t    mean_directional_accuracy: float = 0.0\n60\t    accuracy_by_candle: Dict[int, float] = None\n61\t    close_reasons: Dict[str, int] = None\n62\t\n63\t    def __post_init__(self):\n64\t        if self.accuracy_by_candle is None:\n65\t            self.accuracy_by_candle = {}\n66\t        if self.close_reasons is None:\n67\t            self.close_reasons = {}\n68\t\n69\t\n70\tclass Backtest:\n71\t    \"\"\"\n72\t    Backtesting engine for validating trading strategies.\n73\t\n74\t    Workflow:\n75\t    1. Loop through historical dates\n76\t    2. Fetch OHLC data for each date using DataProvider (cached)\n77\t    3. Execute analysis using TradingGraph\n78\t    4. Simulate trade execution using OrderManager\n79\t    5. Track portfolio performance\n80\t    6. Calculate and persist metrics\n81\t\n82\t    Features:\n83\t    - Uses DataProvider for 10x faster data access (caching)\n84\t    - Executes same agents as live trading\n85\t    - Stores full provenance (config snapshot, model metadata)\n86\t    - Supports replay with different risk/portfolio profiles\n87\t    \"\"\"\n88\t\n89\t    def __init__(\n90\t        self,\n91\t        start_date: datetime,\n92\t        end_date: datetime,\n93\t        assets: List[str],\n94\t        timeframe: str = \"1h\",\n95\t        initial_capital: float = 100000.0,\n96\t        config: Optional[Dict] = None,\n97\t        db_session: Optional[Session] = None,\n98\t        use_checkpointing: bool = False,\n99\t        strategy: Optional[TradingStrategy] = None,\n100\t    ):\n101\t        \"\"\"\n102\t        Initialize Backtest.\n103\t\n104\t        Args:\n105\t            start_date: Start date for backtest\n106\t            end_date: End date for backtest\n107\t            assets: List of asset symbols (e.g., [\"BTC\", \"SPX\", \"CL\"])\n108\t            timeframe: Timeframe for analysis (e.g., \"1h\", \"4h\", \"1d\")\n109\t            initial_capital: Starting portfolio value\n110\t            config: Configuration dict (portfolio/risk params, model settings)\n111\t            db_session: Database session (creates new if None)\n112\t            use_checkpointing: Enable LangGraph checkpointing for state persistence\n113\t            strategy: Optional TradingStrategy. If None, uses LLMAgentStrategy with TradingGraph\n114\t        \"\"\"\n115\t        self.start_date = start_date\n116\t        self.end_date = end_date\n117\t        self.assets = assets\n118\t        self.timeframe = timeframe\n119\t        self.initial_capital = initial_capital\n120\t        self.config = config or {}\n121\t        self.use_checkpointing = use_checkpointing\n122\t\n123\t        # Database\n124\t        self.db = db_session or SessionLocal()\n125\t        self._own_session = db_session is None\n126\t\n127\t        # Data provider (caching layer)\n128\t        self.data_provider = DataProvider(self.db)\n129\t\n130\t        # Resolve config via StrategyAssembler and build components (unify DB session)\n131\t        from quantagent import settings\n132\t        \n133\t        resolved = StrategyAssembler.from_snapshot(\n134\t            {\n135\t                \"initial_cash\": initial_capital,\n136\t                \"base_position_pct\": self.config.get(\"base_position_pct\", settings.TRADING_BASE_POSITION_PCT),\n137\t                \"max_daily_loss_pct\": self.config.get(\"max_daily_loss_pct\", settings.TRADING_MAX_DAILY_LOSS_PCT),\n138\t                \"max_position_pct\": self.config.get(\"max_position_pct\", settings.TRADING_MAX_POSITION_PCT),\n139\t                \"slippage_pct\": self.config.get(\"slippage_pct\", settings.TRADING_SLIPPAGE_PCT),\n140\t                # Normalize model fields into generic ones; accept both\n141\t                \"model_provider\": self.config.get(\n142\t                    \"agent_llm_provider\", self.config.get(\"model_provider\", settings.AGENT_LLM_PROVIDER)\n143\t                ),\n144\t                \"model_name\": self.config.get(\n145\t                    \"agent_llm_model\", self.config.get(\"model_name\", settings.AGENT_LLM_MODEL)\n146\t                ),\n147\t                \"temperature\": self.config.get(\n148\t                    \"agent_llm_temperature\", self.config.get(\"temperature\", settings.AGENT_LLM_TEMPERATURE)\n149\t                ),\n150\t                \"use_checkpointing\": use_checkpointing,\n151\t                \"universe\": self.config.get(\"universe\", settings.get_trading_universe()),\n152\t            },\n153\t            environment=Environment.BACKTEST,\n154\t        )\n155\t        components = StrategyAssembler.build_components(resolved, db_session=self.db)\n156\t\n157\t        # Trading graph (analysis engine)\n158\t        self.trading_graph = components.graph\n159\t\n160\t        # Trading strategy (use provided or default to LLMAgentStrategy)\n161\t        self.strategy = strategy or LLMAgentStrategy(self.trading_graph)\n162\t\n163\t        # Position monitor for active position tracking\n164\t        self.position_monitor = PositionMonitor(self.db)\n165\t\n166\t        # Trading components\n167\t        self.portfolio = components.portfolio_manager\n168\t        self.position_sizer = components.position_sizer\n169\t        self.risk_manager = components.risk_manager\n170\t        self.broker = components.broker\n171\t        self.order_manager = components.order_manager\n172\t\n173\t        # Backtest state\n174\t        self.current_date = start_date\n175\t        self.backtest_run_id: Optional[int] = None\n176\t        self.trades: List[Trade] = []\n177\t        self.equity_curve: List[Dict] = []\n178\t\n179\t        # Phase 4: Invocation tracking\n180\t        self.agent_invocations = 0\n181\t        self.total_candles_processed = 0\n182\t\n183\t        # Market hours filtering\n184\t        self.market_hours_filter = self.config.get(\"market_hours_filter\", True)\n185\t        self._market_calendar = (\n186\t            get_market_calendar() if self.market_hours_filter else None\n187\t        )\n188\t\n189\t        # Cache asset types for each symbol\n190\t        self._asset_types: Dict[str, AssetType] = {\n191\t            asset: get_asset_type(asset) for asset in assets\n192\t        }\n193\t\n194\t    def run(self, name: Optional[str] = None) -> BacktestMetrics:\n195\t        \"\"\"\n196\t        Run backtest and return metrics.\n197\t\n198\t        Args:\n199\t            name: Optional name for this backtest run\n200\t\n201\t        Returns:\n202\t            BacktestMetrics with performance statistics\n203\t        \"\"\"\n204\t        logger.info(\n205\t            f\"Starting backtest: {self.start_date} to {self.end_date}\",\n206\t            extra={\"event_type\": \"backtest_start\", \"environment\": \"backtest\"},\n207\t        )\n208\t        logger.info(\n209\t            f\"Assets: {self.assets}, Timeframe: {self.timeframe}\",\n210\t            extra={\"event_type\": \"backtest_start\"},\n211\t        )\n212\t        logger.info(\n213\t            f\"Initial capital: ${self.initial_capital:,.2f}\",\n214\t            extra={\"event_type\": \"backtest_start\"},\n215\t        )\n216\t        logger.info(\n217\t            f\"Market hours filter: {self.market_hours_filter}\",\n218\t            extra={\"event_type\": \"backtest_start\"},\n219\t        )\n220\t\n221\t        # Create backtest run record\n222\t        self._create_backtest_run(name)\n223\t\n224\t        # Process each asset with its filtered date range\n225\t        total_periods = 0\n226\t        for asset in self.assets:\n227\t            asset_dates = self._get_date_range_for_asset(asset)\n228\t            total_periods += len(asset_dates)\n229\t\n230\t            asset_type = self._asset_types.get(asset, AssetType.UNKNOWN)\n231\t            logger.info(\n232\t                f\"Asset {asset} ({asset_type.value}): {len(asset_dates)} analysis periods\",\n233\t                extra={\"event_type\": \"backtest_start\"},\n234\t            )\n235\t\n236\t        logger.info(\n237\t            f\"Backtesting {total_periods} total analysis periods\",\n238\t            extra={\"event_type\": \"backtest_start\"},\n239\t        )\n240\t\n241\t        # Track progress across all periods\n242\t        periods_completed = 0\n243\t\n244\t        # Loop through assets (outer) and their dates (inner)\n245\t        for asset in self.assets:\n246\t            asset_dates = self._get_date_range_for_asset(asset)\n247\t\n248\t            for i, current_date in enumerate(asset_dates):\n249\t                self.current_date = current_date\n250\t\n251\t                # Reset daily P&L tracking at start of each day\n252\t                if i == 0 or current_date.date() != asset_dates[i - 1].date():\n253\t                    self.risk_manager.reset_daily_tracker()\n254\t\n255\t                try:\n256\t                    self._analyze_and_trade(asset, current_date)\n257\t                except Exception as e:\n258\t                    logger.error(\n259\t                        f\"Error analyzing {asset} at {current_date}: {e}\",\n260\t                        exc_info=True,\n261\t                        extra={\"event_type\": \"backtest_error\", \"symbol\": asset},\n262\t                    )\n263\t                    continue\n264\t\n265\t                # Record equity at end of period\n266\t                self._record_equity(current_date)\n267\t\n268\t                periods_completed += 1\n269\t\n270\t                # Log progress\n271\t                if periods_completed % 100 == 0 or periods_completed == total_periods:\n272\t                    progress = (periods_completed / total_periods) * 100\n273\t                    logger.info(\n274\t                        f\"Progress: {progress:.1f}% ({periods_completed}/{total_periods})\",\n275\t                        extra={\"event_type\": \"backtest_progress\"},\n276\t                    )\n277\t\n278\t        # Calculate metrics\n279\t        metrics = self._calculate_metrics()\n280\t\n281\t        # Update backtest run with results\n282\t        self._update_backtest_run(metrics)\n283\t\n284\t        logger.info(\n285\t            f\"Backtest complete: {metrics.total_trades} trades, Win rate: {metrics.win_rate:.2%}\",\n286\t            extra={\"event_type\": \"backtest_end\", \"environment\": \"backtest\"},\n287\t        )\n288\t        logger.info(\n289\t            f\"Total P&L: ${metrics.total_pnl:,.2f} ({metrics.total_return_pct:.2%})\",\n290\t            extra={\"event_type\": \"backtest_end\"},\n291\t        )\n292\t\n293\t        return metrics\n294\t\n295\t    def _create_backtest_run(self, name: Optional[str]) -> None:\n296\t        \"\"\"Create BacktestRun record in database.\"\"\"\n297\t        run = BacktestRun(\n298\t            name=name or f\"Backtest_{datetime.now().strftime('%Y%m%d_%H%M%S')}\",\n299\t            timeframe=self.timeframe,\n300\t            assets=self.assets,\n301\t            start_date=self.start_date,\n302\t            end_date=self.end_date,\n303\t            config_snapshot=self._build_config_snapshot(),\n304\t        )\n305\t\n306\t        self.db.add(run)\n307\t        self.db.commit()\n308\t        self.backtest_run_id = run.id\n309\t\n310\t        if self.position_monitor is not None:\n311\t            self.position_monitor.set_backtest_run_id(self.backtest_run_id)\n312\t\n313\t        logger.info(\n314\t            f\"Created backtest run #{self.backtest_run_id}: {run.name}\",\n315\t            extra={\"event_type\": \"backtest_init\"},\n316\t        )\n317\t\n318\t    def _build_config_snapshot(self) -> Dict:\n319\t        \"\"\"Build immutable config snapshot for reproducibility.\"\"\"\n320\t        from quantagent import settings\n321\t        \n322\t        # Re-generate snapshot via assembler to keep alignment\n323\t        resolved = StrategyAssembler.from_snapshot(\n324\t            {\n325\t                \"initial_cash\": self.initial_capital,\n326\t                \"base_position_pct\": self.config.get(\"base_position_pct\", settings.TRADING_BASE_POSITION_PCT),\n327\t                \"max_daily_loss_pct\": self.config.get(\"max_daily_loss_pct\", settings.TRADING_MAX_DAILY_LOSS_PCT),\n328\t                \"max_position_pct\": self.config.get(\"max_position_pct\", settings.TRADING_MAX_POSITION_PCT),\n329\t                \"slippage_pct\": self.config.get(\"slippage_pct\", settings.TRADING_SLIPPAGE_PCT),\n330\t                \"model_provider\": self.config.get(\n331\t                    \"agent_llm_provider\", self.config.get(\"model_provider\", settings.AGENT_LLM_PROVIDER)\n332\t                ),\n333\t                \"model_name\": self.config.get(\n334\t                    \"agent_llm_model\", self.config.get(\"model_name\", settings.AGENT_LLM_MODEL)\n335\t                ),\n336\t                \"temperature\": self.config.get(\n337\t                    \"agent_llm_temperature\", self.config.get(\"temperature\", settings.AGENT_LLM_TEMPERATURE)\n338\t                ),\n339\t                \"use_checkpointing\": self.use_checkpointing,\n340\t                \"universe\": self.config.get(\"universe\", settings.get_trading_universe()),\n341\t            },\n342\t            environment=Environment.BACKTEST,\n343\t        )\n344\t        return StrategyAssembler.config_snapshot(resolved)\n345\t\n346\t    def _get_date_range(self) -> List[datetime]:\n347\t        \"\"\"\n348\t        Get list of dates to backtest.\n349\t\n350\t        For hourly/intraday: every N hours\n351\t        For daily: every day\n352\t        \"\"\"\n353\t        dates = []\n354\t        current = self.start_date\n355\t\n356\t        # Determine step size based on timeframe\n357\t        if self.timeframe in [\"1h\", \"4h\"]:\n358\t            step_hours = int(self.timeframe.replace(\"h\", \"\"))\n359\t            step = timedelta(hours=step_hours)\n360\t        elif self.timeframe == \"1d\":\n361\t            step = timedelta(days=1)\n362\t        elif self.timeframe == \"1w\":\n363\t            step = timedelta(weeks=1)\n364\t        else:\n365\t            # Default to hourly\n366\t            step = timedelta(hours=1)\n367\t\n368\t        while current <= self.end_date:\n369\t            dates.append(current)\n370\t            current += step\n371\t\n372\t        return dates\n373\t\n374\t    def _get_date_range_for_asset(self, asset: str) -> List[datetime]:\n375\t        \"\"\"\n376\t        Get date range filtered by market hours for specific asset.\n377\t\n378\t        Args:\n379\t            asset: Asset symbol\n380\t\n381\t        Returns:\n382\t            List of valid trading timestamps for this asset\n383\t        \"\"\"\n384\t        all_dates = self._get_date_range()\n385\t\n386\t        if not self.market_hours_filter or self._market_calendar is None:\n387\t            return all_dates\n388\t\n389\t        asset_type = self._asset_types.get(asset, AssetType.UNKNOWN)\n390\t\n391\t        return self._market_calendar.filter_to_trading_hours(all_dates, asset_type)\n392\t\n393\t    def _analyze_and_trade(self, asset: str, current_date: datetime) -> None:\n394\t        \"\"\"\n395\t        Execute analysis and trade for a single asset at a given time.\n396\t\n397\t        NEW FLOW (Hybrid Model with PositionMonitor):\n398\t        1. Check for active position\n399\t        2. If active: strategy.should_exit() → close or update tracking (NO invoke)\n400\t        3. If not active: strategy.generate_signal() → open position if signal != HOLD\n401\t\n402\t        Args:\n403\t            asset: Asset symbol\n404\t            current_date: Current backtest date\n405\t        \"\"\"\n406\t        # Get historical data for analysis (need lookback period)\n407\t        lookback_bars = self.strategy.required_history_bars\n408\t        if lookback_bars <= 0:\n409\t            lookback_bars = 30\n410\t\n411\t        data_start = current_date - timedelta(\n412\t            days=self._bars_to_calendar_days(lookback_bars)\n413\t        )\n414\t\n415\t        df = self.data_provider.get_ohlc(\n416\t            symbol=asset,\n417\t            timeframe=self.timeframe,\n418\t            start_date=data_start,\n419\t            end_date=current_date,\n420\t        )\n421\t\n422\t        if df.empty or len(df) < lookback_bars:\n423\t            logger.warning(\n424\t                f\"Insufficient data for {asset} at {current_date} \"\n425\t                f\"(got {len(df)}, need {lookback_bars})\",\n426\t                extra={\"event_type\": \"backtest_data_warning\", \"symbol\": asset},\n427\t            )\n428\t            return\n429\t\n430\t        current_price = float(df.iloc[-1][\"close\"])\n431\t\n432\t        # Check for active position\n433\t        active_pos = self.position_monitor.get_active_position(asset)\n434\t\n435\t        # Phase 4: Count total candles processed\n436\t        self.total_candles_processed += 1\n437\t\n438\t        if active_pos:\n439\t            # Position active: check exit conditions via strategy\n440\t            should_exit, reason = self.strategy.should_exit(\n441\t                active_pos, current_price, df\n442\t            )\n443\t\n444\t            if should_exit:\n445\t                # Close position\n446\t                self.position_monitor.close_position(active_pos, reason, current_price)\n447\t\n448\t                # Execute close via OrderManager\n449\t                if active_pos.trade_id:\n450\t                    self.order_manager.close_trade(\n451\t                        active_pos.trade_id,\n452\t                        current_price,\n453\t                        environment=Environment.BACKTEST,\n454\t                    )\n455\t                    logger.info(\n456\t                        f\"{asset}: Closed position - {reason} @ ${current_price:.2f}\"\n457\t                    )\n458\t                # Continue to potentially open new position below\n459\t            else:\n460\t                # Position still active: update tracking only (NO INVOKE)\n461\t                prev_close = (\n462\t                    float(df.iloc[-2][\"close\"]) if len(df) >= 2 else current_price\n463\t                )\n464\t                self.position_monitor.update_candle_tracking(\n465\t                    active_pos, current_price, prev_close\n466\t                )\n467\t                return  # Early return - invocation saved\n468\t\n469\t        # No active position (or just closed): generate signal\n470\t        if isinstance(self.strategy, LLMAgentStrategy):\n471\t            kline_data = format_ohlcv_for_agents(df)\n472\t        else:\n473\t            kline_data = df.to_dict(orient=\"records\")\n474\t\n475\t        # Phase 4: Count agent invocations\n476\t        self.agent_invocations += 1\n477\t\n478\t        # Generate thread_id for checkpointing (if enabled)\n479\t        thread_id = None\n480\t        if self.use_checkpointing:\n481\t            from quantagent.strategy.assembler import StrategyAssembler\n482\t\n483\t            thread_id = StrategyAssembler.make_thread_id(\n484\t                self.backtest_run_id, asset, current_date\n485\t            )\n486\t\n487\t        signal_kwargs = {}\n488\t        if thread_id is not None:\n489\t            signal_kwargs[\"thread_id\"] = thread_id\n490\t\n491\t        signal = self.strategy.generate_signal(\n492\t            kline_data, asset, self.timeframe, current_price, **signal_kwargs\n493\t        )\n494\t\n495\t        if signal is None or signal.decision == \"HOLD\":\n496\t            return\n497\t\n498\t        # Execute trade\n499\t        trading_signal = (\n500\t            TradeSignal.LONG if signal.decision == \"LONG\" else TradeSignal.SHORT\n501\t        )\n502\t\n503\t        # Store signal in database\n504\t        db_signal = self._create_signal_from_strategy(\n505\t            asset=asset,\n506\t            decision=trading_signal,\n507\t            confidence=signal.confidence,\n508\t            reasoning=signal.reasoning,\n509\t            current_date=current_date,\n510\t        )\n511\t\n512\t        # Execute order\n513\t        order = self.order_manager.execute_decision(\n514\t            symbol=asset,\n515\t            decision=trading_signal,\n516\t            confidence=signal.confidence,\n517\t            current_price=current_price,\n518\t            environment=Environment.BACKTEST,\n519\t            trigger_signal_id=db_signal.id if db_signal else None,\n520\t        )\n521\t\n522\t        if order and order.filled_quantity and order.filled_quantity > 0:\n523\t            # Create ActivePosition\n524\t            side = (\n525\t                OrderSide.BUY if trading_signal == TradeSignal.LONG else OrderSide.SELL\n526\t            )\n527\t\n528\t            # Get trade_id from order\n529\t            trade_id = None\n530\t            if order.id:\n531\t                trade = self.db.query(Trade).filter(Trade.order_id == order.id).first()\n532\t                if trade:\n533\t                    trade_id = trade.id\n534\t\n535\t            self.position_monitor.open_position(\n536\t                symbol=asset,\n537\t                side=side,\n538\t                entry_price=signal.entry_price or current_price,\n539\t                stop_loss=signal.stop_loss\n540\t                or (\n541\t                    current_price * 0.98\n542\t                    if side == OrderSide.BUY\n543\t                    else current_price * 1.02\n544\t                ),\n545\t                take_profit=signal.take_profit\n546\t                or (\n547\t                    current_price * 1.03\n548\t                    if side == OrderSide.BUY\n549\t                    else current_price * 0.97\n550\t                ),\n551\t                quantity=order.filled_quantity,\n552\t                exit_policy=signal.exit_policy.value,\n553\t                trade_id=trade_id,\n554\t                signal_id=db_signal.id if db_signal else None,\n555\t                trailing_stop_pct=signal.trailing_stop_pct,\n556\t                max_hold_candles=signal.max_hold_candles,\n557\t            )\n558\t\n559\t            logger.info(\n560\t                f\"Executed {trading_signal.value} for {asset} \"\n561\t                f\"@ \"\n562\t                f\"${current_price:.2f}, qty: {order.filled_quantity}\"\n563\t            )\n564\t\n565\t    def _bars_to_calendar_days(self, bars: int) -> int:\n566\t        \"\"\"Convert required trading bars to a calendar-day lookback window.\"\"\"\n567\t        if self.timeframe == \"1d\":\n568\t            return math.ceil(bars * 365 / 252)\n569\t        if self.timeframe == \"1h\":\n570\t            return math.ceil(bars / 6.5 * 7 / 5)\n571\t        if self.timeframe == \"4h\":\n572\t            return math.ceil(bars * 4 / 6.5 * 7 / 5)\n573\t        return bars * 2\n574\t\n575\t    def _parse_decision(self, decision: TradingDecision) -> (TradeSignal, float):\n576\t        \"\"\"Parse decision text to extract LONG/SHORT/HOLD and confidence.\"\"\"\n577\t        decision_upper = decision.decision.upper()\n578\t        signal = TradeSignal.NEUTRAL\n579\t\n580\t        if \"LONG\" in decision_upper or \"BUY\" in decision_upper:\n581\t            signal = TradeSignal.LONG\n582\t        elif \"SHORT\" in decision_upper or \"SELL\" in decision_upper:\n583\t            signal = TradeSignal.SHORT\n584\t        else:\n585\t            signal = TradeSignal.NEUTRAL\n586\t\n587\t        ind = float(decision.confidence)\n588\t\n589\t        return signal, ind\n590\t\n591\t    def _create_signal_from_strategy(\n592\t        self,\n593\t        asset: str,\n594\t        decision: TradeSignal,\n595\t        confidence: float,\n596\t        reasoning: str,\n597\t        current_date: datetime,\n598\t    ) -> Optional[Signal]:\n599\t        \"\"\"Create Signal record from strategy output (simplified).\"\"\"\n600\t        from quantagent import settings\n601\t        \n602\t        try:\n603\t            signal = Signal(\n604\t                symbol=asset,\n605\t                signal=decision,\n606\t                confidence=confidence,\n607\t                timeframe=self.timeframe,\n608\t                analysis_summary=reasoning,\n609\t                generated_at=current_date,\n610\t                environment=Environment.BACKTEST,\n611\t                model_provider=self.config.get(\"agent_llm_provider\", settings.AGENT_LLM_PROVIDER),\n612\t                model_name=self.config.get(\"agent_llm_model\", settings.AGENT_LLM_MODEL),\n613\t                temperature=self.config.get(\"agent_llm_temperature\", settings.AGENT_LLM_TEMPERATURE),\n614\t            )\n615\t\n616\t            self.db.add(signal)\n617\t            self.db.commit()\n618\t            return signal\n619\t\n620\t        except Exception as e:\n621\t            logger.error(f\"Error creating signal: {e}\", exc_info=True)\n622\t            return None\n623\t\n624\t    def _create_signal(\n625\t        self,\n626\t        asset: str,\n627\t        decision: TradeSignal,\n628\t        confidence: float,\n629\t        result: Dict,\n630\t        current_date: datetime,\n631\t        thread_id: Optional[str] = None,\n632\t    ) -> Optional[Signal]:\n633\t        \"\"\"Create and persist Signal record.\"\"\"\n634\t        try:\n635\t            # Extract technical indicators\n636\t            rsi = None\n637\t            macd = None\n638\t            stochastic = None\n639\t            roc = None\n640\t            williams_r = None\n641\t            pattern = None\n642\t            trend = None\n643\t\n644\t            if \"rsi\" in result and result[\"rsi\"]:\n645\t                rsi = (\n646\t                    float(result[\"rsi\"][-1])\n647\t                    if isinstance(result[\"rsi\"], list)\n648\t                    else float(result[\"rsi\"])\n649\t                )\n650\t\n651\t            if \"macd\" in result and result[\"macd\"]:\n652\t                macd = (\n653\t                    float(result[\"macd\"][-1])\n654\t                    if isinstance(result[\"macd\"], list)\n655\t                    else float(result[\"macd\"])\n656\t                )\n657\t\n658\t            indicator_report = result.get(\"indicator_report\")\n659\t            if indicator_report and hasattr(indicator_report, \"rsi\"):\n660\t                rsi = float(indicator_report.rsi)\n661\t            if indicator_report and hasattr(indicator_report, \"macd\"):\n662\t                macd = float(indicator_report.macd)\n663\t            if indicator_report and hasattr(indicator_report, \"stochastic\"):\n664\t                stochastic = float(indicator_report.stochastic)\n665\t            if indicator_report and hasattr(indicator_report, \"roc\"):\n666\t                roc = float(indicator_report.roc)\n667\t            if indicator_report and hasattr(indicator_report, \"willr\"):\n668\t                williams_r = float(indicator_report.willr)\n669\t\n670\t            # Get pattern and trend from reports\n671\t            pattern_report = result.get(\"pattern_report\")\n672\t            if pattern_report and hasattr(pattern_report, \"primary_pattern\"):\n673\t                pattern = pattern_report.primary_pattern\n674\t\n675\t            trend_report = result.get(\"trend_report\")\n676\t            if trend_report and hasattr(trend_report, \"trend_direction\"):\n677\t                trend = trend_report.trend_direction\n678\t\n679\t            # Create signal\n680\t            from quantagent import settings\n681\t            \n682\t            signal = Signal(\n683\t                symbol=asset,\n684\t                signal=decision,\n685\t                confidence=confidence,\n686\t                timeframe=self.timeframe,\n687\t                rsi=rsi,\n688\t                macd=macd,\n689\t                stochastic=stochastic,\n690\t                roc=roc,\n691\t                williams_r=williams_r,\n692\t                pattern=pattern,\n693\t                trend=trend,\n694\t                analysis_summary=result.get(\"reasoning\", \"\"),\n695\t                generated_at=current_date,\n696\t                environment=Environment.BACKTEST,\n697\t                thread_id=thread_id,\n698\t                model_provider=self.config.get(\"agent_llm_provider\", settings.AGENT_LLM_PROVIDER),\n699\t                model_name=self.config.get(\"agent_llm_model\", settings.AGENT_LLM_MODEL),\n700\t                temperature=self.config.get(\"agent_llm_temperature\", settings.AGENT_LLM_TEMPERATURE),\n701\t            )\n702\t\n703\t            self.db.add(signal)\n704\t            self.db.commit()\n705\t\n706\t            return signal\n707\t\n708\t        except Exception as e:\n709\t            logger.error(\n710\t                f\"Error creating signal: {e}\",\n711\t                exc_info=True,\n712\t                extra={\"event_type\": \"backtest_error\"},\n713\t            )\n714\t            return None\n715\t\n716\t    def _record_equity(self, current_date: datetime) -> None:\n717\t        \"\"\"Record equity curve data point.\"\"\"\n718\t        total_value = self.portfolio.get_total_value()\n719\t\n720\t        self.equity_curve.append(\n721\t            {\n722\t                \"date\": current_date,\n723\t                \"equity\": total_value,\n724\t                \"cash\": self.portfolio.cash,\n725\t                \"positions_value\": total_value - self.portfolio.cash,\n726\t            }\n727\t        )\n728\t\n729\t    def _calculate_metrics(self) -> BacktestMetrics:\n730\t        \"\"\"\n731\t        Calculate backtest performance metrics.\n732\t\n733\t        Metrics:\n734\t        - Win rate: % of winning trades\n735\t        - Profit factor: sum(wins) / abs(sum(losses))\n736\t        - Sharpe ratio: (return - risk_free) / volatility\n737\t        - Max drawdown: worst peak-to-trough decline\n738\t        - Total P&L: sum of all trade P&L\n739\t        \"\"\"\n740\t        # Get all trades from database for this backtest\n741\t        trades = (\n742\t            self.db.query(Trade)\n743\t            .filter(\n744\t                Trade.environment == Environment.BACKTEST,\n745\t                Trade.opened_at >= self.start_date,\n746\t                Trade.opened_at <= self.end_date,\n747\t            )\n748\t            .all()\n749\t        )\n750\t\n751\t        if not trades:\n752\t            logger.warning(\n753\t                \"No trades executed during backtest\",\n754\t                extra={\"event_type\": \"backtest_warning\"},\n755\t            )\n756\t\n757\t            # Phase 4: Even with no trades, calculate MDA if positions were opened\n758\t            mda, accuracy_by_candle = self._calculate_directional_accuracy()\n759\t            close_reasons = self._calculate_close_reasons()\n760\t\n761\t            invocations_saved = self.total_candles_processed - self.agent_invocations\n762\t            invocation_reduction_pct = (\n763\t                (invocations_saved / self.total_candles_processed * 100)\n764\t                if self.total_candles_processed > 0\n765\t                else 0.0\n766\t            )\n767\t\n768\t            return BacktestMetrics(\n769\t                total_trades=0,\n770\t                winning_trades=0,\n771\t                losing_trades=0,\n772\t                win_rate=0.0,\n773\t                profit_factor=0.0,\n774\t                sharpe_ratio=0.0,\n775\t                max_drawdown=0.0,\n776\t                total_pnl=0.0,\n777\t                avg_win=0.0,\n778\t                avg_loss=0.0,\n779\t                largest_win=0.0,\n780\t                largest_loss=0.0,\n781\t                total_return_pct=0.0,\n782\t                agent_invocations=self.agent_invocations,\n783\t                invocations_saved=invocations_saved,\n784\t                invocation_reduction_pct=invocation_reduction_pct,\n785\t                mean_directional_accuracy=mda,\n786\t                accuracy_by_candle=accuracy_by_candle,\n787\t                close_reasons=close_reasons,\n788\t            )\n789\t\n790\t        # Calculate basic metrics\n791\t        total_trades = len(trades)\n792\t        winning_trades = [t for t in trades if t.pnl and float(t.pnl) > 0]\n793\t        losing_trades = [t for t in trades if t.pnl and float(t.pnl) < 0]\n794\t\n795\t        total_wins = sum(float(t.pnl) for t in winning_trades)\n796\t        total_losses = abs(sum(float(t.pnl) for t in losing_trades))\n797\t\n798\t        # Win rate\n799\t        win_rate = len(winning_trades) / total_trades if total_trades > 0 else 0.0\n800\t\n801\t        # Profit factor\n802\t        profit_factor = (\n803\t            total_wins / total_losses\n804\t            if total_losses > 0\n805\t            else float(\"inf\") if total_wins > 0 else 0.0\n806\t        )\n807\t\n808\t        # Total P&L\n809\t        total_pnl = sum(float(t.pnl) for t in trades if t.pnl)\n810\t\n811\t        # Average win/loss\n812\t        avg_win = total_wins / len(winning_trades) if winning_trades else 0.0\n813\t        avg_loss = total_losses / len(losing_trades) if losing_trades else 0.0\n814\t\n815\t        # Largest win/loss\n816\t        largest_win = max((float(t.pnl) for t in winning_trades), default=0.0)\n817\t        largest_loss = min((float(t.pnl) for t in losing_trades), default=0.0)\n818\t\n819\t        # Total return %\n820\t        total_return_pct = (\n821\t            (total_pnl / self.initial_capital) * 100\n822\t            if self.initial_capital > 0\n823\t            else 0.0\n824\t        )\n825\t\n826\t        # Sharpe ratio\n827\t        sharpe_ratio = self._calculate_sharpe_ratio()\n828\t\n829\t        # Max drawdown\n830\t        max_drawdown = self._calculate_max_drawdown()\n831\t\n832\t        # Phase 4: Calculate MDA and accuracy metrics\n833\t        mda, accuracy_by_candle = self._calculate_directional_accuracy()\n834\t\n835\t        # Phase 4: Calculate close reasons distribution\n836\t        close_reasons = self._calculate_close_reasons()\n837\t\n838\t        # Phase 4: Calculate invocation reduction\n839\t        invocations_saved = self.total_candles_processed - self.agent_invocations\n840\t        invocation_reduction_pct = (\n841\t            (invocations_saved / self.total_candles_processed * 100)\n842\t            if self.total_candles_processed > 0\n843\t            else 0.0\n844\t        )\n845\t\n846\t        return BacktestMetrics(\n847\t            total_trades=total_trades,\n848\t            winning_trades=len(winning_trades),\n849\t            losing_trades=len(losing_trades),\n850\t            win_rate=win_rate,\n851\t            profit_factor=profit_factor,\n852\t            sharpe_ratio=sharpe_ratio,\n853\t            max_drawdown=max_drawdown,\n854\t            total_pnl=total_pnl,\n855\t            avg_win=avg_win,\n856\t            avg_loss=avg_loss,\n857\t            largest_win=largest_win,\n858\t            largest_loss=largest_loss,\n859\t            total_return_pct=total_return_pct,\n860\t            agent_invocations=self.agent_invocations,\n861\t            invocations_saved=invocations_saved,\n862\t            invocation_reduction_pct=invocation_reduction_pct,\n863\t            mean_directional_accuracy=mda,\n864\t            accuracy_by_candle=accuracy_by_candle,\n865\t            close_reasons=close_reasons,\n866\t        )\n867\t\n868\t    def _calculate_sharpe_ratio(self, risk_free_rate: float = 0.02) -> float:\n869\t        \"\"\"\n870\t        Calculate Sharpe ratio.\n871\t\n872\t        Formula: (return - risk_free) / volatility\n873\t\n874\t        Args:\n875\t            risk_free_rate: Annual risk-free rate (default: 2%)\n876\t\n877\t        Returns:\n878\t            Sharpe ratio\n879\t        \"\"\"\n880\t        if len(self.equity_curve) < 2:\n881\t            return 0.0\n882\t\n883\t        # Calculate returns\n884\t        equity_series = pd.Series([e[\"equity\"] for e in self.equity_curve])\n885\t        returns = equity_series.pct_change().dropna()\n886\t\n887\t        if len(returns) == 0 or returns.std() == 0:\n888\t            return 0.0\n889\t\n890\t        # Annualize based on timeframe\n891\t        periods_per_year = self._get_periods_per_year()\n892\t\n893\t        # Calculate Sharpe\n894\t        excess_return = returns.mean() - (risk_free_rate / periods_per_year)\n895\t        sharpe = (excess_return / returns.std()) * np.sqrt(periods_per_year)\n896\t\n897\t        return float(sharpe)\n898\t\n899\t    def _calculate_max_drawdown(self) -> float:\n900\t        \"\"\"\n901\t        Calculate maximum drawdown.\n902\t\n903\t        Formula: max((peak - trough) / peak)\n904\t\n905\t        Returns:\n906\t            Max drawdown as decimal (e.g., 0.15 = 15%)\n907\t        \"\"\"\n908\t        if len(self.equity_curve) < 2:\n909\t            return 0.0\n910\t\n911\t        equity_series = pd.Series([e[\"equity\"] for e in self.equity_curve])\n912\t\n913\t        # Calculate running maximum\n914\t        running_max = equity_series.expanding().max()\n915\t\n916\t        # Calculate drawdown\n917\t        drawdown = (equity_series - running_max) / running_max\n918\t\n919\t        # Maximum drawdown (most negative)\n920\t        max_dd = abs(drawdown.min())\n921\t\n922\t        return float(max_dd)\n923\t\n924\t    def _calculate_directional_accuracy(self) -> tuple[float, Dict[int, float]]:\n925\t        \"\"\"\n926\t        Calculate Mean Directional Accuracy (MDA) and per-candle accuracy.\n927\t\n928\t        MDA = (correct_candles / total_candles_evaluated)\n929\t\n930\t        Returns:\n931\t            Tuple of (mean_directional_accuracy, accuracy_by_candle)\n932\t        \"\"\"\n933\t        query = self.db.query(ActivePosition).filter(\n934\t            ActivePosition.is_active.is_(False),\n935\t            ActivePosition.decision_timestamp >= self.start_date,\n936\t            ActivePosition.decision_timestamp <= self.end_date,\n937\t        )\n938\t\n939\t        if self.backtest_run_id is not None:\n940\t            query = query.filter(ActivePosition.backtest_run_id == self.backtest_run_id)\n941\t\n942\t        positions = query.all()\n943\t\n944\t        if not positions:\n945\t            return 0.0, {}\n946\t\n947\t        # Track correct predictions per candle index\n948\t        correct_by_candle = {}\n949\t        total_by_candle = {}\n950\t\n951\t        for pos in positions:\n952\t            expected_direction = \"up\" if pos.side == OrderSide.BUY else \"down\"\n953\t\n954\t            # Evaluate up to prediction_horizon candles\n955\t            for i, direction in enumerate(\n956\t                pos.candles_direction[: pos.prediction_horizon]\n957\t            ):\n958\t                candle_idx = i + 1  # 1-indexed (candle 1, 2, 3...)\n959\t\n960\t                if candle_idx not in correct_by_candle:\n961\t                    correct_by_candle[candle_idx] = 0\n962\t                    total_by_candle[candle_idx] = 0\n963\t\n964\t                total_by_candle[candle_idx] += 1\n965\t                if direction == expected_direction:\n966\t                    correct_by_candle[candle_idx] += 1\n967\t\n968\t        # Calculate accuracy per candle\n969\t        accuracy_by_candle = {\n970\t            candle: correct_by_candle[candle] / total_by_candle[candle]\n971\t            for candle in sorted(total_by_candle.keys())\n972\t        }\n973\t\n974\t        # Calculate overall MDA\n975\t        total_correct = sum(correct_by_candle.values())\n976\t        total_candles = sum(total_by_candle.values())\n977\t        mda = total_correct / total_candles if total_candles > 0 else 0.0\n978\t\n979\t        return mda, accuracy_by_candle\n980\t\n981\t    def _calculate_close_reasons(self) -> Dict[str, int]:\n982\t        \"\"\"\n983\t        Calculate distribution of position close reasons.\n984\t\n985\t        Returns:\n986\t            Dict mapping close_reason to count\n987\t        \"\"\"\n988\t        query = self.db.query(ActivePosition).filter(\n989\t            ActivePosition.is_active.is_(False),\n990\t            ActivePosition.decision_timestamp >= self.start_date,\n991\t            ActivePosition.decision_timestamp <= self.end_date,\n992\t        )\n993\t\n994\t        if self.backtest_run_id is not None:\n995\t            query = query.filter(ActivePosition.backtest_run_id == self.backtest_run_id)\n996\t\n997\t        positions = query.all()\n998\t\n999\t        close_reasons = {}\n1000\t        for pos in positions:\n1001\t            reason = pos.close_reason or \"unknown\"\n1002\t            close_reasons[reason] = close_reasons.get(reason, 0) + 1\n1003\t\n1004\t        return close_reasons\n1005\t\n1006\t    def _get_periods_per_year(self) -> int:\n1007\t        \"\"\"Get number of periods per year based on timeframe.\"\"\"\n1008\t        if self.timeframe == \"1h\":\n1009\t            return 252 * 6.5  # Trading days * hours per day\n1010\t        elif self.timeframe == \"4h\":\n1011\t            return 252 * 1.625  # Approx 1.6 periods per day\n1012\t        elif self.timeframe == \"1d\":\n1013\t            return 252\n1014\t        elif self.timeframe == \"1w\":\n1015\t            return 52\n1016\t        else:\n1017\t            return 252\n1018\t\n1019\t    def _update_backtest_run(self, metrics: BacktestMetrics) -> None:\n1020\t        \"\"\"Update BacktestRun record with final metrics.\"\"\"\n1021\t        if not self.backtest_run_id:\n1022\t            return\n1023\t\n1024\t        run = (\n1025\t            self.db.query(BacktestRun)\n1026\t            .filter(BacktestRun.id == self.backtest_run_id)\n1027\t            .first()\n1028\t        )\n1029\t\n1030\t        if run:\n1031\t            run.total_trades = metrics.total_trades\n1032\t            run.win_rate = metrics.win_rate\n1033\t            run.profit_factor = metrics.profit_factor\n1034\t            run.sharpe_ratio = metrics.sharpe_ratio\n1035\t            run.max_drawdown = metrics.max_drawdown\n1036\t            run.total_pnl = Decimal(str(metrics.total_pnl))\n1037\t\n1038\t            self.db.commit()\n1039\t            logger.info(\n1040\t                f\"Updated backtest run #{self.backtest_run_id} with final metrics\",\n1041\t                extra={\"event_type\": \"backtest_complete\"},\n1042\t            )\n1043\t\n1044\t    def get_equity_curve(self) -> pd.DataFrame:\n1045\t        \"\"\"\n1046\t        Get equity curve as DataFrame.\n1047\t\n1048\t        Returns:\n1049\t            DataFrame with columns: date, equity, cash, positions_value\n1050\t        \"\"\"\n1051\t        return pd.DataFrame(self.equity_curve)\n1052\t\n1053\t    def __del__(self):\n1054\t        \"\"\"Cleanup database session if we own it.\"\"\"\n1055\t        if self._own_session and self.db:\n1056\t            self.db.close()\n1057\t"}]},"parent_tool_use_id":null,"session_id":"f08f8d0e-dfe1-47d6-abdf-e601734c006c","uuid":"b317b854-0ef9-407e-b482-519c4be3acd9","timestamp":"2026-05-11T07:39:19.194Z","tool_use_result":{"type":"text","file":{"filePath":"/home/azureuser/repos/projects/QuantAgent/quantagent/backtesting/backtest.py","content":"\"\"\"Backtesting engine for strategy validation.\"\"\"\n\nimport logging\nimport math\nfrom dataclasses import dataclass\nfrom datetime import datetime, timedelta\nfrom decimal import Decimal\nfrom typing import Dict, List, Optional\n\nimport numpy as np\nimport pandas as pd\nfrom sqlalchemy.orm import Session\n\nfrom quantagent.agent_models import TradingDecision\nfrom quantagent.data.asset_types import AssetType, get_asset_type\nfrom quantagent.data.market_calendar import get_market_calendar\nfrom quantagent.data.provider import DataProvider\nfrom quantagent.database import SessionLocal\nfrom quantagent.models import (\n    ActivePosition,\n    BacktestRun,\n    Environment,\n    OrderSide,\n    Signal,\n    Trade,\n    TradeSignal,\n)\nfrom quantagent.static_util import format_ohlcv_for_agents\nfrom quantagent.strategy.assembler import StrategyAssembler\nfrom quantagent.strategy.base import TradingStrategy\nfrom quantagent.strategy.llm_agent_strategy import LLMAgentStrategy\nfrom quantagent.trading.position_monitor import PositionMonitor\n\nlogger = logging.getLogger(__name__)\n\n\n@dataclass\nclass BacktestMetrics:\n    \"\"\"Backtest performance metrics.\"\"\"\n\n    total_trades: int\n    winning_trades: int\n    losing_trades: int\n    win_rate: float\n    profit_factor: float\n    sharpe_ratio: float\n    max_drawdown: float\n    total_pnl: float\n    avg_win: float\n    avg_loss: float\n    largest_win: float\n    largest_loss: float\n    total_return_pct: float\n\n    # Phase 4: Active Position Monitoring metrics\n    agent_invocations: int = 0\n    invocations_saved: int = 0\n    invocation_reduction_pct: float = 0.0\n    mean_directional_accuracy: float = 0.0\n    accuracy_by_candle: Dict[int, float] = None\n    close_reasons: Dict[str, int] = None\n\n    def __post_init__(self):\n        if self.accuracy_by_candle is None:\n            self.accuracy_by_candle = {}\n        if self.close_reasons is None:\n            self.close_reasons = {}\n\n\nclass Backtest:\n    \"\"\"\n    Backtesting engine for validating trading strategies.\n\n    Workflow:\n    1. Loop through historical dates\n    2. Fetch OHLC data for each date using DataProvider (cached)\n    3. Execute analysis using TradingGraph\n    4. Simulate trade execution using OrderManager\n    5. Track portfolio performance\n    6. Calculate and persist metrics\n\n    Features:\n    - Uses DataProvider for 10x faster data access (caching)\n    - Executes same agents as live trading\n    - Stores full provenance (config snapshot, model metadata)\n    - Supports replay with different risk/portfolio profiles\n    \"\"\"\n\n    def __init__(\n        self,\n        start_date: datetime,\n        end_date: datetime,\n        assets: List[str],\n        timeframe: str = \"1h\",\n        initial_capital: float = 100000.0,\n        config: Optional[Dict] = None,\n        db_session: Optional[Session] = None,\n        use_checkpointing: bool = False,\n        strategy: Optional[TradingStrategy] = None,\n    ):\n        \"\"\"\n        Initialize Backtest.\n\n        Args:\n            start_date: Start date for backtest\n            end_date: End date for backtest\n            assets: List of asset symbols (e.g., [\"BTC\", \"SPX\", \"CL\"])\n            timeframe: Timeframe for analysis (e.g., \"1h\", \"4h\", \"1d\")\n            initial_capital: Starting portfolio value\n            config: Configuration dict (portfolio/risk params, model settings)\n            db_session: Database session (creates new if None)\n            use_checkpointing: Enable LangGraph checkpointing for state persistence\n            strategy: Optional TradingStrategy. If None, uses LLMAgentStrategy with TradingGraph\n        \"\"\"\n        self.start_date = start_date\n        self.end_date = end_date\n        self.assets = assets\n        self.timeframe = timeframe\n        self.initial_capital = initial_capital\n        self.config = config or {}\n        self.use_checkpointing = use_checkpointing\n\n        # Database\n        self.db = db_session or SessionLocal()\n        self._own_session = db_session is None\n\n        # Data provider (caching layer)\n        self.data_provider = DataProvider(self.db)\n\n        # Resolve config via StrategyAssembler and build components (unify DB session)\n        from quantagent import settings\n        \n        resolved = StrategyAssembler.from_snapshot(\n            {\n                \"initial_cash\": initial_capital,\n                \"base_position_pct\": self.config.get(\"base_position_pct\", settings.TRADING_BASE_POSITION_PCT),\n                \"max_daily_loss_pct\": self.config.get(\"max_daily_loss_pct\", settings.TRADING_MAX_DAILY_LOSS_PCT),\n                \"max_position_pct\": self.config.get(\"max_position_pct\", settings.TRADING_MAX_POSITION_PCT),\n                \"slippage_pct\": self.config.get(\"slippage_pct\", settings.TRADING_SLIPPAGE_PCT),\n                # Normalize model fields into generic ones; accept both\n                \"model_provider\": self.config.get(\n                    \"agent_llm_provider\", self.config.get(\"model_provider\", settings.AGENT_LLM_PROVIDER)\n                ),\n                \"model_name\": self.config.get(\n                    \"agent_llm_model\", self.config.get(\"model_name\", settings.AGENT_LLM_MODEL)\n                ),\n                \"temperature\": self.config.get(\n                    \"agent_llm_temperature\", self.config.get(\"temperature\", settings.AGENT_LLM_TEMPERATURE)\n                ),\n                \"use_checkpointing\": use_checkpointing,\n                \"universe\": self.config.get(\"universe\", settings.get_trading_universe()),\n            },\n            environment=Environment.BACKTEST,\n        )\n        components = StrategyAssembler.build_components(resolved, db_session=self.db)\n\n        # Trading graph (analysis engine)\n        self.trading_graph = components.graph\n\n        # Trading strategy (use provided or default to LLMAgentStrategy)\n        self.strategy = strategy or LLMAgentStrategy(self.trading_graph)\n\n        # Position monitor for active position tracking\n        self.position_monitor = PositionMonitor(self.db)\n\n        # Trading components\n        self.portfolio = components.portfolio_manager\n        self.position_sizer = components.position_sizer\n        self.risk_manager = components.risk_manager\n        self.broker = components.broker\n        self.order_manager = components.order_manager\n\n        # Backtest state\n        self.current_date = start_date\n        self.backtest_run_id: Optional[int] = None\n        self.trades: List[Trade] = []\n        self.equity_curve: List[Dict] = []\n\n        # Phase 4: Invocation tracking\n        self.agent_invocations = 0\n        self.total_candles_processed = 0\n\n        # Market hours filtering\n        self.market_hours_filter = self.config.get(\"market_hours_filter\", True)\n        self._market_calendar = (\n            get_market_calendar() if self.market_hours_filter else None\n        )\n\n        # Cache asset types for each symbol\n        self._asset_types: Dict[str, AssetType] = {\n            asset: get_asset_type(asset) for asset in assets\n        }\n\n    def run(self, name: Optional[str] = None) -> BacktestMetrics:\n        \"\"\"\n        Run backtest and return metrics.\n\n        Args:\n            name: Optional name for this backtest run\n\n        Returns:\n            BacktestMetrics with performance statistics\n        \"\"\"\n        logger.info(\n            f\"Starting backtest: {self.start_date} to {self.end_date}\",\n            extra={\"event_type\": \"backtest_start\", \"environment\": \"backtest\"},\n        )\n        logger.info(\n            f\"Assets: {self.assets}, Timeframe: {self.timeframe}\",\n            extra={\"event_type\": \"backtest_start\"},\n        )\n        logger.info(\n            f\"Initial capital: ${self.initial_capital:,.2f}\",\n            extra={\"event_type\": \"backtest_start\"},\n        )\n        logger.info(\n            f\"Market hours filter: {self.market_hours_filter}\",\n            extra={\"event_type\": \"backtest_start\"},\n        )\n\n        # Create backtest run record\n        self._create_backtest_run(name)\n\n        # Process each asset with its filtered date range\n        total_periods = 0\n        for asset in self.assets:\n            asset_dates = self._get_date_range_for_asset(asset)\n            total_periods += len(asset_dates)\n\n            asset_type = self._asset_types.get(asset, AssetType.UNKNOWN)\n            logger.info(\n                f\"Asset {asset} ({asset_type.value}): {len(asset_dates)} analysis periods\",\n                extra={\"event_type\": \"backtest_start\"},\n            )\n\n        logger.info(\n            f\"Backtesting {total_periods} total analysis periods\",\n            extra={\"event_type\": \"backtest_start\"},\n        )\n\n        # Track progress across all periods\n        periods_completed = 0\n\n        # Loop through assets (outer) and their dates (inner)\n        for asset in self.assets:\n            asset_dates = self._get_date_range_for_asset(asset)\n\n            for i, current_date in enumerate(asset_dates):\n                self.current_date = current_date\n\n                # Reset daily P&L tracking at start of each day\n                if i == 0 or current_date.date() != asset_dates[i - 1].date():\n                    self.risk_manager.reset_daily_tracker()\n\n                try:\n                    self._analyze_and_trade(asset, current_date)\n                except Exception as e:\n                    logger.error(\n                        f\"Error analyzing {asset} at {current_date}: {e}\",\n                        exc_info=True,\n                        extra={\"event_type\": \"backtest_error\", \"symbol\": asset},\n                    )\n                    continue\n\n                # Record equity at end of period\n                self._record_equity(current_date)\n\n                periods_completed += 1\n\n                # Log progress\n                if periods_completed % 100 == 0 or periods_completed == total_periods:\n                    progress = (periods_completed / total_periods) * 100\n                    logger.info(\n                        f\"Progress: {progress:.1f}% ({periods_completed}/{total_periods})\",\n                        extra={\"event_type\": \"backtest_progress\"},\n                    )\n\n        # Calculate metrics\n        metrics = self._calculate_metrics()\n\n        # Update backtest run with results\n        self._update_backtest_run(metrics)\n\n        logger.info(\n            f\"Backtest complete: {metrics.total_trades} trades, Win rate: {metrics.win_rate:.2%}\",\n            extra={\"event_type\": \"backtest_end\", \"environment\": \"backtest\"},\n        )\n        logger.info(\n            f\"Total P&L: ${metrics.total_pnl:,.2f} ({metrics.total_return_pct:.2%})\",\n            extra={\"event_type\": \"backtest_end\"},\n        )\n\n        return metrics\n\n    def _create_backtest_run(self, name: Optional[str]) -> None:\n        \"\"\"Create BacktestRun record in database.\"\"\"\n        run = BacktestRun(\n            name=name or f\"Backtest_{datetime.now().strftime('%Y%m%d_%H%M%S')}\",\n            timeframe=self.timeframe,\n            assets=self.assets,\n            start_date=self.start_date,\n            end_date=self.end_date,\n            config_snapshot=self._build_config_snapshot(),\n        )\n\n        self.db.add(run)\n        self.db.commit()\n        self.backtest_run_id = run.id\n\n        if self.position_monitor is not None:\n            self.position_monitor.set_backtest_run_id(self.backtest_run_id)\n\n        logger.info(\n            f\"Created backtest run #{self.backtest_run_id}: {run.name}\",\n            extra={\"event_type\": \"backtest_init\"},\n        )\n\n    def _build_config_snapshot(self) -> Dict:\n        \"\"\"Build immutable config snapshot for reproducibility.\"\"\"\n        from quantagent import settings\n        \n        # Re-generate snapshot via assembler to keep alignment\n        resolved = StrategyAssembler.from_snapshot(\n            {\n                \"initial_cash\": self.initial_capital,\n                \"base_position_pct\": self.config.get(\"base_position_pct\", settings.TRADING_BASE_POSITION_PCT),\n                \"max_daily_loss_pct\": self.config.get(\"max_daily_loss_pct\", settings.TRADING_MAX_DAILY_LOSS_PCT),\n                \"max_position_pct\": self.config.get(\"max_position_pct\", settings.TRADING_MAX_POSITION_PCT),\n                \"slippage_pct\": self.config.get(\"slippage_pct\", settings.TRADING_SLIPPAGE_PCT),\n                \"model_provider\": self.config.get(\n                    \"agent_llm_provider\", self.config.get(\"model_provider\", settings.AGENT_LLM_PROVIDER)\n                ),\n                \"model_name\": self.config.get(\n                    \"agent_llm_model\", self.config.get(\"model_name\", settings.AGENT_LLM_MODEL)\n                ),\n                \"temperature\": self.config.get(\n                    \"agent_llm_temperature\", self.config.get(\"temperature\", settings.AGENT_LLM_TEMPERATURE)\n                ),\n                \"use_checkpointing\": self.use_checkpointing,\n                \"universe\": self.config.get(\"universe\", settings.get_trading_universe()),\n            },\n            environment=Environment.BACKTEST,\n        )\n        return StrategyAssembler.config_snapshot(resolved)\n\n    def _get_date_range(self) -> List[datetime]:\n        \"\"\"\n        Get list of dates to backtest.\n\n        For hourly/intraday: every N hours\n        For daily: every day\n        \"\"\"\n        dates = []\n        current = self.start_date\n\n        # Determine step size based on timeframe\n        if self.timeframe in [\"1h\", \"4h\"]:\n            step_hours = int(self.timeframe.replace(\"h\", \"\"))\n            step = timedelta(hours=step_hours)\n        elif self.timeframe == \"1d\":\n            step = timedelta(days=1)\n        elif self.timeframe == \"1w\":\n            step = timedelta(weeks=1)\n        else:\n            # Default to hourly\n            step = timedelta(hours=1)\n\n        while current <= self.end_date:\n            dates.append(current)\n            current += step\n\n        return dates\n\n    def _get_date_range_for_asset(self, asset: str) -> List[datetime]:\n        \"\"\"\n        Get date range filtered by market hours for specific asset.\n\n        Args:\n            asset: Asset symbol\n\n        Returns:\n            List of valid trading timestamps for this asset\n        \"\"\"\n        all_dates = self._get_date_range()\n\n        if not self.market_hours_filter or self._market_calendar is None:\n            return all_dates\n\n        asset_type = self._asset_types.get(asset, AssetType.UNKNOWN)\n\n        return self._market_calendar.filter_to_trading_hours(all_dates, asset_type)\n\n    def _analyze_and_trade(self, asset: str, current_date: datetime) -> None:\n        \"\"\"\n        Execute analysis and trade for a single asset at a given time.\n\n        NEW FLOW (Hybrid Model with PositionMonitor):\n        1. Check for active position\n        2. If active: strategy.should_exit() → close or update tracking (NO invoke)\n        3. If not active: strategy.generate_signal() → open position if signal != HOLD\n\n        Args:\n            asset: Asset symbol\n            current_date: Current backtest date\n        \"\"\"\n        # Get historical data for analysis (need lookback period)\n        lookback_bars = self.strategy.required_history_bars\n        if lookback_bars <= 0:\n            lookback_bars = 30\n\n        data_start = current_date - timedelta(\n            days=self._bars_to_calendar_days(lookback_bars)\n        )\n\n        df = self.data_provider.get_ohlc(\n            symbol=asset,\n            timeframe=self.timeframe,\n            start_date=data_start,\n            end_date=current_date,\n        )\n\n        if df.empty or len(df) < lookback_bars:\n            logger.warning(\n                f\"Insufficient data for {asset} at {current_date} \"\n                f\"(got {len(df)}, need {lookback_bars})\",\n                extra={\"event_type\": \"backtest_data_warning\", \"symbol\": asset},\n            )\n            return\n\n        current_price = float(df.iloc[-1][\"close\"])\n\n        # Check for active position\n        active_pos = self.position_monitor.get_active_position(asset)\n\n        # Phase 4: Count total candles processed\n        self.total_candles_processed += 1\n\n        if active_pos:\n            # Position active: check exit conditions via strategy\n            should_exit, reason = self.strategy.should_exit(\n                active_pos, current_price, df\n            )\n\n            if should_exit:\n                # Close position\n                self.position_monitor.close_position(active_pos, reason, current_price)\n\n                # Execute close via OrderManager\n                if active_pos.trade_id:\n                    self.order_manager.close_trade(\n                        active_pos.trade_id,\n                        current_price,\n                        environment=Environment.BACKTEST,\n                    )\n                    logger.info(\n                        f\"{asset}: Closed position - {reason} @ ${current_price:.2f}\"\n                    )\n                # Continue to potentially open new position below\n            else:\n                # Position still active: update tracking only (NO INVOKE)\n                prev_close = (\n                    float(df.iloc[-2][\"close\"]) if len(df) >= 2 else current_price\n                )\n                self.position_monitor.update_candle_tracking(\n                    active_pos, current_price, prev_close\n                )\n                return  # Early return - invocation saved\n\n        # No active position (or just closed): generate signal\n        if isinstance(self.strategy, LLMAgentStrategy):\n            kline_data = format_ohlcv_for_agents(df)\n        else:\n            kline_data = df.to_dict(orient=\"records\")\n\n        # Phase 4: Count agent invocations\n        self.agent_invocations += 1\n\n        # Generate thread_id for checkpointing (if enabled)\n        thread_id = None\n        if self.use_checkpointing:\n            from quantagent.strategy.assembler import StrategyAssembler\n\n            thread_id = StrategyAssembler.make_thread_id(\n                self.backtest_run_id, asset, current_date\n            )\n\n        signal_kwargs = {}\n        if thread_id is not None:\n            signal_kwargs[\"thread_id\"] = thread_id\n\n        signal = self.strategy.generate_signal(\n            kline_data, asset, self.timeframe, current_price, **signal_kwargs\n        )\n\n        if signal is None or signal.decision == \"HOLD\":\n            return\n\n        # Execute trade\n        trading_signal = (\n            TradeSignal.LONG if signal.decision == \"LONG\" else TradeSignal.SHORT\n        )\n\n        # Store signal in database\n        db_signal = self._create_signal_from_strategy(\n            asset=asset,\n            decision=trading_signal,\n            confidence=signal.confidence,\n            reasoning=signal.reasoning,\n            current_date=current_date,\n        )\n\n        # Execute order\n        order = self.order_manager.execute_decision(\n            symbol=asset,\n            decision=trading_signal,\n            confidence=signal.confidence,\n            current_price=current_price,\n            environment=Environment.BACKTEST,\n            trigger_signal_id=db_signal.id if db_signal else None,\n        )\n\n        if order and order.filled_quantity and order.filled_quantity > 0:\n            # Create ActivePosition\n            side = (\n                OrderSide.BUY if trading_signal == TradeSignal.LONG else OrderSide.SELL\n            )\n\n            # Get trade_id from order\n            trade_id = None\n            if order.id:\n                trade = self.db.query(Trade).filter(Trade.order_id == order.id).first()\n                if trade:\n                    trade_id = trade.id\n\n            self.position_monitor.open_position(\n                symbol=asset,\n                side=side,\n                entry_price=signal.entry_price or current_price,\n                stop_loss=signal.stop_loss\n                or (\n                    current_price * 0.98\n                    if side == OrderSide.BUY\n                    else current_price * 1.02\n                ),\n                take_profit=signal.take_profit\n                or (\n                    current_price * 1.03\n                    if side == OrderSide.BUY\n                    else current_price * 0.97\n                ),\n                quantity=order.filled_quantity,\n                exit_policy=signal.exit_policy.value,\n                trade_id=trade_id,\n                signal_id=db_signal.id if db_signal else None,\n                trailing_stop_pct=signal.trailing_stop_pct,\n                max_hold_candles=signal.max_hold_candles,\n            )\n\n            logger.info(\n                f\"Executed {trading_signal.value} for {asset} \"\n                f\"@ \"\n                f\"${current_price:.2f}, qty: {order.filled_quantity}\"\n            )\n\n    def _bars_to_calendar_days(self, bars: int) -> int:\n        \"\"\"Convert required trading bars to a calendar-day lookback window.\"\"\"\n        if self.timeframe == \"1d\":\n            return math.ceil(bars * 365 / 252)\n        if self.timeframe == \"1h\":\n            return math.ceil(bars / 6.5 * 7 / 5)\n        if self.timeframe == \"4h\":\n            return math.ceil(bars * 4 / 6.5 * 7 / 5)\n        return bars * 2\n\n    def _parse_decision(self, decision: TradingDecision) -> (TradeSignal, float):\n        \"\"\"Parse decision text to extract LONG/SHORT/HOLD and confidence.\"\"\"\n        decision_upper = decision.decision.upper()\n        signal = TradeSignal.NEUTRAL\n\n        if \"LONG\" in decision_upper or \"BUY\" in decision_upper:\n            signal = TradeSignal.LONG\n        elif \"SHORT\" in decision_upper or \"SELL\" in decision_upper:\n            signal = TradeSignal.SHORT\n        else:\n            signal = TradeSignal.NEUTRAL\n\n        ind = float(decision.confidence)\n\n        return signal, ind\n\n    def _create_signal_from_strategy(\n        self,\n        asset: str,\n        decision: TradeSignal,\n        confidence: float,\n        reasoning: str,\n        current_date: datetime,\n    ) -> Optional[Signal]:\n        \"\"\"Create Signal record from strategy output (simplified).\"\"\"\n        from quantagent import settings\n        \n        try:\n            signal = Signal(\n                symbol=asset,\n                signal=decision,\n                confidence=confidence,\n                timeframe=self.timeframe,\n                analysis_summary=reasoning,\n                generated_at=current_date,\n                environment=Environment.BACKTEST,\n                model_provider=self.config.get(\"agent_llm_provider\", settings.AGENT_LLM_PROVIDER),\n                model_name=self.config.get(\"agent_llm_model\", settings.AGENT_LLM_MODEL),\n                temperature=self.config.get(\"agent_llm_temperature\", settings.AGENT_LLM_TEMPERATURE),\n            )\n\n            self.db.add(signal)\n            self.db.commit()\n            return signal\n\n        except Exception as e:\n            logger.error(f\"Error creating signal: {e}\", exc_info=True)\n            return None\n\n    def _create_signal(\n        self,\n        asset: str,\n        decision: TradeSignal,\n        confidence: float,\n        result: Dict,\n        current_date: datetime,\n        thread_id: Optional[str] = None,\n    ) -> Optional[Signal]:\n        \"\"\"Create and persist Signal record.\"\"\"\n        try:\n            # Extract technical indicators\n            rsi = None\n            macd = None\n            stochastic = None\n            roc = None\n            williams_r = None\n            pattern = None\n            trend = None\n\n            if \"rsi\" in result and result[\"rsi\"]:\n                rsi = (\n                    float(result[\"rsi\"][-1])\n                    if isinstance(result[\"rsi\"], list)\n                    else float(result[\"rsi\"])\n                )\n\n            if \"macd\" in result and result[\"macd\"]:\n                macd = (\n                    float(result[\"macd\"][-1])\n                    if isinstance(result[\"macd\"], list)\n                    else float(result[\"macd\"])\n                )\n\n            indicator_report = result.get(\"indicator_report\")\n            if indicator_report and hasattr(indicator_report, \"rsi\"):\n                rsi = float(indicator_report.rsi)\n            if indicator_report and hasattr(indicator_report, \"macd\"):\n                macd = float(indicator_report.macd)\n            if indicator_report and hasattr(indicator_report, \"stochastic\"):\n                stochastic = float(indicator_report.stochastic)\n            if indicator_report and hasattr(indicator_report, \"roc\"):\n                roc = float(indicator_report.roc)\n            if indicator_report and hasattr(indicator_report, \"willr\"):\n                williams_r = float(indicator_report.willr)\n\n            # Get pattern and trend from reports\n            pattern_report = result.get(\"pattern_report\")\n            if pattern_report and hasattr(pattern_report, \"primary_pattern\"):\n                pattern = pattern_report.primary_pattern\n\n            trend_report = result.get(\"trend_report\")\n            if trend_report and hasattr(trend_report, \"trend_direction\"):\n                trend = trend_report.trend_direction\n\n            # Create signal\n            from quantagent import settings\n            \n            signal = Signal(\n                symbol=asset,\n                signal=decision,\n                confidence=confidence,\n                timeframe=self.timeframe,\n                rsi=rsi,\n                macd=macd,\n                stochastic=stochastic,\n                roc=roc,\n                williams_r=williams_r,\n                pattern=pattern,\n                trend=trend,\n                analysis_summary=result.get(\"reasoning\", \"\"),\n                generated_at=current_date,\n                environment=Environment.BACKTEST,\n                thread_id=thread_id,\n                model_provider=self.config.get(\"agent_llm_provider\", settings.AGENT_LLM_PROVIDER),\n                model_name=self.config.get(\"agent_llm_model\", settings.AGENT_LLM_MODEL),\n                temperature=self.config.get(\"agent_llm_temperature\", settings.AGENT_LLM_TEMPERATURE),\n            )\n\n            self.db.add(signal)\n            self.db.commit()\n\n            return signal\n\n        except Exception as e:\n            logger.error(\n                f\"Error creating signal: {e}\",\n                exc_info=True,\n                extra={\"event_type\": \"backtest_error\"},\n            )\n            return None\n\n    def _record_equity(self, current_date: datetime) -> None:\n        \"\"\"Record equity curve data point.\"\"\"\n        total_value = self.portfolio.get_total_value()\n\n        self.equity_curve.append(\n            {\n                \"date\": current_date,\n                \"equity\": total_value,\n                \"cash\": self.portfolio.cash,\n                \"positions_value\": total_value - self.portfolio.cash,\n            }\n        )\n\n    def _calculate_metrics(self) -> BacktestMetrics:\n        \"\"\"\n        Calculate backtest performance metrics.\n\n        Metrics:\n        - Win rate: % of winning trades\n        - Profit factor: sum(wins) / abs(sum(losses))\n        - Sharpe ratio: (return - risk_free) / volatility\n        - Max drawdown: worst peak-to-trough decline\n        - Total P&L: sum of all trade P&L\n        \"\"\"\n        # Get all trades from database for this backtest\n        trades = (\n            self.db.query(Trade)\n            .filter(\n                Trade.environment == Environment.BACKTEST,\n                Trade.opened_at >= self.start_date,\n                Trade.opened_at <= self.end_date,\n            )\n            .all()\n        )\n\n        if not trades:\n            logger.warning(\n                \"No trades executed during backtest\",\n                extra={\"event_type\": \"backtest_warning\"},\n            )\n\n            # Phase 4: Even with no trades, calculate MDA if positions were opened\n            mda, accuracy_by_candle = self._calculate_directional_accuracy()\n            close_reasons = self._calculate_close_reasons()\n\n            invocations_saved = self.total_candles_processed - self.agent_invocations\n            invocation_reduction_pct = (\n                (invocations_saved / self.total_candles_processed * 100)\n                if self.total_candles_processed > 0\n                else 0.0\n            )\n\n            return BacktestMetrics(\n                total_trades=0,\n                winning_trades=0,\n                losing_trades=0,\n                win_rate=0.0,\n                profit_factor=0.0,\n                sharpe_ratio=0.0,\n                max_drawdown=0.0,\n                total_pnl=0.0,\n                avg_win=0.0,\n                avg_loss=0.0,\n                largest_win=0.0,\n                largest_loss=0.0,\n                total_return_pct=0.0,\n                agent_invocations=self.agent_invocations,\n                invocations_saved=invocations_saved,\n                invocation_reduction_pct=invocation_reduction_pct,\n                mean_directional_accuracy=mda,\n                accuracy_by_candle=accuracy_by_candle,\n                close_reasons=close_reasons,\n            )\n\n        # Calculate basic metrics\n        total_trades = len(trades)\n        winning_trades = [t for t in trades if t.pnl and float(t.pnl) > 0]\n        losing_trades = [t for t in trades if t.pnl and float(t.pnl) < 0]\n\n        total_wins = sum(float(t.pnl) for t in winning_trades)\n        total_losses = abs(sum(float(t.pnl) for t in losing_trades))\n\n        # Win rate\n        win_rate = len(winning_trades) / total_trades if total_trades > 0 else 0.0\n\n        # Profit factor\n        profit_factor = (\n            total_wins / total_losses\n            if total_losses > 0\n            else float(\"inf\") if total_wins > 0 else 0.0\n        )\n\n        # Total P&L\n        total_pnl = sum(float(t.pnl) for t in trades if t.pnl)\n\n        # Average win/loss\n        avg_win = total_wins / len(winning_trades) if winning_trades else 0.0\n        avg_loss = total_losses / len(losing_trades) if losing_trades else 0.0\n\n        # Largest win/loss\n        largest_win = max((float(t.pnl) for t in winning_trades), default=0.0)\n        largest_loss = min((float(t.pnl) for t in losing_trades), default=0.0)\n\n        # Total return %\n        total_return_pct = (\n            (total_pnl / self.initial_capital) * 100\n            if self.initial_capital > 0\n            else 0.0\n        )\n\n        # Sharpe ratio\n        sharpe_ratio = self._calculate_sharpe_ratio()\n\n        # Max drawdown\n        max_drawdown = self._calculate_max_drawdown()\n\n        # Phase 4: Calculate MDA and accuracy metrics\n        mda, accuracy_by_candle = self._calculate_directional_accuracy()\n\n        # Phase 4: Calculate close reasons distribution\n        close_reasons = self._calculate_close_reasons()\n\n        # Phase 4: Calculate invocation reduction\n        invocations_saved = self.total_candles_processed - self.agent_invocations\n        invocation_reduction_pct = (\n            (invocations_saved / self.total_candles_processed * 100)\n            if self.total_candles_processed > 0\n            else 0.0\n        )\n\n        return BacktestMetrics(\n            total_trades=total_trades,\n            winning_trades=len(winning_trades),\n            losing_trades=len(losing_trades),\n            win_rate=win_rate,\n            profit_factor=profit_factor,\n            sharpe_ratio=sharpe_ratio,\n            max_drawdown=max_drawdown,\n            total_pnl=total_pnl,\n            avg_win=avg_win,\n            avg_loss=avg_loss,\n            largest_win=largest_win,\n            largest_loss=largest_loss,\n            total_return_pct=total_return_pct,\n            agent_invocations=self.agent_invocations,\n            invocations_saved=invocations_saved,\n            invocation_reduction_pct=invocation_reduction_pct,\n            mean_directional_accuracy=mda,\n            accuracy_by_candle=accuracy_by_candle,\n            close_reasons=close_reasons,\n        )\n\n    def _calculate_sharpe_ratio(self, risk_free_rate: float = 0.02) -> float:\n        \"\"\"\n        Calculate Sharpe ratio.\n\n        Formula: (return - risk_free) / volatility\n\n        Args:\n            risk_free_rate: Annual risk-free rate (default: 2%)\n\n        Returns:\n            Sharpe ratio\n        \"\"\"\n        if len(self.equity_curve) < 2:\n            return 0.0\n\n        # Calculate returns\n        equity_series = pd.Series([e[\"equity\"] for e in self.equity_curve])\n        returns = equity_series.pct_change().dropna()\n\n        if len(returns) == 0 or returns.std() == 0:\n            return 0.0\n\n        # Annualize based on timeframe\n        periods_per_year = self._get_periods_per_year()\n\n        # Calculate Sharpe\n        excess_return = returns.mean() - (risk_free_rate / periods_per_year)\n        sharpe = (excess_return / returns.std()) * np.sqrt(periods_per_year)\n\n        return float(sharpe)\n\n    def _calculate_max_drawdown(self) -> float:\n        \"\"\"\n        Calculate maximum drawdown.\n\n        Formula: max((peak - trough) / peak)\n\n        Returns:\n            Max drawdown as decimal (e.g., 0.15 = 15%)\n        \"\"\"\n        if len(self.equity_curve) < 2:\n            return 0.0\n\n        equity_series = pd.Series([e[\"equity\"] for e in self.equity_curve])\n\n        # Calculate running maximum\n        running_max = equity_series.expanding().max()\n\n        # Calculate drawdown\n        drawdown = (equity_series - running_max) / running_max\n\n        # Maximum drawdown (most negative)\n        max_dd = abs(drawdown.min())\n\n        return float(max_dd)\n\n    def _calculate_directional_accuracy(self) -> tuple[float, Dict[int, float]]:\n        \"\"\"\n        Calculate Mean Directional Accuracy (MDA) and per-candle accuracy.\n\n        MDA = (correct_candles / total_candles_evaluated)\n\n        Returns:\n            Tuple of (mean_directional_accuracy, accuracy_by_candle)\n        \"\"\"\n        query = self.db.query(ActivePosition).filter(\n            ActivePosition.is_active.is_(False),\n            ActivePosition.decision_timestamp >= self.start_date,\n            ActivePosition.decision_timestamp <= self.end_date,\n        )\n\n        if self.backtest_run_id is not None:\n            query = query.filter(ActivePosition.backtest_run_id == self.backtest_run_id)\n\n        positions = query.all()\n\n        if not positions:\n            return 0.0, {}\n\n        # Track correct predictions per candle index\n        correct_by_candle = {}\n        total_by_candle = {}\n\n        for pos in positions:\n            expected_direction = \"up\" if pos.side == OrderSide.BUY else \"down\"\n\n            # Evaluate up to prediction_horizon candles\n            for i, direction in enumerate(\n                pos.candles_direction[: pos.prediction_horizon]\n            ):\n                candle_idx = i + 1  # 1-indexed (candle 1, 2, 3...)\n\n                if candle_idx not in correct_by_candle:\n                    correct_by_candle[candle_idx] = 0\n                    total_by_candle[candle_idx] = 0\n\n                total_by_candle[candle_idx] += 1\n                if direction == expected_direction:\n                    correct_by_candle[candle_idx] += 1\n\n        # Calculate accuracy per candle\n        accuracy_by_candle = {\n            candle: correct_by_candle[candle] / total_by_candle[candle]\n            for candle in sorted(total_by_candle.keys())\n        }\n\n        # Calculate overall MDA\n        total_correct = sum(correct_by_candle.values())\n        total_candles = sum(total_by_candle.values())\n        mda = total_correct / total_candles if total_candles > 0 else 0.0\n\n        return mda, accuracy_by_candle\n\n    def _calculate_close_reasons(self) -> Dict[str, int]:\n        \"\"\"\n        Calculate distribution of position close reasons.\n\n        Returns:\n            Dict mapping close_reason to count\n        \"\"\"\n        query = self.db.query(ActivePosition).filter(\n            ActivePosition.is_active.is_(False),\n            ActivePosition.decision_timestamp >= self.start_date,\n            ActivePosition.decision_timestamp <= self.end_date,\n        )\n\n        if self.backtest_run_id is not None:\n            query = query.filter(ActivePosition.backtest_run_id == self.backtest_run_id)\n\n        positions = query.all()\n\n        close_reasons = {}\n        for pos in positions:\n            reason = pos.close_reason or \"unknown\"\n            close_reasons[reason] = close_reasons.get(reason, 0) + 1\n\n        return close_reasons\n\n    def _get_periods_per_year(self) -> int:\n        \"\"\"Get number of periods per year based on timeframe.\"\"\"\n        if self.timeframe == \"1h\":\n            return 252 * 6.5  # Trading days * hours per day\n        elif self.timeframe == \"4h\":\n            return 252 * 1.625  # Approx 1.6 periods per day\n        elif self.timeframe == \"1d\":\n            return 252\n        elif self.timeframe == \"1w\":\n            return 52\n        else:\n            return 252\n\n    def _update_backtest_run(self, metrics: BacktestMetrics) -> None:\n        \"\"\"Update BacktestRun record with final metrics.\"\"\"\n        if not self.backtest_run_id:\n            return\n\n        run = (\n            self.db.query(BacktestRun)\n            .filter(BacktestRun.id == self.backtest_run_id)\n            .first()\n        )\n\n        if run:\n            run.total_trades = metrics.total_trades\n            run.win_rate = metrics.win_rate\n            run.profit_factor = metrics.profit_factor\n            run.sharpe_ratio = metrics.sharpe_ratio\n            run.max_drawdown = metrics.max_drawdown\n            run.total_pnl = Decimal(str(metrics.total_pnl))\n\n            self.db.commit()\n            logger.info(\n                f\"Updated backtest run #{self.backtest_run_id} with final metrics\",\n                extra={\"event_type\": \"backtest_complete\"},\n            )\n\n    def get_equity_curve(self) -> pd.DataFrame:\n        \"\"\"\n        Get equity curve as DataFrame.\n\n        Returns:\n            DataFrame with columns: date, equity, cash, positions_value\n        \"\"\"\n        return pd.DataFrame(self.equity_curve)\n\n    def __del__(self):\n        \"\"\"Cleanup database session if we own it.\"\"\"\n        if self._own_session and self.db:\n            self.db.close()\n","numLines":1057,"startLine":1,"totalLines":1057}}}
