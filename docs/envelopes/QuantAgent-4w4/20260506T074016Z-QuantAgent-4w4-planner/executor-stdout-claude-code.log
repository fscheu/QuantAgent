{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_012NRUVtJwyUbfzDJ9yh1ujq","type":"tool_result","content":"1\t\"\"\"Backtesting engine for strategy validation.\"\"\"\n2\t\n3\timport logging\n4\tfrom dataclasses import dataclass\n5\tfrom datetime import datetime, timedelta\n6\tfrom decimal import Decimal\n7\tfrom typing import Dict, List, Optional\n8\t\n9\timport numpy as np\n10\timport pandas as pd\n11\tfrom sqlalchemy.orm import Session\n12\t\n13\tfrom quantagent.agent_models import TradingDecision\n14\tfrom quantagent.data.asset_types import AssetType, get_asset_type\n15\tfrom quantagent.data.market_calendar import get_market_calendar\n16\tfrom quantagent.data.provider import DataProvider\n17\tfrom quantagent.database import SessionLocal\n18\tfrom quantagent.models import (\n19\t    ActivePosition,\n20\t    BacktestRun,\n21\t    Environment,\n22\t    OrderSide,\n23\t    Signal,\n24\t    Trade,\n25\t    TradeSignal,\n26\t)\n27\tfrom quantagent.static_util import format_ohlcv_for_agents\n28\tfrom quantagent.strategy.assembler import StrategyAssembler\n29\tfrom quantagent.strategy.base import TradingStrategy\n30\tfrom quantagent.strategy.llm_agent_strategy import LLMAgentStrategy\n31\tfrom quantagent.trading.position_monitor import PositionMonitor\n32\t\n33\tlogger = logging.getLogger(__name__)\n34\t\n35\t\n36\t@dataclass\n37\tclass BacktestMetrics:\n38\t    \"\"\"Backtest performance metrics.\"\"\"\n39\t\n40\t    total_trades: int\n41\t    winning_trades: int\n42\t    losing_trades: int\n43\t    win_rate: float\n44\t    profit_factor: float\n45\t    sharpe_ratio: float\n46\t    max_drawdown: float\n47\t    total_pnl: float\n48\t    avg_win: float\n49\t    avg_loss: float\n50\t    largest_win: float\n51\t    largest_loss: float\n52\t    total_return_pct: float\n53\t\n54\t    # Phase 4: Active Position Monitoring metrics\n55\t    agent_invocations: int = 0\n56\t    invocations_saved: int = 0\n57\t    invocation_reduction_pct: float = 0.0\n58\t    mean_directional_accuracy: float = 0.0\n59\t    accuracy_by_candle: Dict[int, float] = None\n60\t    close_reasons: Dict[str, int] = None\n61\t\n62\t    def __post_init__(self):\n63\t        if self.accuracy_by_candle is None:\n64\t            self.accuracy_by_candle = {}\n65\t        if self.close_reasons is None:\n66\t            self.close_reasons = {}\n67\t\n68\t\n69\tclass Backtest:\n70\t    \"\"\"\n71\t    Backtesting engine for validating trading strategies.\n72\t\n73\t    Workflow:\n74\t    1. Loop through historical dates\n75\t    2. Fetch OHLC data for each date using DataProvider (cached)\n76\t    3. Execute analysis using TradingGraph\n77\t    4. Simulate trade execution using OrderManager\n78\t    5. Track portfolio performance\n79\t    6. Calculate and persist metrics\n80\t\n81\t    Features:\n82\t    - Uses DataProvider for 10x faster data access (caching)\n83\t    - Executes same agents as live trading\n84\t    - Stores full provenance (config snapshot, model metadata)\n85\t    - Supports replay with different risk/portfolio profiles\n86\t    \"\"\"\n87\t\n88\t    def __init__(\n89\t        self,\n90\t        start_date: datetime,\n91\t        end_date: datetime,\n92\t        assets: List[str],\n93\t        timeframe: str = \"1h\",\n94\t        initial_capital: float = 100000.0,\n95\t        config: Optional[Dict] = None,\n96\t        db_session: Optional[Session] = None,\n97\t        use_checkpointing: bool = False,\n98\t        strategy: Optional[TradingStrategy] = None,\n99\t    ):\n100\t        \"\"\"\n101\t        Initialize Backtest.\n102\t\n103\t        Args:\n104\t            start_date: Start date for backtest\n105\t            end_date: End date for backtest\n106\t            assets: List of asset symbols (e.g., [\"BTC\", \"SPX\", \"CL\"])\n107\t            timeframe: Timeframe for analysis (e.g., \"1h\", \"4h\", \"1d\")\n108\t            initial_capital: Starting portfolio value\n109\t            config: Configuration dict (portfolio/risk params, model settings)\n110\t            db_session: Database session (creates new if None)\n111\t            use_checkpointing: Enable LangGraph checkpointing for state persistence\n112\t            strategy: Optional TradingStrategy. If None, uses LLMAgentStrategy with TradingGraph\n113\t        \"\"\"\n114\t        self.start_date = start_date\n115\t        self.end_date = end_date\n116\t        self.assets = assets\n117\t        self.timeframe = timeframe\n118\t        self.initial_capital = initial_capital\n119\t        self.config = config or {}\n120\t        self.use_checkpointing = use_checkpointing\n121\t\n122\t        # Database\n123\t        self.db = db_session or SessionLocal()\n124\t        self._own_session = db_session is None\n125\t\n126\t        # Data provider (caching layer)\n127\t        self.data_provider = DataProvider(self.db)\n128\t\n129\t        # Resolve config via StrategyAssembler and build components (unify DB session)\n130\t        resolved = StrategyAssembler.from_snapshot(\n131\t            {\n132\t                \"initial_cash\": initial_capital,\n133\t                \"base_position_pct\": self.config.get(\"base_position_pct\", 0.05),\n134\t                \"max_daily_loss_pct\": self.config.get(\"max_daily_loss_pct\", 0.05),\n135\t                \"max_position_pct\": self.config.get(\"max_position_pct\", 0.10),\n136\t                \"slippage_pct\": self.config.get(\"slippage_pct\", 0.01),\n137\t                # Normalize model fields into generic ones; accept both\n138\t                \"model_provider\": self.config.get(\n139\t                    \"agent_llm_provider\", self.config.get(\"model_provider\", \"openai\")\n140\t                ),\n141\t                \"model_name\": self.config.get(\n142\t                    \"agent_llm_model\", self.config.get(\"model_name\", \"gpt-4o-mini\")\n143\t                ),\n144\t                \"temperature\": self.config.get(\n145\t                    \"agent_llm_temperature\", self.config.get(\"temperature\", 0.1)\n146\t                ),\n147\t                \"use_checkpointing\": use_checkpointing,\n148\t                \"universe\": self.config.get(\"universe\", []),\n149\t            },\n150\t            environment=Environment.BACKTEST,\n151\t        )\n152\t        components = StrategyAssembler.build_components(resolved, db_session=self.db)\n153\t\n154\t        # Trading graph (analysis engine)\n155\t        self.trading_graph = components.graph\n156\t\n157\t        # Trading strategy (use provided or default to LLMAgentStrategy)\n158\t        self.strategy = strategy or LLMAgentStrategy(self.trading_graph)\n159\t\n160\t        # Position monitor for active position tracking\n161\t        self.position_monitor = PositionMonitor(self.db)\n162\t\n163\t        # Trading components\n164\t        self.portfolio = components.portfolio_manager\n165\t        self.position_sizer = components.position_sizer\n166\t        self.risk_manager = components.risk_manager\n167\t        self.broker = components.broker\n168\t        self.order_manager = components.order_manager\n169\t\n170\t        # Backtest state\n171\t        self.current_date = start_date\n172\t        self.backtest_run_id: Optional[int] = None\n173\t        self.trades: List[Trade] = []\n174\t        self.equity_curve: List[Dict] = []\n175\t\n176\t        # Phase 4: Invocation tracking\n177\t        self.agent_invocations = 0\n178\t        self.total_candles_processed = 0\n179\t\n180\t        # Market hours filtering\n181\t        self.market_hours_filter = self.config.get(\"market_hours_filter\", True)\n182\t        self._market_calendar = (\n183\t            get_market_calendar() if self.market_hours_filter else None\n184\t        )\n185\t\n186\t        # Cache asset types for each symbol\n187\t        self._asset_types: Dict[str, AssetType] = {\n188\t            asset: get_asset_type(asset) for asset in assets\n189\t        }\n190\t\n191\t    def run(self, name: Optional[str] = None) -> BacktestMetrics:\n192\t        \"\"\"\n193\t        Run backtest and return metrics.\n194\t\n195\t        Args:\n196\t            name: Optional name for this backtest run\n197\t\n198\t        Returns:\n199\t            BacktestMetrics with performance statistics\n200\t        \"\"\"\n201\t        logger.info(\n202\t            f\"Starting backtest: {self.start_date} to {self.end_date}\",\n203\t            extra={\"event_type\": \"backtest_start\", \"environment\": \"backtest\"},\n204\t        )\n205\t        logger.info(\n206\t            f\"Assets: {self.assets}, Timeframe: {self.timeframe}\",\n207\t            extra={\"event_type\": \"backtest_start\"},\n208\t        )\n209\t        logger.info(\n210\t            f\"Initial capital: ${self.initial_capital:,.2f}\",\n211\t            extra={\"event_type\": \"backtest_start\"},\n212\t        )\n213\t        logger.info(\n214\t            f\"Market hours filter: {self.market_hours_filter}\",\n215\t            extra={\"event_type\": \"backtest_start\"},\n216\t        )\n217\t\n218\t        # Create backtest run record\n219\t        self._create_backtest_run(name)\n220\t\n221\t        # Process each asset with its filtered date range\n222\t        total_periods = 0\n223\t        for asset in self.assets:\n224\t            asset_dates = self._get_date_range_for_asset(asset)\n225\t            total_periods += len(asset_dates)\n226\t\n227\t            asset_type = self._asset_types.get(asset, AssetType.UNKNOWN)\n228\t            logger.info(\n229\t                f\"Asset {asset} ({asset_type.value}): {len(asset_dates)} analysis periods\",\n230\t                extra={\"event_type\": \"backtest_start\"},\n231\t            )\n232\t\n233\t        logger.info(\n234\t            f\"Backtesting {total_periods} total analysis periods\",\n235\t            extra={\"event_type\": \"backtest_start\"},\n236\t        )\n237\t\n238\t        # Track progress across all periods\n239\t        periods_completed = 0\n240\t\n241\t        # Loop through assets (outer) and their dates (inner)\n242\t        for asset in self.assets:\n243\t            asset_dates = self._get_date_range_for_asset(asset)\n244\t\n245\t            for i, current_date in enumerate(asset_dates):\n246\t                self.current_date = current_date\n247\t\n248\t                # Reset daily P&L tracking at start of each day\n249\t                if i == 0 or current_date.date() != asset_dates[i - 1].date():\n250\t                    self.risk_manager.reset_daily_tracker()\n251\t\n252\t                try:\n253\t                    self._analyze_and_trade(asset, current_date)\n254\t                except Exception as e:\n255\t                    logger.error(\n256\t                        f\"Error analyzing {asset} at {current_date}: {e}\",\n257\t                        exc_info=True,\n258\t                        extra={\"event_type\": \"backtest_error\", \"symbol\": asset},\n259\t                    )\n260\t                    continue\n261\t\n262\t                # Record equity at end of period\n263\t                self._record_equity(current_date)\n264\t\n265\t                periods_completed += 1\n266\t\n267\t                # Log progress\n268\t                if periods_completed % 100 == 0 or periods_completed == total_periods:\n269\t                    progress = (periods_completed / total_periods) * 100\n270\t                    logger.info(\n271\t                        f\"Progress: {progress:.1f}% ({periods_completed}/{total_periods})\",\n272\t                        extra={\"event_type\": \"backtest_progress\"},\n273\t                    )\n274\t\n275\t        # Calculate metrics\n276\t        metrics = self._calculate_metrics()\n277\t\n278\t        # Update backtest run with results\n279\t        self._update_backtest_run(metrics)\n280\t\n281\t        logger.info(\n282\t            f\"Backtest complete: {metrics.total_trades} trades, Win rate: {metrics.win_rate:.2%}\",\n283\t            extra={\"event_type\": \"backtest_end\", \"environment\": \"backtest\"},\n284\t        )\n285\t        logger.info(\n286\t            f\"Total P&L: ${metrics.total_pnl:,.2f} ({metrics.total_return_pct:.2%})\",\n287\t            extra={\"event_type\": \"backtest_end\"},\n288\t        )\n289\t\n290\t        return metrics\n291\t\n292\t    def _create_backtest_run(self, name: Optional[str]) -> None:\n293\t        \"\"\"Create BacktestRun record in database.\"\"\"\n294\t        run = BacktestRun(\n295\t            name=name or f\"Backtest_{datetime.now().strftime('%Y%m%d_%H%M%S')}\",\n296\t            timeframe=self.timeframe,\n297\t            assets=self.assets,\n298\t            start_date=self.start_date,\n299\t            end_date=self.end_date,\n300\t            config_snapshot=self._build_config_snapshot(),\n301\t        )\n302\t\n303\t        self.db.add(run)\n304\t        self.db.commit()\n305\t        self.backtest_run_id = run.id\n306\t\n307\t        if self.position_monitor is not None:\n308\t            self.position_monitor.set_backtest_run_id(self.backtest_run_id)\n309\t\n310\t        logger.info(\n311\t            f\"Created backtest run #{self.backtest_run_id}: {run.name}\",\n312\t            extra={\"event_type\": \"backtest_init\"},\n313\t        )\n314\t\n315\t    def _build_config_snapshot(self) -> Dict:\n316\t        \"\"\"Build immutable config snapshot for reproducibility.\"\"\"\n317\t        # Re-generate snapshot via assembler to keep alignment\n318\t        resolved = StrategyAssembler.from_snapshot(\n319\t            {\n320\t                \"initial_cash\": self.initial_capital,\n321\t                \"base_position_pct\": self.config.get(\"base_position_pct\", 0.05),\n322\t                \"max_daily_loss_pct\": self.config.get(\"max_daily_loss_pct\", 0.05),\n323\t                \"max_position_pct\": self.config.get(\"max_position_pct\", 0.10),\n324\t                \"slippage_pct\": self.config.get(\"slippage_pct\", 0.01),\n325\t                \"model_provider\": self.config.get(\n326\t                    \"agent_llm_provider\", self.config.get(\"model_provider\", \"openai\")\n327\t                ),\n328\t                \"model_name\": self.config.get(\n329\t                    \"agent_llm_model\", self.config.get(\"model_name\", \"gpt-4o-mini\")\n330\t                ),\n331\t                \"temperature\": self.config.get(\n332\t                    \"agent_llm_temperature\", self.config.get(\"temperature\", 0.1)\n333\t                ),\n334\t                \"use_checkpointing\": self.use_checkpointing,\n335\t                \"universe\": self.config.get(\"universe\", []),\n336\t            },\n337\t            environment=Environment.BACKTEST,\n338\t        )\n339\t        return StrategyAssembler.config_snapshot(resolved)\n340\t\n341\t    def _get_date_range(self) -> List[datetime]:\n342\t        \"\"\"\n343\t        Get list of dates to backtest.\n344\t\n345\t        For hourly/intraday: every N hours\n346\t        For daily: every day\n347\t        \"\"\"\n348\t        dates = []\n349\t        current = self.start_date\n350\t\n351\t        # Determine step size based on timeframe\n352\t        if self.timeframe in [\"1h\", \"4h\"]:\n353\t            step_hours = int(self.timeframe.replace(\"h\", \"\"))\n354\t            step = timedelta(hours=step_hours)\n355\t        elif self.timeframe == \"1d\":\n356\t            step = timedelta(days=1)\n357\t        elif self.timeframe == \"1w\":\n358\t            step = timedelta(weeks=1)\n359\t        else:\n360\t            # Default to hourly\n361\t            step = timedelta(hours=1)\n362\t\n363\t        while current <= self.end_date:\n364\t            dates.append(current)\n365\t            current += step\n366\t\n367\t        return dates\n368\t\n369\t    def _get_date_range_for_asset(self, asset: str) -> List[datetime]:\n370\t        \"\"\"\n371\t        Get date range filtered by market hours for specific asset.\n372\t\n373\t        Args:\n374\t            asset: Asset symbol\n375\t\n376\t        Returns:\n377\t            List of valid trading timestamps for this asset\n378\t        \"\"\"\n379\t        all_dates = self._get_date_range()\n380\t\n381\t        if not self.market_hours_filter or self._market_calendar is None:\n382\t            return all_dates\n383\t\n384\t        asset_type = self._asset_types.get(asset, AssetType.UNKNOWN)\n385\t\n386\t        return self._market_calendar.filter_to_trading_hours(all_dates, asset_type)\n387\t\n388\t    def _analyze_and_trade(self, asset: str, current_date: datetime) -> None:\n389\t        \"\"\"\n390\t        Execute analysis and trade for a single asset at a given time.\n391\t\n392\t        NEW FLOW (Hybrid Model with PositionMonitor):\n393\t        1. Check for active position\n394\t        2. If active: strategy.should_exit() → close or update tracking (NO invoke)\n395\t        3. If not active: strategy.generate_signal() → open position if signal != HOLD\n396\t\n397\t        Args:\n398\t            asset: Asset symbol\n399\t            current_date: Current backtest date\n400\t        \"\"\"\n401\t        # Get historical data for analysis (need lookback period)\n402\t        lookback_days = 30\n403\t        data_start = current_date - timedelta(days=lookback_days)\n404\t\n405\t        df = self.data_provider.get_ohlc(\n406\t            symbol=asset,\n407\t            timeframe=self.timeframe,\n408\t            start_date=data_start,\n409\t            end_date=current_date,\n410\t        )\n411\t\n412\t        if df.empty or len(df) < 30:\n413\t            logger.warning(\n414\t                f\"Insufficient data for {asset} at {current_date} (got {len(df)} records)\",\n415\t                extra={\"event_type\": \"backtest_data_warning\", \"symbol\": asset},\n416\t            )\n417\t            return\n418\t\n419\t        current_price = float(df.iloc[-1][\"close\"])\n420\t\n421\t        # Check for active position\n422\t        active_pos = self.position_monitor.get_active_position(asset)\n423\t\n424\t        # Phase 4: Count total candles processed\n425\t        self.total_candles_processed += 1\n426\t\n427\t        if active_pos:\n428\t            # Position active: check exit conditions via strategy\n429\t            should_exit, reason = self.strategy.should_exit(\n430\t                active_pos, current_price, df\n431\t            )\n432\t\n433\t            if should_exit:\n434\t                # Close position\n435\t                self.position_monitor.close_position(active_pos, reason, current_price)\n436\t\n437\t                # Execute close via OrderManager\n438\t                if active_pos.trade_id:\n439\t                    self.order_manager.close_trade(\n440\t                        active_pos.trade_id,\n441\t                        current_price,\n442\t                        environment=Environment.BACKTEST,\n443\t                    )\n444\t                    logger.info(\n445\t                        f\"{asset}: Closed position - {reason} @ ${current_price:.2f}\"\n446\t                    )\n447\t                # Continue to potentially open new position below\n448\t            else:\n449\t                # Position still active: update tracking only (NO INVOKE)\n450\t                prev_close = (\n451\t                    float(df.iloc[-2][\"close\"]) if len(df) >= 2 else current_price\n452\t                )\n453\t                self.position_monitor.update_candle_tracking(\n454\t                    active_pos, current_price, prev_close\n455\t                )\n456\t                return  # Early return - invocation saved\n457\t\n458\t        # No active position (or just closed): generate signal\n459\t        if isinstance(self.strategy, LLMAgentStrategy):\n460\t            kline_data = format_ohlcv_for_agents(df)\n461\t        else:\n462\t            kline_data = df.to_dict(orient=\"records\")\n463\t\n464\t        # Phase 4: Count agent invocations\n465\t        self.agent_invocations += 1\n466\t\n467\t        # Generate thread_id for checkpointing (if enabled)\n468\t        thread_id = None\n469\t        if self.use_checkpointing:\n470\t            from quantagent.strategy.assembler import StrategyAssembler\n471\t\n472\t            thread_id = StrategyAssembler.make_thread_id(\n473\t                self.backtest_run_id, asset, current_date\n474\t            )\n475\t\n476\t        signal_kwargs = {}\n477\t        if thread_id is not None:\n478\t            signal_kwargs[\"thread_id\"] = thread_id\n479\t\n480\t        signal = self.strategy.generate_signal(\n481\t            kline_data, asset, self.timeframe, current_price, **signal_kwargs\n482\t        )\n483\t\n484\t        if signal is None or signal.decision == \"HOLD\":\n485\t            return\n486\t\n487\t        # Execute trade\n488\t        trading_signal = (\n489\t            TradeSignal.LONG if signal.decision == \"LONG\" else TradeSignal.SHORT\n490\t        )\n491\t\n492\t        # Store signal in database\n493\t        db_signal = self._create_signal_from_strategy(\n494\t            asset=asset,\n495\t            decision=trading_signal,\n496\t            confidence=signal.confidence,\n497\t            reasoning=signal.reasoning,\n498\t            current_date=current_date,\n499\t        )\n500\t\n501\t        # Execute order\n502\t        order = self.order_manager.execute_decision(\n503\t            symbol=asset,\n504\t            decision=trading_signal,\n505\t            confidence=signal.confidence,\n506\t            current_price=current_price,\n507\t            environment=Environment.BACKTEST,\n508\t            trigger_signal_id=db_signal.id if db_signal else None,\n509\t        )\n510\t\n511\t        if order and order.filled_quantity and order.filled_quantity > 0:\n512\t            # Create ActivePosition\n513\t            side = (\n514\t                OrderSide.BUY if trading_signal == TradeSignal.LONG else OrderSide.SELL\n515\t            )\n516\t\n517\t            # Get trade_id from order\n518\t            trade_id = None\n519\t            if order.id:\n520\t                trade = self.db.query(Trade).filter(Trade.order_id == order.id).first()\n521\t                if trade:\n522\t                    trade_id = trade.id\n523\t\n524\t            self.position_monitor.open_position(\n525\t                symbol=asset,\n526\t                side=side,\n527\t                entry_price=signal.entry_price or current_price,\n528\t                stop_loss=signal.stop_loss\n529\t                or (\n530\t                    current_price * 0.98\n531\t                    if side == OrderSide.BUY\n532\t                    else current_price * 1.02\n533\t                ),\n534\t                take_profit=signal.take_profit\n535\t                or (\n536\t                    current_price * 1.03\n537\t                    if side == OrderSide.BUY\n538\t                    else current_price * 0.97\n539\t                ),\n540\t                quantity=order.filled_quantity,\n541\t                exit_policy=signal.exit_policy.value,\n542\t                trade_id=trade_id,\n543\t                signal_id=db_signal.id if db_signal else None,\n544\t                trailing_stop_pct=signal.trailing_stop_pct,\n545\t                max_hold_candles=signal.max_hold_candles,\n546\t            )\n547\t\n548\t            logger.info(\n549\t                f\"Executed {trading_signal.value} for {asset} \"\n550\t                f\"@ \"\n551\t                f\"${current_price:.2f}, qty: {order.filled_quantity}\"\n552\t            )\n553\t\n554\t    def _parse_decision(self, decision: TradingDecision) -> (TradeSignal, float):\n555\t        \"\"\"Parse decision text to extract LONG/SHORT/HOLD and confidence.\"\"\"\n556\t        decision_upper = decision.decision.upper()\n557\t        signal = TradeSignal.NEUTRAL\n558\t\n559\t        if \"LONG\" in decision_upper or \"BUY\" in decision_upper:\n560\t            signal = TradeSignal.LONG\n561\t        elif \"SHORT\" in decision_upper or \"SELL\" in decision_upper:\n562\t            signal = TradeSignal.SHORT\n563\t        else:\n564\t            signal = TradeSignal.NEUTRAL\n565\t\n566\t        ind = float(decision.confidence)\n567\t\n568\t        return signal, ind\n569\t\n570\t    def _create_signal_from_strategy(\n571\t        self,\n572\t        asset: str,\n573\t        decision: TradeSignal,\n574\t        confidence: float,\n575\t        reasoning: str,\n576\t        current_date: datetime,\n577\t    ) -> Optional[Signal]:\n578\t        \"\"\"Create Signal record from strategy output (simplified).\"\"\"\n579\t        try:\n580\t            signal = Signal(\n581\t                symbol=asset,\n582\t                signal=decision,\n583\t                confidence=confidence,\n584\t                timeframe=self.timeframe,\n585\t                analysis_summary=reasoning,\n586\t                generated_at=current_date,\n587\t                environment=Environment.BACKTEST,\n588\t                model_provider=self.config.get(\"agent_llm_provider\", \"openai\"),\n589\t                model_name=self.config.get(\"agent_llm_model\", \"gpt-4o-mini\"),\n590\t                temperature=self.config.get(\"agent_llm_temperature\", 0.1),\n591\t            )\n592\t\n593\t            self.db.add(signal)\n594\t            self.db.commit()\n595\t            return signal\n596\t\n597\t        except Exception as e:\n598\t            logger.error(f\"Error creating signal: {e}\", exc_info=True)\n599\t            return None\n600\t\n601\t    def _create_signal(\n602\t        self,\n603\t        asset: str,\n604\t        decision: TradeSignal,\n605\t        confidence: float,\n606\t        result: Dict,\n607\t        current_date: datetime,\n608\t        thread_id: Optional[str] = None,\n609\t    ) -> Optional[Signal]:\n610\t        \"\"\"Create and persist Signal record.\"\"\"\n611\t        try:\n612\t            # Extract technical indicators\n613\t            rsi = None\n614\t            macd = None\n615\t            stochastic = None\n616\t            roc = None\n617\t            williams_r = None\n618\t            pattern = None\n619\t            trend = None\n620\t\n621\t            if \"rsi\" in result and result[\"rsi\"]:\n622\t                rsi = (\n623\t                    float(result[\"rsi\"][-1])\n624\t                    if isinstance(result[\"rsi\"], list)\n625\t                    else float(result[\"rsi\"])\n626\t                )\n627\t\n628\t            if \"macd\" in result and result[\"macd\"]:\n629\t                macd = (\n630\t                    float(result[\"macd\"][-1])\n631\t                    if isinstance(result[\"macd\"], list)\n632\t                    else float(result[\"macd\"])\n633\t                )\n634\t\n635\t            indicator_report = result.get(\"indicator_report\")\n636\t            if indicator_report and hasattr(indicator_report, \"rsi\"):\n637\t                rsi = float(indicator_report.rsi)\n638\t            if indicator_report and hasattr(indicator_report, \"macd\"):\n639\t                macd = float(indicator_report.macd)\n640\t            if indicator_report and hasattr(indicator_report, \"stochastic\"):\n641\t                stochastic = float(indicator_report.stochastic)\n642\t            if indicator_report and hasattr(indicator_report, \"roc\"):\n643\t                roc = float(indicator_report.roc)\n644\t            if indicator_report and hasattr(indicator_report, \"willr\"):\n645\t                williams_r = float(indicator_report.willr)\n646\t\n647\t            # Get pattern and trend from reports\n648\t            pattern_report = result.get(\"pattern_report\")\n649\t            if pattern_report and hasattr(pattern_report, \"primary_pattern\"):\n650\t                pattern = pattern_report.primary_pattern\n651\t\n652\t            trend_report = result.get(\"trend_report\")\n653\t            if trend_report and hasattr(trend_report, \"trend_direction\"):\n654\t                trend = trend_report.trend_direction\n655\t\n656\t            # Create signal\n657\t            signal = Signal(\n658\t                symbol=asset,\n659\t                signal=decision,\n660\t                confidence=confidence,\n661\t                timeframe=self.timeframe,\n662\t                rsi=rsi,\n663\t                macd=macd,\n664\t                stochastic=stochastic,\n665\t                roc=roc,\n666\t                williams_r=williams_r,\n667\t                pattern=pattern,\n668\t                trend=trend,\n669\t                analysis_summary=result.get(\"reasoning\", \"\"),\n670\t                generated_at=current_date,\n671\t                environment=Environment.BACKTEST,\n672\t                thread_id=thread_id,\n673\t                model_provider=self.config.get(\"agent_llm_provider\", \"openai\"),\n674\t                model_name=self.config.get(\"agent_llm_model\", \"gpt-4o-mini\"),\n675\t                temperature=self.config.get(\"agent_llm_temperature\", 0.1),\n676\t            )\n677\t\n678\t            self.db.add(signal)\n679\t            self.db.commit()\n680\t\n681\t            return signal\n682\t\n683\t        except Exception as e:\n684\t            logger.error(\n685\t                f\"Error creating signal: {e}\",\n686\t                exc_info=True,\n687\t                extra={\"event_type\": \"backtest_error\"},\n688\t            )\n689\t            return None\n690\t\n691\t    def _record_equity(self, current_date: datetime) -> None:\n692\t        \"\"\"Record equity curve data point.\"\"\"\n693\t        total_value = self.portfolio.get_total_value()\n694\t\n695\t        self.equity_curve.append(\n696\t            {\n697\t                \"date\": current_date,\n698\t                \"equity\": total_value,\n699\t                \"cash\": self.portfolio.cash,\n700\t                \"positions_value\": total_value - self.portfolio.cash,\n701\t            }\n702\t        )\n703\t\n704\t    def _calculate_metrics(self) -> BacktestMetrics:\n705\t        \"\"\"\n706\t        Calculate backtest performance metrics.\n707\t\n708\t        Metrics:\n709\t        - Win rate: % of winning trades\n710\t        - Profit factor: sum(wins) / abs(sum(losses))\n711\t        - Sharpe ratio: (return - risk_free) / volatility\n712\t        - Max drawdown: worst peak-to-trough decline\n713\t        - Total P&L: sum of all trade P&L\n714\t        \"\"\"\n715\t        # Get all trades from database for this backtest\n716\t        trades = (\n717\t            self.db.query(Trade)\n718\t            .filter(\n719\t                Trade.environment == Environment.BACKTEST,\n720\t                Trade.opened_at >= self.start_date,\n721\t                Trade.opened_at <= self.end_date,\n722\t            )\n723\t            .all()\n724\t        )\n725\t\n726\t        if not trades:\n727\t            logger.warning(\n728\t                \"No trades executed during backtest\",\n729\t                extra={\"event_type\": \"backtest_warning\"},\n730\t            )\n731\t\n732\t            # Phase 4: Even with no trades, calculate MDA if positions were opened\n733\t            mda, accuracy_by_candle = self._calculate_directional_accuracy()\n734\t            close_reasons = self._calculate_close_reasons()\n735\t\n736\t            invocations_saved = self.total_candles_processed - self.agent_invocations\n737\t            invocation_reduction_pct = (\n738\t                (invocations_saved / self.total_candles_processed * 100)\n739\t                if self.total_candles_processed > 0\n740\t                else 0.0\n741\t            )\n742\t\n743\t            return BacktestMetrics(\n744\t                total_trades=0,\n745\t                winning_trades=0,\n746\t                losing_trades=0,\n747\t                win_rate=0.0,\n748\t                profit_factor=0.0,\n749\t                sharpe_ratio=0.0,\n750\t                max_drawdown=0.0,\n751\t                total_pnl=0.0,\n752\t                avg_win=0.0,\n753\t                avg_loss=0.0,\n754\t                largest_win=0.0,\n755\t                largest_loss=0.0,\n756\t                total_return_pct=0.0,\n757\t                agent_invocations=self.agent_invocations,\n758\t                invocations_saved=invocations_saved,\n759\t                invocation_reduction_pct=invocation_reduction_pct,\n760\t                mean_directional_accuracy=mda,\n761\t                accuracy_by_candle=accuracy_by_candle,\n762\t                close_reasons=close_reasons,\n763\t            )\n764\t\n765\t        # Calculate basic metrics\n766\t        total_trades = len(trades)\n767\t        winning_trades = [t for t in trades if t.pnl and float(t.pnl) > 0]\n768\t        losing_trades = [t for t in trades if t.pnl and float(t.pnl) < 0]\n769\t\n770\t        total_wins = sum(float(t.pnl) for t in winning_trades)\n771\t        total_losses = abs(sum(float(t.pnl) for t in losing_trades))\n772\t\n773\t        # Win rate\n774\t        win_rate = len(winning_trades) / total_trades if total_trades > 0 else 0.0\n775\t\n776\t        # Profit factor\n777\t        profit_factor = (\n778\t            total_wins / total_losses\n779\t            if total_losses > 0\n780\t            else float(\"inf\") if total_wins > 0 else 0.0\n781\t        )\n782\t\n783\t        # Total P&L\n784\t        total_pnl = sum(float(t.pnl) for t in trades if t.pnl)\n785\t\n786\t        # Average win/loss\n787\t        avg_win = total_wins / len(winning_trades) if winning_trades else 0.0\n788\t        avg_loss = total_losses / len(losing_trades) if losing_trades else 0.0\n789\t\n790\t        # Largest win/loss\n791\t        largest_win = max((float(t.pnl) for t in winning_trades), default=0.0)\n792\t        largest_loss = min((float(t.pnl) for t in losing_trades), default=0.0)\n793\t\n794\t        # Total return %\n795\t        total_return_pct = (\n796\t            (total_pnl / self.initial_capital) * 100\n797\t            if self.initial_capital > 0\n798\t            else 0.0\n799\t        )\n800\t\n801\t        # Sharpe ratio\n802\t        sharpe_ratio = self._calculate_sharpe_ratio()\n803\t\n804\t        # Max drawdown\n805\t        max_drawdown = self._calculate_max_drawdown()\n806\t\n807\t        # Phase 4: Calculate MDA and accuracy metrics\n808\t        mda, accuracy_by_candle = self._calculate_directional_accuracy()\n809\t\n810\t        # Phase 4: Calculate close reasons distribution\n811\t        close_reasons = self._calculate_close_reasons()\n812\t\n813\t        # Phase 4: Calculate invocation reduction\n814\t        invocations_saved = self.total_candles_processed - self.agent_invocations\n815\t        invocation_reduction_pct = (\n816\t            (invocations_saved / self.total_candles_processed * 100)\n817\t            if self.total_candles_processed > 0\n818\t            else 0.0\n819\t        )\n820\t\n821\t        return BacktestMetrics(\n822\t            total_trades=total_trades,\n823\t            winning_trades=len(winning_trades),\n824\t            losing_trades=len(losing_trades),\n825\t            win_rate=win_rate,\n826\t            profit_factor=profit_factor,\n827\t            sharpe_ratio=sharpe_ratio,\n828\t            max_drawdown=max_drawdown,\n829\t            total_pnl=total_pnl,\n830\t            avg_win=avg_win,\n831\t            avg_loss=avg_loss,\n832\t            largest_win=largest_win,\n833\t            largest_loss=largest_loss,\n834\t            total_return_pct=total_return_pct,\n835\t            agent_invocations=self.agent_invocations,\n836\t            invocations_saved=invocations_saved,\n837\t            invocation_reduction_pct=invocation_reduction_pct,\n838\t            mean_directional_accuracy=mda,\n839\t            accuracy_by_candle=accuracy_by_candle,\n840\t            close_reasons=close_reasons,\n841\t        )\n842\t\n843\t    def _calculate_sharpe_ratio(self, risk_free_rate: float = 0.02) -> float:\n844\t        \"\"\"\n845\t        Calculate Sharpe ratio.\n846\t\n847\t        Formula: (return - risk_free) / volatility\n848\t\n849\t        Args:\n850\t            risk_free_rate: Annual risk-free rate (default: 2%)\n851\t\n852\t        Returns:\n853\t            Sharpe ratio\n854\t        \"\"\"\n855\t        if len(self.equity_curve) < 2:\n856\t            return 0.0\n857\t\n858\t        # Calculate returns\n859\t        equity_series = pd.Series([e[\"equity\"] for e in self.equity_curve])\n860\t        returns = equity_series.pct_change().dropna()\n861\t\n862\t        if len(returns) == 0 or returns.std() == 0:\n863\t            return 0.0\n864\t\n865\t        # Annualize based on timeframe\n866\t        periods_per_year = self._get_periods_per_year()\n867\t\n868\t        # Calculate Sharpe\n869\t        excess_return = returns.mean() - (risk_free_rate / periods_per_year)\n870\t        sharpe = (excess_return / returns.std()) * np.sqrt(periods_per_year)\n871\t\n872\t        return float(sharpe)\n873\t\n874\t    def _calculate_max_drawdown(self) -> float:\n875\t        \"\"\"\n876\t        Calculate maximum drawdown.\n877\t\n878\t        Formula: max((peak - trough) / peak)\n879\t\n880\t        Returns:\n881\t            Max drawdown as decimal (e.g., 0.15 = 15%)\n882\t        \"\"\"\n883\t        if len(self.equity_curve) < 2:\n884\t            return 0.0\n885\t\n886\t        equity_series = pd.Series([e[\"equity\"] for e in self.equity_curve])\n887\t\n888\t        # Calculate running maximum\n889\t        running_max = equity_series.expanding().max()\n890\t\n891\t        # Calculate drawdown\n892\t        drawdown = (equity_series - running_max) / running_max\n893\t\n894\t        # Maximum drawdown (most negative)\n895\t        max_dd = abs(drawdown.min())\n896\t\n897\t        return float(max_dd)\n898\t\n899\t    def _calculate_directional_accuracy(self) -> tuple[float, Dict[int, float]]:\n900\t        \"\"\"\n901\t        Calculate Mean Directional Accuracy (MDA) and per-candle accuracy.\n902\t\n903\t        MDA = (correct_candles / total_candles_evaluated)\n904\t\n905\t        Returns:\n906\t            Tuple of (mean_directional_accuracy, accuracy_by_candle)\n907\t        \"\"\"\n908\t        query = self.db.query(ActivePosition).filter(\n909\t            ActivePosition.is_active.is_(False),\n910\t            ActivePosition.decision_timestamp >= self.start_date,\n911\t            ActivePosition.decision_timestamp <= self.end_date,\n912\t        )\n913\t\n914\t        if self.backtest_run_id is not None:\n915\t            query = query.filter(ActivePosition.backtest_run_id == self.backtest_run_id)\n916\t\n917\t        positions = query.all()\n918\t\n919\t        if not positions:\n920\t            return 0.0, {}\n921\t\n922\t        # Track correct predictions per candle index\n923\t        correct_by_candle = {}\n924\t        total_by_candle = {}\n925\t\n926\t        for pos in positions:\n927\t            expected_direction = \"up\" if pos.side == OrderSide.BUY else \"down\"\n928\t\n929\t            # Evaluate up to prediction_horizon candles\n930\t            for i, direction in enumerate(\n931\t                pos.candles_direction[: pos.prediction_horizon]\n932\t            ):\n933\t                candle_idx = i + 1  # 1-indexed (candle 1, 2, 3...)\n934\t\n935\t                if candle_idx not in correct_by_candle:\n936\t                    correct_by_candle[candle_idx] = 0\n937\t                    total_by_candle[candle_idx] = 0\n938\t\n939\t                total_by_candle[candle_idx] += 1\n940\t                if direction == expected_direction:\n941\t                    correct_by_candle[candle_idx] += 1\n942\t\n943\t        # Calculate accuracy per candle\n944\t        accuracy_by_candle = {\n945\t            candle: correct_by_candle[candle] / total_by_candle[candle]\n946\t            for candle in sorted(total_by_candle.keys())\n947\t        }\n948\t\n949\t        # Calculate overall MDA\n950\t        total_correct = sum(correct_by_candle.values())\n951\t        total_candles = sum(total_by_candle.values())\n952\t        mda = total_correct / total_candles if total_candles > 0 else 0.0\n953\t\n954\t        return mda, accuracy_by_candle\n955\t\n956\t    def _calculate_close_reasons(self) -> Dict[str, int]:\n957\t        \"\"\"\n958\t        Calculate distribution of position close reasons.\n959\t\n960\t        Returns:\n961\t            Dict mapping close_reason to count\n962\t        \"\"\"\n963\t        query = self.db.query(ActivePosition).filter(\n964\t            ActivePosition.is_active.is_(False),\n965\t            ActivePosition.decision_timestamp >= self.start_date,\n966\t            ActivePosition.decision_timestamp <= self.end_date,\n967\t        )\n968\t\n969\t        if self.backtest_run_id is not None:\n970\t            query = query.filter(ActivePosition.backtest_run_id == self.backtest_run_id)\n971\t\n972\t        positions = query.all()\n973\t\n974\t        close_reasons = {}\n975\t        for pos in positions:\n976\t            reason = pos.close_reason or \"unknown\"\n977\t            close_reasons[reason] = close_reasons.get(reason, 0) + 1\n978\t\n979\t        return close_reasons\n980\t\n981\t    def _get_periods_per_year(self) -> int:\n982\t        \"\"\"Get number of periods per year based on timeframe.\"\"\"\n983\t        if self.timeframe == \"1h\":\n984\t            return 252 * 6.5  # Trading days * hours per day\n985\t        elif self.timeframe == \"4h\":\n986\t            return 252 * 1.625  # Approx 1.6 periods per day\n987\t        elif self.timeframe == \"1d\":\n988\t            return 252\n989\t        elif self.timeframe == \"1w\":\n990\t            return 52\n991\t        else:\n992\t            return 252\n993\t\n994\t    def _update_backtest_run(self, metrics: BacktestMetrics) -> None:\n995\t        \"\"\"Update BacktestRun record with final metrics.\"\"\"\n996\t        if not self.backtest_run_id:\n997\t            return\n998\t\n999\t        run = (\n1000\t            self.db.query(BacktestRun)\n1001\t            .filter(BacktestRun.id == self.backtest_run_id)\n1002\t            .first()\n1003\t        )\n1004\t\n1005\t        if run:\n1006\t            run.total_trades = metrics.total_trades\n1007\t            run.win_rate = metrics.win_rate\n1008\t            run.profit_factor = metrics.profit_factor\n1009\t            run.sharpe_ratio = metrics.sharpe_ratio\n1010\t            run.max_drawdown = metrics.max_drawdown\n1011\t            run.total_pnl = Decimal(str(metrics.total_pnl))\n1012\t\n1013\t            self.db.commit()\n1014\t            logger.info(\n1015\t                f\"Updated backtest run #{self.backtest_run_id} with final metrics\",\n1016\t                extra={\"event_type\": \"backtest_complete\"},\n1017\t            )\n1018\t\n1019\t    def get_equity_curve(self) -> pd.DataFrame:\n1020\t        \"\"\"\n1021\t        Get equity curve as DataFrame.\n1022\t\n1023\t        Returns:\n1024\t            DataFrame with columns: date, equity, cash, positions_value\n1025\t        \"\"\"\n1026\t        return pd.DataFrame(self.equity_curve)\n1027\t\n1028\t    def __del__(self):\n1029\t        \"\"\"Cleanup database session if we own it.\"\"\"\n1030\t        if self._own_session and self.db:\n1031\t            self.db.close()\n1032\t"}]},"parent_tool_use_id":null,"session_id":"d5f29735-d3ee-49a9-b09d-cef53776ca0b","uuid":"0f138084-758e-4e2a-8ce5-be3bdb1ec557","timestamp":"2026-05-06T07:40:43.517Z","tool_use_result":{"type":"text","file":{"filePath":"/home/azureuser/repos/projects/QuantAgent/quantagent/backtesting/backtest.py","content":"\"\"\"Backtesting engine for strategy validation.\"\"\"\n\nimport logging\nfrom dataclasses import dataclass\nfrom datetime import datetime, timedelta\nfrom decimal import Decimal\nfrom typing import Dict, List, Optional\n\nimport numpy as np\nimport pandas as pd\nfrom sqlalchemy.orm import Session\n\nfrom quantagent.agent_models import TradingDecision\nfrom quantagent.data.asset_types import AssetType, get_asset_type\nfrom quantagent.data.market_calendar import get_market_calendar\nfrom quantagent.data.provider import DataProvider\nfrom quantagent.database import SessionLocal\nfrom quantagent.models import (\n    ActivePosition,\n    BacktestRun,\n    Environment,\n    OrderSide,\n    Signal,\n    Trade,\n    TradeSignal,\n)\nfrom quantagent.static_util import format_ohlcv_for_agents\nfrom quantagent.strategy.assembler import StrategyAssembler\nfrom quantagent.strategy.base import TradingStrategy\nfrom quantagent.strategy.llm_agent_strategy import LLMAgentStrategy\nfrom quantagent.trading.position_monitor import PositionMonitor\n\nlogger = logging.getLogger(__name__)\n\n\n@dataclass\nclass BacktestMetrics:\n    \"\"\"Backtest performance metrics.\"\"\"\n\n    total_trades: int\n    winning_trades: int\n    losing_trades: int\n    win_rate: float\n    profit_factor: float\n    sharpe_ratio: float\n    max_drawdown: float\n    total_pnl: float\n    avg_win: float\n    avg_loss: float\n    largest_win: float\n    largest_loss: float\n    total_return_pct: float\n\n    # Phase 4: Active Position Monitoring metrics\n    agent_invocations: int = 0\n    invocations_saved: int = 0\n    invocation_reduction_pct: float = 0.0\n    mean_directional_accuracy: float = 0.0\n    accuracy_by_candle: Dict[int, float] = None\n    close_reasons: Dict[str, int] = None\n\n    def __post_init__(self):\n        if self.accuracy_by_candle is None:\n            self.accuracy_by_candle = {}\n        if self.close_reasons is None:\n            self.close_reasons = {}\n\n\nclass Backtest:\n    \"\"\"\n    Backtesting engine for validating trading strategies.\n\n    Workflow:\n    1. Loop through historical dates\n    2. Fetch OHLC data for each date using DataProvider (cached)\n    3. Execute analysis using TradingGraph\n    4. Simulate trade execution using OrderManager\n    5. Track portfolio performance\n    6. Calculate and persist metrics\n\n    Features:\n    - Uses DataProvider for 10x faster data access (caching)\n    - Executes same agents as live trading\n    - Stores full provenance (config snapshot, model metadata)\n    - Supports replay with different risk/portfolio profiles\n    \"\"\"\n\n    def __init__(\n        self,\n        start_date: datetime,\n        end_date: datetime,\n        assets: List[str],\n        timeframe: str = \"1h\",\n        initial_capital: float = 100000.0,\n        config: Optional[Dict] = None,\n        db_session: Optional[Session] = None,\n        use_checkpointing: bool = False,\n        strategy: Optional[TradingStrategy] = None,\n    ):\n        \"\"\"\n        Initialize Backtest.\n\n        Args:\n            start_date: Start date for backtest\n            end_date: End date for backtest\n            assets: List of asset symbols (e.g., [\"BTC\", \"SPX\", \"CL\"])\n            timeframe: Timeframe for analysis (e.g., \"1h\", \"4h\", \"1d\")\n            initial_capital: Starting portfolio value\n            config: Configuration dict (portfolio/risk params, model settings)\n            db_session: Database session (creates new if None)\n            use_checkpointing: Enable LangGraph checkpointing for state persistence\n            strategy: Optional TradingStrategy. If None, uses LLMAgentStrategy with TradingGraph\n        \"\"\"\n        self.start_date = start_date\n        self.end_date = end_date\n        self.assets = assets\n        self.timeframe = timeframe\n        self.initial_capital = initial_capital\n        self.config = config or {}\n        self.use_checkpointing = use_checkpointing\n\n        # Database\n        self.db = db_session or SessionLocal()\n        self._own_session = db_session is None\n\n        # Data provider (caching layer)\n        self.data_provider = DataProvider(self.db)\n\n        # Resolve config via StrategyAssembler and build components (unify DB session)\n        resolved = StrategyAssembler.from_snapshot(\n            {\n                \"initial_cash\": initial_capital,\n                \"base_position_pct\": self.config.get(\"base_position_pct\", 0.05),\n                \"max_daily_loss_pct\": self.config.get(\"max_daily_loss_pct\", 0.05),\n                \"max_position_pct\": self.config.get(\"max_position_pct\", 0.10),\n                \"slippage_pct\": self.config.get(\"slippage_pct\", 0.01),\n                # Normalize model fields into generic ones; accept both\n                \"model_provider\": self.config.get(\n                    \"agent_llm_provider\", self.config.get(\"model_provider\", \"openai\")\n                ),\n                \"model_name\": self.config.get(\n                    \"agent_llm_model\", self.config.get(\"model_name\", \"gpt-4o-mini\")\n                ),\n                \"temperature\": self.config.get(\n                    \"agent_llm_temperature\", self.config.get(\"temperature\", 0.1)\n                ),\n                \"use_checkpointing\": use_checkpointing,\n                \"universe\": self.config.get(\"universe\", []),\n            },\n            environment=Environment.BACKTEST,\n        )\n        components = StrategyAssembler.build_components(resolved, db_session=self.db)\n\n        # Trading graph (analysis engine)\n        self.trading_graph = components.graph\n\n        # Trading strategy (use provided or default to LLMAgentStrategy)\n        self.strategy = strategy or LLMAgentStrategy(self.trading_graph)\n\n        # Position monitor for active position tracking\n        self.position_monitor = PositionMonitor(self.db)\n\n        # Trading components\n        self.portfolio = components.portfolio_manager\n        self.position_sizer = components.position_sizer\n        self.risk_manager = components.risk_manager\n        self.broker = components.broker\n        self.order_manager = components.order_manager\n\n        # Backtest state\n        self.current_date = start_date\n        self.backtest_run_id: Optional[int] = None\n        self.trades: List[Trade] = []\n        self.equity_curve: List[Dict] = []\n\n        # Phase 4: Invocation tracking\n        self.agent_invocations = 0\n        self.total_candles_processed = 0\n\n        # Market hours filtering\n        self.market_hours_filter = self.config.get(\"market_hours_filter\", True)\n        self._market_calendar = (\n            get_market_calendar() if self.market_hours_filter else None\n        )\n\n        # Cache asset types for each symbol\n        self._asset_types: Dict[str, AssetType] = {\n            asset: get_asset_type(asset) for asset in assets\n        }\n\n    def run(self, name: Optional[str] = None) -> BacktestMetrics:\n        \"\"\"\n        Run backtest and return metrics.\n\n        Args:\n            name: Optional name for this backtest run\n\n        Returns:\n            BacktestMetrics with performance statistics\n        \"\"\"\n        logger.info(\n            f\"Starting backtest: {self.start_date} to {self.end_date}\",\n            extra={\"event_type\": \"backtest_start\", \"environment\": \"backtest\"},\n        )\n        logger.info(\n            f\"Assets: {self.assets}, Timeframe: {self.timeframe}\",\n            extra={\"event_type\": \"backtest_start\"},\n        )\n        logger.info(\n            f\"Initial capital: ${self.initial_capital:,.2f}\",\n            extra={\"event_type\": \"backtest_start\"},\n        )\n        logger.info(\n            f\"Market hours filter: {self.market_hours_filter}\",\n            extra={\"event_type\": \"backtest_start\"},\n        )\n\n        # Create backtest run record\n        self._create_backtest_run(name)\n\n        # Process each asset with its filtered date range\n        total_periods = 0\n        for asset in self.assets:\n            asset_dates = self._get_date_range_for_asset(asset)\n            total_periods += len(asset_dates)\n\n            asset_type = self._asset_types.get(asset, AssetType.UNKNOWN)\n            logger.info(\n                f\"Asset {asset} ({asset_type.value}): {len(asset_dates)} analysis periods\",\n                extra={\"event_type\": \"backtest_start\"},\n            )\n\n        logger.info(\n            f\"Backtesting {total_periods} total analysis periods\",\n            extra={\"event_type\": \"backtest_start\"},\n        )\n\n        # Track progress across all periods\n        periods_completed = 0\n\n        # Loop through assets (outer) and their dates (inner)\n        for asset in self.assets:\n            asset_dates = self._get_date_range_for_asset(asset)\n\n            for i, current_date in enumerate(asset_dates):\n                self.current_date = current_date\n\n                # Reset daily P&L tracking at start of each day\n                if i == 0 or current_date.date() != asset_dates[i - 1].date():\n                    self.risk_manager.reset_daily_tracker()\n\n                try:\n                    self._analyze_and_trade(asset, current_date)\n                except Exception as e:\n                    logger.error(\n                        f\"Error analyzing {asset} at {current_date}: {e}\",\n                        exc_info=True,\n                        extra={\"event_type\": \"backtest_error\", \"symbol\": asset},\n                    )\n                    continue\n\n                # Record equity at end of period\n                self._record_equity(current_date)\n\n                periods_completed += 1\n\n                # Log progress\n                if periods_completed % 100 == 0 or periods_completed == total_periods:\n                    progress = (periods_completed / total_periods) * 100\n                    logger.info(\n                        f\"Progress: {progress:.1f}% ({periods_completed}/{total_periods})\",\n                        extra={\"event_type\": \"backtest_progress\"},\n                    )\n\n        # Calculate metrics\n        metrics = self._calculate_metrics()\n\n        # Update backtest run with results\n        self._update_backtest_run(metrics)\n\n        logger.info(\n            f\"Backtest complete: {metrics.total_trades} trades, Win rate: {metrics.win_rate:.2%}\",\n            extra={\"event_type\": \"backtest_end\", \"environment\": \"backtest\"},\n        )\n        logger.info(\n            f\"Total P&L: ${metrics.total_pnl:,.2f} ({metrics.total_return_pct:.2%})\",\n            extra={\"event_type\": \"backtest_end\"},\n        )\n\n        return metrics\n\n    def _create_backtest_run(self, name: Optional[str]) -> None:\n        \"\"\"Create BacktestRun record in database.\"\"\"\n        run = BacktestRun(\n            name=name or f\"Backtest_{datetime.now().strftime('%Y%m%d_%H%M%S')}\",\n            timeframe=self.timeframe,\n            assets=self.assets,\n            start_date=self.start_date,\n            end_date=self.end_date,\n            config_snapshot=self._build_config_snapshot(),\n        )\n\n        self.db.add(run)\n        self.db.commit()\n        self.backtest_run_id = run.id\n\n        if self.position_monitor is not None:\n            self.position_monitor.set_backtest_run_id(self.backtest_run_id)\n\n        logger.info(\n            f\"Created backtest run #{self.backtest_run_id}: {run.name}\",\n            extra={\"event_type\": \"backtest_init\"},\n        )\n\n    def _build_config_snapshot(self) -> Dict:\n        \"\"\"Build immutable config snapshot for reproducibility.\"\"\"\n        # Re-generate snapshot via assembler to keep alignment\n        resolved = StrategyAssembler.from_snapshot(\n            {\n                \"initial_cash\": self.initial_capital,\n                \"base_position_pct\": self.config.get(\"base_position_pct\", 0.05),\n                \"max_daily_loss_pct\": self.config.get(\"max_daily_loss_pct\", 0.05),\n                \"max_position_pct\": self.config.get(\"max_position_pct\", 0.10),\n                \"slippage_pct\": self.config.get(\"slippage_pct\", 0.01),\n                \"model_provider\": self.config.get(\n                    \"agent_llm_provider\", self.config.get(\"model_provider\", \"openai\")\n                ),\n                \"model_name\": self.config.get(\n                    \"agent_llm_model\", self.config.get(\"model_name\", \"gpt-4o-mini\")\n                ),\n                \"temperature\": self.config.get(\n                    \"agent_llm_temperature\", self.config.get(\"temperature\", 0.1)\n                ),\n                \"use_checkpointing\": self.use_checkpointing,\n                \"universe\": self.config.get(\"universe\", []),\n            },\n            environment=Environment.BACKTEST,\n        )\n        return StrategyAssembler.config_snapshot(resolved)\n\n    def _get_date_range(self) -> List[datetime]:\n        \"\"\"\n        Get list of dates to backtest.\n\n        For hourly/intraday: every N hours\n        For daily: every day\n        \"\"\"\n        dates = []\n        current = self.start_date\n\n        # Determine step size based on timeframe\n        if self.timeframe in [\"1h\", \"4h\"]:\n            step_hours = int(self.timeframe.replace(\"h\", \"\"))\n            step = timedelta(hours=step_hours)\n        elif self.timeframe == \"1d\":\n            step = timedelta(days=1)\n        elif self.timeframe == \"1w\":\n            step = timedelta(weeks=1)\n        else:\n            # Default to hourly\n            step = timedelta(hours=1)\n\n        while current <= self.end_date:\n            dates.append(current)\n            current += step\n\n        return dates\n\n    def _get_date_range_for_asset(self, asset: str) -> List[datetime]:\n        \"\"\"\n        Get date range filtered by market hours for specific asset.\n\n        Args:\n            asset: Asset symbol\n\n        Returns:\n            List of valid trading timestamps for this asset\n        \"\"\"\n        all_dates = self._get_date_range()\n\n        if not self.market_hours_filter or self._market_calendar is None:\n            return all_dates\n\n        asset_type = self._asset_types.get(asset, AssetType.UNKNOWN)\n\n        return self._market_calendar.filter_to_trading_hours(all_dates, asset_type)\n\n    def _analyze_and_trade(self, asset: str, current_date: datetime) -> None:\n        \"\"\"\n        Execute analysis and trade for a single asset at a given time.\n\n        NEW FLOW (Hybrid Model with PositionMonitor):\n        1. Check for active position\n        2. If active: strategy.should_exit() → close or update tracking (NO invoke)\n        3. If not active: strategy.generate_signal() → open position if signal != HOLD\n\n        Args:\n            asset: Asset symbol\n            current_date: Current backtest date\n        \"\"\"\n        # Get historical data for analysis (need lookback period)\n        lookback_days = 30\n        data_start = current_date - timedelta(days=lookback_days)\n\n        df = self.data_provider.get_ohlc(\n            symbol=asset,\n            timeframe=self.timeframe,\n            start_date=data_start,\n            end_date=current_date,\n        )\n\n        if df.empty or len(df) < 30:\n            logger.warning(\n                f\"Insufficient data for {asset} at {current_date} (got {len(df)} records)\",\n                extra={\"event_type\": \"backtest_data_warning\", \"symbol\": asset},\n            )\n            return\n\n        current_price = float(df.iloc[-1][\"close\"])\n\n        # Check for active position\n        active_pos = self.position_monitor.get_active_position(asset)\n\n        # Phase 4: Count total candles processed\n        self.total_candles_processed += 1\n\n        if active_pos:\n            # Position active: check exit conditions via strategy\n            should_exit, reason = self.strategy.should_exit(\n                active_pos, current_price, df\n            )\n\n            if should_exit:\n                # Close position\n                self.position_monitor.close_position(active_pos, reason, current_price)\n\n                # Execute close via OrderManager\n                if active_pos.trade_id:\n                    self.order_manager.close_trade(\n                        active_pos.trade_id,\n                        current_price,\n                        environment=Environment.BACKTEST,\n                    )\n                    logger.info(\n                        f\"{asset}: Closed position - {reason} @ ${current_price:.2f}\"\n                    )\n                # Continue to potentially open new position below\n            else:\n                # Position still active: update tracking only (NO INVOKE)\n                prev_close = (\n                    float(df.iloc[-2][\"close\"]) if len(df) >= 2 else current_price\n                )\n                self.position_monitor.update_candle_tracking(\n                    active_pos, current_price, prev_close\n                )\n                return  # Early return - invocation saved\n\n        # No active position (or just closed): generate signal\n        if isinstance(self.strategy, LLMAgentStrategy):\n            kline_data = format_ohlcv_for_agents(df)\n        else:\n            kline_data = df.to_dict(orient=\"records\")\n\n        # Phase 4: Count agent invocations\n        self.agent_invocations += 1\n\n        # Generate thread_id for checkpointing (if enabled)\n        thread_id = None\n        if self.use_checkpointing:\n            from quantagent.strategy.assembler import StrategyAssembler\n\n            thread_id = StrategyAssembler.make_thread_id(\n                self.backtest_run_id, asset, current_date\n            )\n\n        signal_kwargs = {}\n        if thread_id is not None:\n            signal_kwargs[\"thread_id\"] = thread_id\n\n        signal = self.strategy.generate_signal(\n            kline_data, asset, self.timeframe, current_price, **signal_kwargs\n        )\n\n        if signal is None or signal.decision == \"HOLD\":\n            return\n\n        # Execute trade\n        trading_signal = (\n            TradeSignal.LONG if signal.decision == \"LONG\" else TradeSignal.SHORT\n        )\n\n        # Store signal in database\n        db_signal = self._create_signal_from_strategy(\n            asset=asset,\n            decision=trading_signal,\n            confidence=signal.confidence,\n            reasoning=signal.reasoning,\n            current_date=current_date,\n        )\n\n        # Execute order\n        order = self.order_manager.execute_decision(\n            symbol=asset,\n            decision=trading_signal,\n            confidence=signal.confidence,\n            current_price=current_price,\n            environment=Environment.BACKTEST,\n            trigger_signal_id=db_signal.id if db_signal else None,\n        )\n\n        if order and order.filled_quantity and order.filled_quantity > 0:\n            # Create ActivePosition\n            side = (\n                OrderSide.BUY if trading_signal == TradeSignal.LONG else OrderSide.SELL\n            )\n\n            # Get trade_id from order\n            trade_id = None\n            if order.id:\n                trade = self.db.query(Trade).filter(Trade.order_id == order.id).first()\n                if trade:\n                    trade_id = trade.id\n\n            self.position_monitor.open_position(\n                symbol=asset,\n                side=side,\n                entry_price=signal.entry_price or current_price,\n                stop_loss=signal.stop_loss\n                or (\n                    current_price * 0.98\n                    if side == OrderSide.BUY\n                    else current_price * 1.02\n                ),\n                take_profit=signal.take_profit\n                or (\n                    current_price * 1.03\n                    if side == OrderSide.BUY\n                    else current_price * 0.97\n                ),\n                quantity=order.filled_quantity,\n                exit_policy=signal.exit_policy.value,\n                trade_id=trade_id,\n                signal_id=db_signal.id if db_signal else None,\n                trailing_stop_pct=signal.trailing_stop_pct,\n                max_hold_candles=signal.max_hold_candles,\n            )\n\n            logger.info(\n                f\"Executed {trading_signal.value} for {asset} \"\n                f\"@ \"\n                f\"${current_price:.2f}, qty: {order.filled_quantity}\"\n            )\n\n    def _parse_decision(self, decision: TradingDecision) -> (TradeSignal, float):\n        \"\"\"Parse decision text to extract LONG/SHORT/HOLD and confidence.\"\"\"\n        decision_upper = decision.decision.upper()\n        signal = TradeSignal.NEUTRAL\n\n        if \"LONG\" in decision_upper or \"BUY\" in decision_upper:\n            signal = TradeSignal.LONG\n        elif \"SHORT\" in decision_upper or \"SELL\" in decision_upper:\n            signal = TradeSignal.SHORT\n        else:\n            signal = TradeSignal.NEUTRAL\n\n        ind = float(decision.confidence)\n\n        return signal, ind\n\n    def _create_signal_from_strategy(\n        self,\n        asset: str,\n        decision: TradeSignal,\n        confidence: float,\n        reasoning: str,\n        current_date: datetime,\n    ) -> Optional[Signal]:\n        \"\"\"Create Signal record from strategy output (simplified).\"\"\"\n        try:\n            signal = Signal(\n                symbol=asset,\n                signal=decision,\n                confidence=confidence,\n                timeframe=self.timeframe,\n                analysis_summary=reasoning,\n                generated_at=current_date,\n                environment=Environment.BACKTEST,\n                model_provider=self.config.get(\"agent_llm_provider\", \"openai\"),\n                model_name=self.config.get(\"agent_llm_model\", \"gpt-4o-mini\"),\n                temperature=self.config.get(\"agent_llm_temperature\", 0.1),\n            )\n\n            self.db.add(signal)\n            self.db.commit()\n            return signal\n\n        except Exception as e:\n            logger.error(f\"Error creating signal: {e}\", exc_info=True)\n            return None\n\n    def _create_signal(\n        self,\n        asset: str,\n        decision: TradeSignal,\n        confidence: float,\n        result: Dict,\n        current_date: datetime,\n        thread_id: Optional[str] = None,\n    ) -> Optional[Signal]:\n        \"\"\"Create and persist Signal record.\"\"\"\n        try:\n            # Extract technical indicators\n            rsi = None\n            macd = None\n            stochastic = None\n            roc = None\n            williams_r = None\n            pattern = None\n            trend = None\n\n            if \"rsi\" in result and result[\"rsi\"]:\n                rsi = (\n                    float(result[\"rsi\"][-1])\n                    if isinstance(result[\"rsi\"], list)\n                    else float(result[\"rsi\"])\n                )\n\n            if \"macd\" in result and result[\"macd\"]:\n                macd = (\n                    float(result[\"macd\"][-1])\n                    if isinstance(result[\"macd\"], list)\n                    else float(result[\"macd\"])\n                )\n\n            indicator_report = result.get(\"indicator_report\")\n            if indicator_report and hasattr(indicator_report, \"rsi\"):\n                rsi = float(indicator_report.rsi)\n            if indicator_report and hasattr(indicator_report, \"macd\"):\n                macd = float(indicator_report.macd)\n            if indicator_report and hasattr(indicator_report, \"stochastic\"):\n                stochastic = float(indicator_report.stochastic)\n            if indicator_report and hasattr(indicator_report, \"roc\"):\n                roc = float(indicator_report.roc)\n            if indicator_report and hasattr(indicator_report, \"willr\"):\n                williams_r = float(indicator_report.willr)\n\n            # Get pattern and trend from reports\n            pattern_report = result.get(\"pattern_report\")\n            if pattern_report and hasattr(pattern_report, \"primary_pattern\"):\n                pattern = pattern_report.primary_pattern\n\n            trend_report = result.get(\"trend_report\")\n            if trend_report and hasattr(trend_report, \"trend_direction\"):\n                trend = trend_report.trend_direction\n\n            # Create signal\n            signal = Signal(\n                symbol=asset,\n                signal=decision,\n                confidence=confidence,\n                timeframe=self.timeframe,\n                rsi=rsi,\n                macd=macd,\n                stochastic=stochastic,\n                roc=roc,\n                williams_r=williams_r,\n                pattern=pattern,\n                trend=trend,\n                analysis_summary=result.get(\"reasoning\", \"\"),\n                generated_at=current_date,\n                environment=Environment.BACKTEST,\n                thread_id=thread_id,\n                model_provider=self.config.get(\"agent_llm_provider\", \"openai\"),\n                model_name=self.config.get(\"agent_llm_model\", \"gpt-4o-mini\"),\n                temperature=self.config.get(\"agent_llm_temperature\", 0.1),\n            )\n\n            self.db.add(signal)\n            self.db.commit()\n\n            return signal\n\n        except Exception as e:\n            logger.error(\n                f\"Error creating signal: {e}\",\n                exc_info=True,\n                extra={\"event_type\": \"backtest_error\"},\n            )\n            return None\n\n    def _record_equity(self, current_date: datetime) -> None:\n        \"\"\"Record equity curve data point.\"\"\"\n        total_value = self.portfolio.get_total_value()\n\n        self.equity_curve.append(\n            {\n                \"date\": current_date,\n                \"equity\": total_value,\n                \"cash\": self.portfolio.cash,\n                \"positions_value\": total_value - self.portfolio.cash,\n            }\n        )\n\n    def _calculate_metrics(self) -> BacktestMetrics:\n        \"\"\"\n        Calculate backtest performance metrics.\n\n        Metrics:\n        - Win rate: % of winning trades\n        - Profit factor: sum(wins) / abs(sum(losses))\n        - Sharpe ratio: (return - risk_free) / volatility\n        - Max drawdown: worst peak-to-trough decline\n        - Total P&L: sum of all trade P&L\n        \"\"\"\n        # Get all trades from database for this backtest\n        trades = (\n            self.db.query(Trade)\n            .filter(\n                Trade.environment == Environment.BACKTEST,\n                Trade.opened_at >= self.start_date,\n                Trade.opened_at <= self.end_date,\n            )\n            .all()\n        )\n\n        if not trades:\n            logger.warning(\n                \"No trades executed during backtest\",\n                extra={\"event_type\": \"backtest_warning\"},\n            )\n\n            # Phase 4: Even with no trades, calculate MDA if positions were opened\n            mda, accuracy_by_candle = self._calculate_directional_accuracy()\n            close_reasons = self._calculate_close_reasons()\n\n            invocations_saved = self.total_candles_processed - self.agent_invocations\n            invocation_reduction_pct = (\n                (invocations_saved / self.total_candles_processed * 100)\n                if self.total_candles_processed > 0\n                else 0.0\n            )\n\n            return BacktestMetrics(\n                total_trades=0,\n                winning_trades=0,\n                losing_trades=0,\n                win_rate=0.0,\n                profit_factor=0.0,\n                sharpe_ratio=0.0,\n                max_drawdown=0.0,\n                total_pnl=0.0,\n                avg_win=0.0,\n                avg_loss=0.0,\n                largest_win=0.0,\n                largest_loss=0.0,\n                total_return_pct=0.0,\n                agent_invocations=self.agent_invocations,\n                invocations_saved=invocations_saved,\n                invocation_reduction_pct=invocation_reduction_pct,\n                mean_directional_accuracy=mda,\n                accuracy_by_candle=accuracy_by_candle,\n                close_reasons=close_reasons,\n            )\n\n        # Calculate basic metrics\n        total_trades = len(trades)\n        winning_trades = [t for t in trades if t.pnl and float(t.pnl) > 0]\n        losing_trades = [t for t in trades if t.pnl and float(t.pnl) < 0]\n\n        total_wins = sum(float(t.pnl) for t in winning_trades)\n        total_losses = abs(sum(float(t.pnl) for t in losing_trades))\n\n        # Win rate\n        win_rate = len(winning_trades) / total_trades if total_trades > 0 else 0.0\n\n        # Profit factor\n        profit_factor = (\n            total_wins / total_losses\n            if total_losses > 0\n            else float(\"inf\") if total_wins > 0 else 0.0\n        )\n\n        # Total P&L\n        total_pnl = sum(float(t.pnl) for t in trades if t.pnl)\n\n        # Average win/loss\n        avg_win = total_wins / len(winning_trades) if winning_trades else 0.0\n        avg_loss = total_losses / len(losing_trades) if losing_trades else 0.0\n\n        # Largest win/loss\n        largest_win = max((float(t.pnl) for t in winning_trades), default=0.0)\n        largest_loss = min((float(t.pnl) for t in losing_trades), default=0.0)\n\n        # Total return %\n        total_return_pct = (\n            (total_pnl / self.initial_capital) * 100\n            if self.initial_capital > 0\n            else 0.0\n        )\n\n        # Sharpe ratio\n        sharpe_ratio = self._calculate_sharpe_ratio()\n\n        # Max drawdown\n        max_drawdown = self._calculate_max_drawdown()\n\n        # Phase 4: Calculate MDA and accuracy metrics\n        mda, accuracy_by_candle = self._calculate_directional_accuracy()\n\n        # Phase 4: Calculate close reasons distribution\n        close_reasons = self._calculate_close_reasons()\n\n        # Phase 4: Calculate invocation reduction\n        invocations_saved = self.total_candles_processed - self.agent_invocations\n        invocation_reduction_pct = (\n            (invocations_saved / self.total_candles_processed * 100)\n            if self.total_candles_processed > 0\n            else 0.0\n        )\n\n        return BacktestMetrics(\n            total_trades=total_trades,\n            winning_trades=len(winning_trades),\n            losing_trades=len(losing_trades),\n            win_rate=win_rate,\n            profit_factor=profit_factor,\n            sharpe_ratio=sharpe_ratio,\n            max_drawdown=max_drawdown,\n            total_pnl=total_pnl,\n            avg_win=avg_win,\n            avg_loss=avg_loss,\n            largest_win=largest_win,\n            largest_loss=largest_loss,\n            total_return_pct=total_return_pct,\n            agent_invocations=self.agent_invocations,\n            invocations_saved=invocations_saved,\n            invocation_reduction_pct=invocation_reduction_pct,\n            mean_directional_accuracy=mda,\n            accuracy_by_candle=accuracy_by_candle,\n            close_reasons=close_reasons,\n        )\n\n    def _calculate_sharpe_ratio(self, risk_free_rate: float = 0.02) -> float:\n        \"\"\"\n        Calculate Sharpe ratio.\n\n        Formula: (return - risk_free) / volatility\n\n        Args:\n            risk_free_rate: Annual risk-free rate (default: 2%)\n\n        Returns:\n            Sharpe ratio\n        \"\"\"\n        if len(self.equity_curve) < 2:\n            return 0.0\n\n        # Calculate returns\n        equity_series = pd.Series([e[\"equity\"] for e in self.equity_curve])\n        returns = equity_series.pct_change().dropna()\n\n        if len(returns) == 0 or returns.std() == 0:\n            return 0.0\n\n        # Annualize based on timeframe\n        periods_per_year = self._get_periods_per_year()\n\n        # Calculate Sharpe\n        excess_return = returns.mean() - (risk_free_rate / periods_per_year)\n        sharpe = (excess_return / returns.std()) * np.sqrt(periods_per_year)\n\n        return float(sharpe)\n\n    def _calculate_max_drawdown(self) -> float:\n        \"\"\"\n        Calculate maximum drawdown.\n\n        Formula: max((peak - trough) / peak)\n\n        Returns:\n            Max drawdown as decimal (e.g., 0.15 = 15%)\n        \"\"\"\n        if len(self.equity_curve) < 2:\n            return 0.0\n\n        equity_series = pd.Series([e[\"equity\"] for e in self.equity_curve])\n\n        # Calculate running maximum\n        running_max = equity_series.expanding().max()\n\n        # Calculate drawdown\n        drawdown = (equity_series - running_max) / running_max\n\n        # Maximum drawdown (most negative)\n        max_dd = abs(drawdown.min())\n\n        return float(max_dd)\n\n    def _calculate_directional_accuracy(self) -> tuple[float, Dict[int, float]]:\n        \"\"\"\n        Calculate Mean Directional Accuracy (MDA) and per-candle accuracy.\n\n        MDA = (correct_candles / total_candles_evaluated)\n\n        Returns:\n            Tuple of (mean_directional_accuracy, accuracy_by_candle)\n        \"\"\"\n        query = self.db.query(ActivePosition).filter(\n            ActivePosition.is_active.is_(False),\n            ActivePosition.decision_timestamp >= self.start_date,\n            ActivePosition.decision_timestamp <= self.end_date,\n        )\n\n        if self.backtest_run_id is not None:\n            query = query.filter(ActivePosition.backtest_run_id == self.backtest_run_id)\n\n        positions = query.all()\n\n        if not positions:\n            return 0.0, {}\n\n        # Track correct predictions per candle index\n        correct_by_candle = {}\n        total_by_candle = {}\n\n        for pos in positions:\n            expected_direction = \"up\" if pos.side == OrderSide.BUY else \"down\"\n\n            # Evaluate up to prediction_horizon candles\n            for i, direction in enumerate(\n                pos.candles_direction[: pos.prediction_horizon]\n            ):\n                candle_idx = i + 1  # 1-indexed (candle 1, 2, 3...)\n\n                if candle_idx not in correct_by_candle:\n                    correct_by_candle[candle_idx] = 0\n                    total_by_candle[candle_idx] = 0\n\n                total_by_candle[candle_idx] += 1\n                if direction == expected_direction:\n                    correct_by_candle[candle_idx] += 1\n\n        # Calculate accuracy per candle\n        accuracy_by_candle = {\n            candle: correct_by_candle[candle] / total_by_candle[candle]\n            for candle in sorted(total_by_candle.keys())\n        }\n\n        # Calculate overall MDA\n        total_correct = sum(correct_by_candle.values())\n        total_candles = sum(total_by_candle.values())\n        mda = total_correct / total_candles if total_candles > 0 else 0.0\n\n        return mda, accuracy_by_candle\n\n    def _calculate_close_reasons(self) -> Dict[str, int]:\n        \"\"\"\n        Calculate distribution of position close reasons.\n\n        Returns:\n            Dict mapping close_reason to count\n        \"\"\"\n        query = self.db.query(ActivePosition).filter(\n            ActivePosition.is_active.is_(False),\n            ActivePosition.decision_timestamp >= self.start_date,\n            ActivePosition.decision_timestamp <= self.end_date,\n        )\n\n        if self.backtest_run_id is not None:\n            query = query.filter(ActivePosition.backtest_run_id == self.backtest_run_id)\n\n        positions = query.all()\n\n        close_reasons = {}\n        for pos in positions:\n            reason = pos.close_reason or \"unknown\"\n            close_reasons[reason] = close_reasons.get(reason, 0) + 1\n\n        return close_reasons\n\n    def _get_periods_per_year(self) -> int:\n        \"\"\"Get number of periods per year based on timeframe.\"\"\"\n        if self.timeframe == \"1h\":\n            return 252 * 6.5  # Trading days * hours per day\n        elif self.timeframe == \"4h\":\n            return 252 * 1.625  # Approx 1.6 periods per day\n        elif self.timeframe == \"1d\":\n            return 252\n        elif self.timeframe == \"1w\":\n            return 52\n        else:\n            return 252\n\n    def _update_backtest_run(self, metrics: BacktestMetrics) -> None:\n        \"\"\"Update BacktestRun record with final metrics.\"\"\"\n        if not self.backtest_run_id:\n            return\n\n        run = (\n            self.db.query(BacktestRun)\n            .filter(BacktestRun.id == self.backtest_run_id)\n            .first()\n        )\n\n        if run:\n            run.total_trades = metrics.total_trades\n            run.win_rate = metrics.win_rate\n            run.profit_factor = metrics.profit_factor\n            run.sharpe_ratio = metrics.sharpe_ratio\n            run.max_drawdown = metrics.max_drawdown\n            run.total_pnl = Decimal(str(metrics.total_pnl))\n\n            self.db.commit()\n            logger.info(\n                f\"Updated backtest run #{self.backtest_run_id} with final metrics\",\n                extra={\"event_type\": \"backtest_complete\"},\n            )\n\n    def get_equity_curve(self) -> pd.DataFrame:\n        \"\"\"\n        Get equity curve as DataFrame.\n\n        Returns:\n            DataFrame with columns: date, equity, cash, positions_value\n        \"\"\"\n        return pd.DataFrame(self.equity_curve)\n\n    def __del__(self):\n        \"\"\"Cleanup database session if we own it.\"\"\"\n        if self._own_session and self.db:\n            self.db.close()\n","numLines":1032,"startLine":1,"totalLines":1032}}}
