uff check quantagent/ --fix\n          ruff check quantagent/ --output-format=github\n        continue-on-error: true\n      \n      # Unit tests temporarily disabled (tracked for later deep dive)\n      # - name: Run unit tests\n      #   id: tests\n      #   env:\n      #     DATABASE_URL: postgresql://test:test@localhost:5432/quantagent_test\n      #   run: |\n      #     pytest tests/ -v --tb=short --maxfail=5 \\\n      #       -m \"not integration and not slow\"\n      #   continue-on-error: true\n      \n      - name: Determine overall status\n        id: status\n        env:\n          LINT_EXIT: ${{ steps.lint.outcome }}\n          TESTS_EXIT: ${{ steps.tests.outcome || 'skipped' }}\n        run: |\n          if [[ \"$LINT_EXIT\" != \"success\" ]]; then\n            echo \"failed_step=Lint\" >> $GITHUB_OUTPUT\n            exit 1\n          fi\n\n          if [[ \"$TESTS_EXIT\" != \"success\" && \"$TESTS_EXIT\" != \"skipped\" ]]; then\n            echo \"failed_step=Unit tests\" >> $GITHUB_OUTPUT\n            exit 1\n          fi\n\n          echo \"All checks passed\"\n      \n      - name: Notify Telegram on failure\n        if: failure()\n        env:\n          TELEGRAM_BOT_TOKEN: ${{ secrets.TELEGRAM_BOT_TOKEN }}\n        run: |\n          COMMIT_SHA=\"${GITHUB_SHA:0:7}\"\n          COMMIT_MSG=$(git log -1 --pretty=%B | head -1 | tr '\"' \"'\")\n          FAILED_STEP=\"${{ steps.status.outputs.failed_step || 'Unknown' }}\"\n          RUN_URL=\"https://github.com/${{ github.repository }}/actions/runs/${{ github.run_id }}\"\n          \n          curl -X POST \"https://api.telegram.org/bot${TELEGRAM_BOT_TOKEN}/sendMessage\" \\\n            -H \"Content-Type: application/json\" \\\n            -d \"{\n              \\\"chat_id\\\": \\\"-1003835130753\\\",\n              \\\"message_thread_id\\\": 208,\n              \\\"text\\\": \\\"🚨 CI Failure\\\\n\\\\nCommit: ${COMMIT_SHA}\\\\nMessage: ${COMMIT_MSG}\\\\nFailed step: ${FAILED_STEP}\\\\nLogs: ${RUN_URL}\\\\n\\\\n@openclaw Run ID: ${{ github.run_id }}\\\",\n              \\\"disable_web_page_preview\\\": true\n            }\"\n      \n      - name: Notify Telegram on success\n        if: success()\n        env:\n          TELEGRAM_BOT_TOKEN: ${{ secrets.TELEGRAM_BOT_TOKEN }}\n        run: |\n          COMMIT_SHA=\"${GITHUB_SHA:0:7}\"\n          COMMIT_MSG=$(git log -1 --pretty=%B | head -1 | tr '\"' \"'\")\n          \n          curl -X POST \"https://api.telegram.org/bot${TELEGRAM_BOT_TOKEN}/sendMessage\" \\\n            -H \"Content-Type: application/json\" \\\n            -d \"{\n              \\\"chat_id\\\": \\\"-1003835130753\\\",\n              \\\"message_thread_id\\\": 208,\n              \\\"text\\\": \\\"✅ CI passed\\\\n\\\\nCommit: ${COMMIT_SHA}\\\\nMessage: ${COMMIT_MSG}\\\",\n              \\\"disable_web_page_preview\\\": true\n            }\"\n  \n  deploy-qa:\n    name: Deploy to QA\n    needs: ci\n    runs-on: ubuntu-latest\n    if: success()\n    \n    steps:\n      - name: Deploy to QA via SSH\n        uses: appleboy/ssh-action@v1.0.3\n        with:\n          host: ${{ secrets.VM_HOST }}\n          username: azureuser\n          key: ${{ secrets.VM_SSH_KEY }}\n          script: |\n            cd ~/repos/projects/QuantAgent\n            git fetch origin\n            git reset --hard origin/main\n            sudo docker-compose -f docker-compose.qa.yml down || true\n            sudo docker-compose -f docker-compose.qa.yml build --no-cache\n            sudo docker-compose -f docker-compose.qa.yml up -d\n            echo \"Waiting for services to be healthy...\"\n            sleep 30\n      \n      - name: Health check\n        run: |\n          for i in {1..10}; do\n            if curl -f https://qa.fedes.dev/health; then\n              echo \"QA environment is healthy\"\n              exit 0\n            fi\n            echo \"Attempt $i/10 failed, waiting...\"\n            sleep 10\n          done\n          echo \"Health check failed after 10 attempts\"\n          exit 1\n      \n      - name: Notify Telegram on deploy success\n        if: success()\n        env:\n          TELEGRAM_BOT_TOKEN: ${{ secrets.TELEGRAM_BOT_TOKEN }}\n        run: |\n          COMMIT_SHA=\"${GITHUB_SHA:0:7}\"\n          COMMIT_MSG=$(git log -1 --pretty=%B | head -1 | tr '\"' \"'\")\n          \n          curl -X POST \"https://api.telegram.org/bot${TELEGRAM_BOT_TOKEN}/sendMessage\" \\\n            -H \"Content-Type: application/json\" \\\n            -d \"{\n              \\\"chat_id\\\": \\\"-1003835130753\\\",\n              \\\"message_thread_id\\\": 208,\n              \\\"text\\\": \\\"🚀 QA Deploy Success\\\\n\\\\nCommit: ${COMMIT_SHA}\\\\nMessage: ${COMMIT_MSG}\\\\nURL: https://qa.fedes.dev\\\",\n              \\\"disable_web_page_preview\\\": true\n            }\"\n      \n      - name: Notify Telegram on deploy failure\n        if: failure()\n        env:\n          TELEGRAM_BOT_TOKEN: ${{ secrets.TELEGRAM_BOT_TOKEN }}\n        run: |\n          COMMIT_SHA=\"${GITHUB_SHA:0:7}\"\n          RUN_URL=\"https://github.com/${{ github.repository }}/actions/runs/${{ github.run_id }}\"\n          \n          curl -X POST \"https://api.telegram.org/bot${TELEGRAM_BOT_TOKEN}/sendMessage\" \\\n            -H \"Content-Type: application/json\" \\\n            -d \"{\n              \\\"chat_id\\\": \\\"-1003835130753\\\",\n              \\\"message_thread_id\\\": 208,\n              \\\"text\\\": \\\"❌ QA Deploy Failed\\\\n\\\\nCommit: ${COMMIT_SHA}\\\\nLogs: ${RUN_URL}\\\",\n              \\\"disable_web_page_preview\\\": true\n            }\"\n","numLines":200,"startLine":1,"totalLines":200}}}
