{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01W1y3EGwP9tkh7mGmQRZ8kf","type":"tool_result","content":"1\t\"\"\"Tests for TripleScreenStrategy — QuantAgent-vna.\"\"\"\n2\t\n3\timport math\n4\tfrom datetime import datetime, timedelta\n5\tfrom decimal import Decimal\n6\tfrom typing import Dict, List\n7\tfrom unittest.mock import Mock, patch\n8\t\n9\timport pandas as pd\n10\t\n11\tfrom quantagent.backtesting.backtest import Backtest\n12\tfrom quantagent.models import ActivePosition, ExitPolicy, MarketData, OrderSide\n13\tfrom quantagent.strategy.base import TradingSignal, TradingStrategy\n14\tfrom quantagent.strategy.triple_screen_strategy import TripleScreenStrategy\n15\t\n16\t# ---------------------------------------------------------------------------\n17\t# Helpers\n18\t# ---------------------------------------------------------------------------\n19\t\n20\tdef _make_candles(\n21\t    prices: List[float],\n22\t    spread: float = 0.5,\n23\t) -> List[Dict]:\n24\t    \"\"\"Build OHLCV candle list from a close-price sequence.\"\"\"\n25\t    candles = []\n26\t    for i, p in enumerate(prices):\n27\t        candles.append(\n28\t            {\n29\t                \"timestamp\": datetime(2024, 1, 1) + timedelta(hours=i * 4),\n30\t                \"open\": p - spread * 0.5,\n31\t                \"high\": p + spread,\n32\t                \"low\": p - spread,\n33\t                \"close\": p,\n34\t                \"volume\": 1000.0,\n35\t            }\n36\t        )\n37\t    return candles\n38\t\n39\t\n40\tdef _uptrend_candles(n: int = 200, base: float = 100.0) -> List[Dict]:\n41\t    \"\"\"\n42\t    Produces n candles in a durable uptrend with a mild pullback at the end.\n43\t\n44\t    The pullback is shallow enough to keep Screen 1 trending UP after weekly\n45\t    aggregation, while still pushing the fast stochastic below the oversold\n46\t    threshold for Screen 2.\n47\t    \"\"\"\n48\t    trend_prices = [base + i * 0.5 for i in range(n - 20)]\n49\t    pullback_prices = [trend_prices[-1] - i * 0.5 for i in range(1, 21)]\n50\t    return _make_candles(trend_prices + pullback_prices)\n51\t\n52\t\n53\tdef _downtrend_candles(n: int = 200, base: float = 200.0) -> List[Dict]:\n54\t    \"\"\"\n55\t    Produces n candles in a durable downtrend with a mild rally at the end.\n56\t\n57\t    The rally is shallow enough to keep Screen 1 trending DOWN after weekly\n58\t    aggregation, while still pushing the fast stochastic above the overbought\n59\t    threshold for Screen 2.\n60\t    \"\"\"\n61\t    trend_prices = [base - i * 0.5 for i in range(n - 20)]\n62\t    rally_prices = [trend_prices[-1] + i * 0.5 for i in range(1, 21)]\n63\t    return _make_candles(trend_prices + rally_prices)\n64\t\n65\t\n66\tdef _seed_market_data(db_session, symbol: str, timeframe: str, candles: List[Dict]) -> None:\n67\t    for candle in candles:\n68\t        db_session.add(\n69\t            MarketData(\n70\t                symbol=symbol,\n71\t                timeframe=timeframe,\n72\t                timestamp=candle[\"timestamp\"],\n73\t                open=Decimal(str(candle[\"open\"])),\n74\t                high=Decimal(str(candle[\"high\"])),\n75\t                low=Decimal(str(candle[\"low\"])),\n76\t                close=Decimal(str(candle[\"close\"])),\n77\t                volume=Decimal(str(candle[\"volume\"])),\n78\t            )\n79\t        )\n80\t    db_session.commit()\n81\t\n82\t\n83\t# ---------------------------------------------------------------------------\n84\t# AC1 — Class validity\n85\t# ---------------------------------------------------------------------------\n86\t\n87\tclass TestClassIsValidStrategy:\n88\t    \"\"\"AC1: TripleScreenStrategy satisfies the TradingStrategy ABC.\"\"\"\n89\t\n90\t    def test_class_is_valid_strategy(self):\n91\t        assert issubclass(TripleScreenStrategy, TradingStrategy)\n92\t\n93\t    def test_instantiation_with_defaults(self):\n94\t        strategy = TripleScreenStrategy()\n95\t        assert strategy is not None\n96\t\n97\t    def test_instantiation_with_custom_params(self):\n98\t        strategy = TripleScreenStrategy(\n99\t            weekly_bars=3,\n100\t            trend_ema_period=10,\n101\t            stoch_k_period=4,\n102\t            stoch_d_period=2,\n103\t            stoch_oversold=25.0,\n104\t            stoch_overbought=75.0,\n105\t            stop_loss_pct=0.03,\n106\t            take_profit_pct=0.06,\n107\t            trailing_stop_pct=0.07,\n108\t        )\n109\t        assert strategy.weekly_bars == 3\n110\t        assert strategy.stoch_oversold == 25.0\n111\t\n112\t\n113\t# ---------------------------------------------------------------------------\n114\t# AC2 — Screen 1: EMA slope\n115\t# ---------------------------------------------------------------------------\n116\t\n117\tclass TestScreen1Trend:\n118\t    \"\"\"AC2: Screen 1 correctly classifies trend direction.\"\"\"\n119\t\n120\t    def _weekly_df_from_prices(self, closes: List[float]) -> pd.DataFrame:\n121\t        rows = [{\"open\": c, \"high\": c + 0.5, \"low\": c - 0.5, \"close\": c, \"volume\": 1000.0} for c in closes]\n122\t        return pd.DataFrame(rows)\n123\t\n124\t    def test_screen1_uptrend(self):\n125\t        \"\"\"AC2.1: Rising closes → UP.\"\"\"\n126\t        strategy = TripleScreenStrategy(trend_ema_period=5)\n127\t        closes = [100.0 + i for i in range(20)]\n128\t        weekly_df = self._weekly_df_from_prices(closes)\n129\t        assert strategy._screen1_trend(weekly_df) == \"UP\"\n130\t\n131\t    def test_screen1_downtrend(self):\n132\t        \"\"\"AC2.2: Falling closes → DOWN.\"\"\"\n133\t        strategy = TripleScreenStrategy(trend_ema_period=5)\n134\t        closes = [120.0 - i for i in range(20)]\n135\t        weekly_df = self._weekly_df_from_prices(closes)\n136\t        assert strategy._screen1_trend(weekly_df) == \"DOWN\"\n137\t\n138\t    def test_screen1_insufficient_bars_returns_none(self):\n139\t        \"\"\"AC2.3: Fewer than trend_ema_period + 1 bars → None.\"\"\"\n140\t        strategy = TripleScreenStrategy(trend_ema_period=13)\n141\t        closes = [100.0] * 5  # only 5 bars, need 14\n142\t        weekly_df = self._weekly_df_from_prices(closes)\n143\t        assert strategy._screen1_trend(weekly_df) is None\n144\t\n145\t\n146\t# ---------------------------------------------------------------------------\n147\t# AC3 — Screen 2: Stochastic\n148\t# ---------------------------------------------------------------------------\n149\t\n150\tclass TestScreen2Oscillator:\n151\t    \"\"\"AC3: Screen 2 stochastic activation rules.\"\"\"\n152\t\n153\t    def _oversold_candles(self, n: int = 30) -> List[Dict]:\n154\t        \"\"\"Last few candles at very low prices → stoch_k << 20.\"\"\"\n155\t        high_prices = [100.0] * (n - 8)\n156\t        low_prices = [60.0 - i for i in range(8)]\n157\t        return _make_candles(high_prices + low_prices)\n158\t\n159\t    def _overbought_candles(self, n: int = 30) -> List[Dict]:\n160\t        \"\"\"Last few candles at very high prices → stoch_k >> 80.\"\"\"\n161\t        low_prices = [60.0] * (n - 8)\n162\t        high_prices = [100.0 + i for i in range(8)]\n163\t        return _make_candles(low_prices + high_prices)\n164\t\n165\t    def _midrange_candles(self, n: int = 30, price: float = 80.0) -> List[Dict]:\n166\t        \"\"\"Candles in mid-range → stoch_k ~50.\"\"\"\n167\t        prices = [price + (i % 3) * 0.1 for i in range(n)]\n168\t        return _make_candles(prices)\n169\t\n170\t    def test_screen2_uptrend_oversold_activates(self):\n171\t        \"\"\"AC3.1: Uptrend + oversold stoch → True.\"\"\"\n172\t        strategy = TripleScreenStrategy(stoch_k_period=5, stoch_d_period=3)\n173\t        df = pd.DataFrame(self._oversold_candles())\n174\t        assert strategy._screen2_oscillator(df, \"UP\") is True\n175\t\n176\t    def test_screen2_uptrend_not_oversold(self):\n177\t        \"\"\"AC3.2: Uptrend + mid-range stoch → False.\"\"\"\n178\t        strategy = TripleScreenStrategy(stoch_k_period=5, stoch_d_period=3)\n179\t        df = pd.DataFrame(self._midrange_candles())\n180\t        assert strategy._screen2_oscillator(df, \"UP\") is False\n181\t\n182\t    def test_screen2_downtrend_overbought_activates(self):\n183\t        \"\"\"AC3.3: Downtrend + overbought stoch → True.\"\"\"\n184\t        strategy = TripleScreenStrategy(stoch_k_period=5, stoch_d_period=3)\n185\t        df = pd.DataFrame(self._overbought_candles())\n186\t        assert strategy._screen2_oscillator(df, \"DOWN\") is True\n187\t\n188\t    def test_screen2_downtrend_not_overbought(self):\n189\t        \"\"\"AC3.4: Downtrend + mid-range stoch → False.\"\"\"\n190\t        strategy = TripleScreenStrategy(stoch_k_period=5, stoch_d_period=3)\n191\t        df = pd.DataFrame(self._midrange_candles())\n192\t        assert strategy._screen2_oscillator(df, \"DOWN\") is False\n193\t\n194\t\n195\t# ---------------------------------------------------------------------------\n196\t# AC4 — Screen 3: Breakout trigger\n197\t# ---------------------------------------------------------------------------\n198\t\n199\tclass TestScreen3Trigger:\n200\t    \"\"\"AC4: Screen 3 breakout fires correctly.\"\"\"\n201\t\n202\t    def _candles_with_prior_high(self, prior_high: float) -> List[Dict]:\n203\t        candles = _make_candles([100.0] * 10)\n204\t        candles[-2][\"high\"] = prior_high\n205\t        candles[-1][\"close\"] = prior_high - 2\n206\t        return candles\n207\t\n208\t    def _candles_with_prior_low(self, prior_low: float) -> List[Dict]:\n209\t        candles = _make_candles([100.0] * 10)\n210\t        candles[-2][\"low\"] = prior_low\n211\t        candles[-1][\"close\"] = prior_low + 2\n212\t        return candles\n213\t\n214\t    def test_screen3_long_breakout_triggers(self):\n215\t        \"\"\"AC4.1: current_price > prior high → True (UP).\"\"\"\n216\t        strategy = TripleScreenStrategy()\n217\t        klines = self._candles_with_prior_high(prior_high=105.0)\n218\t        assert strategy._screen3_trigger(klines, \"UP\", 106.0) is True\n219\t\n220\t    def test_screen3_long_no_breakout(self):\n221\t        \"\"\"AC4.2: current_price <= prior high → False (UP).\"\"\"\n222\t        strategy = TripleScreenStrategy()\n223\t        klines = self._candles_with_prior_high(prior_high=105.0)\n224\t        assert strategy._screen3_trigger(klines, \"UP\", 104.9) is False\n225\t\n226\t    def test_screen3_short_breakout_triggers(self):\n227\t        \"\"\"AC4.3: current_price < prior low → True (DOWN).\"\"\"\n228\t        strategy = TripleScreenStrategy()\n229\t        klines = self._candles_with_prior_low(prior_low=95.0)\n230\t        assert strategy._screen3_trigger(klines, \"DOWN\", 94.9) is True\n231\t\n232\t    def test_screen3_short_no_breakout(self):\n233\t        \"\"\"AC4.4: current_price >= prior low → False (DOWN).\"\"\"\n234\t        strategy = TripleScreenStrategy()\n235\t        klines = self._candles_with_prior_low(prior_low=95.0)\n236\t        assert strategy._screen3_trigger(klines, \"DOWN\", 95.1) is False\n237\t\n238\t\n239\t# ---------------------------------------------------------------------------\n240\t# AC5 — generate_signal integration\n241\t# ---------------------------------------------------------------------------\n242\t\n243\tclass TestGenerateSignal:\n244\t    \"\"\"AC5: generate_signal combines all three screens correctly.\"\"\"\n245\t\n246\t    def test_generate_signal_long_all_screens_pass(self):\n247\t        \"\"\"AC5.1: All screens → LONG signal with correct fields.\"\"\"\n248\t        strategy = TripleScreenStrategy()\n249\t        klines = _uptrend_candles(n=200)\n250\t\n251\t        # current_price must be above kline[-2][\"high\"] to fire Screen 3\n252\t        prior_high = float(klines[-2][\"high\"])\n253\t        current_price = prior_high + 1.0\n254\t\n255\t        signal = strategy.generate_signal(klines, \"BTC-USD\", \"4h\", current_price)\n256\t\n257\t        assert signal is not None\n258\t        assert isinstance(signal, TradingSignal)\n259\t        assert signal.decision == \"LONG\"\n260\t        assert 0.1 <= signal.confidence <= 1.0\n261\t        assert signal.entry_price == current_price\n262\t        assert abs(signal.stop_loss - current_price * (1 - strategy.stop_loss_pct)) < 1e-6\n263\t        assert abs(signal.take_profit - current_price * (1 + strategy.take_profit_pct)) < 1e-6\n264\t        assert \"Screen\" in signal.reasoning\n265\t\n266\t    def test_generate_signal_short_all_screens_pass(self):\n267\t        \"\"\"AC5.2: All screens → SHORT signal with correct fields.\"\"\"\n268\t        strategy = TripleScreenStrategy()\n269\t        klines = _downtrend_candles(n=200)\n270\t\n271\t        prior_low = float(klines[-2][\"low\"])\n272\t        current_price = prior_low - 1.0\n273\t\n274\t        signal = strategy.generate_signal(klines, \"BTC-USD\", \"4h\", current_price)\n275\t\n276\t        assert signal is not None\n277\t        assert signal.decision == \"SHORT\"\n278\t        assert abs(signal.stop_loss - current_price * (1 + strategy.stop_loss_pct)) < 1e-6\n279\t        assert abs(signal.take_profit - current_price * (1 - strategy.take_profit_pct)) < 1e-6\n280\t\n281\t    def test_generate_signal_screen2_fails_returns_none(self):\n282\t        \"\"\"AC5.3: Screen 1 UP but stoch not oversold → None.\"\"\"\n283\t        strategy = TripleScreenStrategy()\n284\t        # Steady uptrend with no pullback: stoch will be near 100 (overbought), not oversold\n285\t        prices = [100.0 + i for i in range(200)]\n286\t        klines = _make_candles(prices)\n287\t        current_price = float(klines[-2][\"high\"]) + 1.0\n288\t        signal = strategy.generate_signal(klines, \"BTC-USD\", \"4h\", current_price)\n289\t        assert signal is None\n290\t\n291\t    def test_generate_signal_screen3_fails_returns_none(self):\n292\t        \"\"\"AC5.4: Screens 1+2 pass but no breakout → None.\"\"\"\n293\t        strategy = TripleScreenStrategy()\n294\t        klines = _uptrend_candles(n=200)\n295\t\n296\t        # current_price BELOW prior high → Screen 3 fails\n297\t        prior_high = float(klines[-2][\"high\"])\n298\t        current_price = prior_high - 1.0\n299\t\n300\t        signal = strategy.generate_signal(klines, \"BTC-USD\", \"4h\", current_price)\n301\t        assert signal is None\n302\t\n303\t    def test_generate_signal_insufficient_candles_returns_none(self):\n304\t        \"\"\"AC5.5: Fewer than min_candles → None without exception.\"\"\"\n305\t        strategy = TripleScreenStrategy()\n306\t        klines = _make_candles([100.0] * 10)\n307\t        signal = strategy.generate_signal(klines, \"BTC-USD\", \"4h\", 100.0)\n308\t        assert signal is None\n309\t\n310\t    def test_generate_signal_exactly_min_candles(self):\n311\t        \"\"\"Edge: exactly min_candles does not raise.\"\"\"\n312\t        strategy = TripleScreenStrategy()\n313\t        n = strategy._min_candles\n314\t        klines = _make_candles([100.0] * n)\n315\t        # Should not raise — may return None depending on market conditions\n316\t        result = strategy.generate_signal(klines, \"BTC-USD\", \"4h\", 100.5)\n317\t        assert result is None or isinstance(result, TradingSignal)\n318\t\n319\t\n320\t# ---------------------------------------------------------------------------\n321\t# AC6 — Realistic scenario generates non-HOLD signal\n322\t# ---------------------------------------------------------------------------\n323\t\n324\tdef test_generates_signal_in_realistic_scenario():\n325\t    \"\"\"AC6: Strategy generates a real signal (not None) in designed scenario.\"\"\"\n326\t    strategy = TripleScreenStrategy()\n327\t    klines = _uptrend_candles(n=200)\n328\t    prior_high = float(klines[-2][\"high\"])\n329\t    current_price = prior_high + 1.0\n330\t    signal = strategy.generate_signal(klines, \"BTC-USD\", \"4h\", current_price)\n331\t    assert signal is not None\n332\t    assert signal.decision in (\"LONG\", \"SHORT\")\n333\t\n334\t\n335\t# ---------------------------------------------------------------------------\n336\t# AC8 — should_reevaluate always False\n337\t# ---------------------------------------------------------------------------\n338\t\n339\tdef test_should_reevaluate_false():\n340\t    \"\"\"AC8: should_reevaluate returns False unconditionally.\"\"\"\n341\t    strategy = TripleScreenStrategy()\n342\t    position = ActivePosition(\n343\t        id=1,\n344\t        symbol=\"BTC-USD\",\n345\t        side=OrderSide.BUY,\n346\t        entry_price=100.0,\n347\t        stop_loss=98.0,\n348\t        take_profit=104.0,\n349\t        quantity=1.0,\n350\t        decision_timestamp=datetime.utcnow(),\n351\t        candles_since_entry=5,\n352\t        exit_policy=ExitPolicy.TRAILING_STOP,\n353\t        prediction_horizon=3,\n354\t        candles_direction=[],\n355\t        is_active=True,\n356\t    )\n357\t    assert strategy.should_reevaluate(position, 102.0) is False\n358\t\n359\t\n360\tdef test_backtest_reference_profile_completes(db_session):\n361\t    \"\"\"AC7: Reference backtest profile completes and produces finite metrics.\"\"\"\n362\t    strategy = TripleScreenStrategy()\n363\t    seed_start = datetime(2023, 12, 1)\n364\t    prices = [100.0 + i * 0.15 for i in range(732)]\n365\t    candles = _make_candles(prices)\n366\t    for index, candle in enumerate(candles):\n367\t        candle[\"timestamp\"] = seed_start + timedelta(hours=index * 4)\n368\t\n369\t    _seed_market_data(db_session, \"BTC-USD\", \"4h\", candles)\n370\t\n371\t    config = {\n372\t        \"base_position_pct\": 0.05,\n373\t        \"max_daily_loss_pct\": 0.05,\n374\t        \"max_position_pct\": 0.10,\n375\t        \"slippage_pct\": 0.01,\n376\t        \"agent_llm_provider\": \"openai\",\n377\t        \"agent_llm_model\": \"gpt-4o-mini\",\n378\t        \"agent_llm_temperature\": 0.1,\n379\t        \"market_hours_filter\": False,\n380\t    }\n381\t\n382\t    with patch(\"quantagent.data.provider.yf.download\") as mock_download:\n383\t        mock_download.return_value = Mock(empty=True)\n384\t        backtest = Backtest(\n385\t            start_date=datetime(2024, 1, 1),\n386\t            end_date=datetime(2024, 3, 31),\n387\t            assets=[\"BTC-USD\"],\n388\t            timeframe=\"4h\",\n389\t            initial_capital=100_000.0,\n390\t            config=config,\n391\t            db_session=db_session,\n392\t            strategy=strategy,\n393\t        )\n394\t        metrics = backtest.run(name=\"QuantAgent-vna-reference\")\n395\t\n396\t    assert math.isfinite(metrics.total_pnl)\n397\t    assert metrics.total_trades >= 0\n398\t\n399\t\n400\t# ---------------------------------------------------------------------------\n401\t# Exit policy\n402\t# ---------------------------------------------------------------------------\n403\t\n404\tdef test_default_exit_policy():\n405\t    strategy = TripleScreenStrategy()\n406\t    assert strategy.get_default_exit_policy() == ExitPolicy.TRAILING_STOP\n407\t"}]},"parent_tool_use_id":null,"session_id":"a4a16dcd-4157-4b5f-847a-b63e9050b3d1","uuid":"4874bc68-268a-4c9f-8ddb-1fb683829758","timestamp":"2026-05-05T21:40:16.186Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/autodev-worktrees/planning-20260505/QuantAgent-vna/implementer-20260505T174012Z/tests/test_triple_screen_strategy.py","content":"\"\"\"Tests for TripleScreenStrategy — QuantAgent-vna.\"\"\"\n\nimport math\nfrom datetime import datetime, timedelta\nfrom decimal import Decimal\nfrom typing import Dict, List\nfrom unittest.mock import Mock, patch\n\nimport pandas as pd\n\nfrom quantagent.backtesting.backtest import Backtest\nfrom quantagent.models import ActivePosition, ExitPolicy, MarketData, OrderSide\nfrom quantagent.strategy.base import TradingSignal, TradingStrategy\nfrom quantagent.strategy.triple_screen_strategy import TripleScreenStrategy\n\n# ---------------------------------------------------------------------------\n# Helpers\n# ---------------------------------------------------------------------------\n\ndef _make_candles(\n    prices: List[float],\n    spread: float = 0.5,\n) -> List[Dict]:\n    \"\"\"Build OHLCV candle list from a close-price sequence.\"\"\"\n    candles = []\n    for i, p in enumerate(prices):\n        candles.append(\n            {\n                \"timestamp\": datetime(2024, 1, 1) + timedelta(hours=i * 4),\n                \"open\": p - spread * 0.5,\n                \"high\": p + spread,\n                \"low\": p - spread,\n                \"close\": p,\n                \"volume\": 1000.0,\n            }\n        )\n    return candles\n\n\ndef _uptrend_candles(n: int = 200, base: float = 100.0) -> List[Dict]:\n    \"\"\"\n    Produces n candles in a durable uptrend with a mild pullback at the end.\n\n    The pullback is shallow enough to keep Screen 1 trending UP after weekly\n    aggregation, while still pushing the fast stochastic below the oversold\n    threshold for Screen 2.\n    \"\"\"\n    trend_prices = [base + i * 0.5 for i in range(n - 20)]\n    pullback_prices = [trend_prices[-1] - i * 0.5 for i in range(1, 21)]\n    return _make_candles(trend_prices + pullback_prices)\n\n\ndef _downtrend_candles(n: int = 200, base: float = 200.0) -> List[Dict]:\n    \"\"\"\n    Produces n candles in a durable downtrend with a mild rally at the end.\n\n    The rally is shallow enough to keep Screen 1 trending DOWN after weekly\n    aggregation, while still pushing the fast stochastic above the overbought\n    threshold for Screen 2.\n    \"\"\"\n    trend_prices = [base - i * 0.5 for i in range(n - 20)]\n    rally_prices = [trend_prices[-1] + i * 0.5 for i in range(1, 21)]\n    return _make_candles(trend_prices + rally_prices)\n\n\ndef _seed_market_data(db_session, symbol: str, timeframe: str, candles: List[Dict]) -> None:\n    for candle in candles:\n        db_session.add(\n            MarketData(\n                symbol=symbol,\n                timeframe=timeframe,\n                timestamp=candle[\"timestamp\"],\n                open=Decimal(str(candle[\"open\"])),\n                high=Decimal(str(candle[\"high\"])),\n                low=Decimal(str(candle[\"low\"])),\n                close=Decimal(str(candle[\"close\"])),\n                volume=Decimal(str(candle[\"volume\"])),\n            )\n        )\n    db_session.commit()\n\n\n# ---------------------------------------------------------------------------\n# AC1 — Class validity\n# ---------------------------------------------------------------------------\n\nclass TestClassIsValidStrategy:\n    \"\"\"AC1: TripleScreenStrategy satisfies the TradingStrategy ABC.\"\"\"\n\n    def test_class_is_valid_strategy(self):\n        assert issubclass(TripleScreenStrategy, TradingStrategy)\n\n    def test_instantiation_with_defaults(self):\n        strategy = TripleScreenStrategy()\n        assert strategy is not None\n\n    def test_instantiation_with_custom_params(self):\n        strategy = TripleScreenStrategy(\n            weekly_bars=3,\n            trend_ema_period=10,\n            stoch_k_period=4,\n            stoch_d_period=2,\n            stoch_oversold=25.0,\n            stoch_overbought=75.0,\n            stop_loss_pct=0.03,\n            take_profit_pct=0.06,\n            trailing_stop_pct=0.07,\n        )\n        assert strategy.weekly_bars == 3\n        assert strategy.stoch_oversold == 25.0\n\n\n# ---------------------------------------------------------------------------\n# AC2 — Screen 1: EMA slope\n# ---------------------------------------------------------------------------\n\nclass TestScreen1Trend:\n    \"\"\"AC2: Screen 1 correctly classifies trend direction.\"\"\"\n\n    def _weekly_df_from_prices(self, closes: List[float]) -> pd.DataFrame:\n        rows = [{\"open\": c, \"high\": c + 0.5, \"low\": c - 0.5, \"close\": c, \"volume\": 1000.0} for c in closes]\n        return pd.DataFrame(rows)\n\n    def test_screen1_uptrend(self):\n        \"\"\"AC2.1: Rising closes → UP.\"\"\"\n        strategy = TripleScreenStrategy(trend_ema_period=5)\n        closes = [100.0 + i for i in range(20)]\n        weekly_df = self._weekly_df_from_prices(closes)\n        assert strategy._screen1_trend(weekly_df) == \"UP\"\n\n    def test_screen1_downtrend(self):\n        \"\"\"AC2.2: Falling closes → DOWN.\"\"\"\n        strategy = TripleScreenStrategy(trend_ema_period=5)\n        closes = [120.0 - i for i in range(20)]\n        weekly_df = self._weekly_df_from_prices(closes)\n        assert strategy._screen1_trend(weekly_df) == \"DOWN\"\n\n    def test_screen1_insufficient_bars_returns_none(self):\n        \"\"\"AC2.3: Fewer than trend_ema_period + 1 bars → None.\"\"\"\n        strategy = TripleScreenStrategy(trend_ema_period=13)\n        closes = [100.0] * 5  # only 5 bars, need 14\n        weekly_df = self._weekly_df_from_prices(closes)\n        assert strategy._screen1_trend(weekly_df) is None\n\n\n# ---------------------------------------------------------------------------\n# AC3 — Screen 2: Stochastic\n# ---------------------------------------------------------------------------\n\nclass TestScreen2Oscillator:\n    \"\"\"AC3: Screen 2 stochastic activation rules.\"\"\"\n\n    def _oversold_candles(self, n: int = 30) -> List[Dict]:\n        \"\"\"Last few candles at very low prices → stoch_k << 20.\"\"\"\n        high_prices = [100.0] * (n - 8)\n        low_prices = [60.0 - i for i in range(8)]\n        return _make_candles(high_prices + low_prices)\n\n    def _overbought_candles(self, n: int = 30) -> List[Dict]:\n        \"\"\"Last few candles at very high prices → stoch_k >> 80.\"\"\"\n        low_prices = [60.0] * (n - 8)\n        high_prices = [100.0 + i for i in range(8)]\n        return _make_candles(low_prices + high_prices)\n\n    def _midrange_candles(self, n: int = 30, price: float = 80.0) -> List[Dict]:\n        \"\"\"Candles in mid-range → stoch_k ~50.\"\"\"\n        prices = [price + (i % 3) * 0.1 for i in range(n)]\n        return _make_candles(prices)\n\n    def test_screen2_uptrend_oversold_activates(self):\n        \"\"\"AC3.1: Uptrend + oversold stoch → True.\"\"\"\n        strategy = TripleScreenStrategy(stoch_k_period=5, stoch_d_period=3)\n        df = pd.DataFrame(self._oversold_candles())\n        assert strategy._screen2_oscillator(df, \"UP\") is True\n\n    def test_screen2_uptrend_not_oversold(self):\n        \"\"\"AC3.2: Uptrend + mid-range stoch → False.\"\"\"\n        strategy = TripleScreenStrategy(stoch_k_period=5, stoch_d_period=3)\n        df = pd.DataFrame(self._midrange_candles())\n        assert strategy._screen2_oscillator(df, \"UP\") is False\n\n    def test_screen2_downtrend_overbought_activates(self):\n        \"\"\"AC3.3: Downtrend + overbought stoch → True.\"\"\"\n        strategy = TripleScreenStrategy(stoch_k_period=5, stoch_d_period=3)\n        df = pd.DataFrame(self._overbought_candles())\n        assert strategy._screen2_oscillator(df, \"DOWN\") is True\n\n    def test_screen2_downtrend_not_overbought(self):\n        \"\"\"AC3.4: Downtrend + mid-range stoch → False.\"\"\"\n        strategy = TripleScreenStrategy(stoch_k_period=5, stoch_d_period=3)\n        df = pd.DataFrame(self._midrange_candles())\n        assert strategy._screen2_oscillator(df, \"DOWN\") is False\n\n\n# ---------------------------------------------------------------------------\n# AC4 — Screen 3: Breakout trigger\n# ---------------------------------------------------------------------------\n\nclass TestScreen3Trigger:\n    \"\"\"AC4: Screen 3 breakout fires correctly.\"\"\"\n\n    def _candles_with_prior_high(self, prior_high: float) -> List[Dict]:\n        candles = _make_candles([100.0] * 10)\n        candles[-2][\"high\"] = prior_high\n        candles[-1][\"close\"] = prior_high - 2\n        return candles\n\n    def _candles_with_prior_low(self, prior_low: float) -> List[Dict]:\n        candles = _make_candles([100.0] * 10)\n        candles[-2][\"low\"] = prior_low\n        candles[-1][\"close\"] = prior_low + 2\n        return candles\n\n    def test_screen3_long_breakout_triggers(self):\n        \"\"\"AC4.1: current_price > prior high → True (UP).\"\"\"\n        strategy = TripleScreenStrategy()\n        klines = self._candles_with_prior_high(prior_high=105.0)\n        assert strategy._screen3_trigger(klines, \"UP\", 106.0) is True\n\n    def test_screen3_long_no_breakout(self):\n        \"\"\"AC4.2: current_price <= prior high → False (UP).\"\"\"\n        strategy = TripleScreenStrategy()\n        klines = self._candles_with_prior_high(prior_high=105.0)\n        assert strategy._screen3_trigger(klines, \"UP\", 104.9) is False\n\n    def test_screen3_short_breakout_triggers(self):\n        \"\"\"AC4.3: current_price < prior low → True (DOWN).\"\"\"\n        strategy = TripleScreenStrategy()\n        klines = self._candles_with_prior_low(prior_low=95.0)\n        assert strategy._screen3_trigger(klines, \"DOWN\", 94.9) is True\n\n    def test_screen3_short_no_breakout(self):\n        \"\"\"AC4.4: current_price >= prior low → False (DOWN).\"\"\"\n        strategy = TripleScreenStrategy()\n        klines = self._candles_with_prior_low(prior_low=95.0)\n        assert strategy._screen3_trigger(klines, \"DOWN\", 95.1) is False\n\n\n# ---------------------------------------------------------------------------\n# AC5 — generate_signal integration\n# ---------------------------------------------------------------------------\n\nclass TestGenerateSignal:\n    \"\"\"AC5: generate_signal combines all three screens correctly.\"\"\"\n\n    def test_generate_signal_long_all_screens_pass(self):\n        \"\"\"AC5.1: All screens → LONG signal with correct fields.\"\"\"\n        strategy = TripleScreenStrategy()\n        klines = _uptrend_candles(n=200)\n\n        # current_price must be above kline[-2][\"high\"] to fire Screen 3\n        prior_high = float(klines[-2][\"high\"])\n        current_price = prior_high + 1.0\n\n        signal = strategy.generate_signal(klines, \"BTC-USD\", \"4h\", current_price)\n\n        assert signal is not None\n        assert isinstance(signal, TradingSignal)\n        assert signal.decision == \"LONG\"\n        assert 0.1 <= signal.confidence <= 1.0\n        assert signal.entry_price == current_price\n        assert abs(signal.stop_loss - current_price * (1 - strategy.stop_loss_pct)) < 1e-6\n        assert abs(signal.take_profit - current_price * (1 + strategy.take_profit_pct)) < 1e-6\n        assert \"Screen\" in signal.reasoning\n\n    def test_generate_signal_short_all_screens_pass(self):\n        \"\"\"AC5.2: All screens → SHORT signal with correct fields.\"\"\"\n        strategy = TripleScreenStrategy()\n        klines = _downtrend_candles(n=200)\n\n        prior_low = float(klines[-2][\"low\"])\n        current_price = prior_low - 1.0\n\n        signal = strategy.generate_signal(klines, \"BTC-USD\", \"4h\", current_price)\n\n        assert signal is not None\n        assert signal.decision == \"SHORT\"\n        assert abs(signal.stop_loss - current_price * (1 + strategy.stop_loss_pct)) < 1e-6\n        assert abs(signal.take_profit - current_price * (1 - strategy.take_profit_pct)) < 1e-6\n\n    def test_generate_signal_screen2_fails_returns_none(self):\n        \"\"\"AC5.3: Screen 1 UP but stoch not oversold → None.\"\"\"\n        strategy = TripleScreenStrategy()\n        # Steady uptrend with no pullback: stoch will be near 100 (overbought), not oversold\n        prices = [100.0 + i for i in range(200)]\n        klines = _make_candles(prices)\n        current_price = float(klines[-2][\"high\"]) + 1.0\n        signal = strategy.generate_signal(klines, \"BTC-USD\", \"4h\", current_price)\n        assert signal is None\n\n    def test_generate_signal_screen3_fails_returns_none(self):\n        \"\"\"AC5.4: Screens 1+2 pass but no breakout → None.\"\"\"\n        strategy = TripleScreenStrategy()\n        klines = _uptrend_candles(n=200)\n\n        # current_price BELOW prior high → Screen 3 fails\n        prior_high = float(klines[-2][\"high\"])\n        current_price = prior_high - 1.0\n\n        signal = strategy.generate_signal(klines, \"BTC-USD\", \"4h\", current_price)\n        assert signal is None\n\n    def test_generate_signal_insufficient_candles_returns_none(self):\n        \"\"\"AC5.5: Fewer than min_candles → None without exception.\"\"\"\n        strategy = TripleScreenStrategy()\n        klines = _make_candles([100.0] * 10)\n        signal = strategy.generate_signal(klines, \"BTC-USD\", \"4h\", 100.0)\n        assert signal is None\n\n    def test_generate_signal_exactly_min_candles(self):\n        \"\"\"Edge: exactly min_candles does not raise.\"\"\"\n        strategy = TripleScreenStrategy()\n        n = strategy._min_candles\n        klines = _make_candles([100.0] * n)\n        # Should not raise — may return None depending on market conditions\n        result = strategy.generate_signal(klines, \"BTC-USD\", \"4h\", 100.5)\n        assert result is None or isinstance(result, TradingSignal)\n\n\n# ---------------------------------------------------------------------------\n# AC6 — Realistic scenario generates non-HOLD signal\n# ---------------------------------------------------------------------------\n\ndef test_generates_signal_in_realistic_scenario():\n    \"\"\"AC6: Strategy generates a real signal (not None) in designed scenario.\"\"\"\n    strategy = TripleScreenStrategy()\n    klines = _uptrend_candles(n=200)\n    prior_high = float(klines[-2][\"high\"])\n    current_price = prior_high + 1.0\n    signal = strategy.generate_signal(klines, \"BTC-USD\", \"4h\", current_price)\n    assert signal is not None\n    assert signal.decision in (\"LONG\", \"SHORT\")\n\n\n# ---------------------------------------------------------------------------\n# AC8 — should_reevaluate always False\n# ---------------------------------------------------------------------------\n\ndef test_should_reevaluate_false():\n    \"\"\"AC8: should_reevaluate returns False unconditionally.\"\"\"\n    strategy = TripleScreenStrategy()\n    position = ActivePosition(\n        id=1,\n        symbol=\"BTC-USD\",\n        side=OrderSide.BUY,\n        entry_price=100.0,\n        stop_loss=98.0,\n        take_profit=104.0,\n        quantity=1.0,\n        decision_timestamp=datetime.utcnow(),\n        candles_since_entry=5,\n        exit_policy=ExitPolicy.TRAILING_STOP,\n        prediction_horizon=3,\n        candles_direction=[],\n        is_active=True,\n    )\n    assert strategy.should_reevaluate(position, 102.0) is False\n\n\ndef test_backtest_reference_profile_completes(db_session):\n    \"\"\"AC7: Reference backtest profile completes and produces finite metrics.\"\"\"\n    strategy = TripleScreenStrategy()\n    seed_start = datetime(2023, 12, 1)\n    prices = [100.0 + i * 0.15 for i in range(732)]\n    candles = _make_candles(prices)\n    for index, candle in enumerate(candles):\n        candle[\"timestamp\"] = seed_start + timedelta(hours=index * 4)\n\n    _seed_market_data(db_session, \"BTC-USD\", \"4h\", candles)\n\n    config = {\n        \"base_position_pct\": 0.05,\n        \"max_daily_loss_pct\": 0.05,\n        \"max_position_pct\": 0.10,\n        \"slippage_pct\": 0.01,\n        \"agent_llm_provider\": \"openai\",\n        \"agent_llm_model\": \"gpt-4o-mini\",\n        \"agent_llm_temperature\": 0.1,\n        \"market_hours_filter\": False,\n    }\n\n    with patch(\"quantagent.data.provider.yf.download\") as mock_download:\n        mock_download.return_value = Mock(empty=True)\n        backtest = Backtest(\n            start_date=datetime(2024, 1, 1),\n            end_date=datetime(2024, 3, 31),\n            assets=[\"BTC-USD\"],\n            timeframe=\"4h\",\n            initial_capital=100_000.0,\n            config=config,\n            db_session=db_session,\n            strategy=strategy,\n        )\n        metrics = backtest.run(name=\"QuantAgent-vna-reference\")\n\n    assert math.isfinite(metrics.total_pnl)\n    assert metrics.total_trades >= 0\n\n\n# ---------------------------------------------------------------------------\n# Exit policy\n# ---------------------------------------------------------------------------\n\ndef test_default_exit_policy():\n    strategy = TripleScreenStrategy()\n    assert strategy.get_default_exit_policy() == ExitPolicy.TRAILING_STOP\n","numLines":407,"startLine":1,"totalLines":407}}}
