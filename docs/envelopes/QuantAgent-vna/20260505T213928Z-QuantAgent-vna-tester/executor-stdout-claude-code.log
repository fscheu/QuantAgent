{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_019GqBrKRu5Y3c6psvDdxwbU","type":"tool_result","content":"1\t\"\"\"Triple Screen Strategy (Alexander Elder) — QuantAgent-vna M1 implementation.\"\"\"\n2\t\n3\tfrom typing import Dict, List, Optional, Tuple\n4\t\n5\timport pandas as pd\n6\t\n7\tfrom ..models import ActivePosition, ExitPolicy\n8\tfrom .base import TradingSignal, TradingStrategy\n9\t\n10\t_EPS = 1e-10\n11\t\n12\t\n13\tclass TripleScreenStrategy(TradingStrategy):\n14\t    \"\"\"\n15\t    Alexander Elder's Triple Screen trading system.\n16\t\n17\t    Three successive filters before any entry:\n18\t      Screen 1 — weekly EMA slope identifies dominant trend direction.\n19\t      Screen 2 — stochastic oscillator detects pullback within trend.\n20\t      Screen 3 — breakout above/below prior candle's high/low triggers entry.\n21\t    \"\"\"\n22\t\n23\t    def __init__(\n24\t        self,\n25\t        weekly_bars: int = 5,\n26\t        trend_ema_period: int = 13,\n27\t        stoch_k_period: int = 5,\n28\t        stoch_d_period: int = 3,\n29\t        stoch_oversold: float = 20.0,\n30\t        stoch_overbought: float = 80.0,\n31\t        stop_loss_pct: float = 0.02,\n32\t        take_profit_pct: float = 0.04,\n33\t        trailing_stop_pct: float = 0.05,\n34\t    ):\n35\t        self.weekly_bars = weekly_bars\n36\t        self.trend_ema_period = trend_ema_period\n37\t        self.stoch_k_period = stoch_k_period\n38\t        self.stoch_d_period = stoch_d_period\n39\t        self.stoch_oversold = stoch_oversold\n40\t        self.stoch_overbought = stoch_overbought\n41\t        self.stop_loss_pct = stop_loss_pct\n42\t        self.take_profit_pct = take_profit_pct\n43\t        self.trailing_stop_pct = trailing_stop_pct\n44\t\n45\t    @property\n46\t    def _min_candles(self) -> int:\n47\t        return (\n48\t            self.weekly_bars * (self.trend_ema_period + 1)\n49\t            + self.stoch_k_period\n50\t            + self.stoch_d_period\n51\t        )\n52\t\n53\t    def generate_signal(\n54\t        self,\n55\t        kline_data: List[Dict],\n56\t        symbol: str,\n57\t        timeframe: str,\n58\t        current_price: float,\n59\t    ) -> Optional[TradingSignal]:\n60\t        if len(kline_data) < self._min_candles:\n61\t            return None\n62\t\n63\t        df = pd.DataFrame(kline_data)\n64\t\n65\t        weekly_df = self._aggregate_weekly_bars(df)\n66\t        trend = self._screen1_trend(weekly_df)\n67\t        if trend is None:\n68\t            return None\n69\t\n70\t        screen2_active = self._screen2_oscillator(df, trend)\n71\t        if not screen2_active:\n72\t            return None\n73\t\n74\t        screen3_active = self._screen3_trigger(kline_data, trend, current_price)\n75\t        if not screen3_active:\n76\t            return None\n77\t\n78\t        stoch_k, _ = self._stochastic(df)\n79\t        confidence = self._confidence(stoch_k, trend)\n80\t\n81\t        if trend == \"UP\":\n82\t            decision = \"LONG\"\n83\t            stop_loss = current_price * (1 - self.stop_loss_pct)\n84\t            take_profit = current_price * (1 + self.take_profit_pct)\n85\t        else:\n86\t            decision = \"SHORT\"\n87\t            stop_loss = current_price * (1 + self.stop_loss_pct)\n88\t            take_profit = current_price * (1 - self.take_profit_pct)\n89\t\n90\t        reasoning = (\n91\t            f\"Screen 1: trend={trend} (EMA slope on {self.weekly_bars}-bar aggregates); \"\n92\t            f\"Screen 2: stoch_k={stoch_k:.1f} ({'oversold' if trend == 'UP' else 'overbought'}); \"\n93\t            f\"Screen 3: breakout {'above prior high' if trend == 'UP' else 'below prior low'}\"\n94\t        )\n95\t\n96\t        return TradingSignal(\n97\t            decision=decision,\n98\t            confidence=confidence,\n99\t            entry_price=current_price,\n100\t            stop_loss=stop_loss,\n101\t            take_profit=take_profit,\n102\t            reasoning=reasoning,\n103\t            exit_policy=ExitPolicy.TRAILING_STOP,\n104\t            trailing_stop_pct=self.trailing_stop_pct,\n105\t        )\n106\t\n107\t    def should_reevaluate(self, position: ActivePosition, current_price: float) -> bool:\n108\t        return False\n109\t\n110\t    def get_default_exit_policy(self) -> ExitPolicy:\n111\t        return ExitPolicy.TRAILING_STOP\n112\t\n113\t    # ------------------------------------------------------------------\n114\t    # Private helpers\n115\t    # ------------------------------------------------------------------\n116\t\n117\t    def _aggregate_weekly_bars(self, df: pd.DataFrame) -> pd.DataFrame:\n118\t        \"\"\"Reshape kline_data into synthetic higher-TF bars of `weekly_bars` candles.\"\"\"\n119\t        n = len(df)\n120\t        complete = (n // self.weekly_bars) * self.weekly_bars\n121\t        trimmed = df.iloc[:complete].copy()\n122\t\n123\t        groups = []\n124\t        for start in range(0, complete, self.weekly_bars):\n125\t            block = trimmed.iloc[start : start + self.weekly_bars]\n126\t            groups.append(\n127\t                {\n128\t                    \"open\": block[\"open\"].iloc[0],\n129\t                    \"high\": block[\"high\"].max(),\n130\t                    \"low\": block[\"low\"].min(),\n131\t                    \"close\": block[\"close\"].iloc[-1],\n132\t                    \"volume\": block[\"volume\"].sum(),\n133\t                }\n134\t            )\n135\t        return pd.DataFrame(groups)\n136\t\n137\t    def _ema(self, series: pd.Series, period: int) -> pd.Series:\n138\t        \"\"\"Exponential moving average with alpha = 2/(period+1).\"\"\"\n139\t        return series.ewm(span=period, adjust=False).mean()\n140\t\n141\t    def _stochastic(self, df: pd.DataFrame) -> Tuple[float, float]:\n142\t        \"\"\"Compute last completed Stochastic %K and %D values.\"\"\"\n143\t        lowest_low = df[\"low\"].rolling(window=self.stoch_k_period, min_periods=self.stoch_k_period).min()\n144\t        highest_high = df[\"high\"].rolling(window=self.stoch_k_period, min_periods=self.stoch_k_period).max()\n145\t        pct_k = 100.0 * (df[\"close\"] - lowest_low) / (highest_high - lowest_low + _EPS)\n146\t        pct_d = pct_k.rolling(window=self.stoch_d_period, min_periods=self.stoch_d_period).mean()\n147\t        return float(pct_k.iloc[-1]), float(pct_d.iloc[-1])\n148\t\n149\t    def _screen1_trend(self, weekly_df: pd.DataFrame) -> Optional[str]:\n150\t        \"\"\"Return 'UP', 'DOWN', or None when insufficient bars.\"\"\"\n151\t        if len(weekly_df) < self.trend_ema_period + 1:\n152\t            return None\n153\t        ema = self._ema(weekly_df[\"close\"], self.trend_ema_period)\n154\t        slope = float(ema.iloc[-1]) - float(ema.iloc[-2])\n155\t        return \"UP\" if slope > 0 else \"DOWN\"\n156\t\n157\t    def _screen2_oscillator(self, df: pd.DataFrame, trend: str) -> bool:\n158\t        \"\"\"Return True when stochastic confirms a pullback within the trend.\"\"\"\n159\t        stoch_k, _ = self._stochastic(df)\n160\t        if trend == \"UP\":\n161\t            return stoch_k <= self.stoch_oversold\n162\t        else:\n163\t            return stoch_k >= self.stoch_overbought\n164\t\n165\t    def _screen3_trigger(self, kline_data: List[Dict], trend: str, current_price: float) -> bool:\n166\t        \"\"\"Return True when price breaks out of the prior completed candle.\"\"\"\n167\t        if len(kline_data) < 2:\n168\t            return False\n169\t        prior = kline_data[-2]\n170\t        if trend == \"UP\":\n171\t            return current_price > float(prior[\"high\"])\n172\t        else:\n173\t            return current_price < float(prior[\"low\"])\n174\t\n175\t    def _confidence(self, stoch_k: float, trend: str) -> float:\n176\t        \"\"\"Map stochastic depth to a [0.1, 1.0] confidence score.\"\"\"\n177\t        if trend == \"UP\":\n178\t            raw = (self.stoch_oversold - stoch_k) / (self.stoch_oversold + _EPS)\n179\t        else:\n180\t            raw = (stoch_k - self.stoch_overbought) / (100.0 - self.stoch_overbought + _EPS)\n181\t        return max(0.1, min(1.0, raw))\n182\t"}]},"parent_tool_use_id":null,"session_id":"a4a16dcd-4157-4b5f-847a-b63e9050b3d1","uuid":"047d2a15-fdb6-4c82-ae70-0cc748615f63","timestamp":"2026-05-05T21:40:16.171Z","tool_use_result":{"type":"text","file":{"filePath":"/tmp/autodev-worktrees/planning-20260505/QuantAgent-vna/implementer-20260505T174012Z/quantagent/strategy/triple_screen_strategy.py","content":"\"\"\"Triple Screen Strategy (Alexander Elder) — QuantAgent-vna M1 implementation.\"\"\"\n\nfrom typing import Dict, List, Optional, Tuple\n\nimport pandas as pd\n\nfrom ..models import ActivePosition, ExitPolicy\nfrom .base import TradingSignal, TradingStrategy\n\n_EPS = 1e-10\n\n\nclass TripleScreenStrategy(TradingStrategy):\n    \"\"\"\n    Alexander Elder's Triple Screen trading system.\n\n    Three successive filters before any entry:\n      Screen 1 — weekly EMA slope identifies dominant trend direction.\n      Screen 2 — stochastic oscillator detects pullback within trend.\n      Screen 3 — breakout above/below prior candle's high/low triggers entry.\n    \"\"\"\n\n    def __init__(\n        self,\n        weekly_bars: int = 5,\n        trend_ema_period: int = 13,\n        stoch_k_period: int = 5,\n        stoch_d_period: int = 3,\n        stoch_oversold: float = 20.0,\n        stoch_overbought: float = 80.0,\n        stop_loss_pct: float = 0.02,\n        take_profit_pct: float = 0.04,\n        trailing_stop_pct: float = 0.05,\n    ):\n        self.weekly_bars = weekly_bars\n        self.trend_ema_period = trend_ema_period\n        self.stoch_k_period = stoch_k_period\n        self.stoch_d_period = stoch_d_period\n        self.stoch_oversold = stoch_oversold\n        self.stoch_overbought = stoch_overbought\n        self.stop_loss_pct = stop_loss_pct\n        self.take_profit_pct = take_profit_pct\n        self.trailing_stop_pct = trailing_stop_pct\n\n    @property\n    def _min_candles(self) -> int:\n        return (\n            self.weekly_bars * (self.trend_ema_period + 1)\n            + self.stoch_k_period\n            + self.stoch_d_period\n        )\n\n    def generate_signal(\n        self,\n        kline_data: List[Dict],\n        symbol: str,\n        timeframe: str,\n        current_price: float,\n    ) -> Optional[TradingSignal]:\n        if len(kline_data) < self._min_candles:\n            return None\n\n        df = pd.DataFrame(kline_data)\n\n        weekly_df = self._aggregate_weekly_bars(df)\n        trend = self._screen1_trend(weekly_df)\n        if trend is None:\n            return None\n\n        screen2_active = self._screen2_oscillator(df, trend)\n        if not screen2_active:\n            return None\n\n        screen3_active = self._screen3_trigger(kline_data, trend, current_price)\n        if not screen3_active:\n            return None\n\n        stoch_k, _ = self._stochastic(df)\n        confidence = self._confidence(stoch_k, trend)\n\n        if trend == \"UP\":\n            decision = \"LONG\"\n            stop_loss = current_price * (1 - self.stop_loss_pct)\n            take_profit = current_price * (1 + self.take_profit_pct)\n        else:\n            decision = \"SHORT\"\n            stop_loss = current_price * (1 + self.stop_loss_pct)\n            take_profit = current_price * (1 - self.take_profit_pct)\n\n        reasoning = (\n            f\"Screen 1: trend={trend} (EMA slope on {self.weekly_bars}-bar aggregates); \"\n            f\"Screen 2: stoch_k={stoch_k:.1f} ({'oversold' if trend == 'UP' else 'overbought'}); \"\n            f\"Screen 3: breakout {'above prior high' if trend == 'UP' else 'below prior low'}\"\n        )\n\n        return TradingSignal(\n            decision=decision,\n            confidence=confidence,\n            entry_price=current_price,\n            stop_loss=stop_loss,\n            take_profit=take_profit,\n            reasoning=reasoning,\n            exit_policy=ExitPolicy.TRAILING_STOP,\n            trailing_stop_pct=self.trailing_stop_pct,\n        )\n\n    def should_reevaluate(self, position: ActivePosition, current_price: float) -> bool:\n        return False\n\n    def get_default_exit_policy(self) -> ExitPolicy:\n        return ExitPolicy.TRAILING_STOP\n\n    # ------------------------------------------------------------------\n    # Private helpers\n    # ------------------------------------------------------------------\n\n    def _aggregate_weekly_bars(self, df: pd.DataFrame) -> pd.DataFrame:\n        \"\"\"Reshape kline_data into synthetic higher-TF bars of `weekly_bars` candles.\"\"\"\n        n = len(df)\n        complete = (n // self.weekly_bars) * self.weekly_bars\n        trimmed = df.iloc[:complete].copy()\n\n        groups = []\n        for start in range(0, complete, self.weekly_bars):\n            block = trimmed.iloc[start : start + self.weekly_bars]\n            groups.append(\n                {\n                    \"open\": block[\"open\"].iloc[0],\n                    \"high\": block[\"high\"].max(),\n                    \"low\": block[\"low\"].min(),\n                    \"close\": block[\"close\"].iloc[-1],\n                    \"volume\": block[\"volume\"].sum(),\n                }\n            )\n        return pd.DataFrame(groups)\n\n    def _ema(self, series: pd.Series, period: int) -> pd.Series:\n        \"\"\"Exponential moving average with alpha = 2/(period+1).\"\"\"\n        return series.ewm(span=period, adjust=False).mean()\n\n    def _stochastic(self, df: pd.DataFrame) -> Tuple[float, float]:\n        \"\"\"Compute last completed Stochastic %K and %D values.\"\"\"\n        lowest_low = df[\"low\"].rolling(window=self.stoch_k_period, min_periods=self.stoch_k_period).min()\n        highest_high = df[\"high\"].rolling(window=self.stoch_k_period, min_periods=self.stoch_k_period).max()\n        pct_k = 100.0 * (df[\"close\"] - lowest_low) / (highest_high - lowest_low + _EPS)\n        pct_d = pct_k.rolling(window=self.stoch_d_period, min_periods=self.stoch_d_period).mean()\n        return float(pct_k.iloc[-1]), float(pct_d.iloc[-1])\n\n    def _screen1_trend(self, weekly_df: pd.DataFrame) -> Optional[str]:\n        \"\"\"Return 'UP', 'DOWN', or None when insufficient bars.\"\"\"\n        if len(weekly_df) < self.trend_ema_period + 1:\n            return None\n        ema = self._ema(weekly_df[\"close\"], self.trend_ema_period)\n        slope = float(ema.iloc[-1]) - float(ema.iloc[-2])\n        return \"UP\" if slope > 0 else \"DOWN\"\n\n    def _screen2_oscillator(self, df: pd.DataFrame, trend: str) -> bool:\n        \"\"\"Return True when stochastic confirms a pullback within the trend.\"\"\"\n        stoch_k, _ = self._stochastic(df)\n        if trend == \"UP\":\n            return stoch_k <= self.stoch_oversold\n        else:\n            return stoch_k >= self.stoch_overbought\n\n    def _screen3_trigger(self, kline_data: List[Dict], trend: str, current_price: float) -> bool:\n        \"\"\"Return True when price breaks out of the prior completed candle.\"\"\"\n        if len(kline_data) < 2:\n            return False\n        prior = kline_data[-2]\n        if trend == \"UP\":\n            return current_price > float(prior[\"high\"])\n        else:\n            return current_price < float(prior[\"low\"])\n\n    def _confidence(self, stoch_k: float, trend: str) -> float:\n        \"\"\"Map stochastic depth to a [0.1, 1.0] confidence score.\"\"\"\n        if trend == \"UP\":\n            raw = (self.stoch_oversold - stoch_k) / (self.stoch_oversold + _EPS)\n        else:\n            raw = (stoch_k - self.stoch_overbought) / (100.0 - self.stoch_overbought + _EPS)\n        return max(0.1, min(1.0, raw))\n","numLines":182,"startLine":1,"totalLines":182}}}
