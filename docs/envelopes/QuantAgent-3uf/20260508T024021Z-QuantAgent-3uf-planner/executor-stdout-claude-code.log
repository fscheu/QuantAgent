{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_016Tr4fE4WSo5enNXMnAktDE","type":"tool_result","content":"1\t\"\"\"SQLAlchemy models for QuantAgent trading system.\"\"\"\n2\t\n3\timport enum\n4\tfrom datetime import datetime\n5\t\n6\tfrom sqlalchemy import JSON, Boolean, Column, DateTime, Enum, Float, ForeignKey, Index, Integer, Numeric, String, Text\n7\tfrom sqlalchemy.orm import relationship\n8\t\n9\tfrom .database import Base\n10\t\n11\t\n12\tclass OrderStatus(str, enum.Enum):\n13\t    \"\"\"Enum for order statuses.\"\"\"\n14\t\n15\t    PENDING = \"pending\"\n16\t    FILLED = \"filled\"\n17\t    PARTIALLY_FILLED = \"partially_filled\"\n18\t    CANCELLED = \"cancelled\"\n19\t    REJECTED = \"rejected\"\n20\t\n21\t\n22\tclass OrderSide(str, enum.Enum):\n23\t    \"\"\"Enum for order side (buy/sell).\"\"\"\n24\t\n25\t    BUY = \"buy\"\n26\t    SELL = \"sell\"\n27\t\n28\t\n29\tclass OrderType(str, enum.Enum):\n30\t    \"\"\"Enum for order types.\"\"\"\n31\t\n32\t    MARKET = \"market\"\n33\t    LIMIT = \"limit\"\n34\t    STOP = \"stop\"\n35\t    STOP_LIMIT = \"stop_limit\"\n36\t\n37\t\n38\tclass TradeSignal(str, enum.Enum):\n39\t    \"\"\"Enum for trading signals.\"\"\"\n40\t\n41\t    LONG = \"long\"\n42\t    SHORT = \"short\"\n43\t    NEUTRAL = \"neutral\"\n44\t    CLOSE = \"close\"\n45\t\n46\t\n47\tclass Environment(str, enum.Enum):\n48\t    \"\"\"Enum for execution environments.\"\"\"\n49\t\n50\t    BACKTEST = \"backtest\"\n51\t    PAPER = \"paper\"\n52\t    PROD = \"prod\"\n53\t\n54\t\n55\tclass ExitPolicy(str, enum.Enum):\n56\t    \"\"\"Enum for position exit policies.\"\"\"\n57\t\n58\t    SL_TP_ONLY = \"sl_tp_only\"\n59\t    TIME_BASED = \"time_based\"\n60\t    REEVALUATE = \"reevaluate\"\n61\t    TRAILING_STOP = \"trailing_stop\"\n62\t\n63\t\n64\tclass Order(Base):\n65\t    \"\"\"Order model for placing and tracking trading orders.\"\"\"\n66\t\n67\t    __tablename__ = \"orders\"\n68\t\n69\t    id = Column(Integer, primary_key=True, index=True)\n70\t    symbol = Column(String(20), nullable=False, index=True)\n71\t    side = Column(Enum(OrderSide), nullable=False)\n72\t    order_type = Column(Enum(OrderType), nullable=False)\n73\t    quantity = Column(Numeric(precision=18, scale=8), nullable=False)\n74\t    price = Column(Numeric(precision=18, scale=8), nullable=True)\n75\t    stop_price = Column(Numeric(precision=18, scale=8), nullable=True)\n76\t    status = Column(Enum(OrderStatus), nullable=False, default=OrderStatus.PENDING)\n77\t    created_at = Column(DateTime, nullable=False, default=datetime.utcnow, index=True)\n78\t    updated_at = Column(\n79\t        DateTime, nullable=False, default=datetime.utcnow, onupdate=datetime.utcnow\n80\t    )\n81\t    filled_at = Column(DateTime, nullable=True, index=True)\n82\t    filled_quantity = Column(Numeric(precision=18, scale=8), nullable=False, default=0)\n83\t    average_fill_price = Column(Numeric(precision=18, scale=8), nullable=True)\n84\t    comment = Column(Text, nullable=True)\n85\t\n86\t    # Environment & Provenance (NEW)\n87\t    environment = Column(\n88\t        Enum(Environment), nullable=False, default=Environment.PAPER, index=True\n89\t    )\n90\t    trigger_signal_id = Column(Integer, ForeignKey(\"signals.id\"), nullable=True)\n91\t\n92\t    # Relationships\n93\t    fills = relationship(\"Fill\", back_populates=\"order\", cascade=\"all, delete-orphan\")\n94\t    trades = relationship(\"Trade\", back_populates=\"order\", cascade=\"all, delete-orphan\")\n95\t    trigger_signal = relationship(\n96\t        \"Signal\", foreign_keys=[trigger_signal_id], back_populates=\"triggered_orders\"\n97\t    )\n98\t\n99\t    __table_args__ = (\n100\t        Index(\"idx_symbol_created_at\", \"symbol\", \"created_at\"),\n101\t        Index(\"idx_status_symbol\", \"status\", \"symbol\"),\n102\t        Index(\"idx_orders_environment\", \"environment\"),\n103\t    )\n104\t\n105\t\n106\tclass Fill(Base):\n107\t    \"\"\"Fill model for partial/full order executions.\"\"\"\n108\t\n109\t    __tablename__ = \"fills\"\n110\t\n111\t    id = Column(Integer, primary_key=True, index=True)\n112\t    order_id = Column(Integer, ForeignKey(\"orders.id\"), nullable=False, index=True)\n113\t    quantity = Column(Numeric(precision=18, scale=8), nullable=False)\n114\t    price = Column(Numeric(precision=18, scale=8), nullable=False)\n115\t    commission = Column(Numeric(precision=18, scale=8), nullable=False, default=0)\n116\t    filled_at = Column(DateTime, nullable=False, default=datetime.utcnow, index=True)\n117\t\n118\t    # Relationships\n119\t    order = relationship(\"Order\", back_populates=\"fills\")\n120\t\n121\t    __table_args__ = (Index(\"idx_order_filled_at\", \"order_id\", \"filled_at\"),)\n122\t\n123\t\n124\tclass Position(Base):\n125\t    \"\"\"Position model for tracking open positions.\"\"\"\n126\t\n127\t    __tablename__ = \"positions\"\n128\t\n129\t    id = Column(Integer, primary_key=True, index=True)\n130\t    symbol = Column(String(20), nullable=False, unique=True, index=True)\n131\t    quantity = Column(Numeric(precision=18, scale=8), nullable=False)\n132\t    average_entry_price = Column(Numeric(precision=18, scale=8), nullable=False)\n133\t    current_price = Column(Numeric(precision=18, scale=8), nullable=False)\n134\t    unrealized_pnl = Column(Numeric(precision=18, scale=8), nullable=False)\n135\t    unrealized_pnl_pct = Column(Float, nullable=False)\n136\t    side = Column(Enum(OrderSide), nullable=False)\n137\t    opened_at = Column(DateTime, nullable=False, default=datetime.utcnow, index=True)\n138\t    updated_at = Column(\n139\t        DateTime, nullable=False, default=datetime.utcnow, onupdate=datetime.utcnow\n140\t    )\n141\t\n142\t\n143\tclass Signal(Base):\n144\t    \"\"\"Signal model for tracking trading signals from agents.\"\"\"\n145\t\n146\t    __tablename__ = \"signals\"\n147\t\n148\t    id = Column(Integer, primary_key=True, index=True)\n149\t    symbol = Column(String(20), nullable=False, index=True)\n150\t    signal = Column(Enum(TradeSignal), nullable=False)\n151\t    confidence = Column(Float, nullable=False)  # 0-1 scale\n152\t    timeframe = Column(String(10), nullable=False)  # 1m, 5m, 15m, 1h, 4h, 1d, etc.\n153\t\n154\t    # Agent analysis details\n155\t    rsi = Column(Float, nullable=True)\n156\t    macd = Column(Float, nullable=True)\n157\t    stochastic = Column(Float, nullable=True)\n158\t    roc = Column(Float, nullable=True)\n159\t    williams_r = Column(Float, nullable=True)\n160\t    pattern = Column(String(100), nullable=True)\n161\t    trend = Column(String(50), nullable=True)\n162\t\n163\t    # Analysis report\n164\t    analysis_summary = Column(Text, nullable=True)\n165\t    generated_at = Column(DateTime, nullable=False, default=datetime.utcnow, index=True)\n166\t\n167\t    # Environment & Provenance (NEW)\n168\t    environment = Column(\n169\t        Enum(Environment), nullable=False, default=Environment.PAPER, index=True\n170\t    )\n171\t    order_id = Column(Integer, ForeignKey(\"orders.id\"), nullable=True)\n172\t\n173\t    # Checkpoint & Metadata (NEW)\n174\t    thread_id = Column(String(100), nullable=True)\n175\t    checkpoint_id = Column(String(100), nullable=True)\n176\t    state_snapshot = Column(JSON, nullable=True)\n177\t\n178\t    # Model metadata\n179\t    model_provider = Column(String(50), nullable=True)  # \"openai\", \"anthropic\", \"qwen\"\n180\t    model_name = Column(String(100), nullable=True)  # \"gpt-4o\", \"claude-3-opus\", etc.\n181\t    temperature = Column(Float, nullable=True)  # Model temperature used\n182\t    agent_version = Column(String(50), nullable=True)\n183\t    graph_version = Column(String(50), nullable=True)\n184\t\n185\t    # Relationships\n186\t    triggered_orders = relationship(\n187\t        \"Order\", foreign_keys=\"Order.trigger_signal_id\", back_populates=\"trigger_signal\"\n188\t    )\n189\t\n190\t    __table_args__ = (\n191\t        Index(\"idx_symbol_generated_at\", \"symbol\", \"generated_at\"),\n192\t        Index(\"idx_symbol_signal\", \"symbol\", \"signal\"),\n193\t        Index(\"idx_signals_environment\", \"environment\"),\n194\t        Index(\"idx_signals_thread_id\", \"thread_id\"),\n195\t    )\n196\t\n197\t\n198\tclass Trade(Base):\n199\t    \"\"\"Trade model for tracking completed trades.\"\"\"\n200\t\n201\t    __tablename__ = \"trades\"\n202\t\n203\t    id = Column(Integer, primary_key=True, index=True)\n204\t    symbol = Column(String(20), nullable=False, index=True)\n205\t    order_id = Column(Integer, ForeignKey(\"orders.id\"), nullable=True)\n206\t    entry_price = Column(Numeric(precision=18, scale=8), nullable=False)\n207\t    exit_price = Column(Numeric(precision=18, scale=8), nullable=True)\n208\t    quantity = Column(Numeric(precision=18, scale=8), nullable=False)\n209\t    side = Column(Enum(OrderSide), nullable=False)\n210\t    pnl = Column(Numeric(precision=18, scale=8), nullable=True)\n211\t    pnl_pct = Column(Float, nullable=True)\n212\t    commission = Column(Numeric(precision=18, scale=8), nullable=False, default=0)\n213\t\n214\t    entry_signal = Column(String(50), nullable=True)\n215\t    exit_signal = Column(String(50), nullable=True)\n216\t    timeframe = Column(String(10), nullable=True)\n217\t\n218\t    opened_at = Column(DateTime, nullable=False, default=datetime.utcnow, index=True)\n219\t    closed_at = Column(DateTime, nullable=True)\n220\t\n221\t    notes = Column(Text, nullable=True)\n222\t\n223\t    # Environment (NEW)\n224\t    environment = Column(\n225\t        Enum(Environment), nullable=False, default=Environment.PAPER, index=True\n226\t    )\n227\t\n228\t    # Relationships\n229\t    order = relationship(\"Order\", back_populates=\"trades\")\n230\t\n231\t    __table_args__ = (\n232\t        Index(\"idx_symbol_opened_at\", \"symbol\", \"opened_at\"),\n233\t        Index(\"idx_symbol_closed_at\", \"symbol\", \"closed_at\"),\n234\t        Index(\"idx_trades_environment\", \"environment\"),\n235\t    )\n236\t\n237\t\n238\tclass MarketData(Base):\n239\t    \"\"\"MarketData model for storing historical OHLCV data.\"\"\"\n240\t\n241\t    __tablename__ = \"market_data\"\n242\t\n243\t    id = Column(Integer, primary_key=True, index=True)\n244\t    symbol = Column(String(20), nullable=False, index=True)\n245\t    timeframe = Column(String(10), nullable=False)  # 1m, 5m, 15m, 1h, 4h, 1d, etc.\n246\t    timestamp = Column(DateTime, nullable=False, index=True)\n247\t\n248\t    open = Column(Numeric(precision=18, scale=8), nullable=False)\n249\t    high = Column(Numeric(precision=18, scale=8), nullable=False)\n250\t    low = Column(Numeric(precision=18, scale=8), nullable=False)\n251\t    close = Column(Numeric(precision=18, scale=8), nullable=False)\n252\t    volume = Column(Numeric(precision=20, scale=8), nullable=False)\n253\t\n254\t    created_at = Column(DateTime, nullable=False, default=datetime.utcnow)\n255\t\n256\t    __table_args__ = (\n257\t        Index(\"idx_symbol_timeframe_timestamp\", \"symbol\", \"timeframe\", \"timestamp\"),\n258\t        Index(\"idx_timestamp\", \"timestamp\"),\n259\t    )\n260\t\n261\t\n262\tclass StrategyConfig(Base):\n263\t    \"\"\"StrategyConfig model for persisting portfolio and risk management profiles.\"\"\"\n264\t\n265\t    __tablename__ = \"strategy_configs\"\n266\t\n267\t    id = Column(Integer, primary_key=True, index=True)\n268\t    name = Column(String(100), nullable=False, unique=True, index=True)\n269\t    kind = Column(String(20), nullable=False)  # \"portfolio\", \"risk\", \"combined\"\n270\t    json_config = Column(JSON, nullable=False)  # Persisted configuration dict\n271\t    version = Column(Integer, nullable=False, default=1)\n272\t    created_at = Column(DateTime, nullable=False, default=datetime.utcnow, index=True)\n273\t    updated_at = Column(\n274\t        DateTime, nullable=False, default=datetime.utcnow, onupdate=datetime.utcnow\n275\t    )\n276\t\n277\t    __table_args__ = (Index(\"idx_name_kind\", \"name\", \"kind\"),)\n278\t\n279\t\n280\tclass BacktestRun(Base):\n281\t    \"\"\"BacktestRun model for recording backtest executions and configurations.\"\"\"\n282\t\n283\t    __tablename__ = \"backtest_runs\"\n284\t\n285\t    id = Column(Integer, primary_key=True, index=True)\n286\t    name = Column(String(200), nullable=True)\n287\t    timeframe = Column(String(10), nullable=False)  # \"1h\", \"4h\", \"1d\", etc.\n288\t    assets = Column(JSON, nullable=False)  # List of symbols, e.g., [\"BTC\", \"SPX\", \"CL\"]\n289\t    start_date = Column(DateTime, nullable=False, index=True)\n290\t    end_date = Column(DateTime, nullable=False, index=True)\n291\t    data_source = Column(\n292\t        String(200), nullable=True\n293\t    )  # Optional source/hash for reproducibility\n294\t    config_snapshot = Column(JSON, nullable=False)  # Immutable config at run time\n295\t    created_at = Column(DateTime, nullable=False, default=datetime.utcnow, index=True)\n296\t\n297\t    # Result metrics (nullable until run completes)\n298\t    total_trades = Column(Integer, nullable=True)\n299\t    win_rate = Column(Float, nullable=True)\n300\t    profit_factor = Column(Float, nullable=True)\n301\t    sharpe_ratio = Column(Float, nullable=True)\n302\t    max_drawdown = Column(Float, nullable=True)\n303\t    total_pnl = Column(Numeric(precision=18, scale=8), nullable=True)\n304\t\n305\t    __table_args__ = (Index(\"idx_start_end_date\", \"start_date\", \"end_date\"),)\n306\t\n307\t    # Relationships\n308\t    active_positions = relationship(\"ActivePosition\", back_populates=\"backtest_run\")\n309\t\n310\t\n311\tclass ActivePosition(Base):\n312\t    \"\"\"ActivePosition model for tracking active positions with stop-loss and take-profit.\"\"\"\n313\t\n314\t    __tablename__ = \"active_positions\"\n315\t\n316\t    id = Column(Integer, primary_key=True, index=True)\n317\t    symbol = Column(String(20), nullable=False, index=True)\n318\t    side = Column(Enum(OrderSide), nullable=False)\n319\t\n320\t    entry_price = Column(Numeric(precision=18, scale=8), nullable=False)\n321\t    stop_loss = Column(Numeric(precision=18, scale=8), nullable=False)\n322\t    take_profit = Column(Numeric(precision=18, scale=8), nullable=False)\n323\t    quantity = Column(Numeric(precision=18, scale=8), nullable=False)\n324\t\n325\t    decision_timestamp = Column(DateTime, nullable=False, index=True)\n326\t    candles_since_entry = Column(Integer, nullable=False, default=0)\n327\t\n328\t    exit_policy = Column(Enum(ExitPolicy), nullable=False)\n329\t    max_hold_candles = Column(Integer, nullable=True)\n330\t\n331\t    prediction_horizon = Column(Integer, nullable=False, default=3)\n332\t    candles_direction = Column(JSON, nullable=False, default=list)\n333\t\n334\t    trailing_stop_pct = Column(Float, nullable=True)\n335\t    highest_price_seen = Column(Numeric(precision=18, scale=8), nullable=True)\n336\t    lowest_price_seen = Column(Numeric(precision=18, scale=8), nullable=True)\n337\t\n338\t    trade_id = Column(Integer, ForeignKey(\"trades.id\"), nullable=True)\n339\t    signal_id = Column(Integer, ForeignKey(\"signals.id\"), nullable=True)\n340\t    backtest_run_id = Column(Integer, ForeignKey(\"backtest_runs.id\"), nullable=True, index=True)\n341\t\n342\t    is_active = Column(Boolean, nullable=False, default=True, index=True)\n343\t    closed_at = Column(DateTime, nullable=True)\n344\t    close_reason = Column(String(50), nullable=True)\n345\t    accuracy = Column(Float, nullable=True)\n346\t\n347\t    environment = Column(\n348\t        Enum(Environment), nullable=False, default=Environment.BACKTEST, index=True\n349\t    )\n350\t    backtest_run = relationship(\"BacktestRun\", back_populates=\"active_positions\")\n351\t\n352\t    __table_args__ = (\n353\t        Index(\"idx_active_position_isolation\", \"symbol\", \"is_active\", \"backtest_run_id\", \"environment\"),\n354\t    )\n355\t\n356\t\n357\tclass Log(Base):\n358\t    \"\"\"System event logs for debugging, audit trail, and monitoring.\"\"\"\n359\t\n360\t    __tablename__ = \"logs\"\n361\t\n362\t    id = Column(Integer, primary_key=True)\n363\t    timestamp = Column(DateTime, nullable=False, default=datetime.utcnow, index=True)\n364\t    level = Column(String(10), nullable=False, index=True)\n365\t    module = Column(String(100), nullable=False)\n366\t    message = Column(Text, nullable=False)\n367\t    environment = Column(String(20), index=True)\n368\t    symbol = Column(String(20), index=True)\n369\t    event_type = Column(String(50), index=True)\n370\t    extra_data = Column(JSON)\n371\t    thread_id = Column(String(100), index=True)\n372\t    checkpoint_id = Column(String(100))\n373\t\n374\t\n375\tclass SchedulerHeartbeat(Base):\n376\t    \"\"\"Track TradingScheduler execution cycles for monitoring.\"\"\"\n377\t\n378\t    __tablename__ = \"scheduler_heartbeats\"\n379\t\n380\t    id = Column(Integer, primary_key=True, autoincrement=True)\n381\t    timestamp = Column(DateTime, nullable=False, index=True)\n382\t    completed_at = Column(DateTime, nullable=True)\n383\t    status = Column(String(20), nullable=False)  # running, completed, error\n384\t    environment = Column(Enum(Environment), nullable=False, index=True)\n385\t    assets = Column(JSON, nullable=True)  # List of symbols processed\n386\t    stats = Column(JSON, nullable=True)  # {processed, errors, duration_seconds, total}\n387\t    last_trade_id = Column(Integer, ForeignKey(\"trades.id\"), nullable=True)\n388\t    error_message = Column(Text, nullable=True)\n389\t\n390\t    __table_args__ = (Index(\"idx_heartbeat_env_ts\", \"environment\", \"timestamp\"),)\n391\t"}]},"parent_tool_use_id":null,"session_id":"3c1eaaa5-4630-4080-9c30-fa243b2053bf","uuid":"f115d4c6-a5ee-4572-bf5d-37848a9aa1b0","timestamp":"2026-05-08T02:40:49.612Z","tool_use_result":{"type":"text","file":{"filePath":"/home/azureuser/repos/projects/QuantAgent/quantagent/models.py","content":"\"\"\"SQLAlchemy models for QuantAgent trading system.\"\"\"\n\nimport enum\nfrom datetime import datetime\n\nfrom sqlalchemy import JSON, Boolean, Column, DateTime, Enum, Float, ForeignKey, Index, Integer, Numeric, String, Text\nfrom sqlalchemy.orm import relationship\n\nfrom .database import Base\n\n\nclass OrderStatus(str, enum.Enum):\n    \"\"\"Enum for order statuses.\"\"\"\n\n    PENDING = \"pending\"\n    FILLED = \"filled\"\n    PARTIALLY_FILLED = \"partially_filled\"\n    CANCELLED = \"cancelled\"\n    REJECTED = \"rejected\"\n\n\nclass OrderSide(str, enum.Enum):\n    \"\"\"Enum for order side (buy/sell).\"\"\"\n\n    BUY = \"buy\"\n    SELL = \"sell\"\n\n\nclass OrderType(str, enum.Enum):\n    \"\"\"Enum for order types.\"\"\"\n\n    MARKET = \"market\"\n    LIMIT = \"limit\"\n    STOP = \"stop\"\n    STOP_LIMIT = \"stop_limit\"\n\n\nclass TradeSignal(str, enum.Enum):\n    \"\"\"Enum for trading signals.\"\"\"\n\n    LONG = \"long\"\n    SHORT = \"short\"\n    NEUTRAL = \"neutral\"\n    CLOSE = \"close\"\n\n\nclass Environment(str, enum.Enum):\n    \"\"\"Enum for execution environments.\"\"\"\n\n    BACKTEST = \"backtest\"\n    PAPER = \"paper\"\n    PROD = \"prod\"\n\n\nclass ExitPolicy(str, enum.Enum):\n    \"\"\"Enum for position exit policies.\"\"\"\n\n    SL_TP_ONLY = \"sl_tp_only\"\n    TIME_BASED = \"time_based\"\n    REEVALUATE = \"reevaluate\"\n    TRAILING_STOP = \"trailing_stop\"\n\n\nclass Order(Base):\n    \"\"\"Order model for placing and tracking trading orders.\"\"\"\n\n    __tablename__ = \"orders\"\n\n    id = Column(Integer, primary_key=True, index=True)\n    symbol = Column(String(20), nullable=False, index=True)\n    side = Column(Enum(OrderSide), nullable=False)\n    order_type = Column(Enum(OrderType), nullable=False)\n    quantity = Column(Numeric(precision=18, scale=8), nullable=False)\n    price = Column(Numeric(precision=18, scale=8), nullable=True)\n    stop_price = Column(Numeric(precision=18, scale=8), nullable=True)\n    status = Column(Enum(OrderStatus), nullable=False, default=OrderStatus.PENDING)\n    created_at = Column(DateTime, nullable=False, default=datetime.utcnow, index=True)\n    updated_at = Column(\n        DateTime, nullable=False, default=datetime.utcnow, onupdate=datetime.utcnow\n    )\n    filled_at = Column(DateTime, nullable=True, index=True)\n    filled_quantity = Column(Numeric(precision=18, scale=8), nullable=False, default=0)\n    average_fill_price = Column(Numeric(precision=18, scale=8), nullable=True)\n    comment = Column(Text, nullable=True)\n\n    # Environment & Provenance (NEW)\n    environment = Column(\n        Enum(Environment), nullable=False, default=Environment.PAPER, index=True\n    )\n    trigger_signal_id = Column(Integer, ForeignKey(\"signals.id\"), nullable=True)\n\n    # Relationships\n    fills = relationship(\"Fill\", back_populates=\"order\", cascade=\"all, delete-orphan\")\n    trades = relationship(\"Trade\", back_populates=\"order\", cascade=\"all, delete-orphan\")\n    trigger_signal = relationship(\n        \"Signal\", foreign_keys=[trigger_signal_id], back_populates=\"triggered_orders\"\n    )\n\n    __table_args__ = (\n        Index(\"idx_symbol_created_at\", \"symbol\", \"created_at\"),\n        Index(\"idx_status_symbol\", \"status\", \"symbol\"),\n        Index(\"idx_orders_environment\", \"environment\"),\n    )\n\n\nclass Fill(Base):\n    \"\"\"Fill model for partial/full order executions.\"\"\"\n\n    __tablename__ = \"fills\"\n\n    id = Column(Integer, primary_key=True, index=True)\n    order_id = Column(Integer, ForeignKey(\"orders.id\"), nullable=False, index=True)\n    quantity = Column(Numeric(precision=18, scale=8), nullable=False)\n    price = Column(Numeric(precision=18, scale=8), nullable=False)\n    commission = Column(Numeric(precision=18, scale=8), nullable=False, default=0)\n    filled_at = Column(DateTime, nullable=False, default=datetime.utcnow, index=True)\n\n    # Relationships\n    order = relationship(\"Order\", back_populates=\"fills\")\n\n    __table_args__ = (Index(\"idx_order_filled_at\", \"order_id\", \"filled_at\"),)\n\n\nclass Position(Base):\n    \"\"\"Position model for tracking open positions.\"\"\"\n\n    __tablename__ = \"positions\"\n\n    id = Column(Integer, primary_key=True, index=True)\n    symbol = Column(String(20), nullable=False, unique=True, index=True)\n    quantity = Column(Numeric(precision=18, scale=8), nullable=False)\n    average_entry_price = Column(Numeric(precision=18, scale=8), nullable=False)\n    current_price = Column(Numeric(precision=18, scale=8), nullable=False)\n    unrealized_pnl = Column(Numeric(precision=18, scale=8), nullable=False)\n    unrealized_pnl_pct = Column(Float, nullable=False)\n    side = Column(Enum(OrderSide), nullable=False)\n    opened_at = Column(DateTime, nullable=False, default=datetime.utcnow, index=True)\n    updated_at = Column(\n        DateTime, nullable=False, default=datetime.utcnow, onupdate=datetime.utcnow\n    )\n\n\nclass Signal(Base):\n    \"\"\"Signal model for tracking trading signals from agents.\"\"\"\n\n    __tablename__ = \"signals\"\n\n    id = Column(Integer, primary_key=True, index=True)\n    symbol = Column(String(20), nullable=False, index=True)\n    signal = Column(Enum(TradeSignal), nullable=False)\n    confidence = Column(Float, nullable=False)  # 0-1 scale\n    timeframe = Column(String(10), nullable=False)  # 1m, 5m, 15m, 1h, 4h, 1d, etc.\n\n    # Agent analysis details\n    rsi = Column(Float, nullable=True)\n    macd = Column(Float, nullable=True)\n    stochastic = Column(Float, nullable=True)\n    roc = Column(Float, nullable=True)\n    williams_r = Column(Float, nullable=True)\n    pattern = Column(String(100), nullable=True)\n    trend = Column(String(50), nullable=True)\n\n    # Analysis report\n    analysis_summary = Column(Text, nullable=True)\n    generated_at = Column(DateTime, nullable=False, default=datetime.utcnow, index=True)\n\n    # Environment & Provenance (NEW)\n    environment = Column(\n        Enum(Environment), nullable=False, default=Environment.PAPER, index=True\n    )\n    order_id = Column(Integer, ForeignKey(\"orders.id\"), nullable=True)\n\n    # Checkpoint & Metadata (NEW)\n    thread_id = Column(String(100), nullable=True)\n    checkpoint_id = Column(String(100), nullable=True)\n    state_snapshot = Column(JSON, nullable=True)\n\n    # Model metadata\n    model_provider = Column(String(50), nullable=True)  # \"openai\", \"anthropic\", \"qwen\"\n    model_name = Column(String(100), nullable=True)  # \"gpt-4o\", \"claude-3-opus\", etc.\n    temperature = Column(Float, nullable=True)  # Model temperature used\n    agent_version = Column(String(50), nullable=True)\n    graph_version = Column(String(50), nullable=True)\n\n    # Relationships\n    triggered_orders = relationship(\n        \"Order\", foreign_keys=\"Order.trigger_signal_id\", back_populates=\"trigger_signal\"\n    )\n\n    __table_args__ = (\n        Index(\"idx_symbol_generated_at\", \"symbol\", \"generated_at\"),\n        Index(\"idx_symbol_signal\", \"symbol\", \"signal\"),\n        Index(\"idx_signals_environment\", \"environment\"),\n        Index(\"idx_signals_thread_id\", \"thread_id\"),\n    )\n\n\nclass Trade(Base):\n    \"\"\"Trade model for tracking completed trades.\"\"\"\n\n    __tablename__ = \"trades\"\n\n    id = Column(Integer, primary_key=True, index=True)\n    symbol = Column(String(20), nullable=False, index=True)\n    order_id = Column(Integer, ForeignKey(\"orders.id\"), nullable=True)\n    entry_price = Column(Numeric(precision=18, scale=8), nullable=False)\n    exit_price = Column(Numeric(precision=18, scale=8), nullable=True)\n    quantity = Column(Numeric(precision=18, scale=8), nullable=False)\n    side = Column(Enum(OrderSide), nullable=False)\n    pnl = Column(Numeric(precision=18, scale=8), nullable=True)\n    pnl_pct = Column(Float, nullable=True)\n    commission = Column(Numeric(precision=18, scale=8), nullable=False, default=0)\n\n    entry_signal = Column(String(50), nullable=True)\n    exit_signal = Column(String(50), nullable=True)\n    timeframe = Column(String(10), nullable=True)\n\n    opened_at = Column(DateTime, nullable=False, default=datetime.utcnow, index=True)\n    closed_at = Column(DateTime, nullable=True)\n\n    notes = Column(Text, nullable=True)\n\n    # Environment (NEW)\n    environment = Column(\n        Enum(Environment), nullable=False, default=Environment.PAPER, index=True\n    )\n\n    # Relationships\n    order = relationship(\"Order\", back_populates=\"trades\")\n\n    __table_args__ = (\n        Index(\"idx_symbol_opened_at\", \"symbol\", \"opened_at\"),\n        Index(\"idx_symbol_closed_at\", \"symbol\", \"closed_at\"),\n        Index(\"idx_trades_environment\", \"environment\"),\n    )\n\n\nclass MarketData(Base):\n    \"\"\"MarketData model for storing historical OHLCV data.\"\"\"\n\n    __tablename__ = \"market_data\"\n\n    id = Column(Integer, primary_key=True, index=True)\n    symbol = Column(String(20), nullable=False, index=True)\n    timeframe = Column(String(10), nullable=False)  # 1m, 5m, 15m, 1h, 4h, 1d, etc.\n    timestamp = Column(DateTime, nullable=False, index=True)\n\n    open = Column(Numeric(precision=18, scale=8), nullable=False)\n    high = Column(Numeric(precision=18, scale=8), nullable=False)\n    low = Column(Numeric(precision=18, scale=8), nullable=False)\n    close = Column(Numeric(precision=18, scale=8), nullable=False)\n    volume = Column(Numeric(precision=20, scale=8), nullable=False)\n\n    created_at = Column(DateTime, nullable=False, default=datetime.utcnow)\n\n    __table_args__ = (\n        Index(\"idx_symbol_timeframe_timestamp\", \"symbol\", \"timeframe\", \"timestamp\"),\n        Index(\"idx_timestamp\", \"timestamp\"),\n    )\n\n\nclass StrategyConfig(Base):\n    \"\"\"StrategyConfig model for persisting portfolio and risk management profiles.\"\"\"\n\n    __tablename__ = \"strategy_configs\"\n\n    id = Column(Integer, primary_key=True, index=True)\n    name = Column(String(100), nullable=False, unique=True, index=True)\n    kind = Column(String(20), nullable=False)  # \"portfolio\", \"risk\", \"combined\"\n    json_config = Column(JSON, nullable=False)  # Persisted configuration dict\n    version = Column(Integer, nullable=False, default=1)\n    created_at = Column(DateTime, nullable=False, default=datetime.utcnow, index=True)\n    updated_at = Column(\n        DateTime, nullable=False, default=datetime.utcnow, onupdate=datetime.utcnow\n    )\n\n    __table_args__ = (Index(\"idx_name_kind\", \"name\", \"kind\"),)\n\n\nclass BacktestRun(Base):\n    \"\"\"BacktestRun model for recording backtest executions and configurations.\"\"\"\n\n    __tablename__ = \"backtest_runs\"\n\n    id = Column(Integer, primary_key=True, index=True)\n    name = Column(String(200), nullable=True)\n    timeframe = Column(String(10), nullable=False)  # \"1h\", \"4h\", \"1d\", etc.\n    assets = Column(JSON, nullable=False)  # List of symbols, e.g., [\"BTC\", \"SPX\", \"CL\"]\n    start_date = Column(DateTime, nullable=False, index=True)\n    end_date = Column(DateTime, nullable=False, index=True)\n    data_source = Column(\n        String(200), nullable=True\n    )  # Optional source/hash for reproducibility\n    config_snapshot = Column(JSON, nullable=False)  # Immutable config at run time\n    created_at = Column(DateTime, nullable=False, default=datetime.utcnow, index=True)\n\n    # Result metrics (nullable until run completes)\n    total_trades = Column(Integer, nullable=True)\n    win_rate = Column(Float, nullable=True)\n    profit_factor = Column(Float, nullable=True)\n    sharpe_ratio = Column(Float, nullable=True)\n    max_drawdown = Column(Float, nullable=True)\n    total_pnl = Column(Numeric(precision=18, scale=8), nullable=True)\n\n    __table_args__ = (Index(\"idx_start_end_date\", \"start_date\", \"end_date\"),)\n\n    # Relationships\n    active_positions = relationship(\"ActivePosition\", back_populates=\"backtest_run\")\n\n\nclass ActivePosition(Base):\n    \"\"\"ActivePosition model for tracking active positions with stop-loss and take-profit.\"\"\"\n\n    __tablename__ = \"active_positions\"\n\n    id = Column(Integer, primary_key=True, index=True)\n    symbol = Column(String(20), nullable=False, index=True)\n    side = Column(Enum(OrderSide), nullable=False)\n\n    entry_price = Column(Numeric(precision=18, scale=8), nullable=False)\n    stop_loss = Column(Numeric(precision=18, scale=8), nullable=False)\n    take_profit = Column(Numeric(precision=18, scale=8), nullable=False)\n    quantity = Column(Numeric(precision=18, scale=8), nullable=False)\n\n    decision_timestamp = Column(DateTime, nullable=False, index=True)\n    candles_since_entry = Column(Integer, nullable=False, default=0)\n\n    exit_policy = Column(Enum(ExitPolicy), nullable=False)\n    max_hold_candles = Column(Integer, nullable=True)\n\n    prediction_horizon = Column(Integer, nullable=False, default=3)\n    candles_direction = Column(JSON, nullable=False, default=list)\n\n    trailing_stop_pct = Column(Float, nullable=True)\n    highest_price_seen = Column(Numeric(precision=18, scale=8), nullable=True)\n    lowest_price_seen = Column(Numeric(precision=18, scale=8), nullable=True)\n\n    trade_id = Column(Integer, ForeignKey(\"trades.id\"), nullable=True)\n    signal_id = Column(Integer, ForeignKey(\"signals.id\"), nullable=True)\n    backtest_run_id = Column(Integer, ForeignKey(\"backtest_runs.id\"), nullable=True, index=True)\n\n    is_active = Column(Boolean, nullable=False, default=True, index=True)\n    closed_at = Column(DateTime, nullable=True)\n    close_reason = Column(String(50), nullable=True)\n    accuracy = Column(Float, nullable=True)\n\n    environment = Column(\n        Enum(Environment), nullable=False, default=Environment.BACKTEST, index=True\n    )\n    backtest_run = relationship(\"BacktestRun\", back_populates=\"active_positions\")\n\n    __table_args__ = (\n        Index(\"idx_active_position_isolation\", \"symbol\", \"is_active\", \"backtest_run_id\", \"environment\"),\n    )\n\n\nclass Log(Base):\n    \"\"\"System event logs for debugging, audit trail, and monitoring.\"\"\"\n\n    __tablename__ = \"logs\"\n\n    id = Column(Integer, primary_key=True)\n    timestamp = Column(DateTime, nullable=False, default=datetime.utcnow, index=True)\n    level = Column(String(10), nullable=False, index=True)\n    module = Column(String(100), nullable=False)\n    message = Column(Text, nullable=False)\n    environment = Column(String(20), index=True)\n    symbol = Column(String(20), index=True)\n    event_type = Column(String(50), index=True)\n    extra_data = Column(JSON)\n    thread_id = Column(String(100), index=True)\n    checkpoint_id = Column(String(100))\n\n\nclass SchedulerHeartbeat(Base):\n    \"\"\"Track TradingScheduler execution cycles for monitoring.\"\"\"\n\n    __tablename__ = \"scheduler_heartbeats\"\n\n    id = Column(Integer, primary_key=True, autoincrement=True)\n    timestamp = Column(DateTime, nullable=False, index=True)\n    completed_at = Column(DateTime, nullable=True)\n    status = Column(String(20), nullable=False)  # running, completed, error\n    environment = Column(Enum(Environment), nullable=False, index=True)\n    assets = Column(JSON, nullable=True)  # List of symbols processed\n    stats = Column(JSON, nullable=True)  # {processed, errors, duration_seconds, total}\n    last_trade_id = Column(Integer, ForeignKey(\"trades.id\"), nullable=True)\n    error_message = Column(Text, nullable=True)\n\n    __table_args__ = (Index(\"idx_heartbeat_env_ts\", \"environment\", \"timestamp\"),)\n","numLines":391,"startLine":1,"totalLines":391}}}
