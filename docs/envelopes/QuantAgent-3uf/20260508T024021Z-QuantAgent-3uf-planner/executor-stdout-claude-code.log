{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01WN8LkcuFaCN1eQRgqoee6V","type":"tool_result","content":"1\t\"\"\"Additional tests for PositionMonitor - Constraints & Edge Cases.\n2\t\n3\tNote: These tests require PostgreSQL due to JSON column usage in models.\n4\tThey are marked as integration tests to exclude from default pytest run.\n5\t\"\"\"\n6\t\n7\timport os\n8\tfrom decimal import Decimal\n9\t\n10\timport pytest\n11\tfrom sqlalchemy import create_engine\n12\tfrom sqlalchemy.orm import sessionmaker\n13\t\n14\tfrom quantagent.models import (\n15\t    ActivePosition,\n16\t    Base,\n17\t    Environment,\n18\t    ExitPolicy,\n19\t    OrderSide,\n20\t)\n21\tfrom quantagent.trading.position_monitor import PositionMonitor\n22\t\n23\t\n24\t@pytest.fixture\n25\tdef db_session():\n26\t    \"\"\"Create database session for testing using DATABASE_URL if available.\"\"\"\n27\t    database_url = os.getenv(\"DATABASE_URL\")\n28\t    if database_url:\n29\t        engine = create_engine(database_url)\n30\t    else:\n31\t        # Fallback to SQLite for local development\n32\t        engine = create_engine(\"sqlite:///:memory:\")\n33\t    Base.metadata.create_all(engine)\n34\t    TestSession = sessionmaker(bind=engine)\n35\t    db = TestSession()\n36\t    yield db\n37\t    db.close()\n38\t\n39\t\n40\t@pytest.fixture\n41\tdef position_monitor(db_session):\n42\t    \"\"\"Create PositionMonitor instance.\"\"\"\n43\t    return PositionMonitor(db_session)\n44\t\n45\t# ============================================================================\n46\t# CONSTRAINT VALIDATION TESTS (siguiendo TESTING_PATTERNS.md)\n47\t# ============================================================================\n48\t\n49\tdef test_active_position_has_required_fields(position_monitor):\n50\t    \"\"\"Validate ActivePosition model has all required fields per design.\"\"\"\n51\t    position = position_monitor.open_position(\n52\t        symbol=\"BTCUSDT\",\n53\t        side=OrderSide.BUY,\n54\t        entry_price=100.0,\n55\t        stop_loss=95.0,\n56\t        take_profit=110.0,\n57\t        quantity=Decimal(\"1.0\"),\n58\t        exit_policy=ExitPolicy.SL_TP_ONLY,\n59\t    )\n60\t\n61\t    # Required fields per docs/03_design/QuantAgent-nu7-DS-active-position-monitoring.md\n62\t    required_attrs = [\n63\t        \"id\",\n64\t        \"symbol\",\n65\t        \"side\",\n66\t        \"entry_price\",\n67\t        \"stop_loss\",\n68\t        \"take_profit\",\n69\t        \"quantity\",\n70\t        \"decision_timestamp\",\n71\t        \"candles_since_entry\",\n72\t        \"exit_policy\",\n73\t        \"prediction_horizon\",\n74\t        \"candles_direction\",\n75\t        \"is_active\",\n76\t        \"environment\",\n77\t    ]\n78\t\n79\t    for attr in required_attrs:\n80\t        assert hasattr(position, attr), f\"Missing required field: {attr}\"\n81\t        assert getattr(position, attr) is not None or attr in [\n82\t            \"max_hold_candles\",\n83\t            \"trailing_stop_pct\",\n84\t            \"highest_price_seen\",\n85\t            \"lowest_price_seen\",\n86\t            \"trade_id\",\n87\t            \"signal_id\",\n88\t            \"closed_at\",\n89\t            \"close_reason\",\n90\t            \"accuracy\",\n91\t        ], f\"Field {attr} should not be None\"\n92\t\n93\tdef test_default_values_are_correct(position_monitor):\n94\t    \"\"\"Validate default values match design specifications.\"\"\"\n95\t    position = position_monitor.open_position(\n96\t        symbol=\"BTCUSDT\",\n97\t        side=OrderSide.BUY,\n98\t        entry_price=100.0,\n99\t        stop_loss=95.0,\n100\t        take_profit=110.0,\n101\t        quantity=Decimal(\"1.0\"),\n102\t        exit_policy=ExitPolicy.SL_TP_ONLY,\n103\t    )\n104\t\n105\t    # Defaults per design\n106\t    assert position.is_active is True\n107\t    assert position.candles_since_entry == 0\n108\t    assert position.prediction_horizon == 3\n109\t    assert position.candles_direction == []\n110\t    assert position.environment == Environment.BACKTEST\n111\t    assert position.closed_at is None\n112\t    assert position.close_reason is None\n113\t    assert position.accuracy is None\n114\t\n115\tdef test_position_with_all_optional_fields(position_monitor):\n116\t    \"\"\"Validate position creation with all optional fields set.\"\"\"\n117\t    position = position_monitor.open_position(\n118\t        symbol=\"BTCUSDT\",\n119\t        side=OrderSide.BUY,\n120\t        entry_price=100.0,\n121\t        stop_loss=95.0,\n122\t        take_profit=110.0,\n123\t        quantity=Decimal(\"1.0\"),\n124\t        exit_policy=ExitPolicy.TRAILING_STOP,\n125\t        trailing_stop_pct=0.05,\n126\t        max_hold_candles=10,\n127\t        prediction_horizon=5,\n128\t        trade_id=123,\n129\t        signal_id=456,\n130\t    )\n131\t\n132\t    assert position.trailing_stop_pct == 0.05\n133\t    assert position.max_hold_candles == 10\n134\t    assert position.prediction_horizon == 5\n135\t    assert position.trade_id == 123\n136\t    assert position.signal_id == 456\n137\t\n138\t# ============================================================================\n139\t# INVARIANTS TESTS\n140\t# ============================================================================\n141\t\n142\tdef test_candles_since_entry_never_decrements(position_monitor):\n143\t    \"\"\"Invariant: candles_since_entry should only increment, never decrement.\"\"\"\n144\t    position = position_monitor.open_position(\n145\t        symbol=\"BTCUSDT\",\n146\t        side=OrderSide.BUY,\n147\t        entry_price=100.0,\n148\t        stop_loss=95.0,\n149\t        take_profit=110.0,\n150\t        quantity=Decimal(\"1.0\"),\n151\t        exit_policy=ExitPolicy.TIME_BASED,\n152\t        prediction_horizon=5,\n153\t    )\n154\t\n155\t    prev_value = position.candles_since_entry\n156\t\n157\t    for i in range(1, 6):\n158\t        position_monitor.update_candle_tracking(\n159\t            position, current_price=100.0 + i, prev_close=100.0 + i - 1\n160\t        )\n161\t        current_value = position.candles_since_entry\n162\t        assert (\n163\t            current_value > prev_value\n164\t        ), f\"candles_since_entry decremented: {prev_value} -> {current_value}\"\n165\t        prev_value = current_value\n166\t\n167\tdef test_candles_direction_never_exceeds_prediction_horizon(position_monitor):\n168\t    \"\"\"Invariant: len(candles_direction) <= prediction_horizon.\"\"\"\n169\t    position = position_monitor.open_position(\n170\t        symbol=\"BTCUSDT\",\n171\t        side=OrderSide.BUY,\n172\t        entry_price=100.0,\n173\t        stop_loss=95.0,\n174\t        take_profit=110.0,\n175\t        quantity=Decimal(\"1.0\"),\n176\t        exit_policy=ExitPolicy.TIME_BASED,\n177\t        prediction_horizon=3,\n178\t    )\n179\t\n180\t    # Try to add 10 candles\n181\t    for i in range(1, 11):\n182\t        position_monitor.update_candle_tracking(\n183\t            position, current_price=100.0 + i, prev_close=100.0 + i - 1\n184\t        )\n185\t        assert (\n186\t            len(position.candles_direction) <= position.prediction_horizon\n187\t        ), f\"candles_direction exceeded horizon: {len(position.candles_direction)} > {position.prediction_horizon}\"\n188\t\n189\tdef test_accuracy_is_between_zero_and_one(position_monitor):\n190\t    \"\"\"Invariant: accuracy should be in [0.0, 1.0] range.\"\"\"\n191\t    position = position_monitor.open_position(\n192\t        symbol=\"BTCUSDT\",\n193\t        side=OrderSide.BUY,\n194\t        entry_price=100.0,\n195\t        stop_loss=95.0,\n196\t        take_profit=110.0,\n197\t        quantity=Decimal(\"1.0\"),\n198\t        exit_policy=ExitPolicy.TIME_BASED,\n199\t        prediction_horizon=3,\n200\t    )\n201\t\n202\t    # Add varied directions\n203\t    position.candles_direction = [\"up\", \"down\", \"up\"]\n204\t\n205\t    position_monitor.close_position(position, reason=\"TIME_EXPIRED\", exit_price=108.0)\n206\t\n207\t    assert position.accuracy is not None\n208\t    assert (\n209\t        0.0 <= position.accuracy <= 1.0\n210\t    ), f\"accuracy out of range: {position.accuracy}\"\n211\t\n212\tdef test_closed_position_has_closed_at_timestamp(position_monitor):\n213\t    \"\"\"Invariant: closed position must have closed_at timestamp.\"\"\"\n214\t    position = position_monitor.open_position(\n215\t        symbol=\"BTCUSDT\",\n216\t        side=OrderSide.BUY,\n217\t        entry_price=100.0,\n218\t        stop_loss=95.0,\n219\t        take_profit=110.0,\n220\t        quantity=Decimal(\"1.0\"),\n221\t        exit_policy=ExitPolicy.SL_TP_ONLY,\n222\t    )\n223\t\n224\t    position_monitor.close_position(position, reason=\"STOP_LOSS\", exit_price=95.0)\n225\t\n226\t    assert position.is_active is False\n227\t    assert position.closed_at is not None\n228\t    assert position.close_reason == \"STOP_LOSS\"\n229\t\n230\t# ============================================================================\n231\t# EDGE CASES & ERROR HANDLING\n232\t# ============================================================================\n233\t\n234\tdef test_close_already_closed_position_is_idempotent(position_monitor):\n235\t    \"\"\"Edge case: closing an already closed position should not error.\"\"\"\n236\t    position = position_monitor.open_position(\n237\t        symbol=\"BTCUSDT\",\n238\t        side=OrderSide.BUY,\n239\t        entry_price=100.0,\n240\t        stop_loss=95.0,\n241\t        take_profit=110.0,\n242\t        quantity=Decimal(\"1.0\"),\n243\t        exit_policy=ExitPolicy.SL_TP_ONLY,\n244\t    )\n245\t\n246\t    # Close once\n247\t    position_monitor.close_position(position, reason=\"TAKE_PROFIT\", exit_price=110.0)\n248\t\n249\t    # Close again (should be idempotent)\n250\t    position_monitor.close_position(position, reason=\"MANUAL\", exit_price=110.0)\n251\t\n252\t    assert position.is_active is False\n253\t    assert position.close_reason == \"MANUAL\"  # Reason updated\n254\t\n255\tdef test_update_tracking_on_closed_position_still_increments(position_monitor):\n256\t    \"\"\"Edge case: tracking on closed position (shouldn't happen but shouldn't crash).\"\"\"\n257\t    position = position_monitor.open_position(\n258\t        symbol=\"BTCUSDT\",\n259\t        side=OrderSide.BUY,\n260\t        entry_price=100.0,\n261\t        stop_loss=95.0,\n262\t        take_profit=110.0,\n263\t        quantity=Decimal(\"1.0\"),\n264\t        exit_policy=ExitPolicy.SL_TP_ONLY,\n265\t    )\n266\t\n267\t    position_monitor.close_position(position, reason=\"TAKE_PROFIT\", exit_price=110.0)\n268\t\n269\t    # Try to update tracking (shouldn't crash)\n270\t    position_monitor.update_candle_tracking(\n271\t        position, current_price=111.0, prev_close=110.0\n272\t    )\n273\t\n274\t    # Should still increment (no guard in implementation)\n275\t    assert position.candles_since_entry == 1\n276\t\n277\tdef test_zero_quantity_position(position_monitor):\n278\t    \"\"\"Edge case: position with zero quantity.\"\"\"\n279\t    position = position_monitor.open_position(\n280\t        symbol=\"BTCUSDT\",\n281\t        side=OrderSide.BUY,\n282\t        entry_price=100.0,\n283\t        stop_loss=95.0,\n284\t        take_profit=110.0,\n285\t        quantity=Decimal(\"0.0\"),\n286\t        exit_policy=ExitPolicy.SL_TP_ONLY,\n287\t    )\n288\t\n289\t    assert position.quantity == Decimal(\"0.0\")\n290\t    assert position.is_active is True\n291\t\n292\tdef test_candle_tracking_with_equal_prices(position_monitor):\n293\t    \"\"\"Edge case: current_price == prev_close (flat candle).\"\"\"\n294\t    position = position_monitor.open_position(\n295\t        symbol=\"BTCUSDT\",\n296\t        side=OrderSide.BUY,\n297\t        entry_price=100.0,\n298\t        stop_loss=95.0,\n299\t        take_profit=110.0,\n300\t        quantity=Decimal(\"1.0\"),\n301\t        exit_policy=ExitPolicy.TIME_BASED,\n302\t        prediction_horizon=3,\n303\t    )\n304\t\n305\t    # Flat candle (same price)\n306\t    position_monitor.update_candle_tracking(\n307\t        position, current_price=100.0, prev_close=100.0\n308\t    )\n309\t\n310\t    # Should be classified as \"down\" per implementation logic\n311\t    assert position.candles_direction == [\"down\"]\n312\t\n313\tdef test_accuracy_calculation_all_correct_predictions(position_monitor):\n314\t    \"\"\"Edge case: 100% accurate predictions.\"\"\"\n315\t    position = position_monitor.open_position(\n316\t        symbol=\"BTCUSDT\",\n317\t        side=OrderSide.BUY,\n318\t        entry_price=100.0,\n319\t        stop_loss=95.0,\n320\t        take_profit=110.0,\n321\t        quantity=Decimal(\"1.0\"),\n322\t        exit_policy=ExitPolicy.TIME_BASED,\n323\t        prediction_horizon=3,\n324\t    )\n325\t\n326\t    position.candles_direction = [\"up\", \"up\", \"up\"]\n327\t\n328\t    position_monitor.close_position(position, reason=\"TIME_EXPIRED\", exit_price=110.0)\n329\t\n330\t    assert position.accuracy == 1.0\n331\t\n332\tdef test_accuracy_calculation_all_wrong_predictions(position_monitor):\n333\t    \"\"\"Edge case: 0% accurate predictions.\"\"\"\n334\t    position = position_monitor.open_position(\n335\t        symbol=\"BTCUSDT\",\n336\t        side=OrderSide.BUY,\n337\t        entry_price=100.0,\n338\t        stop_loss=95.0,\n339\t        take_profit=110.0,\n340\t        quantity=Decimal(\"1.0\"),\n341\t        exit_policy=ExitPolicy.TIME_BASED,\n342\t        prediction_horizon=3,\n343\t    )\n344\t\n345\t    # All wrong for LONG (expected \"up\", got \"down\")\n346\t    position.candles_direction = [\"down\", \"down\", \"down\"]\n347\t\n348\t    position_monitor.close_position(position, reason=\"TIME_EXPIRED\", exit_price=95.0)\n349\t\n350\t    assert position.accuracy == 0.0\n351\t\n352\tdef test_accuracy_calculation_short_with_up_candles(position_monitor):\n353\t    \"\"\"Edge case: SHORT position with up candles (all wrong).\"\"\"\n354\t    position = position_monitor.open_position(\n355\t        symbol=\"BTCUSDT\",\n356\t        side=OrderSide.SELL,\n357\t        entry_price=100.0,\n358\t        stop_loss=105.0,\n359\t        take_profit=90.0,\n360\t        quantity=Decimal(\"1.0\"),\n361\t        exit_policy=ExitPolicy.TIME_BASED,\n362\t        prediction_horizon=3,\n363\t    )\n364\t\n365\t    # All wrong for SHORT (expected \"down\", got \"up\")\n366\t    position.candles_direction = [\"up\", \"up\", \"up\"]\n367\t\n368\t    position_monitor.close_position(position, reason=\"STOP_LOSS\", exit_price=105.0)\n369\t\n370\t    assert position.accuracy == 0.0\n371\t\n372\tdef test_get_active_position_returns_most_recent_if_multiple(\n373\t    position_monitor, db_session\n374\t):\n375\t    \"\"\"Edge case: if DB has multiple active positions (shouldn't happen but test query behavior).\"\"\"\n376\t    # Create 2 positions for same symbol (violates constraint but test DB query)\n377\t    pos1 = position_monitor.open_position(\n378\t        symbol=\"BTCUSDT\",\n379\t        side=OrderSide.BUY,\n380\t        entry_price=100.0,\n381\t        stop_loss=95.0,\n382\t        take_profit=110.0,\n383\t        quantity=Decimal(\"1.0\"),\n384\t        exit_policy=ExitPolicy.SL_TP_ONLY,\n385\t    )\n386\t\n387\t    # Manually create another active position (bypassing monitor)\n388\t    pos2 = ActivePosition(\n389\t        symbol=\"BTCUSDT\",\n390\t        side=OrderSide.SELL,\n391\t        entry_price=105.0,\n392\t        stop_loss=110.0,\n393\t        take_profit=95.0,\n394\t        quantity=Decimal(\"1.0\"),\n395\t        exit_policy=ExitPolicy.SL_TP_ONLY,\n396\t        decision_timestamp=pos1.decision_timestamp,\n397\t        is_active=True,\n398\t        candles_direction=[],\n399\t    )\n400\t    db_session.add(pos2)\n401\t    db_session.commit()\n402\t\n403\t    # get_active_position should return first match\n404\t    active = position_monitor.get_active_position(\"BTCUSDT\")\n405\t    assert active is not None\n406\t    assert active.id == pos1.id  # Returns first one\n407\t\n408\t# ============================================================================\n409\t# VALIDATION OF PERSISTENCE\n410\t# ============================================================================\n411\t\n412\tdef test_position_persists_after_session_close(db_session):\n413\t    \"\"\"Validate position is actually persisted to DB.\"\"\"\n414\t    monitor = PositionMonitor(db_session)\n415\t\n416\t    position = monitor.open_position(\n417\t        symbol=\"BTCUSDT\",\n418\t        side=OrderSide.BUY,\n419\t        entry_price=100.0,\n420\t        stop_loss=95.0,\n421\t        take_profit=110.0,\n422\t        quantity=Decimal(\"1.0\"),\n423\t        exit_policy=ExitPolicy.SL_TP_ONLY,\n424\t    )\n425\t\n426\t    position_id = position.id\n427\t\n428\t    # Query directly from DB\n429\t    db_position = db_session.query(ActivePosition).filter_by(id=position_id).first()\n430\t\n431\t    assert db_position is not None\n432\t    assert db_position.symbol == \"BTCUSDT\"\n433\t    assert db_position.is_active is True\n434\t\n435\tdef test_closed_position_not_returned_by_get_active(position_monitor):\n436\t    \"\"\"Validate closed positions are not returned by get_active_position.\"\"\"\n437\t    position = position_monitor.open_position(\n438\t        symbol=\"BTCUSDT\",\n439\t        side=OrderSide.BUY,\n440\t        entry_price=100.0,\n441\t        stop_loss=95.0,\n442\t        take_profit=110.0,\n443\t        quantity=Decimal(\"1.0\"),\n444\t        exit_policy=ExitPolicy.SL_TP_ONLY,\n445\t    )\n446\t\n447\t    position_monitor.close_position(position, reason=\"MANUAL\", exit_price=105.0)\n448\t\n449\t    # Should not be returned by get_active_position\n450\t    active = position_monitor.get_active_position(\"BTCUSDT\")\n451\t    assert active is None\n452\t\n453\t# ============================================================================\n454\t# TESTS FOR DIFFERENT EXIT POLICIES\n455\t# ============================================================================\n456\t\n457\tdef test_all_exit_policies_can_be_set(position_monitor):\n458\t    \"\"\"Validate all ExitPolicy enum values are valid.\"\"\"\n459\t    for policy in [\n460\t        ExitPolicy.SL_TP_ONLY,\n461\t        ExitPolicy.TIME_BASED,\n462\t        ExitPolicy.REEVALUATE,\n463\t        ExitPolicy.TRAILING_STOP,\n464\t    ]:\n465\t        position = position_monitor.open_position(\n466\t            symbol=f\"TEST_{policy.value}\",\n467\t            side=OrderSide.BUY,\n468\t            entry_price=100.0,\n469\t            stop_loss=95.0,\n470\t            take_profit=110.0,\n471\t            quantity=Decimal(\"1.0\"),\n472\t            exit_policy=policy,\n473\t        )\n474\t\n475\t        assert position.exit_policy == policy\n476\t"}]},"parent_tool_use_id":null,"session_id":"3c1eaaa5-4630-4080-9c30-fa243b2053bf","uuid":"bbd6e66e-6fc8-40c6-84df-4d7734f3b3c0","timestamp":"2026-05-08T02:40:49.091Z","tool_use_result":{"type":"text","file":{"filePath":"/home/azureuser/repos/projects/QuantAgent/tests/test_position_monitor_constraints.py","content":"\"\"\"Additional tests for PositionMonitor - Constraints & Edge Cases.\n\nNote: These tests require PostgreSQL due to JSON column usage in models.\nThey are marked as integration tests to exclude from default pytest run.\n\"\"\"\n\nimport os\nfrom decimal import Decimal\n\nimport pytest\nfrom sqlalchemy import create_engine\nfrom sqlalchemy.orm import sessionmaker\n\nfrom quantagent.models import (\n    ActivePosition,\n    Base,\n    Environment,\n    ExitPolicy,\n    OrderSide,\n)\nfrom quantagent.trading.position_monitor import PositionMonitor\n\n\n@pytest.fixture\ndef db_session():\n    \"\"\"Create database session for testing using DATABASE_URL if available.\"\"\"\n    database_url = os.getenv(\"DATABASE_URL\")\n    if database_url:\n        engine = create_engine(database_url)\n    else:\n        # Fallback to SQLite for local development\n        engine = create_engine(\"sqlite:///:memory:\")\n    Base.metadata.create_all(engine)\n    TestSession = sessionmaker(bind=engine)\n    db = TestSession()\n    yield db\n    db.close()\n\n\n@pytest.fixture\ndef position_monitor(db_session):\n    \"\"\"Create PositionMonitor instance.\"\"\"\n    return PositionMonitor(db_session)\n\n# ============================================================================\n# CONSTRAINT VALIDATION TESTS (siguiendo TESTING_PATTERNS.md)\n# ============================================================================\n\ndef test_active_position_has_required_fields(position_monitor):\n    \"\"\"Validate ActivePosition model has all required fields per design.\"\"\"\n    position = position_monitor.open_position(\n        symbol=\"BTCUSDT\",\n        side=OrderSide.BUY,\n        entry_price=100.0,\n        stop_loss=95.0,\n        take_profit=110.0,\n        quantity=Decimal(\"1.0\"),\n        exit_policy=ExitPolicy.SL_TP_ONLY,\n    )\n\n    # Required fields per docs/03_design/QuantAgent-nu7-DS-active-position-monitoring.md\n    required_attrs = [\n        \"id\",\n        \"symbol\",\n        \"side\",\n        \"entry_price\",\n        \"stop_loss\",\n        \"take_profit\",\n        \"quantity\",\n        \"decision_timestamp\",\n        \"candles_since_entry\",\n        \"exit_policy\",\n        \"prediction_horizon\",\n        \"candles_direction\",\n        \"is_active\",\n        \"environment\",\n    ]\n\n    for attr in required_attrs:\n        assert hasattr(position, attr), f\"Missing required field: {attr}\"\n        assert getattr(position, attr) is not None or attr in [\n            \"max_hold_candles\",\n            \"trailing_stop_pct\",\n            \"highest_price_seen\",\n            \"lowest_price_seen\",\n            \"trade_id\",\n            \"signal_id\",\n            \"closed_at\",\n            \"close_reason\",\n            \"accuracy\",\n        ], f\"Field {attr} should not be None\"\n\ndef test_default_values_are_correct(position_monitor):\n    \"\"\"Validate default values match design specifications.\"\"\"\n    position = position_monitor.open_position(\n        symbol=\"BTCUSDT\",\n        side=OrderSide.BUY,\n        entry_price=100.0,\n        stop_loss=95.0,\n        take_profit=110.0,\n        quantity=Decimal(\"1.0\"),\n        exit_policy=ExitPolicy.SL_TP_ONLY,\n    )\n\n    # Defaults per design\n    assert position.is_active is True\n    assert position.candles_since_entry == 0\n    assert position.prediction_horizon == 3\n    assert position.candles_direction == []\n    assert position.environment == Environment.BACKTEST\n    assert position.closed_at is None\n    assert position.close_reason is None\n    assert position.accuracy is None\n\ndef test_position_with_all_optional_fields(position_monitor):\n    \"\"\"Validate position creation with all optional fields set.\"\"\"\n    position = position_monitor.open_position(\n        symbol=\"BTCUSDT\",\n        side=OrderSide.BUY,\n        entry_price=100.0,\n        stop_loss=95.0,\n        take_profit=110.0,\n        quantity=Decimal(\"1.0\"),\n        exit_policy=ExitPolicy.TRAILING_STOP,\n        trailing_stop_pct=0.05,\n        max_hold_candles=10,\n        prediction_horizon=5,\n        trade_id=123,\n        signal_id=456,\n    )\n\n    assert position.trailing_stop_pct == 0.05\n    assert position.max_hold_candles == 10\n    assert position.prediction_horizon == 5\n    assert position.trade_id == 123\n    assert position.signal_id == 456\n\n# ============================================================================\n# INVARIANTS TESTS\n# ============================================================================\n\ndef test_candles_since_entry_never_decrements(position_monitor):\n    \"\"\"Invariant: candles_since_entry should only increment, never decrement.\"\"\"\n    position = position_monitor.open_position(\n        symbol=\"BTCUSDT\",\n        side=OrderSide.BUY,\n        entry_price=100.0,\n        stop_loss=95.0,\n        take_profit=110.0,\n        quantity=Decimal(\"1.0\"),\n        exit_policy=ExitPolicy.TIME_BASED,\n        prediction_horizon=5,\n    )\n\n    prev_value = position.candles_since_entry\n\n    for i in range(1, 6):\n        position_monitor.update_candle_tracking(\n            position, current_price=100.0 + i, prev_close=100.0 + i - 1\n        )\n        current_value = position.candles_since_entry\n        assert (\n            current_value > prev_value\n        ), f\"candles_since_entry decremented: {prev_value} -> {current_value}\"\n        prev_value = current_value\n\ndef test_candles_direction_never_exceeds_prediction_horizon(position_monitor):\n    \"\"\"Invariant: len(candles_direction) <= prediction_horizon.\"\"\"\n    position = position_monitor.open_position(\n        symbol=\"BTCUSDT\",\n        side=OrderSide.BUY,\n        entry_price=100.0,\n        stop_loss=95.0,\n        take_profit=110.0,\n        quantity=Decimal(\"1.0\"),\n        exit_policy=ExitPolicy.TIME_BASED,\n        prediction_horizon=3,\n    )\n\n    # Try to add 10 candles\n    for i in range(1, 11):\n        position_monitor.update_candle_tracking(\n            position, current_price=100.0 + i, prev_close=100.0 + i - 1\n        )\n        assert (\n            len(position.candles_direction) <= position.prediction_horizon\n        ), f\"candles_direction exceeded horizon: {len(position.candles_direction)} > {position.prediction_horizon}\"\n\ndef test_accuracy_is_between_zero_and_one(position_monitor):\n    \"\"\"Invariant: accuracy should be in [0.0, 1.0] range.\"\"\"\n    position = position_monitor.open_position(\n        symbol=\"BTCUSDT\",\n        side=OrderSide.BUY,\n        entry_price=100.0,\n        stop_loss=95.0,\n        take_profit=110.0,\n        quantity=Decimal(\"1.0\"),\n        exit_policy=ExitPolicy.TIME_BASED,\n        prediction_horizon=3,\n    )\n\n    # Add varied directions\n    position.candles_direction = [\"up\", \"down\", \"up\"]\n\n    position_monitor.close_position(position, reason=\"TIME_EXPIRED\", exit_price=108.0)\n\n    assert position.accuracy is not None\n    assert (\n        0.0 <= position.accuracy <= 1.0\n    ), f\"accuracy out of range: {position.accuracy}\"\n\ndef test_closed_position_has_closed_at_timestamp(position_monitor):\n    \"\"\"Invariant: closed position must have closed_at timestamp.\"\"\"\n    position = position_monitor.open_position(\n        symbol=\"BTCUSDT\",\n        side=OrderSide.BUY,\n        entry_price=100.0,\n        stop_loss=95.0,\n        take_profit=110.0,\n        quantity=Decimal(\"1.0\"),\n        exit_policy=ExitPolicy.SL_TP_ONLY,\n    )\n\n    position_monitor.close_position(position, reason=\"STOP_LOSS\", exit_price=95.0)\n\n    assert position.is_active is False\n    assert position.closed_at is not None\n    assert position.close_reason == \"STOP_LOSS\"\n\n# ============================================================================\n# EDGE CASES & ERROR HANDLING\n# ============================================================================\n\ndef test_close_already_closed_position_is_idempotent(position_monitor):\n    \"\"\"Edge case: closing an already closed position should not error.\"\"\"\n    position = position_monitor.open_position(\n        symbol=\"BTCUSDT\",\n        side=OrderSide.BUY,\n        entry_price=100.0,\n        stop_loss=95.0,\n        take_profit=110.0,\n        quantity=Decimal(\"1.0\"),\n        exit_policy=ExitPolicy.SL_TP_ONLY,\n    )\n\n    # Close once\n    position_monitor.close_position(position, reason=\"TAKE_PROFIT\", exit_price=110.0)\n\n    # Close again (should be idempotent)\n    position_monitor.close_position(position, reason=\"MANUAL\", exit_price=110.0)\n\n    assert position.is_active is False\n    assert position.close_reason == \"MANUAL\"  # Reason updated\n\ndef test_update_tracking_on_closed_position_still_increments(position_monitor):\n    \"\"\"Edge case: tracking on closed position (shouldn't happen but shouldn't crash).\"\"\"\n    position = position_monitor.open_position(\n        symbol=\"BTCUSDT\",\n        side=OrderSide.BUY,\n        entry_price=100.0,\n        stop_loss=95.0,\n        take_profit=110.0,\n        quantity=Decimal(\"1.0\"),\n        exit_policy=ExitPolicy.SL_TP_ONLY,\n    )\n\n    position_monitor.close_position(position, reason=\"TAKE_PROFIT\", exit_price=110.0)\n\n    # Try to update tracking (shouldn't crash)\n    position_monitor.update_candle_tracking(\n        position, current_price=111.0, prev_close=110.0\n    )\n\n    # Should still increment (no guard in implementation)\n    assert position.candles_since_entry == 1\n\ndef test_zero_quantity_position(position_monitor):\n    \"\"\"Edge case: position with zero quantity.\"\"\"\n    position = position_monitor.open_position(\n        symbol=\"BTCUSDT\",\n        side=OrderSide.BUY,\n        entry_price=100.0,\n        stop_loss=95.0,\n        take_profit=110.0,\n        quantity=Decimal(\"0.0\"),\n        exit_policy=ExitPolicy.SL_TP_ONLY,\n    )\n\n    assert position.quantity == Decimal(\"0.0\")\n    assert position.is_active is True\n\ndef test_candle_tracking_with_equal_prices(position_monitor):\n    \"\"\"Edge case: current_price == prev_close (flat candle).\"\"\"\n    position = position_monitor.open_position(\n        symbol=\"BTCUSDT\",\n        side=OrderSide.BUY,\n        entry_price=100.0,\n        stop_loss=95.0,\n        take_profit=110.0,\n        quantity=Decimal(\"1.0\"),\n        exit_policy=ExitPolicy.TIME_BASED,\n        prediction_horizon=3,\n    )\n\n    # Flat candle (same price)\n    position_monitor.update_candle_tracking(\n        position, current_price=100.0, prev_close=100.0\n    )\n\n    # Should be classified as \"down\" per implementation logic\n    assert position.candles_direction == [\"down\"]\n\ndef test_accuracy_calculation_all_correct_predictions(position_monitor):\n    \"\"\"Edge case: 100% accurate predictions.\"\"\"\n    position = position_monitor.open_position(\n        symbol=\"BTCUSDT\",\n        side=OrderSide.BUY,\n        entry_price=100.0,\n        stop_loss=95.0,\n        take_profit=110.0,\n        quantity=Decimal(\"1.0\"),\n        exit_policy=ExitPolicy.TIME_BASED,\n        prediction_horizon=3,\n    )\n\n    position.candles_direction = [\"up\", \"up\", \"up\"]\n\n    position_monitor.close_position(position, reason=\"TIME_EXPIRED\", exit_price=110.0)\n\n    assert position.accuracy == 1.0\n\ndef test_accuracy_calculation_all_wrong_predictions(position_monitor):\n    \"\"\"Edge case: 0% accurate predictions.\"\"\"\n    position = position_monitor.open_position(\n        symbol=\"BTCUSDT\",\n        side=OrderSide.BUY,\n        entry_price=100.0,\n        stop_loss=95.0,\n        take_profit=110.0,\n        quantity=Decimal(\"1.0\"),\n        exit_policy=ExitPolicy.TIME_BASED,\n        prediction_horizon=3,\n    )\n\n    # All wrong for LONG (expected \"up\", got \"down\")\n    position.candles_direction = [\"down\", \"down\", \"down\"]\n\n    position_monitor.close_position(position, reason=\"TIME_EXPIRED\", exit_price=95.0)\n\n    assert position.accuracy == 0.0\n\ndef test_accuracy_calculation_short_with_up_candles(position_monitor):\n    \"\"\"Edge case: SHORT position with up candles (all wrong).\"\"\"\n    position = position_monitor.open_position(\n        symbol=\"BTCUSDT\",\n        side=OrderSide.SELL,\n        entry_price=100.0,\n        stop_loss=105.0,\n        take_profit=90.0,\n        quantity=Decimal(\"1.0\"),\n        exit_policy=ExitPolicy.TIME_BASED,\n        prediction_horizon=3,\n    )\n\n    # All wrong for SHORT (expected \"down\", got \"up\")\n    position.candles_direction = [\"up\", \"up\", \"up\"]\n\n    position_monitor.close_position(position, reason=\"STOP_LOSS\", exit_price=105.0)\n\n    assert position.accuracy == 0.0\n\ndef test_get_active_position_returns_most_recent_if_multiple(\n    position_monitor, db_session\n):\n    \"\"\"Edge case: if DB has multiple active positions (shouldn't happen but test query behavior).\"\"\"\n    # Create 2 positions for same symbol (violates constraint but test DB query)\n    pos1 = position_monitor.open_position(\n        symbol=\"BTCUSDT\",\n        side=OrderSide.BUY,\n        entry_price=100.0,\n        stop_loss=95.0,\n        take_profit=110.0,\n        quantity=Decimal(\"1.0\"),\n        exit_policy=ExitPolicy.SL_TP_ONLY,\n    )\n\n    # Manually create another active position (bypassing monitor)\n    pos2 = ActivePosition(\n        symbol=\"BTCUSDT\",\n        side=OrderSide.SELL,\n        entry_price=105.0,\n        stop_loss=110.0,\n        take_profit=95.0,\n        quantity=Decimal(\"1.0\"),\n        exit_policy=ExitPolicy.SL_TP_ONLY,\n        decision_timestamp=pos1.decision_timestamp,\n        is_active=True,\n        candles_direction=[],\n    )\n    db_session.add(pos2)\n    db_session.commit()\n\n    # get_active_position should return first match\n    active = position_monitor.get_active_position(\"BTCUSDT\")\n    assert active is not None\n    assert active.id == pos1.id  # Returns first one\n\n# ============================================================================\n# VALIDATION OF PERSISTENCE\n# ============================================================================\n\ndef test_position_persists_after_session_close(db_session):\n    \"\"\"Validate position is actually persisted to DB.\"\"\"\n    monitor = PositionMonitor(db_session)\n\n    position = monitor.open_position(\n        symbol=\"BTCUSDT\",\n        side=OrderSide.BUY,\n        entry_price=100.0,\n        stop_loss=95.0,\n        take_profit=110.0,\n        quantity=Decimal(\"1.0\"),\n        exit_policy=ExitPolicy.SL_TP_ONLY,\n    )\n\n    position_id = position.id\n\n    # Query directly from DB\n    db_position = db_session.query(ActivePosition).filter_by(id=position_id).first()\n\n    assert db_position is not None\n    assert db_position.symbol == \"BTCUSDT\"\n    assert db_position.is_active is True\n\ndef test_closed_position_not_returned_by_get_active(position_monitor):\n    \"\"\"Validate closed positions are not returned by get_active_position.\"\"\"\n    position = position_monitor.open_position(\n        symbol=\"BTCUSDT\",\n        side=OrderSide.BUY,\n        entry_price=100.0,\n        stop_loss=95.0,\n        take_profit=110.0,\n        quantity=Decimal(\"1.0\"),\n        exit_policy=ExitPolicy.SL_TP_ONLY,\n    )\n\n    position_monitor.close_position(position, reason=\"MANUAL\", exit_price=105.0)\n\n    # Should not be returned by get_active_position\n    active = position_monitor.get_active_position(\"BTCUSDT\")\n    assert active is None\n\n# ============================================================================\n# TESTS FOR DIFFERENT EXIT POLICIES\n# ============================================================================\n\ndef test_all_exit_policies_can_be_set(position_monitor):\n    \"\"\"Validate all ExitPolicy enum values are valid.\"\"\"\n    for policy in [\n        ExitPolicy.SL_TP_ONLY,\n        ExitPolicy.TIME_BASED,\n        ExitPolicy.REEVALUATE,\n        ExitPolicy.TRAILING_STOP,\n    ]:\n        position = position_monitor.open_position(\n            symbol=f\"TEST_{policy.value}\",\n            side=OrderSide.BUY,\n            entry_price=100.0,\n            stop_loss=95.0,\n            take_profit=110.0,\n            quantity=Decimal(\"1.0\"),\n            exit_policy=policy,\n        )\n\n        assert position.exit_policy == policy\n","numLines":476,"startLine":1,"totalLines":476}}}
