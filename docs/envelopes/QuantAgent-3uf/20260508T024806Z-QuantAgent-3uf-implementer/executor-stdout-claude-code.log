=0.05,\n        max_hold_candles=10,\n        prediction_horizon=5,\n        trade_id=trade.id,\n        signal_id=signal.id,\n    )\n\n    assert position.trailing_stop_pct == 0.05\n    assert position.max_hold_candles == 10\n    assert position.prediction_horizon == 5\n    assert position.trade_id == trade.id\n    assert position.signal_id == signal.id"},"caller":{"type":"direct"}}],"stop_reason":null,"stop_sequence":null,"stop_details":null,"usage":{"input_tokens":1,"cache_creation_input_tokens":758,"cache_read_input_tokens":53787,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":758},"output_tokens":1,"service_tier":"standard","inference_geo":"not_available"},"context_management":null},"parent_tool_use_id":null,"session_id":"e4119307-b18c-4a04-a8f0-d6dabcd79e06","uuid":"b9050068-e09d-4867-a8ac-8a9cb37dd602"}
