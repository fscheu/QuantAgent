{"type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_01GJpaPrm5wdnskztK97cS3w","type":"tool_result","content":"1\t\"\"\"Tests for PositionMonitor.\n2\t\n3\tNote: These tests require PostgreSQL due to JSON column usage in models.\n4\tThey are marked as integration tests to exclude from default pytest run.\n5\t\"\"\"\n6\t\n7\timport os\n8\tfrom decimal import Decimal\n9\t\n10\timport pytest\n11\tfrom sqlalchemy import create_engine\n12\tfrom sqlalchemy.orm import sessionmaker\n13\t\n14\tfrom quantagent.models import (\n15\t    ActivePosition,\n16\t    Base,\n17\t    ExitPolicy,\n18\t    OrderSide,\n19\t)\n20\tfrom quantagent.trading.position_monitor import PositionMonitor\n21\t\n22\t\n23\t@pytest.fixture\n24\tdef db_session():\n25\t    \"\"\"Create database session for testing using DATABASE_URL if available.\"\"\"\n26\t    database_url = os.getenv(\"DATABASE_URL\")\n27\t    if database_url:\n28\t        engine = create_engine(database_url)\n29\t    else:\n30\t        # Fallback to SQLite for local development\n31\t        engine = create_engine(\"sqlite:///:memory:\")\n32\t    Base.metadata.create_all(engine)\n33\t    TestSession = sessionmaker(bind=engine)\n34\t    db = TestSession()\n35\t    yield db\n36\t    db.close()\n37\t\n38\t\n39\t@pytest.fixture\n40\tdef position_monitor(db_session):\n41\t    \"\"\"Create PositionMonitor instance.\"\"\"\n42\t    return PositionMonitor(db_session)\n43\t\n44\tdef test_open_position(position_monitor, db_session):\n45\t    \"\"\"Test creating a new active position.\"\"\"\n46\t    position = position_monitor.open_position(\n47\t        symbol=\"BTCUSDT\",\n48\t        side=OrderSide.BUY,\n49\t        entry_price=100.0,\n50\t        stop_loss=95.0,\n51\t        take_profit=110.0,\n52\t        quantity=Decimal(\"1.0\"),\n53\t        exit_policy=ExitPolicy.TRAILING_STOP,\n54\t        trailing_stop_pct=0.05,\n55\t    )\n56\t\n57\t    assert position.id is not None\n58\t    assert position.symbol == \"BTCUSDT\"\n59\t    assert position.side == OrderSide.BUY\n60\t    assert position.entry_price == 100.0\n61\t    assert position.stop_loss == 95.0\n62\t    assert position.take_profit == 110.0\n63\t    assert position.quantity == Decimal(\"1.0\")\n64\t    assert position.exit_policy == ExitPolicy.TRAILING_STOP\n65\t    assert position.trailing_stop_pct == 0.05\n66\t    assert position.is_active is True\n67\t    assert position.candles_since_entry == 0\n68\t    assert position.candles_direction == []\n69\t\n70\tdef test_get_active_position(position_monitor):\n71\t    \"\"\"Test retrieving active position by symbol.\"\"\"\n72\t    position_monitor.open_position(\n73\t        symbol=\"BTCUSDT\",\n74\t        side=OrderSide.BUY,\n75\t        entry_price=100.0,\n76\t        stop_loss=95.0,\n77\t        take_profit=110.0,\n78\t        quantity=Decimal(\"1.0\"),\n79\t        exit_policy=ExitPolicy.SL_TP_ONLY,\n80\t    )\n81\t\n82\t    active = position_monitor.get_active_position(\"BTCUSDT\")\n83\t    assert active is not None\n84\t    assert active.symbol == \"BTCUSDT\"\n85\t    assert active.is_active is True\n86\t\n87\t    no_position = position_monitor.get_active_position(\"ETHUSDT\")\n88\t    assert no_position is None\n89\t\n90\tdef test_update_candle_tracking_up(position_monitor):\n91\t    \"\"\"Test tracking candle direction - up.\"\"\"\n92\t    position = position_monitor.open_position(\n93\t        symbol=\"BTCUSDT\",\n94\t        side=OrderSide.BUY,\n95\t        entry_price=100.0,\n96\t        stop_loss=95.0,\n97\t        take_profit=110.0,\n98\t        quantity=Decimal(\"1.0\"),\n99\t        exit_policy=ExitPolicy.TIME_BASED,\n100\t        prediction_horizon=3,\n101\t    )\n102\t\n103\t    position_monitor.update_candle_tracking(\n104\t        position, current_price=102.0, prev_close=100.0\n105\t    )\n106\t\n107\t    assert position.candles_since_entry == 1\n108\t    assert position.candles_direction == [\"up\"]\n109\t\n110\tdef test_update_candle_tracking_down(position_monitor):\n111\t    \"\"\"Test tracking candle direction - down.\"\"\"\n112\t    position = position_monitor.open_position(\n113\t        symbol=\"BTCUSDT\",\n114\t        side=OrderSide.BUY,\n115\t        entry_price=100.0,\n116\t        stop_loss=95.0,\n117\t        take_profit=110.0,\n118\t        quantity=Decimal(\"1.0\"),\n119\t        exit_policy=ExitPolicy.TIME_BASED,\n120\t        prediction_horizon=3,\n121\t    )\n122\t\n123\t    position_monitor.update_candle_tracking(\n124\t        position, current_price=98.0, prev_close=100.0\n125\t    )\n126\t\n127\t    assert position.candles_since_entry == 1\n128\t    assert position.candles_direction == [\"down\"]\n129\t\n130\tdef test_update_candle_tracking_respects_horizon(position_monitor):\n131\t    \"\"\"Test that candle tracking respects prediction horizon.\"\"\"\n132\t    position = position_monitor.open_position(\n133\t        symbol=\"BTCUSDT\",\n134\t        side=OrderSide.BUY,\n135\t        entry_price=100.0,\n136\t        stop_loss=95.0,\n137\t        take_profit=110.0,\n138\t        quantity=Decimal(\"1.0\"),\n139\t        exit_policy=ExitPolicy.TIME_BASED,\n140\t        prediction_horizon=3,\n141\t    )\n142\t\n143\t    for i, price in enumerate([102.0, 104.0, 106.0, 108.0], start=1):\n144\t        position_monitor.update_candle_tracking(\n145\t            position, current_price=price, prev_close=price - 2\n146\t        )\n147\t        assert position.candles_since_entry == i\n148\t\n149\t    assert len(position.candles_direction) == 3\n150\t\n151\tdef test_close_position_long_accurate(position_monitor):\n152\t    \"\"\"Test closing LONG position with accurate predictions.\"\"\"\n153\t    position = position_monitor.open_position(\n154\t        symbol=\"BTCUSDT\",\n155\t        side=OrderSide.BUY,\n156\t        entry_price=100.0,\n157\t        stop_loss=95.0,\n158\t        take_profit=110.0,\n159\t        quantity=Decimal(\"1.0\"),\n160\t        exit_policy=ExitPolicy.TIME_BASED,\n161\t        prediction_horizon=3,\n162\t    )\n163\t\n164\t    position.candles_direction = [\"up\", \"up\", \"down\"]\n165\t\n166\t    position_monitor.close_position(position, reason=\"TIME_EXPIRED\", exit_price=108.0)\n167\t\n168\t    assert position.is_active is False\n169\t    assert position.close_reason == \"TIME_EXPIRED\"\n170\t    assert position.closed_at is not None\n171\t    assert position.accuracy == pytest.approx(2 / 3, rel=1e-2)\n172\t\n173\tdef test_close_position_short_accurate(position_monitor):\n174\t    \"\"\"Test closing SHORT position with accurate predictions.\"\"\"\n175\t    position = position_monitor.open_position(\n176\t        symbol=\"BTCUSDT\",\n177\t        side=OrderSide.SELL,\n178\t        entry_price=100.0,\n179\t        stop_loss=105.0,\n180\t        take_profit=90.0,\n181\t        quantity=Decimal(\"1.0\"),\n182\t        exit_policy=ExitPolicy.TIME_BASED,\n183\t        prediction_horizon=3,\n184\t    )\n185\t\n186\t    position.candles_direction = [\"down\", \"down\", \"up\"]\n187\t\n188\t    position_monitor.close_position(position, reason=\"TAKE_PROFIT\", exit_price=90.0)\n189\t\n190\t    assert position.is_active is False\n191\t    assert position.close_reason == \"TAKE_PROFIT\"\n192\t    assert position.accuracy == pytest.approx(2 / 3, rel=1e-2)\n193\t\n194\tdef test_close_position_no_tracking(position_monitor):\n195\t    \"\"\"Test closing position with no candle tracking.\"\"\"\n196\t    position = position_monitor.open_position(\n197\t        symbol=\"BTCUSDT\",\n198\t        side=OrderSide.BUY,\n199\t        entry_price=100.0,\n200\t        stop_loss=95.0,\n201\t        take_profit=110.0,\n202\t        quantity=Decimal(\"1.0\"),\n203\t        exit_policy=ExitPolicy.SL_TP_ONLY,\n204\t    )\n205\t\n206\t    position_monitor.close_position(position, reason=\"STOP_LOSS\", exit_price=95.0)\n207\t\n208\t    assert position.is_active is False\n209\t    assert position.accuracy is None\n210\t\n211\tdef test_only_one_active_position_per_symbol(position_monitor, db_session):\n212\t    \"\"\"Test constraint: only one active position per symbol.\"\"\"\n213\t    position_monitor.open_position(\n214\t        symbol=\"BTCUSDT\",\n215\t        side=OrderSide.BUY,\n216\t        entry_price=100.0,\n217\t        stop_loss=95.0,\n218\t        take_profit=110.0,\n219\t        quantity=Decimal(\"1.0\"),\n220\t        exit_policy=ExitPolicy.SL_TP_ONLY,\n221\t    )\n222\t\n223\t    active_positions = (\n224\t        db_session.query(ActivePosition)\n225\t        .filter(\n226\t            ActivePosition.symbol == \"BTCUSDT\", ActivePosition.is_active.is_(True)\n227\t        )\n228\t        .all()\n229\t    )\n230\t\n231\t    assert len(active_positions) == 1\n232\t\n233\t    pos1 = position_monitor.get_active_position(\"BTCUSDT\")\n234\t    position_monitor.close_position(pos1, reason=\"TEST\", exit_price=105.0)\n235\t\n236\t    position_monitor.open_position(\n237\t        symbol=\"BTCUSDT\",\n238\t        side=OrderSide.SELL,\n239\t        entry_price=105.0,\n240\t        stop_loss=110.0,\n241\t        take_profit=95.0,\n242\t        quantity=Decimal(\"1.0\"),\n243\t        exit_policy=ExitPolicy.SL_TP_ONLY,\n244\t    )\n245\t\n246\t    active_positions_after = (\n247\t        db_session.query(ActivePosition)\n248\t        .filter(\n249\t            ActivePosition.symbol == \"BTCUSDT\", ActivePosition.is_active.is_(True)\n250\t        )\n251\t        .all()\n252\t    )\n253\t\n254\t    assert len(active_positions_after) == 1\n255\t    assert active_positions_after[0].side == OrderSide.SELL\n256\t"}]},"parent_tool_use_id":null,"session_id":"e4119307-b18c-4a04-a8f0-d6dabcd79e06","uuid":"f323f2c9-6c58-4cb6-8251-bb859e084bf7","timestamp":"2026-05-08T02:48:31.555Z","tool_use_result":{"type":"text","file":{"filePath":"/mnt/actions-runner/autodev-runtime/worktrees/QuantAgent/QuantAgent-3uf/implementer-20260508T024806Z/tests/test_position_monitor.py","content":"\"\"\"Tests for PositionMonitor.\n\nNote: These tests require PostgreSQL due to JSON column usage in models.\nThey are marked as integration tests to exclude from default pytest run.\n\"\"\"\n\nimport os\nfrom decimal import Decimal\n\nimport pytest\nfrom sqlalchemy import create_engine\nfrom sqlalchemy.orm import sessionmaker\n\nfrom quantagent.models import (\n    ActivePosition,\n    Base,\n    ExitPolicy,\n    OrderSide,\n)\nfrom quantagent.trading.position_monitor import PositionMonitor\n\n\n@pytest.fixture\ndef db_session():\n    \"\"\"Create database session for testing using DATABASE_URL if available.\"\"\"\n    database_url = os.getenv(\"DATABASE_URL\")\n    if database_url:\n        engine = create_engine(database_url)\n    else:\n        # Fallback to SQLite for local development\n        engine = create_engine(\"sqlite:///:memory:\")\n    Base.metadata.create_all(engine)\n    TestSession = sessionmaker(bind=engine)\n    db = TestSession()\n    yield db\n    db.close()\n\n\n@pytest.fixture\ndef position_monitor(db_session):\n    \"\"\"Create PositionMonitor instance.\"\"\"\n    return PositionMonitor(db_session)\n\ndef test_open_position(position_monitor, db_session):\n    \"\"\"Test creating a new active position.\"\"\"\n    position = position_monitor.open_position(\n        symbol=\"BTCUSDT\",\n        side=OrderSide.BUY,\n        entry_price=100.0,\n        stop_loss=95.0,\n        take_profit=110.0,\n        quantity=Decimal(\"1.0\"),\n        exit_policy=ExitPolicy.TRAILING_STOP,\n        trailing_stop_pct=0.05,\n    )\n\n    assert position.id is not None\n    assert position.symbol == \"BTCUSDT\"\n    assert position.side == OrderSide.BUY\n    assert position.entry_price == 100.0\n    assert position.stop_loss == 95.0\n    assert position.take_profit == 110.0\n    assert position.quantity == Decimal(\"1.0\")\n    assert position.exit_policy == ExitPolicy.TRAILING_STOP\n    assert position.trailing_stop_pct == 0.05\n    assert position.is_active is True\n    assert position.candles_since_entry == 0\n    assert position.candles_direction == []\n\ndef test_get_active_position(position_monitor):\n    \"\"\"Test retrieving active position by symbol.\"\"\"\n    position_monitor.open_position(\n        symbol=\"BTCUSDT\",\n        side=OrderSide.BUY,\n        entry_price=100.0,\n        stop_loss=95.0,\n        take_profit=110.0,\n        quantity=Decimal(\"1.0\"),\n        exit_policy=ExitPolicy.SL_TP_ONLY,\n    )\n\n    active = position_monitor.get_active_position(\"BTCUSDT\")\n    assert active is not None\n    assert active.symbol == \"BTCUSDT\"\n    assert active.is_active is True\n\n    no_position = position_monitor.get_active_position(\"ETHUSDT\")\n    assert no_position is None\n\ndef test_update_candle_tracking_up(position_monitor):\n    \"\"\"Test tracking candle direction - up.\"\"\"\n    position = position_monitor.open_position(\n        symbol=\"BTCUSDT\",\n        side=OrderSide.BUY,\n        entry_price=100.0,\n        stop_loss=95.0,\n        take_profit=110.0,\n        quantity=Decimal(\"1.0\"),\n        exit_policy=ExitPolicy.TIME_BASED,\n        prediction_horizon=3,\n    )\n\n    position_monitor.update_candle_tracking(\n        position, current_price=102.0, prev_close=100.0\n    )\n\n    assert position.candles_since_entry == 1\n    assert position.candles_direction == [\"up\"]\n\ndef test_update_candle_tracking_down(position_monitor):\n    \"\"\"Test tracking candle direction - down.\"\"\"\n    position = position_monitor.open_position(\n        symbol=\"BTCUSDT\",\n        side=OrderSide.BUY,\n        entry_price=100.0,\n        stop_loss=95.0,\n        take_profit=110.0,\n        quantity=Decimal(\"1.0\"),\n        exit_policy=ExitPolicy.TIME_BASED,\n        prediction_horizon=3,\n    )\n\n    position_monitor.update_candle_tracking(\n        position, current_price=98.0, prev_close=100.0\n    )\n\n    assert position.candles_since_entry == 1\n    assert position.candles_direction == [\"down\"]\n\ndef test_update_candle_tracking_respects_horizon(position_monitor):\n    \"\"\"Test that candle tracking respects prediction horizon.\"\"\"\n    position = position_monitor.open_position(\n        symbol=\"BTCUSDT\",\n        side=OrderSide.BUY,\n        entry_price=100.0,\n        stop_loss=95.0,\n        take_profit=110.0,\n        quantity=Decimal(\"1.0\"),\n        exit_policy=ExitPolicy.TIME_BASED,\n        prediction_horizon=3,\n    )\n\n    for i, price in enumerate([102.0, 104.0, 106.0, 108.0], start=1):\n        position_monitor.update_candle_tracking(\n            position, current_price=price, prev_close=price - 2\n        )\n        assert position.candles_since_entry == i\n\n    assert len(position.candles_direction) == 3\n\ndef test_close_position_long_accurate(position_monitor):\n    \"\"\"Test closing LONG position with accurate predictions.\"\"\"\n    position = position_monitor.open_position(\n        symbol=\"BTCUSDT\",\n        side=OrderSide.BUY,\n        entry_price=100.0,\n        stop_loss=95.0,\n        take_profit=110.0,\n        quantity=Decimal(\"1.0\"),\n        exit_policy=ExitPolicy.TIME_BASED,\n        prediction_horizon=3,\n    )\n\n    position.candles_direction = [\"up\", \"up\", \"down\"]\n\n    position_monitor.close_position(position, reason=\"TIME_EXPIRED\", exit_price=108.0)\n\n    assert position.is_active is False\n    assert position.close_reason == \"TIME_EXPIRED\"\n    assert position.closed_at is not None\n    assert position.accuracy == pytest.approx(2 / 3, rel=1e-2)\n\ndef test_close_position_short_accurate(position_monitor):\n    \"\"\"Test closing SHORT position with accurate predictions.\"\"\"\n    position = position_monitor.open_position(\n        symbol=\"BTCUSDT\",\n        side=OrderSide.SELL,\n        entry_price=100.0,\n        stop_loss=105.0,\n        take_profit=90.0,\n        quantity=Decimal(\"1.0\"),\n        exit_policy=ExitPolicy.TIME_BASED,\n        prediction_horizon=3,\n    )\n\n    position.candles_direction = [\"down\", \"down\", \"up\"]\n\n    position_monitor.close_position(position, reason=\"TAKE_PROFIT\", exit_price=90.0)\n\n    assert position.is_active is False\n    assert position.close_reason == \"TAKE_PROFIT\"\n    assert position.accuracy == pytest.approx(2 / 3, rel=1e-2)\n\ndef test_close_position_no_tracking(position_monitor):\n    \"\"\"Test closing position with no candle tracking.\"\"\"\n    position = position_monitor.open_position(\n        symbol=\"BTCUSDT\",\n        side=OrderSide.BUY,\n        entry_price=100.0,\n        stop_loss=95.0,\n        take_profit=110.0,\n        quantity=Decimal(\"1.0\"),\n        exit_policy=ExitPolicy.SL_TP_ONLY,\n    )\n\n    position_monitor.close_position(position, reason=\"STOP_LOSS\", exit_price=95.0)\n\n    assert position.is_active is False\n    assert position.accuracy is None\n\ndef test_only_one_active_position_per_symbol(position_monitor, db_session):\n    \"\"\"Test constraint: only one active position per symbol.\"\"\"\n    position_monitor.open_position(\n        symbol=\"BTCUSDT\",\n        side=OrderSide.BUY,\n        entry_price=100.0,\n        stop_loss=95.0,\n        take_profit=110.0,\n        quantity=Decimal(\"1.0\"),\n        exit_policy=ExitPolicy.SL_TP_ONLY,\n    )\n\n    active_positions = (\n        db_session.query(ActivePosition)\n        .filter(\n            ActivePosition.symbol == \"BTCUSDT\", ActivePosition.is_active.is_(True)\n        )\n        .all()\n    )\n\n    assert len(active_positions) == 1\n\n    pos1 = position_monitor.get_active_position(\"BTCUSDT\")\n    position_monitor.close_position(pos1, reason=\"TEST\", exit_price=105.0)\n\n    position_monitor.open_position(\n        symbol=\"BTCUSDT\",\n        side=OrderSide.SELL,\n        entry_price=105.0,\n        stop_loss=110.0,\n        take_profit=95.0,\n        quantity=Decimal(\"1.0\"),\n        exit_policy=ExitPolicy.SL_TP_ONLY,\n    )\n\n    active_positions_after = (\n        db_session.query(ActivePosition)\n        .filter(\n            ActivePosition.symbol == \"BTCUSDT\", ActivePosition.is_active.is_(True)\n        )\n        .all()\n    )\n\n    assert len(active_positions_after) == 1\n    assert active_positions_after[0].side == OrderSide.SELL\n","numLines":256,"startLine":1,"totalLines":256}}}
