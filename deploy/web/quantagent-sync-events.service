[Unit]
Description=QuantAgent web: copiar eventos de las cuentas al feed

[Service]
Type=oneshot
WorkingDirectory=/home/azureuser/paper-ops
Environment=PYTHONPATH=/home/azureuser/paper-ops/QuantAgent
Environment=QUANTAGENT_SNAPSHOT_DIR=/home/azureuser/paper-ops/local-data
Environment=QUANTAGENT_DATABASE_URL=sqlite:////home/azureuser/web-ops/maestro.db
Environment=NUMBA_CACHE_DIR=/tmp/numba-cache
ExecStart=/home/azureuser/paper-ops/venv/bin/quantagent api sync-events
TimeoutStartSec=10min
